<% if(!sourceTransforms.workbook&&sourceTransforms.sheetCount>1){ const scope=sourceTransforms.worksheetScope,imagePages=plan.sourceKind==='image',part=imagePages?'image page':'worksheet',parts=imagePages?'image pages':'worksheets',source=imagePages?'image file':'workbook'; %>
<section class="card section" aria-labelledby="worksheet-scope"><div class="card-head"><h2 id="worksheet-scope"><%= needsWorksheetScope?'Review the '+parts+' before approval':scope?.confirmed?(imagePages?'Image page scope reviewed':'Worksheet scope reviewed'):(imagePages?'Image page scope':'Worksheet scope') %></h2></div><div class="card-body">
<p>This <%= source %> has <%= sourceTransforms.sheetCount %> <%= parts %>. This preview uses only “<%= plan.sheetName %>”. StockChief has not combined the other <%= parts %>. <% if(plan.status==='READY'&&plan.approvalStatus==='AWAITING_APPROVAL'){ %>Nothing has been imported.<% } %></p>
<% if(scope?.coverage){ %><div class="table-scroll"><table class="table"><thead><tr><th><%= imagePages?'Image page':'Worksheet' %></th><th>Source rows</th><th>Use in this import</th></tr></thead><tbody><% scope.coverage.forEach(function(part){ %><tr><th scope="row"><%= part.name %></th><td><%= Number(part.rows).toLocaleString('en-US') %></td><td><%= part.included?'Included in this preview':'Not imported' %></td></tr><% }) %></tbody></table></div>
<% if(needsWorksheetScope&&plan.status==='READY'&&plan.approvalStatus==='AWAITING_APPROVAL'){ %><p>To include other <%= parts %>, read the complete <%= source %> again. If those <%= parts %> are intentionally outside this import, confirm that choice below.</p>
<% if(sourceTransforms.analysisNotice){ %><form method="post" action="/imports/<%= plan.id %>/reanalyse"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="integrityHash" value="<%= plan.integrityHash %>"><label class="field"><span>Prepare a preview of another worksheet</span><select name="sheetIndex" required><% scope.coverage.forEach(part=>{ %><option value="<%= part.sheet %>" <%= part.included?'selected':'' %>><%= part.name %> · <%= part.rows %> rows</option><% }); %></select></label><p>This creates a separate preview without calling a model, joining worksheets or changing stock.</p><button class="btn" type="submit">Review selected worksheet</button></form><% } %>
<form method="post" action="/imports/<%= plan.id %>/revise" data-worksheet-scope-form><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="integrityHash" value="<%= plan.integrityHash %>"><label class="field"><span><input type="checkbox" name="confirmWorksheetScope" value="yes" required> Use only “<%= plan.sheetName %>”; I reviewed the worksheet list and understand that all other <%= parts %> will not be imported.</span></label><p>This choice revises the preview only. Importing still needs separate approval.</p><button class="btn" type="submit">Save worksheet scope</button></form><% } %>
<% } else if(needsWorksheetScope){ %><p>Read this workbook again to see every worksheet and prepare a complete preview. This older preview cannot be approved while its <%= part %> coverage is unresolved.</p><% } %>
<% if(scope?.confirmedAt){ %><p>Scope confirmed <time data-import-time datetime="<%= scope.confirmedAt %>"><%= new Date(scope.confirmedAt).toUTCString() %></time>.</p><% } %>
</div></section><% } %>
