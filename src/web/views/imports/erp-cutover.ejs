<div class="page-head"><div class="titles"><h1><%= pkg.source_label %></h1><p class="page-sub"><%= labels[pkg.status]||'Needs review' %></p></div></div>
<% if(locals.migrationAllowed===false){ %><p class="notice" data-agent-plan-locked><span class="badge">Growth</span> Continuing this ERP migration requires Growth or above. You can review saved progress or cancel before business records have been saved. <a class="btn" href="/settings/billing">Upgrade plan</a></p><% } %>
<div class="card section"><div class="card-body" data-erp-progress="/erp-cutovers/<%= encodeURIComponent(pkg.id) %>/progress" data-erp-state="<%= pkg.status %>" data-erp-stopped="<%= worker?.status==='DEAD'?'yes':'no' %>"><p><strong data-erp-progress-label><%= labels[pkg.status]||'Needs review' %></strong></p><p><%= Number(pkg.staged_count).toLocaleString() %> source records; <%= Number(pkg.applied_count).toLocaleString() %> saved; <%= Number(pkg.problem_count).toLocaleString() %> problems.</p><p data-erp-progress-count></p>
<% if(worker?.status==='DEAD'){ %><p class="notice notice--warn">The worker stopped before saving its next page. Your saved progress is intact.</p><form method="post" action="/erp-cutovers/<%= encodeURIComponent(pkg.id) %>/resume"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="btn" <% if(locals.migrationAllowed===false){ %>disabled<% } %>>Resume saved progress</button></form><% } %>
<% if(['APPROVED','APPLYING','RECONCILING','VERIFIED'].includes(pkg.status)){ %><p>Regular stock and order changes are paused in this inventory while its opening balances are checked. The worker saves progress in small batches.</p><% } %>
<% if(['READY','APPROVED','APPLYING','RECONCILING','VERIFIED','CUTOVER_ACTIVE'].includes(pkg.status)){const source=JSON.parse(pkg.manifest_json),names={account:'Mapped accounts',location:'Locations',product:'Products',sku:'Variants / SKUs',supplier:'Suppliers',customer:'Customers',inventory_position:'Opening stock positions',purchase_order:'Remaining purchase orders',sales_order:'Remaining sales orders',opening_receivable:'Unpaid customer documents',opening_payable:'Unpaid supplier documents',history_fact:'Historical evidence'}; %><h2>The reviewed opening position</h2><dl><% for(const [key,label]of Object.entries(names)){if(source.counts[key]){ %><div><dt><%= label %></dt><dd><%= source.counts[key].toLocaleString() %></dd></div><% }}if(pkg.postgres_state.sourceSummary&&source.accounting){const totals=pkg.postgres_state.sourceSummary; %><div><dt>Starting stock value</dt><dd><%= helpers.money(totals.stock_value_minor,source.accounting.currency) %></dd></div><div><dt>Customers still owe</dt><dd><%= helpers.money(totals.receivables_minor,source.accounting.currency) %></dd></div><div><dt>Still owed to suppliers</dt><dd><%= helpers.money(totals.payables_minor,source.accounting.currency) %></dd></div><% } %></dl><% } %>
<% const oldSystem=pkg.postgres_state&&pkg.postgres_state.oldSystem; if(oldSystem){ const names={stockValue:'Stock value',stockUnits:'Stock units',receivables:'Customers owe',payables:'Owed to suppliers',products:'Products',customers:'Customers',suppliers:'Suppliers'},cur=JSON.parse(pkg.manifest_json).accounting?.currency||'USD',show=(k,v)=>['stockValue','receivables','payables'].includes(k)?helpers.money(Number(v),cur):Number(v).toLocaleString(); %>
<section class="section" data-old-system-plan><h2>What StockChief read</h2><ul class="plain-list"><% for(const t of oldSystem.tables){ %><li dir="auto"><%= t.label %> · <%= t.label2 %> · <%= Number(t.rows).toLocaleString() %> lines</li><% } %></ul>
<h3>Totals check</h3><div class="table-scroll"><table class="table table--tight" data-old-system-totals><thead><tr><th>Total</th><th>In the export</th><th>In the records</th><th>Result</th></tr></thead><tbody>
<% for(const [k,v] of Object.entries(oldSystem.exported||{})){ const diff=(oldSystem.differences||[]).some(d=>d.name===k); %><tr><td><%= names[k]||k %></td><td><%= show(k,v) %></td><td><%= oldSystem.computed[k]===undefined?'—':show(k,oldSystem.computed[k]) %></td><td><span class="badge <%= diff?'badge--warn':'badge--ok' %>"><%= diff?'Differs':'Matches' %></span></td></tr><% } %>
</tbody></table></div>
<% if(oldSystem.differences&&oldSystem.differences.length){ %><p class="notice notice--warn">The export’s totals and its records differ, so StockChief stopped. Correct the export and upload it again, or accept the differences to approve.</p><% } %>
<% if(oldSystem.holdReason&&!['CUTOVER_ACTIVE','CANCELLED'].includes(pkg.status)){ %><p class="notice" data-old-system-hold><%= oldSystem.holdReason %></p><% } %>
<% if(oldSystem.agentApproved){ %><p data-old-system-agent>StockChief approved this migration on its own after every total matched<%= pkg.status==='CUTOVER_ACTIVE'?' and opened the inventory once every balance matched':'' %>.</p><% } %></section><% } %>
<% if(pkg.status==='READY'){ %><p>The source has passed its checks. Approval starts saving this exact opening position into this new inventory.</p><form method="post" action="/erp-cutovers/<%= encodeURIComponent(pkg.id) %>/approve"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="sealedHash" value="<%= pkg.postgres_state.sealedHash %>"><% if(pkg.postgres_state.oldSystem&&(pkg.postgres_state.oldSystem.differences||[]).length){ %><label class="field"><span><input type="checkbox" name="acceptDifferences" value="yes"> I accept the differences above.</span></label><% } %><button class="btn btn--primary" <% if(locals.migrationAllowed===false){ %>disabled<% } %>>Approve this cutover</button></form><% } %>
<% if(pkg.status==='VERIFIED'){ %><p>Every required source and balance check matches. Keep the old ERP frozen, then start operating here.</p><form method="post" action="/erp-cutovers/<%= encodeURIComponent(pkg.id) %>/activate"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="sealedHash" value="<%= pkg.postgres_state.sealedHash %>"><button class="btn btn--primary" <% if(locals.migrationAllowed===false){ %>disabled<% } %>>Open this inventory</button></form><% } %>
<% if(pkg.status==='RECONCILING'&&Number(pkg.problem_count)){ %><form method="post" action="/erp-cutovers/<%= encodeURIComponent(pkg.id) %>/retry"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="btn" <% if(locals.migrationAllowed===false){ %>disabled<% } %>>Run the saved balance checks again</button></form><% } %>
<% if(Number(pkg.applied_count)===0&&!['CUTOVER_ACTIVE','CANCELLED'].includes(pkg.status)){ %><form method="post" action="/erp-cutovers/<%= encodeURIComponent(pkg.id) %>/cancel"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="btn">Cancel before saving business records</button></form><% } %>
</div></div><% if(issues.length||checks.length){ %><div class="card section"><div class="card-body"><h2>Needs review</h2><% for(const issue of issues){ %><p><%= issue.entity_type.replaceAll('_',' ') %>: <%= issue.issue_detail %></p><% } %><% for(const check of checks){ %><p><%= check.label %> does not match the frozen source.</p><% } %></div></div><% } %><a class="btn" href="/erp-cutovers">Back to ERP cutovers</a>

<script src="/erp-cutovers.js" defer></script>
