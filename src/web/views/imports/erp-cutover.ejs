<div class="page-head"><div class="titles"><h1><%= pkg.source_label %></h1><p class="page-sub"><%= labels[pkg.status]||'Needs review' %></p></div></div>
<div class="card section"><div class="card-body" data-erp-progress="/erp-cutovers/<%= encodeURIComponent(pkg.id) %>/progress" data-erp-state="<%= pkg.status %>" data-erp-stopped="<%= worker?.status==='DEAD'?'yes':'no' %>"><p><strong data-erp-progress-label><%= labels[pkg.status]||'Needs review' %></strong></p><p><%= Number(pkg.staged_count).toLocaleString() %> source records; <%= Number(pkg.applied_count).toLocaleString() %> saved; <%= Number(pkg.problem_count).toLocaleString() %> problems.</p><p data-erp-progress-count></p>
<% if(worker?.status==='DEAD'){ %><p class="notice notice--warn">The worker stopped before saving its next page. Your saved progress is intact.</p><form method="post" action="/erp-cutovers/<%= encodeURIComponent(pkg.id) %>/resume"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="btn">Resume saved progress</button></form><% } %>
<% if(['APPROVED','APPLYING','RECONCILING','VERIFIED'].includes(pkg.status)){ %><p>Regular stock and order changes are paused in this inventory while its opening balances are checked. The worker saves progress in small batches.</p><% } %>
<% if(['READY','APPROVED','APPLYING','RECONCILING','VERIFIED','CUTOVER_ACTIVE'].includes(pkg.status)){const source=JSON.parse(pkg.manifest_json),names={account:'Mapped accounts',location:'Locations',product:'Products',sku:'Variants / SKUs',supplier:'Suppliers',customer:'Customers',inventory_position:'Opening stock positions',purchase_order:'Remaining purchase orders',sales_order:'Remaining sales orders',opening_receivable:'Unpaid customer documents',opening_payable:'Unpaid supplier documents',history_fact:'Historical evidence'}; %><h2>The reviewed opening position</h2><dl><% for(const [key,label]of Object.entries(names)){if(source.counts[key]){ %><div><dt><%= label %></dt><dd><%= source.counts[key].toLocaleString() %></dd></div><% }}if(pkg.postgres_state.sourceSummary&&source.accounting){const totals=pkg.postgres_state.sourceSummary; %><div><dt>Starting stock value</dt><dd><%= helpers.money(totals.stock_value_minor,source.accounting.currency) %></dd></div><div><dt>Customers still owe</dt><dd><%= helpers.money(totals.receivables_minor,source.accounting.currency) %></dd></div><div><dt>Still owed to suppliers</dt><dd><%= helpers.money(totals.payables_minor,source.accounting.currency) %></dd></div><% } %></dl><% } %>
<% if(pkg.status==='READY'){ %><p>The source has passed its checks. Approval starts saving this exact opening position into this new inventory.</p><form method="post" action="/erp-cutovers/<%= encodeURIComponent(pkg.id) %>/approve"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="sealedHash" value="<%= pkg.postgres_state.sealedHash %>"><button class="btn btn--primary">Approve this cutover</button></form><% } %>
<% if(pkg.status==='VERIFIED'){ %><p>Every required source and balance check matches. Keep the old ERP frozen, then start operating here.</p><form method="post" action="/erp-cutovers/<%= encodeURIComponent(pkg.id) %>/activate"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="sealedHash" value="<%= pkg.postgres_state.sealedHash %>"><button class="btn btn--primary">Open this inventory</button></form><% } %>
<% if(pkg.status==='RECONCILING'&&Number(pkg.problem_count)){ %><form method="post" action="/erp-cutovers/<%= encodeURIComponent(pkg.id) %>/retry"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="btn">Run the saved balance checks again</button></form><% } %>
<% if(Number(pkg.applied_count)===0&&!['CUTOVER_ACTIVE','CANCELLED'].includes(pkg.status)){ %><form method="post" action="/erp-cutovers/<%= encodeURIComponent(pkg.id) %>/cancel"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="btn">Cancel before saving business records</button></form><% } %>
</div></div><% if(issues.length||checks.length){ %><div class="card section"><div class="card-body"><h2>Needs review</h2><% for(const issue of issues){ %><p><%= issue.entity_type.replaceAll('_',' ') %>: <%= issue.issue_detail %></p><% } %><% for(const check of checks){ %><p><%= check.label %> does not match the frozen source.</p><% } %></div></div><% } %><a class="btn" href="/erp-cutovers">Back to ERP cutovers</a>

<script src="/erp-cutovers.js" defer></script>
