<% if(locals.uploadPolicy){ const policy=uploadPolicy,n=value=>value===null?'Unlimited':Number(value).toLocaleString('en-US'); %>
<section class="setup-plan-allowance" aria-label="Your plan's import allowance"><h3><%= policy.planName %> import allowance</h3><dl><% for(const [key,label] of [['products','Products'],['active_skus','SKUs'],['agent_documents','AI document readings this month'],['ai_work_credits','AI credits this month']]){const meter=policy.meters.find(m=>m.meter===key);if(meter){ %><div><dt><%= label %></dt><dd><strong><%= n(meter.remaining) %></strong><%= meter.remaining===null?'':' remaining' %><% if(meter.hardLimit!==null){ %> of <%= n(meter.hardLimit) %><% } %></dd></div><% }} %></dl><% const rows=policy.meters.find(m=>m.meter==='import_rows');if(rows?.hardLimit!==null&&rows?.hardLimit!==undefined){ %><p>Up to <strong><%= n(rows.hardLimit) %> rows per file</strong>.</p><% } %><p>Handwritten sheets: <strong><%= policy.handwriting?'Included on your plan':'Growth or higher' %></strong>. Product and SKU limits are checked again before importing. AI readings use your current document and credit allowances, including active packs. Typed tables can be read without AI.</p><a href="/settings/billing">View plan and usage</a></section><% } %>
