<header class="rm-head"><h1><%= campaign.title %></h1><p>Quantity stock across the selected warehouse, zone or category. Lot, serial and catch-weight stock require identity or weight checks on their product pages and are excluded from this worksheet.</p></header>
<p><a href="/warehouse/counts/new">Back to stock counts</a></p>
<% if(locals.observed && totals.uncounted){ %><form method="post" action="/warehouse/counts/campaigns/<%= campaign.id %>/staff-quantities">
  <input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="revision" value="<%= campaign.revision %>">
  <p>Your counter has finished. Copy their quantities into the empty worksheet positions to review the differences.</p><button class="rm-btn">Use staff counts</button>
</form><% } %>
<p><a href="/warehouse/counts/campaigns/<%= campaign.id %>/export">Download the complete count worksheet (CSV)</a></p>
<% if(campaign.status==='DRAFT'){ %><form method="post" action="/warehouse/counts/campaigns/<%= campaign.id %>/save" data-count-upload data-revision="<%= campaign.revision %>" data-csrf="<%= csrfToken %>"><label>Upload counted quantities from the worksheet<input type="file" accept=".csv,text/csv" required></label><p>Enter the Counted quantity column. Keep stock position references unchanged. Blank quantities remain uncounted. Uploads save in batches and never move stock until an owner approves the variances.</p><button class="rm-btn">Save counts from CSV</button><p role="status" aria-live="polite"></p></form><script src="/count-worksheet.js" defer></script><% } %>
<p>Total reviewed stock value change: <%= helpers.money(Number(totals.cost_delta_minor),currency) %></p>
<section class="rm-panel"><p><%= totals.positions.toLocaleString() %> positions · <%= totals.uncounted.toLocaleString() %> uncounted · <%= totals.variances.toLocaleString() %> variances · <%= totals.applied.toLocaleString() %> processed</p><p>Status: <%= ({DRAFT:'Counting in progress',APPLYING:'Applying approved counts in saved batches',REVIEW_REQUIRED:'Stock changed — review required',COMPLETED:'Completed'})[campaign.status] %></p>
<% if(campaign.problem){ %><p class="notice notice--warn"><%= campaign.problem %></p><p>Create a new worksheet for the remaining stock. Completed movements are preserved and will not be repeated.</p><% } %>
<form method="post" action="/warehouse/counts/campaigns/<%= campaign.id %>/save"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="revision" value="<%= campaign.revision %>">
<table class="table"><thead><tr><th>Location</th><th>Product / variant</th><th>SKU</th><th>Before</th><th>Counted</th><th>Unit cost for extra stock</th><th>Stock value change</th><th>Physical count recorded by</th></tr></thead><tbody><% rows.forEach((line,index)=>{ %><tr><td><%= line.location_name %></td><td><%= line.name %><%= line.variant_label?' — '+line.variant_label:'' %></td><td><%= line.code %></td><td><%= line.before_quantity %></td><td><input type="hidden" name="lines[<%= index %>][skuId]" value="<%= line.sku_id %>"><input type="hidden" name="lines[<%= index %>][locationId]" value="<%= line.location_id %>"><input aria-label="Count for <%= line.code %>" name="lines[<%= index %>][quantity]" value="<%= line.counted_quantity??'' %>" <%= campaign.status==='DRAFT'?'':'disabled' %>></td><td><input aria-label="Additional stock cost for <%= line.code %>" name="lines[<%= index %>][unitCost]" <%= campaign.status==='DRAFT'?'':'disabled' %>></td><td><%= line.cost_delta_minor==null?'Save count to calculate':helpers.money(Number(line.cost_delta_minor),currency) %></td><td><%= line.counter_name||(line.counted_quantity==null?'Awaiting count':'Entered for owner review') %><% if(line.counter_recorded_at){ %> · <%= helpers.dateTime(line.counter_recorded_at) %><% } %></td></tr><% }); %></tbody></table>
<% if(campaign.status==='DRAFT'){ %><p>Blank counts remain uncounted. Save this page before opening the next one.</p><button class="rm-btn">Save these counts</button><% } %></form>
<% if(next){ %><a href="/warehouse/counts/campaigns/<%= campaign.id %>?<%= new URLSearchParams({afterLocation:next.location_id,afterSku:next.sku_id}).toString() %>">Next 100 positions</a><% } %>
<% if(campaign.status==='DRAFT'&&currentUser.role==='owner'){ %><form method="post" action="/warehouse/counts/campaigns/<%= campaign.id %>/approve"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="revision" value="<%= campaign.revision %>"><p>One approval covers every saved variance. Stock changes are checked again in each batch; other operations may continue.</p><button class="rm-btn" <%= totals.uncounted?'disabled':'' %>>Approve all count variances</button></form><% } %></section>
