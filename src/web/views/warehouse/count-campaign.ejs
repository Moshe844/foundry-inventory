<% const details=rows.filter(line=>line.before_count),quantities=rows.filter(line=>!line.before_count),mixed=campaign.scope.tracking==='stock'; %>
<header class="rm-head"><h1><%= campaign.title %></h1><p><%= mixed?'Compare the blind staff observations with recorded quantities, identifiers and weights.':'Quantity stock across the selected warehouse, zone or category.' %></p></header>
<p><a href="/warehouse/counts/new">Back to stock counts</a></p>
<% if(locals.observed && totals.uncounted){ %><form method="post" action="/warehouse/counts/campaigns/<%= campaign.id %>/staff-quantities">
  <input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="revision" value="<%= campaign.revision %>">
  <p>Your counter has finished. Review their observations before accepting the staff counts.</p><button class="rm-btn">Use staff counts</button>
</form><% } %>
<p><a href="/warehouse/counts/campaigns/<%= campaign.id %>/export">Download <%= mixed?'quantity rows':'the complete count worksheet' %> (CSV)</a></p>
<% if(campaign.status==='DRAFT'){ %><form method="post" action="/warehouse/counts/campaigns/<%= campaign.id %>/save" data-count-upload data-revision="<%= campaign.revision %>" data-csrf="<%= csrfToken %>"><label>Upload counted quantities from the worksheet<input type="file" accept=".csv,text/csv" required></label><p>Enter the Counted quantity column. Keep stock position references unchanged. Blank quantities remain uncounted. Uploads save in batches and never move stock until an owner approves the variances.</p><button class="rm-btn">Save counts from CSV</button><p role="status" aria-live="polite"></p></form><script src="/count-worksheet.js" defer></script><% } %>
<% if(seesCosts){ %><p><%= mixed?'Reviewed value change for quantity rows':'Total reviewed stock value change' %>: <%= helpers.money(Number(totals.cost_delta_minor),currency) %></p><% } %>
<section class="rm-panel"><p><%= totals.positions.toLocaleString() %> positions · <% if(campaign.assigned){ %><%= totals.staff_observed.toLocaleString() %> staff observations · <% } %><%= totals.uncounted.toLocaleString() %> <%= campaign.assigned?'awaiting worksheet review':'uncounted' %> · <%= totals.variances.toLocaleString() %> variances · <%= totals.applied.toLocaleString() %> processed</p><p>Status: <%= ({DRAFT:'Counting in progress',APPLYING:'Applying approved counts in saved batches',REVIEW_REQUIRED:'Stock changed — review required',COMPLETED:'Completed'})[campaign.status] %></p>
<% if(campaign.problem){ %><p class="notice notice--warn"><%= campaign.problem %></p><p>Create a new worksheet for the remaining stock. Completed movements are preserved and will not be repeated.</p><% } %>
<% if(quantities.length){ %><form method="post" action="/warehouse/counts/campaigns/<%= campaign.id %>/save"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="revision" value="<%= campaign.revision %>">
<table class="table"><thead><tr><th>Location</th><th>Product / variant</th><th>SKU</th><th>Before</th><th>Counted</th><th>Unit cost for extra stock</th><% if(seesCosts){ %><th>Stock value change</th><% } %><th>Physical count recorded by</th></tr></thead><tbody><% quantities.forEach((line,index)=>{ %><tr><td><%= line.location_name %></td><td><%= line.name %><%= line.variant_label?' — '+line.variant_label:'' %></td><td><%= line.code %></td><td><%= line.before_quantity %></td><td><input type="hidden" name="lines[<%= index %>][skuId]" value="<%= line.sku_id %>"><input type="hidden" name="lines[<%= index %>][locationId]" value="<%= line.location_id %>"><input aria-label="Count for <%= line.code %>" name="lines[<%= index %>][quantity]" value="<%= line.counted_quantity??'' %>" <%= campaign.status==='DRAFT'?'':'disabled' %>></td><td><input aria-label="Additional stock cost for <%= line.code %>" name="lines[<%= index %>][unitCost]" <%= campaign.status==='DRAFT'?'':'disabled' %>></td><% if(seesCosts){ %><td><%= line.cost_delta_minor==null?'Save count to calculate':helpers.money(Number(line.cost_delta_minor),currency) %></td><% } %><td><%= line.counter_name||(line.counted_quantity==null?'Awaiting count':'Entered for owner review') %><% if(line.counter_recorded_at){ %> · <%= helpers.dateTime(line.counter_recorded_at) %><% } %></td></tr><% }); %></tbody></table>
<% if(campaign.status==='DRAFT'){ %><p>Blank counts remain uncounted. Save this page before opening the next one.</p><button class="rm-btn">Save these counts</button><% } %></form><% } %>
<% if(details.length){ %><h2>Identifiers and measured stock</h2><% for(const line of details){ %>
<article class="card card-body stack">
  <h3><%= line.code %> · <%= line.location_name %></h3>
  <% if(line.counter_recorded_at){ %><p><%= line.counter_name %> · <%= helpers.dateTime(line.counter_recorded_at) %></p><% } %>
  <% if(line.applied_at){ %><p>Verified during worksheet approval.</p>
  <% }else if(line.counter_quantity==null){ %><p>Awaiting the completed physical observation.</p>
  <% }else if(!line.matches_current){ %><p>Physical observation differs from current stock. <a href="/inventory/<%= line.item_id %>">Review and resolve this product separately</a> before approval.</p>
  <% }else{ %><p><%= line.matches_original?'Matches the recorded stock.':'Matches the current stock after the original snapshot.' %></p><% } %>
  <% function detailsFor(label,evidence){ %>
    <details><summary><%= label %></summary><p><%= evidence.quantity??'Unknown' %> <%= line.unit_label %><% if(line.secondary_unit_label){ %> · <%= evidence.secondary??'Unknown' %> <%= line.secondary_unit_label %><% } %></p>
    <% if(evidence.entries.length){ %><ul><% for(const entry of evidence.entries){ %><li><%= entry.code %> · <%= entry.quantity %> <%= line.unit_label %><% if(line.secondary_unit_label){ %> · <%= entry.secondary??'Unknown' %> <%= line.secondary_unit_label %><% } %></li><% } %></ul><% } %>
    </details>
  <% } detailsFor('Recorded at assignment',line.before_count); if(line.counter_quantity!=null&&line.observation)detailsFor('Staff observation',line.observation);
  if(line.live_count&&!line.applied_at)detailsFor('Current stock',line.live_count); %>
</article><% } } %>
<% if(next){ %><a href="/warehouse/counts/campaigns/<%= campaign.id %>?<%= new URLSearchParams({afterLocation:next.location_id,afterSku:next.sku_id}).toString() %>">Next 100 positions</a><% } %>
<% if(campaign.status==='DRAFT'&&currentUser.role==='owner'){ %><form method="post" action="/warehouse/counts/campaigns/<%= campaign.id %>/approve"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="revision" value="<%= campaign.revision %>"><p>One approval covers every saved variance. Stock changes are checked again in each batch; other operations may continue.</p><button class="rm-btn" <%= totals.uncounted?'disabled':'' %>>Approve all count variances</button></form><% } %></section>
