<header class="page-head"><div><h1>Record a physical count</h1><p>Choose the product you counted. Its count form will open with its locations and recorded stock.</p></div></header><form method="get" action="/warehouse/counts/new"><label class="field"><span>Find a product or SKU</span><input class="input" type="search" name="q" value="<%= q %>" autofocus></label><button class="btn" type="submit">Search</button></form><section class="card"><div class="card-body"><% for(const row of rows){ %><p><a href="/inventory/<%= encodeURIComponent(row.id) %>#modal-adjust"><%= row.name %> · <%= row.code %></a></p><% } %><% if(!rows.length){ %><p>No products match this search.</p><% } %></div></section>
