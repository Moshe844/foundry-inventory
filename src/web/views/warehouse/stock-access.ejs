<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Warehouse stock · StockChief</title><link rel="stylesheet" href="/app.css"></head><body><main>
<h1>Warehouse stock</h1><p><%= workspace.name %> · <%= restricted?'Your assigned warehouses and their bins. Inventory-wide reports and order management require inventory-wide access.':'All warehouses' %></p>
<% if(message){ %><p role="status"><%= message %></p><% } %>
<% for(const task of locals.countTasks||[]){ %><p><%= task.title %> · <a href="<%= task.href %>"><%= task.actionLabel %></a></p><% } %>
<% for(const notice of locals.flash||[]){ %><p role="status"><%= notice.message %></p><% } %>
<form method="get" action="/warehouse/stock"><label>Location<select name="locationId"><% for(const l of locations){ %><option value="<%= l.id %>" <%= l.id===locationId?'selected':'' %>><%= l.name %></option><% } %></select></label><label>Product, variant, SKU or barcode<input name="q" value="<%= q %>"></label><button>Find stock</button></form>
<% if(!locations.length){ %><p>No warehouses are assigned. Ask your inventory owner to choose your warehouses in Team settings.</p><% }else if(!rows.length){ %><p>No stock positions match this location and search.</p><% } %>
<table><thead><tr><th>Product / variant</th><th>SKU</th><th>On hand</th><th>Stock actions</th></tr></thead><tbody><% for(const row of rows){ %><tr><td><%= row.name %><%= row.variant_label?' — '+row.variant_label:'' %></td><td><%= row.code %></td><td><%= row.quantity %></td><td>
<% if(canReceive){ %><details><summary>Receive stock</summary><form method="post" action="/warehouse/stock/receive"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="skuId" value="<%= row.id %>"><input type="hidden" name="locationId" value="<%= locationId %>"><input type="hidden" name="operationKey" value="<%= operationKey+':'+row.id %>"><label>Quantity<input name="quantity" inputmode="decimal" required></label><label>Unit cost (blank uses saved purchase cost)<input name="unitCost" inputmode="decimal"></label><% if(row.tracking_mode==='lot'){ %><label>Lot / batch<input name="lotCode" required></label><label>Expiry date<input type="date" name="expiresAt"></label><% } %><% if(row.tracking_mode==='serial'){ %><label>Serial numbers, one per line<textarea name="serials" required></textarea></label><% } %><button>Receive</button></form></details><% } %>
<% if(canCount&&row.tracking_mode==='quantity'&&!row.secondary_unit_label){ %><details><summary>Record count</summary><form method="post" action="/warehouse/stock/count"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="skuId" value="<%= row.id %>"><input type="hidden" name="locationId" value="<%= locationId %>"><label>Counted quantity<input name="quantity" inputmode="decimal" required></label><label>Unit cost for additional stock<input name="unitCost" inputmode="decimal"></label><label>Count reference<input name="reference"></label><button>Submit for owner review</button></form></details><% } %>
</td></tr><% } %></tbody></table>
<% if(next){ %><a href="/warehouse/stock?<%= new URLSearchParams({locationId,q,after:next}).toString() %>">Next 100 stock positions</a><% } %>
<form method="post" action="/logout"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button>Sign out</button></form></main></body></html>
