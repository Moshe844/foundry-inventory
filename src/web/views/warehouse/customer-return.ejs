<div class="rm-operation-page">
<p class="rm-stamp"><a href="/warehouse/operations#customer-returns">Customer returns</a> · <%= record.return_number %></p>
<h1 class="rm-figure"><%= record.customer_name %> returned goods.</h1>
<p class="rm-sub"><%= record.order_number %> · <%= record.resolution %> · <%= record.status.replace('_',' ') %></p>
<section class="rm-panel"><div class="rm-panel__head"><div><p class="rm-kicker">One governed return</p><h2>Where the goods are and what happens next</h2></div></div>
  <div class="rm-list"><% record.lines.forEach(function(line){ %><div class="rm-row"><span><strong><%= line.item_name %><%= line.variant_label?' / '+line.variant_label:'' %></strong><small><%= line.sku_code %> · <%= line.quantity_authorized %> authorized</small></span><span><%= line.quantity_received %> in · <%= line.quantity_restocked %> restocked · <%= line.quantity_scrapped %> scrapped · <%= line.quantity_repair %> repair</span></div><% }) %></div>
  <% if(record.status==='REQUESTED'){ %><form method="post" action="/warehouse/returns/customer/<%= record.id %>/authorize"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="rm-button rm-button--primary">Authorize return</button></form><% } %>
  <% if(['AUTHORIZED','PARTIALLY_RECEIVED'].includes(record.status)){ %>
    <section class="rm-panel" id="return-shipping">
      <div class="rm-panel__head"><div><p class="rm-kicker">Customer return shipping</p><h2><%= returnLabel ? 'Return label and tracking' : 'Compare return postage' %></h2></div></div>
      <% if(returnLabel){ %>
        <div class="rm-list"><div class="rm-row"><span><strong><%= returnLabel.carrier %> <%= returnLabel.service || '' %></strong><small><%= returnLabel.tracking_number %> · <%= returnLabel.status.replace('_',' ') %></small></span><span><%= helpers.money(returnLabel.amount_minor,returnLabel.currency) %></span></div></div>
        <div class="button-row"><% if(returnLabel.label_url){ %><a class="rm-button rm-button--primary" href="<%= returnLabel.label_url %>" target="_blank" rel="noopener">Print return label</a><% } %><form method="post" action="/warehouse/returns/customer/<%= record.id %>/return-label/refresh" data-busy><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="rm-button">Refresh tracking</button></form></div>
        <p class="rm-note">A carrier delivery scan does not receive inventory. Record the physical arrival below after the parcel is actually checked.</p>
      <% } else if(returnRates && returnRates.length){ %>
        <form method="post" action="/warehouse/returns/customer/<%= record.id %>/return-label" data-busy>
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <div class="rm-list"><% returnRates.forEach(function(rate,index){ %><label class="rm-row"><span><input type="radio" name="rateId" value="<%= rate.id %>" <%= index===0?'checked':'' %> required> <strong><%= rate.carrier %> <%= rate.service %></strong><small><%= rate.deliveryDate?'Expected '+rate.deliveryDate:rate.deliveryDays?rate.deliveryDays+' days':'No date supplied' %></small></span><strong><%= helpers.money(rate.amountMinor,rate.currency) %></strong></label><% }) %></div>
          <button class="rm-button rm-button--primary">Buy selected return label</button>
          <p class="rm-note">This purchases postage only. It does not receive stock, decide condition, or refund money.</p>
        </form>
      <% } else { %>
        <form method="post" action="/warehouse/returns/customer/<%= record.id %>/shipping-rates" data-busy><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="rm-button rm-button--primary">Compare return rates</button></form>
        <p class="rm-note">Rate comparison costs nothing. StockChief reverses the proven outbound route and uses the evidenced parcel weight.</p>
      <% } %>
    </section>
  <% } %>
  <% if(record.status==='AUTHORIZED'||record.status==='PARTIALLY_RECEIVED'){ var line=record.lines.find(function(l){return l.quantity_received<l.quantity_authorized}); %><form method="post" action="/warehouse/returns/customer/<%= record.id %>/receive" class="rm-form-grid"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="lineId" value="<%= line.id %>"><label>Quantity physically received<input type="number" name="quantity" min="1" max="<%= line.quantity_authorized-line.quantity_received %>" required></label><label>Lot/batch <span class="optional">when tracked</span><input name="lotCode"></label><label class="rm-span-2">Serials <span class="optional">one per line when tracked</span><textarea name="serials"></textarea></label><div class="rm-span-2"><button class="rm-button rm-button--primary">Receive into <%= record.quarantine_name %></button></div></form><% } %>
  <% if(record.status==='RECEIVED'){ var inspect=record.lines[0]; %><p class="rm-note">StockChief cannot decide physical condition. Record how every received unit was actually inspected.</p><form method="post" action="/warehouse/returns/customer/<%= record.id %>/inspect" class="rm-form-grid"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="lineId" value="<%= inspect.id %>"><label>Restock<input type="number" name="restock" min="0" value="0"></label><label>Restock location<select name="restockLocationId"><% locations.forEach(function(l){ %><option value="<%= l.id %>"><%= l.name %></option><% }) %></select></label><label>Scrap<input type="number" name="scrap" min="0" value="0"></label><label>Repair<input type="number" name="repair" min="0" value="0"></label><label>Repair location<select name="repairLocationId"><% locations.forEach(function(l){ %><option value="<%= l.id %>"><%= l.name %></option><% }) %></select></label><label>Condition evidence<input name="conditionNote" required placeholder="Box opened; sole unworn"></label><div class="rm-span-2"><button class="rm-button rm-button--primary">Record inspection</button></div></form><% } %>
  <% if(record.status==='AWAITING_REFUND'){ %><form method="post" action="/warehouse/returns/customer/<%= record.id %>/refund" class="rm-form-grid"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><label>Refund merchandise<input name="revenue" inputmode="decimal" required></label><label>Refund tax<input name="tax" inputmode="decimal" value="0"></label><label>Returned inventory cost<input name="cogs" inputmode="decimal" value="0"></label><label>Refund to<select name="destination"><option value="CASH">Cash/bank</option><option value="AR">Customer balance</option></select></label><div class="rm-span-2"><button class="rm-button rm-button--primary">Approve refund and reconcile</button></div></form><% } %>
  <% if(record.status==='INSPECTED'&&record.resolution==='EXCHANGE'){ %><form method="post" action="/warehouse/returns/customer/<%= record.id %>/exchange" class="rm-form-grid"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><label>Replacement product<select name="skuId"><% skus.forEach(function(s){ %><option value="<%= s.id %>"><%= s.display_name %></option><% }) %></select></label><label>Quantity<input type="number" name="quantity" min="1" value="1"></label><div class="rm-span-2"><button class="rm-button rm-button--primary">Create confirmed exchange order</button></div></form><% } %>
</section>
</div>
