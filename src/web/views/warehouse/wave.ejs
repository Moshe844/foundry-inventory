<div class="rm-operation-page">
<p class="rm-stamp"><a href="/warehouse/operations#waves">Fulfillment waves</a> · wave #<%= wave.wave_number %></p>
<h1 class="rm-figure"><%= wave.title %></h1>
<p class="rm-sub"><%= wave.strategy %> · <%= wave.units.picked %> of <%= wave.units.planned %> scan-verified · <%= wave.status %></p>
<% if(wave.status==='PICKING'&&wave.units.picked===0){ %><div class="rm-note">Wave released. Stock remains unchanged until each pick is scanned and its shipment is handed off.</div><% } %>
<% if(wave.status==='COMPLETED'){ %><div class="rm-note">This wave is complete. Every shipment outcome has been verified.</div><% } %>
<section class="rm-panel"><div class="rm-panel__head"><div><p class="rm-kicker">Pick path</p><h2>One ordered route across every carton</h2></div></div><div class="rm-list"><% wave.lines.forEach(function(line){ %><div class="rm-row"><span><strong><%= line.location_name %> → <%= line.item_name %><%= line.variant_label?' / '+line.variant_label:'' %></strong><small><%= line.shipment_number %> · product <%= line.sku_barcode||line.sku_code %> · location <%= line.location_barcode||'needs barcode' %></small><% if(line.status==='PICKED'){ %><small>Verified <%= line.picked_quantity %> <%= line.item_name %> from <%= line.location_name %>.</small><% } %></span><span><%= line.picked_quantity %> / <%= line.planned_quantity %> · <%= line.status %><% if(line.status!=='PICKED'){ %><details class="rm-disclosure"><summary>Report a shortage</summary><form method="post" action="/warehouse/waves/<%= wave.id %>/shortage" class="rm-inline-form"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="lineId" value="<%= line.id %>"><input type="number" name="foundQuantity" min="0" max="<%= line.planned_quantity-line.picked_quantity-1 %>" placeholder="Found" required><input name="note" placeholder="What you checked"><button class="rm-button">Stop this wave</button></form></details><% } %></span></div><% }) %></div>
  <% if(wave.status==='PICKING'||wave.status==='BLOCKED'){ %><form method="post" action="/warehouse/waves/<%= wave.id %>/scans" class="rm-form-grid" id="scan"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="clientScanId" value="browser-<%= Date.now() %>"><label>Location scan<input name="locationBarcode" required autofocus></label><label>Product scan<input name="itemBarcode" required></label><label>Lot/batch scan <span class="optional">when tracked</span><input name="lotBarcode"></label><label>Serial scan <span class="optional">when tracked</span><input name="serialBarcode"></label><label>Quantity<input type="number" name="quantity" min="1" value="1"></label><div><button class="rm-button rm-button--primary">Verify pick</button></div></form><% } %>
</section>
</div>
<% if(wave.scans.length){ %><section class="rm-panel"><div class="rm-panel__head"><div><p class="rm-kicker">Scan history</p><h2>What the warehouse scanner accepted or refused</h2></div></div><div class="rm-list"><% wave.scans.forEach(function(scan){ %><div class="rm-row"><span><strong><%= scan.message %></strong><small><%= helpers.dateTime(scan.scanned_at) %> · <%= scan.location_barcode || 'no location scan' %> · <%= scan.item_barcode || 'no product scan' %></small></span><span class="rm-badge"><%= scan.status %></span></div><% }) %></div></section><% } %>
<section class="rm-panel"><div class="rm-panel__head"><div><p class="rm-kicker">Cartons</p><h2>Pack only after every unit is verified</h2></div></div><div class="rm-list"><% wave.shipments.forEach(function(s){ var complete=wave.lines.filter(function(l){return l.shipment_id===s.shipment_id}).every(function(l){return l.picked_quantity===l.planned_quantity}); %><div class="rm-row"><span><strong><%= s.shipment_number %> · <%= s.customer_name %></strong><small><%= s.order_number %> · <%= s.container_code||'no carton assigned' %></small><% if(s.status==='PACKED'){ %><small>Carton packed. No stock moved.</small><% } %></span><span><% if(complete&&s.status==='PICKING'){ %><form method="post" action="/warehouse/waves/<%= wave.id %>/pack" class="rm-inline-form"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="shipmentId" value="<%= s.shipment_id %>"><select name="containerId"><option value="">No saved carton</option><% containers.filter(function(c){return c.status==='OPEN'}).forEach(function(c){ %><option value="<%= c.id %>"><%= c.code %></option><% }) %></select><input type="number" name="packageCount" min="1" value="1" aria-label="Package count"><input type="number" name="weightGrams" min="1" placeholder="Measured grams" aria-label="Measured weight in grams"><button class="rm-button">Pack</button></form><% }else{ %><%= s.status %><% } %></span></div><% }) %></div>
  <p class="rm-note">Packing does not move stock. Shipping each carton uses the normal shipment flow, posts inventory and accounting once, and supports partial fulfillment.</p>
  <form method="post" action="/warehouse/waves/<%= wave.id %>/refresh"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="rm-button">Verify shipment outcomes</button></form>
</section>
