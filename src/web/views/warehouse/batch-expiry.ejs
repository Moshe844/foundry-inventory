<a class="back-link" href="/needs-you">‹ Needs you</a><h1>Batch expiry</h1><p>Review expired stock and batches due to expire in the next 30 days. Expired stock cannot be sold; use the item’s disposal action to record what actually happens to it.</p>
<form method="get"><label>Search batch, item or variant <input name="q" value="<%= q %>" maxlength="120"></label><label>Show<select name="state"><% for(const [value,label] of [['watch','Expired and expiring soon'],['expired','Expired'],['soon','Next 30 days'],['all','All expiry dates']]){ %><option value="<%= value %>" <%= state===value?'selected':'' %>><%= label %></option><% } %></select></label><label>Location<select name="location"><option value="">All locations</option><% for(const place of locations){ %><option value="<%= place.id %>" <%= location===place.id?'selected':'' %>><%= place.name %></option><% } %></select></label><button class="btn">Apply</button></form>
<p><%= total.toLocaleString('en-US') %> batch stock positions match.</p><% if(!rows.length){ %><p>No batch stock matches these filters.</p><% }else{ %><div class="table-wrap"><table class="table"><thead><tr><th>Item / variant</th><th>SKU</th><th>Batch</th><th>Expiry</th><th>Location</th><th>On hand</th></tr></thead><tbody><% for(const row of rows){ %><tr><td><a href="/inventory/<%= row.item_id %>?trackingQuery=<%= encodeURIComponent(row.lot_code) %>"><%= row.name %><%= row.variant_label?' — '+row.variant_label:'' %></a></td><td><%= row.sku %></td><td><%= row.lot_code %></td><td><%= helpers.shortDate(row.expires_on) %></td><td><%= row.location %></td><td><%= helpers.qty(row.quantity) %></td></tr><% } %></tbody></table></div><% } %><% if(hasMore){ %><a class="btn" href="/warehouse/batches?<%= new URLSearchParams({q,location,state,page:page+1}) %>">Next batches</a><% } %>
