<div style="overflow-wrap:anywhere">
<p><a href="/warehouse/stock">← Warehouse stock</a> · <a href="/warehouse/bin-corrections">New bin correction</a> · <a href="/warehouse/bin-corrections/found">Stock in the wrong bin</a></p>
<h1><%= row?'Review a stock bin correction':'Correct a stock bin' %></h1>
<p>For a wrong put-away or mis-scan, record a real move between two internal bins at the same physical site. Staff confirm the printed codes and physical quantity. Stock and its recorded value move together. Found stock in a different bin than the records show? <a href="/warehouse/bin-corrections/found">Report it here</a> and the records follow the stock.</p>
<% if(locked){ %><p class="notice"><span class="badge">Pro</span> Bin corrections need Pro with a taught scope, or Custom for routine work within owner limits. <a class="btn" href="/billing">Upgrade</a></p><% } %>
<% if(shadow){ %><p class="notice">The first 14-day watch period is active. Agent bin corrections wait until it ends.</p><% } %>
<% if(blocked&&!shadow){ %><p class="notice"><%= blocked %></p><% } %>
<% if(!row&&!locked){ %>
<section class="card"><div class="card-body"><h2>Prepare the exact correction</h2><p>Preparation reserves the units at their source bin. Stock moves only after the physical confirmation and required authority. Use the printed product and bin codes. For batch or serial goods found in another bin, use <a href="/warehouse/bin-corrections/found">Stock in the wrong bin</a>. Measured goods and kits need their separate workflows.</p>
<form method="post" class="form-stack"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="requestKey" value="<%= requestKey %>">
<label>Product scan code<input name="productCode" maxlength="80" autocomplete="off" required></label>
<label>Source bin scan code<input name="fromCode" maxlength="80" autocomplete="off" required></label>
<label>Correct destination bin scan code<input name="toCode" maxlength="80" autocomplete="off" required></label>
<label>Whole units to move<input type="number" name="quantity" min="1" max="100000" step="1" required></label>
<label>Reason<select name="reason" required><option value="wrong-putaway">Wrong put-away</option><option value="mis-scan">Mis-scan</option></select></label>
<button class="btn" <%= shadow||blocked?'disabled':'' %>>Prepare bin correction</button></form></div></section>
<% } %>
<% if(row){const p=row.source; %>
<section class="card"><div class="card-body"><h2><%= p.product %> · <%= p.sku %></h2><p><strong><%= p.quantity %> <%= p.unit %></strong> · <%= p.from.name %> → <%= p.to.name %><% if(p.lot){ %> · Batch <%= p.lot.code %><% } %><% if(p.serials){ %> · Serials <%= p.serials.map(s=>s.serial).join(', ') %><% } %></p>
<p><strong><%= row.kind==='RECORD'?'Records follow the stock':'Staff move the goods' %></strong> · <%= row.kind==='RECORD'?(row.evidence?.source==='count'?'Two counts showed '+p.from.name+' short by exactly what '+p.to.name+' has extra.':'Staff found these units in '+p.to.name+' while the records showed '+p.from.name+'. Nothing needs to be carried.'):row.evidence?.source==='putaway'?'A put-away was scanned into '+p.from.name+' instead of the planned '+p.to.name+'. Staff move the goods back to the plan.':'Reported by staff as a '+(p.reason==='mis-scan'?'mis-scan':'wrong put-away')+'.' %></p><p>Product code: <strong><%= p.productBarcode %></strong></p><p>Source bin: <strong><%= p.from.barcode %></strong> · Destination bin: <strong><%= p.to.barcode %></strong></p>
<p role="status"><strong><%= {PROPOSED:'Waiting for the owner — nothing has moved',OPEN:'Prepared — units reserved; no stock has moved in StockChief',SCANNED:row.kind==='RECORD'?'Stock found — waiting for owner approval':'Physical move confirmed — waiting for owner approval',COMPLETED:'Completed — stock and value moved once',CANCELLED:'Cancelled — reservation released without moving stock',UNDONE:'Undone — the records were moved back'}[row.status] %></strong></p>
<% if(row.problem){ %><p class="notice"><%= row.problem %></p><% } %>
<% if(row.scanned_at){ %><p><%= row.kind==='RECORD'?'Stock found and counted':'Physical confirmation recorded' %> <%= helpers.dateTime(row.scanned_at) %> on <%= row.scanned_plan==='enterprise'?'Custom':'Pro' %>.</p><% } %>
<% if(row.manual_recovery){ %><p>Completed manually after the plan change. This did not enable training or routine work.</p><% } %>
<% if(row.status==='COMPLETED'){ %><p><%= row.automatic?'Completed within owner-authorized routine limits.':'Individually approved by the owner.' %> <a href="/warehouse/stock?locationId=<%= p.to.id %>&amp;q=<%= encodeURIComponent(p.sku) %>">View current stock</a></p><% } %>
<% if(row.status==='OPEN'&&!canScan){ %><p>Your inventory owner must grant physical stock operation permission before you can confirm this move.</p><% } %>
<% if(row.status==='OPEN'&&row.kind!=='RECORD'&&!locked&&canScan){ %>
<form method="post" action="/warehouse/bin-corrections/<%= row.id %>/scan" class="form-stack"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="expectedFingerprint" value="<%= row.fingerprint %>">
<label>Confirm product code<input name="productCode" maxlength="80" autocomplete="off" required></label>
<label>Confirm source bin code<input name="fromCode" maxlength="80" autocomplete="off" required></label>
<label>Confirm destination bin code<input name="toCode" maxlength="80" autocomplete="off" required></label>
<label>Actual whole units moved<input type="number" name="quantity" min="1" max="100000" step="1" required></label>
<label><input type="checkbox" name="confirmed" value="yes" required> I physically moved these units from the scanned source bin to the scanned destination bin.</label>
<button class="btn" <%= shadow||blocked?'disabled':'' %>>Record physical move</button></form><% } %>
<% if(row.status==='PROPOSED'&&owner&&!locked){ %><form method="post" action="/warehouse/bin-corrections/<%= row.id %>/approve" class="stacked-form"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="expectedFingerprint" value="<%= row.fingerprint %>"><label class="checkbox"><input type="checkbox" name="confirmed" value="yes" required> <%= row.kind==='RECORD'?'I approve moving these stock records to where the stock was found.':'I approve this move. Staff will carry it out and scan it.' %></label><div class="form-actions"><button class="btn btn--primary" <%= shadow||blocked?'disabled':'' %>>Approve this correction</button></div></form>
<form method="post" action="/warehouse/bin-corrections/<%= row.id %>/cancel" class="stacked-form"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><label class="checkbox"><input type="checkbox" name="confirmed" value="yes" required> I want to decline this correction.</label><div class="form-actions"><button class="btn">Decline</button></div></form><% } %>
<% if(row.status==='SCANNED'&&row.kind==='RECORD'&&owner){ %><form method="post" action="/warehouse/bin-corrections/<%= row.id %>/cancel" class="stacked-form"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><label class="checkbox"><input type="checkbox" name="confirmed" value="yes" required> I want to decline this correction and leave the records as they are.</label><div class="form-actions"><button class="btn">Decline</button></div></form><% } %>
<% if(row.status==='SCANNED'&&owner&&!locked){ %><form method="post" action="/warehouse/bin-corrections/<%= row.id %>/approve" class="form-stack"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="expectedFingerprint" value="<%= row.fingerprint %>"><label><input type="checkbox" name="confirmed" value="yes" required> I approve this exact physically confirmed correction and its recorded stock value.</label><button class="btn" <%= shadow||blocked?'disabled':'' %>>Approve scanned bin correction</button></form><% } %>
<% if(manualRecoveryAllowed){ %><p>This move was physically confirmed before your downgrade. You can finish this existing record manually. New bin corrections, training and routine work remain subject to your current plan.</p><form method="post" action="/warehouse/bin-corrections/<%= row.id %>/approve" class="form-stack"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="expectedFingerprint" value="<%= row.fingerprint %>"><input type="hidden" name="manualRecovery" value="yes"><label><input type="checkbox" name="confirmed" value="yes" required> I approve only this existing physical move and its recorded stock value. No new automation is authorized.</label><button class="btn">Finish existing move manually</button></form><% } %>
</div></section>
<% if(owner&&row.kind==='RECORD'&&row.status==='COMPLETED'){ %><form method="post" action="/warehouse/bin-corrections/<%= row.id %>/undo" class="stacked-form"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><label class="checkbox"><input type="checkbox" name="confirmed" value="yes" required> I want the stock records moved back to where they were.</label><div class="form-actions"><button class="btn">Undo this correction</button></div></form><% } %>
<% if(owner&&row.status==='OPEN'){ %><form method="post" action="/warehouse/bin-corrections/<%= row.id %>/cancel" class="form-stack"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><label><input type="checkbox" name="confirmed" value="yes" required> I confirm these units have not been physically moved and I want to release this reservation.</label><button class="btn">Cancel unmoved bin correction</button></form><% } %>
<% if(owner&&row.status==='COMPLETED'&&!row.automatic&&!row.manual_recovery&&!locked){ %><section class="card"><div class="card-body"><h2>Teach this product and bin scope</h2><p>Pro needs an individually approved example before completing matching scanned corrections alone. The same lower limit remains in force on Custom.</p>
<form method="post" action="/warehouse/bin-corrections/<%= row.id %>/rule" class="form-stack"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="revision" value="<%= rule?.revision||0 %>"><label>Maximum whole units per matching correction<input type="number" name="maximumUnits" min="1" max="100000" step="1" value="<%= rule?.maximum_units||p.quantity %>" required></label><label><input type="checkbox" name="confirmed" value="yes" required> I authorize this exact product, source bin and destination bin within the maximum above.</label><button class="btn" <%= shadow||blocked?'disabled':'' %>>Teach this bin correction</button></form></div></section><% } %>
<% if(owner&&rule){ %><form method="post" action="/warehouse/bin-corrections/<%= row.id %>/rule" class="form-stack"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="revision" value="<%= rule.revision %>"><label><input type="checkbox" name="confirmed" value="yes" required> I confirm removing this learned limit. The routine settings still apply on Custom.</label><button class="btn" name="remove" value="yes">Remove learned bin correction rule</button></form><% } %>
<% } %>
<% if(owner&&!locked){ %><section class="card"><div class="card-body"><h2>Routine work after physical confirmation</h2><p>Enable completion of physically confirmed moves, and of records that follow stock found in another bin, between active internal bins at one site. Pro also needs a matching taught rule. Custom needs no training for this job. Corrections worth more than the value limit, and reserved, picked, counted, batch or serial stock, wait for you. Reservations, inspection holds, scan codes, staff warehouse access and current owner limits are checked again before stock changes.</p>
<form method="post" action="/warehouse/bin-corrections/settings" class="form-stack"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="revision" value="<%= settings?.revision||0 %>"><label>Maximum whole units per routine correction<input type="number" name="maximumUnits" min="1" max="100000" step="1" value="<%= settings?.maximum_units??'' %>" required></label><label>Maximum stock value per routine correction<input name="maximumValue" inputmode="decimal" value="<%= valueLimit %>"></label><label><input type="checkbox" name="confirmed" value="yes" required> I authorize routine completion of physically confirmed bin moves within this quantity limit.</label><button class="btn" <%= shadow||blocked?'disabled':'' %>>Enable routine bin corrections</button></form></div></section><% } %>
<% if(owner&&settings?.enabled){ %><form method="post" action="/warehouse/bin-corrections/settings"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="revision" value="<%= settings.revision %>"><button class="btn" name="stop" value="yes">Stop routine bin corrections</button></form><% } %>
<% if(recent.length){ %><section class="card"><div class="card-body"><h2>Recent corrections</h2><p>Up to 50 most recent records.</p><ul><% for(const r of recent){ %><li><a href="/warehouse/bin-corrections/<%= r.id %>"><%= r.source.sku %> · <%= r.source.quantity %> <%= r.source.unit %> · <%= r.source.from.name %> → <%= r.source.to.name %></a> · <%= r.kind==='RECORD'?'records follow the stock':'move' %> · <%= r.status %></li><% } %></ul></div></section><% } %>
<% if(learned.length){ %><section class="card"><div class="card-body"><h2>Learned correction rules</h2><p>Open a reviewed example to change or remove its limit. These controls remain available after a downgrade.</p><ul><% for(const r of learned){ %><li><a href="/warehouse/bin-corrections/<%= r.example_id %>"><%= r.scope.sku %> · <%= r.scope.from.name %> → <%= r.scope.to.name %></a> · maximum <%= r.maximum_units %> units</li><% } %></ul><% if(nextRule){ %><a href="/warehouse/bin-corrections?afterRule=<%= nextRule %>">Next 100 learned rules</a><% } %></div></section><% } %>
</div>
