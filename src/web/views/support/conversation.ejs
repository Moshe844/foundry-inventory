<header class="rm-head"><h1><%= ticket.subject %></h1><p><%= ticket.id %> · <%= ticket.status==='RESOLVED'?'Resolved':ticket.status==='IN_REVIEW'?'In review':'Received' %> · <%= ticket.channel==='CHAT'?'Support chat':'Support request' %><%= ticket.priority?' · Priority support':'' %></p></header><section class="card card-body stack" data-support-conversation data-support-staff="<%= staff?'true':'false' %>" data-staff-account="<%= staff?account.id:'' %>" data-history="<%= ticket.history?'true':'false' %>" data-cursor="<%= ticket.messages.at(-1)?.cursor||'' %>" data-time-zone="<%= account.timeZone||'UTC' %>" data-updates-url="<%= staff?'/commercial-admin/support/':'/support/requests/' %><%= ticket.id %>/updates"><p role="status" data-support-live-status><%= ticket.history?'Viewing earlier messages.':'Checking support availability…' %></p><% if(staff){ %><button class="btn" type="button" data-support-presence aria-pressed="false">Go online for live chat</button><% } %><nav aria-label="Conversation history"><% if(ticket.earlierCursor){ %><a href="?before=<%= encodeURIComponent(ticket.earlierCursor) %>">Earlier messages</a><% } %><% if(ticket.history){ %><a href="<%= staff?'/commercial-admin/support/':'/support/requests/' %><%= ticket.id %>">Return to live conversation</a><% } %></nav><article><h2>Your request</h2><p style="white-space:pre-wrap;overflow-wrap:anywhere"><%= ticket.body %></p><time datetime="<%= new Date(ticket.created_at).toISOString() %>"><%= helpers.dateTime(ticket.created_at) %></time></article><div data-support-messages role="log" aria-label="Support messages" aria-live="polite"><% for(const m of ticket.messages){ %><article class="card card-body" data-message-id="<%= m.id %>"><h3><%= m.author_role==='SUPPORT'?m.display_name||'StockChief Support':staff?'Customer':'You' %></h3><p style="white-space:pre-wrap;overflow-wrap:anywhere"><%= m.body %></p><time datetime="<%= new Date(m.created_at).toISOString() %>"><%= helpers.dateTime(m.created_at) %></time></article><% } %></div><form data-support-reply method="post" action="<%= staff?'/commercial-admin/support/':'/support/requests/' %><%= ticket.id %>/reply"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="requestKey" value="<%= messageKey %>"><label class="field">Message<textarea class="input" name="body" rows="5" maxlength="10000" required autofocus></textarea></label><p>Your message is saved here. A notification will also be emailed to <%= staff?'the requester':'StockChief Support' %>.</p><button class="btn btn--primary" type="submit">Send message</button></form><% if(staff){ %><form method="post" action="/commercial-admin/support/<%= ticket.id %>/resolve"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="btn" type="submit">Mark resolved</button></form><% } %></section>
<% if(staff&&ticket.owner_account_id){ const a=locals.serviceAgreement; %><section class="card card-body"><h2>Prepare the owner's service agreement</h2><p>No deadline or account manager is promised until an actual support contact is configured and the owner accepts the exact terms.</p><form method="post" action="/commercial-admin/support/<%= ticket.id %>/agreement"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><label class="field">Account manager<select class="input" name="managerAccountId"><option value="">No named manager</option><% for(const p of staffProfiles){ %><option value="<%= p.account_id %>" <%= a?.manager_account_id===p.account_id?'selected':'' %>><%= p.display_name %></option><% } %></select></label><label class="field">First-response target (elapsed hours, optional)<input class="input" type="number" min="1" max="720" name="responseHours" value="<%= a?.response_hours||'' %>"></label><label class="field">Exact service and SLA terms<textarea class="input" name="serviceText" maxlength="8000" rows="6" required><%= a?.service_text||'' %></textarea></label><button class="btn" type="submit">Prepare for owner review</button></form></section><% } %>

<script src="/support-chat.js?v=<%= assetVersion %>" defer></script>
