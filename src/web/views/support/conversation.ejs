<header class="rm-head"><div><p class="eyebrow"><%= staff?'StockChief developer support':'Help and support' %></p><h1><%= ticket.subject %></h1><p><%= staff?(ticket.business_name||'Website enquiry')+' · '+ticket.contact_email:'A conversation with a person' %> · <%= ticket.status==='RESOLVED'?'Resolved':'Open' %></p></div><a class="btn" href="<%= staff?'/commercial-admin/support':'/support' %>">All conversations</a></header>
<%- include('thread') %><script src="/support-chat.js?v=<%= assetVersion %>" defer></script>

<% if(!staff&&locals.supportGrants?.length){ %><section class="card card-body" aria-label="Support access permissions"><h2>Control support access</h2><p>Only approve access you recognize. Viewing is read-only, limited to the selected areas, and recorded in an audit trail.</p><% for(const grant of supportGrants){ %><article class="card card-body"><h3><%= grant.operator_name %> requests <%= grant.scopes.map(s=>({stock:'Inventory',orders:'Orders',purchasing:'Purchasing',money:'Money'})[s]).join(', ') %></h3><p><%= grant.reason %></p><p><%= grant.duration_minutes %> minutes · <%= grant.status %><% if(grant.expires_at){ %> · Ends <%= helpers.dateTime(grant.expires_at) %><% } %></p><% if(grant.status==='REQUESTED'){ %><form method="post" action="/support/access/<%= grant.id %>/approve"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="btn" type="submit">Approve this read-only access</button></form><% } %><% if(grant.status!=='REVOKED'){ %><form method="post" action="/support/access/<%= grant.id %>/revoke"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="btn" type="submit">Revoke support access</button></form><% } %></article><% } %></section><% } %>
