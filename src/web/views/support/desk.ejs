<header class="rm-head"><div><a href="/support">Help &amp; support</a><h1>Customer inbox</h1><p>Open a conversation to read the customer’s message and send your reply. Your replies are written by you; no AI replies are generated.</p></div></header>
<% const me=staffProfiles.find(p=>p.account_id===account.id); %>
<section class="card card-body support-inbox" data-support-desk data-staff-account="<%= account.id %>" data-after="<%= after||'' %>" data-time-zone="<%= account.timeZone||'UTC' %>">
  <div class="support-inbox-presence"><div><h2>Your availability</h2><p role="status" data-support-live-status>You are offline. Customers can leave messages.</p><p>Keep this inbox open while you are available. Replies are written by you.</p></div><button class="btn btn--primary" type="button" data-support-presence aria-pressed="false">Go online for live chat</button></div>
  <h2>Open conversations <span data-support-inbox-count>(<%= tickets.length %>)</span></h2>
  <p data-support-empty <%= tickets.length?'hidden':'' %>>No customers are waiting for a reply. New messages appear here automatically.</p>
  <div class="table-wrap"><table><thead><tr><th>Conversation</th><th>Customer and business</th><th>Status</th><th>Last message</th></tr></thead><tbody data-support-queue><% for(const r of tickets){ %><tr data-support-ticket-id="<%= r.id %>"><td><a href="/commercial-admin/support/<%= r.id %>"><%= r.subject %></a></td><td><strong><%= r.business_name||'Website enquiry' %></strong><br><%= r.contact_email %></td><td><%= r.first_response_at?'Conversation in progress':'Waiting for your reply' %></td><td><%= helpers.dateTime(r.updated_at||r.created_at) %></td></tr><% } %></tbody></table></div>
  <nav aria-label="Support queue pages"><a href="/commercial-admin/support">First page</a><a data-support-next href="<%= nextCursor?'/commercial-admin/support?after='+encodeURIComponent(nextCursor):'/commercial-admin/support' %>" <%= nextCursor?'':'hidden' %>>Next conversations</a></nav>
</section>
<details class="card card-body support-profile" <%= me?'':'open' %>><summary>Your support name and email<%= me?'':' — set these before going online' %></summary><form method="post" action="/commercial-admin/support/profile"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><label class="field">Public support name<input class="input" name="displayName" maxlength="120" value="<%= me?.display_name||account.name %>" required></label><label class="field">Public support contact email<input class="input" type="email" name="contactEmail" maxlength="254" value="<%= me?.contact_email||'support@stockchiefhq.com' %>" required></label><label><input type="checkbox" name="active" value="1" checked> Available for assignment</label><button class="btn" type="submit">Save support profile</button></form></details><script src="/support-chat.js?v=<%= assetVersion %>" defer></script>
