<%# The files sent with one support message. Pictures show small; other files download. %>
<% if((locals.files||[]).length){ %><div class="sup-files"><% for(const file of files){ %><% if(file.image){ %><a class="sup-file sup-file--image" href="<%= base+encodeURIComponent(file.id) %>" target="_blank" rel="noopener" title="<%= file.name %> · <%= file.sizeLabel %>"><img src="<%= base+encodeURIComponent(file.id) %>" alt="<%= file.name %>" loading="lazy"></a><% }else{ %><a class="sup-file" href="<%= base+encodeURIComponent(file.id) %>" download="<%= file.name %>" title="<%= file.name %>"><%- helpers.icon('paperclip',{size:15}) %><span><%= file.name %></span><small><%= file.sizeLabel %></small></a><% } %><% } %></div><% } %>
