<header class="rm-head"><h1>Help and support</h1><p>Message a person at StockChief. Your conversations stay together here.</p></header>

<div class="pro-support-layout"><section class="pro-support-thread" data-support-start data-chat-eligible="<%= supportAccess.chat?'true':'false' %>">
  <header class="pro-support-status"><strong>StockChief Support</strong><p role="status" data-support-live-status><%= !supportAccess.chat?'Send a message. Replies appear here and by email.':presence.online?'Support is online. You are chatting directly with a person.':'Support is offline. Leave a message and we will follow up by email.' %></p></header>
  <div class="pro-support-welcome"><h2>Start a conversation</h2><p>Moshe reads and replies to your message. Please leave out passwords, keys and card details.</p><div class="pro-support-topics"><% for(const topic of ['Connecting a store','Importing inventory','My plan or billing','Something is not working']){ %><button class="btn" type="button" data-support-topic="<%= topic %>"><%= topic %></button><% } %></div></div>
  <form class="pro-support-compose" data-support-start-form method="post" action="/support/message"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="requestKey" value="<%= supportRequestKey %>"><input type="hidden" name="sourcePath" value="<%= locals.supportSourcePath||'' %>"><label for="support-message">Message</label><textarea id="support-message" class="input" name="body" rows="3" maxlength="10000" required placeholder="Write your message…"></textarea><div><small>Your message and replies are saved in this conversation.</small><button class="btn btn--primary" type="submit">Send message</button></div></form>
</section><aside class="pro-support-aside"><h2>Your conversations</h2><% if(!supportRequests.length){ %><p>Your first conversation will appear here.</p><% } %><% for(const request of supportRequests){ %><a href="/support/requests/<%= request.id %>"><strong><%= request.subject %></strong><small><%= request.status==='RESOLVED'?'Resolved':'Open' %> · <%= helpers.dateTime(request.updated_at) %></small></a><% } %><h2>Prefer email?</h2><a href="mailto:support@stockchiefhq.com">support@stockchiefhq.com</a><a href="/guide">Read the guide</a></aside></div><script src="/support-chat.js?v=<%= assetVersion %>" defer></script>
