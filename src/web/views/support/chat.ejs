<header class="rm-head"><div><h1>Help and support</h1><p>Talk to a person at StockChief. Your messages and replies stay together here.</p></div><% if(supportAccess.isOperator){ %><a class="btn" href="/commercial-admin/support">Open your Support desk</a><% } %></header><div class="pro-support-layout"><div><% if(ticket){ %><%- include('thread') %><% }else{ %><section class="pro-support-thread" data-support-start data-chat-eligible="<%= supportAccess.chat?'true':'false' %>"><header class="pro-support-status"><strong>StockChief Support</strong><p role="status" data-support-live-status><%= presence.online&&supportAccess.chat?'Support is online. You are chatting directly with a person.':'Support is offline. Leave a message and we will follow up by email.' %></p></header><div class="pro-support-welcome"><h2>How can we help?</h2><p>A person reads and replies to every request. Please leave out passwords, API keys and card details.</p><div class="pro-support-topics"><% for(const topic of ['Connecting a store','Importing inventory','My plan or billing','Something is not working']){ %><button class="btn" type="button" data-support-topic="<%= topic %>"><%= topic %></button><% } %></div></div><form class="pro-support-compose" data-support-start-form method="post" action="/support/message"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="requestKey" value="<%= supportRequestKey %>"><label for="support-message">Message</label><textarea id="support-message" class="input" name="body" rows="3" maxlength="10000" required placeholder="Write your message…"></textarea><div><small>Replies also arrive by email.</small><button class="btn btn--primary" type="submit">Send message</button></div></form></section><% } %></div><aside class="pro-support-aside"><h2>Your conversations</h2><% if(!supportRequests.length){ %><p>Your first conversation will appear here.</p><% } %><% for(const request of supportRequests){ %><a href="/support/requests/<%= request.id %>"><strong><%= request.subject %></strong><small><%= helpers.dateTime(request.updated_at) %></small></a><% } %><a href="/support/request">Start a separate request</a><h2>Prefer email?</h2><a href="mailto:support@stockchiefhq.com">support@stockchiefhq.com</a><a href="/guide">Read the guide</a></aside></div><script src="/support-chat.js?v=<%= assetVersion %>" defer></script>