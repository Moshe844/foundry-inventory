<%# Attach files to a support message: choose them, drop them on the box, or paste a screenshot. %>
<div class="sup-tray" data-support-tray hidden></div>
<div class="sup-attach"><label class="sup-attach__button"><input class="visually-hidden" type="file" name="attachments" multiple accept="image/*,.pdf,.txt,.csv,.log,.xlsx,.docx" data-support-files><%- helpers.icon('paperclip',{size:16}) %><span>Attach</span></label><small>Paste a screenshot, drop files here, or attach up to 5 (10 MB each).</small></div>
