<header class="rm-head"><h1>Support service agreement</h1><a href="/commercial-admin/support/<%= ticket.id %>">Back to conversation</a></header><% if(staff&&ticket.owner_account_id){ const a=locals.serviceAgreement; %><section class="card card-body"><h2>Prepare the owner's service agreement</h2><p>No deadline or account manager is promised until an actual support contact is configured and the owner accepts the exact terms.</p><form method="post" action="/commercial-admin/support/<%= ticket.id %>/agreement"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><label class="field">Account manager<select class="input" name="managerAccountId"><option value="">No named manager</option><% for(const p of staffProfiles){ %><option value="<%= p.account_id %>" <%= a?.manager_account_id===p.account_id?'selected':'' %>><%= p.display_name %></option><% } %></select></label><label class="field">First-response target (elapsed hours, optional)<input class="input" type="number" min="1" max="720" name="responseHours" value="<%= a?.response_hours||'' %>"></label><label class="field">Exact service and SLA terms<textarea class="input" name="serviceText" maxlength="8000" rows="6" required><%= a?.service_text||'' %></textarea></label><button class="btn" type="submit">Prepare for owner review</button></form></section><% } %>
