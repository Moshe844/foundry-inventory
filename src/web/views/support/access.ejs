<header class="rm-head"><div><h1>Support access permissions</h1><p>Control temporary read-only access to businesses you own.</p></div><a class="btn" href="/support">Help and support</a></header><% if(!grants.length){ %><section class="card card-body"><h2>No support access requests</h2><p>A request appears here when StockChief support needs your permission to inspect business records.</p></section><% } %><% for(const grant of grants){ %><section class="card card-body"><h2><%= grant.workspace_name %></h2><p><%= grant.operator_name %> requests read-only access to <%= grant.scopes.map(s=>({stock:'Inventory',orders:'Orders',purchasing:'Purchasing',money:'Money'})[s]).join(', ') %>.</p><p><%= grant.reason %></p><p><%= grant.duration_minutes %> minutes · <%= grant.status %><%= grant.expires_at?' · Ends '+helpers.dateTime(grant.expires_at):'' %></p><% if(grant.status==='REQUESTED'){ %><form method="post" action="/support/access/<%= grant.id %>/approve"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="btn" type="submit">Approve this read-only access</button></form><% } %><% if(grant.status!=='REVOKED'){ %><form method="post" action="/support/access/<%= grant.id %>/revoke"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="btn" type="submit">Revoke support access</button></form><% } %></section><% } %>
