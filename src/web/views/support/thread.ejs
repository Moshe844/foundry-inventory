<% const staffBase=locals.supportBase||'/commercial-admin/support'; %><section class="pro-support-thread" data-support-conversation data-chat-eligible="<%= staff||ticket.channel==='CHAT'?'true':'false' %>" data-support-staff="<%= staff?'true':'false' %>" data-staff-account="<%= staff?account.id:'' %>" data-history="<%= ticket.history?'true':'false' %>" data-cursor="<%= ticket.messages.at(-1)?.cursor||'' %>" data-time-zone="<%= account.timeZone||'UTC' %>" data-updates-url="<%= staff?staffBase+'/':'/support/requests/' %><%= ticket.id %>/updates"><header class="pro-support-status"><strong><%= staff?'You are replying as StockChief':'StockChief Support' %></strong><p role="status" data-support-live-status><%= ticket.history?'Viewing earlier messages.':staff?'Choose Go online when you are available. Your reply below goes to this customer.':ticket.channel!=='CHAT'?'Send a message. Replies appear here and by email.':locals.presence?.online?'Support is online. You are chatting directly with a person.':'Support is offline. Leave a message and we will follow up by email.' %></p><% if(staff){ %><button class="btn" type="button" data-support-presence aria-pressed="false">Go online for live chat</button><% if(!locals.ownerConsole){ %><a href="<%= staffBase %>/<%= ticket.id %>/service">Service agreement</a><% } %><% } %></header><div class="pro-support-log" data-support-messages role="log" aria-label="Support messages" aria-live="polite"><% if(ticket.earlierCursor){ %><a href="?before=<%= encodeURIComponent(ticket.earlierCursor) %>">Earlier messages</a><% } %><% if(ticket.history){ %><a href="<%= staff?staffBase+'/':'/support/requests/' %><%= ticket.id %>">Return to live conversation</a><% } %><% if(!ticket.history){ %><article class="pro-support-bubble is-customer"><strong><%= staff?'Customer':'You' %></strong><p><%= ticket.body %></p><time><%= helpers.dateTime(ticket.created_at) %></time></article><% } %><% for(const m of ticket.messages){ %><article class="pro-support-bubble <%= m.author_role==='SUPPORT'?'is-support':'is-customer' %>" data-message-id="<%= m.id %>"><strong><%= m.author_role==='SUPPORT'?m.display_name||'StockChief Support':staff?'Customer':'You' %></strong><p><%= m.body %></p><time datetime="<%= new Date(m.created_at).toISOString() %>"><%= helpers.dateTime(m.created_at) %></time></article><% } %></div><form class="pro-support-compose" data-support-reply method="post" action="<%= staff?staffBase+'/':'/support/requests/' %><%= ticket.id %>/reply"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="requestKey" value="<%= messageKey %>"><label for="support-message"><%= staff?'Reply to customer':'Message' %></label><textarea id="support-message" class="input" name="body" rows="3" maxlength="10000" required placeholder="Write your message…"></textarea><div><small>Your message is saved here and its notification is emailed.</small><button class="btn btn--primary" type="submit">Send message</button></div></form></section><% if(staff){ %><form method="post" action="<%= staffBase %>/<%= ticket.id %>/resolve"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="btn" type="submit">Mark resolved</button></form><% } %>