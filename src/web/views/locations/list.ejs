<div class="page-head">
  <div class="titles">
    <h1>Locations</h1>
    <div class="page-sub">Buildings and the exact zones, aisles, shelves, bins, docks or staging areas inside them.</div>
  </div>
  <% if (currentUser.role === 'owner') { %>
    <div class="page-actions">
      <button class="btn btn--primary" type="button" data-modal-open="modal-location"><%- helpers.icon('plus', { size: 16 }) %> Add location</button>
    </div>
  <% } %>
</div>

<div class="card">
  <% if (locations.length === 0) { %>
    <div class="empty">
      <div class="icon-wrap"><%- helpers.icon('locations', { size: 22 }) %></div>
      <h3>No locations yet</h3>
      <p>Add the first place stock can live. Add bins only when they are real; StockChief never invents them.</p>
      <% if (currentUser.role === 'owner') { %>
        <button class="btn btn--primary" type="button" data-modal-open="modal-location">Add your first location</button>
      <% } %>
    </div>
  <% } else { %>
    <div class="table-wrap">
      <table class="table table--stack">
        <thead>
          <tr><th>Location</th><th>Type</th><th class="right">Distinct items</th><th class="right">Units on hand</th><th></th></tr>
        </thead>
        <tbody>
          <% locations.forEach(function (location) { %>
            <tr>
              <td class="cell-main">
                <a class="cell-title" style="padding-left:<%= location.depth * 18 %>px" href="/inventory?location=<%= location.id %>"><%= location.depth ? '↳ ' : '' %><%= location.name %></a>
                <% if (location.barcode) { %><span class="cell-sub">Scan code: <%= location.barcode %> · <a href="/warehouse/labels/location/<%= location.id %>">Print label</a></span><% } %>
                <% if (location.note) { %><span class="cell-sub"><%= location.note %></span><% } %>
                <% if (!location.is_active) { %><span class="badge badge--muted">Archived</span><% } %>
              </td>
              <td data-label="Type"><span class="badge"><%= helpers.locationKindLabel(location.kind) %></span></td>
              <td class="right" data-label="Items"><span class="num"><%= helpers.qty(location.sku_count) %></span></td>
              <td class="right cell-end" data-label="On hand"><strong class="num"><%= helpers.qty(location.on_hand) %></strong></td>
              <td class="right cell-full">
                <% if (currentUser.role === 'owner') { %>
                  <div class="btn-row" style="justify-content:flex-end;">
                    <button class="btn btn--ghost btn--sm" type="button" data-modal-open="modal-location-<%= location.id %>">Edit</button>
                    <% if (location.is_active) { %>
                      <form method="post" action="/locations/<%= location.id %>/archive" data-confirm="Archive <%= location.name %>?">
                        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                        <button class="btn btn--ghost btn--sm" type="submit">Archive</button>
                      </form>
                    <% } else { %>
                      <form method="post" action="/locations/<%= location.id %>/archive">
                        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                        <input type="hidden" name="restore" value="1">
                        <button class="btn btn--ghost btn--sm" type="submit">Restore</button>
                      </form>
                    <% } %>
                  </div>
                <% } %>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  <% } %>
</div>

<% if (currentUser.role !== 'owner') { %>
  <div class="notice" style="margin-top:14px;">
    <%- helpers.icon('shield', { size: 16 }) %>
    <span>Only an owner can add or change locations. You can still move stock between them.</span>
  </div>
<% } %>

<% if (currentUser.role === 'owner') { %>
  <dialog class="modal" id="modal-location">
    <form method="post" action="/locations">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <div class="modal-head">
        <h2>Add a location</h2>
        <button class="btn btn--ghost btn--sm close" type="button" data-modal-close aria-label="Close"><%- helpers.icon('close', { size: 16 }) %></button>
      </div>
      <div class="modal-body">
        <div class="field">
          <label class="label" for="location-name">Name</label>
          <input class="input" id="location-name" name="name" required placeholder="Main Warehouse">
        </div>
        <div class="field">
          <label class="label" for="location-kind">Type</label>
          <select class="select" id="location-kind" name="kind" required>
            <% helpers.LOCATION_KINDS.forEach(function (kind) { %>
              <option value="<%= kind.id %>"><%= kind.label %></option>
            <% }) %>
          </select>
        </div>
        <div class="field">
          <label class="label" for="location-parent">Inside <span class="optional">optional</span></label>
          <select class="select" id="location-parent" name="parentLocationId"><option value="">Top-level location</option><% locations.filter(l => l.is_active).forEach(function(parent) { %><option value="<%= parent.id %>"><%= parent.display_path %></option><% }) %></select>
          <p class="field-hint">Use this for a real zone, aisle, shelf, bin, dock or staging area inside another location.</p>
        </div>
        <div class="field"><label class="label" for="location-barcode">Scan code <span class="optional">recommended</span></label><input class="input" id="location-barcode" name="barcode" autocomplete="off" placeholder="BIN-A-01-02"></div>
        <div class="field"><label class="label" for="location-sequence">Pick sequence</label><input class="input" id="location-sequence" name="pickSequence" type="number" min="0" step="1" value="0"></div>
        <div class="field">
          <%#
            Its own field rather than a line in the note, because a carrier
            needs it as an address and will not quote a rate without one.
            Optional: most locations never post anything, and a stockroom does
            not need a postal address to hold stock.
          %>
          <label class="label" for="location-address">Postal address <span class="optional">optional</span></label>
          <textarea class="input textarea" id="location-address" name="address" rows="3"
            placeholder="12 Depot Road&#10;Monroe, NY 10950"></textarea>
          <p class="field-hint">
            Where parcels leave from. Needed only to buy a shipping label, and StockChief asks for it
            once rather than filling it in on your behalf.
          </p>
        </div>
        <div class="field">
          <label class="label" for="location-note">Note <span class="optional">optional</span></label>
          <input class="input" id="location-note" name="note" placeholder="Floor, aisle, or who runs it">
        </div>
      </div>
      <div class="modal-foot">
        <button class="btn" type="button" data-modal-close>Cancel</button>
        <button class="btn btn--primary" type="submit">Add location</button>
      </div>
    </form>
  </dialog>

  <% locations.forEach(function (location) { %>
    <dialog class="modal" id="modal-location-<%= location.id %>">
      <form method="post" action="/locations/<%= location.id %>">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <div class="modal-head">
          <h2>Edit <%= location.name %></h2>
          <button class="btn btn--ghost btn--sm close" type="button" data-modal-close aria-label="Close"><%- helpers.icon('close', { size: 16 }) %></button>
        </div>
        <div class="modal-body">
          <div class="field">
            <label class="label" for="edit-name-<%= location.id %>">Name</label>
            <input class="input" id="edit-name-<%= location.id %>" name="name" value="<%= location.name %>" required>
          </div>
          <div class="field">
            <label class="label" for="edit-kind-<%= location.id %>">Type</label>
            <select class="select" id="edit-kind-<%= location.id %>" name="kind" required>
              <% helpers.LOCATION_KINDS.forEach(function (kind) { %>
                <option value="<%= kind.id %>" <%= location.kind === kind.id ? 'selected' : '' %>><%= kind.label %></option>
              <% }) %>
            </select>
          </div>
          <div class="field"><label class="label" for="edit-parent-<%= location.id %>">Inside</label><select class="select" id="edit-parent-<%= location.id %>" name="parentLocationId"><option value="">Top-level location</option><% locations.filter(l => l.id !== location.id && l.is_active).forEach(function(parent) { %><option value="<%= parent.id %>" <%= location.parent_location_id === parent.id ? 'selected' : '' %>><%= parent.display_path %></option><% }) %></select></div>
          <div class="field"><label class="label" for="edit-barcode-<%= location.id %>">Scan code</label><input class="input" id="edit-barcode-<%= location.id %>" name="barcode" value="<%= location.barcode || '' %>"></div>
          <div class="field"><label class="label" for="edit-sequence-<%= location.id %>">Pick sequence</label><input class="input" id="edit-sequence-<%= location.id %>" name="pickSequence" type="number" min="0" value="<%= location.pick_sequence || 0 %>"></div>
          <div class="field">
            <label class="label" for="edit-address-<%= location.id %>">Postal address</label>
            <textarea class="input textarea" id="edit-address-<%= location.id %>" name="address" rows="3"
              placeholder="12 Depot Road&#10;Monroe, NY 10950"><%= location.address || '' %></textarea>
            <p class="field-hint">Where parcels leave from, for buying a shipping label.</p>
          </div>
          <div class="field">
            <label class="label" for="edit-note-<%= location.id %>">Note</label>
            <input class="input" id="edit-note-<%= location.id %>" name="note" value="<%= location.note || '' %>">
          </div>
        </div>
        <div class="modal-foot">
          <button class="btn" type="button" data-modal-close>Cancel</button>
          <button class="btn btn--primary" type="submit">Save</button>
        </div>
      </form>
    </dialog>
  <% }) %>
<% } %>
