<%
  /*
   * Settings is the technical half. The owner-facing half — the standing rules
   * in the words they were said — is at /what-you-told-me, and this page links
   * to it rather than competing with it.
   *
   * What this replaced was eight sections of identically-weighted cards: a list
   * of destinations, a stock-guard list, rule history, a live feed with a code
   * sample, the plan, the people, the account, an Advanced heading and an
   * integrity check. Every one looked the same, so nothing on the page had a
   * shape and finding anything meant reading all of it.
   *
   * Now: where to go, as a grid of real destinations with icons; then the
   * facts about this inventory; then everything technical behind disclosures
   * that are closed until somebody wants them.
   */
  var isOwner = currentUser.role === 'owner';
%>

<div class="rm-head">
  <p class="rm-head__eyebrow"><%- helpers.icon('settings', { size: 14 }) %> Settings</p>
  <h1>The technical side of this inventory.</h1>
  <p>
    What StockChief may do, where stock lives, who can see it, and the record behind its decisions.
    What you have <em>told</em> StockChief — the standing rules in your own words — lives on its own page.
  </p>
</div>

<section class="rm-panel" aria-label="Sample and test data">
  <div class="rm-panel__body">
    <h2>Sample and test data</h2>
    <p>Sample data lives in a separate test inventory. It cannot be converted to a real inventory. Clear it and import your own records to start operating.</p>
    <% if (isOwner) { %>
      <form method="post" action="/onboarding/sample/load">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <button class="rm-btn rm-btn--ghost" type="submit">Load sample data to explore</button>
      </form>
      <details class="rm-disclosure">
        <summary>Create a separate empty test inventory</summary>
        <form method="post" action="/settings/test-inventory">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <label class="rm-field"><span>Test inventory name</span><input name="name" maxlength="120" required value="Test inventory" placeholder="e.g. Training inventory"></label>
          <button class="rm-btn rm-btn--ghost" type="submit">Create a test inventory</button>
        </form>
      </details>
    <% } %>
    <p><a href="/onboarding?add=1">Add another inventory source</a> · <a href="/settings/ingestion">Set up ongoing email-attachment ingestion</a></p>
  </div>
</section>

<div class="rm-next">
  <p class="rm-stamp"><%- helpers.icon('chat', { size: 13 }) %> Most things are set by saying them</p>
  <p class="rm-next__t">StockChief is taught by talking to it, not by filling in this page.</p>
  <p class="rm-next__d">Tell it a rule and it writes the rule down for you to check, change or take away.</p>
  <p class="rm-choices" style="margin-top:11px">
    <a class="rm-btn rm-btn--sm" href="/what-you-told-me">What you've told me</a>
    <a class="rm-btn rm-btn--ghost rm-btn--sm" href="/ask">Tell StockChief something</a>
  </p>
</div>

<%# ------------------------------------------------------------ destinations %>
<p class="rm-stamp"><%- helpers.icon('bolt', { size: 14 }) %> How StockChief runs this inventory</p>
<div class="rm-choices-grid" style="margin-bottom:18px">
  <a class="rm-choice" href="/autopilot">
    <span class="rm-choice__ic"><%- helpers.icon('shield', { size: 19 }) %></span>
    <span class="rm-choice__t">Standing authority</span>
    <span class="rm-choice__b">Whether StockChief asks first, or handles routine work inside limits you set.</span>
    <span class="rm-choice__go">Open <%- helpers.icon('arrowRight', { size: 14 }) %></span>
  </a>
  <a class="rm-choice" href="/purchasing/setup">
    <span class="rm-choice__ic"><%- helpers.icon('purchasing', { size: 19 }) %></span>
    <span class="rm-choice__t">Reorder rules</span>
    <span class="rm-choice__b">Reorder points, targets, safety stock and who supplies what.</span>
    <span class="rm-choice__go">Open <%- helpers.icon('arrowRight', { size: 14 }) %></span>
  </a>
  <a class="rm-choice" href="/foundry">
    <span class="rm-choice__ic"><%- helpers.icon('spark', { size: 19 }) %></span>
    <span class="rm-choice__t">How stock is tracked</span>
    <span class="rm-choice__b">What you call things, and whether they need variants, serials or lots.</span>
    <span class="rm-choice__go">Open <%- helpers.icon('arrowRight', { size: 14 }) %></span>
  </a>
</div>

<p class="rm-stamp"><%- helpers.icon('layers', { size: 14 }) %> Your operation</p>
<div class="rm-choices-grid" style="margin-bottom:18px">
  <a class="rm-choice" href="/locations">
    <span class="rm-choice__ic"><%- helpers.icon('locations', { size: 19 }) %></span>
    <span class="rm-choice__t">Locations</span>
    <span class="rm-choice__b">Where stock is kept and moved between.</span>
    <span class="rm-choice__go">Open <%- helpers.icon('arrowRight', { size: 14 }) %></span>
  </a>
  <a class="rm-choice" href="/suppliers">
    <span class="rm-choice__ic"><%- helpers.icon('purchasing', { size: 19 }) %></span>
    <span class="rm-choice__t">Suppliers</span>
    <span class="rm-choice__b">Who you buy from, on what terms, at what lead time.</span>
    <span class="rm-choice__go">Open <%- helpers.icon('arrowRight', { size: 14 }) %></span>
  </a>
  <a class="rm-choice" href="/settings/connections">
    <span class="rm-choice__ic"><%- helpers.icon('link', { size: 19 }) %></span>
    <span class="rm-choice__t">Connections</span>
    <span class="rm-choice__b">Mailbox, shop, payments and carrier — what keeps StockChief informed.</span>
    <span class="rm-choice__go">Manage <%- helpers.icon('arrowRight', { size: 14 }) %></span>
  </a>
  <a class="rm-choice" href="/settings/shipping">
    <span class="rm-choice__ic"><%- helpers.icon('ship', { size: 19 }) %></span>
    <span class="rm-choice__t">Shipping</span>
    <span class="rm-choice__b">Which carrier and service StockChief may buy on its own, and up to what.</span>
    <span class="rm-choice__go">Open <%- helpers.icon('arrowRight', { size: 14 }) %></span>
  </a>
  <a class="rm-choice" href="/imports">
    <span class="rm-choice__ic"><%- helpers.icon('import', { size: 19 }) %></span>
    <span class="rm-choice__t">Imports</span>
    <span class="rm-choice__b">Bring in spreadsheets, and review the exact changes first.</span>
    <span class="rm-choice__go">Open <%- helpers.icon('arrowRight', { size: 14 }) %></span>
  </a>
  <% if (isOwner) { %><a class="rm-choice" href="/settings/operations">
    <span class="rm-choice__ic"><%- helpers.icon('shield', { size: 19 }) %></span>
    <span class="rm-choice__t">Production operations</span>
    <span class="rm-choice__b">Readiness gates, alerts, backups, restore evidence and dead-letter review.</span>
    <span class="rm-choice__go">Review <%- helpers.icon('arrowRight', { size: 14 }) %></span>
  </a><% } %>
</div>

<%# ------------------------------------------------------- stock protection %>
<section class="rm-panel" style="margin-bottom:16px" id="email-alerts">
  <div class="rm-panel__head">
    <%- helpers.icon('mail', { size: 15, className: 'rm-quiet' }) %>
    <h2>Automatic email alerts<%= emailAlerts.enabled ? ' are on' : '' %></h2>
    <span class="right"><span class="rm-pillbadge <%= emailAlerts.enabled && emailAlerts.deliveryConfigured ? 'is-ok' : emailAlerts.enabled ? 'is-warn' : '' %>">
      <%= emailAlerts.enabled && emailAlerts.deliveryConfigured ? 'on'
        : emailAlerts.enabled ? 'waiting for sender' : 'off' %>
    </span></span>
  </div>
  <form method="post" action="/settings/email-alerts" style="padding:16px">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <label class="rm-field">
      <span><input type="checkbox" name="enabled" value="1" <%= emailAlerts.enabled ? 'checked' : '' %> <%= isOwner ? '' : 'disabled' %>> Email me when something newly needs attention</span>
      <small>StockChief sends one email when the item opens. Rechecking the same condition does not send another.</small>
    </label>
    <label class="rm-field">
      <span>Which items</span>
      <select name="minimumSeverity" <%= isOwner ? '' : 'disabled' %>>
        <option value="critical" <%= emailAlerts.minimumSeverity === 'critical' ? 'selected' : '' %>>Critical only</option>
        <option value="important" <%= emailAlerts.minimumSeverity === 'important' ? 'selected' : '' %>>Important and critical</option>
        <option value="all" <%= emailAlerts.minimumSeverity === 'all' ? 'selected' : '' %>>Everything, including watch items</option>
      </select>
    </label>
    <label class="rm-field">
      <span>Recipients</span>
      <textarea name="recipients" rows="2" <%= isOwner ? '' : 'disabled' %>><%= emailAlerts.recipients.join('\n') %></textarea>
      <small>One or more email addresses, separated by a new line or comma. Each email contains a direct link to the decision.</small>
    </label>
    <% if (!emailAlerts.deliveryConfigured) { %>
      <div class="rm-note rm-note--warn" style="margin-bottom:12px">
        <%- helpers.icon('alert', { size: 16 }) %>
        <span><strong>Delivery is not configured on this server yet.</strong><br>
          Add a verified sender in <code>FOUNDRY_FROM_EMAIL</code> and a Resend key in <code>RESEND_API_KEY</code>. The preferences above can be saved now; emails begin with future events after delivery is configured.</span>
      </div>
    <% } %>
    <% if (isOwner) { %><div class="rm-choices">
      <button class="rm-btn rm-btn--sm" type="submit">Save email alerts</button>
    </div><% } %>
  </form>
  <% if (isOwner && emailAlerts.enabled) { %>
    <form method="post" action="/settings/email-alerts/test" style="padding:0 16px 16px">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <button class="rm-btn rm-btn--ghost rm-btn--sm" type="submit">Send a test email</button>
    </form>
  <% } %>
</section>

<% if (stockGuards.length) { %>
  <section class="rm-panel" style="margin-bottom:16px" id="stock-protection">
    <div class="rm-panel__head">
      <%- helpers.icon('shield', { size: 15, className: 'rm-quiet' }) %>
      <h2>Stock protection &amp; alerts</h2>
      <span class="right"><%= stockGuards.length %> active</span>
    </div>
    <div class="rm-told" style="border:0;border-radius:0;box-shadow:none">
      <% stockGuards.forEach(function (rule) { %>
        <div class="rm-told__row">
          <span class="rm-told__t">
            <%= rule.itemName %><%= rule.variantLabel ? ' / ' + rule.variantLabel : '' %><%= rule.locationName ? ' at ' + rule.locationName : '' %>
            <small>
              <% if (rule.enforcementMode === 'warn') { %>
                Warn when on-hand stock is <%= rule.boundary.blockedWhen %>. Outgoing stock stays allowed.
              <% } else { %>
                Block a sale or issue that would leave stock <%= rule.boundary.blockedWhen %>.
                <%= rule.boundary.permittedExplanation %>
                <%= rule.releaseCondition === 'on_order' ? 'Resume after a supplier order is placed.'
                  : rule.releaseCondition === 'stock_recovered' ? 'Resume after on-hand stock recovers to ' + rule.releaseThreshold + '.'
                  : 'An owner must release it.' %>
              <% } %>
            </small>
          </span>
          <span class="rm-told__m">
            <span class="rm-pillbadge <%= rule.enforcementMode === 'warn' ? '' : 'is-warn' %>">
              <%= rule.enforcementMode === 'warn' ? 'warns' : 'blocks' %>
            </span>
            <% if (rule.instructionId) { %><a href="/operating-instructions/<%= rule.instructionId %>">Manage</a><% } %>
          </span>
        </div>
      <% }) %>
    </div>
  </section>
<% } %>

<%# ------------------------------------------------------------- the facts %>
<div class="rm-split" style="margin-bottom:16px">
  <div class="rm-stack">
    <section class="rm-panel">
      <div class="rm-panel__head">
        <%- helpers.icon('user', { size: 15, className: 'rm-quiet' }) %>
        <h2>People</h2>
        <span class="right">
          <% if (isOwner) { %>
            <button class="rm-btn rm-btn--sm rm-btn--ghost" type="button" data-modal-open="modal-person">
              <%- helpers.icon('plus', { size: 13 }) %> Add person
            </button>
          <% } %>
        </span>
      </div>
      <div class="rm-told" style="border:0;border-radius:0;box-shadow:none">
        <% users.forEach(function (user) { %>
          <div class="rm-told__row">
            <span class="rm-told__t">
              <%= user.name %><%= user.id === currentUser.id ? ' (you)' : '' %>
              <small><%= user.email %></small>
            </span>
            <span class="rm-told__m"><span class="rm-pillbadge"><%= helpers.roleLabel(user.role) %></span></span>
          </div>
        <% }) %>
      </div>
      <p class="rm-quiet" style="font-size:12.5px;padding:12px 16px;border-top:1px solid var(--line-2);margin:0">
        Owners manage locations, people and settings. Staff do the day-to-day inventory work.
      </p>
    </section>

    <section class="rm-panel">
      <div class="rm-panel__head">
        <%- helpers.icon('inventory', { size: 15, className: 'rm-quiet' }) %>
        <h2>This inventory</h2>
      </div>
      <form method="post" action="/settings/workspace" style="padding:16px">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <label class="rm-field">
          <span>Inventory name</span>
          <input type="text" id="workspace-name" name="name" value="<%= workspace.name %>" required <%= isOwner ? '' : 'disabled' %>>
          <small>
            Shown in the switcher and on every screen your team uses. This names the whole
            inventory, not a place inside it — <a href="/locations">locations</a> live within it.
          </small>
        </label>
        <% if (isOwner) { %><button class="rm-btn rm-btn--sm" type="submit">Save</button><% } %>
      </form>
    </section>
  </div>

  <div class="rm-stack">
    <section class="rm-panel">
      <div class="rm-panel__head">
        <%- helpers.icon('wallet', { size: 15, className: 'rm-quiet' }) %>
        <h2>Your plan</h2>
        <span class="right"><span class="rm-pillbadge"><%= entitlements.plan.label %></span></span>
      </div>
      <div class="rm-told" style="border:0;border-radius:0;box-shadow:none">
        <% entitlements.limits.forEach(function (limit) { %>
          <%
            var label = { workspaces: 'Inventories', members: 'People on this inventory',
              locations: 'Locations here', skus: 'Tracked variants here' }[limit.key] || limit.key;
            var pct = limit.unlimited || !limit.limit
              ? 0 : Math.min(100, Math.round((limit.used / limit.limit) * 100));
          %>
          <div class="rm-told__row">
            <span class="rm-told__t">
              <%= label %>
              <% if (!limit.unlimited) { %>
                <span class="rm-meter <%= pct >= 90 ? 'is-flag' : '' %>" style="margin-top:6px;max-width:200px">
                  <span style="width:<%= Math.max(3, pct) %>%"></span>
                </span>
              <% } %>
            </span>
            <span class="rm-told__m">
              <%= limit.used %><% if (!limit.unlimited) { %> of <%= limit.limit %><% } else { %> · unlimited<% } %>
            </span>
          </div>
        <% }) %>
      </div>
      <p class="rm-quiet" style="font-size:12.5px;padding:12px 16px;border-top:1px solid var(--line-2);margin:0">
        Inventories are counted across your whole account; everything else within this one.
      </p>
    </section>

    <% if (locals.aiUsage) { var ai = aiUsage; var k = function (n) { return n >= 1000000 ? (n / 1000000).toFixed(1) + 'M' : n >= 1000 ? Math.round(n / 1000) + 'k' : String(n); }; %>
    <%#
      What StockChief's model reads have cost this inventory, from the call
      record: today against the day's allowance, the last thirty days, how
      many answers needed no model at all, and what the reads were for.
    %>
    <section class="rm-panel" id="ai-usage">
      <div class="rm-panel__head">
        <%- helpers.icon('chat', { size: 15, className: 'rm-quiet' }) %>
        <h2>AI reading</h2>
        <span class="right"><span class="rm-pillbadge"><%= ai.today.calls %> read<%= ai.today.calls === 1 ? '' : 's' %> today</span></span>
      </div>
      <div class="rm-told" style="border:0;border-radius:0;box-shadow:none">
        <div class="rm-told__row">
          <span class="rm-told__t">Today’s allowance
            <span class="rm-meter <%= ai.today.pct >= 90 ? 'is-flag' : '' %>" style="margin-top:6px;max-width:200px"><span style="width:<%= Math.max(3, ai.today.pct) %>%"></span></span>
          </span>
          <span class="rm-told__m"><%= k(ai.today.tokens) %> of <%= k(ai.today.allowance) %> tokens</span>
        </div>
        <div class="rm-told__row">
          <span class="rm-told__t">Last 30 days</span>
          <span class="rm-told__m"><%= ai.month.calls %> model read<%= ai.month.calls === 1 ? '' : 's' %> · <%= k(ai.month.tokens) %> tokens<% if (ai.month.calls) { %> · <%= (ai.month.avgMs / 1000).toFixed(1) %> s each<% } %></span>
        </div>
        <% if (ai.goals.total) { %>
        <div class="rm-told__row">
          <span class="rm-told__t">Things you asked for</span>
          <span class="rm-told__m"><%= ai.goals.total %> in all · <%= ai.goals.inCode %> answered in code without a model</span>
        </div>
        <% } %>
        <% if (ai.month.failed || ai.month.refused) { %>
        <div class="rm-told__row">
          <span class="rm-told__t">Reads that did not finish</span>
          <span class="rm-told__m"><% if (ai.month.failed) { %><%= ai.month.failed %> timed out or failed<% } %><% if (ai.month.failed && ai.month.refused) { %> · <% } %><% if (ai.month.refused) { %><%= ai.month.refused %> stopped by a ceiling or a refusal<% } %></span>
        </div>
        <% } %>
        <% ai.purposes.forEach(function (p) { %>
        <div class="rm-told__row">
          <span class="rm-told__t rm-quiet" style="padding-left:14px"><%= p.label %></span>
          <span class="rm-told__m"><%= p.calls %> · <%= k(p.tokens) %> tokens</span>
        </div>
        <% }) %>
      </div>
      <p class="rm-quiet" style="font-size:12.5px;padding:12px 16px;border-top:1px solid var(--line-2);margin:0">
        Ceilings for this inventory: <%= ai.limits.concurrent %> reads at once, <%= ai.limits.perMinute %> a minute, <%= k(ai.limits.tokensPerDay) %> tokens a day. Lookups StockChief does in code cost nothing and are not counted. Prompts are kept redacted for 30 days; no record values are stored with them.
      </p>
    </section>
    <% } %>

    <section class="rm-panel">
      <div class="rm-panel__head">
        <%- helpers.icon(integrity.ok ? 'shield' : 'alert', { size: 15, className: 'rm-quiet' }) %>
        <h2>Inventory integrity</h2>
        <span class="right">
          <span class="rm-pillbadge <%= integrity.ok ? 'is-ok' : 'is-warn' %>">
            <%= integrity.ok ? 'all balanced' : integrity.problems.length + ' to check' %>
          </span>
        </span>
      </div>
      <div style="padding:14px 16px">
        <% if (integrity.ok) { %>
          <p style="font-size:13.5px;color:var(--ink-2);margin:0">
            Every balance matches its movement history, lot quantities and tracked units.
          </p>
        <% } else { %>
          <ul class="plain-list" style="font-family:var(--f-num);font-size:12px">
            <% integrity.problems.slice(0, 10).forEach(function (problem) { %>
              <li><%= problem.kind %>: <%= problem.detail %></li>
            <% }) %>
          </ul>
        <% } %>
        <p class="rm-quiet" style="font-size:12.5px;margin:10px 0 0">
          Recomputed from the ledger every time you open this page.
        </p>
      </div>
    </section>

    <section class="rm-panel">
      <div class="rm-panel__head">
        <%- helpers.icon('user', { size: 15, className: 'rm-quiet' }) %>
        <h2>Your account</h2>
      </div>
      <div class="rm-told" style="border:0;border-radius:0;box-shadow:none">
        <div class="rm-told__row"><span class="rm-told__t">Name</span><span class="rm-told__m"><%= currentUser.name %></span></div>
        <div class="rm-told__row"><span class="rm-told__t">Email</span><span class="rm-told__m"><%= currentUser.email %></span></div>
        <div class="rm-told__row"><span class="rm-told__t">Role</span><span class="rm-told__m"><%= helpers.roleLabel(currentUser.role) %></span></div>
      </div>
    </section>
  </div>
</div>

<%# --------------------------------------------------------------- advanced %>
<%# Everything below is for auditing and integrating. It is real and it is
    kept, but it is not what somebody opens Settings to change, so it is closed
    until they want it. %>
<p class="rm-stamp"><%- helpers.icon('serial', { size: 14 }) %> Advanced — the record behind StockChief's decisions, and the ways in</p>

<% if (learnedInstructions.length) { %>
  <details class="card advanced-settings" id="learned-instructions">
    <summary>Rule history · <%= learnedInstructions.length %> record<%= learnedInstructions.length === 1 ? '' : 's' %></summary>
    <div class="rm-work__body">
      <div class="rm-told" style="border:0;border-radius:0;box-shadow:none">
        <% learnedInstructions.forEach(function (instruction) { %>
          <div class="rm-told__row">
            <span class="rm-told__t">
              <%= instruction.status === 'APPROVED' ? 'Current instruction'
                : instruction.status === 'SUPERSEDED' ? 'Previous instruction' : 'Removed instruction' %>
              <small>“<%= instruction.statedAs %>”</small>
            </span>
            <span class="rm-told__m"><a href="/operating-instructions/<%= instruction.id %>">Inspect</a></span>
          </div>
        <% }) %>
      </div>
    </div>
  </details>
<% } %>

<details class="rm-work" style="margin:0 0 12px" id="live-event-feed" <%= newFeedToken || eventFeed.connected ? 'open' : '' %>>
  <summary>
    Live operating feed ·
    <%= eventFeed.connected ? 'Connected' : eventFeed.configured ? 'Waiting for first event' : 'Not configured' %>
  </summary>
  <div class="rm-work__body">
    <p style="font-size:13.5px;color:var(--ink-2);margin:0 0 14px;max-width:70ch">
      Sales and warehouse systems can push real movements to StockChief as they happen. Event IDs are
      idempotent: retrying one never moves stock twice.
    </p>

    <% if (newFeedToken) { %>
      <div class="rm-note rm-note--warn">
        <%- helpers.icon('alert', { size: 16 }) %>
        <span>
          <strong>Copy this token now — it will not be shown again.</strong>
          <input class="rm-field" style="font-family:var(--f-num);margin-top:6px" value="<%= newFeedToken %>"
                 readonly aria-label="New event feed token" onclick="this.select()">
        </span>
      </div>
    <% } %>

    <label class="rm-field">
      <span>Event endpoint</span>
      <input style="font-family:var(--f-num)" value="<%= origin %>/api/v1/feed/events" readonly
             aria-label="Event feed endpoint" onclick="this.select()">
      <small>Authenticate with <code style="font-family:var(--f-num)">Authorization: Bearer YOUR_TOKEN</code>.</small>
    </label>

    <details style="margin-bottom:14px">
      <summary style="font-size:13px;font-weight:600;color:var(--muted);cursor:pointer">Event format</summary>
      <pre style="margin-top:10px;padding:12px;background:var(--surface-3);border:1px solid var(--line);border-radius:var(--r-sm);overflow:auto;font-family:var(--f-num);font-size:12px">{
  "eventId": "sale-10482-line-1",
  "type": "sale",
  "skuCode": "SH-101-BLK-23",
  "locationName": "Main Warehouse",
  "quantity": 2,
  "occurredAt": "2026-08-17T14:30:00Z"
}</pre>
      <p class="rm-quiet" style="font-size:12.5px">
        Also supported: receive, customer_return, damage, count, adjustment and transfer. Use
        <code style="font-family:var(--f-num)">supplierCode</code> when an external system knows the
        vendor's code rather than StockChief's SKU.
      </p>
    </details>

    <% if (isOwner) { %>
      <div class="rm-choices">
        <% if (eventFeed.configured) { %>
          <form method="post" action="/settings/event-feed/enable" data-confirm="Rotate the feed token? The existing token will stop working immediately." style="margin:0">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <button class="rm-btn rm-btn--ghost rm-btn--sm" type="submit">Rotate token</button>
          </form>
          <form method="post" action="/settings/event-feed/disconnect" data-confirm="Disconnect the live feed and revoke its token?" style="margin:0">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <button class="rm-btn rm-btn--ghost rm-btn--sm" type="submit">Disconnect</button>
          </form>
        <% } else { %>
          <form method="post" action="/settings/event-feed/enable" style="margin:0">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <button class="rm-btn rm-btn--sm" type="submit">Connect live feed</button>
          </form>
        <% } %>
      </div>
    <% } %>

    <% if (eventFeed.recentEvents.length) { %>
      <p class="rm-stamp" style="margin-top:16px">Recent events</p>
      <div class="rm-feed">
        <% eventFeed.recentEvents.slice(0, 6).forEach(function (event) { %>
          <div class="rm-feed__row" style="padding-left:0;padding-right:0">
            <span class="rm-feed__ic <%= event.status === 'COMPLETED' ? 'is-done' : 'is-flag' %>">
              <%- helpers.icon(event.status === 'COMPLETED' ? 'check' : 'alert', { size: 14 }) %>
            </span>
            <span class="rm-feed__t">
              <%= event.eventId %>
              <small><%= event.type %> · <%= helpers.timeAgo(event.processedAt) %><% if (event.error) { %> · <%= event.error %><% } %></small>
            </span>
            <span class="rm-feed__m"><%= event.status %></span>
          </div>
        <% }) %>
      </div>
    <% } %>
  </div>
</details>

<p class="rm-disclose">
  <a href="/autopilot/history">System &amp; audit — what StockChief checked, decided and carried out</a>
  <% if (isOwner) { %><a href="/settings/export">Export this inventory</a><% } %>
  <a href="/what-you-told-me">What you've told me</a>
  <a href="/everything">Everything else</a>
</p>

<% if (isOwner) { %>
  <dialog class="modal" id="modal-person">
    <form method="post" action="/settings/people">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <div class="modal-head">
        <h2>Add a person</h2>
        <button class="btn btn--ghost btn--sm close" type="button" data-modal-close aria-label="Close"><%- helpers.icon('close', { size: 16 }) %></button>
      </div>
      <div class="modal-body">
        <label class="rm-field"><span>Name</span><input type="text" id="person-name" name="name" required></label>
        <label class="rm-field"><span>Email</span><input type="email" id="person-email" name="email" required></label>
        <label class="rm-field">
          <span>Temporary password</span>
          <input type="text" id="person-password" name="password" minlength="8" required>
          <small>At least 8 characters. Share it with them directly.</small>
        </label>
        <label class="rm-field">
          <span>Role</span>
          <select id="person-role" name="role" required>
            <% helpers.ROLES.forEach(function (role) { %>
              <option value="<%= role.id %>" <%= role.id === 'staff' ? 'selected' : '' %>><%= role.label %> — <%= role.blurb %></option>
            <% }) %>
          </select>
        </label>
      </div>
      <div class="modal-foot">
        <button class="rm-btn rm-btn--ghost" type="button" data-modal-close>Cancel</button>
        <button class="rm-btn" type="submit">Add person</button>
      </div>
    </form>
  </dialog>
<% } %>
