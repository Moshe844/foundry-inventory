<div class="page-head">
  <div class="titles">
    <h1>Settings</h1>
    <div class="page-sub">This inventory, the people on it, and what your plan allows.</div>
  </div>
</div>

<div class="grid grid--sidebar">
  <div class="grid">
    <div class="card">
      <div class="card-head"><h2>How Foundry manages this inventory</h2></div>
      <div class="card-body grid">
        <a class="list-row" href="/purchasing/setup"><div><strong>Stock management</strong><p>Foundry managed · adjust reorder points, targets, safety stock and suppliers.</p></div><span>Adjust rules</span></a>
        <a class="list-row" href="/autopilot"><div><strong>Automatic work</strong><p>Choose whether Foundry asks first or handles routine work inside your limits.</p></div><span>Choose</span></a>
        <a class="list-row" href="/locations"><div><strong>Locations</strong><p>Where inventory is stored and moved.</p></div><span>Open</span></a>
        <a class="list-row" href="/imports"><div><strong>Imports</strong><p>Bring in spreadsheets and review exact changes.</p></div><span>Open</span></a>
        <a class="list-row" href="/foundry"><div><strong>Inventory configuration</strong><p>Terminology and tracking setup.</p></div><span>Open</span></a>
        <a class="list-row" href="/autopilot/history"><div><strong>System & audit</strong><p>Advanced record of what Foundry checked, decided and carried out.</p></div><span>Open</span></a>
        <a class="list-row" href="/settings/connections"><div><strong>Connections</strong><p>Keep Foundry informed automatically from systems outside Foundry.</p></div><span>Manage</span></a>
      </div>
    </div>

    <% if (stockGuards.length) { %>
      <div class="card" id="stock-protection">
        <div class="card-head"><div><h2>Stock protection</h2><p class="muted">Hard stops enforced wherever outgoing stock is recorded.</p></div><span class="spacer"></span><span class="badge"><%= stockGuards.length %> active</span></div>
        <div class="card-body grid">
          <% stockGuards.forEach(function(rule) { %>
            <div class="list-row">
              <div>
                <strong><%= rule.itemName %><%= rule.variantLabel ? ' / ' + rule.variantLabel : '' %><%= rule.locationName ? ' at ' + rule.locationName : '' %></strong>
                <p>Block a sale or issue that would leave stock <%= rule.boundary.blockedWhen %>. <%= rule.boundary.permittedExplanation %> <%= rule.releaseCondition === 'on_order' ? 'Resume after a supplier order is placed.' : rule.releaseCondition === 'stock_recovered' ? 'Resume after on-hand stock recovers to ' + rule.releaseThreshold + '.' : 'An owner must release it.' %></p>
              </div>
              <% if (rule.instructionId) { %>
                <a class="btn btn--sm" href="/operating-instructions/<%= rule.instructionId %>">Manage</a>
              <% } %>
            </div>
          <% }) %>
        </div>
      </div>
    <% } %>

    <% if (learnedInstructions.length) { %>
      <details class="card advanced-settings" id="learned-instructions">
        <summary class="card-head">
          <div><h2>Rule history</h2><p class="muted">Original instructions and previous versions, kept for audit.</p></div>
          <span class="spacer"></span><span class="badge"><%= learnedInstructions.length %> record<%= learnedInstructions.length === 1 ? '' : 's' %></span>
        </summary>
        <div class="card-body grid">
          <% learnedInstructions.forEach(function(instruction) { %>
            <div class="list-row" style="align-items:flex-start;">
              <div><strong><%= instruction.status === 'APPROVED' ? 'Current instruction' : instruction.status === 'SUPERSEDED' ? 'Previous instruction' : 'Removed instruction' %></strong><p>“<%= instruction.statedAs %>”</p></div>
              <div class="actions-inline">
                <a class="btn btn--sm" href="/operating-instructions/<%= instruction.id %>">Inspect</a>
              </div>
            </div>
          <% }) %>
        </div>
      </details>
    <% } %>

    <details class="card advanced-settings" id="live-event-feed" <%= newFeedToken || eventFeed.connected ? 'open' : '' %>>
      <summary class="card-head">
        <div>
          <h2>Live operating feed</h2>
          <p class="muted">Sales and warehouse systems can push real movements to Foundry as they happen.</p>
        </div>
        <span class="spacer"></span>
        <span class="badge <%= eventFeed.connected ? 'badge--ok' : eventFeed.configured ? 'badge--warn' : 'badge--muted' %>"><%= eventFeed.connected ? 'Connected' : eventFeed.configured ? 'Waiting for first event' : 'Not configured' %></span>
      </summary>
      <div class="card-body grid">
        <% if (newFeedToken) { %>
          <div class="notice notice--warn">
            <div>
              <strong>Copy this token now. It will not be shown again.</strong>
              <input class="input mono" value="<%= newFeedToken %>" readonly aria-label="New event feed token" onclick="this.select()">
            </div>
          </div>
        <% } %>

        <div>
          <div class="label">Event endpoint</div>
          <input class="input mono" value="<%= origin %>/api/v1/feed/events" readonly aria-label="Event feed endpoint" onclick="this.select()">
          <p class="hint">Authenticate with <code class="mono">Authorization: Bearer YOUR_TOKEN</code>. Event IDs are idempotent: retrying one never moves stock twice.</p>
        </div>

        <details>
          <summary>Event format</summary>
          <pre class="mono" style="margin-top:10px; padding:12px; background:var(--surface-2); border:1px solid var(--line); border-radius:8px; overflow:auto; font-size:12px;">{
  "eventId": "sale-10482-line-1",
  "type": "sale",
  "skuCode": "SH-101-BLK-23",
  "locationName": "Main Warehouse",
  "quantity": 2,
  "occurredAt": "2026-08-17T14:30:00Z"
}</pre>
          <p class="hint">Also supported: receive, customer_return, damage, count, adjustment and transfer. Use <code class="mono">supplierCode</code> when an external system knows the vendor’s code rather than Foundry’s SKU.</p>
        </details>

        <% if (currentUser.role === 'owner') { %>
          <% if (eventFeed.configured) { %>
            <div class="form-actions">
              <form method="post" action="/settings/event-feed/enable" data-confirm="Rotate the feed token? The existing token will stop working immediately.">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                <button class="btn" type="submit">Rotate token</button>
              </form>
              <form method="post" action="/settings/event-feed/disconnect" data-confirm="Disconnect the live feed and revoke its token?">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                <button class="btn btn--danger" type="submit">Disconnect</button>
              </form>
            </div>
          <% } else { %>
            <form method="post" action="/settings/event-feed/enable">
              <input type="hidden" name="_csrf" value="<%= csrfToken %>">
              <button class="btn btn--primary" type="submit">Connect live feed</button>
            </form>
          <% } %>
        <% } %>

        <% if (eventFeed.recentEvents.length) { %>
          <div>
            <div class="label">Recent events</div>
            <ul class="plain-list">
              <% eventFeed.recentEvents.slice(0, 6).forEach(function (event) { %>
                <li>
                  <strong><%= event.eventId %></strong>
                  <span class="badge <%= event.status === 'COMPLETED' ? 'badge--ok' : 'badge--danger' %>"><%= event.status %></span>
                  <span class="muted"> <%= event.type %> · <%= helpers.timeAgo(event.processedAt) %></span>
                  <% if (event.error) { %><div class="is-warn"><%= event.error %></div><% } %>
                </li>
              <% }) %>
            </ul>
          </div>
        <% } %>
      </div>
    </details>

    <div class="card">
      <div class="card-head"><h2>This inventory</h2></div>
      <div class="card-body">
        <form method="post" action="/settings/workspace">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <div class="field">
            <label class="label" for="workspace-name">Inventory name</label>
            <input class="input" id="workspace-name" name="name" value="<%= workspace.name %>" required <%= currentUser.role === 'owner' ? '' : 'disabled' %>>
            <div class="hint">
              Shown in the switcher and on every screen your team uses. This names the whole
              inventory, not a location inside it — <a href="/locations">locations</a> live within it.
            </div>
          </div>
          <% if (currentUser.role === 'owner') { %>
            <div class="form-actions"><button class="btn btn--primary" type="submit">Save</button></div>
          <% } %>
        </form>
      </div>
    </div>

    <div class="card">
      <div class="card-head">
        <h2>Your plan</h2>
        <span class="spacer"></span>
        <span class="badge badge--muted"><%= entitlements.plan.label %></span>
      </div>
      <div class="table-wrap">
        <table class="table">
          <tbody>
            <% entitlements.limits.forEach(function (limit) { %>
              <tr>
                <td class="muted">
                  <%= { workspaces: 'Inventories', members: 'People on this inventory',
                        locations: 'Locations here', skus: 'Tracked variants here' }[limit.key] || limit.key %>
                </td>
                <td class="right num">
                  <%= limit.used %><% if (!limit.unlimited) { %> of <%= limit.limit %><% } %>
                </td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
      <div class="card-foot muted" style="font-size:12px;">
        Inventories are counted across your whole account; everything else is counted
        within this one.
      </div>
    </div>

    <div class="card">
      <div class="card-head">
        <h2>People</h2>
        <span class="spacer"></span>
        <% if (currentUser.role === 'owner') { %>
          <button class="btn btn--sm" type="button" data-modal-open="modal-person"><%- helpers.icon('plus', { size: 14 }) %> Add person</button>
        <% } %>
      </div>
      <div class="table-wrap">
        <table class="table table--stack">
          <thead><tr><th>Name</th><th>Email</th><th class="right">Role</th></tr></thead>
          <tbody>
            <% users.forEach(function (user) { %>
              <tr>
                <td class="cell-main">
                  <span class="cell-title"><%= user.name %><%= user.id === currentUser.id ? ' (you)' : '' %></span>
                </td>
                <td data-label="Email"><span class="muted"><%= user.email %></span></td>
                <td class="right cell-end" data-label="Role"><span class="badge"><%= helpers.roleLabel(user.role) %></span></td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
      <div class="card-foot muted">
        Owners manage locations, people and settings. Staff do the day-to-day inventory work.
      </div>
    </div>
  </div>

  <div class="grid">
    <div class="card">
      <div class="card-head"><h2>Inventory integrity</h2></div>
      <div class="card-body">
        <% if (integrity.ok) { %>
          <div class="notice" style="background: var(--ok-bg); border-color:#bbf7d0; color:#14532d;">
            <%- helpers.icon('shield', { size: 16 }) %>
            <span>Every balance matches its movement history, lot quantities and tracked units.</span>
          </div>
        <% } else { %>
          <div class="notice notice--warn">
            <%- helpers.icon('alert', { size: 16 }) %>
            <span><%= integrity.problems.length %> <%= helpers.plural(integrity.problems.length, 'discrepancy', 'discrepancies') %> found.</span>
          </div>
          <ul class="mono" style="margin:10px 0 0; padding-left:18px; font-size:12px; color:var(--muted);">
            <% integrity.problems.slice(0, 10).forEach(function (problem) { %>
              <li><%= problem.kind %>: <%= problem.detail %></li>
            <% }) %>
          </ul>
        <% } %>
        <p class="hint" style="margin-top:10px;">
          Foundry recomputes this from the ledger every time you open this page.
        </p>
      </div>
    </div>

    <div class="card">
      <div class="card-head"><h2>Your account</h2></div>
      <div class="card-body">
        <dl class="kv">
          <dt>Name</dt><dd><%= currentUser.name %></dd>
          <dt>Email</dt><dd><%= currentUser.email %></dd>
          <dt>Role</dt><dd><%= helpers.roleLabel(currentUser.role) %></dd>
        </dl>
      </div>
    </div>
  </div>
</div>

<% if (currentUser.role === 'owner') { %>
  <dialog class="modal" id="modal-person">
    <form method="post" action="/settings/people">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <div class="modal-head">
        <h2>Add a person</h2>
        <button class="btn btn--ghost btn--sm close" type="button" data-modal-close aria-label="Close"><%- helpers.icon('close', { size: 16 }) %></button>
      </div>
      <div class="modal-body">
        <div class="field">
          <label class="label" for="person-name">Name</label>
          <input class="input" id="person-name" name="name" required>
        </div>
        <div class="field">
          <label class="label" for="person-email">Email</label>
          <input class="input" id="person-email" name="email" type="email" required>
        </div>
        <div class="field">
          <label class="label" for="person-password">Temporary password</label>
          <input class="input" id="person-password" name="password" type="text" minlength="8" required>
          <div class="hint">At least 8 characters. Share it with them directly.</div>
        </div>
        <div class="field">
          <label class="label" for="person-role">Role</label>
          <select class="select" id="person-role" name="role" required>
            <% helpers.ROLES.forEach(function (role) { %>
              <option value="<%= role.id %>" <%= role.id === 'staff' ? 'selected' : '' %>><%= role.label %> — <%= role.blurb %></option>
            <% }) %>
          </select>
        </div>
      </div>
      <div class="modal-foot">
        <button class="btn" type="button" data-modal-close>Cancel</button>
        <button class="btn btn--primary" type="submit">Add person</button>
      </div>
    </form>
  </dialog>
<% } %>
