<% const isOwner=currentUser.role==='owner',section=locals.settingsSection||'general';const sections=locals.searchableSettingsSections||[]; %>
<header class="rm-head"><h1>Settings</h1><p>Manage your business, team and StockChief preferences.</p></header>
<div class="sc-settings-layout"><%- include('settings/navigation',{section,sections}) %>
<div class="sc-settings-content" data-settings-section="<%= section %>" data-settings-hashes="<%= JSON.stringify(locals.settingsSectionHashes||{}) %>">
<% if(section==='general'){ %><section class="rm-panel">
      <div class="rm-panel__head">
        <%- helpers.icon('inventory', { size: 15, className: 'rm-quiet' }) %>
        <h2>This inventory</h2>
      </div>
      <form data-settings-form method="post" action="/settings/workspace" style="padding:16px">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <label class="rm-field">
          <span id="workspace-name-label">Inventory name</span>
          <input type="text" id="workspace-name" aria-labelledby="workspace-name-label" name="name" value="<%= workspace.name %>" required <%= isOwner ? '' : 'disabled' %>>
          <small>
            Shown in the switcher and on every screen your team uses. This names the whole
            inventory, not a place inside it — <a href="/locations">locations</a> live within it.
          </small>
        </label>
        <% if (isOwner) { %><button class="rm-btn rm-btn--sm" type="submit">Save</button><% } %>
      </form>
    </section>
<% }else if(section==='team'){ %><section class="rm-panel" id="people">
      <div class="rm-panel__head">
        <%- helpers.icon('user', { size: 15, className: 'rm-quiet' }) %>
        <h2>People</h2>
        <span class="right">
          <% if (isOwner) { %>
            <button class="rm-btn rm-btn--sm rm-btn--ghost" type="button" data-modal-open="modal-person">
              <%- helpers.icon('plus', { size: 13 }) %> Add person
            </button>
          <% } %>
        </span>
      </div>
      <div class="rm-told" style="border:0;border-radius:0;box-shadow:none">
        <% users.forEach(function (user) { %>
          <div class="rm-told__row">
            <span class="rm-told__t">
              <%= user.name %><%= user.id === currentUser.id ? ' (you)' : '' %>
              <small><%= user.email %></small>
            </span>
            <span class="rm-told__m"><span class="rm-pillbadge"><%= helpers.roleLabel(user.role) %></span></span>
          </div>
        <% }) %>
      </div>
      <p class="rm-quiet" style="font-size:12.5px;padding:12px 16px;border-top:1px solid var(--line-2);margin:0">
        Owners manage locations, people and settings. Staff do the day-to-day inventory work.
      </p>
    </section><% if (isOwner) { %>
  <dialog class="modal" id="modal-person">
    <form method="post" action="/settings/people">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <div class="modal-head">
        <h2>Add a person</h2>
        <button class="btn btn--ghost btn--sm close" type="button" data-modal-close aria-label="Close"><%- helpers.icon('close', { size: 16 }) %></button>
      </div>
      <div class="modal-body">
        <label class="rm-field"><span>Name</span><input type="text" id="person-name" name="name" required></label>
        <label class="rm-field"><span>Email</span><input type="email" id="person-email" name="email" required></label>
        <p class="rm-quiet">They receive an expiring invitation and choose their own password. StockChief never asks you to handle another person's credentials.</p>
        <label class="rm-field">
          <span>Role</span>
          <select id="person-role" name="role" required>
            <% helpers.ROLES.forEach(function (role) { %>
              <option value="<%= role.id %>" <%= role.id === 'staff' ? 'selected' : '' %>><%= role.label %> — <%= role.blurb %></option>
            <% }) %>
          </select>
        </label>
      </div>
      <div class="modal-foot">
        <button class="rm-btn rm-btn--ghost" type="button" data-modal-close>Cancel</button>
        <button class="rm-btn" type="submit">Add person</button>
      </div>
    </form>
  </dialog>
<% } %>

<% }else if(section==='notifications'){ %><section class="rm-panel" style="margin-bottom:16px" id="email-alerts">
  <div class="rm-panel__head">
    <%- helpers.icon('mail', { size: 15, className: 'rm-quiet' }) %>
    <h2>Automatic email alerts<%= emailAlerts.enabled ? ' are on' : '' %></h2>
    <span class="right"><span class="rm-pillbadge <%= emailAlerts.enabled && emailAlerts.deliveryConfigured ? 'is-ok' : emailAlerts.enabled ? 'is-warn' : '' %>">
      <%= emailAlerts.enabled && emailAlerts.deliveryConfigured ? 'on'
        : emailAlerts.enabled ? 'waiting for sender' : 'off' %>
    </span></span>
  </div>
  <form data-settings-form method="post" action="/settings/email-alerts" style="padding:16px">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <label class="rm-field">
      <span><input type="checkbox" name="enabled" value="1" <%= emailAlerts.enabled ? 'checked' : '' %> <%= isOwner ? '' : 'disabled' %>> Email me when something newly needs attention</span>
      <small>StockChief sends one email when the item opens. Rechecking the same condition does not send another.</small>
    </label>
    <label class="rm-field">
      <span>Which items</span>
      <select name="minimumSeverity" <%= isOwner ? '' : 'disabled' %>>
        <option value="critical" <%= emailAlerts.minimumSeverity === 'critical' ? 'selected' : '' %>>Critical only</option>
        <option value="important" <%= emailAlerts.minimumSeverity === 'important' ? 'selected' : '' %>>Important and critical</option>
        <option value="all" <%= emailAlerts.minimumSeverity === 'all' ? 'selected' : '' %>>Everything, including watch items</option>
      </select>
    </label>
    <label class="rm-field">
      <span>Recipients</span>
      <textarea name="recipients" rows="2" <%= isOwner ? '' : 'disabled' %>><%= emailAlerts.recipients.join('\n') %></textarea>
      <small>One or more email addresses, separated by a new line or comma. Each email contains a direct link to the decision.</small>
    </label>
    <% if (!emailAlerts.deliveryConfigured) { %>
      <div class="rm-note rm-note--warn" style="margin-bottom:12px">
        <%- helpers.icon('alert', { size: 16 }) %>
        <span><strong>Email delivery is temporarily unavailable.</strong><br>Your preferences can be saved. Alerts for future events will begin when delivery is restored.</span>
      </div>
    <% } %>
    <% if (isOwner) { %><div class="rm-choices">
      <button class="rm-btn rm-btn--sm" type="submit">Save</button>
    </div><% } %>
  </form>
  <% if (isOwner && emailAlerts.enabled) { %>
    <form method="post" action="/settings/email-alerts/test" style="padding:0 16px 16px">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <button class="rm-btn rm-btn--ghost rm-btn--sm" type="submit">Send a test email</button>
    </form>
  <% } %>
</section>
<% }else if(section==='ai'){ %><section class="card section" id="ask-preferences" aria-label="Ask StockChief preferences"><div class="card-body"><h2>Ask StockChief preferences</h2><p>The business time zone controls accounting days, reports and scheduled delivery. Ask uses your preferred answer language unless you request another.</p><form data-settings-form method="post" action="/settings/ask-preferences"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><label class="field"><span>Answer language</span><select class="select" name="answerLanguage"><% [['auto','Match my request'],['en','English'],['he','Hebrew · עברית'],['fr','French'],['es','Spanish'],['de','German'],['ar','Arabic'],['yi','Yiddish']].concat(answerPreferences.answerLanguage&&!['en','he','fr','es','de','ar','yi'].includes(answerPreferences.answerLanguage)?[[answerPreferences.answerLanguage,new Intl.DisplayNames(['en'],{type:'language'}).of(answerPreferences.answerLanguage)]]:[]).forEach(function(pair){ %><option value="<%= pair[0] %>" <%= (answerPreferences.answerLanguage||'auto')===pair[0]?'selected':'' %>><%= pair[1] %></option><% }); %></select></label><label class="field"><span>Answer style</span><textarea class="input" name="answerStyle" maxlength="500" rows="3" placeholder="Describe how you prefer answers"><%= answerPreferences.answerStyle||'' %></textarea></label><label class="field"><span>Business time zone</span><select class="select" name="timeZone"><% Array.from(new Set(['UTC',...Intl.supportedValuesOf('timeZone'),answerPreferences.timeZone])).forEach(function(zone){ %><option value="<%= zone %>" <%= answerPreferences.timeZone===zone?'selected':'' %>><%= zone.replaceAll('_',' ') %></option><% }); %></select></label><% if(isOwner){ %><button class="btn" type="submit">Save</button><% }else{ %><p>Your account owner can change these preferences.</p><% } %></form><% if(locals.recordAliases?.length){ %><h3>Saved business nicknames</h3><ul><% recordAliases.forEach(function(a){ %><li><strong><%= a.alias %></strong> → <%= a.recordReference %> (<%= a.kind %>)</li><% }); %></ul><p>Ask StockChief to change or remove a nickname. Nicknames do not change permissions or the original record.</p><% } %></div></section>
<div class="sc-settings-actions"><a class="btn" href="/autopilot">Authority</a><a class="btn" href="/what-you-told-me">What you've told me</a></div>
<% if(locals.aiCost?.creditsOnly){ %><% if(locals.aiCost){ var cost=aiCost,usd=function(n){return '$'+(n/100).toFixed(2);}; %>
    <% if(aiCost?.creditsOnly){ %><section class="card section" id="ai-spending"><div class="card-body"><h2>AI credits</h2><p><strong><%= aiCost.credits.remaining===null?'Unlimited':Number(aiCost.credits.remaining).toLocaleString() %> credits available</strong></p><p>Ask and file reading share this balance. <%= aiCost.credits.reserved %> credits are reserved for work in progress. Renewals follow your plan.</p><a href="/billing">View Plan &amp; Usage</a></div></section><% }else{ %><section class="card section" id="ai-spending"><div class="card-body"><h2>AI spending protection</h2>
      <p><strong><%= cost.credits.remaining===null?'No credit limit':Number(cost.credits.remaining).toLocaleString()+' AI credits remaining' %></strong>. Credits measure included work; the spending limits below separately protect account and inventory costs. Both must permit the request.</p>
      <p>Standard limits for file reading and other included AI work. This inventory: <strong><%= usd(cost.workspaceMinor) %> / <%= usd(cost.workspaceCapMinor) %></strong>. Account total across inventories: <strong><%= usd(cost.accountMinor) %> / <%= usd(cost.accountCapMinor) %></strong>.</p>
      <p>File interpretation is limited to <%= usd(cost.importRequestCapMinor) %> per AI request. Pending and unverified calls count toward protection. Included-usage limits renew <%= helpers.dateTime(cost.periodEndsAt) %>. Purchased AI packs have their own funding limits.</p>
      <% if(cost.sharedTestAllowance){ %><p role="status">Ask and AI file reading share the approved <strong><%= usd(cost.sharedTestAllowance.maximumMinor) %></strong> test cap through <%= helpers.dateTime(cost.sharedTestAllowance.expiresAt) %>. The same availability is used on Ask, file reading and Plan &amp; Usage. When this exception expires, your standard limits apply again.</p><% }else if(cost.nativeTestAllowance){ %><p role="status">Your approved temporary Ask limit is <strong><%= usd(cost.nativeTestAllowance.maximumMinor) %></strong> through <%= helpers.dateTime(cost.nativeTestAllowance.expiresAt) %>. <%= cost.nativeTestAllowance.available?'Eligible Ask requests remain available.':'This temporary allowance cannot fund another request.' %> It does not change the standard limits in this form.</p><% } %><% if(cost.warning||cost.creditWarning){ %><p role="alert" class="notice notice--warn"><%= cost.blocked?'Standard included AI work is paused by a spending limit, even though credits may remain.':'At least 80% of a spending limit or included credit allowance has been used.' %> Your saved files and records remain available. The account owner can change the limits below.</p><% } %>
      <% if(isOwner){ %><form data-settings-form method="post" action="/settings/ai-spending" class="stack"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><label class="field">Account AI limit for this billing period (USD)<input name="accountLimit" inputmode="decimal" value="<%= (cost.accountCapMinor/100).toFixed(2) %>" required></label><label class="field">AI limit for this inventory this period (USD)<input name="workspaceLimit" inputmode="decimal" value="<%= (cost.workspaceCapMinor/100).toFixed(2) %>" required></label><p>The account limit is shared by your owned inventories; the inventory limit applies here only, through <%= helpers.dateTime(cost.periodEndsAt) %>. Raising them permits more AI use from available credits; it does not purchase credits, charge your card, clear uncertain costs, or change separate request, goal or certification guards.</p><label><input type="checkbox" name="confirmed" value="yes" required> I approve these exact AI spending limits for this billing period.</label><button class="rm-btn" type="submit">Save</button></form><% } %>
    </div></section><% } %><% } %>
    <% }else if(locals.aiCost){ %><section class="card card-body"><h2>AI credits</h2><p><%= aiCost.credits.remaining===null?'Unlimited':Number(aiCost.credits.remaining).toLocaleString() %> credits available for Ask and file reading.</p><a class="btn" href="/settings?section=advanced#ai-spending">Manage AI spending protection</a></section><% } %>
<% }else if(section==='data'){ %><section class="card card-body"><h2>Business data</h2><div class="sc-settings-actions"><a class="btn" href="/imports">Imports</a><% if(isOwner){ %><a class="btn" href="/settings/export">Export this inventory</a><% } %></div></section><section class="rm-panel">
      <div class="rm-panel__head">
        <%- helpers.icon(integrity.ok ? 'shield' : 'alert', { size: 15, className: 'rm-quiet' }) %>
        <h2>Inventory integrity</h2>
        <span class="right">
          <span id="integrity-check-badge" class="rm-pillbadge <%= integrity.ok ? 'is-ok' : 'is-warn' %>">
            <%= integrity.status==='NOT_CHECKED'?'not checked here':integrity.status==='CHECKING'?'checking':integrity.status==='ERROR'?'check interrupted':integrity.ok?'balanced at last check':integrity.problems.length+' to check' %>
          </span>
        </span>
      </div>
      <div style="padding:14px 16px">
        <div id="integrity-check-result" role="status" aria-live="polite">
        <% if(integrity.status==='NOT_CHECKED'){ %><p>Run a full check to compare stock with its movement history, tracked units and journal totals. Large inventories can take a minute; the rest of Settings stays available.</p>
        <% } else if (integrity.ok) { %>
          <p style="font-size:13.5px;color:var(--ink-2);margin:0">
            Every balance matches its movement history, lot quantities and tracked units.
          </p>
        <% } else { %>
          <ul class="plain-list" style="font-family:var(--f-num);font-size:12px">
            <% integrity.problems.slice(0, 10).forEach(function (problem) { %>
              <li><%= problem.kind %>: <%= problem.detail %></li>
            <% }) %>
          </ul>
        <% } %>
        <% if(integrity.checkedAt){ %><p class="rm-quiet">Last checked <%= helpers.dateTime(integrity.checkedAt) %>. Later changes are not included.</p><% } %>
        </div>
        <% if(locals.postgresMode){ %><form id="integrity-check-form" method="post" action="/settings/integrity/check"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="rm-btn rm-btn--ghost" type="submit">Check inventory integrity</button></form><% } %>
      </div>
    </section><script src="/integrity-check.js?v=<%= assetVersion %>" defer></script>
<% }else if(section==='advanced'){ %><section class="rm-panel" id="account">
      <div class="rm-panel__head">
        <%- helpers.icon('user', { size: 15, className: 'rm-quiet' }) %>
        <h2>Your account</h2>
      </div>
      <div class="rm-told" style="border:0;border-radius:0;box-shadow:none">
        <div class="rm-told__row"><span class="rm-told__t">Name</span><span class="rm-told__m"><%= currentUser.name %></span></div>
        <div class="rm-told__row"><span class="rm-told__t">Email</span><span class="rm-told__m"><%= currentUser.email %></span></div>
        <div class="rm-told__row"><span class="rm-told__t">Role</span><span class="rm-told__m"><%= helpers.roleLabel(currentUser.role) %></span></div>
      </div>
    </section><div class="sc-settings-actions"><a class="btn" href="/autopilot/history">Activity and audit history</a><a class="btn" href="/settings/connections?section=developers#developer-api">Developer connections</a></div><% if(locals.aiCost&&!aiCost.creditsOnly){ %><% if(locals.aiCost){ var cost=aiCost,usd=function(n){return '$'+(n/100).toFixed(2);}; %>
    <% if(aiCost?.creditsOnly){ %><section class="card section" id="ai-spending"><div class="card-body"><h2>AI credits</h2><p><strong><%= aiCost.credits.remaining===null?'Unlimited':Number(aiCost.credits.remaining).toLocaleString() %> credits available</strong></p><p>Ask and file reading share this balance. <%= aiCost.credits.reserved %> credits are reserved for work in progress. Renewals follow your plan.</p><a href="/billing">View Plan &amp; Usage</a></div></section><% }else{ %><section class="card section" id="ai-spending"><div class="card-body"><h2>AI spending protection</h2>
      <p><strong><%= cost.credits.remaining===null?'No credit limit':Number(cost.credits.remaining).toLocaleString()+' AI credits remaining' %></strong>. Credits measure included work; the spending limits below separately protect account and inventory costs. Both must permit the request.</p>
      <p>Standard limits for file reading and other included AI work. This inventory: <strong><%= usd(cost.workspaceMinor) %> / <%= usd(cost.workspaceCapMinor) %></strong>. Account total across inventories: <strong><%= usd(cost.accountMinor) %> / <%= usd(cost.accountCapMinor) %></strong>.</p>
      <p>File interpretation is limited to <%= usd(cost.importRequestCapMinor) %> per AI request. Pending and unverified calls count toward protection. Included-usage limits renew <%= helpers.dateTime(cost.periodEndsAt) %>. Purchased AI packs have their own funding limits.</p>
      <% if(cost.sharedTestAllowance){ %><p role="status">Ask and AI file reading share the approved <strong><%= usd(cost.sharedTestAllowance.maximumMinor) %></strong> test cap through <%= helpers.dateTime(cost.sharedTestAllowance.expiresAt) %>. The same availability is used on Ask, file reading and Plan &amp; Usage. When this exception expires, your standard limits apply again.</p><% }else if(cost.nativeTestAllowance){ %><p role="status">Your approved temporary Ask limit is <strong><%= usd(cost.nativeTestAllowance.maximumMinor) %></strong> through <%= helpers.dateTime(cost.nativeTestAllowance.expiresAt) %>. <%= cost.nativeTestAllowance.available?'Eligible Ask requests remain available.':'This temporary allowance cannot fund another request.' %> It does not change the standard limits in this form.</p><% } %><% if(cost.warning||cost.creditWarning){ %><p role="alert" class="notice notice--warn"><%= cost.blocked?'Standard included AI work is paused by a spending limit, even though credits may remain.':'At least 80% of a spending limit or included credit allowance has been used.' %> Your saved files and records remain available. The account owner can change the limits below.</p><% } %>
      <% if(isOwner){ %><form data-settings-form method="post" action="/settings/ai-spending" class="stack"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><label class="field">Account AI limit for this billing period (USD)<input name="accountLimit" inputmode="decimal" value="<%= (cost.accountCapMinor/100).toFixed(2) %>" required></label><label class="field">AI limit for this inventory this period (USD)<input name="workspaceLimit" inputmode="decimal" value="<%= (cost.workspaceCapMinor/100).toFixed(2) %>" required></label><p>The account limit is shared by your owned inventories; the inventory limit applies here only, through <%= helpers.dateTime(cost.periodEndsAt) %>. Raising them permits more AI use from available credits; it does not purchase credits, charge your card, clear uncertain costs, or change separate request, goal or certification guards.</p><label><input type="checkbox" name="confirmed" value="yes" required> I approve these exact AI spending limits for this billing period.</label><button class="rm-btn" type="submit">Save</button></form><% } %>
    </div></section><% } %><% } %>
    <% } %>
<% } %></div></div><script src="/settings-sections.js?v=<%= assetVersion %>" defer></script>
