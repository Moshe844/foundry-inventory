<%
  /*
   * Home is a manager's morning briefing, not a product tour.
   *
   * It used to open with eight sections, three of which explained Foundry to
   * the person already using it: a "just tell Foundry what happened" panel, a
   * six-card guide to what the product can do, and a readiness section whose
   * headline was "Foundry is still learning demand for 6 tracked variants".
   * The three questions somebody actually opens this page to answer — how is my
   * business doing, what needs me, what has Foundry handled — were below all of
   * it, styled the same as everything else.
   *
   * So the order is now the order of those questions, the explanations have
   * moved to the guide where somebody can go looking for them, and the
   * vocabulary is the operation's rather than Foundry's.
   */
  var hour = new Date().getHours();
  var greeting = hour < 12 ? 'Good morning' : hour < 18 ? 'Good afternoon' : 'Good evening';
  var firstName = currentUser && currentUser.name ? currentUser.name.split(/\s+/)[0] : '';
  var needsCount = home.needsYou.length;
  var handlingCount = home.handling.length;
  var isSettingUp = !!home.setup || !!(home.guidance && home.guidance.checklistActive);
  var paused = home.status.paused || home.status.suspended;
  var learningCount = home.readiness.evidenceGaps ? home.readiness.evidenceGaps.length : 0;

  // One verdict, in the words somebody would use out loud. This is the single
  // most important sentence on the page, so it is the largest thing on it.
  // A workspace still being set up has nothing to be under control yet, and
  // telling somebody on their first morning that everything is fine — when
  // Foundry does not yet know what they hold — is the friendliest possible way
  // to be wrong. Setup gets its own verdict until it is finished.
  var verdict = paused
    ? 'Foundry is paused'
    : needsCount > 0
      ? needsCount + (needsCount === 1 ? ' thing needs you' : ' things need you')
      : isSettingUp
        ? 'Getting Foundry ready'
        : 'Everything is under control';

  var subVerdict = paused
    ? (home.status.suspendedReason || home.status.pausedReason || 'Nothing happens automatically until you resume.')
    : needsCount > 0
      ? (isSettingUp ? 'Finish the setup step below, then settle the decisions Foundry has already found.' : 'Everything else, Foundry is getting on with.')
      : isSettingUp
        ? 'Give Foundry your inventory once. After that, tell it what happens and it manages the routine work.'
        : (handlingCount
            ? 'Foundry is handling ' + handlingCount + ' thing' + (handlingCount === 1 ? '' : 's') + ' and needs nothing from you.'
            : 'Nothing is waiting on you.');

  var didHeadline = needsCount && /nothing needed doing/i.test(home.did.headline || '')
    ? 'No new work found on the last check.'
    : home.did.headline;
%>

<div data-live-home data-signature="<%= homeSignature %>" hidden></div>

<%# ---------------------------------------------------------- The briefing %>
<header class="briefing <%= paused ? 'briefing--paused' : needsCount ? 'briefing--attention' : 'briefing--clear' %>">
  <div class="briefing__copy">
    <p class="briefing__greeting"><%= greeting %><%= firstName ? ', ' + firstName : '' %></p>
    <h1 class="briefing__verdict"><%= verdict %></h1>
    <p class="briefing__sub"><%= subVerdict %></p>
  </div>
  <div class="briefing__state">
    <span class="briefing__pulse <%= paused ? 'is-paused' : 'is-live' %>">
      <span class="dot <%= paused ? '' : 'dot--ok' %>" aria-hidden="true"></span>
      <%= paused ? 'Paused' : 'Working' %>
    </span>
    <span class="briefing__checked">Last checked <%= home.status.lastEvaluatedText %></span>
    <% if (canOperate) { %>
      <% if (paused) { %>
        <form method="post" action="/autopilot/resume">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <button class="btn btn--sm btn--primary" type="submit">Resume Foundry</button>
        </form>
      <% } else { %>
        <form method="post" action="/autopilot/pause" data-confirm="Pause Foundry? Nothing will happen automatically until you resume it.">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <button class="btn btn--sm btn--ghost" type="submit">Pause</button>
        </form>
      <% } %>
    <% } %>
  </div>
</header>

<%
  // State-aware guidance. The checklist shows only while something is left to
  // tick off, so this teaches by doing and then disappears on its own.
  //
  // Its next-best-action half, though, is built by reusing the top Needs you
  // decision when there is one — so on a page that already has a "Needs your
  // attention" section it printed the same title, the same paragraph and the
  // same button a second time, a few centimetres away. Guidance earns its place
  // here only when it is saying something the rest of the page is not.
  var guidanceRepeatsNeedsYou = !home.guidance.checklistActive
    && home.guidance.next && home.guidance.next.kind === 'needs-you';
%>
<% if (!guidanceRepeatsNeedsYou) { %>
  <%- include('partials/operating-guidance', { guidance: home.guidance }) %>
<% } %>

<%# Tell Foundry follows the single next action and teaches with examples from
    the same workspace state. It is an alternative way to perform the work,
    not a competing first decision. %>
<section class="section tell" id="tell-foundry">
  <form class="tell__form" method="post" action="/foundry/tell" enctype="multipart/form-data" data-busy data-ask-form data-operator-command-form>
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <span class="tell__mark" aria-hidden="true"><%- helpers.icon('foundry', { size: 18 }) %></span>
    <label class="visually-hidden" for="ask-question">Tell Foundry what happened</label>
    <input class="tell__input" id="ask-question" data-ask-input type="text" name="message"
           placeholder="<%= home.guidance.examples[0] || 'Tell Foundry what happened' %>"
           maxlength="400" autocomplete="off">
    <label class="tell__attach" title="Attach a file">
      <input type="file" name="file" accept=".csv,.tsv,.xlsx,.xls,.txt,.pdf,.docx,image/*" data-operator-attachment>
      <%- helpers.icon('import', { size: 17 }) %><span class="visually-hidden">Attach a file</span>
    </label>
    <button class="btn btn--primary tell__send" type="submit" data-ask-submit>Send</button>
  </form>
  <div class="ask-pending tell__pending" data-ask-pending role="status" aria-live="polite" hidden>
    <span class="working-spinner" aria-hidden="true"></span>
    Foundry is working out what that means…
  </div>
  <div class="tell__status" data-operator-attachment-status role="status" aria-live="polite" hidden>
    <%- helpers.icon('check', { size: 15 }) %>
    <span><strong data-operator-attachment-name></strong> attached. Add a note if useful, then send.</span>
  </div>
  <div class="tell__examples">
    <% home.guidance.examples.slice(0, 3).forEach(function (example) { %>
      <a href="#tell-foundry" data-fill-ask="<%= example %>"><%= example %></a>
    <% }) %>
  </div>
</section>

<% if (brain && brain.finance) { %>
<section class="section business-brief" aria-labelledby="business-brief-title">
  <div class="section-head"><div><h2 id="business-brief-title">Your business right now</h2><p class="t-muted"><%= brain.briefing.headline %></p></div><a class="section-more" href="/accounting">See every dollar</a></div>
  <div class="business-brief__story">
    <% brain.briefing.lines.forEach(function (line) { %><p><%= line %></p><% }) %>
  </div>
  <div class="stat-strip">
    <div><span class="stat-value"><%= helpers.money(brain.finance.customers.balanceMinor, brain.currency) %></span><span class="stat-label">Customers still owe you</span></div>
    <div><span class="stat-value"><%= helpers.money(brain.acquisition.supplierOwedMinor, brain.currency) %></span><span class="stat-label">You still owe suppliers</span></div>
    <div><span class="stat-value"><%= helpers.money(brain.acquisition.stillOwnedMinor, brain.currency) %><%= brain.acquisition.missingCostUnits ? ' recorded' : '' %></span><span class="stat-label"><%= brain.acquisition.missingCostUnits ? `${brain.acquisition.missingCostUnits} units still need cost evidence` : 'Inventory you still own' %></span></div>
    <div><span class="stat-value"><%= helpers.money(brain.acquisition.receivedCostMinor, brain.currency) %></span><span class="stat-label">Inventory received at recorded cost</span></div>
  </div>
  <% if (brain.acquisition.receivedWithoutBillMinor > 0) { %>
    <div class="quiet-note quiet-note--warn"><strong>A cost is not the same as a bill.</strong> Foundry has received inventory costing <%= helpers.money(brain.acquisition.receivedWithoutBillMinor, brain.currency) %>, but no supplier bill proves what is owed yet. The purchase has not disappeared; it is waiting for bill evidence.</div>
  <% } %>
</section>
<% } %>

<% if (!isSettingUp || needsCount) { %>

<%# ------------------------------------------------------- Needs your attention %>
<section class="section">
  <div class="section-head">
    <h2>Needs your attention</h2>
    <% if (needsCount) { %><a class="section-more" href="/needs-you">See all <%= needsCount %></a><% } %>
  </div>
  <% if (!needsCount) { %>
    <div class="quiet-note">
      <span class="dot dot--ok" aria-hidden="true"></span>
      Nothing needs a decision from you right now.
    </div>
  <% } else { %>
    <div class="inbox">
      <% home.needsYou.slice(0, 3).forEach(function (entry) { %>
        <%# The third importance tier is literally called "Needs You", which as a
            badge under a heading that already says "Needs your attention" is a
            word repeated for no reason. A badge that is always there stops being
            read, so it appears only when it raises the stakes. %>
        <article class="inbox-item <%= entry.importance === 'Urgent' ? 'inbox-item--urgent' : entry.importance === 'Important' ? 'inbox-item--important' : '' %>">
          <div>
            <% if (entry.importance === 'Urgent' || entry.importance === 'Important') { %>
              <span class="badge <%= entry.importance === 'Urgent' ? 'badge--danger' : 'badge--warn' %>"><%= entry.importance %></span>
            <% } %>
            <h3 class="inbox-item__title"><%= entry.title %></h3>
            <% if (entry.because) { %><p class="inbox-item__because"><%= entry.because %></p><% } %>
          </div>
          <div class="inbox-item__do">
            <a class="btn btn--primary btn--sm" href="<%= entry.link %>"><%= entry.action %></a>
          </div>
        </article>
      <% }) %>
    </div>
  <% } %>
</section>

<% } %>

<% if (!isSettingUp) { %>

<%# ------------------------------------------------------------------ Coming up %>
<section class="section">
  <div class="section-head">
    <h2>Coming up</h2>
  </div>
  <%
    // Coming up is the operation's diary: deliveries arriving, dates that
    // matter to a customer. Foundry's own next cron tick was appearing in it
    // as "Next scheduled evaluation", which tells an owner nothing about their
    // business and everything about Foundry's internals. When Foundry last
    // looked, and when it looks next, is already stated in the briefing.
    var upcoming = home.next.filter(function (event) {
      return !/scheduled evaluation|scheduled check/i.test(event.title || '');
    });
  %>
  <% if (!upcoming.length) { %>
    <div class="quiet-note">No deliveries expected and no dates approaching.</div>
  <% } else { %>
    <div class="panel"><div class="timeline timeline--panel">
      <% upcoming.forEach(function (event) { %>
        <div class="timeline-item <%= event.overdue ? 'is-overdue' : '' %>">
          <span class="timeline-when"><%= event.when %></span>
          <span class="timeline-what">
            <% if (event.link) { %><a href="<%= event.link %>"><%= event.title %></a><% } else { %><%= event.title %><% } %>
            <% if (event.detail) { %><span class="t-muted"> — <%= event.detail %></span><% } %>
          </span>
          <% if (event.overdue) { %><span class="badge badge--warn">Overdue</span><% } %>
        </div>
      <% }) %>
    </div></div>
  <% } %>
</section>

<%# ------------------------------------------------------------ Foundry handled %>
<section class="section">
  <div class="section-head">
    <h2>Foundry handled</h2>
    <a class="section-more" href="/autopilot/history">See everything</a>
  </div>
  <% if (home.did.actions.length) { %>
    <div class="panel"><div class="timeline timeline--panel">
      <% home.did.actions.slice(0, 4).forEach(function (action) { %>
        <div class="timeline-item">
          <span class="timeline-when"><span class="dot dot--ok" aria-hidden="true"></span></span>
          <span class="timeline-what">
            <a href="<%= action.link %>"><%= action.headline %></a>
            <% if (action.detail) { %><span class="t-muted"> — <%= action.detail %></span><% } %>
          </span>
        </div>
      <% }) %>
    </div></div>
  <% } else { %>
    <div class="quiet-note"><%= didHeadline %></div>
  <% } %>
  <% if (handlingCount) { %>
    <p class="section-foot"><a href="/autopilot/history"><%= handlingCount %> thing<%= handlingCount === 1 ? '' : 's' %> in progress now</a></p>
  <% } %>
</section>

<%# ---------------------------------------------------------- Inventory pulse %>
<section class="section">
  <div class="section-head">
    <h2>Inventory pulse</h2>
    <a class="section-more" href="/inventory">Open inventory</a>
  </div>
  <div class="stat-strip">
    <div><span class="stat-value"><%= stats.itemCount %></span><span class="stat-label">Product<%= stats.itemCount === 1 ? '' : 's' %></span></div>
    <div><span class="stat-value"><%= stats.locationCount %></span><span class="stat-label">Location<%= stats.locationCount === 1 ? '' : 's' %></span></div>
    <div><span class="stat-value"><%= stats.unitsOnHand %></span><span class="stat-label">Units on hand</span></div>
    <div><span class="stat-value"><%= home.did.counts.positionsWatched %></span><span class="stat-label">Product locations watched</span></div>
  </div>

  <%
    // Progressive disclosure, exactly where the old page put its worst
    // sentence. One plain line about where Foundry stands; the evidence
    // thresholds and per-variant gaps stay one click away for anyone who
    // wants them.
    var demandStage = home.readiness.demandStage
      || (home.readiness.usageReady > 0 ? 'ready' : home.readiness.skuCount > 0 ? 'none' : 'no-products');
    var demandLine = demandStage === 'none'
      ? 'Foundry knows what you have, but has not seen anything leave yet — so it cannot tell you what is running low.'
      : demandStage === 'learning'
        ? 'Still learning what sells. Keep recording normal activity and Foundry will start managing low stock.'
        : 'Watching demand, and will act when the numbers support it.';
  %>
  <%
    // When Foundry has already put "tell me when you sell something" in Needs
    // you, saying the same thing again down here is the page repeating itself.
    // The pulse keeps the numbers; the decision stays where decisions live.
    var demandAlreadyAsked = needsCount > 0 && demandStage === 'none';
  %>
  <% if (home.readiness.notes.length && !demandAlreadyAsked) { %>
    <details class="disclose">
      <summary>
        <span><%= demandLine %></span>
        <span class="disclose__cue">Why?</span>
      </summary>
      <div class="disclose__body">
        <p><%= home.readiness.evidenceRequirement %></p>
        <% if (learningCount) { %>
          <ul class="plain-list"><% home.readiness.evidenceGaps.forEach(function (p) { %><li><%= p.missingSummary %></li><% }) %></ul>
        <% } %>
        <ul class="plain-list"><% home.readiness.notes.forEach(function (note) { %><li><%= note %></li><% }) %></ul>
      </div>
    </details>
    <% if (demandStage === 'none') { %>
      <p class="section-foot"><a class="btn btn--sm" href="#tell-foundry">Record a sale or movement</a></p>
    <% } %>
  <% } %>
</section>

<% } %>
