<div class="rm-head"><a class="rm-head__back" href="/ask"><span aria-hidden="true">←</span> Ask StockChief</a><div class="rm-title"><div><p class="rm-stamp"><%= proposal.status==='EXECUTED'?'Recorded change':'Prepared change' %></p><h1><%= proposal.status==='EXECUTED'?'Completed change':'Review before anything changes' %></h1></div></div></div>
<% if(locals.editProposal&&proposal.status==='PENDING'){ %><section class="card" id="revise-proposal"><div class="card-body"><h2>Revise this prepared change</h2><p>Its current details are shown below. Preparing a replacement withdraws this unapproved change; the replacement needs a new approval.</p><form method="post" action="/actions/<%= proposal.id %>/revise"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><label class="field"><span>Revised request</span><textarea name="message" class="input" required maxlength="10000" autofocus><%= proposal.source_message %></textarea></label><button class="btn btn--primary" type="submit">Prepare revised change</button></form></div></section><% } %>
<div class="card measure"><div class="card-head"><h2><%= presentation.summary %></h2><span class="badge badge--<%= proposal.status === 'EXECUTED' ? 'ok' : proposal.status === 'PENDING' ? 'warn' : 'muted' %>"><%= proposal.status %></span></div>
  <div class="card-body rm-mission-review"><p class="badge badge--muted"><%= presentation.impact %></p><section aria-label="Proposed changes"><dl class="summary-list"><% presentation.fields.forEach(function(field){ %><div><dt><%= field.label %></dt><dd><%= field.value %></dd></div><% }); %></dl></section><details class="rm-mission-request"><summary>Your original request</summary><p><%= proposal.source_message %></p></details>
    <% if(proposal.action_type==='inventory.establish_cost'){ const p=proposal.payload; %>
    <section aria-label="Existing stock cost review"><h3>Actual cost for stock already on hand</h3>
    <table class="table"><tbody><tr><th>Product</th><td><%= p.productName %> · <%= p.skuCode %></td></tr><tr><th>Location</th><td><%= p.locationName %></td></tr><tr><th>Units receiving cost</th><td><%= p.quantity %></td></tr><tr><th>Actual unit cost</th><td><%= helpers.money(p.unitCostMinor,p.currency) %></td></tr><tr><th>Inventory value added</th><td><%= helpers.money(p.totalCostMinor,p.currency) %></td></tr><tr><th>Stock quantity</th><td><%= p.physicalUnits %> — unchanged</td></tr><tr><th>Supporting evidence</th><td><%= p.evidenceReference %></td></tr><tr><th>Posting date</th><td><%= p.postingDate %></td></tr></tbody></table>
    <p><%= p.basis==='opening_inventory'?'Records the value of stock you already owned when you started.':'Moves a previously expensed purchase into inventory, increasing profit in the posting period.' %> No receipt, supplier bill or payment is created.</p></section>
    <% } %>
    <% if(proposal.action_type==='purchase_order.receive_from_document'){ %><p><a href="/imports/<%= proposal.payload.sourceId %>">Review the delivery document and source rows</a></p><% } %>
    <% if (typeof mission !== 'undefined' && mission) { %>
      <section class="rm-mission-scope" aria-labelledby="mission-outcome"><h3 id="mission-outcome"><%= proposal.status==='PENDING'?'Review all':'Recorded' %> <%= (mission.approved_steps || []).length %> changes</h3>
        <% if(proposal.status==='PENDING'){ %><p>You can approve the full request once, or approve just the current change. StockChief checks permissions and business conditions again before each operation, and stops if the approved scope changes.</p><% } %>
        <ol class="rm-mission-steps"><% (typeof missionSteps!=='undefined'?missionSteps:(mission.approved_steps||[]).map(function(step,index){return {label:step.capability.replace(/[._]/g,' '),args:step.args,index:index+1,state:mission.steps[index]?.state};})).forEach(function(step){ %>
          <li><div class="rm-mission-step-head"><strong><%= step.label %></strong><span class="rm-mission-step-status"><%= step.state==='DONE'?'Completed':step.state==='WAITING'?'Ready for approval':'After earlier changes' %></span></div>
          <dl class="rm-mission-fields"><% (step.fields||[]).forEach(function(field){ %><div><dt><%= field.label %></dt><dd><%= field.value %></dd></div><% }) %></dl></li>
        <% }) %></ol>
      </section>
    <% } %>
    <% if (typeof mission !== 'undefined' && mission && proposal.status === 'EXECUTED') { %>
      <% if (mission.status === 'WAITING_EVENT' && mission.waiting_condition && mission.waiting_condition.kind === 'supplier_acceptance') { %>
        <div class="notice"><strong>Waiting for the supplier’s acceptance.</strong> The email was sent, but the purchase order has not been placed. StockChief will check replies in the sent thread and resume this approved mission automatically when acceptance is verified.</div>
      <% } else if (mission.status === 'DONE' && mission.verification_status === 'VERIFIED') { %>
        <div class="notice notice--ok"><strong>Mission completed and verified.</strong> All approved changes finished. Their outcomes are recorded.</div>
      <% } else if (mission.status === 'BLOCKED') { %>
        <div class="notice"><strong>Request paused.</strong> Earlier verified changes are saved. <% const failed=(mission.steps||[]).find(step=>step.failure?.message); %><%= failed?failed.failure.message:'StockChief could not confirm the next step. Review the recorded changes before continuing.' %></div>
      <% } %>
    <% } %>
    <% if (proposal.status === 'PENDING') { %><p class="muted">Nothing has changed yet. Check the business result above before approving.</p><% } %>
    <details class="advanced-settings"><summary>Technical record details</summary><p class="muted">Action: <%= proposal.action_type %></p><% if(typeof mission!=='undefined'&&mission){ %><p class="muted">Plan integrity: <%= mission.plan_hash %></p><% } %>
    <p>Review identifier: <%= proposal.id %></p></details>
    <% if (proposal.result) { %><p class="notice">Completed. The result is recorded and retries will not perform it twice.</p><% if (proposal.result.transferId) { %><p><a class="btn btn--primary" href="/transfers/<%= proposal.result.transferId %>">Continue <%= proposal.result.transferNumber %> in the warehouse</a></p><% } %><% if (proposal.result.salesOrderId) { %><p><a class="btn btn--primary" href="/orders/<%= proposal.result.salesOrderId %>">Continue <%= proposal.result.orderNumber %></a></p><% } %><% if (proposal.result.purchaseOrderId) { %><p><a class="btn btn--primary" href="/purchasing/orders/<%= proposal.result.purchaseOrderId %>">Continue <%= proposal.result.poNumber || 'purchase order' %></a></p><% } %><% if (proposal.result.journalEntryId) { %><p><a class="btn" href="/accounting/entries/<%= proposal.result.journalEntryId %>">View accounting proof</a></p><% } %><% if (proposal.result.communicationId) { %><p><a class="btn btn--primary" href="/messages/<%= proposal.result.communicationKind %>/<%= proposal.result.communicationId %>">Track this email</a></p><% } %><% } %>
  </div>
  <% if (proposal.status === 'PENDING') { const native=typeof nativeApproval!=='undefined'?nativeApproval:null,access=locals.approvalAccess; %><div class="card-foot rm-mission-actions">
    <% if(access?.individual?.blocked){ %><p class="notice"><%= access.individual.reason %><% if(access.individual.upgrade){ %> <a class="btn" href="/billing">Upgrade to <%= access.individual.upgrade %></a><% } %></p><% }else if(mission&&access?.mission?.blocked){ %><p class="notice"><%= access.mission.reason %><% if(access.mission.upgrade){ %> <a class="btn" href="/billing">Upgrade to <%= access.mission.upgrade %></a><% } %></p><% } %>
    <% if(typeof mission!=='undefined'&&mission&&(!native||native.mission)){ %><form method="post" action="<%= native?'/ask/goals/'+native.goalId+'/approval':'/actions/'+proposal.id+'/approve-mission' %>">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="missionHash" value="<%= mission.plan_hash %>">
      <% if(native){ %><input type="hidden" name="decision" value="approve"><input type="hidden" name="deliveryId" value="<%= native.id %>"><input type="hidden" name="sha256" value="<%= native.sha256 %>"><input type="hidden" name="scope" value="mission"><input type="hidden" name="missionId" value="<%= mission.id %>"><% } %>
      <button class="btn btn--primary" type="submit" <%= access?.mission?.blocked?'disabled':'' %>><%= native?.decision?.approved?'Continue approved changes':'Approve all remaining changes' %></button></form><% } %>
    <% if(!native?.decision?.scope){ %>
    <form method="post" action="<%= native?'/ask/goals/'+native.goalId+'/approval':'/actions/'+proposal.id+'/approve' %>"><input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <% if(native){ %><input type="hidden" name="decision" value="approve"><input type="hidden" name="deliveryId" value="<%= native.id %>"><input type="hidden" name="sha256" value="<%= native.sha256 %>"><% } %>
      <button class="btn" type="submit" <%= access?.individual?.blocked?'disabled':'' %>><%= native?.decision?.approved?'Continue approved change':'Approve only this change' %></button></form><% } %>
    <% if(!native?.decision?.approved){ %>
    <form method="post" action="<%= native?'/ask/goals/'+native.goalId+'/approval':'/actions/'+proposal.id+'/cancel' %>"><input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <% if(native){ %><input type="hidden" name="decision" value="reject"><input type="hidden" name="deliveryId" value="<%= native.id %>"><input type="hidden" name="sha256" value="<%= native.sha256 %>"><% } %><button class="btn" type="submit">Reject this change</button></form><% } %>
  </div><% } %>
  <% if (typeof nativeResume !== 'undefined' && nativeResume) { %><div class="card-foot"><p>Your approval is saved. Continue only the remaining approved work; StockChief rechecks access and conditions and preserves completed changes.</p><form method="post" action="/ask/goals/<%= nativeResume.goalId %>/approval"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="decision" value="approve"><input type="hidden" name="deliveryId" value="<%= nativeResume.id %>"><input type="hidden" name="sha256" value="<%= nativeResume.sha256 %>"><input type="hidden" name="scope" value="mission"><input type="hidden" name="missionId" value="<%= mission.id %>"><input type="hidden" name="missionHash" value="<%= mission.plan_hash %>"><button class="btn btn--primary" type="submit">Continue approved request</button></form></div><% } %>
  <% if (typeof resumeAvailable !== 'undefined' && resumeAvailable) { %><div class="card-foot"><p>That change completed. StockChief paused before preparing the next step.</p><form method="post" action="/actions/<%= proposal.id %>/continue"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="btn btn--primary" type="submit">Continue the remaining request</button></form></div><% } %>
  <% if(locals.draftTraining&&(draftTraining.canTeach||draftTraining.rule)){ %><section class="card-body">
  <% const costRoutine=draftTraining.action==='landed_cost.apply',pickRoutine=['warehouse.release_orders','warehouse.wave.create'].includes(draftTraining.action),receiptRoutine=draftTraining.action==='customer_payment.match_bank_line',reservationRoutine=draftTraining.action==='sales_order.reserve_arrived',disputeRoutine=draftTraining.action==='supplier_invoice.dispute'; %>
  <h2><%= costRoutine?'Teach stock cost allocations':pickRoutine?'Teach pick releases':disputeRoutine?'Teach supplier invoice disputes':reservationRoutine?'Teach arrived-stock reservations':receiptRoutine?'Teach receipt matching':'Teach this draft routine' %></h2><p><%= draftTraining.bound.label %></p>
  <% if(draftTraining.canTeach){ %><form method="get"><label><%= costRoutine?'Maximum additional stock cost per allocation':pickRoutine?'Maximum goods value per release':disputeRoutine?'Maximum invoice value':reservationRoutine?'Maximum goods value per reservation':receiptRoutine?'Maximum receipt amount':'Maximum value per draft operation' %> in <%= draftTraining.bound.currency %>
  <input name="draftMaximum" inputmode="decimal" required value="<%= draftTraining.preview?.maximum||draftTraining.rule?.amount||draftTraining.exampleAmount %>"></label>
  <button class="btn"><%= costRoutine?'Test on past reviewed allocations':pickRoutine?'Test on past reviewed releases':disputeRoutine?'Test on past sent disputes':reservationRoutine?'Test on past reviewed reservations':receiptRoutine?'Test on past matched receipts':'Test on past drafts' %></button></form><% } %>
  <% if(draftTraining.preview&&draftTraining.canTeach){ %><p><%= draftTraining.preview.covered %> of <%= draftTraining.preview.total %> completed matching <%= costRoutine?'reviewed cost allocations':pickRoutine?'reviewed releases':disputeRoutine?'sent reviewed disputes':reservationRoutine?'reviewed reservations':receiptRoutine?'receipts':'draft operations' %> were within this amount.</p>
  <form method="post" action="/actions/<%= proposal.id %>/draft-rule"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="revision" value="<%= draftTraining.rule?.revision||0 %>"><input type="hidden" name="maximum" value="<%= draftTraining.preview.maximum %>"><button class="btn" name="mode" value="save"><%= costRoutine?'Save stock-cost rule':pickRoutine?'Save pick release rule':disputeRoutine?'Save supplier dispute rule':reservationRoutine?'Save reservation rule':'Save routine for approved missions' %></button></form><% } %>
  <% if(draftTraining.rule){ %><form method="post" action="/actions/<%= proposal.id %>/draft-rule"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="revision" value="<%= draftTraining.rule.revision %>"><button class="btn" name="mode" value="remove">Remove routine</button></form><% } %>
  </section><% } %>
</div>
