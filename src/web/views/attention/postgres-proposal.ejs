<div class="rm-head"><a class="rm-head__back" href="/ask"><span aria-hidden="true">←</span> Ask StockChief</a><div class="rm-title"><div><p class="rm-stamp">Prepared change</p><h1>Review before anything changes</h1></div></div></div>
<div class="card measure"><div class="card-head"><h2><%= proposal.summary %></h2><span class="badge badge--<%= proposal.status === 'EXECUTED' ? 'ok' : proposal.status === 'PENDING' ? 'warn' : 'muted' %>"><%= proposal.status %></span></div>
  <div class="card-body"><p><strong>You said:</strong> “<%= proposal.source_message %>”</p><p class="muted">Action: <%= proposal.action_type %></p>
    <dl class="summary-list"><% Object.entries(proposal.payload || {}).filter(function(entry){return entry[1] !== null && entry[1] !== undefined;}).forEach(function(entry){ %><div><dt><%= helpers.columnLabel(entry[0]) %></dt><dd><%= entry[1] %></dd></div><% }) %></dl>
    <% if (proposal.result) { %><p class="notice">Completed. The result is recorded and retries will not perform it twice.</p><% if (proposal.result.transferId) { %><p><a class="btn btn--primary" href="/transfers/<%= proposal.result.transferId %>">Continue <%= proposal.result.transferNumber %> in the warehouse</a></p><% } %><% if (proposal.result.salesOrderId) { %><p><a class="btn btn--primary" href="/orders/<%= proposal.result.salesOrderId %>">Continue <%= proposal.result.orderNumber %></a></p><% } %><% if (proposal.result.purchaseOrderId) { %><p><a class="btn btn--primary" href="/purchasing/orders/<%= proposal.result.purchaseOrderId %>">Continue <%= proposal.result.poNumber || 'purchase order' %></a></p><% } %><% if (proposal.result.journalEntryId) { %><p><a class="btn" href="/accounting/entries/<%= proposal.result.journalEntryId %>">View accounting proof</a></p><% } %><% if (proposal.result.communicationId) { %><p><a class="btn btn--primary" href="/messages/<%= proposal.result.communicationKind %>/<%= proposal.result.communicationId %>">Track this email</a></p><% } %><% } %>
  </div>
  <% if (proposal.status === 'PENDING') { %><div class="card-foot" style="display:flex;gap:10px;justify-content:flex-end"><form method="post" action="/actions/<%= proposal.id %>/cancel"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="btn" type="submit">Discard</button></form><form method="post" action="/actions/<%= proposal.id %>/approve"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="btn btn--primary" type="submit">Approve and execute</button></form></div><% } %>
</div>
