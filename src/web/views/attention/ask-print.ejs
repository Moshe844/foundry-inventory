<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= result.config.title %> · StockChief</title>
  <style>
    body { max-width: 62rem; margin: 2rem auto; padding: 0 1rem; color: #172033; font: 1rem/1.5 system-ui, sans-serif; }
    nav { margin-bottom: 1.5rem; }
    button { font: inherit; padding: .45rem .85rem; }
    table { border-collapse: collapse; width: 100%; table-layout: fixed; }
    th, td { padding: .4rem .55rem; border-bottom: 1px solid #ccd3de; text-align: start; vertical-align: top; white-space: pre-wrap; overflow-wrap: anywhere; }
    @media print {
      nav { display: none; }
      body { margin: 0; padding: 0; max-width: none; }
      thead { display: table-header-group; }
    }
  </style>
</head>
<body>
  <nav><button type="button" onclick="window.print()">Print or save as PDF</button></nav>
  <h1 dir="auto"><%= result.config.title %></h1>
  <table>
    <thead><tr><% for (const column of result.columns) { %><th scope="col" dir="auto"><%= result.columnLabels?.[column] || column %></th><% } %></tr></thead>
    <tbody><% for (const row of result.displayRows || result.rows) { %><tr><% for (const column of result.columns) { %><td dir="auto"><%= row[column] ?? '' %></td><% } %></tr><% } %></tbody>
  </table>
</body>
</html>
