<div class="ask-chat" data-chat-row data-chat-text="<%= chat.label.toLowerCase() %>" <%- locals.currentChatId===chat.chat_id?'aria-current="true"':'' %>>
  <a class="sc-recent-request" href="<%= chat.href %>" title="<%= chat.label %> · <%= helpers.dateTime(chat.updated_at) %>"><span class="ask-chat__mark" aria-hidden="true"><%- helpers.icon(chat.pinned_at?'pin':'chat',{size:15}) %></span><strong dir="auto"><%= chat.label %></strong><time data-local-time datetime="<%= new Date(chat.updated_at).toISOString() %>"><%= helpers.dateTime(chat.updated_at) %></time></a>
  <%# Rename happens in the row itself: Rename in the menu turns the title into this box. %>
  <form class="ask-chat__rename" data-chat-rename-form method="post" action="/ask/chats/<%= encodeURIComponent(chat.chat_id) %>/rename" hidden><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="returnTo" value="<%= chatReturn %>"><label><span class="visually-hidden">Conversation name</span><input name="title" value="<%= chat.title||chat.label %>" maxlength="120" autocomplete="off" required></label><button type="submit" aria-label="Save the new name"><%- helpers.icon('check',{size:15}) %></button></form>
  <details class="ask-menu"><summary aria-label="Options for <%= chat.label %>"><%- helpers.icon('more',{size:16}) %></summary><div class="ask-menu__panel">
    <form method="post" action="/ask/chats/<%= encodeURIComponent(chat.chat_id) %>/pin"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="returnTo" value="<%= chatReturn %>"><input type="hidden" name="pinned" value="<%= chat.pinned_at?'':'1' %>"><button class="ask-menu__item" type="submit"><%- helpers.icon('pin',{size:16}) %><span><%= chat.pinned_at?'Unpin':'Pin' %></span></button></form>
    <button class="ask-menu__item" type="button" data-chat-rename><%- helpers.icon('pencil',{size:16}) %><span>Rename</span></button>
    <a class="ask-menu__item" href="/ask/chats/<%= encodeURIComponent(chat.chat_id) %>/download" download><%- helpers.icon('download',{size:16}) %><span>Download</span></a>
    <hr class="ask-menu__line">
    <form method="post" action="/ask/chats/<%= encodeURIComponent(chat.chat_id) %>/delete" data-confirm="Delete this conversation? It disappears from your list and cannot be reopened. Anything it already changed stays recorded in your business's history."><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="returnTo" value="<%= chatReturn %>"><button class="ask-menu__item ask-menu__delete" type="submit"><%- helpers.icon('trash',{size:16}) %><span>Delete</span></button></form>
  </div></details>
</div>
