<%
  /*
   * The Line — the running conversation with StockChief.
   *
   * There used to be two boxes for one thing. "Ask StockChief" answered questions
   * on this page; "Tell StockChief" carried instructions from somewhere else. But
   * StockChief has one understanding of what somebody said, and which box they
   * typed it in should never decide whether it understands them. So there is
   * one composer, it posts to the router that already classifies fifteen kinds
   * of sentence, and where the sentence goes is StockChief's problem rather than
   * the owner's.
   *
   * It reads as a conversation because it is one. Every turn this session is
   * on the page — what was asked, what came back — with the latest answer in
   * full and the earlier ones as they were said. The page used to show one
   * question and fold the one before it under a "Previous question" line, so
   * a person three questions in could not see what they had asked.
   *
   * This is also where StockChief is taught. A rule typed here comes back as a
   * card that can be read, changed, paused and revoked — and that card is the
   * settings record. There is no form: the sentence is the form.
   */
  var recent = locals.recentRules || [];
  var pending = locals.pendingRules || [];
  var about = locals.about || '';
  var transcript = locals.transcript || [];
  var currentGoalId = locals.currentGoalId || '';
  var showingCurrent = !!(result || error);
  var started = transcript.length > 0 || showingCurrent;
  /* A guided email step owns the next interaction. Keep the general composer
     available, but place it after the step instead of floating over its fields. */
  var guidedEmailStep = !!(result && (result.emailFlow || (result.emailProposal && result.emailProposal.status === 'PENDING')));
  /*
   * Where an answer came from, in one line a person can check: which
   * lookup, which records, which filters, how many rows, as of when.
   */
  function provenanceLine(goal) {
    var p = goal.provenance || {};
    var bits = [];
    (p.reads || []).slice(0, 3).forEach(function (r) {
      var what = r.dataset ? r.dataset.replace(/_/g, ' ') : (r.intent ? r.intent.replace(/_/g, ' ') : '');
      var scope = [].concat(r.filters || []).slice(0, 3).join(', ');
      if (!scope && (r.entity || r.location)) scope = [r.entity, r.location].filter(Boolean).join(' at ');
      if (what) bits.push(what + (scope ? ' (' + scope + ')' : ''));
    });
    var out = bits.length ? 'Read ' + bits.join('; ') : '';
    if (p.rowCount !== undefined && p.rowCount !== null && (out || p.rowCount)) out += (out ? ' · ' : '') + helpers.qty(p.rowCount) + ' ' + helpers.plural(p.rowCount, 'row');
    if (p.asOf) out += (out ? ' · ' : '') + 'as of ' + helpers.dateTime(p.asOf);
    if (p.general) out = 'General knowledge — not read from your records';
    if (p.modelCalls) out += (out ? ' · ' : '') + p.modelCalls + ' model call' + (p.modelCalls === 1 ? '' : 's') + ', ' + (p.modelMs >= 1000 ? (p.modelMs / 1000).toFixed(1) + ' s' : p.modelMs + ' ms');
    return out;
  }
  var askReturnHref = question ? '/ask?q=' + encodeURIComponent(question) : '/ask';
  /*
   * A cell, as a person would read it. Numbers get their thousands separators;
   * a column with a heading is written "Heading value"; a column whose heading
   * is deliberately empty — a summary's figure — is just the figure.
   */
  function cellText(column, value) {
    if (value === null || value === undefined) return null;
    if (column === 'occurredAt') value = helpers.dateTime(value);
    if (column === 'operation') value = helpers.operationLabel(value);
    if (column === 'expiresAt') value = helpers.shortDate(value);
    if (typeof value === 'number' && Number.isFinite(value)) value = helpers.qty(value);
    var heading = helpers.columnLabel(column);
    return heading ? heading + ' ' + value : String(value);
  }
  function evidenceHref(href, label) {
    if (!href) return null;
    if (locals.postgresAsk) return String(href).startsWith('/') && !String(href).startsWith('//') ? href : null;
    if (!String(href).startsWith('/') || String(href).startsWith('/foundry/navigate?')) return href;
    return '/foundry/navigate?to=' + encodeURIComponent(href)
      + '&label=' + encodeURIComponent('Open ' + label)
      + '&return=' + encodeURIComponent(askReturnHref);
  }
  function suggestionHref(example) {
    return '/ask?q=' + encodeURIComponent(example) + (locals.sourcePath ? '&from=' + encodeURIComponent(locals.sourcePath) : '');
  }
%>

<div class="rm-chat<%= guidedEmailStep ? ' rm-chat--guided' : '' %>" data-conversation="<%= locals.conversationId || '' %>">
  <% if (started) { %>
  <div class="rm-chat__bar">
    <div><p class="rm-stamp">Your direct line</p><h1 class="rm-chat__title">Ask StockChief</h1></div>
      <form method="post" action="/ask/new" class="rm-chat__new">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <button class="rm-btn rm-btn--ghost rm-btn--sm" type="submit">New conversation</button>
      </form>
  </div>
  <% } %>

  <% if (!started && !question) { %>
    <header class="rm-chat__intro">
      <span class="rm-chat__mark" aria-hidden="true"><%- helpers.icon('spark', { size: 18 }) %></span>
      <div>
        <p class="rm-stamp">Ask StockChief</p>
        <h1 class="rm-verdict">What can I help you run?</h1>
        <p class="rm-prose">
          Ask about the business or tell me what should happen. I will find the records and show any change before it is made.
        </p>
      </div>
    </header>
  <% } %>

  <% if (about) { %>
    <p class="rm-stamp">About: <%= about %></p>
  <% } %>

  <%#
    Every turn of this conversation, from the ledger. A turn is what you said;
    under it, one card per thing you asked for, each with what StockChief
    said, what became of it, and where the answer came from. The latest
    answer is shown in full with its records; earlier ones are as they were
    said — a record of what was said, not a live figure.
  %>
  <%
    /*
     * Only the latest exchange is open: the turn that holds the answer just
     * computed, or failing that the last one said. Everything before it is
     * folded under one line, so what was just asked is what is on screen
     * and the page does not have to be scrolled back up to find it.
     */
    var latestIndex = transcript.length - 1;
    transcript.forEach(function (t, i) { if (t.goals.some(function (g) { return g.id === currentGoalId; })) latestIndex = i; });
    var earlier = latestIndex;
  %>
  <% transcript.forEach(function (turn, turnIndex) { %>
    <% if (earlier > 0 && turnIndex === 0) { %>
    <details class="rm-history">
      <summary>Earlier in this conversation · <%= earlier %> <%= helpers.plural(earlier, 'message') %></summary>
      <div class="rm-history__body">
    <% } %>
    <% if (earlier > 0 && turnIndex === earlier) { %>
      </div>
    </details>
    <% } %>
    <div class="rm-turn rm-turn--you<%= turn.goals.some(function (g) { return g.id === currentGoalId; }) ? '' : ' rm-turn--past' %><%= turnIndex === latestIndex ? ' rm-turn--latest' : '' %>">
      <p class="rm-turn__who">You<%
        /* Several parts: how many are settled, so a half-done message never reads as done. */
        if (turn.goals.length > 1) { var waitingStates = turn.coveragePendingStatuses || ['pending']; var settledParts = turn.goals.filter(function (g) { return !waitingStates.includes(g.status); }).length; %> · <span class="rm-turn__coverage<%= settledParts === turn.goals.length ? '' : ' rm-turn__coverage--open' %>"><%= settledParts === turn.goals.length ? 'all ' + turn.goals.length + ' parts settled' : settledParts + ' of ' + turn.goals.length + ' parts settled' %></span><% } %></p>
      <% if (turn.message.length > 400) { %>
        <details class="rm-turn__said"><summary><%= turn.message.slice(0, 160) %>…</summary><p style="white-space:pre-line;margin:8px 0 0"><%= turn.message %></p></details>
      <% } else { %><p class="rm-turn__said"><%= turn.message %></p><% } %>
    </div>
    <% turn.goals.forEach(function (goal) { %>
      <% if (goal.id === currentGoalId && error) { %>
    <div class="rm-turn rm-turn--foundry">
      <p class="rm-turn__who">StockChief<% if (turn.goals.length > 1) { %> · part <%= goal.position + 1 %> of <%= turn.goals.length %><% } %></p>
      <div class="rm-said rm-said--problem">
        <p class="rm-said__text"><%= error %></p>
        <p class="rm-said__meta"><span class="rm-pill rm-pill--<%= goal.statusTone %>"><%= goal.statusLabel %></span><span>Nothing changed. Your message is still in the box below.</span></p>
      </div>
    </div>
      <% } else if (goal.id === currentGoalId && result) { %>
    <div class="rm-turn rm-turn--foundry">
      <p class="rm-turn__who">StockChief<% if (turn.goals.length > 1) { %> · part <%= goal.position + 1 %> of <%= turn.goals.length %><% } %></p>
      <%
        /*
         * One sentence. `spoken` is the model's phrasing of the computed
         * figures — every number in it was checked against the computed answer
         * before it got here, and dropped if it did not match — so where it
         * exists it is the answer. The computed sentence is the statement of
         * record and is true whether or not a model was there to read it out,
         * so it is kept, under "How I read that", rather than printed directly
         * underneath: the two say the same thing, and a page that says the
         * same thing twice reads as a page that is not sure.
         */
        var said = (result.spoken && !result.progressiveDisclosure) ? result.spoken : result.answer;
        var record = said === result.answer ? null : result.answer;
        var sections = (result.sections || []).filter(function (s) { return s.rows.length || s.handoff; });
        var answerIsSummary = result.columns && result.columns[0] === 'measure' && result.columns[1] === 'value';
        var hasRows = result.rows && result.rows.length;
      %>
      <div class="rm-said">
        <p class="rm-said__text" style="white-space:pre-line"><%= helpers.figures(said) %></p>
        <p class="rm-said__meta"><span class="rm-pill rm-pill--<%= goal.statusTone %>"><%= goal.statusLabel %></span><% if (result.general) { %><span class="rm-pill rm-pill--muted">General knowledge — not read from your records</span><% } %><% if (result.needsClarification && goal.status === 'clarify' && !result.emailFlow) { %><span><%= result.choices && result.choices.length ? 'Pick one, or reply below.' : 'Reply below to continue this question.' %> Nothing has changed.</span><% } %></p>
        <% if (result.emailFlow && result.needsClarification) { %>
          <form method="post" action="/ask/email/continue" class="rm-email-flow" data-busy>
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <input type="hidden" name="interactionId" value="<%= currentGoalId %>">
            <input type="hidden" name="usageKey" value="<%= locals.usageKey %>">
            <fieldset><legend><%= result.emailFlow.kind === 'missing_contact' ? 'How should I handle this new contact?' : 'Use this address just once, or save it for next time?' %></legend>
              <% if (result.emailFlow.kind === 'missing_contact') { %>
                <% if (!result.emailFlow.recipientKind || result.emailFlow.recipientKind === 'customer') { %><label><input type="radio" name="mode" value="add_customer" <%= result.emailFlow.recipientKind === 'customer' ? 'checked' : '' %> required> Add <%= result.emailFlow.name %> as a customer</label><% } %>
                <% if (!result.emailFlow.recipientKind || result.emailFlow.recipientKind === 'supplier') { %><label><input type="radio" name="mode" value="add_supplier" <%= result.emailFlow.recipientKind === 'supplier' ? 'checked' : '' %> required> Add <%= result.emailFlow.name %> as a supplier</label><% } %>
                <label><input type="radio" name="mode" value="one_off" <%= !result.emailFlow.recipientKind ? 'checked' : '' %> required> Send once without adding a contact</label>
              <% } else { %>
                <label><input type="radio" name="mode" value="save" checked required> Save the address on <%= result.emailFlow.name %> and use it</label>
                <label><input type="radio" name="mode" value="once" required> Use it for this email only</label>
              <% } %>
            </fieldset>
            <label class="rm-email-flow__address">Email address<input type="email" name="email" autocomplete="email" placeholder="name@example.com" required maxlength="254"></label>
            <button class="rm-btn rm-btn--sm" type="submit">Prepare the email <span aria-hidden="true">→</span></button>
            <small>No contact is added and nothing is sent until you approve the finished draft.</small>
          </form>
        <% } %>
        <% if (result.emailProposal) { var emailDraft = result.emailProposal; var emailPayload = emailDraft.payload || {}; %>
          <section class="rm-email-preview" aria-label="Email draft">
            <p class="rm-email-preview__k"><%= emailDraft.status === 'PENDING' ? 'Ready for your approval' : emailDraft.status === 'EXECUTED' ? emailDraft.deliveryStatus === 'SENT' ? 'Sent and confirmed' : emailDraft.deliveryStatus === 'FAILED' ? 'Delivery needs attention' : 'Approved · sending' : 'Discarded draft' %></p>
            <dl><div><dt>To</dt><dd><%= emailPayload.recipientName %> &lt;<%= emailPayload.recipientEmail %>&gt;</dd></div>
              <div><dt>From</dt><dd><%= emailPayload.mailboxName %></dd></div>
              <div><dt>Subject</dt><dd><%= emailPayload.subject %></dd></div></dl>
            <div class="rm-email-preview__body"><%= emailPayload.body %></div>
            <% if (emailPayload.addContactKind) { %><p class="rm-email-preview__note">Approval also adds <%= emailPayload.recipientName %> as a <%= emailPayload.addContactKind %> with this address.</p><% } %>
            <% if (emailPayload.saveEmailToContact) { %><p class="rm-email-preview__note">Approval also saves this address on the contact.</p><% } %>
            <% if (!emailPayload.draftPolished && !emailPayload.editedByOwner && emailDraft.status === 'PENDING') { %><p class="rm-email-preview__note">I could not polish this wording automatically. Review or edit it before approving.</p><% } %>
            <% if (emailDraft.status === 'PENDING') { %>
              <div class="rm-email-preview__actions"><form method="post" action="/ask/email/<%= emailDraft.id %>/approve" data-busy><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="rm-btn rm-btn--sm" type="submit">Approve and send</button></form>
                <form method="post" action="/ask/email/<%= emailDraft.id %>/cancel"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="rm-btn rm-btn--ghost rm-btn--sm" type="submit">Discard</button></form></div>
              <details class="rm-email-preview__edit"><summary>Edit this draft</summary><form method="post" action="/ask/email/<%= emailDraft.id %>/revise" data-busy><input type="hidden" name="_csrf" value="<%= csrfToken %>"><label>Subject<input name="subject" value="<%= emailPayload.subject %>" maxlength="200" required></label><label>Message<textarea name="body" rows="7" maxlength="6000" required><%= emailPayload.body %></textarea></label><button class="rm-btn rm-btn--sm" type="submit">Save draft</button></form></details>
              <p class="rm-email-preview__note">Nothing is sent until you approve. You can change the wording here.</p>
            <% } else if (emailDraft.status === 'EXECUTED' && emailDraft.result?.communicationId) { %>
              <p class="rm-email-preview__note">Delivery: <%= emailDraft.deliveryStatus || 'QUEUED' %>. <a href="/messages/<%= emailDraft.result.communicationKind %>/<%= emailDraft.result.communicationId %>">Track this email</a></p>
            <% } %>
          </section>
        <% } %>
        <%# A "which one?" is answered with a click: each candidate is the reply, sent as the answer to this question. %>
        <% if (result.needsClarification && result.choices && result.choices.length) { %>
          <div class="rm-suggest rm-suggest--answers">
            <% result.choices.forEach(function (choice) { %>
              <form method="post" action="/foundry/tell" data-busy>
                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                <input type="hidden" name="queryConversation" value="1">
                <% if (result.actionClarification) { %>
                  <input type="hidden" name="original" value="<%= result.actionClarification.original %>">
                  <input type="hidden" name="answer" value="<%= choice.value %>">
                  <input type="hidden" name="answerAction" value="1">
                  <% if (result.actionClarification.goalId) { %><input type="hidden" name="assistantGoal" value="<%= result.actionClarification.goalId %>"><% } %>
                <% } else { %>
                  <input type="hidden" name="message" value="<%= choice.value || choice %>">
                <% } %>
                <button type="submit"><%= choice.label || choice %></button>
              </form>
            <% }) %>
          </div>
        <% } %>

        <% if (result.handoff) { %>
          <p class="rm-chat-actions"><a class="rm-btn" href="<%= result.handoff.href %>"><%= result.handoff.label %> <span aria-hidden="true">→</span></a></p>
        <% } %>

        <% if (result.isAction) { %>
          <%# Saying "StockChief cannot move stock" would be false — it can. So the
              request is handed straight over rather than explained away. %>
          <form method="post" action="<%= result.semanticPlan ? '/foundry/tell' : '/actions/ask' %>" class="rm-chat-actions" data-busy>
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <input type="hidden" name="instruction" value="<%= result.question %>">
            <% if (result.semanticPlan) { %><input type="hidden" name="message" value="<%= result.question %>"><input type="hidden" name="prepareOnly" value="1"><% } %>
            <button class="rm-btn" type="submit">Prepare for review <span aria-hidden="true">→</span></button>
          </form>
          <p class="rm-said__meta"><span>Nothing has changed. You will see the exact change before it happens.</span></p>
        <% } %>

        <% if (!result.supported && !result.isAction && !result.needsClarification && !result.answerReason) { %>
          <p class="rm-said__meta"><span>Things I can answer</span></p>
          <div class="rm-suggest">
            <% examples.slice(0, 4).forEach(function (example) { %>
              <a href="<%= suggestionHref(example) %>"><%= example %></a>
            <% }) %>
          </div>
        <% } %>

        <% sections.forEach(function(section) { %>
          <% if (section.rows.length) { %>
            <details class="rm-chat-evidence">
              <summary>
                <span><%- helpers.icon('layers', { size: 15 }) %> <%= section.question %></span>
                <small><%= helpers.qty(section.totalMatches === undefined ? section.rowCount : section.totalMatches) %> <%= helpers.plural(section.totalMatches === undefined ? section.rowCount : section.totalMatches, 'match', 'matches') %></small>
              </summary>
              <div class="rm-chat-evidence__rows">
                <% section.rows.slice(0,12).forEach(function(row) { %>
                  <div class="rm-chat-evidence__row"><span><%= row[section.columns[0]] === null ? 'Not recorded' : row[section.columns[0]] %></span>
                    <small><%= section.columns.slice(1).map(function(c){return cellText(c,row[c]);}).filter(Boolean).join(' · ') %></small></div>
                <% }); %>
              </div>
            </details>
          <% } %>
          <% if (section.handoff) { %><p class="rm-said__meta"><a href="<%= evidenceHref(section.handoff.href, section.handoff.label) %>"><%= section.handoff.label %> →</a></p><% } %>
        <% }); %>

        <% if (hasRows && result.comparisonSafe !== false && result.reportConfig && result.reportConfig.chart === 'bar' &&
          result.reportConfig.groups.length === 1 && result.columns.length === 2 &&
          result.rows.slice(0,12).every(function(row){return Number.isFinite(Number(row[result.columns[1]])) && Number(row[result.columns[1]]) >= 0;}) ) {
            var reportMax=Math.max(1,...result.rows.slice(0,12).map(function(row){return Number(row[result.columns[1]]);})); %>
          <section class="rm-report-bars" aria-label="Report bar chart">
            <% result.rows.slice(0,12).forEach(function(row){var amount=Number(row[result.columns[1]]); %>
              <div class="rm-report-bars__row"><span><%= row[result.columns[0]] %></span>
                <div class="rm-report-bars__track"><div class="rm-report-bars__fill" style="width:<%= Math.max(2,Math.round(amount/reportMax*100)) %>%"></div></div>
                <strong><%= row[result.columns[1]] %></strong></div>
            <% }); %>
            <% if(result.rows.length>12){ %><small>First 12 groups shown. Open the report for every value.</small><% } %>
          </section>
        <% } %>
        <% if (hasRows && result.comparisonSafe !== false && result.reportConfig && result.reportConfig.chart === 'line' &&
          result.reportConfig.groups.length === 1 && result.columns.length === 2 &&
          result.rows.slice(0,40).every(function(row){return Number.isFinite(Number(row[result.columns[1]])) &&
            Math.abs(Number(row[result.columns[1]])) <= Number.MAX_SAFE_INTEGER;}) ) {
            var lineValues=result.rows.slice(0,40).map(function(row){return Number(row[result.columns[1]]);});
            var lineLow=Math.min(...lineValues),lineHigh=Math.max(...lineValues);
            var linePoints=lineValues.map(function(value,index){return (12+index*476/Math.max(1,lineValues.length-1))+','+
              (lineHigh===lineLow?75:135-(value-lineLow)*120/(lineHigh-lineLow));}).join(' '); %>
          <section class="rm-report-trend" aria-label="Report line chart">
            <svg viewBox="0 0 500 150" role="img" aria-label="Trend in <%= result.reportConfig.title %>">
              <line x1="12" y1="135" x2="488" y2="135" stroke="#c9c4ec"/>
              <polyline points="<%= linePoints %>" fill="none" stroke="#6355ee" stroke-width="3"/>
              <% linePoints.split(' ').forEach(function(point){var xy=point.split(','); %>
                <circle cx="<%= xy[0] %>" cy="<%= xy[1] %>" r="4" fill="#6355ee"/>
              <% }); %>
            </svg><small>Exact dates and values appear below.</small>
          </section>
        <% } %>
        <% if (hasRows) { %>
          <details class="rm-chat-evidence" <%= result.reportConfig ? 'open' : '' %>>
            <summary>
              <span><%- helpers.icon('layers', { size: 15 }) %> <%= answerIsSummary ? 'Answer details' : 'The records behind this' %></span>
              <small>
                <%# The count under an answer must never contradict the sentence above it: a page says it is a page ("first 25 of 70"), a summary counts its lines, and a full list counts its records. %>
                <% var shown = Math.min(result.rows.length, 60); var known = Number(result.rowCount || result.rows.length); %>
                <% if (known > shown) { %>first <%= helpers.qty(shown) %> of <%= helpers.qty(known) %><% } else if (answerIsSummary) { %><%= helpers.qty(shown) %> <%= helpers.plural(shown, 'line') %><% } else { %><%= helpers.qty(shown) %> <%= helpers.plural(shown, 'record') %><% } %>
              </small>
            </summary>
            <div class="rm-chat-evidence__rows">
              <%# Sixty, not twelve: "all products with their prices" is a list a person scrolls, not a sample. %>
              <% result.rows.slice(0, 60).forEach(function (row) { %>
                <%
                  var first = result.columns[0];
                  var label = row[first] === null || row[first] === undefined ? '—' : row[first];
                  var rest = result.columns.slice(1).map(function (column) {
                    return cellText(column, row[column]);
                  }).filter(Boolean).join(' · ');
                  var linkHref = evidenceHref(row.href, label);
                %>
                <div class="rm-chat-evidence__row">
                  <span><% if (linkHref) { %><a href="<%= linkHref %>"><%= label %></a><% } else { %><%= label %><% } %></span>
                  <small><%= rest %></small>
                </div>
              <% }) %>
            </div>
          </details>
        <% } %>

        <% const conversational = result.plan && ['small_talk', 'conversation_recap', 'general_knowledge', 'undo', 'action_clarification', 'navigation'].includes(result.plan.intent); %>
        <% if ((result.supported || result.isAction) && !conversational && !result.emailProposal) { %>
          <%#
            The working, folded. A native disclosure says what it is, opens
            without a script, and is where the statement of record lives.
          %>
          <details class="rm-chat-reading">
            <summary>Why this answer?</summary>
            <div class="rm-chat-reading__body">
              <% if (record) { %>
                <p class="rm-chat-reading__record"><%= helpers.figures(record) %></p>
              <% } %>
              <p>
                Read as “<%= result.interpretation || result.plan.intent.replace(/_/g, ' ') %>”<%
                %><% if (result.plan.entityQuery) { %> for “<%= result.plan.entityQuery %>”<% } %><%
                %><% if (result.plan.locationQuery) { %> at “<%= result.plan.locationQuery %>”<% } %>.
                <%= helpers.qty(result.rowCount) %> <%= helpers.plural(result.rowCount, 'row') %> read from your records.
                Nothing changed — asking is not doing, and changes are approved on the actions page.
              </p>
              <% var currentGoal = null; transcript.forEach(function (t) { t.goals.forEach(function (g) { if (g.id === currentGoalId) currentGoal = g; }); }); %>
              <% if (currentGoal && provenanceLine(currentGoal)) { %><p><%= provenanceLine(currentGoal) %></p><% } %>
            </div>
          </details>
        <% } %>
      </div>
    </div>
      <% } else { %>
    <div class="rm-turn rm-turn--foundry rm-turn--past">
      <p class="rm-turn__who">StockChief<% if (turn.goals.length > 1) { %> · part <%= goal.position + 1 %> of <%= turn.goals.length %><% } %></p>
      <div class="rm-said<%= goal.status === 'refused' || goal.status === 'failed' ? ' rm-said--problem' : '' %>">
        <% var saidText = goal.said || (goal.status === 'pending' ? 'Not started yet — it is waiting behind the part before it.' : ''); %>
        <% if (turn.goals.length > 1) { %><p class="rm-said__goal">“<%= goal.text.length > 160 ? goal.text.slice(0, 160) + '…' : goal.text %>”</p><% } %>
        <% if (saidText.length > 600) { %>
          <details class="rm-said__text"><summary><%= saidText.slice(0, 220) %>…</summary><p style="white-space:pre-line;margin:8px 0 0"><%= helpers.figures(saidText) %></p></details>
        <% } else if (saidText) { %><p class="rm-said__text" style="white-space:pre-line"><%= helpers.figures(saidText) %></p><% } %>
        <p class="rm-said__meta">
          <span class="rm-pill rm-pill--<%= goal.statusTone %>"><%= goal.statusLabel %></span>
          <% if (goal.resultHref) { %><a href="<%= goal.resultHref %>"><%= goal.resultLabel || 'Open' %> →</a><% } %>
          <% var prov = provenanceLine(goal); %><% if (prov) { %><span><%= prov %></span><% } %>
        </p>
      </div>
    </div>
      <% } %>
    <% }) %>
  <% }) %>

  <%
    /*
     * A rule StockChief has understood but not yet been given. This is the card
     * the concept is built on: the settings record, rendered the moment it is
     * created, in the owner's own words, with its controls attached.
     */
  %>
  <% pending.forEach(function (rule) { %>
    <div class="rm-turn rm-turn--foundry">
      <p class="rm-turn__who">StockChief</p>
      <div class="rm-said">
        <p class="rm-said__text">I read that as a standing rule. Is this right?</p>
        <div class="rm-rule">
          <p class="rm-rule__k">Waiting for you · not in force yet</p>
          <p class="rm-rule__t"><%= rule.summary || rule.statedAs %></p>
          <p class="rm-rule__m">
            <a href="/operating-instructions/<%= rule.id %>?from=ask">Check it and turn it on</a>
            <% if (rule.questions && rule.questions.length) { %>
              <span class="rm-quiet">— <%= rule.questions[0] %></span>
            <% } %>
          </p>
        </div>
      </div>
    </div>
  <% }) %>

  <%# ------------------------------------------------------------- composer %>
  <%- include('../partials/composer', {
    queryConversation: true,
    composerPrefill: error ? question : locals.prefill ? locals.prefill : about ? 'About ' + about + ': ' : '',
    composerPlaceholder: result && result.actionClarification ? 'Answer the question above…' : 'Ask what’s happening or tell StockChief what to do…',
    actionClarification: result && result.actionClarification ? result.actionClarification : null,
    usageKey: locals.usageKey,
    sourcePath: locals.sourcePath,
    hideAttachment: false,
  }) %>

  <% if (!aiConfigured) { %>
    <p class="rm-stamp" style="margin-top:14px;color:var(--copper)">
      Broader free-form language needs a model connection. Grounded questions and deterministic workflows still work without one.
    </p>
  <% } else if (!started) { %>
    <div class="rm-suggest">
      <% examples.forEach(function (example) { %>
        <a href="<%= suggestionHref(example) %>"><%= example %></a>
      <% }) %>
    </div>
  <% } %>

  <%# ------------------------------------------------- what has already been said %>
  <% if (recent.length && !started) { %>
    <p class="rm-stamp" style="margin-top:48px">Lately you told me</p>
    <div class="rm-told">
      <% recent.slice(0, 4).forEach(function (rule) { %>
        <div class="rm-told__row">
          <span class="rm-told__t"><%= rule.summary || rule.statedAs %></span>
          <span class="rm-told__m is-ok"><%= helpers.shortDate(rule.approvedAt || rule.createdAt) %></span>
        </div>
      <% }) %>
    </div>
    <p class="rm-disclose"><a href="/what-you-told-me">Everything you've told me</a></p>
  <% } %>

</div>
<% if (currentUser && ['owner','manager','staff'].includes(currentUser.role)) { %><p class="rm-disclose"><a href="/autopilot/misses">Report a wrong answer or missing requirement</a></p><% } %>
