<%
  /*
   * The Line — the running conversation with Foundry.
   *
   * There used to be two boxes for one thing. "Ask Foundry" answered questions
   * on this page; "Tell Foundry" carried instructions from somewhere else. But
   * Foundry has one understanding of what somebody said, and which box they
   * typed it in should never decide whether it understands them. So there is
   * one composer, it posts to the router that already classifies fifteen kinds
   * of sentence, and where the sentence goes is Foundry's problem rather than
   * the owner's.
   *
   * This is also where Foundry is taught. A rule typed here comes back as a
   * card that can be read, changed, paused and revoked — and that card is the
   * settings record. There is no form: the sentence is the form.
   */
  var recent = locals.recentRules || [];
  var pending = locals.pendingRules || [];
  var about = locals.about || '';
  var askReturnHref = question ? '/ask?q=' + encodeURIComponent(question) : '/ask';
  function evidenceHref(href, label) {
    if (!href) return null;
    if (!String(href).startsWith('/') || String(href).startsWith('/foundry/navigate?')) return href;
    return '/foundry/navigate?to=' + encodeURIComponent(href)
      + '&label=' + encodeURIComponent('Open ' + label)
      + '&return=' + encodeURIComponent(askReturnHref);
  }
%>

<div class="rm-line">

  <% if (!question && !result && !error) { %>
    <p class="rm-stamp">The line</p>
    <h1 class="rm-verdict">Tell me anything.</h1>
    <p class="rm-prose">
      What happened, what you want, how you want this run. I work out which it is.
      Nothing I understand as a change is carried out until you have seen exactly what it does.
    </p>
  <% } %>

  <% if (about) { %>
    <p class="rm-stamp">About: <%= about %></p>
  <% } %>

  <% if (error) { %>
    <div class="rm-turn">
      <p class="rm-turn__who">Foundry</p>
      <p class="rm-turn__said"><%= error %></p>
    </div>
  <% } %>

  <% if (result) { %>
    <div class="rm-turn">
      <p class="rm-turn__who">You asked</p>
      <p class="rm-turn__said"><%= result.question %></p>
    </div>

    <div class="rm-turn">
      <p class="rm-turn__who">Foundry</p>
      <%
        /*
         * The sentence first, the record underneath. `spoken` is a phrasing of
         * the same figures — every number in it was checked against the
         * computed answer before it got here, and dropped if it did not match.
         * The computed answer is still shown, because it is the statement of
         * record and is true whether or not a model was there to read it out.
         */
      %>
      <% if (result.spoken && !result.progressiveDisclosure) { %>
        <p class="rm-turn__said"><%= result.spoken %></p>
        <p class="rm-turn__said rm-quiet" style="font-size:17px;white-space:pre-line"><%= result.answer %></p>
      <% } else { %>
        <p class="rm-turn__said" style="white-space:pre-line"><%= result.answer %></p>
      <% } %>

      <% if (result.rows && result.rows.length && result.progressiveDisclosure) { %>
        <details class="rm-disclose" style="margin-top:18px">
          <summary>See how I worked this out</summary>
          <div class="rm-told" style="margin-top:12px">
            <% result.rows.slice(0, 12).forEach(function (row) { %>
              <%
                var first = result.columns[0];
                var label = row[first] === null || row[first] === undefined ? '—' : row[first];
                var rest = result.columns.slice(1).map(function (column) {
                  var value = row[column];
                  if (value === null || value === undefined) return null;
                  return helpers.columnLabel(column) + ' ' + value;
                }).filter(Boolean).join(' · ');
                var linkHref = evidenceHref(row.href, label);
              %>
              <div class="rm-told__row">
                <span class="rm-told__t"><% if (linkHref) { %><a class="rm-u" href="<%= linkHref %>"><%= label %></a><% } else { %><%= label %><% } %></span>
                <span class="rm-told__m"><%= rest %></span>
              </div>
            <% }) %>
          </div>
        </details>
      <% } else if (result.rows && result.rows.length) { %>
        <div class="rm-told" style="margin-top:18px">
          <% result.rows.slice(0, 12).forEach(function (row) { %>
            <%
              var first = result.columns[0];
              var label = row[first] === null || row[first] === undefined ? '—' : row[first];
              var rest = result.columns.slice(1).map(function (column) {
                var value = row[column];
                if (column === 'occurredAt') value = helpers.dateTime(value);
                if (column === 'operation') value = helpers.operationLabel(value);
                if (column === 'expiresAt') value = helpers.shortDate(value);
                if (value === null || value === undefined) return null;
                return helpers.columnLabel(column) + ' ' + value;
              }).filter(Boolean).join(' · ');
              var linkHref = evidenceHref(row.href, label);
            %>
            <div class="rm-told__row">
              <span class="rm-told__t"><% if (linkHref) { %><a class="rm-u" href="<%= linkHref %>"><%= label %></a><% } else { %><%= label %><% } %></span>
              <span class="rm-told__m"><%= rest %></span>
            </div>
          <% }) %>
        </div>
        <% if (result.rows.length > 12) { %>
          <p class="rm-stamp" style="margin-top:10px"><%= result.rows.length - 12 %> more not shown</p>
        <% } %>
      <% } %>

      <% if (result.handoff) { %>
        <p class="rm-choices" style="margin-top:18px"><a class="rm-btn" href="<%= result.handoff.href %>"><%= result.handoff.label %></a></p>
      <% } %>

      <% if (result.isAction) { %>
        <%# Saying "Foundry cannot move stock" would be false — it can. So the
            request is handed straight over rather than explained away. %>
        <form method="post" action="/actions/ask" style="margin-top:18px" data-busy>
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <input type="hidden" name="instruction" value="<%= result.question %>">
          <button class="rm-btn" type="submit">Work out what that would change</button>
        </form>
        <p class="rm-stamp" style="margin-top:10px">Nothing has changed. You will see the exact change before it happens.</p>
      <% } %>

      <% if (!result.supported && !result.isAction) { %>
        <p class="rm-stamp" style="margin-top:18px">Things I can answer</p>
        <div class="rm-suggest">
          <% examples.slice(0, 4).forEach(function (example) { %>
            <a href="/ask?q=<%= encodeURIComponent(example) %>"><%= example %></a>
          <% }) %>
        </div>
      <% } %>

      <% if (result.supported || result.isAction) { %>
        <p class="rm-disclose">
          <a href="#" onclick="var d=document.getElementById('read-as');d.hidden=!d.hidden;return false;">How I read that</a>
        </p>
        <p class="rm-stamp" id="read-as" hidden>
          Read as “<%= result.plan.intent.replace(/_/g, ' ') %>”<%
          %><% if (result.plan.entityQuery) { %> for “<%= result.plan.entityQuery %>”<% } %><%
          %><% if (result.plan.locationQuery) { %> at “<%= result.plan.locationQuery %>”<% } %>
          · <%= result.rowCount %> <%= helpers.plural(result.rowCount, 'row') %> from your records
          · nothing changed — asking is not doing, and changes are approved on the actions page
        </p>
      <% } %>
    </div>
  <% } %>

  <%
    /*
     * A rule Foundry has understood but not yet been given. This is the card
     * the concept is built on: the settings record, rendered the moment it is
     * created, in the owner's own words, with its controls attached.
     */
  %>
  <% pending.forEach(function (rule) { %>
    <div class="rm-turn">
      <p class="rm-turn__who">Foundry</p>
      <p class="rm-turn__said">I read that as a standing rule. Is this right?</p>
      <div class="rm-rule">
        <p class="rm-rule__k">Waiting for you · not in force yet</p>
        <p class="rm-rule__t"><%= rule.summary || rule.statedAs %></p>
        <p class="rm-rule__m">
          <a href="/operating-instructions/<%= rule.id %>">Check it and turn it on</a>
          <% if (rule.questions && rule.questions.length) { %>
            <span class="rm-quiet">— <%= rule.questions[0] %></span>
          <% } %>
        </p>
      </div>
    </div>
  <% }) %>

  <%# ------------------------------------------------------------- composer %>
  <%- include('../partials/composer', {
    composerPrefill: about ? 'About ' + about + ': ' : '',
  }) %>

  <% if (!aiConfigured) { %>
    <p class="rm-stamp" style="margin-top:14px;color:var(--copper)">
      Foundry needs its model connection before it can read a sentence. Everything on the desk works without one.
    </p>
  <% } else if (!result) { %>
    <div class="rm-suggest">
      <% examples.forEach(function (example) { %>
        <a href="/ask?q=<%= encodeURIComponent(example) %>"><%= example %></a>
      <% }) %>
    </div>
  <% } %>

  <%# ------------------------------------------------- what has already been said %>
  <% if (recent.length) { %>
    <p class="rm-stamp" style="margin-top:48px">Lately you told me</p>
    <div class="rm-told">
      <% recent.slice(0, 4).forEach(function (rule) { %>
        <div class="rm-told__row">
          <span class="rm-told__t"><%= rule.summary || rule.statedAs %></span>
          <span class="rm-told__m is-ok"><%= helpers.shortDate(rule.approvedAt || rule.createdAt) %></span>
        </div>
      <% }) %>
    </div>
    <p class="rm-disclose"><a href="/what-you-told-me">Everything you've told me</a></p>
  <% } %>

</div>
