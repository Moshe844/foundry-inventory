<header class="page-head"><div><h1>Your conversations</h1><p>Each conversation keeps its questions, answers and recorded decisions together.</p></div><a class="btn" href="/ask">Back to Ask StockChief</a></header>
<div class="ask-history-tools"><form method="get" action="/ask/history" role="search"><label><span class="visually-hidden">Search your conversations</span><input class="input" type="search" name="q" value="<%= q %>" placeholder="Search what you asked" autocomplete="off"></label><button class="btn" type="submit">Search</button></form>
<form method="get" action="/ask/history" class="form-actions"><label for="history-status">Find requests by status</label><select id="history-status" name="status"><option value="all">All requests</option><% for(const [value,label] of Object.entries(requireLabels)){ %><option value="<%= value %>"><%= label %></option><% } %></select><button class="btn" type="submit">Filter</button></form></div>
<section class="card ask-history"><div class="card-body"><% if(!chats.length){ %><p><%= q?'No conversations match that search.':'No saved conversations yet.' %></p><% } %><% for(const chat of chats){ %><article class="sc-conversation-row"><%- include('chat-row',{chat}) %><p><%= chat.request_count %> <%= chat.request_count===1?'request':'requests' %></p></article><% } %><%- include('../partials/pager') %></div></section>
