<header class="page-head"><div><h1>Your conversations</h1><p>Each conversation keeps its questions, answers and recorded decisions together.</p></div><a class="btn" href="/ask">Back to Ask StockChief</a></header>
<form method="get" action="/ask/history" class="form-actions"><label for="history-status">Find requests by status</label><select id="history-status" name="status"><option value="all">All requests</option><% for(const [value,label] of Object.entries(requireLabels)){ %><option value="<%= value %>"><%= label %></option><% } %></select><button class="btn" type="submit">Filter</button></form>
<section class="card"><div class="card-body"><% if(!chats.length){ %><p>No saved conversations yet.</p><% } %><% for(const chat of chats){ %><article class="sc-conversation-row"><a href="<%= chat.href %>"><strong><%= chat.original_request %></strong></a><p><time data-local-time datetime="<%= new Date(chat.created_at).toISOString() %>"><%= helpers.dateTime(chat.created_at) %></time> · <%= chat.request_count %> <%= chat.request_count===1?'request':'requests' %></p></article><% } %></div></section>
