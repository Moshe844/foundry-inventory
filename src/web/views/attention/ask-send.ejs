<form class="ask-send" method="post" action="/foundry/tell" data-busy><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="queryConversation" value="1"><% if(locals.currentChatId){ %><input type="hidden" name="chatId" value="<%= currentChatId %>"><% } %><% if(locals.currentChatContext){ %><input type="hidden" name="chatContext" value="<%= currentChatContext %>"><% } %><% if(locals.sourcePath){ %><input type="hidden" name="sourcePath" value="<%= sourcePath %>"><% } %><input type="hidden" name="message" value="<%= message %>"><button class="<%= locals.sendClass||'' %>" type="submit"><%= label %></button></form>
