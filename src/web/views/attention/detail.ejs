<% const livePlan = locals.plan; %>
<% const preparedOnly = Boolean(livePlan && livePlan.prepared && livePlan.prepared.orders.length && !livePlan.purchase && livePlan.transfers.length === 0); %>
<% const preparedOrder = preparedOnly ? livePlan.prepared.orders[0] : null; %>
<% const preparedNumbers = preparedOnly ? livePlan.prepared.orders.map(function(order) { return order.poNumber; }).join(', ') : ''; %>

<div class="page-head">
  <div class="titles">
    <a class="back-link" href="/attention"><%- helpers.icon('chevron', { size: 14 }) %> Needs attention</a>
    <h1><%= item.title %></h1>
    <div class="page-sub"><%= item.conciseSummary %></div>
  </div>
  <div class="page-actions">
    <% if (!preparedOnly && item.status === 'OPEN') { %>
      <form method="post" action="/attention/<%= item.attentionId %>/acknowledge">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <input type="hidden" name="returnTo" value="/attention/<%= item.attentionId %>">
        <button class="btn btn--primary" type="submit">I'm on it</button>
      </form>
    <% } %>
    <% if (!preparedOnly && (item.status === 'OPEN' || item.status === 'ACKNOWLEDGED')) { %>
      <form class="dismiss-form" method="post" action="/attention/<%= item.attentionId %>/dismiss">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <input type="hidden" name="returnTo" value="/attention/<%= item.attentionId %>">
        <button class="btn" type="submit">Not a problem</button>
        <select class="select" name="days" aria-label="Hide this for how long">
          <option value="14" selected>for 2 weeks</option>
          <option value="30">for a month</option>
          <option value="90">for 3 months</option>
          <option value="365">for a year</option>
        </select>
      </form>
    <% } %>
  </div>
</div>

<div class="badge-row">
  <% if (preparedOnly) { %>
    <span class="badge badge--warn">Needs approval</span>
    <span class="badge badge--muted">Draft purchase order</span>
  <% } else { %>
    <span class="badge badge--<%= item.severityTone %>"><%= item.severityLabel %></span>
    <span class="badge badge--muted"><%= item.categoryLabel %></span>
  <% } %>
  <% item.relatedLabels.forEach(function (label) { %>
    <span class="badge badge--muted">also <%= label.toLowerCase() %></span>
  <% }) %>
  <% if (item.status === 'RESOLVED') { %><span class="badge badge--ok">Resolved</span><% } %>
  <% if (item.status === 'ACKNOWLEDGED') { %><span class="badge badge--ok">Being handled</span><% } %>
  <% if (item.status === 'DISMISSED') { %><span class="badge badge--muted">Hidden until <%= helpers.shortDate(item.dismissedUntil) %></span><% } %>
</div>

<div class="grid <%= preparedOnly ? '' : 'grid--sidebar' %> section">
  <div class="grid">
    <% if (preparedOnly) { %>
      <div class="card">
        <div class="card-head">
          <h2><%= livePlan.prepared.units %> <%= livePlan.unitLabel %>(s) are ready to order</h2>
          <span class="spacer"></span><span class="badge badge--warn">Draft</span>
        </div>
        <div class="card-body">
          <p class="lede">
            Foundry prepared <strong><%= preparedNumbers %></strong> for the <%= livePlan.prepared.units %>
            <%= livePlan.unitLabel %>(s) needed. It is only a draft: the supplier has not received it,
            and these units are not on order yet.
          </p>
          <table class="table table--tight" style="margin:16px 0;">
            <tbody>
              <tr><td>On hand now</td><td class="right num"><strong><%= livePlan.onHandTotal %></strong></td></tr>
              <tr><td>Prepared in <%= preparedNumbers %></td><td class="right num"><strong><%= livePlan.prepared.units %></strong></td></tr>
              <tr><td>On order now</td><td class="right num"><strong><%= livePlan.onOrder %></strong></td></tr>
              <tr><td>On hand after the full order arrives</td><td class="right num"><strong><%= livePlan.onHandTotal + livePlan.prepared.units %></strong></td></tr>
            </tbody>
          </table>
          <a class="btn btn--primary" href="/purchasing/orders/<%= preparedOrder.poId %>">Review and place <%= preparedOrder.poNumber %></a>
          <p class="muted" style="font-size:12px; margin-top:8px;">
            On the next page, choose <strong>Approve and mark as ordered</strong>. Nothing is sent or counted as incoming before you approve it.
          </p>
        </div>
      </div>
    <% } else { %>
    <div class="card">
      <div class="card-head"><h2>What Foundry found</h2></div>
      <div class="card-body">
        <p class="lede"><%= item.explanation %></p>

        <%# The whole replenishment answer, in the order it was worked out. It is
            rendered here rather than summarised because approving a plan you
            cannot check is not approval. %>
        <% const plan = livePlan; %>
        <% if (plan) { %>
          <div class="rep-plan">
            <div class="rep-plan-head">
              <strong><%= plan.headline %></strong>
              <span class="badge <%= plan.decision === 'none' ? 'badge--muted' : 'badge--warn' %>">
                <%= { transfer_and_purchase: 'Move and order', transfer: 'Move only',
                      purchase: 'Order only', none: 'No action' }[plan.decision] %>
              </span>
            </div>

            <table class="rep-plan-table">
              <thead>
                <tr><th>Location</th><th>Now</th><th>Needs</th><th>Reserve</th><th>After</th></tr>
              </thead>
              <tbody>
                <% (plan.after ? plan.after.byLocation : plan.byLocation).forEach(function (row) { %>
                  <tr>
                    <td><%= row.locationName %></td>
                    <td><%= row.before === undefined ? row.onHand : row.before %></td>
                    <td><%= row.need %></td>
                    <td><%= row.reserveFloor ? row.reserveFloor : '—' %></td>
                    <td<%= row.meetsNeed === false ? ' class="rep-short"' : '' %>><%= row.after === undefined ? row.onHand : row.after %></td>
                  </tr>
                <% }); %>
              </tbody>
            </table>

            <% if (plan.transfers.length) { %>
              <h3 class="rep-plan-sub">Move</h3>
              <ul class="plain-list">
                <% plan.transfers.forEach(function (move) { %>
                  <li>
                    <strong><%= move.quantity %> <%= plan.unitLabel %>(s)</strong>
                    from <%= move.fromLocationName %> to <%= move.toLocationName %>.
                    <span class="muted"><%= move.why %></span>
                  </li>
                <% }); %>
              </ul>
            <% } %>

            <% if (plan.purchase) { %>
              <h3 class="rep-plan-sub">Order</h3>
              <ul class="plain-list">
                <li>
                  <strong><%= plan.purchase.quantityPurchaseUnits %> <%= plan.purchase.purchaseUnit %>(s)</strong>
                  — <%= plan.purchase.quantityUnits %> <%= plan.unitLabel %>(s) from <%= plan.purchase.supplierName %>,
                  arriving in about <%= plan.purchase.leadTimeDays %> days<%= plan.purchase.leadTimeAssumed ? ' (assumed)' : '' %>.
                  <% if (plan.purchase.estimatedCost !== null) { %>
                    <span class="muted">About <%= plan.purchase.estimatedCost %> in total.</span>
                  <% } %>
                </li>
              </ul>
            <% } %>

            <% if (plan.prepared) { %>
              <h3 class="rep-plan-sub">Already prepared</h3>
              <ul class="plain-list">
                <li>
                  <%= plan.prepared.units %> <%= plan.unitLabel %>(s) are on
                  <% plan.prepared.orders.forEach(function (order, i) { %><%= i ? ', ' : '' %><a href="/purchasing/orders/<%= order.poId %>"><%= order.poNumber %></a><% }); %>,
                  waiting for approval. Foundry is not proposing another order for the same stock.
                </li>
              </ul>
            <% } %>

            <% if (plan.blocked === 'no_supplier') { %>
              <p class="muted" style="margin-top:8px;">
                No supplier is linked to this line, so Foundry cannot work out a pack size, a cost or a lead time.
                <a href="/purchasing/supplier-for/<%= plan.skuId %>">Add one for this line</a> and it will.
              </p>
            <% } %>

            <details class="rep-plan-working">
              <summary>How Foundry worked this out</summary>
              <ol class="plain-list">
                <% plan.calculation.forEach(function (line) { %>
                  <li><%= line.detail %></li>
                <% }); %>
              </ol>
            </details>

            <% if (plan.after) { %>
              <p class="rep-plan-after">
                Afterwards: <strong><%= plan.after.onHandAfterMoves %></strong> on hand across every location<%
                  %><% if (plan.purchase && plan.after.onHandAfterDelivery === plan.target) { %>, reaching the
                  order-up-to level of <strong><%= plan.target %></strong> when the order arrives<% } else if (plan.purchase) { %>.
                  The order-up-to target is <strong><%= plan.target %></strong>; whole <%= plan.purchase.purchaseUnit %> quantities
                  mean the projected on-hand quantity after arrival is <strong><%= plan.after.onHandAfterDelivery %></strong><% } %>.
              </p>
            <% } %>
          </div>
        <% } %>

        <div class="att-rec-box">
          <span class="att-rec-icon"><%- helpers.icon('foundry', { size: 16 }) %></span>
          <div>
            <strong>What you might do</strong>
            <p><%= item.recommendation %></p>
            <% if (typeof actionable !== 'undefined' && actionable) { %>
              <%# Both halves of the plan get a way to act on them. Offering only
                  the transfer left the order — the half that spends money —
                  with nowhere to go but a screen the reader has to find. %>
              <div class="rep-plan-actions">
                <form method="post" action="/attention/<%= item.attentionId %>/action">
                  <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                  <button class="btn btn--primary btn--sm" type="submit">Review transfer</button>
                </form>
                <% if (locals.plan && locals.plan.purchase) { %>
                  <form method="post" action="/purchasing/prepare/<%= locals.plan.purchase.supplierId %>">
                    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                    <button class="btn btn--sm" type="submit">Review the order</button>
                  </form>
                <% } %>
              </div>
              <p class="muted" style="font-size:12px; margin-top:8px;">
                <% if (locals.plan && locals.plan.purchase) { %>
                  Each opens as a draft you approve. Nothing moves and nothing is ordered until you say so.
                <% } else { %>
                  Foundry will work out the exact movement and show it to you. Nothing moves until you approve it.
                <% } %>
              </p>
            <% } else if (locals.plan && locals.plan.purchase) { %>
              <form method="post" action="/purchasing/prepare/<%= locals.plan.purchase.supplierId %>" style="margin-top:10px;">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                <button class="btn btn--primary btn--sm" type="submit">Review the order</button>
              </form>
              <p class="muted" style="font-size:12px; margin-top:8px;">
                It opens as a draft order you approve. Nothing is ordered until you say so.
              </p>
            <% } else if (item.category === 'stock_protection_boundary' && item.subjects && item.subjects.length) { %>
              <a class="btn btn--primary btn--sm" href="<%= item.subjects[0].href %>">Review stock and ordering</a>
              <p class="muted" style="font-size:12px; margin-top:8px;">
                This opens the exact product and its current stock. From there you can record a receipt,
                set replenishment, or change the protection rule in Settings.
              </p>
            <% } else { %>
              <%# True as written: the one thing Foundry does unattended is balancing
                  its own locations under an approved policy, and that is never this
                  branch. Everything else waits for a person. %>
              <p class="muted" style="font-size:12px; margin-top:6px;">
                <%= typeof actionMessage !== 'undefined' && actionMessage
                    ? actionMessage
                    : 'There is nothing here Foundry acts on by itself. This is a suggestion for you to act on.' %>
              </p>
            <% } %>
          </div>
        </div>

        <% if (item.status === 'RESOLVED' && item.resolutionReason) { %>
          <p class="muted" style="margin-top:12px;">
            Closed <%= helpers.timeAgo(item.resolvedAt) %>: <%= item.resolutionReason %>
          </p>
        <% } %>
      </div>
    </div>
    <% } %>

    <% if (preparedOnly) { %>
      <details class="card advanced-settings">
        <summary class="card-head">
          <div><h2>Calculation and evidence</h2><p class="muted">Why Foundry prepared this quantity.</p></div>
        </summary>
    <% } else { %>
      <div class="card">
        <div class="card-head">
        <h2>The evidence</h2>
        <span class="spacer"></span>
        <span class="muted" style="font-size:12px;">Straight from your movement history</span>
        </div>
    <% } %>
      <div class="table-wrap">
        <table class="table">
          <tbody>
            <% item.measuredEvidence.forEach(function (fact) { %>
              <tr>
                <td class="muted"><%= fact.label %></td>
                <td class="right num"><%= fact.value %></td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
      <% if (item.estimatedEvidence.length) { %>
        <div class="card-head" style="border-top:1px solid var(--line);">
          <h3 style="font-size:13px;">Foundry's working</h3>
          <span class="spacer"></span>
          <span class="badge badge--muted">estimated</span>
        </div>
        <div class="table-wrap">
          <table class="table">
            <tbody>
              <% item.estimatedEvidence.forEach(function (fact) { %>
                <tr>
                  <td class="muted"><%= fact.label %></td>
                  <td class="right"><%= fact.value %></td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
        <div class="card-foot muted">
          These are calculated from the measured figures above, not counted. <%= item.confidenceNote %>
        </div>
      <% } %>
    <% if (preparedOnly) { %></details><% } else { %></div><% } %>

    <% if (item.movements.length) { %>
      <div class="card">
        <div class="card-head"><h2>The movements behind this</h2></div>
        <div class="table-wrap">
          <table class="table">
            <thead>
              <tr><th>When</th><th>What</th><th>Where</th><th class="right">Change</th><th>Who</th></tr>
            </thead>
            <tbody>
              <% item.movements.forEach(function (movement) { %>
                <tr>
                  <td><%= helpers.dateTime(movement.occurredAt) %></td>
                  <td>
                    <a class="cell-title" href="/inventory/<%= movement.itemId %>"><%= movement.itemName %></a>
                    <span class="cell-sub"><%= helpers.operationLabel(movement.operation) %><% if (movement.reason) { %> · <%= helpers.reasonText(movement.operation, movement.reason) %><% } %></span>
                  </td>
                  <td><%= movement.locationName %></td>
                  <td class="right num"><%= movement.delta > 0 ? '+' : '' %><%= helpers.qty(movement.delta) %></td>
                  <td><%= movement.actorName %></td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
      </div>
    <% } %>
  </div>

  <% if (!preparedOnly) { %>
  <div class="grid">
    <div class="card">
      <div class="card-head"><h2>Was this useful?</h2></div>
      <div class="card-body">
        <p class="muted" style="font-size:13px; margin-bottom:10px;">
          Foundry records your answer. It will not quietly change what it checks —
          if a rule is wrong, that is something to fix openly.
        </p>
        <div class="btn-row">
          <form method="post" action="/attention/<%= item.attentionId %>/rate">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <input type="hidden" name="verdict" value="useful">
            <button class="btn btn--sm" type="submit">Useful</button>
          </form>
          <form method="post" action="/attention/<%= item.attentionId %>/rate">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <input type="hidden" name="verdict" value="not_useful">
            <button class="btn btn--sm" type="submit">Not useful</button>
          </form>
        </div>
      </div>
      <% if (history.length) { %>
        <div class="table-wrap">
          <table class="table">
            <tbody>
              <% history.forEach(function (entry) { %>
                <tr>
                  <td>
                    <span class="cell-title"><%= entry.verdict.replace('_', ' ') %></span>
                    <span class="cell-sub"><%= entry.actorName %> · <%= helpers.timeAgo(entry.createdAt) %></span>
                  </td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
      <% } %>
    </div>

    <div class="card">
      <div class="card-head"><h2>Details</h2></div>
      <div class="table-wrap">
        <table class="table">
          <tbody>
            <tr><td class="muted">First detected</td><td class="right"><%= helpers.dateTime(item.firstDetectedAt) %></td></tr>
            <tr><td class="muted">Last checked</td><td class="right"><%= helpers.timeAgo(item.lastEvaluatedAt) %></td></tr>
            <tr><td class="muted">Confidence</td><td class="right"><%= item.confidence %></td></tr>
            <tr><td class="muted">Detection rules</td><td class="right mono"><%= item.detectionRuleVersion %></td></tr>
            <tr><td class="muted">Wording</td><td class="right"><%= item.isReworded ? 'Foundry, from the figures above' : 'Foundry, deterministic' %></td></tr>
          </tbody>
        </table>
      </div>
    </div>

    <% if (item.subjects.length || item.locations.length) { %>
      <div class="card">
        <div class="card-head"><h2>What this is about</h2></div>
        <div class="card-body">
          <div class="btn-row">
            <% item.subjects.forEach(function (subject) { %>
              <a class="btn btn--sm" href="<%= subject.href %>"><%= subject.name %></a>
            <% }) %>
            <% item.locations.forEach(function (location) { %>
              <a class="btn btn--sm btn--ghost" href="<%= location.href %>"><%= location.name %></a>
            <% }) %>
          </div>
        </div>
      </div>
    <% } %>
  </div>
  <% } %>
</div>
