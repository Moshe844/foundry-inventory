<details class="ask-download" data-ask-download><summary><%- helpers.icon('download',{size:14}) %> <%= locals.fullAnswer?'Download answer':'Download' %></summary><div class="ask-download__menu">
<% for(const [extension,label] of (locals.formats||[['pdf','PDF'],['xlsx','Excel'],['csv','CSV']])){ %><a href="<%= base %><%= extension?'.'+extension:'' %><%= locals.fullAnswer?'?content=answer':'' %>" download><%= label %></a><% } %>
</div></details>
