<div class="ask-actions" aria-label="Answer actions"><% if(locals.answerText){ %><button class="ask-action" type="button" data-copy="<%= answerText %>">Copy</button><% } %><% if(locals.question){ %><a class="ask-action" href="/ask?chat=<%= encodeURIComponent(currentChatId) %>&amp;q=<%= encodeURIComponent(question) %>#ask-question">Edit question</a><%- include('ask-send',{message:question,label:'Ask again',sendClass:'ask-action'}) %><% } %><% if(locals.interactionId){ %><a class="ask-action" href="/autopilot/misses?interaction=<%= encodeURIComponent(interactionId) %>">Report a problem</a><% } %></div>
