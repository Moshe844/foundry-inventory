<header class="page-head"><h1>Audit trail</h1><p>Recorded stock movements, variant changes, prices, costs and order events. Older events may not have a recorded prior value. Dates below use UTC.</p></header>
<form method="get" action="/audit"><label>Person <select name="user"><option value="">Everyone</option><% for(const user of users){ %><option value="<%= user.id %>" <%= filters.user===user.id?'selected':'' %>><%= user.name %></option><% } %></select></label><label>Product, variant or SKU <input name="q" value="<%= filters.q %>"></label><label>From <input type="date" name="from" value="<%= filters.from %>"></label><label>Through <input type="date" name="to" value="<%= filters.to %>"></label><button class="btn" type="submit">Apply filters</button> <a class="btn" download href="/audit/export?<%= new URLSearchParams(filters) %>">Export CSV</a></form>
<div class="table-wrap"><table class="table"><thead><tr><th>When (UTC)</th><th>Who</th><th>Change</th><th>Product / reference</th><th>Before</th><th>After</th></tr></thead><tbody><% for(const row of rows){ %><tr><td><time datetime="<%= row.at %>"><%= row.at.replace('T',' ').replace('.000Z',' UTC') %></time></td><td><%= row.who %></td><td><%= row.action %></td><td><%= [row.product,row.variant,row.sku,row.location,row.reference].filter(Boolean).join(' · ') %></td><td><%= row.before %></td><td><%= row.after %></td></tr><% } %></tbody></table></div><% if(!rows.length){ %><p>No recorded changes match these filters.</p><% } %><% if(hasMore){ %><a class="btn" href="/audit?<%= new URLSearchParams({...filters,after:next}) %>">Older changes</a><% } %>
