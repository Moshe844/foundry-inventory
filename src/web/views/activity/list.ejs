<div class="page-head">
  <div class="titles">
    <h1>Activity</h1>
    <div class="page-sub">
      What happened to your operation — stock, orders, differences and the work
      Foundry did about them. <a href="/autopilot/history">Foundry's own working</a> is kept separately.
    </div>
  </div>
</div>

<%# Which part of the story to read. Everything is one stream underneath, but
    a person asking "what happened to my stock" and a person auditing routine
    checks are asking different questions, and answering both at once is what
    buried the sale under fifty inventory checks. %>
<nav class="act-streams section" aria-label="Filter activity">
  <% streams.concat(['all']).filter(function (s, i, a) { return a.indexOf(s) === i; }).sort(function (a, b) {
       var order = ['all', 'inventory', 'purchasing', 'foundry', 'exception', 'system'];
       return order.indexOf(a) - order.indexOf(b);
     }).forEach(function (name) { %>
    <a class="chip <%= stream === name ? 'is-active' : '' %>"
       href="/activity?stream=<%= name %><%= query ? '&q=' + encodeURIComponent(query) : '' %>">
      <%= streamLabels[name] %>
      <% if (log.counts[name]) { %><span class="chip-count"><%= log.counts[name] %></span><% } %>
    </a>
  <% }) %>
</nav>

<form class="filters" method="get" action="/activity">
  <input type="hidden" name="stream" value="<%= stream %>">
  <input class="input filter-search" type="search" name="q" value="<%= query %>"
         placeholder="Search this activity" aria-label="Search activity">
</form>

<form class="filters" method="get" action="/activity">
  <input type="hidden" name="stream" value="<%= stream %>">
  <select class="select" name="operation" aria-label="Operation" data-auto-submit>
    <option value="">All operations</option>
    <% helpers.OPERATIONS.forEach(function (operation) { %><option value="<%= operation.id %>" <%= filters.operation === operation.id ? 'selected' : '' %>><%= operation.label %></option><% }) %>
  </select>
  <select class="select" name="item" aria-label="Item" data-auto-submit><option value="">All items</option><% items.forEach(function (row) { %><option value="<%= row.id %>" <%= filters.itemId === row.id ? 'selected' : '' %>><%= row.name %></option><% }) %></select>
  <select class="select" name="location" aria-label="Location" data-auto-submit><option value="">All locations</option><% locations.forEach(function (location) { %><option value="<%= location.id %>" <%= filters.locationId === location.id ? 'selected' : '' %>><%= location.name %></option><% }) %></select>
  <select class="select" name="user" aria-label="Person" data-auto-submit><option value="">Anyone</option><% users.forEach(function (user) { %><option value="<%= user.id %>" <%= filters.actorId === user.id ? 'selected' : '' %>><%= user.name %></option><% }) %></select>
  <input class="input" type="date" name="from" value="<%= filters.dateFrom %>" aria-label="From date">
  <input class="input" type="date" name="to" value="<%= filters.dateTo %>" aria-label="To date">
  <button class="btn btn--sm" type="submit">Apply</button>
  <% if (filters.operation || filters.itemId || filters.locationId || filters.actorId || filters.dateFrom || filters.dateTo) { %><a class="btn btn--ghost btn--sm" href="/activity">Clear</a><% } %>
</form>

<div class="card section">
  <div class="card-head">
    <h2><%= streamLabels[stream] %></h2>
    <span class="spacer"></span>
    <span class="muted" style="font-size:12.5px;">Newest first</span>
  </div>
  <div class="card-body">
    <% if (!log.events.length) { %>
      <div class="empty">
        <div class="icon-wrap"><%- helpers.icon('empty', { size: 22 }) %></div>
        <h3>Nothing here yet</h3>
        <p>When stock moves, an order is placed or a difference is found, it appears here.</p>
      </div>
    <% } else { %>
      <ol class="act-log ledger">
        <% log.events.forEach(function (event) { %>
          <li class="act-log__row act-log__row--<%= event.stream %>">
            <div class="act-log__body">
              <a class="act-log__title" href="<%= event.href %>"><%= event.title %></a>
              <% if (event.detail) { %><p class="act-log__detail"><%= event.detail %></p><% } %>
              <p class="act-log__meta">
                <span class="badge badge--muted"><%= streamLabels[event.stream] %></span>
                <% if (event.who) { %><span><%= event.who %></span><% } %>
                <% if (event.at) { %><span><%= helpers.timeAgo ? helpers.timeAgo(event.at) : event.at %></span><% } %>
              </p>
            </div>
          </li>
        <% }) %>
      </ol>
      <% if (stream === 'all' && log.quietChecks) { %>
        <p class="muted" style="font-size:12.5px; margin-top:12px;">
          <%= log.quietChecks %> routine check<%= log.quietChecks === 1 ? '' : 's' %> found nothing and
          <a href="/activity?stream=system"><%= log.quietChecks === 1 ? 'is' : 'are' %> kept out of the way</a>.
        </p>
      <% } %>
    <% } %>
  </div>
</div>

<% if ((stream === 'all' || stream === 'inventory') && !query) { %>
<details class="section">
  <summary class="muted" style="cursor:pointer; font-size:13px;">Raw movement details</summary>

<div class="card">
  <div class="card-head">
    <h2><%= helpers.qty(total) %> <%= helpers.plural(total, 'movement') %></h2>
    <span class="spacer"></span>
    <span class="muted" style="font-size:12.5px;">Newest first</span>
  </div>
  <% if (groups.length === 0) { %>
    <div class="empty">
      <div class="icon-wrap"><%- helpers.icon('activity', { size: 22 }) %></div>
      <h3>No movements match</h3>
      <p>Inventory changes appear here as soon as somebody receives, issues, transfers or adjusts stock.</p>
      <a class="btn" href="/activity">Clear filters</a>
    </div>
  <% } else { %>
    <%- include('../partials/ledger', { groups: groups, helpers: helpers, ledgerClass: 'raw-movement-ledger' }) %>
    <% if (page > 1 || hasMore) { %>
      <div class="card-foot" style="display:flex; gap:8px; align-items:center;">
        <span class="muted">Page <%= page %></span>
        <span style="margin-left:auto; display:flex; gap:8px;">
          <% if (page > 1) { %>
            <a class="btn btn--sm" href="/activity<%= helpers.queryString(query, { page: page - 1 }) %>">Previous</a>
          <% } %>
          <% if (hasMore) { %>
            <a class="btn btn--sm" href="/activity<%= helpers.queryString(query, { page: page + 1 }) %>">Next</a>
          <% } %>
        </span>
      </div>
    <% } %>
  <% } %>
</div>
</details>
<% } %>
