<div class="page-head">
  <div class="titles">
    <span class="setup-eyebrow">New inventory</span>
    <h1>How are you managing inventory today?</h1>
    <div class="page-sub">Choose the closest answer. Foundry will do the setup work from there.</div>
  </div>
</div>

<div class="grid grid--2 section">
  <% paths.forEach(function (path) { %>
    <form method="post" action="/onboarding/choose" class="card onboard-card">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <input type="hidden" name="path" value="<%= path.id %>">
      <button class="onboard-choice" type="submit" <%= canOperate ? '' : 'disabled' %>>
        <span class="onboard-icon"><%- helpers.icon(path.icon, { size: 20 }) %></span>
        <span class="onboard-text">
          <strong><%= path.label %></strong>
          <span class="onboard-blurb"><%= path.blurb %></span>
          <span class="muted"><%= path.detail %></span>
        </span>
        <%- helpers.icon('chevron', { size: 16 }) %>
      </button>
    </form>
  <% }) %>
</div>

<div class="card section">
  <div class="card-head"><h2>Not sure? Tell Foundry what's going on.</h2></div>
  <form method="post" action="/onboarding/describe">
    <div class="card-body">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <label class="field">
        <span class="field-label">Tell Foundry what's going on</span>
        <input class="input" type="text" name="description" value="<%= description %>"
               placeholder="We track everything in a couple of spreadsheets and a stock count from last month"
               maxlength="500" autocomplete="off">
      </label>

      <% if (recommendation) { %>
        <div class="notice section">
          <strong>Foundry suggests: <%= paths.find(function (p) { return p.id === recommendation.path; }).label %></strong>
          <div class="muted">Because <%= recommendation.reason %>.</div>
        </div>
        <form method="post" action="/onboarding/choose">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <input type="hidden" name="path" value="<%= recommendation.path %>">
          <input type="hidden" name="chosenBy" value="foundry">
          <input type="hidden" name="reason" value="<%= recommendation.reason %>">
          <input type="hidden" name="describedAs" value="<%= description %>">
          <button class="btn btn--primary" type="submit">Go that way</button>
        </form>
        <p class="muted">Or pick one of the four above — Foundry is only guessing from what you wrote.</p>
      <% } %>
    </div>
    <% if (!recommendation) { %>
      <div class="card-foot"><button class="btn" type="submit">Work out where I fit</button></div>
    <% } %>
  </form>
</div>
