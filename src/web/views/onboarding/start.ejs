<section class="inventory-setup" aria-labelledby="setup-title">
  <header class="setup-header"><span class="setup-eyebrow">Get started</span><h1 id="setup-title">Add your inventory</h1><p>Bring the records you already have. Choose one way to start; add others whenever you’re ready.</p></header>
  <% if(currentUser.role==='owner'){ %><details class="setup-details" data-setup-details><summary><span><%= workspace.name %></span><span class="setup-details__hint">Business name &amp; time zone</span></summary><div class="setup-details__forms">
    <form method="post" action="/onboarding/name"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><label class="field" for="inventory-name"><span>Inventory name</span><input id="inventory-name" name="name" maxlength="120" required value="<%= workspace.name %>"></label><button class="btn btn--secondary" type="submit">Save name</button></form>
    <form method="post" action="/onboarding/time-zone"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><label class="field"><span>Business time zone</span><input name="timeZone" data-business-time-zone value="<%= locals.account?.timeZone||'UTC' %>" required maxlength="100"></label><button class="btn btn--secondary" type="submit">Confirm time zone</button><small>Used for posting dates, reports and activity times.</small></form>
  </div></details><% } %>
  <% const setupActions={software:'Choose a platform',fresh:'Add my first item'}; %>
  <div class="setup-source-grid">
    <article class="setup-source-card setup-source-card--file"><header><span class="setup-icon" aria-hidden="true"><%- helpers.icon('import',{size:24}) %></span><div><h2>Move from files</h2><p>Upload the records you already use.</p></div></header>
      <form method="post" action="<%= locals.importAction||'/onboarding/migrations/new' %>" enctype="multipart/form-data" data-migration-upload data-direct-upload><input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <% if(locals.importAction==='/imports'){ %><input type="hidden" name="prepareAsync" value="yes"><input type="hidden" name="uploadKey" value=""><% } %>
        <label class="setup-drop" data-file-drop><span class="setup-drop__icon" aria-hidden="true"><%- helpers.icon('import',{size:26}) %></span><strong>Drop a file here</strong><span>or choose it from your device</span><span class="setup-file-button">Choose a file</span><input type="file" name="<%= locals.importFieldName||'files' %>" aria-label="Inventory spreadsheets, documents and images" accept="<%= locals.importAction==='/imports'?helpers.importSourceFormats.accept:'.csv,.tsv,.txt,.xlsx' %>" <%= locals.importMultiple===false?'':'multiple' %> data-migration-files></label>
        <div class="setup-upload-selection" data-migration-selection hidden aria-live="polite"></div><div class="setup-upload-progress" data-migration-progress hidden aria-live="polite"><strong data-migration-progress-title>Uploading…</strong><span data-migration-progress-detail></span><progress max="100" value="0" data-migration-progress-bar></progress></div><p class="setup-upload-error" data-migration-error hidden role="alert"></p><button class="btn btn--secondary" type="submit" data-migration-submit hidden>Retry upload</button>
        <a class="setup-text-link" href="<%= locals.importOptionsHref||'/onboarding/migrations/new' %>">Paste records or open upload options →</a>
      </form>
      <% if(locals.importAction==='/imports'){ %><details class="setup-file-types"><summary>Supported files &amp; upload limits</summary><dl><% helpers.importSourceFormats.groups.forEach(group=>{ %><div><dt><%= group.label %></dt><dd><%= group.formats %></dd></div><% }); %><div><dt>Limits</dt><dd>Spreadsheets and text: up to <%= Math.floor(helpers.importSourceFormats.maxBytes/1048576) %> MB. Images: 20 MB, 10 pages and 12 megapixels in total. PDFs: 32 MB and 30 pages.</dd></div><div><dt>Other sources</dt><dd>For XML or ZIP archives, export the records as CSV, JSON or Excel first.</dd></div></dl><p>StockChief prepares a preview before you approve changes. Unclear scans or values are flagged for review.</p></details><% }else{ %><p class="setup-file-types">A CSV, TSV or Excel export with SKU, name and quantity.</p><% } %>
    </article>
    <% sourceOptions.filter(s=>s.id!=='spreadsheet').forEach(source=>{ %><article class="setup-source-card"><header><span class="setup-icon" aria-hidden="true"><%- helpers.icon(source.icon,{size:24}) %></span><div><h2><%= source.label %></h2><p><%= source.id==='software'?'Bring in products from your store or POS.':'Start with your first product.' %></p></div></header><p class="setup-source-copy"><%= source.id==='software'?'Connect a supported platform to bring in products, SKUs and stock. You’ll sign in with that platform and approve access.':'Add products, locations and opening quantities directly in StockChief. You can import or connect a platform later.' %></p><form method="post" action="/onboarding/choose"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="path" value="<%= source.id %>"><button class="btn btn--secondary" type="submit"><%= setupActions[source.id] %> →</button></form></article><% }); %>
  </div>
  <footer class="setup-footer"><form method="post" action="/onboarding/skip"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="btn btn--ghost" type="submit">Skip for now</button></form><span>Nothing is imported until you review and approve it.</span></footer>
  <% if(currentUser.role==='owner'&&!onboardingEntry.dismissed){ %><details class="setup-sample"><summary>Explore with sample records instead</summary><p>Sample data is kept separate from your business.</p><div><form method="post" action="/onboarding/sample/load"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="btn btn--secondary" type="submit">Load sample data to explore</button></form><form method="post" action="/onboarding/sample/dismiss"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="returnTo" value="/onboarding"><button class="btn btn--ghost" type="submit">Dismiss</button></form></div></details><% } %>
</section>