<%
  /*
   * The inventory-source chooser.
   *
   * The same five cards the first-run brief offers, because they are the same
   * decision — somebody arriving here from "Not sure, help me choose" should
   * not meet a different-looking screen asking the same question.
   *
   * What this page adds is the other way in: describe the business in a
   * sentence and let StockChief pick the source for you.
   */
  var options = locals.sourceOptions || [];
  var chosen = state && state.path;
%>

<%- include('../partials/setup-steps', { step: 0 }) %>

<div class="rm-head">
  <p class="rm-head__eyebrow"><%- helpers.icon('layers', { size: 14 }) %> Getting set up</p>
  <h1>Where should StockChief get your inventory from?</h1>
  <p>
    Pick the one that is closest to the truth today. You are not locked in — StockChief can take a
    second source later and reconcile the two.
  </p>
</div>

<%
  /*
   * A description that names the kind of business but carries no real records
   * is not a failure — it just is not a source. It gets its own answer, since
   * there is no recommendation to attach it to.
   */
%>
<% if (locals.sourcePrompt && !locals.recommendation) { %>
  <div class="rm-note" id="source-recommendation">
    <%- helpers.icon('question', { size: 16 }) %>
    <span><%= sourcePrompt %></span>
  </div>
<% } %>

<% if (locals.recommendation) { %>
  <div class="rm-next" id="source-recommendation">
    <p class="rm-stamp"><%- helpers.icon('spark', { size: 13 }) %> From what you described</p>
    <p class="rm-next__t"><%= recommendation.label %></p>
    <% if (locals.sourcePrompt) { %><p class="rm-next__d"><%= sourcePrompt %></p><% } %>
    <% if (locals.recommendedOption && recommendedOption.href) { %>
      <p class="rm-choices" style="margin-top:11px"><a class="rm-btn rm-btn--sm" href="<%= recommendedOption.href %>">Use that source</a></p>
    <% } else { %>
      <form method="post" action="/onboarding/choose" style="margin-top:11px">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <input type="hidden" name="path" value="<%= recommendation.id %>">
        <input type="hidden" name="chosenBy" value="foundry">
        <button class="rm-btn rm-btn--sm" type="submit">Use that source</button>
      </form>
    <% } %>
  </div>
<% } %>

<div class="rm-choices-grid">
  <% options.forEach(function (source) { %>
    <% if (source.href) { %>
      <a class="rm-choice" href="<%= source.href %>">
        <span class="rm-choice__ic"><%- helpers.icon(source.icon || 'box', { size: 19 }) %></span>
        <span class="rm-choice__t"><%= source.label %></span>
        <span class="rm-choice__b"><%= source.blurb %></span>
        <span class="rm-choice__d"><%= source.detail %></span>
        <% if (source.providers) { %>
          <span class="rm-choice__tags"><% source.providers.forEach(function (name) { %><span><%= name %></span><% }) %></span>
        <% } %>
        <span class="rm-choice__go"><%= chosen === source.id ? 'Carry on with this' : 'Choose this' %> <%- helpers.icon('arrowRight', { size: 14 }) %></span>
      </a>
    <% } else { %>
      <form class="rm-choice__form" method="post" action="/onboarding/choose">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <input type="hidden" name="path" value="<%= source.id %>">
        <input type="hidden" name="chosenBy" value="customer">
        <button class="rm-choice" type="submit">
          <span class="rm-choice__ic"><%- helpers.icon(source.icon || 'box', { size: 19 }) %></span>
          <span class="rm-choice__t"><%= source.label %></span>
          <span class="rm-choice__b"><%= source.blurb %></span>
          <span class="rm-choice__d"><%= source.detail %></span>
          <% if (source.providers) { %>
            <span class="rm-choice__tags"><% source.providers.forEach(function (name) { %><span><%= name %></span><% }) %></span>
          <% } %>
          <span class="rm-choice__go"><%= chosen === source.id ? 'Carry on with this' : 'Choose this' %> <%- helpers.icon('arrowRight', { size: 14 }) %></span>
        </button>
      </form>
    <% } %>
  <% }) %>
</div>

<section class="rm-panel" style="margin-bottom:16px">
  <div class="rm-panel__head">
    <%- helpers.icon('chat', { size: 15, className: 'rm-quiet' }) %>
    <h2>Not sure which source fits?</h2>
  </div>
  <form method="post" action="/onboarding/describe#source-recommendation" style="padding:16px">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <label class="rm-field">
      <span>Describe where your inventory records are now. This recommends a starting source; it does not create or analyze inventory.</span>
      <textarea name="description" rows="3"
        placeholder="We keep everything in one spreadsheet, but our supplier emails us a stock report every Monday." required><%= locals.description || '' %></textarea>
    </label>
    <button class="rm-btn rm-btn--ghost" type="submit" <%= canOperate ? '' : 'disabled' %>>
      <%- helpers.icon('spark', { size: 15 }) %> Recommend my starting source
    </button>
  </form>
</section>

<div class="rm-note">
  <%- helpers.icon('shield', { size: 16 }) %>
  <span>
    <strong>Nothing is created until you approve it.</strong>
    Whichever source you choose, StockChief reads it, shows you every product and quantity it would
    create, and waits for you.
  </span>
</div>
