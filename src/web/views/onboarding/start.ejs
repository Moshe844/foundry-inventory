<div class="rm-head rm-source-head">
  <span class="rm-stamp">Get started</span>
  <h1>Add your inventory</h1>
  <p>Bring the records you already have. Start with one source; add others later.</p>
  <% if (currentUser.role === 'owner') { %>
    <form method="post" action="/onboarding/name" class="rm-inline-name">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <label for="inventory-name">Inventory name</label>
      <input class="input" id="inventory-name" name="name" maxlength="120" required value="<%= workspace.name %>" placeholder="e.g. Clothing Business">
      <button class="rm-btn rm-btn--ghost rm-btn--sm" type="submit">Save name</button>
    </form>
  <% } %>
</div>
<p class="rm-source-options-note">Three ways to start — choose the one that suits you.</p>
<div class="rm-source-grid">
  <form class="rm-source-files rm-choice" method="post" action="<%= locals.importAction || '/onboarding/migrations/new' %>" enctype="multipart/form-data" data-migration-upload data-direct-upload>
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <h2>Move from files <span class="badge badge--muted">Fastest</span></h2>
    <p>A CSV, TSV or Excel export with SKU, name and quantity.</p>
    <label class="rm-drop" data-file-drop>
      <span>Drop your spreadsheet here, or <strong>browse files</strong></span>
      <input type="file" name="<%= locals.importFieldName || 'files' %>" aria-label="Inventory spreadsheets" accept=".csv,.tsv,.txt,.xlsx" <%= locals.importMultiple === false ? '' : 'multiple' %> data-migration-files>
    </label>
    <div data-migration-selection hidden aria-live="polite"></div>
    <div data-migration-progress hidden aria-live="polite">
      <strong data-migration-progress-title>Uploading…</strong><span data-migration-progress-detail></span>
      <progress max="100" value="0" data-migration-progress-bar></progress>
    </div>
    <p data-migration-error hidden role="alert"></p>
    <button class="rm-btn rm-btn--ghost rm-btn--sm rm-upload-retry" type="submit" data-migration-submit hidden>Retry upload</button>
    <a href="<%= locals.importOptionsHref || '/onboarding/migrations/new' %>">Paste data or see upload options</a>
  </form>
  <% sourceOptions.filter(function (source) { return source.id !== 'spreadsheet'; }).forEach(function (source) { %>
    <form class="rm-choice__form" method="post" action="/onboarding/choose">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <input type="hidden" name="path" value="<%= source.id %>">
      <button class="rm-choice" type="submit">
        <span class="rm-choice__ic"><%- helpers.icon(source.icon, { size: 19 }) %></span>
        <span class="rm-choice__t"><%= source.label %></span>
        <span class="rm-choice__b"><%= source.prerequisite %></span>
        <span class="rm-choice__d"><%= source.id === 'software' ? 'Shopify, Square, Clover, WooCommerce or Custom API.' : 'Add products and opening quantities yourself.' %></span>
        <span class="rm-choice__go">Choose this →</span>
      </button>
    </form>
  <% }) %>
</div>
<div class="rm-choices">
  <form method="post" action="/onboarding/skip">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <button class="rm-btn rm-btn--ghost" type="submit">Skip for now</button>
  </form>
  <span>You’ll review imported records before they become live.</span>
</div>
<% if (currentUser.role === 'owner' && !onboardingEntry.dismissed) { %>
  <div class="rm-sample-prompt" aria-label="Explore with samples">
    <span>Just looking around? Sample data is separate from your business.</span>
    <form method="post" action="/onboarding/sample/load"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="rm-btn rm-btn--ghost rm-btn--sm" type="submit">Load sample data to explore</button></form>
    <form method="post" action="/onboarding/sample/dismiss"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="returnTo" value="/onboarding"><button class="rm-btn rm-btn--ghost rm-btn--sm" type="submit" aria-label="Dismiss sample suggestion">Dismiss</button></form>
  </div>
<% } %>
<details class="rm-disclosure">
  <summary>Not sure which source fits?</summary>
  <form method="post" action="/onboarding/describe#source-recommendation">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <label class="rm-field"><span>Where are your inventory records now?</span>
      <textarea name="description" rows="2" required placeholder="e.g. We keep quantities in an Excel workbook."><%= locals.description || '' %></textarea>
    </label>
    <button class="rm-btn rm-btn--ghost" type="submit">Recommend my starting source</button>
  </form>
</details>
<% if (locals.recommendation || locals.sourcePrompt) { %>
  <div class="rm-note" id="source-recommendation" role="status">
    <span><%= locals.recommendation ? recommendation.label + ': ' : '' %><%= locals.sourcePrompt || '' %></span>
  </div>
<% } %>
