<% var operational = datasets.filter(function(d) { return d.entityType !== 'reference_only'; }); %>
<% var ready = operational.filter(function(d) { return d.status === 'READY_TO_STAGE'; }); %>
<% var staged = operational.filter(function(d) { return d.status === 'STAGED'; }); %>
<% var reference = datasets.filter(function(d) { return d.entityType === 'reference_only'; }); %>
<% var review = operational.filter(function(d) { return !['READY_TO_STAGE','STAGED'].includes(d.status); }); %>
<% var sourceNames = Array.from(new Set(datasets.map(function(d) { return d.sourceName; }))); %>
<% var stagedSourceRows = staged.reduce(function(sum,d) { return sum + Number(d.sourceRowCount || 0); },0); %>
<% var allPrepared = operational.length > 0 && staged.length === operational.length; %>
<% var automaticFields = new Set(['reserved','incoming','damaged','shipping','tax']); %>
<% var automaticallyUnderstood = review.filter(function(d) { return d.unresolved && d.unresolved.length && d.unresolved.every(function(f) { return automaticFields.has(String(f.sourceField || '').toLowerCase()); }); }); %>
<% var manualReview = review.filter(function(d) { return !automaticallyUnderstood.includes(d); }); %>
<% var automaticConflict = allPrepared && sourceReview && sourceReview.autoResolvable; %>
<% var decisionPending = allPrepared && sourceReview && sourceReview.requiresDecision && !sourceReview.resolved && !automaticConflict; %>
<% var isPreparing = pkg.preparationStatus === 'RUNNING'; %>
<%
  /* A WAITING preparation that carries an error is a stop, not a pause: the
     worker found a source fact it will not guess at. Auto-starting again from
     here re-ran it in a loop and the page only ever showed "Starting…", so
     the one thing the person had to read never appeared. */
  var stoppedOnEvidence = pkg.preparationStatus === 'WAITING' && !!pkg.preparationError && !decisionPending;
  var canAutoStart = !stoppedOnEvidence && ['IDLE','FAILED','WAITING'].includes(pkg.preparationStatus) && pkg.status === 'STAGING' && (ready.length || automaticallyUnderstood.length || (allPrepared && !decisionPending));
%>

<div class="rm-head rm-migration-head">
  <a class="rm-back" href="/onboarding/migrations/<%= pkg.id %>">← Migration progress</a>
  <p class="rm-head__eyebrow">Preparing <%= workspace.name %></p>
  <p class="rm-source-file"><%- helpers.icon('paperclip',{ size:14 }) %> <%= sourceNames.join(' · ') %></p>
  <h1>Your workbook is saved.</h1>
  <p><% if (allPrepared) { %>Every operational dataset is prepared for verification.<% } else { %><%= staged.length %> of <%= operational.length %> operational datasets are prepared. <%= review.length || ready.length %> remain.<% } %></p>
</div>

<section class="rm-migration-state" aria-label="Migration state">
  <div class="is-done"><span>Workbook</span><strong>Saved</strong><small><%= datasets.length %> tabs read</small></div>
  <div class="<%= allPrepared ? 'is-done' : 'is-now' %>"><span>Private staging</span><strong><%= stagedSourceRows.toLocaleString() %> source rows</strong><small><%= pkg.stagedCount.toLocaleString() %> StockChief records prepared</small></div>
  <div><span>Live inventory</span><strong><%= pkg.appliedCount.toLocaleString() %> records</strong><small>Nothing changes before verification and approval</small></div>
</section>

<div class="rm-migration-safety">
  <span class="rm-migration-safety__icon"><%- helpers.icon('shield',{ size:18 }) %></span>
  <span><strong>Nothing was cleared.</strong> You are preparing the separate inventory <strong><%= workspace.name %></strong>. Your other inventories and their records are untouched.</span>
  <a href="/inventories">See my inventories</a>
</div>

<% if (isPreparing) { %>
<section class="rm-next-card rm-next-card--working" data-migration-progress="/onboarding/migrations/<%= pkg.id %>/progress">
  <div class="rm-working-copy"><span class="rm-stamp">Working automatically</span><h2>StockChief is preparing this inventory.</h2>
    <p data-migration-progress-copy><%= pkg.preparationDetail || 'Identifying each dataset and checking its source meaning.' %></p>
    <div class="rm-live-progress"><span data-migration-progress-phase><%= String(pkg.preparationStage || 'understanding').replaceAll('_',' ').toLowerCase() %></span><span data-migration-progress-fraction><% if (pkg.preparationTotal) { %><%= pkg.preparationCompleted %> of <%= pkg.preparationTotal %> datasets<% } else { %>Starting…<% } %></span></div>
    <progress max="<%= Math.max(1,pkg.preparationTotal || 1) %>" value="<%= pkg.preparationCompleted %>" data-migration-job-bar></progress>
    <small>You can leave this page. The source snapshot and every completed step are saved.</small>
  </div>
</section>
<% } else if (canAutoStart) { %>
<section class="rm-next-card rm-next-card--working" aria-live="polite">
  <div class="rm-working-copy"><span class="rm-stamp">Starting automatically</span><h2><%= automaticConflict ? 'StockChief is reconciling the workbook.' : 'StockChief is continuing the preparation.' %></h2>
    <p><%= automaticConflict
      ? 'Detailed operational rows will control stock, purchasing and accounting. Conflicting summary totals remain attached as evidence and cannot create duplicate business effects. No technical choice is required from you.'
      : 'It will prepare every meaning it can prove and run verification. You will only be interrupted for a genuinely ambiguous source fact or the final switch approval.' %></p>
    <progress max="100"></progress>
  </div>
  <form method="post" action="/onboarding/migrations/<%= pkg.id %>/prepare-known-evidence" data-migration-auto-start data-no-busy>
    <input type="hidden" name="_csrf" value="<%= csrfToken %>"><button type="submit" hidden>Start</button>
  </form>
</section>
<% } %>

<% if (pkg.preparationStatus === 'WAITING' && pkg.preparationError && !decisionPending) { %>
<section class="rm-next-card rm-next-card--attention">
  <div><span class="rm-stamp">Needs you · source evidence</span><h2>StockChief stopped before guessing.</h2>
    <p><%= pkg.preparationError %></p>
    <small>Fix that row in the file and upload it again, or check the mapping below. Everything already prepared is kept, and nothing has gone live.</small>
    <div class="rm-choices" style="margin-top:12px">
      <a class="rm-btn" href="/onboarding/migrations/new">Upload a corrected file</a>
      <form method="post" action="/onboarding/migrations/<%= pkg.id %>/prepare-known-evidence" style="margin:0"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="rm-btn rm-btn--ghost" type="submit">Try again</button></form>
    </div>
  </div>
</section>
<% } %>

<% if (decisionPending && !isPreparing && !canAutoStart) { %>
<section class="rm-panel rm-panel--attention rm-migration-decision">
  <div class="rm-panel__head"><%- helpers.icon('alert',{ size:15 }) %><h2>StockChief needs one source fact</h2><span class="right">Nothing is live</span></div>
  <div class="rm-migration-choice">
    <h3>Some row-level values contradict each other.</h3>
    <p>StockChief has kept every source row but stopped before a disputed value could change stock or accounting.</p>
    <ul class="rm-migration-conflicts">
      <% if (sourceReview.inventoryFormulaMismatches) { %><li><strong><%= sourceReview.inventoryFormulaMismatches.toLocaleString() %></strong> stock row<%= sourceReview.inventoryFormulaMismatches === 1 ? '' : 's' %> do not reconcile on-hand, reserved, damaged and available quantities.</li><% } %>
      <% if (sourceReview.inventoryValueMismatches) { %><li><strong><%= sourceReview.inventoryValueMismatches.toLocaleString() %></strong> inventory value<%= sourceReview.inventoryValueMismatches === 1 ? '' : 's' %> do not equal quantity × unit cost.</li><% } %>
    </ul>
    <p><strong>What to do:</strong> correct those exact values in the source and upload the corrected snapshot. StockChief will reuse the mappings it already proved.</p>
    <form method="post" action="/onboarding/migrations/<%= pkg.id %>/choose-operational-truth">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <input type="hidden" name="choice" value="DETAILED_OPERATIONAL_RECORDS">
      <button class="rm-btn rm-btn--ghost">Keep only the undisputed detailed records</button>
    </form>
    <small>This fallback excludes contradictory summaries from operations; it does not certify the disputed values as correct.</small>
  </div>
</section>
<% } %>

<% if (manualReview.length && !isPreparing && !canAutoStart) { %>
<section class="rm-panel rm-panel--attention rm-migration-decision">
  <div class="rm-panel__head"><%- helpers.icon('alert',{ size:15 }) %><h2>Next: settle <%= manualReview.length === 1 ? 'one source issue' : manualReview.length + ' source issues' %></h2><span class="right"><%= manualReview.length %></span></div>
  <div class="rm-feed">
    <% manualReview.forEach(function(dataset) { var verifiedOrderSplit = dataset.entityType === 'purchase_order' && dataset.profile && dataset.profile.status === 'APPROVED' && (!dataset.unresolved || !dataset.unresolved.length); %>
      <div class="rm-feed__row rm-migration-decision__row">
        <span class="rm-feed__ic is-warn"><%- helpers.icon('alert',{ size:14 }) %></span>
        <span class="rm-feed__t">
          <strong><%= dataset.entityType === 'purchase_order' ? 'Purchase orders' : dataset.sheetName %></strong>
          <% if (verifiedOrderSplit) { %>
            <small>This file mixes open, partially received and completed orders. Its ordered, received and remaining quantities can be checked line by line.</small>
            <span class="rm-field-list">StockChief will prepare only the verified quantity still incoming. Received and closed orders stay as history.</span>
          <% } else { %>
            <small><%= dataset.sourceRowCount.toLocaleString() %> rows · <% if (dataset.unresolved && dataset.unresolved.length) { %><%= dataset.unresolved.length %> consequential field<%= dataset.unresolved.length === 1 ? '' : 's' %> need a rule<% } else { %>StockChief cannot safely finish this dataset yet<% } %></small>
            <% if (dataset.unresolved && dataset.unresolved.length) { %><span class="rm-field-list"><%= dataset.unresolved.map(function(field) { return field.sourceField; }).join(' · ') %></span><% } %>
          <% } %>
        </span>
        <span class="rm-feed__m">
          <% if (verifiedOrderSplit) { %>
            <form method="post" action="/onboarding/migration-datasets/<%= dataset.id %>/prepare-purchase-orders">
              <input type="hidden" name="_csrf" value="<%= csrfToken %>">
              <button class="rm-btn rm-btn--sm">Prepare the open orders</button>
            </form>
          <% } else if (dataset.profileId) { %><a class="rm-btn rm-btn--sm" href="/onboarding/migration-mappings/<%= dataset.profileId %>">Resolve this issue</a>
          <% } else { %>
            <details class="rm-inline-review"><summary>Choose the record type</summary>
              <form method="post" action="/onboarding/migration-datasets/<%= dataset.id %>/classify">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                <select name="entityType" required><option value="">Choose record type</option>
                  <% types.forEach(function(type) { %><option value="<%= type.id %>"><%= type.label %></option><% }) %>
                </select><button class="rm-btn rm-btn--sm">Use this meaning</button>
              </form>
            </details>
          <% } %>
        </span>
      </div>
    <% }) %>
  </div>
</section>
<% } %>

<details class="rm-panel rm-migration-details">
  <summary><span><%- helpers.icon('check',{ size:15 }) %> <strong>What StockChief understood</strong></span><span><%= staged.length %> prepared</span></summary>
  <div class="rm-feed">
    <% operational.filter(function(d) { return ['READY_TO_STAGE','STAGED'].includes(d.status); }).forEach(function(dataset) { %>
      <div class="rm-feed__row">
        <span class="rm-feed__ic is-done"><%- helpers.icon('check',{ size:14 }) %></span>
        <span class="rm-feed__t"><strong><%= dataset.sheetName %></strong>
          <small><%= dataset.sourceRowCount.toLocaleString() %> source rows → <% if (dataset.entityType === 'history_fact') { %>queryable history only<% } else { %><%= (dataset.entityType || '').replaceAll('_',' ') %><% } %><% if (dataset.custom && dataset.custom.length) { %> · <%= dataset.custom.length %> extra fields kept as searchable attributes<% } %></small></span>
        <span class="rm-feed__m"><span class="status-pill"><%= dataset.status === 'STAGED' ? 'prepared' : 'ready' %></span></span>
      </div>
    <% }) %>
  </div>
</details>

<% if (reference.length) { %>
<details class="rm-panel rm-migration-details">
  <summary><span><%- helpers.icon('paperclip',{ size:15 }) %> <strong>Supporting tabs kept with the source</strong></span><span><%= reference.length %></span></summary>
  <div class="rm-feed">
    <% reference.forEach(function(dataset) { %><div class="rm-feed__row"><span class="rm-feed__t"><strong><%= dataset.sheetName %></strong><small><%= dataset.sourceRowCount.toLocaleString() %> rows · <%= dataset.isJoinedOrderHeader ? 'joined to its order lines and retained as evidence' : 'retained as evidence, not treated as live stock or orders' %></small></span></div><% }) %>
  </div>
</details>
<% } %>

<div class="rm-source-actions">
  <% if (!staged.length) { %><form method="post" action="/onboarding/migrations/<%= pkg.id %>/reanalyze">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <button class="rm-btn rm-btn--ghost">Re-analyze this workbook</button>
  </form><% } %>
  <a class="rm-btn rm-btn--ghost" href="/inventories">Leave migration and see my inventories</a>
</div>
