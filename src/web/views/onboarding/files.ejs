<div class="page-head">
  <div class="titles">
    <a class="back-link" href="/onboarding"><%- helpers.icon('chevron', { size: 14 }) %> Start over</a>
    <h1><%= messy ? 'Give Foundry everything you have' : 'Give Foundry your spreadsheet' %></h1>
    <div class="page-sub">
      <% if (messy) { %>
        Upload every file that holds part of the picture. Foundry works out what agrees, what does not,
        and what only looks like a duplicate.
      <% } else { %>
        Upload the file you already keep your stock in. Foundry reads it and sets itself up from what it finds —
        you do not need to configure anything first.
      <% } %>
    </div>
  </div>
</div>

<div class="card section">
  <div class="card-head"><h2>Files</h2></div>
  <form method="post" action="/onboarding/files" enctype="multipart/form-data" data-busy>
    <div class="card-body">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <label class="field">
        <span class="field-label">Spreadsheets or CSVs</span>
        <input class="input" type="file" name="files" accept=".csv,.tsv,.txt,.xlsx" multiple>
        <span class="field-help">.xlsx, .csv or .tsv. Extra title rows, blank lines and stray columns are fine.</span>
      </label>
      <label class="field">
        <span class="field-label">Or paste rows</span>
        <textarea class="input" name="pasted" rows="4" placeholder="Paste straight out of a spreadsheet"></textarea>
      </label>
    </div>
    <div class="card-foot">
      <button class="btn" type="submit"><%- helpers.icon('import', { size: 15 }) %> Add</button>
    </div>
  </form>
</div>

<% if (sources.length) { %>
  <div class="card section">
    <div class="card-head">
      <h2>What Foundry has</h2>
      <span class="spacer"></span>
      <span class="badge badge--muted"><%= sources.length %> file<%= sources.length === 1 ? '' : 's' %></span>
    </div>
    <table class="table">
      <thead><tr><th>File</th><th>Foundry reads it as</th><th class="num">Rows</th><th class="num">Units</th><th>When</th><th></th></tr></thead>
      <tbody>
        <% sources.forEach(function (source) { %>
          <tr>
            <td><strong><%= source.name %></strong></td>
            <td><%= source.purposeLabel %> <span class="muted">(<%= source.purposeConfidence %> confidence)</span></td>
            <td class="num"><%= source.profile.totals ? source.profile.totals.rows : 0 %></td>
            <td class="num"><%= source.profile.totals ? source.profile.totals.units : 0 %></td>
            <td class="muted">
              <% if (source.observedAt) { %><%= source.observedAt %><% } else { %>not dated<% } %>
            </td>
            <td>
              <form method="post" action="/onboarding/files/<%= source.id %>/remove">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                <button class="btn btn--sm btn--ghost" type="submit">Remove</button>
              </form>
            </td>
          </tr>
        <% }) %>
      </tbody>
    </table>
    <div class="card-foot">
      <form method="post" action="/onboarding/understand" data-busy>
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <button class="btn btn--primary" type="submit" <%= canOperate ? '' : 'disabled' %>>
          <%- helpers.icon('foundry', { size: 15 }) %> Understand my inventory
        </button>
      </form>
    </div>
  </div>
<% } %>
