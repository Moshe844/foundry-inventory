<div class="rm-head">
  <p class="rm-head__eyebrow">Migration control</p>
  <h1>Move your operation without losing the truth.</h1>
  <p>Every source stages into the same contract. Foundry checks identities, dependencies and totals before it allows cutover.</p>
</div>

<div style="display:flex;justify-content:flex-end;margin:-44px 0 18px">
  <a class="rm-btn" href="/onboarding/migrations/new">Start a migration</a>
</div>

<section class="rm-panel">
  <div class="rm-panel__head">
    <%- helpers.icon('shield', { size: 15 }) %>
    <h2>Cutover packages</h2>
    <span class="right"><%= packages.length %></span>
  </div>
  <% if (!packages.length) { %>
    <div class="empty-state">
      <h3>No staged migration yet</h3>
      <p>Connect the source or provide its exports. Foundry will stage them here before changing live records.</p>
      <a class="rm-btn" href="/onboarding/migrations/new">Upload your exports</a>
    </div>
  <% } else { %>
    <div class="rm-list">
      <% packages.forEach(function (pkg) { %>
        <a class="rm-row" href="/onboarding/migrations/<%= pkg.id %>">
          <span><strong><%= pkg.sourceLabel %></strong><small><%= pkg.stagedCount %> staged · <%= pkg.appliedCount %> applied</small></span>
          <span class="status-pill"><%= pkg.status.replaceAll('_', ' ').toLowerCase() %></span>
        </a>
      <% }) %>
    </div>
  <% } %>
</section>
