<%
  /*
   * Suppliers: one table. Adding a supplier opens a side panel (the full
   * /suppliers/new page still works); what stops work — no email, money owed —
   * shows as a badge in the row and has its own tab.
   */
  var L = list;
  var m = function (minor) { return helpers.money(minor, 'USD'); };
  var qs = function (over) {
    var p = { tab: L.tab === 'all' ? '' : L.tab, q: L.q };
    Object.keys(over || {}).forEach(function (k) { p[k] = over[k]; });
    var parts = Object.keys(p).filter(function (k) { return p[k]; }).map(function (k) { return k + '=' + encodeURIComponent(p[k]); });
    return '/suppliers' + (parts.length ? '?' + parts.join('&') : '');
  };
  var tabs = [['all', 'All'], ['email', 'Missing email'], ['owed', 'Owed money'], ['archived', 'Archived']];
%>
<link rel="stylesheet" href="/orders-ui.css?v=<%= assetVersion %>">
<div class="ox ox-buy" data-ox-page="suppliers">
  <header class="ox-head">
    <div>
      <h1 class="ox-title">Suppliers</h1>
      <p class="ox-sub"><%= L.total %> supplier<%= L.total === 1 ? '' : 's' %><% if (L.counts.email) { %> · <span class="ox-dot ox-dot--amber" aria-hidden="true"></span> <%= L.counts.email %> missing an email<% } %></p>
    </div>
    <div class="ox-head__actions">
      <% if (permissions.suppliers) { %><button class="ox-btn ox-btn--primary" type="button" data-modal-open="ox-supplier-drawer"><span aria-hidden="true">+</span> Add supplier</button><% } %>
    </div>
  </header>
  <%- include('_tabs', { active: '/suppliers' }) %>

  <section class="ox-card ox-list" aria-label="Supplier list">
    <% if (!L.counts.all && !L.counts.archived) { %>
      <div class="ox-empty">
        <strong>No suppliers yet.</strong>
        <p>Add who you buy from. Then link what they sell you, and write your first purchase order.</p>
        <% if (permissions.suppliers) { %><div class="ox-empty__actions"><button class="ox-btn ox-btn--primary" type="button" data-modal-open="ox-supplier-drawer"><span aria-hidden="true">+</span> Add supplier</button></div><% } %>
      </div>
    <% } else { %>
    <div class="ox-toolbar">
      <nav class="ox-tabs" aria-label="Filter suppliers">
        <% tabs.forEach(function (t) { %><a class="ox-tab <%= L.tab === t[0] ? 'is-on' : '' %>" href="<%= qs({ tab: t[0] === 'all' ? '' : t[0] }) %>"<%- L.tab === t[0] ? ' aria-current="page"' : '' %>><%= t[1] %> <span class="ox-chip<%= t[0] === 'email' && L.counts.email ? ' ox-chip--rose' : '' %>"><%= L.counts[t[0]] %></span></a><% }) %>
      </nav>
      <form class="ox-search" method="get" action="/suppliers" role="search" data-ox-search>
        <% if (L.tab !== 'all') { %><input type="hidden" name="tab" value="<%= L.tab %>"><% } %>
        <svg class="ox-search__icon" viewBox="0 0 20 20" width="16" height="16" aria-hidden="true"><circle cx="9" cy="9" r="6" fill="none" stroke="currentColor" stroke-width="1.8"/><path d="m14 14 4 4" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/></svg>
        <input class="ox-input" type="search" name="q" value="<%= L.q %>" placeholder="Search name, contact, email" aria-label="Search suppliers" autocomplete="off">
      </form>
    </div>
    <% if (!L.rows.length) { %>
      <div class="ox-empty"><strong>No suppliers match</strong><p><a href="/suppliers">Show every supplier</a></p></div>
    <% } else { %>
      <table class="ox-table" data-preserve-grid>
        <thead><tr><th scope="col">Supplier</th><th scope="col" class="ox-hide-sm">Contact</th><th scope="col" class="ox-hide-sm ox-c">Lead time</th><th scope="col" class="ox-hide-sm ox-c">Products</th><th scope="col" class="ox-hide-sm ox-c">Open POs</th><th scope="col" class="ox-r">Owed</th><th scope="col" class="ox-hide-sm"><span class="ox-sr">New purchase order</span></th></tr></thead>
        <tbody>
          <% L.rows.forEach(function (s) { %>
            <tr class="ox-row<%= s.isActive ? '' : ' is-muted' %>" data-href="/suppliers/<%= s.id %>">
              <td><span class="ox-cust"><span class="ox-avatar" aria-hidden="true"><%= s.initials %></span><span><a class="ox-order" href="/suppliers/<%= s.id %>"><%= s.name %></a><span class="ox-show-sm ox-cell-sub"><%= [s.defaultLeadTimeDays != null ? s.defaultLeadTimeDays + ' days' : null, s.itemCount + ' product' + (s.itemCount === 1 ? '' : 's'), s.email ? null : 'no email yet'].filter(Boolean).join(' · ') %></span></span></span></td>
              <td class="ox-hide-sm"><% if (s.email) { %><%= s.contactName || '' %><small class="ox-block ox-muted"><%= s.email %></small><% } else { %><a class="ox-badge ox-badge--amber" href="/suppliers/<%= s.id %>?edit=1">Add email</a><% } %></td>
              <td class="ox-hide-sm ox-c <%= s.defaultLeadTimeDays == null ? 'ox-muted' : '' %>"><%= s.defaultLeadTimeDays == null ? '—' : s.defaultLeadTimeDays + ' days' %></td>
              <td class="ox-hide-sm ox-c"><% if (s.itemCount) { %><%= s.itemCount %><% } else { %><a class="ox-badge ox-badge--amber" href="/suppliers/<%= s.id %>#link-product">Link products</a><% } %></td>
              <td class="ox-hide-sm ox-c <%= s.openOrders ? '' : 'ox-muted' %>"><%= s.openOrders %></td>
              <td class="ox-r ox-num <%= s.owed ? 'ox-amber' : 'ox-muted' %>"><%= s.owed ? m(s.owed.minor) : '—' %></td>
              <td class="ox-r ox-hide-sm"><% if (s.isActive && permissions.create) { %><a class="ox-btn ox-btn--sm ox-btn--<%= s.openOrders || s.itemCount ? 'secondary' : 'ghost' %>" href="/purchasing/orders/new?supplier=<%= s.id %>" aria-label="New purchase order for <%= s.name %>">New PO</a><% } %></td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    <% } %>
    <footer class="ox-foot"><span class="ox-muted">Showing <%= L.rows.length %> of <%= L.counts[L.tab] %></span></footer>
    <% } %>
  </section>

  <% if (permissions.suppliers) { %><%- include('_supplier-drawer', { action: '/suppliers', supplier: locals.prefill, drawerId: 'ox-supplier-drawer' }) %><% } %>
</div>
<script src="/orders-ui.js?v=<%= assetVersion %>" defer></script>
<script src="/buy-ui.js?v=<%= assetVersion %>" defer></script>
<% if (locals.prefill) { %><script>document.addEventListener('DOMContentLoaded',function(){var d=document.getElementById('ox-supplier-drawer');if(d&&d.showModal)d.showModal();});</script><% } %>
