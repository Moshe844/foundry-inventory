<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><meta name="robots" content="noindex,nofollow"><title><%= offer?offer.p.label:'Customer order request' %> · StockChief</title><link rel="stylesheet" href="/app-system.css"><style>body{background:#f5f7fa;color:#182333;font-family:system-ui,sans-serif;margin:0}.customer-request{max-width:720px;margin:30px auto;padding:20px}.customer-request section,.customer-request fieldset{background:white;border:1px solid #d6dfe8;border-radius:12px;padding:18px;margin:18px 0;min-width:0}.customer-request label{display:block;margin:14px 0}.customer-request input:not([type=checkbox]){display:block;width:100%;box-sizing:border-box;padding:12px;margin-top:6px;border:1px solid #bac5d1;border-radius:8px;font:inherit}.customer-request button,.customer-request .public-button{display:inline-block;padding:13px 18px;background:#5145cd;color:white;border:0;border-radius:8px;font:inherit;cursor:pointer;text-decoration:none;white-space:normal}.customer-request p,.customer-request legend{overflow-wrap:anywhere}.customer-request .total{font-size:1.3rem;font-weight:700}.customer-request small{color:#536273}</style></head><body><main class="customer-request">
<% if(unavailable){ %><h1>Customer order request</h1><p role="alert"><%= problem %></p><% if(typeof retryPath!=='undefined' && retryPath){ %><p><a class="public-button" href="<%= retryPath %>">Reload customer order form</a></p><% }else{ %><p>Use your browser’s Back button to check your entries, or contact the business. Nothing has been charged.</p><% } %>
<% }else{ var p=offer.p; %><h1><%= p.label %></h1><p>Choose your products and review the exact request before sending. This page uses the customer and <%= p.delivery_method==='PICKUP'?'pickup':'delivery' %> details already agreed with the business.</p>
<p><strong>This is an order request.</strong> The business confirms acceptance, availability and <%= p.delivery_method==='PICKUP'?'collection':'dispatch and delivery' %> separately. This page does not take payment.</p>
<% if(p.delivery_method==='SHIP'){ %><p>The request total covers products, discounts and tax. Shipping charges, if any, are confirmed separately.</p><% } %>
<% if(receipt){ %><section role="status"><h2>Request received</h2><p><%= receipt.reference %><%= receipt.replayed?' was already received; it has not been duplicated.':' has been received for the business to review.' %></p><p>Contact the business if you need to change the request or delivery details.</p></section><% } %>
<% if(preview){ var q=preview.snapshot.quote; %><section><h2>Review your exact request</h2><p>Reference: <strong><%= preview.reference %></strong></p>
<% q.lines.forEach(function(line){var product=preview.f.products.find(function(s){return s.id===line.skuId}); %><p><strong><%= product.name %> · <%= product.code %></strong><br><%= line.quantity %> units · <%= helpers.money(line.unitPriceMinor,q.currency) %> each · <%= helpers.money(line.totalMinor,q.currency) %> including the line’s tax and discounts</p><% }) %>
<p>Products: <%= helpers.money(q.subtotalMinor,q.currency) %><br>Discounts: <%= helpers.money(q.discountMinor,q.currency) %><br>Tax: <%= helpers.money(q.taxMinor,q.currency) %></p><p class="total">Request total: <%= helpers.money(q.totalMinor,q.currency) %></p><p>Delivery or collection details stay as already agreed. A changed price or tax policy requires another review.</p>
<form method="post" action="/customer/order/<%= offer.token %>/submit"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="reference" value="<%= preview.reference %>"><input type="hidden" name="expectedHash" value="<%= preview.requestHash %>"><% preview.snapshot.input.lines.forEach(function(l,i){ %><input type="hidden" name="lines[<%= i %>][skuId]" value="<%= l.skuId %>"><input type="hidden" name="lines[<%= i %>][quantity]" value="<%= l.quantity %>"><% }) %><label><input type="checkbox" name="confirmed" value="yes" required> I checked these exact products, quantities and total and want to send this request.</label><button type="submit">Send this exact request</button></form><p><a href="/customer/order/<%= offer.token %>">Change products or quantities</a></p></section>
<% }else{ %><form method="post" action="/customer/order/<%= offer.token %>/review"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><label>Your purchase order or request reference<input name="reference" required maxlength="80" autocomplete="off"></label><p>Use a new reference for each different request. Reusing a reference cannot create another order.</p>
<% offer.f.products.forEach(function(s,i){ %><fieldset><legend><%= s.name %> · <%= s.code %></legend><p>Published base price: <%= helpers.money(Number(s.amount_minor),p.currency) %> each. Any current customer price rules, discounts and tax appear in the review.</p><input type="hidden" name="lines[<%= i %>][skuId]" value="<%= s.id %>"><label>Quantity for <%= s.code %><input name="lines[<%= i %>][quantity]" type="number" min="0" max="<%= p.maximum_units %>" step="1" value="0" required inputmode="numeric"></label></fieldset><% }) %><p>Up to <%= p.maximum_units %> units per product and <%= helpers.money(Number(p.maximum_minor),p.currency) %> total per request. Larger or changed requests need the business to review them separately.</p><button type="submit">Review this request</button></form><% } %>
<% } %><p><small>Powered by StockChief. Keep your customer link private.</small></p></main></body></html>
