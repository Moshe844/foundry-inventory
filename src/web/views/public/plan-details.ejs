<% for(const plan of compared){const source='/pricing/plan/'+encodeURIComponent(plan.id)+'?interval='+interval; %>
<dialog class="plan-dialog" id="plan-details-<%= plan.id %>" aria-labelledby="plan-dialog-title-<%= plan.id %>" data-plan-dialog="<%= plan.id %>">
 <header class="plan-dialog-header"><div><p class="pub-kicker">Every duty and its status</p><h2 id="plan-dialog-title-<%= plan.id %>"><%= plan.name %></h2></div><form method="dialog"><button class="plan-dialog-close" aria-label="Close <%= plan.name %> details">×</button></form></header>
 <div class="plan-dialog-body" data-plan-source="<%= source %>"><p data-plan-loading role="status">Open these details to see every included duty.</p><p><a data-plan-fallback href="<%= source %>">Open <%= plan.name %> details as a page</a></p></div>
</dialog>
<% } %>
<noscript><p class="pro-pricing-note">Every plan’s duty list and the full comparison are available as ordinary linked pages.</p></noscript>
