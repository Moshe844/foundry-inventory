<% var stories={
  starter:{number:'01',verb:'Run cleanly',headline:'Build one reliable operating system.',best:'Businesses leaving spreadsheets or basic stock tools.',features:['Inventory, variants, lots, serials and kits','Purchasing, suppliers and controlled receiving','Sales Orders, commitments and returns','Native accounting, reports and Needs You','Grounded Ask StockChief with supervised actions','Spreadsheet import with preview and rollback']},
  growth:{number:'02',verb:'Hand off routine work',headline:'Let StockChief carry the operational middle.',best:'Growing businesses ready to automate communication and follow-through.',features:['Everything in Starter','Connected commerce, Gmail or Microsoft 365','Business-email and document understanding','Transfer-versus-buy replenishment recommendations','Prepared supplier and customer responses','Provider shipping, payments and accounting connections']},
  pro:{number:'03',verb:'Manage the exceptions',headline:'Operate with broader authority and control.',best:'Multi-location operators ready for bounded autonomous execution.',features:['Everything in Growth','Advanced authority and automatic-work policies','Higher-volume commerce and communication','Fulfillment waves, scans and operational controls','Scoped APIs and signed outbound webhooks','Priority support and deeper operating visibility']},
  enterprise:{number:'04',verb:'Fit the operation',headline:'Deploy around complex scale and requirements.',best:'High-volume or specialized operations needing a tailored rollout.',features:['Everything in Pro','Custom limits, implementation and migration engagement','Certified custom event and integration contracts','Tailored authority and access structures','Contracted support and service requirements','Provider and workflow qualification plan']}
}; function storyFor(plan){return stories[plan.id]||stories.starter;} function usageFor(plan){var enabled=new Set((plan.entitlements||[]).filter(function(item){return Number(item.enabled)!==0;}).map(function(item){return item.capability;}));var required={accounting_syncs:['accounting.sync','connection.accounting','connections.accounting'],api_events:['api.public'],automatic_actions:['automation.transfers','automation.purchasing'],business_communications:['communications.email_ingestion','email.auto_extract','communications.ai_drafts','email.response_generation'],document_pages:['documents.process','documents.extraction'],external_events:['connections.shopify','connections.square','connections.commerce','connection.commerce'],intelligent_operations:['ask.prepare_actions','ask_stockchief'],shipments_managed:['shipping.labels','shipping.automation']};return (plan.meters||[]).filter(function(meter){var capabilities=required[meter.meter]||[];return meter.kind==='USAGE'&&Number(meter.customer_visible)&&Number(meter.included_units)>0&&(!capabilities.length||capabilities.some(function(capability){return enabled.has(capability);}));});} %>
<section class="pricing-intro"><div><span class="pub-kicker">Pricing by operating responsibility</span><h1>Pay for work StockChief can take over—not another seat in another tool.</h1><p>Every plan keeps inventory truth, orders and money connected. Higher plans expand communication, connected systems and the authority StockChief can use.</p></div><div class="billing-switch" data-billing-switch><button class="is-active" data-interval="monthly" type="button">Monthly</button><button data-interval="annual" type="button">Annual <span>2 months included</span></button></div></section>
<% if (checkoutCancelled) { %><div class="pub-notice">Checkout was cancelled. Nothing was charged and your selected plan is still here.</div><% } %>

<section class="plan-ladder">
  <% plans.forEach(function(plan){var story=storyFor(plan);var monthly=Number(plan.monthly_amount_minor||0)/100;var annual=Number(plan.annual_amount_minor||0)/100;var usage=usageFor(plan); %>
  <article class="plan-card plan-card--<%= plan.id %> <%= plan.is_recommended?'is-recommended':'' %>" id="<%= plan.id %>">
    <header><span class="plan-card__number"><%= story.number %></span><div><small><%= story.verb %></small><h2><%= plan.public_name %></h2></div><% if(plan.is_recommended){ %><b class="plan-card__flag">Best fit for most operators</b><% } %></header>
    <div class="plan-card__body"><div class="plan-card__promise"><h3><%= story.headline %></h3><p><%= story.best %></p><% if(plan.sales_only){ %><div class="plan-price"><strong>Custom</strong><span>planned around your operation</span></div><% }else{ %><div class="plan-price" data-monthly="$<%= monthly.toLocaleString('en-US') %>" data-annual="$<%= Math.round(annual/12).toLocaleString('en-US') %>" data-annual-note="<%= annual.toLocaleString('en-US',{style:'currency',currency:plan.currency,maximumFractionDigits:0}) %> billed annually"><strong>$<%= monthly.toLocaleString('en-US') %></strong><span>/month</span><small data-price-note>Billed monthly</small></div><% } %></div>
      <div class="plan-card__features"><small>WHAT CHANGES AT THIS LEVEL</small><ul><% story.features.forEach(function(feature){ %><li><i>✓</i><span><%= feature %></span></li><% }); %></ul><div class="plan-card__usage"><small>INCLUDED EACH BILLING PERIOD</small><% if(plan.sales_only){ %><p>Usage and overage terms are set in your contract.</p><% }else if(!usage.length){ %><p>Usage allowances appear here before checkout opens.</p><% }else{ %><ul><% usage.forEach(function(meter){ %><li><span><%= Number(meter.included_units).toLocaleString('en-US') %> <%= String(meter.label||meter.meter).toLowerCase() %></span><small><% if(meter.overage_mode==='BILL'){ %>then <%= (Number(meter.overage_amount_minor||0)/100).toLocaleString('en-US',{style:'currency',currency:plan.currency}) %> per <%= Number(meter.overage_block_units||1).toLocaleString('en-US') %><% }else if(meter.overage_mode==='PAUSE'){ %>then optional processing pauses<% }else if(meter.overage_mode==='PURCHASE'){ %>additional usage can be added<% }else{ %>contract terms apply<% } %></small></li><% }); %></ul><% } %></div></div>
      <div class="plan-card__action"><% if(plan.sales_only){ %><a class="pub-btn pub-btn--secondary" href="/contact?plan=enterprise">Plan an Enterprise rollout</a><% }else if(account){ %><form method="post" action="/billing/checkout" data-checkout-form><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="planId" value="<%= plan.id %>"><input type="hidden" name="interval" value="monthly"><button class="pub-btn" type="submit">Choose <%= plan.public_name %></button></form><% }else{ %><a class="pub-btn" href="/register?plan=<%= plan.id %>&interval=monthly" data-plan-link data-plan="<%= plan.id %>">Choose <%= plan.public_name %></a><% } %></div>
    </div>
  </article>
  <% }); %>
</section>

<section class="pricing-compare"><div class="pub-section__heading"><span class="pub-kicker">The progression</span><h2>The reason to upgrade is operating leverage.</h2><p>Limits protect reliability, but the commercial difference is how much connected work StockChief may understand and carry through.</p></div><div class="compare-operation"><div class="compare-operation__head"><span>Operational responsibility</span><b>Starter</b><b>Growth</b><b>Pro</b><b>Enterprise</b></div><div><span>Inventory, purchasing and Sales Orders</span><b>Full</b><b>Full</b><b>Full</b><b>Full</b></div><div><span>Ask StockChief</span><b>Supervised</b><b>Connected</b><b>Broad authority</b><b>Tailored</b></div><div><span>Supplier/customer communication</span><b>Manual</b><b>Understands + prepares</b><b>Routine auto-send</b><b>Custom policy</b></div><div><span>Replenishment</span><b>Alerts</b><b>Transfer vs buy</b><b>Bounded execution</b><b>Tailored</b></div><div><span>Connected operation</span><b>Core</b><b>Standard providers</b><b>API + higher volume</b><b>Custom contracts</b></div><div><span>Accounting connection</span><b>Native books</b><b>Read + reconcile</b><b>Governed posting</b><b>Custom rollout</b></div><div><span>Support</span><b>Standard</b><b>Standard</b><b>Priority</b><b>Contracted</b></div></div></section>

<section class="qualification-note"><span>Honest launch boundary</span><h2>Connected features go live provider by provider.</h2><p>Shipping automation, Stripe customer payments and external accounting posting are offered only after the relevant provider and business account pass qualification. Advanced adaptive forecasting, generic full-business migration, manufacturing, EDI and SSO are not included in these launch plans.</p><a href="/integrations">See integration qualification →</a></section>

<section class="pub-final"><span class="pub-kicker">Start with the operation you have</span><h2>Your first inventory is created from your business account.</h2><p>After email verification and secure checkout, go directly to files, a supported connection or manual entry.</p><div class="pub-actions pub-actions--center"><a class="pub-btn" href="/register?plan=growth">Start with Growth</a><a class="pub-btn pub-btn--secondary" href="/demo">Watch the demo first</a></div></section>
