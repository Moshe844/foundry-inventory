<% var stories={
 starter:{verb:'Run cleanly',headline:'Keep stock, orders and money connected.',features:['Inventory, variants, lots, serials and multiple locations','Purchasing, receiving, sales orders, returns and manual shipping','Native accounting, reports and operational alerts','Grounded Ask with actions you approve','Spreadsheet imports with a preview','Standard commerce connections']},
 growth:{verb:'Connect the operation',headline:'Plan replenishment and follow connected work.',features:['Everything in Starter','Gmail and Microsoft 365 inbox monitoring','Email sending with your approval','Stockout planning and transfer-before-buy recommendations','Carrier rates, labels and tracking','QuickBooks and Xero connections with shadow reconciliation']},
 pro:{verb:'Manage exceptions',headline:'Authorize bounded purchasing and transfers.',features:['Everything in Growth','Automatic transfers within approved location and quantity limits','Automatic purchasing within approved supplier and spending limits','Advanced authority policies','Warehouse waves and scans','Inventory API and approved external accounting posting']},
 enterprise:{verb:'Fit your operation',headline:'Agree the scale your business needs.',features:['Everything in Pro','Contract-defined capacity','Implemented custom API and event feeds','Provider qualification scoped to supported workflows']}
}; %>
<section class="pricing-intro"><div><span class="pub-kicker">Plans by operating responsibility</span><h1>Choose the work StockChief can handle for your business.</h1><p>Every plan connects inventory, purchasing, sales orders and native accounting. Higher plans add connected workflows and bounded authority.</p></div><div class="billing-switch" data-billing-switch><button class="is-active" data-interval="monthly" type="button">Monthly</button><button data-interval="annual" type="button">Annual</button></div></section>
<div class="pub-notice">Checkout is closed while final usage allowances and add-on prices are reviewed.</div>
<% if(checkoutCancelled){ %><div class="pub-notice">Checkout was cancelled.</div><% } %>
<section class="plan-ladder"><% plans.forEach(function(plan,index){var story=stories[plan.id]||stories.starter; %>
<article class="plan-card plan-card--<%= plan.id %> <%= plan.is_recommended?'is-recommended':'' %>" id="<%= plan.id %>">
<header><span class="plan-card__number">0<%= index+1 %></span><div><small><%= story.verb %></small><h2><%= plan.public_name %></h2></div></header>
<div class="plan-card__body"><div class="plan-card__promise"><h3><%= story.headline %></h3><div class="plan-price" <% if(!plan.sales_only){ %> data-monthly="$<%= Number(plan.monthly_amount_minor)/100 %>" data-annual="$<%= Math.round(Number(plan.annual_amount_minor)/1200) %>" data-annual-note="Billed annually · $<%= Number(plan.annual_amount_minor)/100 %>/year" <% } %>>
<% if(plan.sales_only){ %><strong>Custom</strong><span>Contracted scope</span><% }else{ %><strong>$<%= Number(plan.monthly_amount_minor)/100 %></strong><span>/month</span><small data-price-note>Billed monthly</small><% } %></div></div>
<div class="plan-card__features"><small>WHAT THIS PLAN ADDS</small><ul><% story.features.forEach(function(feature){ %><li><i>✓</i><span><%= feature %></span></li><% }); %></ul>
<div class="plan-card__usage"><p>Included AI Work Credits and Connected Operations, with optional usage packs.</p><details><summary>View usage details</summary><p>Monthly included usage resets without rollover. Purchased usage is allocated to your chosen inventory, used after included usage, and expires after 12 months. Optional costly processing pauses when usage runs out; core records remain available.</p><p>Exact allowances and pack prices are provisional and will be published after the cost review.</p></details></div></div>
<div class="plan-card__action"><a class="pub-btn" href="<%= plan.sales_only?'/contact?plan=enterprise':'/register?plan='+plan.id+'&interval=monthly' %>" data-plan-link data-plan="<%= plan.id %>"><%= plan.sales_only?'Discuss Enterprise':'Choose '+plan.public_name %></a></div></div></article><% }); %></section>
<section class="qualification-note"><span>Connected providers</span><h2>Connect the services your business has qualified.</h2><p>Carrier, merchant payment and accounting workflows depend on provider availability and authorization for your business.</p><a href="/integrations">View supported integrations →</a></section>
