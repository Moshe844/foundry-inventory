<section class="page-hero"><span class="pub-kicker">Connections</span><h1>Your business, connected.</h1><p>Bring the systems you already use into StockChief. Choose any connection to see what it does and exactly how to connect it.</p></section>
<div class="pub-integration-directory"><% for(const group of groups){ const groupId='group-'+group.title.toLowerCase().replace(/[^a-z0-9]+/g,'-'); %><section aria-labelledby="<%= groupId %>"><header><h2 id="<%= groupId %>"><%= group.title %></h2><p><%= group.description %></p></header><div class="pub-integration-cards"><% for(const p of group.providers){ %><article><div class="pub-integration-logo"><% if(p.logo){ %><img src="/provider-logos/<%= p.logo %>.svg" alt="" width="32" height="32"><% }else{ %><span aria-hidden="true"><%= p.name.slice(0,1) %></span><% } %></div><h3><button type="button" class="pub-integration-open" data-integration-open="<%= p.id %>" aria-haspopup="dialog"><%= p.name %></button></h3><p><%= p.description %></p><span class="pub-integration-more"><% if(p.status){ %><span class="pub-integration-status"><%= p.status %></span><% } %>See how it works</span></article><% } %></div></section><% } %></div>
<% for(const group of groups){ for(const p of group.providers){ %><dialog class="pub-integration-dialog" id="<%= p.id %>" aria-labelledby="<%= p.id %>-title">
 <header><div class="pub-integration-logo"><% if(p.logo){ %><img src="/provider-logos/<%= p.logo %>.svg" alt="" width="32" height="32"><% }else{ %><span aria-hidden="true"><%= p.name.slice(0,1) %></span><% } %></div><div><p class="pub-integration-dialog__group"><%= group.title %><% if(p.status){ %> · <span class="pub-integration-status"><%= p.status %></span><% } %></p><h2 id="<%= p.id %>-title"><%= p.name %></h2></div><button type="button" class="pub-integration-dialog__close" data-integration-close aria-label="Close">×</button></header>
 <p class="pub-integration-dialog__what"><%= p.what || p.description %></p>
 <% if(p.provides && p.provides.length){ %><h3>What comes into StockChief</h3><ul><% for(const item of p.provides){ %><li><%= item.charAt(0).toUpperCase()+item.slice(1) %></li><% } %></ul><% } %>
 <h3>How to connect it</h3><ol><% for(const step of p.steps){ %><li><%= step %></li><% } %></ol>
 <% if(p.control && p.control.length){ %><h3>What stays in your hands</h3><ul><% for(const item of p.control){ %><li><%= item %></li><% } %></ul><% } %>
 <footer><% if(p.status){ %><p><%= p.name %> is being certified before businesses can connect it themselves.</p><a class="pub-btn pub-btn--secondary" href="/support">Ask about <%= p.name %></a><% }else{ %><a class="pub-btn" href="/register">Create your account</a><a class="pub-btn pub-btn--secondary" href="/login">Sign in to connect</a><% } %></footer>
</dialog><% } } %>
<section class="qualification-note"><h2>Your accounts. Your control.</h2><p>Available actions depend on your plan, provider permissions and account setup. Connect a test account to verify a workflow before enabling automatic work. A listed integration does not mean every provider feature has been certified.</p><a href="/support">Get help with a connection →</a></section>
