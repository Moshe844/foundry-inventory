<%
  const plan=locals.inquiryPlan;
  const pilotRequest=locals.supportTopic?.key==='pilot';
  const subject=plan ? plan.public_name+(pilotRequest?' pilot access request':' plan enquiry') : null;
%>
<section class="contact-hero">
  <div>
    <span class="pub-kicker"><%= pilotRequest?'Private pilot':'Email StockChief' %></span>
    <h1><%= pilotRequest?'Request access to StockChief':plan?'Let’s plan StockChief for your business.':'Tell us what you need.' %></h1>
    <% if(pilotRequest){ %><p>Tell us about your business. We’ll review your request and reply by email.</p>
    <% }else{ %><p><%= plan?'Tell Moshe about your team, inventories and connections. He will reply by email with the right setup and pricing.':'Ask about a plan, migration, or your business requirements. Moshe will reply by email.' %></p><% } %>
    <p>Email: <strong>support@stockchiefhq.com</strong></p>
    <% if(locals.account){ %><a class="pub-btn pub-btn--secondary" href="/settings/billing">Back to Plan &amp; billing</a><% } %>
  </div>
  <div>
    <% if(plan&&!locals.supportReceipt){ %>
      <section class="card card-body">
        <h2><%= subject %></h2>
        <% if(locals.supportError){ %><p role="alert"><%= supportError %></p><% } %>
        <form method="post" action="<%= pilotRequest?'/support/requests?topic=pilot':'/support/requests' %>" class="stack-form">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <input type="hidden" name="requestKey" value="<%= supportRequestKey %>">
          <input type="hidden" name="planId" value="<%= plan.id %>">
          <input type="hidden" name="subject" value="<%= subject %>">
          <input type="hidden" name="sourcePath" value="/pricing">
          <label class="field">Reply email<input class="input" type="email" name="email" value="<%= locals.supportContactEmail||'' %>" <%= locals.account?.id?'readonly':'' %> required maxlength="254"></label>
          <label class="field">What does your business need?<textarea class="input" name="body" rows="6" maxlength="10000" required placeholder="Your team size, inventories, sales channels and the work you want StockChief to handle"></textarea></label>
          <button class="pub-btn" type="submit"><%= pilotRequest?'Request pilot access':'Send plan enquiry' %></button>
        </form>
      </section>
    <% }else{ %><%- include('../partials/support-form') %><% } %>
  </div>
</section>
