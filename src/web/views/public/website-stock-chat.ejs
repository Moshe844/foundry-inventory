<% const heading=(answer&&answer.title)||title||'Stock assistant'; const pending=(answer&&answer.handoff)?answer.question:(typeof question==='string'&&question?question:null); %><!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><meta name="robots" content="noindex,nofollow"><title><%= heading %> · StockChief</title><style>body{margin:0;background:#f6f7fb;color:#172637;font-family:system-ui,sans-serif;font-size:15px;line-height:1.5}main{max-width:600px;margin:auto;padding:18px}h1{font-size:22px;margin-top:0}.reply{padding:16px;background:white;border:1px solid #d5dee9;border-radius:14px;margin:18px 0;overflow-wrap:anywhere}.question{padding:12px;background:#e9e8ff;border-radius:12px;overflow-wrap:anywhere}label{display:block;font-weight:600}input{box-sizing:border-box;width:100%;padding:12px;margin:7px 0 12px;border:1px solid #b5c1d0;border-radius:9px;font:inherit}button{padding:12px 18px;border:0;background:#5145cd;color:white;font:inherit;border-radius:9px}small{color:#526274}a{color:#5145cd}form{margin-top:20px}.handoff{margin-top:0}.handoff button{background:#172637}[hidden]{display:none}</style></head><body><main>
<h1><%= heading %></h1>
<% if(sent){ %><p role="status" class="reply">Your question was sent to the team. They will reply if you left an email or phone number.</p><% } %>
<% if(problem){ %><p role="status" class="reply"><%= problem %></p><% } %>
<% if(answer){ %><p>Ask about an exact published product code or the public delivery policy.</p><% if(answer.question){ %><p class="question"><%= answer.question %></p><% } %><section class="reply" aria-label="Stock assistant answer"><p><%= answer.reply %></p><% if(answer.delivery && answer.delivery!==answer.reply){ %><p><%= answer.delivery %></p><% } %><% if(answer.suggestions.length){ %><p>Product codes: <%= answer.suggestions.join(', ') %></p><% } %></section><% } %>
<% if(pending){ %><form class="handoff" method="post" action="/stock-assistant/<%= token %>/handoff"><input type="hidden" name="question" value="<%= pending %>"><div hidden aria-hidden="true"><label>Leave this empty<input name="website" tabindex="-1" autocomplete="off"></label></div><label>Email or phone for the team’s reply (optional)<input name="contact" maxlength="200" autocomplete="email" inputmode="email"></label><button type="submit">Send my question to the team</button></form><% } %>
<% if(answer||sent||(problem&&pending)){ %><form method="get" action="/stock-assistant/<%= token %>"><label>Your stock or delivery question<input name="q" maxlength="200" required autocomplete="off" placeholder="Is WIDGET-01 available?"></label><button type="submit">Ask about stock or delivery</button></form><p><small>Stock status is current recorded information. The business separately confirms orders, availability at acceptance and delivery dates.</small></p><% } %><p><small>Powered by StockChief</small></p></main></body></html>
