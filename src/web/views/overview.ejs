<%
  /*
   * The other Home.
   *
   * "/" renders this when Foundry has not been configured for the workspace,
   * and the briefing page when it has — so the first screen a new customer ever
   * sees was the one that had not been redesigned. It called itself Overview
   * while the sidebar entry said Home, opened with a page of stacked notices,
   * and put its counters above the one thing somebody had come to find out.
   *
   * It is the same briefing now, in the same order, answering the same three
   * questions: how is the business doing, what needs me, what has happened.
   * What differs is only what a workspace at this stage can honestly say.
   */
  var waiting = (typeof operatingDecisions !== 'undefined' && operatingDecisions) ? operatingDecisions.length : 0;
  var isEmpty_ = typeof isEmpty !== 'undefined' && isEmpty;
  var brief_ = typeof brief !== 'undefined' ? brief : null;
  var findings = typeof attention !== 'undefined' ? attention : [];

  var coreInventoryReady = typeof guidance !== 'undefined' && guidance
    && guidance.state.itemCount > 0 && guidance.state.locations.length > 0
    && guidance.state.movementCount > 0;
  var guidanceInProgress = typeof guidance !== 'undefined' && guidance && !coreInventoryReady;

  var hour = new Date().getHours();
  var greeting = hour < 12 ? 'Good morning' : hour < 18 ? 'Good afternoon' : 'Good evening';
  var firstName = currentUser && currentUser.name ? currentUser.name.split(/\s+/)[0] : '';

  /*
   * What "needs you" means, counted once.
   *
   * This page had two of them. It rendered the attention findings as "Needs
   * your attention" and mentioned the inbox underneath as "Separately, 3 things
   * are waiting for you in Needs you" — two queues with near-identical names,
   * going to two different pages, while the verdict added both together. One
   * morning screen said 9, then 6, then 3, and the sidebar badge beside the
   * words "Needs you" said 3 again. Nobody can act on that.
   *
   * needs-you-count says it plainly: "The inbox is the customer-facing source
   * of truth", and the sidebar, the workspace switcher and the Needs you page
   * all count it. So does this page now. The findings Foundry has noticed but
   * cannot turn into a decision are still one link away, named as what they
   * are rather than as a second thing needing you.
   */
  var decisions = (typeof operatingDecisions !== 'undefined' && operatingDecisions) ? operatingDecisions : [];
  var needing = decisions.length;
  var verdict = isEmpty_
    ? 'This inventory is empty'
    : needing === 0
      ? 'Everything is under control'
      : needing + (needing === 1 ? ' thing needs you' : ' things need you');

  var foundryConfig = typeof configuration !== 'undefined' ? configuration : null;
  var configured = foundryConfig && foundryConfig.configuredAt && foundryConfig.configurationVersion > 0;
%>

<header class="briefing <%= needing ? 'briefing--attention' : 'briefing--clear' %>">
  <div class="briefing__copy">
    <p class="briefing__greeting"><%= greeting %><%= firstName ? ', ' + firstName : '' %></p>
    <h1 class="briefing__verdict"><%= verdict %></h1>
    <p class="briefing__sub">
      <% if (isEmpty_) { %>
        Tell Foundry what you keep here and it will work out how to track it — what counts as an item,
        which locations you need, and whether anything needs serial numbers or batch dates.
      <% } else if (needing) { %>
        Everything else, Foundry is getting on with.
      <% } else { %>
        Nothing is waiting on you.
      <% } %>
    </p>
  </div>
  <div class="briefing__state">
    <% if (attentionSummary && attentionSummary.critical > 0) { %>
      <span class="badge badge--danger"><%= attentionSummary.critical %> urgent</span>
    <% } else if (isEmpty_) { %>
      <span class="badge badge--muted">Not set up yet</span>
    <% } else if (needing === 0) { %>
      <span class="badge badge--ok">All clear</span>
    <% } else { %>
      <span class="badge badge--warn"><%= needing %> waiting for you</span>
    <% } %>
  </div>
</header>

<% if (isEmpty_) { %>
  <section class="section">
    <div class="btn-row">
      <a class="btn btn--primary" href="/foundry">Set it up with Foundry</a>
      <a class="btn" href="/locations">Add a location</a>
      <a class="btn" href="/inventory/new">Add an item</a>
    </div>
  </section>
<% } %>

<% if (guidanceInProgress) { %>
  <%- include('partials/operating-guidance', { guidance: guidance }) %>
<% } %>

<%# ------------------------------------------------------- Needs your attention %>
<% if (!isEmpty_) { %>
  <section class="section">
    <div class="section-head">
      <h2>Needs your attention</h2>
      <div class="section-head__aside">
        <% if (needing > 3) { %>
          <a class="section-more" href="/needs-you">See all <%= needing %></a>
        <% } %>
        <form method="post" action="/attention/refresh">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <input type="hidden" name="returnTo" value="overview">
          <button class="btn btn--sm btn--ghost" type="submit">Check again</button>
        </form>
      </div>
    </div>

    <%
      /*
       * The same shape the configured Home uses, and for the same reason.
       *
       * This page rendered the full attention card — severity, evidence, when it
       * was first seen, which lot and location, and three buttons: Why this?,
       * I'm on it, Not a problem. Four of those stacked is most of a screen, and
       * it is a second Needs-you pattern living beside the first, so the same
       * idea looked different depending on whether Foundry had been configured.
       *
       * Home states the decision and offers the one action that resolves it.
       * Dismissing, claiming and reading the evidence are all still there, on
       * the finding's own page, which is where somebody deciding goes anyway.
       */
    %>
    <% if (decisions.length) { %>
      <div class="inbox">
        <% decisions.slice(0, 3).forEach(function (entry) { %>
          <article class="inbox-item <%= entry.importance === 'Urgent' ? 'inbox-item--urgent' : entry.importance === 'Important' ? 'inbox-item--important' : '' %>">
            <div>
              <% if (entry.importance === 'Urgent' || entry.importance === 'Important') { %>
                <span class="badge badge--<%= entry.importance === 'Urgent' ? 'danger' : 'warn' %>"><%= entry.importance %></span>
              <% } %>
              <h3 class="inbox-item__title"><%= entry.title %></h3>
              <% if (entry.happened) { %><p class="inbox-item__because"><%= entry.happened %></p><% } %>
            </div>
            <div class="inbox-item__do">
              <a class="btn btn--primary btn--sm" href="<%= entry.href %>"><%= entry.actionLabel %></a>
            </div>
          </article>
        <% }) %>
      </div>
    <% } else { %>
      <div class="quiet-note">
        <span class="dot <%= waiting ? '' : 'dot--ok' %>" aria-hidden="true"></span>
        <%= brief_ ? brief_.body : 'Nothing in your stock needs attention right now.' %>
      </div>
    <% } %>

    <%# Everything else Foundry has spotted in the stock but cannot turn into a
        decision — an expiring lot, something that has not moved in months. Worth
        a look, not the same as being asked for something, and named accordingly. %>
    <% if (attentionTotal) { %>
      <p class="section-foot t-muted">
        Foundry has also noticed <%= attentionTotal %>
        thing<%= attentionTotal === 1 ? '' : 's' %> about your stock
        <% if (findings.length) { %>— <%= findings[0].title %><% } %>.
        <a href="/attention">Take a look</a>.
      </p>
    <% } %>
  </section>
<% } %>

<%
  /*
   * The briefing paragraph is gone from here, and this is why.
   *
   * It reads: "6 things need your attention: 1 urgent, 4 worth doing today...
   * Start with: Lot B-0731 has expired. Then: Lot B-0422 expires in 10 days;
   * Galvanised Pipe Bracket has not moved" — which is a sentence listing the
   * exact three items rendered immediately above it, in the same order. Written
   * for a page that did not show them; kept on one that does, it made the reader
   * check whether the paragraph and the list were saying different things.
   *
   * It still does its job where nothing is listed: the quiet note above uses it
   * verbatim when there are no findings to show. Check again moved up beside
   * the heading it re-runs.
   */
%>

<%# ------------------------------------------------------------ What happened %>
<% if (!isEmpty_) { %>
  <section class="section">
    <div class="section-head">
      <h2>Recent activity</h2>
      <a class="section-more" href="/activity">See all</a>
    </div>
    <% if (activity.length === 0) { %>
      <div class="quiet-note">
        Once you receive stock, every movement shows up here with who did it and why.
      </div>
    <% } else { %>
      <div class="panel"><%- include('partials/ledger', { groups: activity, helpers: helpers }) %></div>
    <% } %>
  </section>
<% } %>

<%# ---------------------------------------------------------- Inventory pulse %>
<section class="section">
  <div class="section-head">
    <h2>Inventory pulse</h2>
    <a class="section-more" href="/inventory">Open inventory</a>
  </div>
  <div class="stat-strip">
    <div>
      <span class="stat-value"><%= helpers.qty(stats.itemCount) %></span>
      <span class="stat-label">Tracked items</span>
    </div>
    <div>
      <span class="stat-value"><%= helpers.qty(stats.locationCount) %></span>
      <span class="stat-label"><%= helpers.plural(stats.locationCount, 'location') %></span>
    </div>
    <div>
      <span class="stat-value"><%= helpers.qty(stats.unitsOnHand) %></span>
      <span class="stat-label">Units on hand</span>
    </div>
    <div>
      <span class="stat-value <%= stats.zeroCount > 0 ? 'stat-value--warn' : 'stat-value--quiet' %>"><%= helpers.qty(stats.zeroCount) %></span>
      <span class="stat-label">at zero</span>
    </div>
  </div>

  <% if (stats.locationCount === 0) { %>
    <p class="section-foot">
      Stock has to live somewhere. <a href="/locations">Add a warehouse, store or van</a>, then add what you track.
    </p>
  <% } %>

  <%
    // The breakdowns — where it sits, what has run out, what expires, what is
    // serial-tracked — were four more cards down the right-hand side of the
    // page. They are the detail behind the four numbers above, so they live
    // behind them.
    var hasDetail = stats.byLocation.length || stats.zeroStock.length
      || stats.expiringLots.length || stats.trackedUnits > 0;
  %>
  <% if (hasDetail) { %>
    <details class="disclose">
      <summary>
        <span>Where it sits, what has run out, and what expires soon</span>
        <span class="disclose__cue">Show</span>
      </summary>
      <div class="disclose__body">
        <% if (stats.byLocation.length) { %>
          <h3 class="detail-head">Stock by location</h3>
          <%
            var max = stats.byLocation.reduce(function (m, l) { return Math.max(m, l.on_hand); }, 0) || 1;
          %>
          <div class="location-bars">
            <% stats.byLocation.forEach(function (location) { %>
              <div class="location-bar">
                <span class="name"><a href="/inventory?location=<%= location.id %>"><%= location.name %></a></span>
                <span class="value num"><%= helpers.qty(location.on_hand) %></span>
                <span class="track"><span class="fill" style="width: <%= Math.round((location.on_hand / max) * 100) %>%"></span></span>
              </div>
            <% }) %>
          </div>
        <% } %>

        <% if (stats.zeroStock.length) { %>
          <h3 class="detail-head">At zero</h3>
          <ul class="plain-list">
            <% stats.zeroStock.forEach(function (item) { %>
              <li><a href="/inventory/<%= item.id %>"><%= item.name %></a><% if (item.base_code) { %> <span class="t-muted mono"><%= item.base_code %></span><% } %></li>
            <% }) %>
          </ul>
          <% if (stats.zeroCount > stats.zeroStock.length) { %>
            <p class="t-muted">and <%= stats.zeroCount - stats.zeroStock.length %> more</p>
          <% } %>
        <% } %>

        <% if (stats.expiringLots.length) { %>
          <h3 class="detail-head">Lots by expiration</h3>
          <div class="table-wrap">
            <table class="table">
              <tbody>
                <% stats.expiringLots.forEach(function (lot) { %>
                  <% var state = helpers.expiryState(lot.expires_at); %>
                  <tr>
                    <td>
                      <a class="cell-title" href="/inventory/<%= lot.item_id %>"><%= lot.item_name %></a>
                      <span class="cell-sub mono">Lot <%= lot.code %></span>
                    </td>
                    <td class="num">
                      <span class="badge badge--<%= state.tone === 'danger' ? 'danger' : (state.tone === 'warn' ? 'warn' : 'muted') %>"><%= state.text %></span>
                      <span class="cell-sub"><%= helpers.qty(lot.quantity) %> on hand</span>
                    </td>
                  </tr>
                <% }) %>
              </tbody>
            </table>
          </div>
        <% } %>

        <% if (stats.trackedUnits > 0) { %>
          <h3 class="detail-head">Individually tracked units</h3>
          <p><%= helpers.qty(stats.trackedUnits) %> serial-numbered units currently in stock.</p>
        <% } %>
      </div>
    </details>
  <% } %>

  <%# How Foundry is set up for this inventory. One line, where the numbers are,
      rather than its own panel with a button in the middle of the page. %>
  <% if (configured) { %>
    <%
      var m = foundryConfig.inventoryModel || {};
      var modeLabel = m.primaryArchetype ? helpers.TRACKING_MODES[m.primaryArchetype].label.toLowerCase() : 'quantity';
    %>
    <p class="section-foot t-muted">
      <a href="/foundry">Ask Foundry about your inventory</a> — set up for <%= modeLabel %> tracking<%= m.usesVariants ? ' with variants' : '' %>
      across <%= stats.locationCount %> <%= helpers.plural(stats.locationCount, term('location').toLowerCase()) %>.
    </p>
  <% } %>
</section>
