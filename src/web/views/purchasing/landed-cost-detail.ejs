<main class="rm-canvas rm-landed-cost">
  <p class="rm-stamp"><a href="/purchasing/orders/<%= order.id %>/landed-costs">Landed cost</a> <span>›</span> <%= document.document_number %></p>
  <h1 class="rm-verdict"><%= document.status === 'APPLIED' ? 'This landed cost is in inventory value.' : 'Review the exact landed-cost split.' %></h1>
  <p class="rm-prose"><% if (document.status === 'DRAFT') { %>StockChief has not changed inventory or accounting. Approval confirms this evidence and split; applying it posts the reclassification once.<% } else if (document.status === 'APPROVED') { %>Approved. Applying will update inventory value and future COGS using the exact amounts below.<% } else { %>StockChief preserved the evidence, allocation, and accounting entry together.<% } %></p>
  <section class="rm-panel"><div class="rm-panel__head"><div><p class="rm-kicker">Evidence</p><h2><%= document.charges.map(function(c){ return c.description; }).join(', ') %></h2></div><span class="rm-transfer-status rm-transfer-status--<%= String(document.status).toLowerCase() %>"><%= document.status.toLowerCase() %></span></div><div class="rm-panel__body"><ul class="rm-list"><% document.charges.forEach(function(charge){ %><li><strong><%= charge.category %> · $<%= (charge.amount_minor / 100).toFixed(2) %></strong> from <%= charge.source_bill_status %> supplier bill line</li><% }) %></ul></div></section>
  <% if (preview) { %><section class="rm-panel"><div class="rm-panel__head"><div><p class="rm-kicker">Before StockChief applies it</p><h2>The source and allocated totals agree exactly.</h2></div></div><div class="rm-panel__body"><div class="rm-landed-cost__totals"><span>Source charges <strong>$<%= (preview.sourceTotalMinor / 100).toFixed(2) %></strong></span><span>Allocated to received stock <strong>$<%= (preview.allocatedTotalMinor / 100).toFixed(2) %></strong></span></div><div class="rm-landed-cost__allocations"><% preview.allocations.forEach(function(allocation){ %><div><span><strong><%= allocation.itemName %></strong><small><%= allocation.skuCode %> · <%= allocation.quantityUnits %> received</small></span><strong>$<%= (allocation.amountMinor / 100).toFixed(2) %></strong></div><% }) %></div></div></section><% } else { %><section class="rm-panel"><div class="rm-panel__body"><h2 class="rm-h">Applied allocation</h2><div class="rm-landed-cost__allocations"><% document.allocations.forEach(function(allocation){ %><div><span><strong><%= allocation.item_name %></strong><small><%= allocation.sku_code %> · <%= allocation.location_name %></small></span><strong>$<%= (allocation.amount_minor / 100).toFixed(2) %></strong></div><% }) %></div></div></section><% } %>
  <% if (permissions.landedCosts && document.status === 'DRAFT') { %><form method="post" action="/purchasing/orders/<%= order.id %>/landed-costs/<%= document.id %>/approve" class="rm-choices" data-busy><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="rm-btn" type="submit">Approve this allocation</button><a class="rm-btn rm-btn--ghost" href="/purchasing/orders/<%= order.id %>/landed-costs">Change it</a></form><% } %>
  <% if (permissions.landedCosts && document.status === 'APPROVED') { %><form method="post" action="/purchasing/orders/<%= order.id %>/landed-costs/<%= document.id %>/apply" class="rm-choices" data-busy><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="rm-btn" type="submit">Apply to inventory value</button><a class="rm-btn rm-btn--ghost" href="/purchasing/orders/<%= order.id %>/landed-costs">Back</a></form><% } %>
</main>
