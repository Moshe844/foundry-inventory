<div class="page-head">
  <div class="titles">
    <a class="back-link" href="/purchasing/orders"><%- helpers.icon('chevron', { size: 14 }) %> Purchase orders</a>
    <h1><%= order.poNumber %> · <%= order.supplierName %></h1>
    <div class="page-sub">
      <%= helpers.columnLabel(order.status.toLowerCase().replace('_', ' ')) %>
      <% if (order.expectedDate) { %> · expected <%= order.expectedDate %><% } %>
      <% if (order.source === 'foundry_recommendation') { %> · prepared by Foundry<% } %>
      <% if (order.source === 'instruction') { %> · from something you asked for<% } %>
    </div>
  </div>
</div>

<% var missingCostLines = (order.lines || []).filter(function(line) { return line.unitCost === null || line.unitCost === undefined; }); %>
<% if (order.isEditable && missingCostLines.length) { %>
  <form method="post" action="/purchasing/orders/<%= order.id %>/prices" class="card section">
    <div class="card-head"><div><h2>Finish pricing this order</h2><p class="muted">Foundry will not approve or send an order until every selected product has a unit cost.</p></div><span class="spacer"></span><span class="badge badge--warn">Do this now</span></div>
    <div class="card-body grid">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <% missingCostLines.forEach(function(line) { %>
        <label class="field"><span class="field-label"><%= line.displayName %> · cost for one <%= line.unitLabel %></span><input class="input" type="number" min="0" step="0.01" name="unitCost[<%= line.id %>]" placeholder="20.00" required autofocus></label>
      <% }) %>
    </div>
    <div class="card-foot"><button class="btn btn--primary" type="submit">Save prices and continue</button></div>
  </form>
<% } %>

<% if (communications && communications.length && order.hasCosts) { var communication = communications[0]; %>
  <div class="card section">
    <div class="card-head">
      <div><h2>Supplier message</h2><p class="muted">Prepared from this order and sent only through the supplier's approved mailbox and authority.</p></div>
      <span class="spacer"></span>
      <span class="badge <%= communication.status === 'SENT' ? 'badge--ok' : communication.status === 'FAILED' ? 'badge--danger' : 'badge--muted' %>"><%= communication.status.toLowerCase() %></span>
    </div>
    <div class="card-body grid">
      <% if (communication.status === 'PREPARED') { %>
        <div class="notice"><span>Prepared, not queued or sent. Approving the order records the commitment in Foundry.</span></div>
      <% } else if (communication.status === 'QUEUED') { %>
        <div class="notice notice--warn"><span>Ready to send. Foundry has not told the supplier yet.</span></div>
      <% } else if (communication.status === 'SENT') { %>
        <div class="notice" style="background:var(--ok-bg); border-color:#bbf7d0; color:#14532d;"><span>Sent successfully<%= communication.mailboxProviderName ? ' through ' + communication.mailboxProviderName : '' %> from <%= communication.mailboxName %> to <%= communication.recipient %>.</span></div>
      <% } %>
      <dl class="kv"><dt>To</dt><dd><%= communication.recipient || 'No supplier email on file' %></dd><dt>Subject</dt><dd><%= communication.subject %></dd></dl>
      <details><summary>Preview message</summary><pre style="white-space:pre-wrap; font-family:inherit;"><%= communication.body %></pre></details>
      <% if (permissions.approve && communication.status !== 'SENT' && communication.connectorId && communication.recipient && !order.isEditable) { %><form method="post" action="/purchasing/orders/<%= order.id %>/send"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="btn btn--primary" type="submit">Send to supplier</button></form><% } %>
    </div>
  </div>
<% } %>

<% if (order.status === 'CANCELLED') { %>
  <div class="notice notice--warn section">
    This order was cancelled<%= order.cancelReason ? ': ' + order.cancelReason : '.' %>
    <% if (order.receivedUnits) { %>
      The <%= order.receivedUnits %> unit<%= order.receivedUnits === 1 ? '' : 's' %> that had already arrived
      stayed in your inventory — cancelling an order never removes stock that physically exists.
    <% } %>
  </div>
<% } %>

<% var moneyStatus = !supplierBills.length ? 'Waiting for supplier invoice'
     : billSummary.needsReview ? 'Invoice needs review'
     : billSummary.owedMinor === 0 ? 'Paid'
     : billSummary.paidMinor > 0 ? 'Partially paid' : 'Unpaid'; %>
<section class="card section supplier-order-story">
  <div class="card-head"><div><p class="eyebrow">Foundry handles the routine work</p><h2>Delivery and payment are tracked separately</h2><p class="hint">Receiving products changes inventory. A supplier invoice creates the bill. A payment reduces only the bill.</p></div></div>
  <div class="card-body">
    <div class="supplier-order-tracks">
      <div class="supplier-order-track">
        <h3>Products</h3>
        <p class="supplier-order-track__status"><%= order.outstandingUnits === 0 ? 'Everything received' : order.receivedUnits > 0 ? 'Partially received' : 'Waiting for delivery' %></p>
        <dl class="money-plain-list"><div><dt>Ordered</dt><dd><%= order.orderedUnits %> units</dd></div><div><dt>Received</dt><dd><%= order.receivedUnits %> units</dd></div><div><dt>Still expected</dt><dd><%= order.outstandingUnits %> units</dd></div></dl>
      </div>
      <div class="supplier-order-track">
        <h3>Supplier money</h3>
        <p class="supplier-order-track__status"><%= moneyStatus %></p>
        <dl class="money-plain-list"><div><dt>Supplier invoices received</dt><dd><%= helpers.money(billSummary.invoiceTotalMinor, order.currency) %></dd></div><div><dt>Paid</dt><dd><%= helpers.money(billSummary.paidMinor, order.currency) %></dd></div><div><dt>Still owed</dt><dd><%= helpers.money(billSummary.owedMinor, order.currency) %></dd></div></dl>
      </div>
    </div>
    <div class="notice notice--info"><div><strong>These balances never change each other.</strong><br>A partial delivery changes “Still expected.” A partial payment changes “Still owed.” Foundry waits for evidence of each event and never treats an invoice as a delivery or a delivery as a payment.</div></div>

    <% if (!supplierBills.length) { %>
      <div class="notice"><div><strong>No supplier invoice has been received for this order yet.</strong><br>Foundry is watching the approved supplier mailbox. A trusted invoice will be matched to <%= order.poNumber %>, checked against its products and prices, and turned into a supplier bill automatically. Receiving inventory alone does not say the supplier was paid.</div></div>
    <% } else { %>
      <div class="stack supplier-bill-list">
        <% supplierBills.forEach(function(bill) { var openBill = ['OPEN','PARTIALLY_PAID'].includes(bill.status); var paid = Number(bill.total_minor) - Number(bill.balance_minor); %>
          <div class="list-row">
            <div><strong><%= bill.supplier_invoice_number ? 'Supplier invoice ' + bill.supplier_invoice_number : bill.bill_number %></strong><p><%= helpers.money(bill.total_minor, bill.currency) %> invoice · <%= helpers.money(paid, bill.currency) %> paid · <%= helpers.money(bill.balance_minor, bill.currency) %> still owed</p><small><%= bill.status.replaceAll('_',' ').toLowerCase() %> · <%= bill.match_status.replaceAll('_',' ').toLowerCase() %><%= bill.due_date ? ' · due ' + bill.due_date : '' %></small></div>
            <% if (openBill && permissions.payments) { %><details class="advanced-settings"><summary class="btn btn--sm">Record payment</summary><form method="post" action="/accounting/payables/<%= bill.id %>/payment" class="form-inline"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="idempotencyKey" value="<%= bill.id %>-<%= Date.now() %>"><input type="hidden" name="returnTo" value="/purchasing/orders/<%= order.id %>"><label class="field"><span class="field-label">Amount actually paid</span><input class="input input--sm" name="amount" inputmode="decimal" value="<%= (bill.balance_minor / 100).toFixed(2) %>" required></label><label class="field"><span class="field-label">Payment date</span><input class="input input--sm" type="date" name="paymentDate" value="<%= new Date().toISOString().slice(0,10) %>" required></label><label class="field"><span class="field-label">Reference</span><input class="input input--sm" name="reference" placeholder="Check, transfer, card…"></label><button class="btn btn--primary btn--sm" type="submit">Record payment</button></form></details><% } %>
          </div>
        <% }) %>
      </div>
    <% } %>

    <div class="supplier-autonomy-next"><strong>What Foundry does next</strong><p><% if (order.outstandingUnits > 0) { %>Keeps watching for shipment and delivery evidence for the remaining <%= order.outstandingUnits %> units. <% } %><% if (!supplierBills.length) { %>Keeps watching for the supplier invoice. <% } else if (billSummary.owedMinor > 0) { %>Keeps the <%= helpers.money(billSummary.owedMinor, order.currency) %> balance open and updates it when payment evidence is recorded. <% } %>Any price, quantity, SKU, duplicate, or authority exception goes to Needs You instead of being guessed.</p></div>
  </div>
</section>

<div class="card section">
  <div class="card-head">
    <h2><%= order.isEditable && !order.hasCosts ? 'This order needs a price' : order.status === 'DRAFT' || order.status === 'AWAITING_APPROVAL' ? 'Foundry is ready to order' : 'The order' %></h2>
    <span class="spacer"></span>
    <span class="badge badge--<%= order.status === 'RECEIVED' ? 'ok' : order.status === 'CANCELLED' ? 'danger' : 'muted' %>">
      <%= helpers.columnLabel(order.status.toLowerCase().replace('_', ' ')) %>
    </span>
  </div>
  <div class="table-scroll">
    <table class="table table--tight">
      <thead>
        <tr>
          <th>Product</th><th><%= order.supplierItemCodeLabel %></th><th class="num">Ordered</th>
          <th class="num">Received</th><th class="num">Unit cost</th><th class="num">Line total</th>
        </tr>
      </thead>
      <tbody>
        <% order.lines.forEach(function (line) { %>
          <tr>
            <td>
              <%= line.displayName %>
              <div class="muted">
                <%= helpers.unitCount(line.quantityPurchaseUnits, line.purchaseUnit) %>
                <% if (line.unitsPerPurchaseUnit > 1) { %> of <%= line.unitsPerPurchaseUnit %><% } %>
                <% if (line.destinationLocationName) { %> → <%= line.destinationLocationName %><% } %>
              </div>
            </td>
            <td class="muted"><%= line.supplierSku || '—' %></td>
            <td class="num"><%= line.quantityUnits %></td>
            <td class="num <%= line.isComplete ? '' : 'is-warn' %>"><%= line.quantityReceivedUnits %></td>
            <td class="num"><%= line.unitCost === null ? '—' : line.unitCost %></td>
            <td class="num"><%= line.lineTotal === null ? '—' : line.lineTotal.toFixed(2) %></td>
          </tr>
        <% }) %>
      </tbody>
      <tfoot>
        <tr>
          <td colspan="2"><strong>Total</strong></td>
          <td class="num"><strong><%= order.orderedUnits %></strong></td>
          <td class="num"><strong><%= order.receivedUnits %></strong></td>
          <td></td>
          <td class="num"><strong><%= order.hasCosts ? order.subtotal.toFixed(2) : '—' %></strong></td>
        </tr>
      </tfoot>
    </table>
  </div>
  <div class="card-foot">
    <div class="btn-row">
      <% if (['DRAFT', 'AWAITING_APPROVAL'].includes(order.status) && order.hasCosts && permissions.approve) { %>
        <form method="post" action="/purchasing/orders/<%= order.id %>/approve" data-busy>
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <input type="hidden" name="integrityHash" value="<%= order.integrityHash %>">
          <button class="btn btn--primary" type="submit">Approve order</button>
        </form>
      <% } %>
      <% if (order.isOpen && permissions.receive) { %>
        <%# The common case first: the delivery matches the order, so one button
            books the whole thing in. The form behind "Something is different"
            is for short, over or damaged deliveries. Foundry does not decide by
            itself that the boxes arrived — nobody has told it that — but once
            you say so it fills in everything it already knows. %>
        <%# One click only where one click can actually finish. A batch number or
            a list of serials is something only the person unpacking the boxes
            knows, so on those orders the button led straight to an error it
            could never not produce; they go to the form that asks instead. %>
        <% var needsArrivalDetail = (order.lines || []).some(function (line) {
             return line.outstandingUnits > 0 && (line.trackingMode === 'lot' || line.trackingMode === 'serial');
           });
           var futureExpected = typeof expectedInFuture !== 'undefined' && expectedInFuture; %>
        <% if (futureExpected) { %>
          <a class="btn btn--primary" href="/purchasing/orders/<%= order.id %>/receive">Report an early delivery</a>
          <span class="muted" style="font-size:12px;">Expected <%= order.expectedDate %>. Nothing is booked in until you report that it arrived.</span>
        <% } else if (needsArrivalDetail) { %>
          <a class="btn btn--primary" href="/purchasing/orders/<%= order.id %>/receive">Book in the delivery</a>
          <span class="muted" style="font-size:12px;">Foundry needs the batch or serial numbers that arrived — it cannot know those.</span>
        <% } else { %>
          <form method="post" action="/purchasing/orders/<%= order.id %>/receive-all" style="display:inline;" data-busy>
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <button class="btn btn--primary" type="submit">It all arrived — book it in</button>
          </form>
          <a class="btn" href="/purchasing/orders/<%= order.id %>/receive">Something is different</a>
        <% } %>
      <% } %>
      <a class="btn btn--sm" href="/purchasing/orders/<%= order.id %>/document" target="_blank" rel="noopener">
        Printable order
      </a>
      <% if (order.canCancel && permissions.approve) { %>
        <form method="post" action="/purchasing/orders/<%= order.id %>/cancel">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <input class="input input--sm" type="text" name="reason" placeholder="Why cancel?" maxlength="200">
          <button class="btn btn--ghost btn--sm" type="submit">Cancel order</button>
        </form>
      <% } %>
    </div>
    <% if (['DRAFT', 'AWAITING_APPROVAL'].includes(order.status)) { %>
      <p class="muted" style="margin-top:8px;">
        <% if (order.isEditable && !order.hasCosts) { %>
          Nothing has been sent to <%= order.supplierName %>. Add the missing price above before this order can be approved.
        <% } else { %>
          Nothing has been sent to <%= order.supplierName %> yet. Approving records the order and then follows
          this supplier's communication rule: send within approved authority, or wait for you to approve the message.
        <% } %>
      </p>
    <% } %>
  </div>
</div>

<% if (order.sourceDetail && order.sourceDetail.assumptions && order.sourceDetail.assumptions.length) { %>
  <div class="card section">
    <div class="card-head"><h2>What Foundry assumed</h2></div>
    <div class="card-body">
      <ul class="plain-list">
        <% order.sourceDetail.assumptions.forEach(function (line) { %><li><%= line %></li><% }) %>
      </ul>
    </div>
  </div>
<% } %>

<% if (receipts.length) { %>
  <div class="card section">
    <div class="card-head"><h2>Deliveries</h2></div>
    <div class="card-body">
      <% receipts.forEach(function (receipt) { %>
        <div class="act-ledger">
          <div class="act-row act-row--total">
            <span class="act-place">
              <%= helpers.dateTime(receipt.receivedAt) %>
              <% if (receipt.reference) { %> · <%= receipt.reference %><% } %>
              <% if (receipt.overReceiptApproved) { %> · <span class="is-warn">over-receipt accepted</span><% } %>
            </span>
            <span class="act-move"><span class="num">+<%= receipt.totalUnits %></span></span>
          </div>
          <% receipt.lines.forEach(function (line) { %>
            <div class="act-row">
              <span class="act-place">
                <%= line.displayName %> → <%= line.locationName %>
                <% if (line.lotCode) { %><span class="muted"> · lot <%= line.lotCode %></span><% } %>
                <% if (line.serials.length) { %><span class="muted"> · <%= line.serials.join(', ') %></span><% } %>
                <% if (line.overByUnits) { %><span class="is-warn"> · <%= line.overByUnits %> over</span><% } %>
              </span>
              <span class="act-move"><span class="num">+<%= line.quantityUnits %></span></span>
            </div>
          <% }) %>
        </div>
      <% }) %>
      <a class="btn btn--sm" href="/activity">See these in the activity ledger</a>
    </div>
  </div>
<% } %>

<div class="card section">
  <div class="card-head"><h2>What has happened to this order</h2></div>
  <div class="card-body">
    <ul class="plain-list">
      <% supplierDocuments.forEach(function(document) { %><li><strong><%= document.document_type.replaceAll('_', ' ') %> from <%= document.sender %></strong><span class="muted"><%= document.status === 'NEEDS_REVIEW' ? 'Needs your decision' : 'Matched to this order' %> · <%= helpers.dateTime(document.received_at) %></span></li><% }) %>
      <% events.forEach(function (event) { %>
        <li>
          <strong><%= event.event %></strong>
          <span class="muted"><%= event.actorName ? event.actorName + ' · ' : '' %><%= helpers.dateTime(event.createdAt) %></span>
        </li>
      <% }) %>
    </ul>
  </div>
</div>
