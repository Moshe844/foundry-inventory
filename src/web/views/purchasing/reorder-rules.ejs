<header class="page-head"><div><h1>Reorder settings</h1><p>Choose a product to review its limits, supplier terms and proposed reorder rule.</p></div></header><form method="get" action="/reorder-rules" role="search"><label class="field"><span>Find a product or SKU</span><input class="input" type="search" name="q" value="<%= q %>" autofocus></label><button class="btn" type="submit">Search</button></form><section class="card"><div class="card-body"><% if(!rows.length){ %><p>No products match this search.</p><% } %><% for(const row of rows){ %><p><a href="/purchasing/why/<%= encodeURIComponent(row.id) %>"><%= row.name %> · <%= row.code %></a></p><% } %><p class="hint">Showing up to 50 matches. Search to narrow the list.</p></div></section>
