<div class="page-head"><div>
  <a class="back-link" href="/inventory/<%= sku.item_id %>">Back to <%= sku.product %></a>
  <h1>Reorder settings · <%= sku.product %></h1>
  <p class="lede"><%= sku.code %> · Settings saved in this inventory, shown separately for each location.</p>
</div></div>

<section class="card"><div class="card-head"><h2>Current stock</h2></div><div class="card-body">
  <% if(!positions.length){ %><p>No physical stock positions have been recorded for this SKU.</p><% } else { %>
  <table><thead><tr><th>Location</th><th>On hand</th></tr></thead><tbody>
    <% positions.forEach(function(row){ %><tr><td><%= row.location_name %></td><td><%= row.on_hand %></td></tr><% }) %>
  </tbody></table><% } %>
</div></section>
<% if(locals.canManage){ %><section class="card"><div class="card-head"><h2>Change reorder settings</h2></div><div class="card-body">
<form method="post" action="/purchasing/why/<%= sku.id %>/propose" class="stack-form"><input type="hidden" name="_csrf" value="<%= csrfToken %>">
<label class="field"><span>Location</span><select class="select" name="locationId"><option value="">All locations</option><% locations.forEach(function(l){ %><option value="<%= l.id %>"><%= l.name %></option><% }); %></select></label>
<label class="field"><span>Reorder when stock reaches</span><input class="input" name="reorderPoint" type="number" min="0" step="1"></label>
<label class="field"><span>Order up to this stock level</span><input class="input" name="targetStock" type="number" min="0" step="1"></label>
<label class="field"><span>Safety stock</span><input class="input" name="safetyStock" type="number" min="0" step="1"></label>
<p>Blank fields keep their existing setting. Review the exact proposal next; saving a reorder rule does not authorize purchases or email.</p><button class="btn btn--primary" type="submit">Review reorder settings</button></form>
</div></section><% } %>

<section class="card"><div class="card-head"><h2>Approved reorder rules</h2></div><div class="card-body">
  <% if(!policies.length){ %><p>No reorder point or target is set for this SKU.</p><% } else { %>
  <table><thead><tr><th>Scope</th><th>Reorder at</th><th>Target</th><th>Safety stock</th><th>Source</th></tr></thead><tbody>
    <% policies.forEach(function(row){ %><tr><td><%= row.location_name %></td>
      <td><%= row.reorder_point===null?'—':row.reorder_point %></td>
      <td><%= row.target_stock===null?'—':row.target_stock %></td>
      <td><%= row.safety_stock===null?'—':row.safety_stock %></td>
      <td><%= row.source||'Recorded setting' %></td></tr><% }) %>
  </tbody></table><% } %>
  <p>These levels identify replenishment needs. They do not authorize an automatic purchase or send an email.</p>
</div></section>

<section class="card"><div class="card-head"><h2>Linked suppliers</h2></div><div class="card-body">
  <% if(!suppliers.length){ %><p>No active supplier is linked to this SKU.</p><% } else { %>
  <ul><% suppliers.forEach(function(row){ %><li><%= row.supplier_name %><% if(row.lead_time_days!=null){ %> · <%= row.lead_time_days %>-day lead time<% } %><% if(row.minimum_order_quantity!=null){ %> · minimum <%= row.minimum_order_quantity %><% } %></li><% }) %></ul><% } %>
  <a class="button button--secondary" href="/ask?from=<%= encodeURIComponent('/inventory/'+sku.item_id) %>&amp;about=<%= encodeURIComponent(sku.product) %>">Ask StockChief to change a rule</a>
</div></section>
