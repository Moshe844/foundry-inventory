<link rel="stylesheet" href="/orders-ui.css?v=<%= assetVersion %>">
<div class="ox ox-buy ox-narrow" data-ox-page="reorder-settings">
  <header class="ox-head">
    <div>
      <a class="ox-back" href="/purchasing"><span aria-hidden="true">←</span> What to order</a>
      <h1 class="ox-title">Reorder settings · <%= sku.product %></h1>
      <p class="ox-sub"><%= sku.code %> · <a href="/inventory/<%= sku.item_id %>">Open the product</a></p>
    </div>
  </header>

  <% if (locals.canManage) { %>
  <form method="post" action="/purchasing/why/<%= sku.id %>/propose" class="ox-card ox-card__b ox-formcard">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <h2 class="ox-h2">Change the levels</h2>
    <label class="ox-field ox-field--half"><span>Location</span><select name="locationId"><option value="">All locations</option><% locations.forEach(function (l) { %><option value="<%= l.id %>"><%= l.name %></option><% }) %></select></label>
    <div class="ox-grid3">
      <label class="ox-field"><span>Reorder when stock reaches</span><input name="reorderPoint" type="number" min="0" step="1" inputmode="numeric"></label>
      <label class="ox-field"><span>Order up to</span><input name="targetStock" type="number" min="0" step="1" inputmode="numeric"></label>
      <label class="ox-field"><span>Safety stock</span><input name="safetyStock" type="number" min="0" step="1" inputmode="numeric"></label>
    </div>
    <p class="ox-fine ox-fine--flush">Leave a box empty to keep the current value.</p>
    <div class="ox-formcard__f"><button class="ox-btn ox-btn--primary" type="submit">Review reorder settings</button></div>
  </form>
  <% } %>

  <section class="ox-card ox-list" aria-labelledby="ox-h-rules">
    <div class="ox-card__h"><h2 id="ox-h-rules">Current levels</h2></div>
    <% if (!policies.length) { %><p class="ox-empty-line" style="margin:12px 20px 20px">No reorder level is set for this product yet.</p>
    <% } else { %>
    <table class="ox-table" data-preserve-grid style="margin-top:12px"><thead><tr><th scope="col">Where</th><th scope="col" class="ox-c">Reorder at</th><th scope="col" class="ox-c">Order up to</th><th scope="col" class="ox-c">Safety</th></tr></thead><tbody>
      <% policies.forEach(function (row) { %><tr><td><%= row.location_name %></td><td class="ox-c ox-num"><%= row.reorder_point === null ? '—' : row.reorder_point %></td><td class="ox-c ox-num"><%= row.target_stock === null ? '—' : row.target_stock %></td><td class="ox-c ox-num"><%= row.safety_stock === null ? '—' : row.safety_stock %></td></tr><% }) %>
    </tbody></table>
    <% } %>
  </section>

  <div class="ox-grid2 ox-grid2--cards">
    <section class="ox-card ox-card__b" aria-labelledby="ox-h-stock"><h2 id="ox-h-stock" class="ox-h2">In stock</h2>
      <% if (!positions.length) { %><p class="ox-muted ox-small">No stock recorded yet.</p><% } else { %><dl class="ox-kv"><% positions.forEach(function (row) { %><dt><%= row.location_name %></dt><dd class="ox-num"><%= row.on_hand %></dd><% }) %></dl><% } %>
    </section>
    <section class="ox-card ox-card__b" aria-labelledby="ox-h-bought"><h2 id="ox-h-bought" class="ox-h2">Bought from</h2>
      <% if (!suppliers.length) { %><p class="ox-muted ox-small">No supplier linked. <a href="/purchasing/supplier-for/<%= sku.id %>">Link a supplier</a></p><% } else { %><ul class="ox-plain"><% suppliers.forEach(function (row) { %><li><%= row.supplier_name %><span class="ox-muted"><% if (row.lead_time_days != null) { %> · <%= row.lead_time_days %> days<% } %><% if (row.minimum_order_quantity != null) { %> · min <%= row.minimum_order_quantity %><% } %></span></li><% }) %></ul><% } %>
    </section>
  </div>
</div>
