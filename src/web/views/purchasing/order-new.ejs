<% var chosen = supplierId ? suppliers.find(function (s) { return s.id === supplierId; }) : null; %>
<div class="page-head">
  <div class="titles">
    <a class="back-link" href="/purchasing/orders"><%- helpers.icon('chevron', { size: 14 }) %> Purchases</a>
    <h1><% if (chosen) { %>New order from <%= chosen.name %><% } else { %>New purchase order<% } %></h1>
    <div class="page-sub">
      <% if (chosen) { %>
        Step 2 of 2 · <a href="/purchasing/orders/new">Different supplier</a><%
        %><% if (chosen.defaultLeadTimeDays !== null && chosen.defaultLeadTimeDays !== undefined) { %> · usually <%= chosen.defaultLeadTimeDays %> days<% } %><%
        %><% if (chosen.paymentTerms) { %> · <%= chosen.paymentTerms %><% } %>.
        Saved as a draft: nothing reaches <%= chosen.name %> until you approve it.
      <% } else { %>
        Step 1 of 2 · pick who you are buying from. StockChief can also prepare one for you from what is running low.
      <% } %>
    </div>
  </div>
</div>

<% if (!supplierId) { %>
  <div class="card section">
    <div class="card-head"><h2>Which supplier?</h2></div>
    <div class="card-body">
      <% if (suppliers.length === 0) { %>
        <p class="muted">No suppliers yet. <a href="/suppliers">Add one first.</a></p>
      <% } else { %>
        <div class="list-rows">
          <% suppliers.forEach(function (supplier) { %>
            <a class="list-row" href="/purchasing/orders/new?supplier=<%= supplier.id %>">
              <span class="cell-main">
                <span class="cell-title"><%= supplier.name %></span>
                <span class="cell-sub"><%= supplier.contactName || supplier.email || 'No contact on file' %><% if (supplier.defaultLeadTimeDays !== null && supplier.defaultLeadTimeDays !== undefined) { %> · usually <%= supplier.defaultLeadTimeDays %> days<% } %></span>
              </span>
              <span class="btn btn--sm">Choose</span>
            </a>
          <% }) %>
        </div>
      <% } %>
    </div>
  </div>
<% } else { %>
  <form method="post" action="/purchasing/orders" class="card section" data-purchase-entry data-currency="<%= chosen.currency||'USD' %>" data-currency-exponent="<%= helpers.currencyExponent?helpers.currencyExponent(chosen.currency||'USD'):2 %>" data-today="<%= locals.today||helpers.dateInputValue(new Date()) %>" data-busy>
    <div class="card-head"><div><h2>What to order</h2><p class="muted">Only lines with a quantity go on the order.</p></div></div>
    <div class="card-body">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <input type="hidden" name="supplierId" value="<%= supplierId %>"><input type="hidden" name="expectedDateAuto" value="<%= submitted?.expectedDateAuto ?? '1' %>">

      <% if (orderErrors && orderErrors.length) { %>
        <div class="notice notice--warn" role="alert"><div><strong>This order is missing information</strong><% orderErrors.forEach(function(error) { %><p><%= error %></p><% }) %></div></div>
      <% } %>

      <% if (supplierItems.length === 0) { %>
        <p class="muted">
          Nothing is linked to this supplier yet. <a href="/suppliers/<%= supplierId %>">Link some products</a>
          so StockChief knows the pack size and price.
        </p>
      <% } else { %>
        <p class="muted" style="margin-bottom:12px;">These are the products linked to this supplier. Enter a pack quantity for each product you want to order. <a href="/suppliers/<%= supplierId %>#link-product">Link another product</a>.</p>
        <table class="table table--tight">
          <thead><tr><th>Product</th><th>Pack</th><th class="num">Unit cost</th><th class="num">How many packs</th><th class="num">Line total</th></tr></thead>
          <tbody>
            <% supplierItems.forEach(function (item) { %>
              <tr data-purchase-line data-pack-units="<%= item.unitsPerPurchaseUnit||1 %>" data-lead-days="<%= item.leadTimeDays??'' %>">
                <td><%= item.displayName %><% if (item.supplierSku) { %> <span class="muted"><%= item.supplierSku %></span><% } %></td>
                <td><%= item.unitsPerPurchaseUnit > 1 ? item.purchaseUnit + ' of ' + item.unitsPerPurchaseUnit : item.purchaseUnit %></td>
                <td class="num">
                  <label class="sr-only" for="unit-cost-<%= item.skuId %>">Unit cost for <%= item.displayName %></label>
                  <span><%= chosen.currency==='USD'?'$':chosen.currency %></span> <input class="input input--sm" id="unit-cost-<%= item.skuId %>" type="number" min="0" step="0.01"
                         name="unitCost[<%= item.skuId %>]" style="max-width:120px;"
                         value="<%= submitted && submitted.unitCost && submitted.unitCost[item.skuId] !== undefined ? submitted.unitCost[item.skuId] : item.lastUnitCost == null ? '' : Number(item.lastUnitCost).toFixed(2) %>"
                         placeholder="Required if unknown">
                </td>
                <td class="num">
                  <input class="input input--sm" type="number" min="0" step="any" aria-label="Packs of <%= item.displayName %>" name="quantity[<%= item.skuId %>]" style="max-width:110px;"
                         value="<%= submitted && submitted.quantity && submitted.quantity[item.skuId] !== undefined ? submitted.quantity[item.skuId] : '' %>"><input name="secondaryQuantity[<%= item.skuId %>]" inputmode="decimal" aria-label="Actual weight for <%= item.displayName %>" placeholder="Actual weight if also weighed" value="<%= submitted?.secondaryQuantity?.[item.skuId]||'' %>">
                </td>
                <td class="num" data-line-total>—</td>
              </tr>
            <% }) %>
          </tbody>
        </table><p class="right" role="status">Subtotal: <strong data-purchase-total>—</strong></p>

        <div class="grid grid--2">
          <label class="field">
            <span class="field-label">Deliver to</span>
            <select class="input" name="destinationLocationId">
              <% locations.forEach(function (location) { %>
                <option value="<%= location.id %>" <%= submitted?.destinationLocationId===location.id?'selected':'' %>><%= location.name %></option>
              <% }) %>
            </select>
          </label>
          <label class="field">
            <span class="field-label">Expected date</span>
            <input class="input" type="date" name="expectedDate" value="<%= submitted?.expectedDate ?? locals.expectedDate ?? '' %>">
            <span class="field-help">Leave blank and StockChief works it out from the lead time.</span>
          </label>
        </div>
        <label class="checkbox"><input type="checkbox" name="confirmZeroCost" value="1" <%= submitted?.confirmZeroCost==='1'?'checked':'' %>> I confirm selected $0 lines are free of charge.</label>
        <label class="field">
          <span class="field-label">Notes for this order</span>
          <input class="input" type="text" name="notes" maxlength="300" value="<%= submitted?.notes||'' %>">
        </label>
      <% } %>
    </div>
    <% if (supplierItems.length) { %>
      <div class="card-foot"><button class="btn btn--primary" type="submit">Create draft order</button> <a class="btn btn--ghost" href="/purchasing/orders">Cancel</a></div>
    <% } %>
  </form>
<% } %>

<script src="/purchase-entry.js?v=<%= assetVersion %>" defer></script>
