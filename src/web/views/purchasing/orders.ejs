<%
  /*
   * Purchases, as a list of stories.
   *
   * Same shape as customer orders, because they are the same kind of thing:
   * one line each, saying who and what is waiting on whom, ordered by whether
   * anybody is waiting. The table this replaced sorted by creation date and
   * printed the stored status enum, which answers neither question.
   */
  var today = new Date().toISOString().slice(0, 10);
  var open = orders.filter(function (o) { return o.isOpen; });
  var closed = orders.filter(function (o) { return !o.isOpen; });
  var late = open.filter(function (o) { return o.expectedDate && o.expectedDate < today && o.outstandingUnits > 0; });
  var waiting = open.filter(function (o) { return ['DRAFT', 'AWAITING_APPROVAL'].includes(o.status); });

  var SAYS = {
    DRAFT: 'a draft — the supplier has not been told anything',
    AWAITING_APPROVAL: 'ready to send, and waiting on you',
    APPROVED: 'approved and ready to go to the supplier',
    ORDERED: 'with the supplier',
    PARTIALLY_RECEIVED: 'part of it arrived',
    RECEIVED: 'all of it arrived',
    CANCELLED: 'cancelled',
  };
%>

<p class="rm-stamp"><%= open.length %> open · <%= closed.length %> closed</p>
<h1 class="rm-figure">
  <% if (late.length) { %>
    <%= late.length %> purchase<%= late.length === 1 ? '' : 's' %> should have arrived by now.
  <% } else if (waiting.length) { %>
    <%= waiting.length %> purchase<%= waiting.length === 1 ? ' is' : 's are' %> waiting on you.
  <% } else if (open.length) { %>
    <%= open.length %> purchase<%= open.length === 1 ? ' is' : 's are' %> on their way.
  <% } else { %>
    Nothing is on order.
  <% } %>
</h1>
<p class="rm-sub">
  <% if (!orders.length) { %>
    Foundry prepares these when stock falls below where you want it. Nothing is ever sent to a
    supplier without your approval, unless you have given it a limit you are happy with.
  <% } else { %>
    Each of these is a story: why it exists, who was told what, when it arrives and what it costs.
  <% } %>
</p>

<% if (open.length) { %>
  <div class="rm-told">
    <% open.forEach(function (order) { %>
      <div class="rm-told__row">
        <span class="rm-told__t">
          <a class="rm-u" href="/purchasing/orders/<%= order.id %>"><%= order.supplierName %></a>
          <span class="rm-quiet">· <%= order.poNumber %></span>
          <small>
            <%= SAYS[order.status] || order.status %><%
            %><% if (order.expectedDate && order.outstandingUnits) { %>
              — <%= order.expectedDate < today ? 'was due' : 'due' %> <%= helpers.shortDate(order.expectedDate) %><%
            %><% } else if (order.outstandingUnits && order.status === 'ORDERED') { %>
              — nobody has said when<%
            %><% } %>
          </small>
        </span>
        <span class="rm-told__m <%= order.expectedDate && order.expectedDate < today && order.outstandingUnits ? 'is-paused' : '' %>">
          <%= order.outstandingUnits || order.orderedUnits %> units
          <% if (order.subtotal) { %>· $<%= Math.round(order.subtotal).toLocaleString('en-US') %><% } %>
        </span>
      </div>
    <% }) %>
  </div>
<% } %>

<% if (closed.length) { %>
  <p class="rm-stamp">Closed · <%= closed.length %></p>
  <div class="rm-told">
    <% closed.slice(0, 8).forEach(function (order) { %>
      <div class="rm-told__row">
        <span class="rm-told__t rm-quiet"><a class="rm-u" href="/purchasing/orders/<%= order.id %>"><%= order.supplierName %></a> · <%= order.poNumber %></span>
        <span class="rm-told__m <%= order.status === 'RECEIVED' ? 'is-ok' : '' %>"><%= SAYS[order.status] || order.status %></span>
      </div>
    <% }) %>
  </div>
<% } %>

<p class="rm-disclose">
  <a href="/purchasing">What needs buying</a>
  <% if (permissions.create) { %><a href="/purchasing/orders/new">Write a purchase order</a><% } %>
  <a href="/purchasing/receive">Book in a delivery</a>
  <a href="/suppliers">Suppliers and their terms</a>
</p>
