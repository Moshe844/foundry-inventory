<a class="back-link" href="/purchasing">‹ What to order</a><h1>Link a supplier</h1><p><strong><%= sku.name %><%= sku.variant_label?' — '+sku.variant_label:'' %></strong> · <%= sku.code %></p>
<form method="get"><label>Search suppliers <input name="q" value="<%= supplierQuery %>" maxlength="120"></label><button class="btn">Search</button></form>
<form method="post" action="/purchasing/supplier-for/<%= sku.id %>" class="stacked-form"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><label>Supplier<select name="supplierId" required><option value="">Choose a supplier</option><% for(const s of suppliers){ %><option value="<%= s.id %>"><%= s.name %></option><% } %></select></label><p>Up to 50 matching suppliers shown. Search to find another supplier, or <a href="/suppliers/new">add a supplier</a>.</p>
<label>Purchase unit <input name="purchaseUnit" value="unit" maxlength="40" required></label><label>Stock units in each purchase unit <input name="unitsPerPurchaseUnit" value="1" inputmode="decimal" required></label><p>For a case of 12, enter 12. Cost below is per stock unit.</p><label>Supplier cost per stock unit <input name="lastUnitCost" inputmode="decimal"></label><button class="btn btn--primary">Save supplier link</button></form><a href="/inventory/<%= sku.item_id %>#variant-editor">Edit suppliers for several variants together</a>
