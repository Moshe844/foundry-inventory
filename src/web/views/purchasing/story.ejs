<%
  /*
   * A purchase, end to end, told by the same component that tells an order.
   *
   * Need, supplier choice, the purchase order, the email that carried it, the
   * acknowledgement, the delivery, the invoice and the payment are one story.
   * That they are five services and four tables underneath is not something
   * the owner should have to know, and it was the whole reason purchasing felt
   * like a department to operate rather than something StockChief runs.
   *
   * One component, two subjects, is also the practical answer to a hundred and
   * eleven templates: build the spine once and every business event has a page.
   */
  var bills = locals.supplierBills || [];
  var summary = locals.billSummary || {};

  /*
   * The two balances, side by side.
   *
   * Goods and money on a purchase move independently and StockChief never lets
   * one imply the other: a partial delivery changes what is still expected, a
   * partial payment changes what is still owed, and neither ever touches the
   * other. That rule is enforced in the engine, and this is where the owner
   * can see it holding — which is why it stayed on the story rather than
   * going behind the detail link with the line costs.
   */
  var moneyStatus = !bills.length ? 'Waiting for supplier invoice'
    : summary.needsReview ? 'Invoice needs review'
    : summary.owedMinor === 0 ? 'Paid'
    : summary.paidMinor > 0 ? 'Partially paid' : 'Unpaid';
  var supplierMessage = (locals.communications || [])[0] || null;
  var sentToSupplier = (locals.communications || []).some(function (message) { return message.status === 'SENT'; });
%>

<a class="rm-head__back" href="/purchasing/orders"><span aria-hidden="true">←</span> Purchases</a>
<%- include('../partials/spine', { story: story }) %>

<% var supplierPlan = (locals.supplierResponsePlans || [])[0] || null; %>
<% if (supplierPlan) { %>
  <section class="supplier-response" style="margin-top:20px">
    <div class="supplier-response__head">
      <span class="rm-kicker">StockChief worked out the consequence</span>
      <span class="badge <%= supplierPlan.status === 'NEEDS_APPROVAL' ? 'badge--warning' : '' %>"><%= supplierPlan.status.replaceAll('_',' ').toLowerCase() %></span>
    </div>
    <h2><%= supplierPlan.summary %></h2>
    <% if (supplierPlan.consequences.atRiskUnits) { %>
      <p><strong><%= supplierPlan.consequences.atRiskUnits %> committed units are at risk.</strong> StockChief compared stock already owned, alternate supply, waiting and purchasing before proposing a response.</p>
    <% } else { %>
      <p>No stock or money was changed by the supplier message. StockChief is watching the evidenced quantity, date and cost.</p>
    <% } %>
    <% if (supplierPlan.status === 'NEEDS_APPROVAL') { %>
      <a class="rm-btn" href="/needs-you">Review the one decision</a>
    <% } %>
    <details class="disclose">
      <summary>Why StockChief decided this · compare <%= supplierPlan.alternatives.length %> options</summary>
      <div class="disclose__body">
        <% supplierPlan.alternatives.forEach(function(option) { %>
          <p><strong><%= option.type.replaceAll('_',' ') %></strong> — <%= option.explanation || (option.feasible ? 'Possible' : 'Not currently possible') %></p>
        <% }) %>
        <p class="rm-sub">Supplier communication and purchasing approval remain separate. A message cannot receive stock, place an order or post money.</p>
      </div>
    </details>
  </section>
<% } %>

<% if (['DRAFT', 'AWAITING_APPROVAL'].includes(order.status) && order.hasCosts && permissions.approve) { %>
  <div class="rm-decision" style="margin-top:20px">
    <span class="rm-decision__arrow" aria-hidden="true">→</span>
    <span class="rm-decision__txt">
      Ready for your approval.
      <small><%= order.orderedUnits %> units from <%= order.supplierName %> for <%= helpers.money(Math.round(order.subtotal * 100), order.currency) %>. Nothing has been sent yet.</small>
    </span>
    <span class="rm-decision__go">
      <form method="post" action="/purchasing/orders/<%= order.id %>/approve" data-busy>
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <input type="hidden" name="integrityHash" value="<%= order.integrityHash %>">
        <button class="rm-btn" type="submit">Approve order</button>
      </form>
    </span>
  </div>
<% } %>

<% if (order.isEditable && !order.hasCosts) { %>
  <section class="rm-panel" style="margin-top:20px">
    <div class="rm-panel__head"><h2>Next: add the missing purchase prices</h2></div>
    <div style="padding:18px 20px">
      <p>No price was supplied for one or more lines. StockChief will not guess a price or send an incomplete order.</p>
      <a class="rm-btn" href="/purchasing/orders/<%= order.id %>/detail">Add prices and review my PO</a>
      <p class="rm-sub">The next screen shows the exact items, costs and total for your approval. This draft adds no stock; inventory changes only when goods are received.</p>
    </div>
  </section>
<% } %>

<% if (order.status === 'ORDERED' && !sentToSupplier && supplierMessage) { %>
  <div class="rm-decision" style="margin-top:20px">
    <span class="rm-decision__arrow" aria-hidden="true">→</span>
    <span class="rm-decision__txt">
      This order has not reached <%= order.supplierName %>.
      <small><% if (!supplierMessage.recipient) { %>StockChief needs the supplier's email address; it will not pretend an internal approval was a sent order.<% } else if (!supplierMessage.connectorId) { %>StockChief needs the mailbox it should send from.<% } else { %>The message is prepared and needs permission to send.<% } %></small>
    </span>
    <span class="rm-decision__go">
      <% if (!supplierMessage.recipient || !supplierMessage.connectorId) { %>
        <a class="rm-btn" href="/suppliers/<%= order.supplierId %>"><%= !supplierMessage.recipient ? 'Add supplier email' : 'Choose sending mailbox' %></a>
      <% } else if (permissions.approve) { %>
        <form method="post" action="/purchasing/orders/<%= order.id %>/send" data-busy>
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <button class="rm-btn" type="submit">Send order</button>
        </form>
      <% } %>
    </span>
  </div>
<% } %>

<% if (locals.evidenceTrace) { %>
  <details class="rm-work" style="margin-top:24px">
    <summary>See how this purchase is connected</summary>
    <div class="rm-work__body">
      <p style="margin-top:0"><%= evidenceTrace.ownerSummary %></p>
      <div class="accounting-next-list">
        <% evidenceTrace.ownerSteps.forEach(function (step, index) { %>
          <p>
            <strong><%= index + 1 %>. <%= step.label %></strong><br>
            <span><%= step.text %></span>
            <% if (step.href) { %> <a href="<%= step.href %>"><%= step.linkText %></a>.<% } %>
          </p>
        <% }) %>
      </div>
      <% evidenceTrace.unknown.forEach(function (gap) { %><p class="rm-sub"><%= gap %></p><% }) %>
      <details class="disclose" style="margin-top:16px">
        <summary>Advanced evidence records</summary>
        <div class="disclose__body">
          <p class="rm-sub">These are the immutable record links StockChief used. They are for audit and troubleshooting, not for reading the purchase day to day.</p>
          <% evidenceTrace.details.forEach(function (link) { %>
            <p class="rm-sub">
              <% if (link.from.href) { %><a href="<%= link.from.href %>"><%= link.from.title %></a><% } else { %><%= link.from.title %><% } %>
              <%= link.phrase %>
              <% if (link.to.href) { %><a href="<%= link.to.href %>"><%= link.to.title %></a><% } else { %><%= link.to.title %><% } %>.
            </p>
          <% }) %>
        </div>
      </details>
    </div>
  </details>
<% } %>

<%
  var today = new Date().toISOString().slice(0, 10);
  var isLate = order.isOpen && order.outstandingUnits > 0 && order.expectedDate && order.expectedDate < today;
  var needsArrivalDetail = (order.lines || []).some(function (line) {
    return line.outstandingUnits > 0 && (line.trackingMode === 'lot' || line.trackingMode === 'serial');
  });
%>
<% if (order.isOpen && order.outstandingUnits > 0 && permissions.receive) { %>
  <div class="rm-decision<%= isLate ? '' : ' rm-decision--calm' %>" style="margin-top:20px">
    <span class="rm-decision__arrow" aria-hidden="true">→</span>
    <span class="rm-decision__txt">
      <% if (isLate) { %>
        <%= order.outstandingUnits %> units should have arrived by <%= helpers.shortDate(order.expectedDate) %>.
        <small>Nothing is booked in until you say it arrived. If it has, one click does it; if it is late, <%= order.supplierName %> has not said why.</small>
      <% } else if (order.expectedDate) { %>
        <%= order.outstandingUnits %> units are due <%= helpers.shortDate(order.expectedDate) %>.
        <small>When the boxes turn up, book them in here. Stock changes only for what you count.</small>
      <% } else { %>
        <%= order.outstandingUnits %> units are still to come; nobody has said when.
        <small>When the boxes turn up, book them in here. Stock changes only for what you count.</small>
      <% } %>
    </span>
    <span class="rm-decision__go rm-decision__go--pair">
      <% if (needsArrivalDetail) { %>
        <a class="rm-btn" href="/purchasing/orders/<%= order.id %>/receive">Book in the delivery</a>
      <% } else { %>
        <form method="post" action="/purchasing/orders/<%= order.id %>/receive-all" data-busy>
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <button class="rm-btn" type="submit">It all arrived — book it in</button>
        </form>
        <a class="rm-btn rm-btn--wash" href="/purchasing/orders/<%= order.id %>/receive">Only some of it</a>
      <% } %>
    </span>
  </div>
<% } %>

<% if (order.receivedUnits > 0 && !bills.length && permissions.payments) { %>
  <div class="rm-decision rm-decision--calm" style="margin-top:20px">
    <span class="rm-decision__arrow" aria-hidden="true">→</span>
    <span class="rm-decision__txt">
      No invoice from <%= order.supplierName %> yet.
      <small>Stock is in, but nothing is owed until their invoice is recorded. StockChief fills it in from this order.</small>
    </span>
    <span class="rm-decision__go"><a class="rm-btn rm-btn--wash" href="/accounting/payables/new?purchaseOrderId=<%= order.id %>">Record their invoice</a></span>
  </div>
<% } %>

<%# What is actually on the order, always in view. Approving or chasing a
    purchase without seeing its lines was the one thing this page hid. %>
<p class="rm-stamp" style="margin-top:34px">What is on it</p>
<div class="table-wrap rm-lines">
  <table class="table table--stack">
    <thead><tr>
      <th>Product</th>
      <th class="num">Ordered</th>
      <th class="num">Received</th>
      <th class="num">Unit cost</th>
      <th class="num">Total</th>
    </tr></thead>
    <tbody>
      <% (order.lines || []).forEach(function (line) { %>
        <tr>
          <td data-label="Product">
            <div class="cell-main">
              <span class="cell-title"><%= line.displayName %></span>
              <span class="cell-sub"><% if (line.supplierSku) { %><span class="mono"><%= line.supplierSku %></span> · <% } %><% if (line.unitsPerPurchaseUnit > 1) { %><%= line.quantityPurchaseUnits %> <%= line.purchaseUnit %><%= line.quantityPurchaseUnits === 1 ? '' : 's' %> of <%= line.unitsPerPurchaseUnit %> · <% } %><%= line.destinationLocationName || '' %></span>
            </div>
          </td>
          <td class="num" data-label="Ordered"><%= line.quantityUnits %></td>
          <td class="num" data-label="Received"><% if (line.quantityReceivedUnits >= line.quantityUnits) { %><span class="badge badge--ok"><%= line.quantityReceivedUnits %></span><% } else if (line.quantityReceivedUnits > 0) { %><span class="badge badge--warn"><%= line.quantityReceivedUnits %> of <%= line.quantityUnits %></span><% } else { %><span class="rm-quiet">0</span><% } %></td>
          <td class="num" data-label="Unit cost"><% if (line.unitCost != null) { %><%= helpers.money(Math.round(line.unitCost * 100), order.currency) %><% } else { %><span class="badge badge--warn">no price</span><% } %></td>
          <td class="num" data-label="Total"><% if (line.lineTotal != null) { %><%= helpers.money(Math.round(line.lineTotal * 100), order.currency) %><% } else { %>—<% } %></td>
        </tr>
      <% }) %>
    </tbody>
    <tfoot><tr>
      <td colspan="4" class="num"><strong><%= order.orderedUnits %> units</strong> · <%= (order.lines || []).length %> line<%= (order.lines || []).length === 1 ? '' : 's' %></td>
      <td class="num"><strong><%= helpers.money(Math.round((order.subtotal || 0) * 100), order.currency) %></strong></td>
    </tr></tfoot>
  </table>
</div>

<p class="rm-stamp" style="margin-top:34px">Delivery and payment are tracked separately</p>
<div class="rm-ledger" style="margin-bottom:24px">
  <div class="rm-ledger__row">
    <span class="rm-ledger__k">Goods</span>
    <span class="rm-ledger__v">Ordered <%= order.orderedUnits %> units</span>
    <span class="rm-ledger__n">
      Received <%= order.receivedUnits %> units ·
      Still expected <%= order.outstandingUnits %> units
    </span>
  </div>
  <div class="rm-ledger__row">
    <span class="rm-ledger__k">Money</span>
    <span class="rm-ledger__v">Supplier invoices received <%= helpers.money(summary.invoiceTotalMinor || 0, order.currency) %></span>
    <span class="rm-ledger__n<%= summary.needsReview ? ' is-warn' : '' %>">
      Paid <%= helpers.money(summary.paidMinor || 0, order.currency) %> ·
      Still owed <%= helpers.money(summary.owedMinor || 0, order.currency) %> ·
      <%= moneyStatus %>
    </span>
  </div>
</div>
<p class="rm-sub" style="font-size:16px">
  Receiving products changes inventory. A supplier invoice creates the bill. A payment reduces only
  the bill. I wait for evidence of each and never treat an invoice as a delivery, or a delivery as
  a payment.
</p>

<% var awaitingLandedCostApproval = (landedCostDocuments || []).find(function (document) {
  return document.status === 'DRAFT' || document.status === 'APPROVED';
}); %>
<% if (awaitingLandedCostApproval) { %>
  <div class="rm-decision" style="margin-top:20px">
    <span class="rm-decision__arrow" aria-hidden="true">→</span>
    <span class="rm-decision__txt">
      StockChief prepared the documented landed-cost split.
      <small>It is based on the supplier bill and goods actually received. Review it before it changes inventory value.</small>
    </span>
    <span class="rm-decision__go"><a class="rm-btn" href="/purchasing/orders/<%= order.id %>/landed-costs/<%= awaitingLandedCostApproval.id %>">Review split</a></span>
  </div>
<% } %>

<% if (summary.needsReview) { %>
  <div class="rm-decision" style="margin-top:30px">
    <span class="rm-decision__arrow" aria-hidden="true">→</span>
    <span class="rm-decision__txt">
      An invoice on this order needs looking at.
      <small>It does not agree with what was ordered or what arrived, so I have not posted it as final.</small>
    </span>
    <span class="rm-decision__go"><a class="rm-btn" href="/purchasing/orders/<%= order.id %>/detail#bills">Look at it</a></span>
  </div>
<% } %>

<div class="rm-spine-foot">
  <a class="rm-btn rm-btn--ghost" href="/ask?about=<%= encodeURIComponent(order.poNumber + ' from ' + order.supplierName) %>">Ask about this purchase</a>
  <% if ((locals.receipts || []).length && permissions.landedCosts) { %>
    <a class="rm-btn rm-btn--wash" href="/purchasing/orders/<%= order.id %>/landed-costs"><%= awaitingLandedCostApproval ? 'Review landed-cost draft' : 'Add freight, duty or handling' %></a>
  <% } %>
  <% if (order.isEditable) { %><a class="rm-btn rm-btn--wash" href="/purchasing/orders/<%= order.id %>/detail">Edit lines and prices</a><% } %>
</div>

<%# The working page, on the same page, one disclosure down. Same reasoning as
    a customer order: understanding it and acting on it must not be two
    addresses. /purchasing/orders/:id/detail renders it on its own. %>
<details class="rm-work" id="working">
  <summary>Receipts, invoices, documents and the full working record</summary>
  <div class="rm-work__body"><%- include('order') %></div>
</details>

<p class="rm-disclose">
  <a href="/suppliers/<%= order.supplierId %>">Everything from <%= order.supplierName %></a>
  <a href="/purchasing/orders/<%= order.id %>/document">The purchase order as the supplier sees it</a>
  <% if (bills.length) { %><a href="/money">What you owe</a><% } %>
  <a href="/purchasing/orders">Other purchases</a>
</p>
