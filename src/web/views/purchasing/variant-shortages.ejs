<p>Current availability includes reservations and incoming orders. Review a shortage before preparing an order; nothing on this page places an order.</p>
<form method="get" action="/purchasing"><label>Search products, variants or SKUs <input name="q" value="<%= reorderOverview.q %>" maxlength="120"></label><button class="btn">Search</button></form>
<% if(reorderOverview.rows.length){ %><div class="table-wrap"><table class="table"><thead><tr><th>Item / variant</th><th>Location</th><th>Available</th><th>Incoming</th><th>Reorder at</th><th>Needed</th><th>Supplier</th><th>Action</th></tr></thead><tbody>
<% for(const line of reorderOverview.rows){ %><tr><td><a href="/inventory/<%= line.item_id %>#sku-<%= line.sku_id %>"><%= line.displayName %></a><small><%= line.code %></small></td><td><%= line.location_name %></td><td><%= helpers.qty(line.available) %></td><td><%= helpers.qty(line.incoming) %></td><td><%= helpers.qty(line.effectiveReorder) %></td><td><%= helpers.qty(line.needed) %></td><td><%= line.supplierName||'Link a supplier' %></td><td><% if(!line.supplierName){ %><a class="btn" href="/purchasing/supplier-for/<%= line.sku_id %>">Link a supplier</a><% }else{ %><a class="btn" href="/purchasing/why/<%= line.sku_id %>">Review reorder</a><% } %></td></tr><% } %></tbody></table></div><% }else{ %><p>No shortages were found among the <%= reorderOverview.scanned %> products checked on this page. <%= reorderOverview.hasMore?'Continue to check more products.':'Set reorder levels for products you want StockChief to monitor.' %></p><a class="btn" href="/purchasing/setup">Set reorder levels</a><% } %>
<% if(reorderOverview.hasMore){ %><a class="btn" href="/purchasing?<%= new URLSearchParams({afterSkuId:reorderOverview.nextAfterSkuId,q:reorderOverview.q}) %>">Next products</a><% } %>
