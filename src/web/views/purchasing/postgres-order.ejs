<p class="rm-stamp"><a href="/purchasing">Purchasing</a> · <%= order.supplier_name %></p>
<h1 class="rm-verdict"><%= order.po_number %> is <%= order.status.toLowerCase().replaceAll('_',' ') %>.</h1>
<p class="rm-prose">Order value <%= order.currency %> <%= lines.reduce((sum,line)=>sum+Number(line.line_total||0),0).toFixed(2) %>. On-hand inventory changes only when a receipt below is recorded.</p>
<% if(['DRAFT','AWAITING_APPROVAL'].includes(order.status)){ %><p class="rm-sub">Nothing was sent to the supplier and nothing is incoming yet.</p>
<% } else if(order.status==='APPROVED'){ %><p class="rm-sub">The purchase is approved but has not been sent yet.</p>
<% } else if(order.status==='ORDERED'){ %><p class="rm-sub">Supplier placement is recorded as incoming; on-hand stock did not change.</p>
<% } else if(['PARTIALLY_RECEIVED','RECEIVED'].includes(order.status)){ %><p class="rm-sub">Physical receipt recorded through the inventory ledger for the quantity shown below.</p><% } %>

<div class="rm-ledger"><% lines.forEach(function(line){ const outstanding=Number(line.quantity_units)-Number(line.quantity_received_units); %><div class="rm-ledger__row">
  <span class="rm-ledger__k"><%= line.item_name %><%= line.variant_label?' / '+line.variant_label:'' %><small><%= line.code %> · destination <%= line.location_name || 'not set' %></small></span>
  <span class="rm-ledger__v"><%= line.quantity_received_units %> / <%= line.quantity_units %> received</span><span class="rm-ledger__n"><%= outstanding %> outstanding</span>
</div><% }) %></div>

<section class="section"><div class="section-head"><h2>Next controlled step</h2></div>
  <% if(['DRAFT','AWAITING_APPROVAL'].includes(order.status)){ %><form method="post" action="/purchasing/orders/<%= order.id %>/approve"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="rm-btn" type="submit">Approve this purchase</button></form>
  <% } else if(order.status==='APPROVED'){ %><form method="post" action="/purchasing/orders/<%= order.id %>/place" class="inline-form"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><label>Supplier reference<input name="externalReference"></label><button class="rm-btn" type="submit">Record as placed</button></form>
  <% } else if(['ORDERED','PARTIALLY_RECEIVED'].includes(order.status)){ %><p>Book in only what physically arrived.</p><% lines.filter((line)=>Number(line.quantity_received_units)<Number(line.quantity_units)).forEach(function(line){ %><form method="post" action="/purchasing/orders/<%= order.id %>/receive" class="inline-form">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="lineId" value="<%= line.id %>"><input type="hidden" name="locationId" value="<%= line.destination_location_id %>">
    <label><%= line.item_name %> quantity<input type="number" name="quantity" min="1" max="<%= Number(line.quantity_units)-Number(line.quantity_received_units) %>" required></label><label>Receipt reference<input name="reference"></label><button class="rm-btn" type="submit">Record physical receipt</button>
  </form><% }) %><% } else { %><div class="quiet-note">No purchasing transition is waiting.</div><% } %>
</section>

<section class="section"><div class="section-head"><h2>Supplier invoices</h2></div>
  <p class="rm-sub">Recording an invoice establishes what is owed without receiving stock again. Supplier payments change money only; physical inventory does not change.</p>
  <% if(!bills.length){ %><div class="quiet-note">No supplier invoice recorded. An invoice records money owed; it never receives stock.</div><% } else { %><div class="rm-ledger"><% bills.forEach(function(bill){ %><div class="rm-ledger__row"><span class="rm-ledger__k"><%= bill.supplier_invoice_number || bill.bill_number %><small><%= bill.match_status %></small></span><span class="rm-ledger__v"><%= helpers.money(bill.balance_minor,bill.currency) %> open</span><span class="rm-ledger__n"><%= bill.status %></span></div><% }) %></div><% } %>
  <% if(lines.some((line)=>Number(line.quantity_received_units)>0)){ const line=lines.find((candidate)=>Number(candidate.quantity_received_units)>0); %><details><summary>Record a supplier invoice</summary><form method="post" action="/purchasing/orders/<%= order.id %>/invoices" class="stacked-form">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="lineId" value="<%= line.id %>"><div class="form-grid"><label>Supplier invoice number<input name="supplierInvoiceNumber" required></label><label>Invoice date<input type="date" name="issueDate" value="<%= today %>" required></label><label>Due date<input type="date" name="dueDate"></label><label>Quantity billed<input type="number" name="quantity" min="1" max="<%= line.quantity_received_units %>" value="<%= line.quantity_received_units %>" required></label><label>Cost per unit<input type="number" name="unitCost" min="0" step="0.01" value="<%= Number(line.unit_cost).toFixed(2) %>" required></label><label>Tax<input type="number" name="tax" min="0" step="0.01" value="0.00"></label></div><button class="rm-btn" type="submit">Record invoice, not receipt</button>
  </form></details><% } %>
</section>

<% const payable=bills.find((bill)=>['OPEN','PARTIALLY_PAID'].includes(bill.status)); if(payable){ %><section class="section"><div class="section-head"><h2>Pay supplier</h2></div><form method="post" action="/purchasing/orders/<%= order.id %>/payments" class="inline-form">
  <input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="billId" value="<%= payable.id %>"><label>Amount<input type="number" name="amount" min="0.01" step="0.01" max="<%= (payable.balance_minor/100).toFixed(2) %>" required></label><label>Date<input type="date" name="paymentDate" value="<%= today %>"></label><label>Method<input name="method" placeholder="Check, ACH, card"></label><button class="rm-btn" type="submit">Record payment</button>
</form></section><% } %>

<section class="section"><div class="section-head"><h2>Return goods to supplier</h2></div><p class="rm-sub">A request and authorization do not alter stock. Shipping removes the exact goods and their inventory cost; the later supplier credit changes the bill without moving stock again.</p>
  <% if(supplierReturns.length){ %><div class="rm-ledger"><% supplierReturns.forEach(function(supplierReturn){ %><a class="rm-ledger__row" href="/supplier-returns/<%= supplierReturn.id %>"><span class="rm-ledger__k"><%= supplierReturn.return_number %><small><%= supplierReturn.supplier_name %></small></span><span class="rm-ledger__v"><%= supplierReturn.status.replaceAll('_',' ').toLowerCase() %></span><span class="rm-ledger__n">Review →</span></a><% }) %></div><% } %>
  <% const receivedLines=lines.filter((line)=>Number(line.quantity_received_units)>0); const openBills=bills.filter((bill)=>['OPEN','PARTIALLY_PAID'].includes(bill.status)); if(receivedLines.length&&openBills.length){ %><details><summary>Start a controlled supplier return</summary><form method="post" action="/purchasing/orders/<%= order.id %>/returns" class="stacked-form"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="idempotencyKey" value="<%= returnFormKey %>"><label>Bill the supplier credit will reduce<select name="supplierBillId" required><option value="">Choose open bill</option><% openBills.forEach(function(bill){ %><option value="<%= bill.id %>"><%= bill.supplier_invoice_number || bill.bill_number %> · <%= helpers.money(bill.balance_minor,bill.currency) %> open</option><% }) %></select></label><label>Expected supplier credit<input type="number" name="expectedCredit" min="0.01" step="0.01" required></label><% receivedLines.forEach(function(line){ %><fieldset><legend><%= line.item_name %> · <%= line.location_name %></legend><label>Quantity to return<input aria-label="Return <%= line.item_name %> to supplier quantity" type="number" name="quantity_<%= line.id %>" min="0" max="<%= line.quantity_received_units %>" value="0"></label><% if(line.tracking_mode==='lot'){ %><label>Lot / batch<input name="lot_<%= line.id %>"></label><% } %><% if(line.tracking_mode==='serial'){ %><label>Serial numbers<input name="serials_<%= line.id %>" placeholder="Comma-separated, one per unit"></label><% } %></fieldset><% }) %><label>Reason<textarea name="reason" rows="2" placeholder="Damage, wrong item, supplier authorization"></textarea></label><button class="rm-btn" type="submit">Request supplier return</button><p class="rm-sub">Nothing leaves until a separate authorization and shipment step.</p></form></details><% } else if(receivedLines.length&&!openBills.length){ %><div class="quiet-note">Record or reopen the supplier bill before starting a return that expects a credit.</div><% } %>
</section>

<section class="section"><div class="section-head"><h2>Verified history</h2></div><div class="rm-feed"><% events.forEach(function(event){ %><div class="rm-feed__row"><span class="rm-feed__ic">✓</span><span class="rm-feed__t"><%= event.event %><small><%= event.created_at %></small></span></div><% }) %></div></section>
