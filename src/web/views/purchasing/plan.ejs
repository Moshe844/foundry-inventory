<div class="page-head">
  <div class="titles">
    <h1>What to order</h1>
    <div class="page-sub">
      What you are running low on, based on what you have, what is already on its way, and how fast it
      has been selling. Nothing is ordered until you say so.
    </div>

<% if (setup && setup.lines && !setup.alreadySet) { %>
  <div class="card section card--warn">
    <div class="card-body">
      <%# "Reorder points", "lines" and "enough history" all assume the reader
          already runs a stockroom. Say what is missing and what it unlocks. %>
      <p class="lede">Foundry does not know who you buy from yet.</p>
      <p class="muted">
        Once it knows your supplier and how long they take to deliver, it can tell you what to order
        and write the order for you to check. It takes a minute and you only do it once.
      </p>
      <div class="btn-row"><a class="btn btn--primary" href="/purchasing/setup">Set up purchasing</a></div>
    </div>
  </div>
<% } %>

  </div>
</div>

<% if (late.length || arriving.length) { %>
  <div class="grid grid--2 section">
    <% if (late.length) { %>
      <div class="card card--warn">
        <div class="card-head"><h2>Past their expected date</h2></div>
        <div class="card-body">
          <ul class="plain-list">
            <% late.forEach(function (po) { %>
              <li>
                <a href="/purchasing/orders/<%= po.id %>"><%= po.po_number %></a> ·
                <%= po.supplier_name %> · <%= po.daysLate %> day<%= po.daysLate === 1 ? '' : 's' %> late ·
                <%= po.outstanding_units %> outstanding
              </li>
            <% }) %>
          </ul>
        </div>
      </div>
    <% } %>
    <% if (arriving.length) { %>
      <div class="card">
        <div class="card-head"><h2>Arriving this week</h2></div>
        <div class="card-body">
          <ul class="plain-list">
            <% arriving.forEach(function (po) { %>
              <li>
                <a href="/purchasing/orders/<%= po.id %>"><%= po.po_number %></a> ·
                <%= po.supplier_name %> · expected <%= po.expected_date %> ·
                <%= po.outstanding_units %> unit<%= po.outstanding_units === 1 ? '' : 's' %>
              </li>
            <% }) %>
          </ul>
        </div>
      </div>
    <% } %>
  </div>
<% } %>

<%
  // Something below its reorder point that Foundry cannot act on is still
  // something below its reorder point. Heading the page "Nothing needs
  // ordering / All covered" over the top of it is false, and it buries the one
  // line the customer came here to find.
  // Two very different kinds of blocked. A line whose shortfall Foundry worked
  // out and cannot act on because no supplier is attached genuinely needs
  // ordering. A line with no usage history is one Foundry cannot judge at all —
  // announcing that it "needs ordering" would be inventing the very demand
  // figure it is refusing to guess.
  var short = plan.blocked.filter(function (line) { return line.reason === 'no_supplier'; });
  var unknown = plan.blocked.filter(function (line) { return line.reason !== 'no_supplier'; });
  var stuck = short.length > 0;
%>
<% if (plan.recommendations.length === 0) { %>
  <div class="card section <%= stuck ? 'card--warn' : '' %>">
    <div class="card-head">
      <h2><%= stuck
        ? (short.length === 1 ? 'One product needs ordering, and Foundry cannot do it for you' : short.length + ' products need ordering, and Foundry cannot do them for you')
        : (plan.covered.length && unknown.length
            ? (plan.covered.length === 1 ? 'One product is fine. Foundry cannot judge the rest yet' : plan.covered.length + ' products are fine. Foundry cannot judge the rest yet')
            : unknown.length ? 'Foundry cannot tell yet' : 'Nothing needs ordering') %></h2>
      <span class="spacer"></span>
      <span class="badge badge--<%= stuck ? 'danger' : unknown.length ? 'muted' : 'ok' %>"><%= stuck ? 'Needs you' : unknown.length ? 'Not enough history' : 'All covered' %></span>
    </div>
    <div class="card-body">
      <% if (stuck) { %>
        <p class="lede">
          Foundry worked out what these need, but something is missing before it can prepare an order.
          Nothing has been ordered.
        </p>
        <ul class="plain-list">
          <% short.forEach(function (line) { %>
            <li>
              <a href="/purchasing/why/<%= line.skuId %>"><strong><%= line.displayName %></strong></a>
              — <%= line.headline %>
              <% if (line.reason === 'no_supplier') { %>
                <div class="muted">Add a supplier for this product and Foundry can prepare the order.</div>
              <% } %>
            </li>
          <% }) %>
        </ul>
      <% } else { %>
        <% if (unknown.length) { %>
          <%# A line that was assessed and found fine has to be visible, or
              somebody who just set one up and tested it sees only a paragraph
              about the lines they did not touch and concludes nothing worked. %>
          <% if (plan.covered.length) { %>
            <p class="lede">
              Foundry checked
              <%= plan.covered.length === 1 ? 'one product' : plan.covered.length + ' products' %>
              against how fast <%= plan.covered.length === 1 ? 'it sells' : 'they sell' %> and what is
              already on the way — <%= plan.covered.length === 1 ? 'it is' : 'they are' %> fine for now.
            </p>
          <% } %>
          <p class="lede">
            It has not seen
            <%= unknown.length === 1 ? 'the other one' : 'the other ' + unknown.length %> selling yet, so it
            cannot say whether <%= unknown.length === 1 ? 'it needs' : 'they need' %> ordering — and it will
            not guess. Record a sale, or tell it the level to reorder at, and it can start.
          </p>
        <% } else { %>
          <p class="lede">
            Foundry checked every line against its usage and what is already on order, and none of them
            are below their reorder point.
          </p>
        <% } %>
      <% } %>
      <% if (plan.covered.length) { %>
        <h3 class="sub-head">Checked and not needed yet</h3>
        <table class="table table--tight">
          <thead><tr><th>Product</th><th class="num">On hand</th><th class="num">On order</th><th>Why not</th></tr></thead>
          <tbody>
            <% plan.covered.slice(0, 10).forEach(function (line) { %>
              <tr>
                <td><a href="/purchasing/why/<%= line.skuId %>"><%= line.displayName %></a></td>
                <td class="num"><%= line.onHand %></td>
                <td class="num"><%= line.onOrder %></td>
                <td class="muted"><%= line.explanation %></td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      <% } %>
      <% if (unknown.length && stuck) { %>
        <h3 class="sub-head">Foundry cannot assess these yet</h3>
        <ul class="plain-list">
          <% unknown.slice(0, 8).forEach(function (line) { %>
            <li><strong><%= line.displayName %></strong> — <%= line.headline %></li>
          <% }) %>
        </ul>
      <% } %>
    </div>
  </div>
<% } else { %>

  <div class="card section">
    <div class="card-head">
      <h2>Foundry prepared today's replenishment</h2>
      <span class="spacer"></span>
      <span class="badge badge--muted"><%= plan.recommendations.length %> line<%= plan.recommendations.length === 1 ? '' : 's' %></span>
    </div>
    <div class="card-body">
      <p class="lede">
        <%= plan.recommendations.length %> line<%= plan.recommendations.length === 1 ? '' : 's' %>
        <%= plan.recommendations.length === 1 ? 'is' : 'are' %> at or below the reorder point,
        across <%= plan.bySupplier.length %> supplier<%= plan.bySupplier.length === 1 ? '' : 's' %>.
      </p>

      <% plan.bySupplier.forEach(function (group) { %>
        <div class="act-ledger">
          <div class="act-row act-row--total">
            <span class="act-place"><strong><%= group.supplierName %></strong></span>
            <span class="act-move">
              <%= group.lines.length %> item<%= group.lines.length === 1 ? '' : 's' %>
              <% if (group.estimatedTotal) { %>
                · <span class="num"><%= group.estimatedTotal.toFixed(2) %></span><% if (group.hasUnpricedLines) { %>+<% } %>
              <% } %>
            </span>
          </div>
          <% group.lines.forEach(function (line) { %>
            <div class="act-row">
              <span class="act-place">
                <a href="/purchasing/why/<%= line.skuId %>"><%= line.displayName %></a>
                <div class="muted">
                  on hand <%= line.onHand %> · on order <%= line.onOrder %> ·
                  reorder point <%= line.reorderPoint %>
                  <% if (line.urgency === 'may_run_out_first') { %>
                    · <span class="is-warn">may run out before a delivery arrives</span>
                  <% } %>
                </div>
              </span>
              <span class="act-move">
                <span class="num"><%= line.quantityUnits %></span>
                <% if (line.quantityPurchaseUnits !== line.quantityUnits) { %>
                  <span class="muted">(<%= line.quantityPurchaseUnits %> <%= line.purchaseUnit %>)</span>
                <% } %>
              </span>
            </div>
          <% }) %>
        </div>
        <% if (permissions.create) { %>
          <form method="post" action="/purchasing/prepare/<%= group.supplierId %>" data-busy>
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <button class="btn btn--primary" type="submit">Review <%= group.supplierName %> order</button>
          </form>
        <% } %>
      <% }) %>
    </div>
  </div>
<% } %>

<div class="card section">
  <div class="card-head">
    <h2>Open orders</h2>
    <span class="spacer"></span>
    <div class="btn-row">
      <a class="btn btn--sm" href="/purchasing/orders">All orders</a>
      <a class="btn btn--sm" href="/suppliers">Suppliers</a>
      <% if (permissions.create) { %>
        <a class="btn btn--sm" href="/purchasing/orders/new">New order</a>
      <% } %>
      <% if (permissions.receive) { %>
        <a class="btn btn--sm" href="/purchasing/receive">Book in a delivery</a>
      <% } %>
    </div>
  </div>
  <% if (open.length === 0) { %>
    <div class="card-body"><p class="muted">Nothing is on order at the moment.</p></div>
  <% } else { %>
    <table class="table table--tight">
      <thead>
        <tr><th>Order</th><th>Supplier</th><th>Status</th><th>Expected</th><th class="num">Outstanding</th></tr>
      </thead>
      <tbody>
        <% open.forEach(function (po) { %>
          <tr>
            <td><a href="/purchasing/orders/<%= po.id %>"><%= po.po_number %></a></td>
            <td><%= po.supplier_name %></td>
            <td><span class="badge badge--muted"><%= helpers.columnLabel(po.status.toLowerCase().replace('_', ' ')) %></span></td>
            <td class="muted"><%= po.expected_date || '—' %></td>
            <td class="num"><%= po.outstanding_units %></td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  <% } %>
</div>
