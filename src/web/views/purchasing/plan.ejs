<%
  /*
   * Purchasing, as one process rather than six cards of equal weight.
   *
   * The page had "Past their expected date", "Arriving this week" and "Open
   * orders" as three separate sections — three views of the same purchase
   * orders, so an order that was late appeared twice and the reader had to
   * work out that it was one order, not two. They are one list now, ordered by
   * when each is due, with the late ones marked.
   *
   * The setup warning was rendered inside the page heading's own container,
   * which put a bordered card inside the block that holds the title.
   *
   * And the actions at the bottom were four buttons of identical weight —
   * All orders, Suppliers, New order, Book in a delivery — so nothing on the
   * page said which one mattered. What matters is the decision at the top;
   * those four are places to go, and now look like it.
   */
  var short = plan.blocked.filter(function (line) { return line.reason === 'no_supplier'; });
  var unknown = plan.blocked.filter(function (line) { return line.reason === 'no_usage_evidence'; });
  var timingRisks = plan.blocked.filter(function (line) { return line.reason === 'incoming_timing_risk'; });
  var stuck = short.length > 0;
  var hasPlan = plan.recommendations.length > 0;

  // One list of what is on its way. `late` and `arriving` are both slices of
  // `open`, so the lateness is carried onto the row rather than into its own
  // section.
  var lateById = {};
  late.forEach(function (po) { lateById[po.id] = po.daysLate; });
  var onTheWay = open.slice().sort(function (a, b) {
    return String(a.expected_date || '9999').localeCompare(String(b.expected_date || '9999'));
  });
%>

<% var drafts = locals.drafts || []; %>
<div class="page-head">
  <div>
    <h1>Purchasing</h1>
    <p class="page-sub">
      What you are running low on, based on what you have, what is already on its way, and how fast it
      has been selling. Nothing is ordered until you say so.
    </p>
  </div>
  <div class="page-actions">
    <% if (permissions.create) { %><a class="btn btn--primary" href="/purchasing/orders/new"><%- helpers.icon('plus', { size: 15 }) %> Write a purchase order</a><% } %>
    <% if (permissions.receive) { %><a class="btn" href="/purchasing/receive"><%- helpers.icon('receive', { size: 15 }) %> Book in a delivery</a><% } %>
  </div>
</div>

<% if (drafts.length) { %>
  <div class="flash section" role="status" style="margin-top:0">
    <%- helpers.icon('alert', { size: 18 }) %>
    <div>
      <strong><%= drafts.length %> purchase order<%= drafts.length === 1 ? ' is' : 's are' %> waiting on you.</strong>
      <p>
        <%= drafts.length === 1 ? 'It has' : 'They have' %> not been sent to anyone.
        <a href="/purchasing/orders?view=waiting">Check and approve <%= drafts.length === 1 ? 'it' : 'them' %></a><%
        %><% if (drafts.some(function (po) { return !po.hasCosts; })) { %> — <%= drafts.filter(function (po) { return !po.hasCosts; }).length === drafts.length ? 'every one' : 'some' %> still need<%= drafts.length === 1 ? 's' : '' %> a price<% } %>.
      </p>
    </div>
  </div>
<% } %>

<% if (setup && setup.lines && !setup.alreadySet) { %>
  <div class="flash flash--warn section" role="status">
    <%- helpers.icon('alert', { size: 18 }) %>
    <div>
      <% if (!setup.suppliers) { %>
        <strong>StockChief does not know who you buy from yet.</strong>
        <p>Once it knows your supplier and how long they take to deliver, it can tell you what to
          order and write the order for you to check. It takes a minute and you only do it once.</p>
      <% } else if (setup.withoutSupplier) { %>
        <strong>
          <%= setup.withoutSupplier %>
          <%= setup.withoutSupplier === 1 ? 'version has' : 'versions have' %> nobody to buy from yet.
        </strong>
        <p>StockChief can work out what those need, but not who to order them from. The ones that are
          short say so on the line itself.</p>
      <% } else { %>
        <strong>StockChief is working these out from what they have been selling.</strong>
        <p>You have not set your own reorder levels, so StockChief uses the ones it derives from usage
          and says so. Set them yourself whenever you want to be exact.</p>
      <% } %>
      <p><a class="btn btn--sm" href="/purchasing/setup">Set up purchasing</a></p>
    </div>
  </div>
<% } %>

<%#
  What the current position cannot show.

  The list below answers "what is below its reorder point today". This answers
  "what will be a problem before it can be fixed", which is a different and
  usually earlier question. Only the lines nothing is already covering.
%>
<%
  var allShortages = (locals.ahead && ahead.shortages || []);
  var waitingCovered = allShortages.filter(function (row) {
    return row.breaksCommitment
      && row.incomingCoversMissedCommitment
      && row.missedCommitment
      && !row.missedCommitment.dated;
  });
  var exposed = allShortages.filter(function (row) {
    return !row.coveredByIncoming && waitingCovered.indexOf(row) === -1;
  });
%>
<% if (exposed.length) { %>
<section class="section">
  <div class="section-head">
    <h2>Coming up short</h2>
    <a class="section-more" href="/planning">See how I worked this out</a>
  </div>
  <div class="panel"><div class="stack">
    <% exposed.slice(0, 6).forEach(function (row) { %>
      <article class="planning-item">
        <strong><%= row.displayName %></strong>
        <% if (row.breaksCommitment) { %><span class="badge badge--warn">A customer is waiting</span><% } %>
        <span class="badge"><%= row.confidence === 'high' ? 'High confidence'
          : row.confidence === 'moderate' ? 'Moderate confidence' : 'Still learning' %></span>
        <p class="muted"><%= row.explanation %></p>
        <% if (row.purchase && row.purchase.order) { %>
          <p><strong><%= row.purchase.headline %></strong></p>
          <% if (row.purchase.tradeoff) { %><p class="muted"><%= row.purchase.tradeoff.text %></p><% } %>
        <% } %>
      </article>
    <% }) %>
  </div></div>
</section>
<% } %>

<% if (waitingCovered.length) { %>
<section class="section">
  <div class="section-head">
    <h2>Customers waiting for stock already ordered</h2>
    <a class="section-more" href="/planning">See the timing</a>
  </div>
  <div class="panel"><div class="stack">
    <% waitingCovered.slice(0, 6).forEach(function (row) { %>
      <article class="planning-item">
        <strong><%= row.missedCommitment.orderNumber || 'A customer order' %> is waiting for
          <%= helpers.qty(row.shortfallUnits) %> <%= helpers.plural(row.shortfallUnits, 'unit', 'units') %> of <%= row.displayName %>.</strong>
        <% if (row.nextArrival) { %>
          <p class="muted">
            <a href="/purchasing/orders/<%= row.nextArrival.poId %>"><%= row.nextArrival.poNumber %></a>
            brings <%= helpers.qty(row.nextArrival.units) %> <%= helpers.plural(row.nextArrival.units, 'unit', 'units') %> on
            <%= row.nextArrival.date %>, which covers this order. Nothing more needs to be ordered.
          </p>
        <% } else { %>
          <p class="muted"><%= helpers.qty(row.onOrder) %> <%= helpers.plural(row.onOrder, 'unit', 'units') %> are already on order and cover this customer. Nothing more needs to be ordered.</p>
        <% } %>
      </article>
    <% }); %>
  </div></div>
</section>
<% } %>

<%# ------------------------------------------------------------ What to order %>
<section class="section">
  <div class="section-head">
    <h2>What to order</h2>
    <% if (hasPlan) { %>
      <span class="section-more"><%= plan.recommendations.length %> line<%= plan.recommendations.length === 1 ? '' : 's' %>
        across <%= plan.bySupplier.length %> supplier<%= plan.bySupplier.length === 1 ? '' : 's' %></span>
    <% } %>
  </div>

  <% if (hasPlan) { %>
    <% plan.bySupplier.forEach(function (group) { %>
      <div class="panel supplier-order">
        <div class="panel-head">
          <div>
            <h3><%= group.supplierName %></h3>
            <span class="t-xs t-muted">
              <%= group.lines.length %> item<%= group.lines.length === 1 ? '' : 's' %><%
                %><% if (group.estimatedTotal) { %> · <%= group.estimatedTotal.toFixed(2) %><% if (group.hasUnpricedLines) { %>+<% } %><% } %>
            </span>
          </div>
          <% if (permissions.create) { %>
            <% if ((group.activePlans || []).length === 1) { %>
              <a class="btn btn--primary" href="/autopilot/work/<%= group.activePlans[0].id %>">Review StockChief's decision</a>
            <% } else if ((group.activePlans || []).length > 1) { %>
              <a class="btn btn--primary" href="/needs-you">Review these decisions</a>
            <% } else { %>
              <form method="post" action="/purchasing/prepare/<%= group.supplierId %>" data-busy>
                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                <button class="btn btn--primary" type="submit">Prepare <%= group.supplierName %> order</button>
              </form>
            <% } %>
          <% } %>
        </div>
        <div class="table-wrap">
          <table class="table table--stack">
            <thead>
              <tr>
                <th>Product</th>
                <th class="num">On hand</th>
                <th class="num">On order</th>
                <th class="num">Reorder at</th>
                <th class="num">Order</th>
              </tr>
            </thead>
            <tbody>
              <% group.lines.forEach(function (line) { %>
                <tr>
                  <td class="cell-main">
                    <a class="cell-title" href="/purchasing/why/<%= line.skuId %>"><%= line.displayName %></a>
                    <% if (line.urgency === 'may_run_out_first') { %>
                      <span class="cell-sub is-warn">May run out before a delivery arrives</span>
                    <% } %>
                  </td>
                  <td class="num" data-label="On hand"><%= line.onHand %></td>
                  <td class="num" data-label="On order"><%= line.onOrder %></td>
                  <td class="num t-muted" data-label="Reorder at"><%= line.reorderPoint %></td>
                  <td class="num cell-end" data-label="Order">
                    <strong><%= line.quantityUnits %></strong>
                    <% if (line.quantityPurchaseUnits !== line.quantityUnits) { %>
                      <span class="cell-sub"><%= line.quantityPurchaseUnits %> <%= line.purchaseUnit %></span>
                    <% } %>
                  </td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
      </div>
    <% }) %>

  <% } else if (stuck) { %>
    <div class="inbox">
      <% short.forEach(function (line) { %>
        <article class="need need--important">
          <div class="need__main">
            <h3 class="need__title"><%= line.displayName %> needs ordering</h3>
            <p class="need__happened"><%= line.headline %></p>
            <dl class="need__detail">
              <div>
                <dt>Why StockChief stopped</dt>
                <dd>It worked out what this needs, but has nobody to order it from. Nothing has been ordered.</dd>
              </div>
            </dl>
          </div>
          <div class="need__decide">
            <p class="need__ask"><span>Your decision</span>Who supplies this, and on what terms.</p>
            <a class="btn btn--primary" href="/purchasing/supplier-for/<%= line.skuId %>">Add the supplier</a>
            <a class="btn btn--ghost btn--sm" href="/purchasing/why/<%= line.skuId %>">See the numbers</a>
          </div>
        </article>
      <% }) %>
    </div>

  <% } else { %>
    <div class="quiet-note">
      <span class="dot dot--ok" aria-hidden="true"></span>
      <% if (timingRisks.length) { %>
        Incoming quantities are not sufficient proof of timely coverage. Review the arrival decisions below; no duplicate purchase was prepared.
      <% } else if (unknown.length && plan.covered.length) { %>
        <%= plan.covered.length === 1 ? 'One version was checked and is' : plan.covered.length + ' versions were checked and are' %>
        fine for now. StockChief has not seen the other <%= unknown.length === 1 ? 'one' : unknown.length %> selling yet.
      <% } else if (unknown.length) { %>
        <%# "Has not seen these selling" is only one of the reasons StockChief
            cannot judge a line, and it is the wrong one to state by default.
            A product sold twice today has been seen selling; what it lacks is
            days. Saying otherwise contradicts the line's own reason directly
            underneath, and tells somebody to record a sale they just recorded. %>
        StockChief does not have enough history for these yet, so it cannot say whether they need
        ordering — and it will not guess. Each one says what it is waiting for.
      <% } else { %>
        Everything was checked against how fast it sells and what is already on the way. Nothing is below its reorder point.
      <% } %>
    </div>
  <% } %>
</section>

<% if (timingRisks.length) { %>
<section class="card section" role="alert"><div class="card-head"><h2>Incoming stock is not proven coverage</h2></div><div class="card-body">
  <p>The aggregate order quantity is sufficient, but its timing needs review. Nothing has been ordered twice.</p>
  <% timingRisks.forEach(function(line) { %><article class="fold-note"><h3><a href="/purchasing/why/<%= line.skuId %>"><%= line.displayName %></a></h3><p><%= line.explanation %></p><% line.incoming.orders.forEach(function(order) { %><p><a href="/purchasing/orders/<%= order.poId %>">Review <%= order.poNumber %></a></p><% }) %></article><% }) %>
</div></section>
<% } %>
<%# ------------------------------------------------------------- On the way %>
<section class="section">
  <div class="section-head">
    <h2>On the way<% if (late.length) { %> <span class="badge badge--warn" style="margin-left:6px;vertical-align:middle"><%= late.length %> late</span><% } %></h2>
    <a class="section-more" href="/purchasing/orders">All purchases</a>
  </div>
  <% if (!onTheWay.length) { %>
    <div class="quiet-note">Nothing is on order at the moment.</div>
  <% } else { %>
    <div class="panel">
      <div class="table-wrap">
        <table class="table table--stack">
          <thead>
            <tr>
              <th>Order</th><th>Supplier</th><th>Expected</th>
              <th class="num">Still to come</th><th>Stage</th><% if (permissions.receive) { %><th class="num"><span class="sr-only">Action</span></th><% } %>
            </tr>
          </thead>
          <tbody>
            <% onTheWay.forEach(function (po) { %>
              <% var daysLate = lateById[po.id]; %>
              <tr>
                <td class="cell-main">
                  <a class="cell-title" href="/purchasing/orders/<%= po.id %>"><%= po.po_number %></a>
                </td>
                <td data-label="Supplier"><%= po.supplier_name %></td>
                <td data-label="Expected" class="<%= daysLate ? 'is-warn' : 't-muted' %>">
                  <%= po.expected_date ? helpers.shortDate(po.expected_date) : 'No date' %>
                  <% if (daysLate) { %>
                    <span class="cell-sub is-warn"><%= daysLate %> day<%= daysLate === 1 ? '' : 's' %> late</span>
                  <% } %>
                </td>
                <td class="num" data-label="Still to come"><strong><%= po.outstanding_units %></strong></td>
                <td data-label="Stage">
                  <span class="badge badge--<%= daysLate ? 'warn' : 'info' %>"><%= daysLate ? 'Late' : helpers.columnLabel(po.status.toLowerCase().replace('_', ' ')) %></span>
                </td>
                <% if (permissions.receive) { %><td class="num" data-label=""><a class="btn btn--sm" href="/purchasing/orders/<%= po.id %>/receive">Book in</a></td><% } %>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    </div>
  <% } %>
</section>

<%# --------------------------------------------- What StockChief checked and left %>
<% if (plan.covered.length || unknown.length) { %>
  <section class="section">
    <details class="disclose">
      <summary>
        <span>
          <% if (plan.covered.length) { %>
            <%= plan.covered.length %> <%= plan.covered.length === 1 ? 'version' : 'versions' %> checked and not needed yet<%
              %><% if (unknown.length) { %>, <%= unknown.length %> StockChief cannot judge yet<% } %>
          <% } else { %>
            <%= unknown.length %> <%= unknown.length === 1 ? 'version' : 'versions' %> StockChief cannot judge yet
          <% } %>
        </span>
        <span class="disclose__cue">Show</span>
      </summary>
      <div class="disclose__body">
        <% if (plan.covered.length) { %>
          <div class="table-wrap">
            <table class="table">
              <thead><tr><th>Product</th><th class="num">On hand</th><th class="num">On order</th><th>Why not</th></tr></thead>
              <tbody>
                <% plan.covered.slice(0, 10).forEach(function (line) { %>
                  <tr>
                    <td><a href="/purchasing/why/<%= line.skuId %>"><%= line.displayName %></a></td>
                    <td class="num"><%= line.onHand %></td>
                    <td class="num"><%= line.onOrder %></td>
                    <td class="t-muted"><%= line.explanation %></td>
                  </tr>
                <% }) %>
              </tbody>
            </table>
          </div>
        <% } %>
        <% if (unknown.length) { %>
          <p class="t-muted" style="margin-top:12px;">
            StockChief will not guess a demand figure it cannot stand behind. Keep recording what
            goes out, or set the level to reorder at yourself, and it can act on these.
          </p>
          <ul class="plain-list">
            <% unknown.slice(0, 8).forEach(function (line) { %>
              <li><strong><%= line.displayName %></strong> — <%= line.headline %></li>
            <% }) %>
          </ul>
        <% } %>
      </div>
    </details>
  </section>
<% } %>

<nav class="page-links" aria-label="Purchasing pages">
  <a href="/suppliers">Suppliers and their terms</a>
  <a href="/purchasing/orders">All purchases</a>
  <a href="/accounting/payables">Bills to pay</a>
</nav>
