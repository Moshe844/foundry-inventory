<%
  // A plain document, styled for paper. Deliberately not "sent" anywhere:
  // StockChief does not contact suppliers, so this is something a person prints,
  // saves as a PDF from their browser, or attaches to their own email.
%>
<meta charset="utf-8">
<title><%= order.poNumber %> · <%= businessName %></title>
<%# This page is the document itself — it renders without the application
    chrome, because a supplier receives a purchase order rather than a screen.
    It therefore carries its own stylesheet, written from the same type and
    the same neutral ramp as design.css, so a printed StockChief document and a
    StockChief screen are recognisably the same product. %>
<style>
  :root { color-scheme: light; }
  body {
    font-family: "Inter", ui-sans-serif, system-ui, "Segoe UI", Roboto, Arial, sans-serif;
    font-size: 13.5px; line-height: 1.5; letter-spacing: -0.004em;
    color: #171C29; margin: 0; padding: 40px 32px; background: #fff;
    -webkit-font-smoothing: antialiased;
  }
  .sheet { max-width: 780px; margin: 0 auto; }
  h1 { font-size: 24px; font-weight: 600; letter-spacing: -0.026em; margin: 0 0 2px; }
  h2 { font-size: 15px; font-weight: 600; letter-spacing: -0.018em; margin: 0; }
  .muted { color: #6D7689; }
  .row { display: flex; gap: 32px; justify-content: space-between; align-items: flex-start; }
  .block { margin: 24px 0; }
  .label {
    font-size: 11.5px; font-weight: 600; text-transform: uppercase;
    letter-spacing: .05em; color: #6D7689; margin-bottom: 4px;
  }
  table { width: 100%; border-collapse: collapse; margin-top: 12px; }
  th, td { text-align: left; padding: 8px 10px; border-bottom: 1px solid #EAEDF3; }
  th {
    font-size: 11.5px; font-weight: 600; text-transform: uppercase;
    letter-spacing: .05em; color: #6D7689; border-bottom-color: #E1E5ED;
  }
  td.num, th.num { text-align: right; font-variant-numeric: tabular-nums; }
  tfoot td { font-weight: 600; border-bottom: none; border-top: 1px solid #CBD1DC; }
  .note { margin-top: 26px; font-size: 12.5px; color: #6D7689; }
  .actions { margin-bottom: 24px; display: flex; gap: 8px; }
  .actions a, .actions button {
    font: inherit; font-size: 13.5px; font-weight: 500;
    min-height: 32px; padding: 0 12px;
    border: 1px solid #CBD1DC; border-radius: 6px;
    background: #fff; color: #171C29; cursor: pointer;
    display: inline-flex; align-items: center; text-decoration: none;
  }
  .actions button { background: #5B4BE8; border-color: #4A3ACB; color: #fff; }
  @media print { .actions { display: none; } body { padding: 0; } }
</style>

<div class="sheet">
  <div class="actions">
    <button type="button" onclick="window.print()">Print or save as PDF</button>
    <a href="/purchasing/orders/<%= order.id %>">Back to the order</a>
  </div>

  <div class="row">
    <div>
      <h1>Purchase order</h1>
      <div class="muted"><%= order.poNumber %></div>
    </div>
    <div style="text-align:right;">
      <div style="font-weight:600;"><%= businessName %></div>
      <div class="muted">Ordered <%= order.orderDate || '—' %></div>
      <% if (order.expectedDate) { %><div class="muted">Expected <%= order.expectedDate %></div><% } %>
    </div>
  </div>

  <div class="row block">
    <div>
      <div class="label">Supplier</div>
      <div><strong><%= supplier.name %></strong></div>
      <% if (supplier.contactName) { %><div><%= supplier.contactName %></div><% } %>
      <% if (supplier.email) { %><div class="muted"><%= supplier.email %></div><% } %>
      <% if (supplier.phone) { %><div class="muted"><%= supplier.phone %></div><% } %>
    </div>
    <div>
      <div class="label">Deliver to</div>
      <div><%= order.destinationLocationName || '—' %></div>
      <% if (supplier.paymentTerms) { %>
        <div class="label" style="margin-top:12px;">Terms</div>
        <div class="muted"><%= supplier.paymentTerms %></div>
      <% } %>
    </div>
  </div>

  <table>
    <thead>
      <tr>
        <th>Product</th><th><%= order.supplierItemCodeLabel %></th><th class="num">Quantity</th>
        <th>Unit</th><th class="num">Unit cost</th><th class="num">Total</th>
      </tr>
    </thead>
    <tbody>
      <% order.lines.forEach(function (line) { %>
        <tr>
          <td><%= line.displayName %></td>
          <td class="muted"><%= line.supplierSku || '' %></td>
          <td class="num"><%= line.quantityPurchaseUnits %></td>
          <td><%= line.purchaseUnit %><%= line.unitsPerPurchaseUnit > 1 ? ' of ' + line.unitsPerPurchaseUnit : '' %></td>
          <td class="num"><%= line.unitCost === null ? '' : line.unitCost %></td>
          <td class="num"><%= line.lineTotal === null ? '' : line.lineTotal.toFixed(2) %></td>
        </tr>
      <% }) %>
    </tbody>
    <% if (order.hasCosts) { %>
      <tfoot>
        <tr>
          <td colspan="5">Total (<%= order.currency %>)</td>
          <td class="num"><%= order.subtotal.toFixed(2) %></td>
        </tr>
      </tfoot>
    <% } %>
  </table>

  <% if (order.notes) { %>
    <div class="block">
      <div class="label">Notes</div>
      <div><%= order.notes %></div>
    </div>
  <% } %>

  <div class="note">
    Quantities are stated in supplier units; the inventory equivalent is
    <%= order.orderedUnits %> unit<%= order.orderedUnits === 1 ? '' : 's' %>.
    This document was produced by StockChief Inventory and has not been sent to the supplier.
  </div>
</div>
