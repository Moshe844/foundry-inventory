<p class="rm-stamp"><a href="<%= supplierReturn.purchase_order_id?'/purchasing/orders/'+supplierReturn.purchase_order_id:'/purchasing' %>"><%= supplierReturn.po_number || 'Purchasing' %></a> · <%= supplierReturn.supplier_name %></p>
<h1 class="rm-verdict"><%= supplierReturn.return_number %> is <%= supplierReturn.status.replaceAll('_',' ').toLowerCase() %>.</h1>
<p class="rm-prose">Physical shipment and supplier credit are deliberately separate. Stock changes only when the goods leave; the bill changes only when the supplier credit is recorded.</p>

<div class="rm-ledger"><% supplierReturn.lines.forEach(function(line){ %><div class="rm-ledger__row"><span class="rm-ledger__k"><%= line.item_name %><%= line.variant_label?' / '+line.variant_label:'' %><small><%= line.code %> · from <%= line.location_name %></small></span><span class="rm-ledger__v"><%= line.quantity %> units</span><span class="rm-ledger__n"><%= line.movementIds.length?'shipped':'not shipped' %></span></div><% }) %></div>

<section class="section"><div class="section-head"><h2>Next controlled step</h2></div>
  <% if(supplierReturn.status==='REQUESTED'){ %><p class="rm-sub">Authorization confirms what may leave. Stock and the supplier bill remain unchanged.</p><form method="post" action="/supplier-returns/<%= supplierReturn.id %>/authorize"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="idempotencyKey" value="<%= formKey %>-authorize"><button class="rm-btn" type="submit">Authorize supplier return</button></form>
  <% } else if(supplierReturn.status==='AUTHORIZED'){ %><p class="rm-sub">Record shipment only when custody actually leaves the business. This removes both units and their exact inventory cost.</p><form method="post" action="/supplier-returns/<%= supplierReturn.id %>/ship" class="inline-form"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="idempotencyKey" value="<%= formKey %>-ship"><label>Shipment date<input type="date" name="shippedAt" value="<%= today %>"></label><button class="rm-btn" type="submit">Record goods shipped to supplier</button></form>
  <% } else if(supplierReturn.status==='AWAITING_CREDIT'){ %><p class="rm-sub">The goods and inventory cost have left. Enter the supplier's actual credit exactly; StockChief will compare it with the expected <%= helpers.money(Number(supplierReturn.expected_credit_minor||0),supplierReturn.currency||'USD') %>.</p><form method="post" action="/supplier-returns/<%= supplierReturn.id %>/reconcile" class="inline-form"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="idempotencyKey" value="<%= formKey %>-reconcile"><label>Actual supplier credit<input type="number" name="amount" min="0.01" step="0.01" required></label><label>Credit memo number<input name="creditNumber" required></label><label>Credit date<input type="date" name="creditDate" value="<%= today %>"></label><button class="rm-btn" type="submit">Record and reconcile credit</button></form>
  <% } else if(supplierReturn.status==='CREDIT_MISMATCH'){ %><div class="notice notice--warning"><strong>Supplier credit differs from the expected amount.</strong><br>Expected <%= helpers.money(Number(supplierReturn.expected_credit_minor||0),supplierReturn.currency||'USD') %>; actual <%= helpers.money(Number(supplierReturn.actual_credit_minor||0),supplierReturn.currency||'USD') %>. The credit is recorded, but this remains an exception.</div>
  <% } else { %><div class="quiet-note">The physical return and supplier credit are reconciled. Inventory will not move again.</div><% } %>
</section>

<section class="section"><div class="section-head"><h2>Verified separation</h2></div><div class="rm-ledger"><div class="rm-ledger__row"><span class="rm-ledger__k">Physical goods<small>Inventory ledger</small></span><span class="rm-ledger__v"><%= supplierReturn.shipped_at?'left '+supplierReturn.shipped_at:'not shipped' %></span><span class="rm-ledger__n"><%= supplierReturn.lines.reduce((sum,line)=>sum+Number(line.quantity),0) %> units</span></div><div class="rm-ledger__row"><span class="rm-ledger__k">Supplier credit<small>Accounts payable</small></span><span class="rm-ledger__v"><%= supplierReturn.supplier_credit_id?'recorded':'outstanding' %></span><span class="rm-ledger__n"><%= supplierReturn.actual_credit_minor==null?'—':helpers.money(Number(supplierReturn.actual_credit_minor),supplierReturn.currency||'USD') %></span></div></div></section>
