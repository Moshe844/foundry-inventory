<div class="page-head">
  <div class="titles">
    <a class="back-link" href="/suppliers"><%- helpers.icon('chevron', { size: 14 }) %> Suppliers</a>
    <h1><%= supplier.name %></h1>
    <div class="page-sub">
      <%= supplier.contactName || 'No contact on file' %>
      <% if (supplier.email) { %> · <%= supplier.email %><% } %>
      <% if (supplier.defaultLeadTimeDays !== null) { %> · usually <%= supplier.defaultLeadTimeDays %> days<% } %>
    </div>
  </div>
</div>

<%
  var activeSupplierItems = items.filter(function(item) { return item.isActive; });
  var connectedMailboxes = mailboxConnections.filter(function(connection) { return connection.status === 'connected'; });
  var supplierSetupSteps = [
    { done: !!supplier.email, title: 'Add the supplier email', detail: supplier.email || 'Where Foundry sends orders and which sender it can recognize.', href: '#communication' },
    { done: activeSupplierItems.length > 0, title: 'Link what you buy', detail: activeSupplierItems.length ? activeSupplierItems.length + ' product' + (activeSupplierItems.length === 1 ? '' : 's') + ' linked' : 'Choose a product, supplier code, pack size, and cost.', href: '#link-product' },
    { done: connectedMailboxes.length > 0, title: 'Connect the mailbox Foundry watches', detail: connectedMailboxes.length ? connectedMailboxes.map(function(connection) { return connection.display_name; }).join(', ') : 'Connect Gmail or Microsoft 365 for this inventory.', href: '/settings/connections#supplier-communication' },
    { done: senderRules.length > 0 && !!supplier.watchedConnectorId, title: 'Approve this supplier\'s sender', detail: senderRules.length ? senderRules.map(function(rule) { return rule.sender_pattern; }).join(', ') : 'Choose the mailbox and exact sender Foundry may treat as supplier evidence.', href: '#communication' },
    { done: true, title: 'Choose what Foundry may do', detail: supplier.autoSendEnabled ? 'Routine orders may send automatically up to ' + supplier.currency + ' ' + Number(supplier.autoSendLimit || 0).toFixed(2) : 'Safe default: Foundry prepares messages and asks before sending.', href: '#routine-work' },
    { done: orders.length > 0, title: 'Create the first purchase order', detail: orders.length ? orders.length + ' purchase order' + (orders.length === 1 ? '' : 's') + ' on record' : 'Make one small order to test the complete supplier workflow.', href: '/purchasing/orders/new?supplier=' + supplier.id }
  ];
  var currentSupplierSetupIndex = supplierSetupSteps.findIndex(function(step) { return !step.done; });
  var supplierSetupComplete = currentSupplierSetupIndex === -1;
  var currentSupplierSetup = supplierSetupComplete ? null : supplierSetupSteps[currentSupplierSetupIndex];
  var supplierSenderReady = senderRules.length > 0 && !!supplier.watchedConnectorId;
%>

<section class="setup-journey" id="supplier-setup">
  <div class="setup-journey__head">
    <div class="setup-journey__head-copy">
      <span class="setup-journey__eyebrow">Supplier setup</span>
      <h1><%= supplierSetupComplete ? supplier.name + ' is ready' : 'Set up ' + supplier.name %></h1>
      <p><%= supplierSetupComplete
        ? 'Foundry can prepare orders, watch the approved sender, understand purchasing documents, and keep this supplier\'s purchase orders current.'
        : 'Work from top to bottom. Foundry highlights one thing to do now and keeps every later step visible, so you never have to guess where setup continues.' %></p>
    </div>
  </div>
  <div class="setup-steps">
    <% supplierSetupSteps.forEach(function(step, index) { var isCurrent = index === currentSupplierSetupIndex; %>
      <div class="setup-step <%= step.done ? 'setup-step--done' : isCurrent ? 'setup-step--current' : '' %>">
        <span class="setup-step__number"><%= step.done ? '✓' : index + 1 %></span>
        <div><strong><%= step.title %></strong><p><%= step.detail %></p></div>
        <span class="setup-step__state"><%= step.done ? 'Done' : isCurrent ? 'Do this now' : 'Next' %></span>
      </div>
    <% }) %>
  </div>
  <% if (currentSupplierSetup && currentSupplierSetup.href.charAt(0) !== '#') { %>
    <div class="setup-journey__action"><a class="btn btn--primary" href="<%= currentSupplierSetup.href %>"><%= currentSupplierSetup.title %></a></div>
  <% } %>
</section>

<% if (priceHistory.length) { %>
  <div class="card section">
    <div class="card-head"><div><h2>Price evidence</h2><p class="muted">Trusted supplier documents, kept as purchasing history—not accounting entries.</p></div></div>
    <div class="table-scroll"><table class="table table--tight"><thead><tr><th>Product</th><th>Observed</th><th class="num">Unit cost</th></tr></thead><tbody>
      <% priceHistory.forEach(function(entry) { %><tr><td><%= entry.item_name %> · <span class="mono"><%= entry.sku_code %></span></td><td class="muted"><%= helpers.dateTime(entry.observed_at) %></td><td class="num"><%= entry.currency %> <%= Number(entry.unit_cost).toFixed(2) %></td></tr><% }) %>
    </tbody></table></div>
  </div>
<% } %>

<div class="card section" id="communication">
  <div class="card-head">
    <div><h2>Supplier email</h2><p class="muted">Set where orders go, which mailbox Foundry watches, and exactly which sender is trusted.</p></div>
  </div>
  <div class="card-body grid">
    <% if (permissions.suppliers) { %>
      <% if (!supplier.email) { %>
        <form method="post" action="/suppliers/<%= supplier.id %>" class="guided-setup-form guided-setup-form--current">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <label class="field">
            <span class="field-label">Where should Foundry send this supplier's orders?</span>
            <div class="field-row">
              <input class="input" type="email" name="email" maxlength="160" placeholder="orders@abcapparel.com" required autofocus>
              <button class="btn btn--primary" type="submit">Save supplier email</button>
            </div>
            <span class="field-help">Use the supplier's address—not your connected Gmail or Microsoft mailbox.</span>
          </label>
        </form>
      <% } else { %>
        <div class="list-row"><div><strong>Supplier address</strong><p><%= supplier.email %></p></div><span class="badge badge--ok">Done</span></div>
      <% } %>

      <% if (!connectedMailboxes.length) { %>
        <div class="guided-setup-form <%= supplier.email && activeSupplierItems.length ? 'guided-setup-form--current' : 'guided-setup-form--locked' %>">
          <strong>Connect the mailbox Foundry should watch</strong>
          <p class="muted">No Gmail or Microsoft 365 mailbox is connected to this inventory yet. Connections are separate for each inventory.</p>
          <div class="form-actions"><a class="btn <%= supplier.email && activeSupplierItems.length ? 'btn--primary' : '' %>" href="/settings/connections#supplier-communication">Connect Gmail or Microsoft 365</a></div>
        </div>
      <% } else if (!supplierSenderReady) { %>
        <div class="list-row"><div><strong>Mailbox Foundry watches</strong><p><%= connectedMailboxes.map(function(connection) { return connection.display_name; }).join(', ') %></p></div><span class="badge badge--ok">Connected</span></div>
        <form method="post" action="/suppliers/<%= supplier.id %>/senders" class="guided-setup-form guided-setup-form--current">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <input type="hidden" name="connectorId" value="<%= connectedMailboxes[0].id %>">
          <input type="hidden" name="senderPattern" value="<%= supplier.email %>">
          <strong>Approve <%= supplier.name %>'s sender</strong>
          <p class="muted"><strong><%= supplier.email %></strong> → <%= connectedMailboxes[0].display_name %></p>
          <p class="muted">Only messages from this address will become supplier evidence. Everything else in the inbox stays outside purchasing.</p>
          <div class="form-actions"><button class="btn btn--primary" type="submit">Start watching this sender</button></div>
        </form>
      <% } else { %>
        <% senderRules.forEach(function(rule) { %><div class="list-row"><div><strong>Watching <%= rule.sender_pattern %></strong><p>Supplier messages arrive through <%= rule.connection_name %></p></div><span class="badge badge--ok">Ready</span></div><% }) %>
      <% } %>
    <% } %>
  </div>
</div>

<% if (permissions.suppliers && supplierSenderReady) { %>
  <form method="post" action="/suppliers/<%= supplier.id %>" class="card section" id="routine-work">
    <div class="card-head"><div><h2>What may Foundry do?</h2><p class="muted">The safe default is to prepare the work and ask before anything is sent. Change only the authority you want to grant.</p></div></div>
    <div class="card-body grid grid--2">
      <input type="hidden" name="prepareCommunications" value="0">
      <label class="field"><span class="field-label">Prepare messages</span><label><input type="checkbox" name="prepareCommunications" value="1" <%= supplier.prepareCommunications ? 'checked' : '' %>> Prepare routine order and follow-up emails for me</label></label>
      <input type="hidden" name="autoSendEnabled" value="0">
      <label class="field"><span class="field-label">Send automatically</span><label><input type="checkbox" name="autoSendEnabled" value="1" <%= supplier.autoSendEnabled ? 'checked' : '' %>> Send routine approved orders and follow-up emails automatically</label><span class="field-help">Orders still respect your spending limit. Leave unchecked and Foundry prepares the email, then asks you before sending.</span></label>
      <label class="field"><span class="field-label">Automatic order limit</span><input class="input" type="number" min="0" step="0.01" name="autoSendLimit" value="<%= supplier.autoSendLimit === null ? '' : supplier.autoSendLimit %>" placeholder="500.00"><span class="field-help">Orders above this amount wait for your approval.</span></label>
      <label class="field"><span class="field-label">Ask if a price changes by more than</span><div class="field-row"><input class="input" type="number" min="0" max="100" step="0.1" name="priceTolerancePercent" value="<%= supplier.priceTolerancePercent %>"><span>%</span></div></label>
      <label class="field"><span class="field-label">Follow up if there is no reply after</span><div class="field-row"><input class="input" type="number" min="1" max="60" name="followUpDays" value="<%= supplier.followUpDays %>"><span>days</span></div><span class="field-help">Foundry waits this long after the order or latest supplier reply. It then prepares a concise status request; automatic sending follows the choice above.</span></label>
    </div>
    <div class="card-foot"><button class="btn" type="submit">Save supplier rules</button></div>
  </form>
<% } %>

<div class="card section">
  <div class="card-head">
    <h2>Products they supply</h2>
    <span class="spacer"></span>
    <span class="badge badge--muted"><%= items.filter(function (i) { return i.isActive; }).length %> linked</span>
  </div>
  <% if (items.length === 0) { %>
    <div class="card-body">
      <p class="muted">
        Nothing linked yet. Foundry needs to know what this supplier calls a product, how they pack it and
        what it costs before it can work out an order.
      </p>
    </div>
  <% } else { %>
    <div class="table-scroll">
      <table class="table table--tight">
        <thead>
          <tr><th>Product</th><th><%= supplier.itemCodeLabel %> (vendor)</th><th>Your code</th><th>Pack</th><th class="num">Unit cost</th><th class="num">Lead time</th><th>Minimum</th><th></th></tr>
        </thead>
        <tbody>
          <% items.forEach(function (item) { %>
            <tr class="<%= item.isActive ? '' : 'muted' %>">
              <td>
                <%= item.displayName %>
                <% if (item.isPreferred) { %><span class="badge badge--ok">preferred</span><% } %>
                <% if (!item.isActive) { %><span class="badge badge--muted">removed</span><% } %>
              </td>
              <td class="muted"><%= item.supplierSku || '—' %></td>
              <td class="mono"><%= item.internalCode || '—' %></td>
              <td><%= item.unitsPerPurchaseUnit > 1 ? item.purchaseUnit + ' of ' + item.unitsPerPurchaseUnit : item.purchaseUnit %></td>
              <td class="num"><%= item.lastUnitCost === null ? '—' : item.lastUnitCost %></td>
              <td class="num"><%= item.effectiveLeadTimeDays === null ? '—' : item.effectiveLeadTimeDays + ' days' %></td>
              <td class="muted">
                <%= item.minimumOrderQuantity ? item.minimumOrderQuantity + ' ' + item.purchaseUnit + '(s)' : '—' %>
                <% if (item.orderMultiple && item.orderMultiple > 1) { %> · in <%= item.orderMultiple %>s<% } %>
              </td>
              <td>
                <% if (permissions.suppliers && item.isActive) { %>
                  <form method="post" action="/suppliers/<%= supplier.id %>/items/<%= item.id %>/remove">
                    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                    <button class="btn btn--sm btn--ghost" type="submit">Remove</button>
                  </form>
                <% } %>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  <% } %>
</div>

<div class="card section" id="code-mappings">
  <div class="card-head">
    <div>
      <h2>Vendor codes → your codes</h2>
      <p class="muted">Keep the code printed on this vendor's invoices for matching, while Foundry uses the code you choose inside your inventory.</p>
    </div>
  </div>
  <% if (codeMappings.length === 0) { %>
    <div class="card-body">
      <p class="muted">No vendor product codes are linked yet. When Foundry reads one from an invoice, it will appear here.</p>
    </div>
  <% } else { %>
    <div class="card-body">
      <% codeMappings.forEach(function (mapping) { %>
        <div class="proposal-block">
          <div class="proposal-label"><%= mapping.itemName %></div>
          <div class="proposal-body">
            <div class="document-facts">
              <div>
                <span><%= supplier.itemCodeLabel %> from vendor</span>
                <strong class="mono"><%= mapping.vendorCode %></strong>
              </div>
              <div>
                <span>Your current product code</span>
                <strong class="mono"><%= mapping.currentInternalBaseCode || 'Not set' %></strong>
              </div>
              <div>
                <span>Linked inventory</span>
                <strong><%= mapping.linkedVariants %> variant<%= mapping.linkedVariants === 1 ? '' : 's' %></strong>
              </div>
              <div>
                <span>Future invoices</span>
                <strong><%= mapping.rememberedInternalBaseCode ? 'Mapping remembered' : 'Vendor code retained' %></strong>
              </div>
            </div>
            <% if (mapping.rememberedInternalBaseCode) { %>
              <div class="badge-row"><span class="badge badge--ok">Remembered for future invoices</span></div>
            <% } %>
            <% if (permissions.suppliers) { %>
              <form method="post" action="/suppliers/<%= supplier.id %>/code-mappings" style="margin-top:14px;">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                <input type="hidden" name="vendorCode" value="<%= mapping.vendorCode %>">
                <label class="field">
                  <span class="field-label">Use this as my product code</span>
                  <div class="field-row">
                    <input class="input mono" type="text" name="internalBaseCode" maxlength="60"
                           value="<%= mapping.currentInternalBaseCode || '' %>" required>
                    <button class="btn btn--primary" type="submit">Preview change</button>
                  </div>
                  <span class="field-help">Foundry will show every affected variant before changing anything.</span>
                </label>
              </form>
            <% } %>
          </div>
        </div>
      <% }) %>
    </div>
  <% } %>
</div>

<% if (permissions.suppliers) { %>
  <form method="post" action="/suppliers/<%= supplier.id %>/items" class="card section" id="link-product">
    <div class="card-head"><h2>Link a product</h2></div>
    <div class="card-body">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <div class="grid grid--2">
        <label class="field">
          <span class="field-label">Product</span>
          <select class="input" name="skuId" required>
            <% catalogue.forEach(function (sku) { %>
              <option value="<%= sku.id %>"><%= sku.variant_label ? sku.item_name + ' / ' + sku.variant_label : sku.item_name %></option>
            <% }) %>
          </select>
        </label>
        <label class="field">
          <span class="field-label"><%= supplier.itemCodeLabel %></span>
          <input class="input" type="text" name="supplierSku" maxlength="80" placeholder="OX-NV-08">
        </label>
        <label class="field">
          <span class="field-label">Sold in</span>
          <input class="input" type="text" name="purchaseUnit" maxlength="40" placeholder="case">
          <span class="field-help">The unit they sell in. Leave as "unit" if they sell them singly.</span>
        </label>
        <label class="field">
          <span class="field-label">How many per pack</span>
          <input class="input" type="number" min="1" name="unitsPerPurchaseUnit" value="1">
        </label>
        <label class="field">
          <span class="field-label">Cost per <%= 'unit' %></span>
          <input class="input" type="text" name="lastUnitCost" placeholder="8.20">
          <span class="field-help">Per item, not per pack, so suppliers who pack differently can be compared.</span>
        </label>
        <label class="field">
          <span class="field-label">Lead time (days)</span>
          <input class="input" type="number" min="0" max="365" name="leadTimeDays"
                 placeholder="<%= supplier.defaultLeadTimeDays === null ? '' : supplier.defaultLeadTimeDays %>">
        </label>
        <label class="field">
          <span class="field-label">Minimum order (packs)</span>
          <input class="input" type="number" min="0" name="minimumOrderQuantity" placeholder="2">
        </label>
        <label class="field">
          <span class="field-label">Order multiple (packs)</span>
          <input class="input" type="number" min="1" name="orderMultiple" placeholder="1">
        </label>
      </div>
      <label class="field">
        <input type="checkbox" name="isPreferred" value="1"> Preferred supplier for this product
      </label>
    </div>
    <div class="card-foot">
      <button class="btn btn--primary" type="submit">Link product</button>
    </div>
  </form>
<% } %>

<div class="card section">
  <div class="card-head"><h2>Recent orders</h2></div>
  <% if (orders.length === 0) { %>
    <div class="card-body"><p class="muted">No orders with this supplier yet.</p></div>
  <% } else { %>
    <table class="table table--tight">
      <thead><tr><th>Order</th><th>Status</th><th>Expected</th><th class="num">Units</th><th class="num">Total</th></tr></thead>
      <tbody>
        <% orders.forEach(function (po) { %>
          <tr>
            <td><a href="/purchasing/orders/<%= po.id %>"><%= po.poNumber %></a></td>
            <td><span class="badge badge--muted"><%= helpers.columnLabel(po.status.toLowerCase().replace('_', ' ')) %></span></td>
            <td class="muted"><%= po.expectedDate || '—' %></td>
            <td class="num"><%= po.receivedUnits %>/<%= po.orderedUnits %></td>
            <td class="num"><%= po.hasCosts ? po.subtotal.toFixed(2) : '—' %></td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  <% } %>
</div>

<% if (permissions.suppliers) { %>
  <form method="post" action="/suppliers/<%= supplier.id %>" class="card section">
    <div class="card-head"><h2>Details</h2></div>
    <div class="card-body">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <div class="grid grid--2">
        <label class="field">
          <span class="field-label">Name</span>
          <input class="input" type="text" name="name" value="<%= supplier.name %>" maxlength="160">
        </label>
        <label class="field">
          <span class="field-label">What should Foundry call this vendor's product identifier?</span>
          <input class="input" type="text" name="itemCodeLabel" value="<%= supplier.itemCodeLabel %>" maxlength="60" required>
          <span class="field-help">For example: Style #, Item No., Vendor SKU, or Catalogue number. Foundry uses your chosen name everywhere for <%= supplier.name %>, while still recognizing the other headings it has seen on that vendor's documents.</span>
        </label>
        <label class="field">
          <span class="field-label">Contact</span>
          <input class="input" type="text" name="contactName" value="<%= supplier.contactName || '' %>" maxlength="120">
        </label>
        <label class="field">
          <span class="field-label">Email</span>
          <input class="input" type="email" name="email" value="<%= supplier.email || '' %>" maxlength="160">
        </label>
        <label class="field">
          <span class="field-label">Phone</span>
          <input class="input" type="text" name="phone" value="<%= supplier.phone || '' %>" maxlength="60">
        </label>
        <label class="field">
          <span class="field-label">Usual lead time (days)</span>
          <input class="input" type="number" min="0" max="365" name="defaultLeadTimeDays"
                 value="<%= supplier.defaultLeadTimeDays === null ? '' : supplier.defaultLeadTimeDays %>">
        </label>
        <label class="field">
          <span class="field-label">Preferred ordering method</span>
          <select class="input" name="preferredOrderingMethod">
            <option value="email" <%= supplier.preferredOrderingMethod === 'email' ? 'selected' : '' %>>Email</option>
            <option value="supplier portal" <%= supplier.preferredOrderingMethod === 'supplier portal' ? 'selected' : '' %>>Supplier portal</option>
            <option value="phone" <%= supplier.preferredOrderingMethod === 'phone' ? 'selected' : '' %>>Phone</option>
            <option value="edi" <%= supplier.preferredOrderingMethod === 'edi' ? 'selected' : '' %>>EDI / system connection</option>
          </select>
        </label>
        <label class="field">
          <span class="field-label">Status</span>
          <select class="input" name="status">
            <option value="active" <%= supplier.status === 'active' ? 'selected' : '' %>>Active</option>
            <option value="inactive" <%= supplier.status === 'inactive' ? 'selected' : '' %>>Inactive</option>
          </select>
        </label>
      </div>
      <% if (supplier.itemCodeAliases.length) { %>
        <p class="hint" style="margin-top:12px;">Foundry remembers these headings as the same vendor-code field: <%= supplier.itemCodeAliases.join(', ') %>. You will not have to map them again on future documents.</p>
      <% } %>
      <details style="margin-top:18px;">
        <summary><strong>Advanced supplier settings</strong></summary>
        <div class="grid grid--2" style="margin-top:14px;">
          <label class="field"><span class="field-label">Quantity-change tolerance (%)</span><input class="input" type="number" min="0" max="100" step="0.1" name="quantityTolerancePercent" value="<%= supplier.quantityTolerancePercent %>"></label>
          <label class="field"><span class="field-label">Supplier minimum order value</span><input class="input" type="number" min="0" step="0.01" name="minimumOrderAmount" value="<%= supplier.minimumOrderAmount === null ? '' : supplier.minimumOrderAmount %>" placeholder="250.00"></label>
          <label class="field"><span class="field-label">Currency</span><input class="input" type="text" maxlength="3" name="currency" value="<%= supplier.currency %>" placeholder="USD"></label>
          <label class="field"><span class="field-label">Payment / reference terms</span><input class="input" type="text" maxlength="160" name="paymentTerms" value="<%= supplier.paymentTerms || '' %>" placeholder="Net 30 · account 12345"></label>
          <input type="hidden" name="trustedDeliveryReceipt" value="0">
          <label class="field"><span class="field-label">Trusted delivery confirmation</span><label><input type="checkbox" name="trustedDeliveryReceipt" value="1" <%= supplier.trustedDeliveryReceipt ? 'checked' : '' %>> Book in exact, untracked PO lines automatically when this approved sender confirms delivery</label><span class="field-help">Advanced. Foundry still refuses unknown items, missing quantities, over-receipts, lots, serials, or unmatched orders and asks you instead.</span></label>
        </div>
        <p class="hint">Supplier email can provide purchasing evidence, but it cannot change authority or increase on-hand inventory.</p>
      </details>
    </div>
    <div class="card-foot"><button class="btn" type="submit">Save</button></div>
  </form>
<% } %>
