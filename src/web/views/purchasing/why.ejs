<div class="page-head">
  <div class="titles">
    <a class="back-link" href="/purchasing"><%- helpers.icon('chevron', { size: 14 }) %> What to order</a>
    <h1><%= line.displayName %></h1>
    <div class="page-sub"><%= line.headline %></div>
  </div>
</div>

<%# Landing here from a line that is short but has nobody to buy it from used
    to be the end of the road: this page is the arithmetic, and the arithmetic
    was never the problem. %>
<% if (line.reason === 'no_supplier') { %>
  <div class="card section" style="border-color:var(--accent-line);">
    <div class="card-head">
      <%- helpers.icon('alert', { size: 18 }) %>
      <h2>Foundry cannot order this yet</h2>
    </div>
    <div class="card-body">
      <p class="lede" style="margin-top:0;">
        The numbers below are settled — <%= line.displayName %> is
        <strong><%= line.shortfall %></strong> short. What is missing is who you buy it from.
      </p>
      <a class="btn btn--primary" href="/purchasing/supplier-for/<%= line.skuId %>">
        Add the supplier for <%= line.displayName %>
      </a>
    </div>
  </div>
<% } %>

<div class="card section">
  <div class="card-head">
    <h2><%= line.recommend ? 'Why this quantity' : 'Why nothing' %></h2>
    <span class="spacer"></span>
    <% if (line.recommend) { %>
      <span class="badge badge--muted">
        <%= helpers.unitCount(line.quantityUnits, line.unitLabel) %>
      </span>
    <% } else { %>
      <span class="badge badge--ok">No order</span>
    <% } %>
  </div>
  <div class="card-body">
    <p class="lede"><%= line.explanation %></p>

    <h3 class="sub-head">The figures</h3>
    <table class="table table--tight">
      <tbody>
        <% line.evidence.forEach(function (row) { %>
          <tr>
            <td><%= row.label %></td>
            <td class="num"><%= row.value %></td>
            <td class="muted"><%= row.note || '' %></td>
          </tr>
        <% }) %>
      </tbody>
    </table>

    <% if (line.calculation && line.calculation.length) { %>
      <h3 class="sub-head">The calculation, step by step</h3>
      <ol class="plain-list">
        <% line.calculation.forEach(function (step) { %>
          <li><%= step.detail %></li>
        <% }) %>
      </ol>
    <% } %>

    <% if (line.supplierChoice && line.alternatives && line.alternatives.length) { %>
      <h3 class="sub-head">Supplier</h3>
      <p><%= line.supplierChoice.because %>.</p>
      <table class="table table--tight">
        <thead><tr><th>Supplier</th><th class="num">Unit cost</th><th class="num">Lead time</th><th>Pack</th></tr></thead>
        <tbody>
          <% if (line.supplier) { %>
            <tr>
              <td><strong><%= line.supplier.supplierName %></strong> <span class="badge badge--ok">chosen</span></td>
              <td class="num"><%= line.supplier.unitCost === null ? '—' : line.supplier.unitCost %></td>
              <td class="num"><%= line.supplier.leadTimeDays === null ? '—' : line.supplier.leadTimeDays + ' days' %></td>
              <td class="muted"><%= line.supplier.unitsPerPurchaseUnit > 1 ? line.supplier.purchaseUnit + ' of ' + line.supplier.unitsPerPurchaseUnit : line.supplier.purchaseUnit %></td>
            </tr>
          <% } %>
          <% line.alternatives.forEach(function (option) { %>
            <tr>
              <td><%= option.supplierName %></td>
              <td class="num"><%= option.lastUnitCost === null ? '—' : option.lastUnitCost %></td>
              <td class="num"><%= option.effectiveLeadTimeDays === null ? '—' : option.effectiveLeadTimeDays + ' days' %></td>
              <td class="muted"><%= option.unitsPerPurchaseUnit > 1 ? option.purchaseUnit + ' of ' + option.unitsPerPurchaseUnit : option.purchaseUnit %></td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    <% } %>
  </div>
</div>

<% if (history.length) { %>
  <div class="card section">
    <div class="card-head"><h2>What it has cost</h2></div>
    <table class="table table--tight">
      <thead><tr><th>Order</th><th>Supplier</th><th class="num">Unit cost</th><th>When</th></tr></thead>
      <tbody>
        <% history.forEach(function (row) { %>
          <tr>
            <td><a href="/purchasing/orders/<%= row.poId %>"><%= row.poNumber %></a></td>
            <td><%= row.supplierName %></td>
            <td class="num"><%= row.unitCost %></td>
            <td class="muted"><%= (row.orderDate || '').slice(0, 10) %></td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
<% } %>

<div class="card section" id="reorder-settings">
  <div class="card-head">
    <h2>Reorder settings</h2>
    <span class="spacer"></span>
    <span class="badge badge--<%= policy.isSet ? 'muted' : 'ok' %>">
      <%= policy.isSet ? 'Set by ' + (policy.source === 'foundry' ? 'Foundry' : 'you') : 'Worked out from usage' %>
    </span>
  </div>
  <div class="card-body">
    <% if (rulePreview && rulePreview.kind === 'reorder') { %>
      <div class="notice notice--info">
        <div>
          <strong>Foundry understood this rule for <%= rulePreview.displayName %>:</strong>
          reorder at <strong><%= rulePreview.reorderPoint %></strong> and bring the inventory position back to <strong><%= rulePreview.targetStock %></strong>.
          Nothing changes until you save it below.
        </div>
      </div>
    <% } %>
    <% if (!policy.isSet && proposal && proposal.canPropose) { %>
      <p class="muted">
        Foundry has no settings for this line and works the figures out from usage each time.
        From what it has seen it would suggest a reorder point of <strong><%= proposal.proposal.reorderPoint %></strong>
        and a target of <strong><%= proposal.proposal.targetStock %></strong>.
      </p>
    <% } else if (!policy.isSet && proposal && !proposal.canPropose) { %>
      <p class="muted"><%= proposal.because %></p>
    <% } %>

    <% if (permissions.replenishment) { %>
      <form method="post" action="/purchasing/policies/<%= line.skuId %>">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <div class="grid grid--3">
          <label class="field">
            <span class="field-label">Reorder point</span>
            <input class="input" type="number" min="0" name="reorderPoint"
                   value="<%= rulePreview && rulePreview.kind === 'reorder' ? rulePreview.reorderPoint : policy.reorderPoint === null ? '' : policy.reorderPoint %>"
                   placeholder="<%= line.reorderPoint === undefined ? '' : line.reorderPoint %>">
          </label>
          <label class="field">
            <span class="field-label">Order up to</span>
            <input class="input" type="number" min="0" name="targetStock"
                   value="<%= rulePreview && rulePreview.kind === 'reorder' ? rulePreview.targetStock : policy.targetStock === null ? '' : policy.targetStock %>"
                   placeholder="<%= line.target === undefined ? '' : line.target %>">
          </label>
          <label class="field">
            <span class="field-label">Safety stock</span>
            <input class="input" type="number" min="0" name="safetyStock"
                   value="<%= policy.safetyStock === null ? '' : policy.safetyStock %>"
                   placeholder="<%= line.safetyStock === undefined ? '' : line.safetyStock %>">
          </label>
        </div>
        <div class="btn-row">
          <button class="btn btn--primary" type="submit">Save settings</button>
        </div>
      </form>

      <%# Discarding settings somebody typed is its own act, in its own form.
          It used to sit beside Save as "Go back to working it out", which reads
          like a way back to the calculation rather than the deletion of the
          numbers you had just entered — and it deleted them without asking. %>
      <% if (policy.isSet) { %>
        <form method="post" action="/purchasing/policies/<%= line.skuId %>" class="reorder-clear"
              data-confirm="Discard your reorder settings for <%= line.displayName %>? Foundry will go back to working the levels out from usage, and it needs enough sales history to do that.">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <input type="hidden" name="clear" value="1">
          <p class="muted" style="margin:14px 0 6px;">
            Your own levels are in use for this line. Foundry will not change them.
          </p>
          <button class="btn btn--ghost btn--sm" type="submit">Discard my settings for this line</button>
        </form>
      <% } %>
    <% } %>
  </div>
</div>

<div class="card section" id="location-minimums">
  <div class="card-head"><h2>Location minimums</h2><span class="spacer"></span><span class="badge badge--muted">Advanced</span></div>
  <div class="card-body">
    <p class="muted">A location minimum is a hard keep-back level. Foundry will not transfer this variant below it.</p>
    <% if (rulePreview && rulePreview.kind === 'location_minimum') { %>
      <div class="notice notice--info"><div>
        <strong>Foundry understood:</strong> keep at least <strong><%= rulePreview.minimum %></strong> of
        <%= rulePreview.displayName %> at <strong><%= rulePreview.locationName %></strong>.
        Nothing changes until you save it below.
      </div></div>
    <% } %>
    <% if (permissions.replenishment) { %>
      <form method="post" action="/purchasing/location-minimums/<%= line.skuId %>">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <div class="grid grid--2">
          <label class="field"><span class="field-label">Location</span>
            <select class="input" name="locationId" required>
              <% locations.forEach(function (location) { %><option value="<%= location.id %>" <%= rulePreview && rulePreview.locationId === location.id ? 'selected' : '' %>><%= location.name %></option><% }) %>
            </select>
          </label>
          <label class="field"><span class="field-label">Always keep at least</span>
            <input class="input" type="number" min="0" name="minimum" value="<%= rulePreview && rulePreview.kind === 'location_minimum' ? rulePreview.minimum : '' %>" placeholder="0">
          </label>
        </div>
        <button class="btn btn--primary" type="submit">Save location minimum</button>
      </form>
    <% } %>
    <% if (locationPolicies.length) { %>
      <ul class="plain-list"><% locationPolicies.forEach(function (entry) { %><li><strong><%= entry.locationName %>:</strong> keep at least <%= entry.minimum %></li><% }) %></ul>
    <% } %>
  </div>
</div>
