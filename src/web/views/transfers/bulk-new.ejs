<div class="page-head"><div><h1>Request selected stock to move</h1><p>Choose exact quantities and locations. This prepares a transfer; physical stock moves only through its normal approval, dispatch and receipt steps.</p></div></div>
<% if(locations.length<2){ %><p>Add a second real location before requesting a transfer. <a href="/locations">Manage locations</a></p><% }else{ %>
<section class="card card-body"><form method="post" action="/transfers" class="stack-form"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="idempotencyKey" value="<%= operationKey %>">
<label class="field"><span>From</span><select class="select" name="fromLocationId" required><option value="">Choose source</option><% locations.forEach(function(l){ %><option value="<%= l.id %>"><%= l.name %></option><% }); %></select></label><label class="field"><span>To</span><select class="select" name="toLocationId" required><option value="">Choose destination</option><% locations.forEach(function(l){ %><option value="<%= l.id %>"><%= l.name %></option><% }); %></select></label>
<% skus.forEach(function(s,index){ %><% if(s.tracking_mode==='quantity'){ %><label class="field"><span><%= s.item_name %><%= s.variant_label?' / '+s.variant_label:'' %> · <%= s.code %></span><input type="hidden" name="lines[<%= index %>][skuId]" value="<%= s.id %>"><input class="input" name="lines[<%= index %>][quantity]" type="number" min="0" step="1" placeholder="0"></label><% }else{ %><p><%= s.item_name %> needs exact serial or lot selection. <a href="/inventory/<%= s.item_id %>">Choose its tracked units</a>.</p><% } %><% }); %>
<label class="field"><span>Reference (optional)</span><input class="input" name="reference" maxlength="240"></label><button class="btn btn--primary" type="submit">Prepare this transfer</button></form></section><% } %>
