<%
  /*
   * Everything else.
   *
   * The redesign took eight departments off the main path. Nothing was
   * deleted — every screen kept its address — and this page is the promise
   * that made the consolidation honest, because a navigation that hides things
   * is worse than the sidebar it replaced.
   *
   * Grouped by the question each screen answers, not by the module it lives
   * in, and each group says plainly why it is not on the main path. If
   * somebody has to come here during ordinary work, that is a bug in the
   * screen they came from.
   */
%>

<p class="rm-stamp">More</p>
<h1 class="rm-figure">Explore StockChief</h1>
<p class="rm-sub">Everything outside your daily Home, Needs you and Ask flow, grouped by the part of your business it supports.</p>

<div class="rm-vault">
  <% sections.forEach(function (section) { %>
    <div class="rm-vault__grp">
      <p class="rm-vault__h"><%= section.title %></p>
      <p class="rm-vault__why"><%= section.why %></p>
      <div class="rm-vault__links">
        <% section.links.forEach(function (link) { %>
          <a href="<%= link.href %>"><%= link.label %></a>
        <% }) %>
      </div>
    </div>
  <% }) %>
</div>

<p class="rm-disclose">
  <a href="/">Back to Home</a>
  <a href="/what-you-told-me">What you've told me</a>
  <a href="/guide">How to use StockChief</a>
  <a href="/support">Support</a>
</p>
