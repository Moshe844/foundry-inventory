<% if(locals.editProposal&&proposal.status==='PENDING'){ %><section class="card" id="revise-proposal"><div class="card-body"><h2>Revise this instruction</h2><form method="post" action="/operating-instructions/<%= proposal.id %>/revise"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><label class="field"><span>Revised instruction</span><textarea name="message" required maxlength="10000" autofocus><%= proposal.statedAs %></textarea></label><button class="btn btn--primary" type="submit">Prepare revised instruction</button></form></div></section><% } %>
<section class="rm-head"><div><p class="rm-eyebrow">Standing instruction</p><h1><%= proposal.summary %></h1>
  <p class="rm-lede">You said: “<%= proposal.statedAs %>”</p></div><span class="rm-badge"><%= proposal.status %></span></section>

<section class="rm-card"><h2>Exact effect</h2>
  <% descriptions.forEach(function(description){ %><div class="rm-row"><span><strong><%= description %></strong></span></div><% }) %>
  <p class="rm-note"><%= proposal.status==='PENDING' ? 'These changes are prepared for approval. Preparing them does not change your business records.' : 'This records the changes included in the instruction. Its approval status is shown below.' %></p>
</section>

<% if(proposal.resolvedChanges.some(c=>c.notificationChannel==='email')){ %><section class="rm-card"><h2>Email delivery</h2><p>Approved notifications are sent once per threshold crossing through the selected mailbox. Paused automatic work, a disconnected mailbox or changed authority holds delivery.</p><% if(!(locals.notificationLog||[]).length){ %><p>No email delivery recorded.</p><% }else{ (locals.notificationLog||[]).forEach(function(entry){ %><div class="rm-row"><span><strong><%= entry.message_status==='SENT'?'Provider confirmed':entry.message_status==='FAILED'?'Delivery needs attention':entry.status==='HELD'?'Held':entry.status==='CANCELLED'?'Cancelled':'Queued' %></strong> · <%= helpers.dateTime(entry.sent_at||entry.created_at) %><% if(entry.last_error){ %><br><%= entry.last_error %><% } %></span><% if(entry.communication_id){ %><a href="/messages/<%= entry.communication_kind %>/<%= entry.communication_id %>">View email</a><% } %></div><% }); } %></section><% } %>

<% if(locals.nativeGoal&&['COMPLETED','CANCELLED','BLOCKED'].includes(nativeGoal.status)&&proposal.status==='PENDING'){ %>
  <section class="rm-card"><h2>This request is stopped</h2><p>The prepared rule has not taken effect. Continue or review the original request in Ask before deciding.</p><a class="rm-btn" href="/ask?goal=<%= encodeURIComponent(nativeGoal.id) %>#focused-goal">Return to this request</a></section>
<% } else if (proposal.status === 'PENDING' && proposal.questions.length) { %>
  <section class="rm-card"><h2>One detail is still needed</h2><p><%= proposal.questions[0] %></p>
    <form method="post" action="/operating-instructions/<%= proposal.id %>/answer" class="rm-form-grid">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="usageKey" value="<%= usageKey %>"><% if (fromAsk) { %><input type="hidden" name="fromAsk" value="1"><% } %><label>Your answer<input name="answer" required maxlength="500" autofocus></label>
      <div><button class="rm-btn" type="submit">Continue this instruction</button></div>
    </form></section>
<% } else if (proposal.status === 'PENDING') { %>
  <section class="rm-card"><h2>Turn this on?</h2><p>Approval applies only the exact records and limits shown above.</p>
    <div class="rm-actions"><form method="post" action="/operating-instructions/<%= proposal.id %>/approve">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="integrityHash" value="<%= proposal.integrityHash %>"><% if (fromAsk) { %><input type="hidden" name="fromAsk" value="1"><% } %>
      <button class="rm-btn" type="submit">Approve standing rule</button></form>
      <form method="post" action="/operating-instructions/<%= proposal.id %>/cancel"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><% if (fromAsk) { %><input type="hidden" name="fromAsk" value="1"><% } %>
        <button class="rm-btn rm-btn--quiet" type="submit">Discard</button></form></div>
  </section>
<% } else if (proposal.status === 'APPROVED') { %>
  <section class="rm-card"><h2>Approved changes</h2><p>Approved <time data-local-time datetime="<%= proposal.approvedAt %>"><%= helpers.dateTime(proposal.approvedAt) %></time>. Later instructions or settings changes may replace these changes.</p>
    <p>To change or stop this instruction, tell StockChief what you want. It will check the current settings and prepare any change for approval.</p>
    <a class="rm-btn rm-btn--ghost" href="/ask?from=<%= encodeURIComponent('/operating-instructions/'+proposal.id) %>">Request a change</a>
  </section>
<% } else { %><section class="rm-card"><p>This instruction is no longer in force.</p></section><% } %>
