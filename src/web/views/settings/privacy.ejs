<section class="rm-head"><div><p class="rm-eyebrow">Settings · Data</p><h1>Customer privacy requests</h1><p class="rm-lede">Provide customer exports, review deletion requests and record any legal retention requirement. These controls are available on every plan.</p></div></section>
<p><a href="/settings/privacy/access">Review personal data access</a> · <a href="/security/data-protection">Retention and data protection policy</a></p>
<p>To record a request for manual credit decisions, open <a href="/customers">Customers</a>, select the customer and use Customer privacy · Credit decisions. This control is available on every plan.</p>
<% if(!requests.length){ %><section class="rm-card"><h2>You’re up to date</h2><p>No Shopify customer privacy requests have been received for this inventory.</p></section><% } %>
<% requests.forEach(function(request){ %><section class="rm-card" style="margin-block:16px" aria-label="Customer privacy request">
 <div class="rm-card-head"><h2><%= request.topic==='customers/data_request'?'Customer data export':request.topic==='customers/redact'?'Delete customer personal data':'Delete connected store data' %></h2><span class="rm-badge"><%= ({PENDING:'Preparing',READY:'Ready to download',NEEDS_REVIEW:'Needs your review',HELD:'Legal retention hold',COMPLETED:'Completed'})[request.status] %></span></div>
 <p><strong><%= request.shop_domain %></strong></p><p class="rm-note">Received <%= new Date(request.received_at).toLocaleDateString('en-US') %> · Due <%= new Date(request.due_at).toLocaleDateString('en-US') %></p>
 <% if(request.result?.message){ %><p><%= request.result.message %></p><% } %>
 <% if(request.hold_reason){ %><p><strong>Legal retention reason:</strong> <%= request.hold_reason %><br>Review on <%= new Date(request.hold_until).toLocaleDateString('en-US') %>.</p><% } %>
 <% if(request.status!=='PENDING'&&request.status!=='COMPLETED'){ %><div class="rm-actions"><a class="rm-btn rm-btn--quiet" href="/settings/privacy/<%= request.id %>/export">Download private customer records</a></div>
 <% if(request.topic==='customers/data_request'){ %><form method="post" action="/settings/privacy/<%= request.id %>/delivered" class="rm-form-grid"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><label><input type="checkbox" name="delivered" value="yes" required> I provided this export to the store owner for this customer’s request.</label><div><button class="rm-btn" type="submit">Mark export delivered</button></div></form>
 <% }else{ %><p class="rm-note">Review the linked records first. Erasing personal data is permanent. Stock quantities and financial amounts are preserved. Unfinished deliveries, shared customer records or protected documents remain open for review.</p><form method="post" action="/settings/privacy/<%= request.id %>/erase" data-confirm="Permanently erase the personal data covered by this request? This cannot be undone."><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="rm-btn rm-btn--quiet" type="submit">Erase covered personal data</button></form>
 <details style="margin-top:16px"><summary>Required by law to retain these records?</summary><form method="post" action="/settings/privacy/<%= request.id %>/hold" class="rm-form-grid"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><label>Legal obligation and affected records<textarea name="reason" minlength="20" maxlength="1000" required></textarea></label><label>Review date<input type="date" name="until" required></label><div><button class="rm-btn rm-btn--quiet" type="submit">Record legal retention hold</button></div></form></details><% } %><% } %>
 <% if(request.status==='COMPLETED'){ %><p>Completed <%= new Date(request.completed_at).toLocaleDateString('en-US') %>. Completed exports expire after 30 days.</p><% } %>
</section><% }) %>
