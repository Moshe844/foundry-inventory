<details class="card card-body" id="live-event-feed"<%= newFeedToken?' open':'' %>><summary>Event feed</summary><h2>Live operating feed</h2><p><%= eventFeed.connected?'Receiving authenticated events':eventFeed.configured?'Waiting for first event':'Not configured' %></p>
<% if(newFeedToken){ %><p>Copy this token now. It is shown once.</p><input class="input" readonly aria-label="New live feed token" value="<%= newFeedToken %>"><% } %>
<% if(isOwner){ %><form method="post" action="/settings/event-feed/<%= eventFeed.configured?'disconnect':'enable' %>"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="btn" type="submit"><%= eventFeed.configured?'Disconnect live feed':'Create feed token' %></button></form><% } %></details>
<section class="card card-body"><h2>Stock protection</h2><% for(const guard of stockGuards){ %><p><strong><%= guard.itemName %><%= guard.variantLabel?' / '+guard.variantLabel:'' %></strong>: block outgoing stock <%= guard.boundary.blockedWhen %>. <%= guard.boundary.permittedExplanation %><% if(guard.releaseCondition==='on_order'){ %> Resume after a supplier order is placed.<% } %><% if(guard.instructionId){ %> <a href="/operating-instructions/<%= guard.instructionId %>">Manage</a><% } %></p><% } %></section>
<details class="card advanced-settings" id="learned-instructions"><summary>Rule history</summary><% for(const instruction of learnedInstructions){ %><p><strong><%= instruction.summary %></strong><br><%= instruction.statedAs %> · <%= instruction.status %> <a href="/operating-instructions/<%= instruction.id %>">Manage</a></p><% } %></details>
