<details class="card card-body" id="live-event-feed"<%= newFeedToken?' open':'' %>><summary>Event feed</summary><h2>Live operating feed</h2><p>For a developer connecting a custom business system. The token allows that system to submit events to this inventory.</p><p><%= eventFeed.connected?'Receiving authenticated events':eventFeed.configured?'Waiting for first event':'Not configured' %></p>
<% if(newFeedToken){ %><p>Copy this token now. It is shown once.</p><input class="input" readonly aria-label="New live feed token" value="<%= newFeedToken %>"><% } %>
<% const feedAllowed=locals.planGates?.['connections.custom_api']?.enabled!==false;if(!eventFeed.connected&&!feedAllowed){ %><%- include('../components/plan-lock',{capability:'connections.custom_api',label:'Custom event feeds'}) %><% } %>
<% if(isOwner&&(eventFeed.connected||feedAllowed)){ %><form method="post" action="/settings/event-feed/<%= eventFeed.connected?'disconnect':'enable' %>"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="btn" type="submit"><%= eventFeed.connected?'Disconnect live feed':'Create feed token' %></button></form><% } %></details>
<section class="card card-body"><h2>Stock protection</h2><% if(!stockGuards.length){ %><p>No product-specific stock protection rules are saved for this inventory.</p><% } %><% for(const guard of stockGuards){ %><p><strong><%= guard.itemName %><%= guard.variantLabel?' / '+guard.variantLabel:'' %></strong>: block outgoing stock <%= guard.boundary.blockedWhen %>. <%= guard.boundary.permittedExplanation %><% if(guard.releaseCondition==='on_order'){ %> Resume after a supplier order is placed.<% } %><% if(guard.instructionId){ %> <a href="/operating-instructions/<%= guard.instructionId %>">Manage</a><% } %></p><% } %></section>
<details class="card advanced-settings" id="learned-instructions"><summary>Rule history</summary><% if(!learnedInstructions.length){ %><p>No saved rule history for this inventory.</p><% } %><% for(const instruction of learnedInstructions){ %><p><strong><%= instruction.summary %></strong><br><%= instruction.statedAs %> · <%= instruction.status %> <a href="/operating-instructions/<%= instruction.id %>">Manage</a></p><% } %></details>
