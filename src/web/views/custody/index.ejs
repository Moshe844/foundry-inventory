<div class="production-page"><section class="page-head"><div><h1>Rentals and consignment</h1><p>Track goods held by customers or suppliers separately from stock available for ordinary sales. Rental fees and consignment ownership are recorded explicitly.</p></div><% if(canCreate){ %><a class="btn btn--primary" href="/custody/new">New agreement</a><% } %></section><section class="section"><h2>Latest agreements</h2><% if(!agreements.length){ %><p>No agreements yet.</p><% } %><ul><% agreements.forEach(a=>{ %><li><a href="/custody/<%= a.id %>"><%= a.agreement_number %> · <%= a.party_name %></a> · <%= a.kind.replaceAll('_',' ').toLowerCase() %> · <%= a.status.toLowerCase() %> · review or return <%= a.due_date %><% if(a.status==='OPEN'&&a.due_date<today){ %> · <strong>Past due: review outstanding goods</strong><% } %></li><% }) %></ul></section></div>
