<div class="production-page"><h1>New rental or consignment agreement</h1><p>This records the terms and creates two protected custody locations. No goods move and no invoice or supplier obligation is created until you record an actual event. Existing location limits apply.</p><form method="post" action="/custody" class="form-stack"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="requestKey" value="<%= formKey %>"><label class="rm-field"><span>Agreement type</span><select name="kind" required><option value="RENTAL">Rent our goods to a customer</option><option value="CONSIGN_OUT">Our goods held for sale by a customer</option><option value="CONSIGN_IN">Supplier-owned goods held by us</option></select></label><label class="rm-field"><span>Customer (rental or outgoing consignment)</span><select name="customerId"><option value="">Choose customer</option><% customers.forEach(c=>{ %><option value="<%= c.id %>"><%= c.name %></option><% }) %></select></label><label class="rm-field"><span>Supplier (incoming consignment)</span><select name="supplierId"><option value="">Choose supplier</option><% suppliers.forEach(s=>{ %><option value="<%= s.id %>"><%= s.name %></option><% }) %></select></label><label class="rm-field"><span>Start date</span><input type="date" name="startDate" value="<%= today %>" required></label><label class="rm-field"><span>Expected return or review date</span><input type="date" name="dueDate" value="<%= today %>" required></label><section data-production-repeat class="section"><h2>Agreed products</h2><div data-production-rows><div data-production-row><%- include('../manufacturing/picker',{catalogue,label:'Product',field:'lineSkuId'}) %><label class="rm-field"><span>Maximum quantity on this agreement</span><input name="lineQuantity" type="number" min="1" max="1000000000" value="1" required></label><label class="rm-field"><span>Agreed consignment selling price per unit (<%= currency %>)</span><input name="linePrice" inputmode="decimal" value="0" required></label><label class="rm-field"><span>Agreed incoming supplier cost per unit (<%= currency %>)</span><input name="lineCost" inputmode="decimal" value="0" required></label></div></div><button type="button" data-add-row class="btn">Add another product</button></section><button class="btn btn--primary">Save agreement for actual movements</button></form><script src="/manufacturing.js" defer></script></div>
