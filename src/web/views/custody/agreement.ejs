<div class="production-page"><% const a=agreement,amount=n=>helpers.money(Number(n),a.currency),incoming=a.kind==='CONSIGN_IN'; %><h1><%= a.agreement_number %> · <%= a.kind.replaceAll('_',' ').toLowerCase() %></h1><p><%= a.status.toLowerCase() %> · <%= a.start_date %> to <%= helpers.shortDate(a.due_date) %> · <%= a.currency %></p><p>External custody and return inspection are excluded from ordinary sales and replenishment availability. No payment or supplier email is sent by these forms. Incoming consignment belongs to the supplier until an approved ownership transfer.</p>
<% if(a.kind==='RENTAL'){ %><%- include('rental-settings',{a,amount}) %><% } %>
<% a.lines.forEach(l=>{ %><section class="section"><h2><%= l.name %> · <%= l.code %></h2><p><%= l.quantity %> agreed · <%= l.external_quantity %> in external custody · <%= l.inspection_quantity %> awaiting inspection · <%= l.sold_quantity %> sold · <%= l.owned_quantity %> purchased · <%= l.returned_quantity %> resolved returns</p><% if(canViewCosts){ %><p>Agreed consignment sale price <%= amount(l.unit_price_minor) %> · incoming purchase cost <%= amount(l.unit_cost_minor) %> per unit.</p><% } %>
<% if(canMove&&a.status==='OPEN'){ %><% const operations=incoming?[['receive_consigned','Record supplier-owned arrival'],['take_ownership','Take ownership and record goods received, not billed'],['return_supplier','Record physical return to supplier']]:[['dispatch','Record physical dispatch'],['return','Record physical return into inspection'],['restock','Inspect as good and restock'],['write_off','Record lost or damaged owned goods'],...(a.kind==='CONSIGN_OUT'?[['sell','Record a reported consignment sale']]:[])];operations.forEach(([action,label])=>{ %><details><summary><%= label %></summary><form method="post" action="/custody/<%= a.id %>/<%= action %>" class="form-stack"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="requestKey" value="<%= formKey %>:<%= action %>:<%= l.id %>"><input type="hidden" name="lineId" value="<%= l.id %>"><label class="rm-field"><span>Quantity</span><input name="quantity" type="number" min="1" max="<%= l.quantity %>" value="1" required></label><% if(action==='write_off'){ %><label class="rm-field"><span>Where were these goods held?</span><select name="stage"><option value="external">External custody</option><option value="inspection">Return inspection</option></select></label><label class="rm-field"><span>Evidence of loss or damage</span><textarea name="reason" maxlength="1000" required></textarea></label><% } %><% if(['dispatch','restock','take_ownership'].includes(action)){ %><label class="rm-field"><span><%= action==='dispatch'?'Dispatch from':'Receive or restock at' %></span><select name="locationId" required><option value="">Choose location</option><% locations.forEach(location=>{ %><option value="<%= location.id %>"><%= location.name %></option><% }) %></select></label><% } %><% if(l.tracking_mode==='serial'){ %><label class="rm-field"><span>Exact serial numbers, one per line</span><textarea name="serials" required></textarea></label><% }else if(l.tracking_mode==='lot'){ %><label class="rm-field"><span>Lot code</span><input name="lotCode" required></label><% } %><% if(action==='sell'){ %><label class="rm-field"><span>Tax on these sold units (<%= a.currency %>)</span><input name="tax" value="0" inputmode="decimal" required></label><label class="rm-field"><span>Invoice date</span><input name="issueDate" type="date" value="<%= today %>" required></label><label class="rm-field"><span>Payment due date</span><input name="dueDate" type="date" value="<%= today %>" required></label><% } %><label><input type="checkbox" name="confirmed" value="yes" required> I confirm this actual event and the exact quantities and charges shown.</label><button class="btn">Record and verify</button></form></details><% }) %><% } %></section><% }) %>
<% if(canPost&&a.status==='OPEN'){ %><% if(a.kind==='RENTAL'){ %><section class="section"><h2>Invoice an agreed rental period or charge</h2><p>Rental stock remains an asset. This creates a customer invoice for the stated fee and tax; it does not move stock or collect money.</p><form method="post" action="/custody/<%= a.id %>/charge" class="form-stack"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="requestKey" value="<%= formKey %>:charge"><label class="rm-field"><span>Period or charge description</span><input name="description" maxlength="500" required></label><label class="rm-field"><span>Fee (<%= a.currency %>)</span><input name="amount" inputmode="decimal" required></label><label class="rm-field"><span>Tax (<%= a.currency %>)</span><input name="tax" inputmode="decimal" value="0" required></label><label class="rm-field"><span>Invoice date</span><input name="issueDate" type="date" value="<%= today %>" required></label><label class="rm-field"><span>Payment due date</span><input name="dueDate" type="date" value="<%= today %>" required></label><button class="btn">Create rental invoice</button></form></section><% } %><form method="post" action="/custody/<%= a.id %>/close"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="requestKey" value="<%= formKey %>:close"><button class="btn">Close resolved agreement</button></form><% } %>
<section class="section"><h2>Agreement history</h2><ol><% events.forEach(e=>{ %><li><%= e.action.replaceAll('_',' ') %> · <%= helpers.dateTime(e.created_at) %><% if(e.result.quantity){ %> · <%= helpers.unitCount(e.result.quantity,'unit') %><% } %><% if(e.result.invoiceId){ %> · <a href="/accounting/receivables#<%= e.result.invoiceId %>">Customer invoice</a><% } %><% if(e.result.purchaseOrderId){ %> · <a href="/purchasing/orders/<%= e.result.purchaseOrderId %>">Ownership purchase</a><% } %></li><% }) %></ol></section><a href="/custody">All agreements</a></div>
