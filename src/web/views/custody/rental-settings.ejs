<section class="section" id="rental-scheduling"><h2>Rental dates and stock hold</h2><% if(a.booking){ %><p><strong><%= a.booking.status.toLowerCase() %></strong> · <%= helpers.dateTime(a.booking.starts_at) %> – <%= helpers.dateTime(a.booking.ends_at) %> · <%= a.booking.buffer_minutes %> turnaround minutes</p><ul><% a.booking.lines.forEach(l=>{ %><li><%= l.code %> · <%= l.quantity %> at <%= l.location_name %><%= l.return_dependent?' · depends on a planned return':'' %></li><% }) %></ul><% } %>
<p>Calendar capacity includes overlapping reservations. Dispatch still requires physically available goods. Return inspection keeps goods unavailable until confirmed good.</p><a href="/custody/calendar">Open rental calendar</a>
<% if(canMove&&a.status==='OPEN'){ %><details><summary><%= a.booking?'Revise booking':'Reserve dates and locations' %></summary><form method="post" action="/custody/<%= a.id %>/schedule" class="form-stack"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="requestKey" value="<%= formKey %>:schedule"><input type="hidden" name="expectedRevision" value="<%= a.booking?.revision||0 %>"><input type="hidden" name="timeZone" value="<%= rentalTimeZone %>"><p>Dates are in <strong><%= rentalTimeZone %></strong>.</p><label class="rm-field"><span>Starts</span><input name="startsLocal" type="datetime-local" value="<%= rentalLocal(a.booking?.starts_at) %>" required></label><label class="rm-field"><span>Expected return</span><input name="endsLocal" type="datetime-local" value="<%= rentalLocal(a.booking?.ends_at) %>" required></label><label class="rm-field"><span>Turnaround after return (minutes)</span><input name="bufferMinutes" type="number" min="0" max="43200" value="<%= a.booking?.buffer_minutes||0 %>" required></label>
<% a.lines.forEach(l=>{ const slot=a.booking?.lines.find(x=>x.custody_line_id===l.id); %><fieldset><legend><%= l.name %> · <%= l.code %></legend><input type="hidden" name="bookingLineId" value="<%= l.id %>"><label class="rm-field"><span>Quantity to reserve</span><input name="bookingQuantity" type="number" min="1" max="<%= l.quantity %>" value="<%= slot?.quantity||l.quantity %>" required></label><label class="rm-field"><span>Dispatch location</span><select name="bookingLocationId" required><option value="">Choose a location</option><% locations.forEach(loc=>{ %><option value="<%= loc.id %>" <%= slot?.location_id===loc.id?'selected':'' %>><%= loc.name %></option><% }) %></select></label></fieldset><% }) %>
<label><input type="checkbox" name="acknowledgeExpectedReturns" value="yes"> I accept a reservation that depends on another rental returning on time. StockChief must still check physical stock before dispatch.</label><button class="btn">Check capacity and save booking</button></form></details>
<% if(a.booking?.status==='CONFIRMED'){ %><details><summary>Cancel this booking</summary><form method="post" action="/custody/<%= a.id %>/cancel_booking" class="form-stack"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="requestKey" value="<%= formKey %>:cancel-booking"><input type="hidden" name="expectedRevision" value="<%= a.booking.revision %>"><label class="rm-field"><span>Reason</span><input name="reason" maxlength="500" required></label><button class="btn">Cancel and release hold</button></form></details><% } %><% } %></section>
<% if(canViewCosts){ const b=a.billing; %><section class="section" id="rental-billing"><h2>Recurring rental invoices</h2><p>Fixed fee for the whole agreement, billed after each earned period. Billing begins after all agreed goods are dispatched and stops accruing when all are physically returned. Partial returns do not reduce the agreed fee. No payment is collected and no email is sent.</p>
<% if(b){ %><p><strong><%= b.status.replaceAll('_',' ').toLowerCase() %></strong> · <%= amount(b.amount_minor) %> before tax per <%= b.interval_unit.toLowerCase() %> · due in <%= b.due_days %> days</p><p><%= b.billed_periods %> of <%= b.max_periods %> authorized periods · <%= amount(b.billed_total_minor) %> of <%= amount(b.max_total_minor) %> total authority, including tax</p><p><%= b.anchor_at?'Started '+helpers.dateTime(b.anchor_at):'Waiting for full physical dispatch' %><%= b.stopped_at?' · Accrual ended '+helpers.dateTime(b.stopped_at):'' %></p><% if(b.next_due_at&&!['COMPLETE','NEEDS_REVIEW'].includes(b.status)){ %><p>Next earned period ends <%= helpers.dateTime(b.next_due_at) %><%= b.status==='PAUSED'?' · invoice issuance paused':'' %></p><% } %><% if(b.last_error){ %><p role="alert"><strong>Needs review:</strong> <%= b.last_error %> No affected invoice was posted. Review the current terms and accounting period before continuing.</p><% } %><% if(b.status==='NEEDS_REVIEW'&&canPost){ %><a class="btn" href="/custody/<%= a.id %>/billing-review">Review current billing terms</a><% } %><% if(b.status==='COMPLETE'){ %><p>Authorized billing is complete. More periods require a new approval; this does not prove the goods were returned.</p><% } %>
<% if(canPost&&a.status==='OPEN'){ const changes=b.status==='PAUSED'?[['resume_recurring','Resume earned invoices'],['stop_recurring','Stop future accrual']]:['ACTIVE','STOPPED'].includes(b.status)?[['pause_recurring','Pause invoice issuance'],...(b.status==='ACTIVE'?[['stop_recurring','Stop future accrual']]:[])]:[];changes.forEach(([action,label])=>{ %><form method="post" action="/custody/<%= a.id %>/<%= action %>"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="requestKey" value="<%= formKey %>:<%= action %>"><input type="hidden" name="expectedRevision" value="<%= b.revision %>"><button class="btn"><%= label %></button></form><% }) %><p>Pausing delays invoices; it does not waive fees already earned.</p><% } %>
<h3>Invoiced periods</h3><ul><% b.periods.forEach(p=>{ %><li><%= helpers.dateTime(p.starts_at) %> – <%= helpers.dateTime(p.ends_at) %> · <%= amount(p.total_minor) %><%= p.prorated?' · prorated final period':'' %><% if(p.invoice_id){ %> · <a href="/accounting/receivables#<%= p.invoice_id %>"><%= p.invoice_number %></a><% } %></li><% }) %></ul>
<% }else if(canPost&&a.status==='OPEN'){ %><details><summary>Set and authorize recurring terms</summary><form method="post" action="/custody/<%= a.id %>/set_recurring" class="form-stack"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="requestKey" value="<%= formKey %>:recurring"><input type="hidden" name="expectedRevision" value="0"><input type="hidden" name="timeZone" value="<%= rentalTimeZone %>"><label class="rm-field"><span>Agreed fee description</span><input name="description" maxlength="180" required></label><label class="rm-field"><span>Fee per whole agreement (<%= a.currency %>, before tax)</span><input name="amount" inputmode="decimal" required></label><label class="rm-field"><span>Billing interval</span><select name="intervalUnit"><option value="DAY">Daily</option><option value="WEEK">Weekly</option><option value="MONTH">Calendar monthly</option></select></label><label class="rm-field"><span>Configured sales tax</span><select name="taxRateId"><option value="">No tax</option><% rentalTaxRates.forEach(r=>{ %><option value="<%= r.id %>"><%= r.name %></option><% }) %></select></label><label class="rm-field"><span>Payment due after invoice (days)</span><input name="dueDays" type="number" min="0" max="365" value="30" required></label><label class="rm-field"><span>Maximum authorized periods</span><input name="maxPeriods" type="number" min="1" max="1200" required></label><label class="rm-field"><span>Maximum total authorized, including tax (<%= a.currency %>)</span><input name="maxTotal" inputmode="decimal" required></label><label class="rm-field"><span>Final partial period</span><select name="prorateFinal"><option value="yes">Prorate by actual elapsed time</option><option value="no">Charge the agreed full period</option></select></label><p>Calendar and invoice dates use <%= rentalTimeZone %>. Terms are frozen on activation. Changed prices or tax settings pause affected invoices for review.</p><label><input type="checkbox" name="authorizeRecurring" value="yes" required> I authorize these recurring invoices within the period and total limits shown.</label><button class="btn">Authorize bounded recurring invoices</button></form></details><% } %></section><% } %>
