<div class="production-page"><section class="page-head"><div><h1>Rental calendar</h1><p>Bookings reserve capacity. Goods become available again only after their actual return and inspection.</p></div><a class="btn" href="/custody">All agreements</a></section>
<form method="get" action="/custody/calendar" class="form-stack"><label class="rm-field"><span>From</span><input name="from" type="date" value="<%= from %>" required></label><label class="rm-field"><span>Through</span><input name="to" type="date" value="<%= to %>" required></label><button class="btn">Show bookings</button></form>
<section class="section"><h2>Bookings in this window</h2><% if(!bookings.length){ %><p>No confirmed bookings in this window.</p><% } %><ul><% bookings.forEach(b=>{ %><li><a href="/custody/<%= b.agreement_id %>"><%= b.agreement_number %> · <%= b.customer_name %></a><p><%= helpers.dateTime(b.starts_at) %> – <%= helpers.dateTime(b.ends_at) %> · <%= b.buffer_minutes %> turnaround minutes</p><p><%= b.code %> · <%= helpers.unitCount(b.quantity,'unit') %> at <%= b.location_name %><% if(b.return_dependent){ %> · <strong>Depends on a planned return</strong><% } %></p><p><%= b.external_quantity %> currently with customer · <%= b.inspection_quantity %> awaiting inspection</p></li><% }) %></ul><% if(bookings.length===500){ %><p>Showing the first 500 booking lines. Choose a shorter date window to see the rest.</p><% } %></section></div>
