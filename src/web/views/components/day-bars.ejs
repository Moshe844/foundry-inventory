<%# A month's sales as one bar per day: today's the strongest, the days still ahead a faint line.
    month is posted-sales.monthByDay: { days:[{day,minor}], monthDays }. %>
<% const best=Math.max(0,...month.days.map(entry=>entry.minor)); %><span class="sc-days" aria-hidden="true"><% for(let index=0;index<month.monthDays;index++){ const entry=month.days[index]; %><i class="<%= !entry?'is-ahead':index===month.days.length-1?'is-today':'' %>" style="--i:<%= index %>;--h:<%= entry&&best>0&&entry.minor>0?Math.max(10,Math.round(entry.minor*100/best)):0 %>%"></i><% } %></span>
