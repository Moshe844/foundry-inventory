<% const selected=locals.pageSection; if(selected&&selected.tabs.length){const here=currentHref.split('?')[0],activePath=selected.tabs.map(t=>t.href.split('#')[0]).filter(p=>here===p||here.startsWith(p+'/')).sort((a,b)=>b.length-a.length)[0]; %>
<nav class="sc-section-tabs" aria-label="Section navigation"><% for(const tab of selected.tabs){const active=tab.href.split('#')[0]===activePath; %><a href="<%= tab.href %>" <%- active?'aria-current="page"':'' %>><%= tab.label %></a><% } %></nav><% } %>
