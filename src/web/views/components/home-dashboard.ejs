<%
 const needs=locals.homeDecisions||home.needsYou||[],suggestions=locals.homeSuggestions||[];
 const firstName=helpers.displayName((currentUser?.name||'').trim().split(/\s+/)[0]);
 const paused=home.status.paused||home.status.suspended;
 const activity=locals.completedWork||home.did?.actions||[];
 const handling=(home.handling||[]).filter(work=>typeof work.link==='string'&&!work.link.startsWith('/settings/operations'));
 const waiting=Number(home.needsYouTotal||0);
 const statusWord=paused?'Automatic work paused':locals.maintenanceProgress?.active?'Review in progress':home.status.checkStale?'Last check needs refreshing':home.status.lastLookedAt?'Monitoring your business':'Not checked yet';
 const statusTone=paused||home.status.checkStale?'warn':home.status.lastLookedAt?'ok':'idle';
 const chips=(locals.askSuggestions||[]).filter(entry=>entry.href!=='/needs-you').slice(0,3);
 const next=home.guidance?.next&&!locals.activeMigration?home.guidance.next:null;
 const toneOf=item=>item.importance==='Urgent'?'urgent':item.importance==='Important'?'important':'normal';
 const countTone=needs.some(item=>item.importance==='Urgent')?'urgent':needs.some(item=>item.importance==='Important')?'important':'normal';
 const iconOf=item=>item.question?'question':({approval:'check',recovery:'bolt',inventory:'box',accounting:'wallet',order:'ship',purchase:'purchasing',shipping:'ship',connection:'bolt',mail:'chat',clarification:'question'})[item.kind]||'attention';
 const outShare=Math.min(100,Math.round(Number(stats.zeroCount||0)/Math.max(1,Number(stats.skuCount||stats.itemCount||1))*100));
%>
<div class="sc-home hm">
  <header class="sc-home-header hm-head">
    <div>
      <h1><span data-local-greeting>Hello</span><%= firstName?', '+firstName:'' %></h1>
      <p><%= stats.itemCount===0?'Nothing will be ordered, paid, or emailed without your approval or the limits you set.':waiting===0?'Nothing needs you right now.':waiting===1?'1 thing needs you.':waiting+' things need you.' %></p>
    </div>
    <div class="hm-status">
      <span class="hm-status__word" data-tone="<%= statusTone %>"><%= statusWord %></span>
      <% if(home.status.lastLookedAt){ %><span class="hm-status__when">Checked <%= helpers.dateTime(home.status.lastLookedAt) %></span><% } %>
      <% if(canOperate&&!paused&&!locals.maintenanceProgress?.active&&(!home.status.lastLookedAt||home.status.checkStale)){ %><form method="post" action="/autopilot/run"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="returnToHome" value="1"><button class="btn btn--sm" type="submit">Check now</button></form><% } %>
    </div>
  </header>
  <%- include('../manager/coverage-warning',{inbox:home}) %>
  <% if(next){ %><aside class="hm-next"><div><h2><%= next.title %></h2><p><%= next.recommendation||next.what %></p></div><a class="btn btn--primary" href="<%= next.href %>"><%= next.action %></a></aside><% } %>
  <% if(locals.activeMigration){const migration=activeMigration; %><aside class="hm-next"><div><h2>Your source is saved; StockChief will not switch it live without your approved cutover.</h2><p><%= migration.filenames.join(', ') %> · <%= migration.preparedCount %> of <%= migration.operationalCount %> datasets prepared.<%= migration.liveRecords===0?' Nothing is live yet.':'' %></p></div><a class="btn" href="/onboarding/migrations/<%= migration.id %>/sources"><%= migration.remainingCount?'Continue source review':'Run final checks' %></a></aside><% } %>
  <% if(paused){ %><div class="notice notice--warn"><p><%= home.status.suspendedReason||home.status.pausedReason||'Automatic work is paused.' %></p><% if(canOperate){ %><form method="post" action="/autopilot/resume"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="returnToHome" value="1"><button class="btn" type="submit">Resume automatic work</button></form><% } %></div><% } %>
  <% if(locals.maintenanceProgress){ %><%- include('maintenance-progress',{maintenanceProgress}) %><% } %>

  <div class="hm-cols"><div class="hm-main">
  <section class="sc-home-block hm-block" data-home-section="needs" id="needs-you" aria-labelledby="home-needs-title">
    <header><h2 id="home-needs-title">Needs you <span class="hm-count" data-tone="<%= waiting?countTone:'ok' %>">· <%= waiting %></span></h2><% if(waiting){ %><div class="level-counts" aria-label="By level"><% for(const entry of locals.homeLevels||[]){ if(entry.count){ %><a class="level-count" data-tone="<%= entry.key %>" href="/needs-you?level=<%= entry.key %>"><%= entry.count %> <%= entry.label %></a><% }} %></div><a href="/needs-you">View all</a><% } %></header>
    <% if(needs.length){ %><div class="sc-decision-list hm-rows" data-show-batch="6"><% for(const decision of needs){ %><article class="sc-decision hm-row" data-tone="<%= toneOf(decision) %>"><span class="hm-row__icon" aria-hidden="true"><%- helpers.icon(iconOf(decision),{size:16}) %></span><div class="hm-row__text"><div class="hm-row__title"><h3><%= decision.title %></h3><span class="level-label" data-tone="<%= toneOf(decision) %>"><%= toneOf(decision)==='urgent'?'Urgent':toneOf(decision)==='important'?'Important':'Normal' %></span></div><p><%= decision.happened&&decision.happened!==decision.title?decision.happened:decision.why||decision.because %></p></div><% const deadline=helpers.deadlineTag(decision,helpers.businessDay(new Date(),account.timeZone||'UTC'));if(deadline){ %><span class="sc-due-tag"><%= deadline %></span><% } %><a class="btn btn--sm hm-row__action <%= toneOf(decision)==='urgent'?'btn--primary':'' %>" href="<%= decision.href||decision.link||'/needs-you' %>"><%= decision.actionLabel||decision.action||'Review' %></a><% if(decision.dismiss){ %><form method="post" action="<%= decision.dismiss.action %>" class="hm-row__dismiss"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="returnTo" value="/"><button class="btn btn--ghost btn--sm" type="submit"><%= decision.dismiss.label %></button></form><% } %></article><% } %></div><% if(waiting>needs.length||waiting>6){ %><p class="hm-all"><a href="/needs-you">View all in Needs you</a></p><% } %>
    <% }else if(!suggestions.length){ %><p class="sc-home__quiet hm-quiet">You’re all caught up. No known decisions are waiting for you.</p><% } %>
  </section>

  <% if(suggestions.length){ %><section class="sc-home-block hm-block" data-home-section="suggestions" id="suggestions" aria-labelledby="home-suggestions-title">
    <header><h2 id="home-suggestions-title">Ready for your approval</h2></header>
    <div class="sc-suggestion-grid hm-rows" data-show-batch="6"><% for(const suggestion of suggestions.slice(0,18)){ %><%- include('home-suggestion',{suggestion}) %><% } %></div>
  </section><% } %>

  </div><aside class="hm-side">
  <section class="sc-home-block sc-metrics hm-metrics" data-home-section="numbers" aria-label="Business numbers">
    <% if(locals.homeSales){ %><a class="sc-metric" data-tone="ok" href="/money/profit"><span>Sales this month</span><strong data-home-number="sales"><%= helpers.money(homeSales.minor,homeSales.currency) %></strong><% if(locals.homeSummary?.salesChange!==null&&locals.homeSummary?.salesChange!==undefined){ %><small class="hm-sub"><%= homeSummary.salesChange>=0?'Up ':'Down ' %><%= Math.abs(homeSummary.salesChange) %>% on this point last month</small><% } %></a>
    <% }else{ %><a class="sc-metric" href="/inventory"><span>Products</span><strong data-home-number="products"><%= helpers.qty(stats.itemCount) %></strong></a><% } %>
    <a class="sc-metric" data-tone="normal" href="/orders"><span>Open orders</span><strong data-home-number="orders"><%= helpers.qty(stats.openOrders) %></strong><% if(locals.homeSummary){ %><small class="hm-sub <%= homeSummary.readyToShip?'is-go':'' %>"><%= homeSummary.readyToShip?helpers.qty(homeSummary.readyToShip)+' ready to ship →':'None ready to ship' %></small><% } %></a>
    <a class="sc-metric <%= stats.zeroCount>0?'is-alarm':'' %>" data-tone="<%= stats.zeroCount>0?'urgent':'ok' %>" href="/inventory/table?view=flat&amp;group=empty"><span>Out of stock</span><strong data-home-number="low"><%= helpers.qty(stats.zeroCount) %></strong><small class="hm-sub">of <%= helpers.qty(stats.skuCount||stats.itemCount) %> <%= stats.skuCount?(stats.skuCount===1?'SKU':'SKUs'):(stats.itemCount===1?'product':'products') %></small><% if(stats.zeroCount>0){ %><i class="hm-meter" aria-hidden="true"><b style="width:<%= outShare %>%"></b></i><% } %></a>
    <a class="sc-metric" data-tone="stock" href="/inventory/table"><span>Units on hand<% if(stats.hasMeasuredStock){ %> <small>plus measured stock</small><% } %></span><strong data-home-number="units"><%= helpers.qty(stats.unitsOnHand) %></strong><% if(locals.homeSummary?.stockValue){ %><small class="hm-sub">Worth <%= helpers.money(homeSummary.stockValue.minor,homeSummary.stockValue.currency) %></small><% } %></a>
  </section>

  <div class="hm-rail">
  <% if(locals.homeSummary){ %><section class="hm-block hm-work" aria-labelledby="home-work-title"><header><h2 id="home-work-title">This week</h2><a href="/autopilot/history">See its work</a></header>
    <div class="hm-work__panel"><dl class="hm-stats"><div><dd><%= helpers.qty(homeSummary.watching) %></dd><dt><%= homeSummary.watching===1?'product':'products' %> watched</dt></div><div><dd><%= helpers.qty(homeSummary.found) %></dd><dt><%= homeSummary.found===1?'issue':'issues' %> found</dt></div><div><dd><%= helpers.qty(homeSummary.doneAlone) %></dd><dt>handled on its own</dt></div><div><dd><%= helpers.qty(homeSummary.doneApproved) %></dd><dt>resolved after approval</dt></div></dl>
    <p class="hm-work__mode"><%= homeSummary.canAutomate?'StockChief acts on its own within the limits you set.':'StockChief asks you before anything consequential.' %> <a href="/autopilot">Change this</a></p></div>
  </section><% } %>
  <% if(handling.length){ %><section class="sc-home-block hm-block" data-home-section="progress" aria-labelledby="home-progress-title">
    <header><h2 id="home-progress-title">In progress</h2><a href="/autopilot/history">Work history</a></header>
    <div class="sc-decision-list hm-lines"><% for(const work of handling.slice(0,3)){ %><article class="hm-line"><a href="<%= work.link %>"><code><%= work.title %></code><span><%= work.detail||work.because %></span><i aria-hidden="true">›</i></a></article><% } %></div>
  </section><% } %>

  </div></aside></div>
  <section class="sc-home-block sc-ask-card hm-ask" data-home-section="ask" aria-labelledby="home-ask-title">
    <header><h2 id="home-ask-title">Ask StockChief</h2><span class="hm-ask__links"><a href="/ask/capabilities">What it can do</a><a href="/ask/history">Your conversations</a></span></header>
    <%- include('../partials/composer',{composerPlaceholder:'What would you like to know or do?',homeHandoff:!!locals.postgresAsk,hideAttachment:!!locals.postgresAsk}) %>
    <% if(chips.length){ %><div class="sc-home__suggestions" aria-label="Available actions"><% for(const entry of chips){ %><a class="btn btn--ghost btn--sm" href="<%= entry.href %>"><%= entry.label %></a><% } %></div><% } %>
  </section>

  <% if(activity.length){ %><section class="sc-home-block hm-block" data-home-section="activity" id="handled" aria-labelledby="home-activity-title">
    <header><h2 id="home-activity-title">What StockChief did today</h2></header>
    <div class="sc-activity"><% for(const event of activity.slice(0,5)){ %><div><span><a href="<%= event.link %>"><%= event.headline %></a><% if(event.detail){ %><small><%= event.detail %></small><% } %></span><time datetime="<%= event.at %>"><%= helpers.dateTime(event.at) %></time></div><% } %></div>
  </section><% } %>
  <p class="hm-foot"><a href="/activity">Activity log</a></p>
</div>
