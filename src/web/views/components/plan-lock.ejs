<% const gate=locals.planGates?.[capability];if(gate&&!gate.enabled){ %><div class="notice notice--warn" data-plan-lock="<%= capability %>"><span class="rm-pillbadge"><%= gate.tier %></span> <% if(gate.currentOfferIncludes){ %><span><%= label %> is part of your plan's updated terms, which you haven't accepted yet.</span> <a class="rm-btn" href="/billing/terms">Review updated plan terms</a><% }else{ %><span><%= label %> is included with <%= gate.tier %>.</span> <a class="rm-btn" href="/upgrade?capability=<%= encodeURIComponent(capability) %>">Upgrade</a><% } %></div><% } %>
