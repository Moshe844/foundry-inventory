<div class="sc-toolbar">
  <button class="btn btn--ghost sc-nav-toggle" type="button" data-sidebar-toggle aria-expanded="false" aria-controls="app-sidebar" aria-label="Open navigation"><%- helpers.icon('menu',{size:20}) %><span>Menu</span></button>
  <% if(workspace){ %><div class="rail-search sc-global-search" role="search"><%- helpers.icon('search',{size:17}) %><input type="search" data-search autocomplete="off" placeholder="Search or ask StockChief…" aria-label="Search this inventory" aria-controls="global-search-results" role="combobox" aria-autocomplete="list" aria-expanded="false"><kbd aria-hidden="true">Ctrl K</kbd><div id="global-search-results" class="search-results" data-search-results hidden role="listbox" aria-label="Search results"></div></div>
  <div class="sc-toolbar-actions"><a class="btn btn--ghost sc-support-link" href="/support" aria-label="Help and support"><span>Help &amp; support</span></a><a class="btn btn--ghost" href="/needs-you" title="Needs you"><span class="sc-needs-icon" aria-hidden="true"><%- helpers.icon('attention',{size:18}) %></span>Needs you<% if(attentionCount>0){ %> <span class="nav-count"><%= attentionCount %></span><% } %></a><a class="btn btn--primary" href="/ask" data-ask-panel aria-label="Ask StockChief"><span class="sc-ask-word">Ask StockChief</span></a></div><% } %>
</div>
