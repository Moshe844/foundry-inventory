<% const m=model,amount=n=>helpers.money(n,m.currency),q=new URLSearchParams({from:m.from,to:m.to}).toString(); %>
<header class="sc-business-head"><div><h1>Money</h1><p><%= helpers.shortDate(m.from) %> – <%= helpers.shortDate(m.to) %> · <%= m.timeZone %></p></div><a class="btn" href="/accounting/books">Accountant view</a></header>
<%- include('customer-period',{model:m,action:'/money'}) %>
<div class="sc-money-cards">
<a class="sc-money-card" href="/money/invoices" data-money-card="invoices" data-amount-minor="<%= m.receivableTotals.totalMinor %>" data-count="<%= m.receivableTotals.count %>"><span>Customers owe you</span><strong><%= amount(m.receivableTotals.totalMinor) %></strong><small><%= m.receivableTotals.count %> unpaid invoice<%= m.receivableTotals.count===1?'':'s' %> · <%= amount(m.receivableTotals.lateMinor) %> late</small><b>See who owes you →</b></a>
<a class="sc-money-card" href="/money/bills" data-money-card="bills" data-amount-minor="<%= m.payableTotals.totalMinor %>" data-count="<%= m.payableTotals.count %>"><span>You owe suppliers</span><strong><%= amount(m.payableTotals.totalMinor) %></strong><small><%= m.payableTotals.count %> bill<%= m.payableTotals.count===1?'':'s' %> · <%= amount(m.payableTotals.weekMinor) %> due within 7 days</small><b>See bills to pay →</b></a>
<a class="sc-money-card" href="/money/cash?<%= q %>" data-money-card="cash" data-amount-minor="<%= m.cashFlow.netMinor %>"><span>Cash this period</span><strong><%= amount(m.cashFlow.netMinor) %></strong><small>In <%= amount(m.cashFlow.inMinor) %> · Out <%= amount(m.cashFlow.outMinor) %></small><b>See money in and out →</b></a>
<a class="sc-money-card" href="/money/profit?<%= q %>" data-money-card="profit" data-amount-minor="<%= m.pnl.netIncomeMinor %>"><span>Profit this period</span><strong><%= amount(m.pnl.netIncomeMinor) %></strong><small>Sales <%= amount(m.pnl.revenueMinor) %> − product cost <%= amount(m.pnl.cogsMinor) %> − expenses <%= amount(m.pnl.operatingExpenseMinor) %></small><b>See profit breakdown →</b></a></div>
<p class="sc-business-note">Received stock, not yet billed: <a href="/money/sources/received_unbilled?to=<%= m.to %>"><%= amount(m.receivedNotBilledMinor) %></a>. This is separate from bills to pay.</p>
<% if(m.foreignCurrencies.length){ %><p class="notice">Outstanding documents in <%= m.foreignCurrencies.join(', ') %> are kept separate from <%= m.currency %>. Review them in <a href="/accounting/books">Accountant view</a>.</p><% } %>
<div class="sc-business-two"><% for(const side of [{title:'Who owes you',rows:m.topCustomers,path:'/money/invoices'},{title:'Who you owe',rows:m.topSuppliers,path:'/money/bills'}]){ %><section class="sc-business-card"><header><h2><%= side.title %></h2><a href="<%= side.path %>">See all →</a></header><% if(!side.rows.length){ %><p class="sc-empty">No outstanding <%= side.path.includes('bills')?'bills':'invoices' %>.</p><% } %><% for(const p of side.rows){ %><a class="sc-party-row" href="<%= side.path %>?party=<%= p.id %>"><span><strong><%= p.name %></strong><small><%= p.count %> document<%= p.count===1?'':'s' %></small></span><strong><%= amount(p.totalMinor) %></strong></a><% } %></section><% } %></div>
<section class="sc-business-card"><header><h2>Money in and out · last six months</h2><span>In / Out</span></header><%- include('customer-cash-chart',{model:m}) %></section>
<p class="sc-business-note"><strong>Recorded profit · incomplete.</strong> <%= m.profitNote %> <%= helpers.unitCount(m.missingCostUnits,'unit') %> have no recorded inventory cost. <%= m.basis %> basis. <a href="/money/profit?<%= q %>">Where did these figures come from?</a></p>
