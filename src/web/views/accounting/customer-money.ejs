<% const m=model,amount=n=>helpers.money(n,m.currency),q=new URLSearchParams({from:m.from,to:m.to}).toString(),p=m.pnl,count=Number(p.stockCountMinor||0),net=p.netIncomeMinor,gross=p.grossProfitMinor,r=m.receivableTotals,b=m.payableTotals,c=m.cashFlow,quiet=!p.revenueMinor&&!p.cogsMinor&&!p.operatingExpenseMinor&&!count,word=n=>n===1?'invoice':'invoices',initials=name=>String(name||'?').trim().split(/\s+/).slice(0,2).map(w=>w.charAt(0)).join('').toUpperCase(),percent=(part,whole)=>whole?Math.round(part/whole*1000)/10:null,cents=part=>Math.round(part/p.revenueMinor*100),widest=Math.max(1,p.revenueMinor,p.cogsMinor,Math.abs(gross),Math.abs(count),p.operatingExpenseMinor,Math.abs(net)),rows=[['revenue','Sales','What customers bought',p.revenueMinor,'in'],['cogs','Product cost','What the stock you sold cost you',p.cogsMinor,'out'],['gross','Gross profit','Left after paying for what you sold',gross,'sum'],...(count?[['stock-count','Stock count gains / losses',count>0?'Counted more stock than recorded':'Counted less stock than recorded',count,count>0?'in':'out']]:[]),['expenses','Expenses','Rent, shipping and other running costs',p.operatingExpenseMinor,'out'],['net','Net profit','What is really left',net,'sum']],bands=[['not_due','Not due yet','band-ok'],['1_30','1–30 days late','band-late'],['31_60','31–60 days late','band-later'],['sixty_plus','60+ days late','band-latest']],aging={sixty_plus:'60_plus'}; %>
<header class="sc-business-head"><div><h1>Money</h1><p><%= helpers.shortDate(m.from) %> – <%= helpers.shortDate(m.to) %></p></div></header>
<%- include('customer-period',{model:m,action:'/money'}) %>

<section class="mn-story" aria-label="Your money in plain words">
  <div class="mn-story__main">
    <h2 class="<%= net<0?'is-loss':net>0?'is-gain':'' %>"><%= quiet?'Nothing recorded for these dates yet':net<0?'You lost '+amount(-net):net>0?'You made '+amount(net)+' profit':'You broke even' %></h2>
    <% if(!quiet){ %><p>You sold <strong><%= amount(p.revenueMinor) %></strong>. What you sold cost you <strong><%= amount(p.cogsMinor) %></strong>, and other running costs were <strong><%= amount(p.operatingExpenseMinor) %></strong>.<% if(count){ %> Your stock count <%= count>0?'added':'took away' %> <strong><%= amount(Math.abs(count)) %></strong>.<% } %></p><% } %>
    <p>Cash: <strong><%= amount(c.inMinor) %></strong> came in and <strong><%= amount(c.outMinor) %></strong> went out, so your cash went <%= c.netMinor<0?'down':'up' %> by <strong><%= amount(Math.abs(c.netMinor)) %></strong>.</p>
    <p>Customers owe you <strong><%= amount(r.totalMinor) %></strong><% if(r.lateMinor){ %>, and <strong class="is-urgent"><%= amount(r.lateMinor) %></strong> of that is late<% } %>. You owe suppliers <strong><%= amount(b.totalMinor) %></strong><% if(b.weekMinor){ %>, with <strong class="is-important"><%= amount(b.weekMinor) %></strong> due this week<% } %>.</p>
  </div>
  <div class="mn-story__do">
    <% if(r.lateMinor){ %><a class="btn btn--primary" href="/money/invoices?aging=late">Chase late invoices</a><% } %>
    <% if(b.weekMinor){ %><a class="btn" href="/money/bills?aging=due_week">See bills due this week</a><% } %>
    <a class="btn" href="/money/profit?<%= q %>">See how profit adds up</a>
  </div>
</section>

<% if((locals.depositsToRefund||[]).length){ %><section class="sc-business-card sc-money-needs" data-money-needs-you aria-label="Needs you"><h2>Needs you · <%= depositsToRefund.length %></h2><% depositsToRefund.forEach(function(row){ %><p class="sc-business-note"><a href="/orders/<%= row.orderId %>#deposit-refund"><strong><%= row.cancelled ? 'Deposit' : 'Overpayment' %> to refund: <%= helpers.money(row.toRefundMinor,row.currency) %></strong></a> to <%= row.customerName %>, from <%= row.cancelled ? 'cancelled' : 'overpaid' %> order <%= row.orderNumber %>.</p><% }); %></section><% } %>

<div class="sc-money-cards">
<a class="sc-money-card" href="/money/invoices" data-money-card="invoices" data-amount-minor="<%= r.totalMinor %>" data-count="<%= r.count %>"><span>Customers owe you</span><strong><%= amount(r.totalMinor) %></strong><small><%= r.count %> unpaid <%= word(r.count) %> · <em class="<%= r.lateMinor>0?'is-urgent':'' %>"><%= r.lateMinor>0?amount(r.lateMinor)+' late':'none late' %></em></small><b>See who owes you →</b></a>
<a class="sc-money-card" href="/money/bills" data-money-card="bills" data-amount-minor="<%= b.totalMinor %>" data-count="<%= b.count %>"><span>You owe suppliers</span><strong class="<%= b.totalMinor>0?'is-important':'' %>"><%= amount(b.totalMinor) %></strong><small><%= b.count %> bill<%= b.count===1?'':'s' %> · <em class="<%= b.weekMinor>0?'is-important':'' %>"><%= b.weekMinor>0?amount(b.weekMinor)+' due this week':'none due this week' %></em></small><b>See bills to pay →</b></a>
<a class="sc-money-card" href="/money/cash?<%= q %>" data-money-card="cash" data-amount-minor="<%= c.netMinor %>"><span>Cash this period</span><strong class="<%= c.netMinor<0?'is-urgent':'' %>"><%= amount(c.netMinor) %></strong><small>In <%= amount(c.inMinor) %> · Out <%= amount(c.outMinor) %></small><b>See money in and out →</b></a>
<a class="sc-money-card" href="/money/profit?<%= q %>" data-money-card="profit" data-amount-minor="<%= net %>"><span>Profit this period</span><strong class="<%= net<0?'is-urgent':net>0?'is-good':'' %>"><%= amount(net) %></strong><small>Sales <%= amount(p.revenueMinor) %> − costs <%= amount(p.cogsMinor+p.operatingExpenseMinor) %><% if(count){ %> <%= count>0?'+':'−' %> stock count <%= amount(Math.abs(count)) %><% } %></small><b>See how it adds up →</b></a></div>

<% if(m.receivedNotBilledMinor){ %><a class="mn-note" href="/money/sources/received_unbilled?to=<%= m.to %>"><span aria-hidden="true">i</span><span><strong><%= amount(m.receivedNotBilledMinor) %></strong> of stock has arrived but has no supplier bill yet. It is not in “You owe suppliers” until the bill is added.</span><b>Review</b></a><% } %>
<% if(m.foreignCurrencies.length){ %><p class="notice">Outstanding documents in <%= m.foreignCurrencies.join(', ') %> are kept separate from <%= m.currency %>. Review them in <a href="/accounting/books">Accountant view</a>.</p><% } %>
<% if(m.missingCostUnits){ %><p class="notice notice--warn"><strong><%= helpers.missingCost(m) %> have no recorded cost,</strong> so profit may look higher than it really is. <a href="/money/profit?<%= q %>">See what this includes</a></p><% } %>

<div class="mn-grid">
  <section class="sc-business-card mn-flow"><header><h2>From sales to profit</h2><a href="/money/profit?<%= q %>">Full breakdown →</a></header>
    <% for(const [key,name,hint,value,kind] of rows){ %><a class="mn-flow__row is-<%= kind %> <%= value<0?'is-negative':'' %>" href="/money/sources/<%= key %>?<%= q %>"><span><strong><%= kind==='out'?'− ':kind==='sum'?'= ':key==='stock-count'?'+ ':'' %><%= name %></strong><small><%= hint %></small></span><i aria-hidden="true"><b style="width:<%= Math.max(value?1:0,Math.abs(value)/widest*100) %>%"></b></i><em><%= amount(value) %></em></a><% } %>
  </section>
  <section class="sc-business-card mn-due"><header><h2>Who pays when</h2></header>
    <% for(const [title,totals,side] of [['Coming in from customers',r,'invoices'],['Going out to suppliers',b,'bills']]){ %><div class="mn-due__side"><p><strong><%= title %></strong><span><%= amount(totals.totalMinor) %></span></p><% if(totals.totalMinor){ %><div class="mn-bands" role="img" aria-label="<%= title %> by how late it is"><% for(const [key,label,tone] of bands){const value=Number(totals.aging[key]||0);if(value){ %><a class="<%= tone %>" href="/money/<%= side %>?aging=<%= aging[key]||key %>" style="flex-grow:<%= value %>" title="<%= label %>: <%= amount(value) %>"></a><% }} %><% if(totals.aging.unknown){ %><a class="band-none" href="/money/<%= side %>?aging=unknown" style="flex-grow:<%= totals.aging.unknown %>" title="No due date: <%= amount(totals.aging.unknown) %>"></a><% } %></div><ul class="mn-legend"><% for(const [key,label,tone] of bands){const value=Number(totals.aging[key]||0);if(value){ %><li><i class="<%= tone %>"></i><%= label %> <strong><%= amount(value) %></strong></li><% }} %><% if(totals.aging.unknown){ %><li><i class="band-none"></i>No due date <strong><%= amount(totals.aging.unknown) %></strong></li><% } %></ul><% }else{ %><p class="sc-empty">Nothing outstanding.</p><% } %></div><% } %>
    <div class="mn-due__net"><span>If everyone paid today</span><strong class="<%= r.totalMinor-b.totalMinor<0?'is-urgent':'is-good' %>"><%= r.totalMinor-b.totalMinor<0?'You would owe '+amount(b.totalMinor-r.totalMinor):'You would be up '+amount(r.totalMinor-b.totalMinor) %></strong></div>
  </section>
</div>

<% if(p.revenueMinor){ %><div class="mn-health">
  <div><span>Gross margin</span><strong><%= percent(gross,p.revenueMinor) %>%</strong><small>You keep <%= cents(gross) %>¢ of every $1 sold after paying for the product.</small></div>
  <% const earned=net-count; %><div><span>Net margin</span><strong class="<%= earned<0?'is-urgent':'' %>"><%= percent(earned,p.revenueMinor) %>%</strong><small><%= earned<0?'You spent '+Math.abs(cents(earned))+'¢ more than you earned on every $1 sold.':'You keep '+cents(earned)+'¢ of every $1 sold after all costs.' %><%= count?' Stock count gains / losses are left out.':'' %></small></div>
  <div><span>Late money</span><strong class="<%= r.lateMinor?'is-urgent':'is-good' %>"><%= percent(r.lateMinor,r.totalMinor)||0 %>%</strong><small>Of what customers owe you is past its due date.</small></div>
</div><% } %>

<div class="mn-grid"><% for(const side of [{title:'Who owes you',rows:m.topCustomers,path:'/money/invoices',empty:'Nobody owes you money right now.',noun:'invoice'},{title:'Who you owe',rows:m.topSuppliers,path:'/money/bills',empty:'You have no unpaid bills.',noun:'bill'}]){ %><section class="sc-business-card mn-parties"><header><h2><%= side.title %></h2><a href="<%= side.path %>">See all</a></header><% if(!side.rows.length){ %><p class="sc-empty"><%= side.empty %></p><% } %><% for(const party of side.rows){ %><a class="sc-party-row" href="<%= side.path %>?party=<%= party.id %>"><i class="mn-avatar" aria-hidden="true"><%= initials(party.name) %></i><span><strong><%= party.name %></strong><small><%= party.count %> <%= side.noun %><%= party.count===1?'':'s' %></small></span><strong><%= amount(party.totalMinor) %></strong></a><% } %></section><% } %></div>

<section class="sc-business-card mn-cash"><header><h2>Money in and out · last six months</h2><ul class="mn-legend"><li><i class="band-in"></i>In</li><li><i class="band-out"></i>Out</li></ul></header><%- include('customer-cash-chart',{model:m}) %></section>

<details class="sc-business-card mn-words"><summary>What these words mean</summary><dl>
  <div><dt>Sales</dt><dd>What customers bought, counted when it ships, even if they have not paid yet.</dd></div>
  <div><dt>Product cost</dt><dd>What the stock you sold cost you to buy.</dd></div>
  <div><dt>Gross profit</dt><dd>Sales minus product cost.</dd></div>
  <div><dt>Stock count gains / losses</dt><dd>The difference when you count your stock and find more or less than recorded. It is not an expense.</dd></div>
  <div><dt>Expenses</dt><dd>Everything else it costs to run the business, like rent and shipping.</dd></div>
  <div><dt>Net profit</dt><dd>What is left after all of the above.</dd></div>
  <div><dt>Profit or cash?</dt><dd>Profit is what you earned. Cash is what actually moved. You can make a profit while cash goes down, if customers have not paid yet.</dd></div>
  <div><dt>How this is counted</dt><dd><%= m.basis %> basis. <%= m.basisDescription %> <%= m.profitNote %></dd></div>
</dl><p><a href="/accounting/books">Open Accountant view →</a></p></details>
