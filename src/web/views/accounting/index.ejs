<%
  const currency = configured.currency;
  const cashInPeriod = owner.cash.rows.filter(function(row) { return Number(row.cash_change_minor) > 0; })
    .reduce(function(sum, row) { return sum + Number(row.cash_change_minor); }, 0);
  const cashOutPeriod = owner.cash.rows.filter(function(row) { return Number(row.cash_change_minor) < 0; })
    .reduce(function(sum, row) { return sum + Math.abs(Number(row.cash_change_minor)); }, 0);
  const otherCashIn = Math.max(0, cashInPeriod - owner.cashActivity.customerReceivedMinor);
  const otherCashOut = Math.max(0, cashOutPeriod - owner.cashActivity.supplierPaidMinor);
  const paymentStatus = function(row) {
    if (Number(row.refundedMinor) >= Number(row.total_minor) && Number(row.total_minor) > 0) return 'REFUNDED';
    if (Number(row.refundedMinor) > 0) return 'PARTIALLY REFUNDED';
    if (Number(row.balance_minor) === 0) return 'PAID';
    if (Number(row.paidMinor) > 0) return 'PARTIALLY PAID';
    return row.daysPastDue > 0 ? 'OVERDUE' : 'UNPAID';
  };
  const billStatus = function(row) {
    if (row.status === 'DISPUTED' || row.status === 'DRAFT') return 'NEEDS REVIEW';
    if (Number(row.creditedMinor) >= Number(row.total_minor) && Number(row.paidMinor) === 0) return 'CREDITED';
    if (Number(row.creditedMinor) > 0 && Number(row.balance_minor) > 0) return 'PARTIALLY CREDITED';
    return paymentStatus(row);
  };
  const missingFacts = owner.missingBills.length + owner.unconfirmedCustomerPayments.length
    + review.length + supplierBills.reviewCount + inventoryEconomics.missingCostPositions;
%>

<div class="page-head accounting-head">
  <div>
    <p class="eyebrow">Foundry · A Keeper product · <%= workspace.name %></p>
    <h1>Your business right now</h1>
    <p class="lede">Five answers for today, then the full story for <strong><%= period.label.toLowerCase() %></strong>. Every amount opens to its source.</p>
  </div>
  <span class="badge badge--success">Up to date · Updated through <%= asOf %></span>
</div>

<form class="card accounting-period" method="get" action="/accounting">
  <div class="card-body">
    <label class="field"><span class="field-label">Explain activity for</span><select class="select" name="period" onchange="this.form.submit()">
      <% [['today','Today'],['this_week','This week'],['this_month','This month'],['last_month','Last month'],['this_quarter','This quarter'],['this_year','This year'],['all_time','All time'],['custom','Custom dates']].forEach(function(option) { %>
        <option value="<%= option[0] %>" <%= period.key === option[0] ? 'selected' : '' %>><%= option[1] %></option>
      <% }) %>
    </select></label>
    <% if (period.key === 'custom') { %>
      <label class="field"><span class="field-label">From</span><input class="input" type="date" name="from" value="<%= from %>" required></label>
      <label class="field"><span class="field-label">Through</span><input class="input" type="date" name="to" value="<%= to %>" required></label>
      <button class="btn btn--sm" type="submit">Update</button>
    <% } %>
    <p><strong>Balances</strong> are what is still open right now. <strong>Sales, payments, expenses, and profit</strong> below cover <%= from %> through <%= to %>.</p>
  </div>
</form>

<section class="accounting-owner-grid" aria-label="Your business right now">
  <a class="accounting-owner-card" href="#customers"><span>Customers owe you</span><strong><%= helpers.money(owner.customers.balanceMinor, currency) %></strong><small>Completed sales customers have not paid yet. Show customers →</small></a>
  <a class="accounting-owner-card" href="#suppliers"><span>You owe suppliers</span><strong><%= helpers.money(owner.suppliers.balanceMinor, currency) %></strong><small>Supplier bills that have not been fully paid. Show suppliers →</small></a>
  <a class="accounting-owner-card" href="#cash"><span>Customer cash received</span><strong><%= helpers.money(cashHistory.customerReceivedMinor, currency) %></strong><small>Customer money Foundry has recorded receiving. Show payments →</small></a>
  <a class="accounting-owner-card" href="#suppliers"><span>Cash paid to suppliers</span><strong><%= helpers.money(cashHistory.supplierPaidMinor, currency) %></strong><small>Supplier payments Foundry has recorded sending. Show payments →</small></a>
  <a class="accounting-owner-card accounting-owner-card--inventory" href="#inventory"><span>Inventory you own</span><strong><%= helpers.money(owner.inventory.totalCostMinor, currency) %><%= owner.inventory.missingCostUnits ? ' recorded' : '' %></strong><small><%= owner.inventory.totalUnits %> units physically in stock<%= owner.inventory.missingCostUnits ? '; cost is missing for ' + owner.inventory.missingCostUnits : '' %>. Show what I own →</small></a>
</section>

<section class="card accounting-briefing">
  <div class="card-head"><div><p class="eyebrow">Your senior-accountant explanation</p><h2>What that means — here’s what is happening</h2></div></div>
  <div class="card-body accounting-story">
    <% if (cashHistory.customerReceivedMinor === 0 && owner.customers.balanceMinor > 0) { %><p><strong>No cash profit is proven yet.</strong> Customers still owe you <%= helpers.money(owner.customers.balanceMinor,currency) %>, and Foundry has not recorded their money arriving.</p><% } %>
    <p><% if (inventoryAcquired.openingCostMinor) { %>You started Foundry with <strong><%= helpers.money(inventoryAcquired.openingCostMinor, currency) %></strong> of inventory already on hand.<% } %><% if (inventoryAcquired.receivedCostMinor) { %> You later received <strong><%= helpers.money(inventoryAcquired.receivedCostMinor, currency) %></strong> of inventory with recorded purchase cost.<% } %><% if (!inventoryAcquired.openingCostMinor && !inventoryAcquired.receivedCostMinor) { %>No inventory purchase or opening cost has been recorded yet.<% } %> You currently own <strong><%= owner.inventory.totalUnits %> units</strong> with <strong><%= helpers.money(owner.inventory.totalCostMinor, currency) %></strong> of cost proven.<%= owner.inventory.missingCostUnits ? ` I am still missing the cost for ${owner.inventory.missingCostUnits} of those units, so this value is incomplete.` : '' %></p>
    <% if (owner.pnl.revenueMinor) { %><p>During <%= period.label.toLowerCase() %>, you completed <strong><%= helpers.money(owner.pnl.revenueMinor, currency) %></strong> in sales. The products sold cost you <strong><%= helpers.money(owner.pnl.cogsMinor, currency) %></strong>, leaving <strong><%= helpers.money(owner.pnl.grossProfitMinor, currency) %></strong> before other business expenses.</p><% } else { %><p><strong>No completed customer sale is recorded yet.</strong> Draft and confirmed orders do not count until products actually leave inventory.</p><% } %>
    <% if (owner.customers.balanceMinor > 0) { %><p>Customers still owe you <strong><%= helpers.money(owner.customers.balanceMinor, currency) %></strong>. A sale and a customer payment are different events, so this amount is not called cash.</p><% } else { %><p>No completed customer balance remains unpaid right now.</p><% } %>
    <% if (owner.suppliers.balanceMinor > 0) { %><p><strong>Suppliers <%= helpers.money(owner.suppliers.totalMinor,currency) %> in supplier bills <%= helpers.money(owner.suppliers.paidMinor,currency) %> paid · <%= helpers.money(owner.suppliers.balanceMinor,currency) %> still owed by you.</strong> Receiving products and paying their supplier remain separate events.</p><% } else if (owner.missingBills.length) { %><p>I do not show money owed for <%= owner.missingBills.length %> received purchase order<%= owner.missingBills.length === 1 ? '' : 's' %> because the supplier bill is missing. That does not mean the inventory was free; it means I will not invent what the supplier billed you.</p><% } else { %><p>No approved supplier bill remains unpaid right now.</p><% } %>
    <p><strong><%= owner.pnl.netIncomeMinor >= 0 ? helpers.money(owner.pnl.netIncomeMinor, currency) + ' is the recorded profit' : helpers.money(Math.abs(owner.pnl.netIncomeMinor), currency) + ' is the recorded loss' %></strong> for <%= period.label.toLowerCase() %>. It is not the same as cash: cash moved by <strong><%= helpers.money(owner.cash.netCashChangeMinor, currency) %></strong>, and the cash currently proven in Foundry is <strong><%= helpers.money(cashMinor, currency) %></strong>.</p>
    <% if (owner.expenses.totalMinor === 0) { %><p><strong>No other business expenses are recorded for this period.</strong> If rent, payroll, shipping, fees, or other costs occurred but are missing, profit is not complete yet.</p><% } %>
  </div>
</section>

<section class="card accounting-needs" id="accounting-review">
  <div class="card-head"><div><p class="eyebrow">What I need from you</p><h2><%= missingFacts ? 'Exact facts needed to finish the story' : 'Nothing financial is waiting for you' %></h2><p class="hint"><%= missingFacts ? 'Unsupported amounts stay out until the evidence exists.' : 'Foundry will keep updating this page from real business activity.' %></p></div></div>
  <% if (missingFacts) { %><div class="card-body stack">
    <% owner.missingBills.forEach(function(row) { %><article class="accounting-task"><div><strong>I need the supplier bill for <%= row.po_number %>.</strong><p>You received <%= row.receivedUnits %> units costing <%= helpers.money(row.receivedCostMinor, row.currency) %> from <%= row.supplier_name %>, but no approved supplier bill is linked. Until it is added, I cannot say what you owe that supplier.</p></div><a class="btn btn--primary" href="/accounting/payables/new?purchaseOrderId=<%= row.id %>">Add supplier bill</a></article><% }) %>
    <% owner.unconfirmedCustomerPayments.forEach(function(row) { %><article class="accounting-task"><div><strong><%= row.order_number || row.invoice_number %> is completed for <%= helpers.money(row.total_minor, row.currency) %>, but no customer payment is recorded.</strong><p>Did <%= row.customer_name %> pay you? Foundry currently keeps the full <%= helpers.money(row.balance_minor, row.currency) %> open.</p></div><div class="button-row"><a class="btn btn--primary" href="#customer-<%= row.id %>">Record payment</a><form method="post" action="/accounting/receivables/<%= row.id %>/confirm-unpaid"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="btn btn--ghost" type="submit">Mark as unpaid</button></form><a class="btn btn--ghost" href="<%= row.sales_order_id ? '/sales/orders/' + row.sales_order_id : '/accounting/receivables' %>">Review order</a></div></article><% }) %>
    <% review.forEach(function(item) { %><article class="accounting-task"><div><strong><%= item.outcome.message || item.error_message || 'A financial fact needs evidence.' %></strong><p>Nothing was guessed and inventory will not be moved a second time.</p></div><a class="btn" href="/accounting/review/<%= item.id %>">Fix this fact</a></article><% }) %>
    <% if (owner.inventory.missingCostUnits) { %><article class="accounting-task"><div><strong>I need the original purchase cost for <%= owner.inventory.missingCostUnits %> unit<%= owner.inventory.missingCostUnits === 1 ? '' : 's' %> you physically own.</strong><%
  /* Forty versions, each saying the same thing, stood between the ask and the
     button that answers it. The count is the fact; the list is the evidence,
     and evidence belongs behind a disclosure. */
  var missingRows = owner.inventory.rows.filter(function (row) { return row.missingCostUnits; });
%>
<p>That is <%= missingRows.length %> stock position<%= missingRows.length === 1 ? '' : 's' %> across your inventory.</p>
<% if (missingRows.length) { %>
  <details class="disclose"><summary><span>Show which positions</span><span class="disclose__cue">Show</span></summary>
  <div class="disclose__body"><% missingRows.forEach(function(row) { %><p><strong><%= row.item_name %><%= row.variant_label ? ' / ' + row.variant_label : '' %></strong> at <%= row.location_name %>: <%= row.missingCostUnits %> unit<%= row.missingCostUnits === 1 ? '' : 's' %> have no proven receipt or opening cost.</p><% }) %></div>
  </details>
<% } %><p>Until that evidence is added, the inventory value and profit shown here are incomplete.</p></div><a class="btn" href="/accounting/migration?focus=inventory-cost#inventory-costs">Add the missing cost</a></article><% } %>
  </div><% } %>
</section>

<% if (owner.insights.length) { %><section class="card"><div class="card-head"><div><p class="eyebrow">Foundry noticed</p><h2>Facts worth your attention</h2></div></div><div class="card-body accounting-insights"><% owner.insights.forEach(function(insight) { %><p><strong><%= insight.text %></strong><% if (insight.amountMinor !== null) { %> <%= helpers.money(insight.amountMinor, currency) %><% } %></p><% }) %></div></section><% } %>

<section class="card accounting-owner-section" id="suppliers">
  <div class="card-head"><div><p class="eyebrow">Money you owe suppliers</p><h2><%= helpers.money(owner.suppliers.balanceMinor, currency) %> still needs payment</h2><p class="hint">Ordered quantity, received quantity, billed money, and paid money remain four separate facts.</p></div><a class="btn btn--ghost" href="/accounting/payables/new">Record an unrecognized supplier bill</a></div>
  <div class="card-body">
    <div class="accounting-mini-grid"><div><span>Total approved bills</span><strong><%= helpers.money(owner.suppliers.totalMinor, currency) %></strong></div><div><span>Total paid</span><strong><%= helpers.money(owner.suppliers.paidMinor, currency) %></strong></div><div><span>Total remaining</span><strong><%= helpers.money(owner.suppliers.balanceMinor, currency) %></strong></div><div><span>Overdue</span><strong><%= helpers.money(owner.suppliers.overdueMinor, currency) %></strong></div><div><span>Due in 7 days</span><strong><%= helpers.money(owner.suppliers.dueSoonMinor, currency) %></strong></div></div>
    <% if (!owner.suppliers.rows.length) { %><div class="empty"><strong>No supplier bills have been recorded.</strong><p>Receiving inventory does not create a bill. A matched supplier invoice or an owner-entered bill will appear here.</p></div><% } %>
    <div class="accounting-record-list"><% owner.suppliers.rows.forEach(function(row) { %><details class="accounting-record" id="supplier-<%= row.id %>"><summary><div><strong><%= row.supplier_name %> · <%= row.supplier_invoice_number || row.bill_number %></strong><span><%= row.po_number ? row.po_number + ' · ' : '' %>Due <%= row.due_date || 'not provided' %></span></div><div><span class="badge"><%= billStatus(row) %></span><strong><%= helpers.money(row.balance_minor, row.currency) %> owed</strong></div></summary><div class="accounting-record-body">
      <div class="accounting-equation"><p><span>Bill total</span><strong><%= helpers.money(row.total_minor,row.currency) %></strong></p><p><span>You paid</span><strong>− <%= helpers.money(row.paidMinor,row.currency) %></strong></p><% if (row.creditedMinor) { %><p><span>Supplier credits</span><strong>− <%= helpers.money(row.creditedMinor,row.currency) %></strong></p><% } %><p class="total"><span>Still owed</span><strong><%= helpers.money(row.balance_minor,row.currency) %></strong></p></div>
      <% if (row.purchase_order_id) { %><p><strong>Physical order:</strong> <%= row.orderedUnits %> ordered · <%= row.receivedUnits %> received · <%= row.stillExpectedUnits %> still expected. <a href="/purchasing/orders/<%= row.purchase_order_id %>">Open <%= row.po_number %></a></p><% } %>
      <details class="accounting-source"><summary>Show what was bought</summary><div><% row.lines.forEach(function(line) { %><div class="accounting-line"><div><strong><%= line.item_name || line.description %><%= line.variant_label ? ' / ' + line.variant_label : '' %></strong><span><%= line.code || '' %></span></div><div><%= line.quantity %> × <%= helpers.money(line.unit_cost_minor,row.currency) %><strong><%= helpers.money(line.line_total_minor,row.currency) %></strong></div></div><% }) %><p class="accounting-line total"><span>Total billed</span><strong><%= helpers.money(row.total_minor,row.currency) %></strong></p></div></details>
      <% if (row.lines.some(function(line) { return line.item_id && line.sku_id; })) { %><details class="accounting-action"><summary>Return physical items to this supplier</summary><div><p>Only use this when products actually leave your location. Foundry records the quantity and exact inventory cost separately from any supplier credit.</p><div class="button-row"><% row.lines.filter(function(line) { return line.item_id && line.sku_id; }).forEach(function(line) { %><a class="btn btn--ghost" href="/inventory/<%= line.item_id %>?action=issue&skuId=<%= line.sku_id %>&reasonCode=returned&reference=<%= encodeURIComponent(row.supplier_invoice_number || row.bill_number) %>">Return <%= line.item_name || line.description %></a><% }) %></div></div></details><% } %>
      <details class="accounting-source"><summary>Show supplier payments</summary><div><% if (!row.payments.length) { %><p>No supplier payment has been recorded.</p><% } %><% row.payments.forEach(function(payment) { %><p><strong><%= payment.payment_date %> · <%= helpers.money(payment.applied_minor,row.currency) %></strong> <%= payment.reference || payment.method || '' %></p><% }) %></div></details>
      <% if (row.credits.length) { %><details class="accounting-source"><summary>Show supplier credits</summary><div><% row.credits.forEach(function(credit) { %><p><strong><%= credit.credit_date %> · <%= helpers.money(credit.amount_minor,row.currency) %></strong> <%= credit.credit_number || '' %> <%= credit.reason || '' %></p><% }) %></div></details><% } %>
      <details class="accounting-source"><summary>Show evidence and audit trail</summary><div><p>Recorded <strong><%= String(row.created_at).replace('T',' ').slice(0,19) %></strong><%= row.recorded_by ? ' by ' + row.recorded_by : ' automatically from connected evidence' %>.</p><% if (row.purchase_order_id) { %><p>Purchase evidence: <a href="/purchasing/orders/<%= row.purchase_order_id %>"><%= row.po_number %></a>.</p><% } %><% if (row.evidence_message_id || row.evidence_document_id) { %><p>The original supplier email/document is preserved with the supplier communication evidence.</p><% } %><% if (row.journal_entry_id) { %><p><a href="/accounting/entries/<%= row.journal_entry_id %>">Show the posted accounting record</a></p><% } %></div></details>
      <% if (['OPEN','PARTIALLY_PAID'].includes(row.status)) { %><details class="accounting-action"><summary>Record a supplier payment</summary><form method="post" action="/accounting/payables/<%= row.id %>/payment" class="form-inline"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="idempotencyKey" value="<%= row.id %>-<%= Date.now() %>"><input type="hidden" name="returnTo" value="/accounting#supplier-<%= row.id %>"><label class="field"><span class="field-label">Payment date</span><input class="input" type="date" name="paymentDate" value="<%= asOf %>" required></label><label class="field"><span class="field-label">Amount actually paid</span><input class="input" name="amount" inputmode="decimal" value="<%= (row.balance_minor/100).toFixed(2) %>" required></label><label class="field"><span class="field-label">Reference</span><input class="input" name="reference" placeholder="Check, transfer, card…"></label><button class="btn btn--primary" type="submit">Record payment</button></form></details><% } %>
      <% if (['OPEN','PARTIALLY_PAID'].includes(row.status)) { %><a class="btn btn--ghost" href="/accounting/supplier-credits/new?billId=<%= row.id %>">Record supplier credit</a><% } %>
    </div></details><% }) %></div>
  </div>
</section>

<section class="card accounting-owner-section" id="customers">
  <div class="card-head"><div><p class="eyebrow">Money customers owe you</p><h2><%= helpers.money(owner.customers.balanceMinor, currency) %> is still uncollected</h2><p class="hint">A completed sale records what the customer owes. Cash appears only when a payment is recorded.</p></div></div>
  <div class="card-body">
    <div class="accounting-mini-grid"><div><span>Completed sales billed</span><strong><%= helpers.money(owner.customers.totalMinor,currency) %></strong></div><div><span>Money received</span><strong><%= helpers.money(owner.customers.paidMinor,currency) %></strong></div><div><span>Still owed</span><strong><%= helpers.money(owner.customers.balanceMinor,currency) %></strong></div><div><span>Overdue</span><strong><%= helpers.money(owner.customers.overdueMinor,currency) %></strong></div></div>
    <% if (!owner.customers.rows.length) { %><div class="empty"><strong>No completed customer sales are recorded.</strong><p>Foundry creates the customer balance automatically when products are shipped.</p></div><% } %>
    <div class="accounting-record-list"><% owner.customers.rows.forEach(function(row) { %><details class="accounting-record" id="customer-<%= row.id %>"><summary><div><strong><%= row.order_number || row.invoice_number %> · <%= row.customer_name %></strong><span><%= row.issue_date %> · Due <%= row.due_date || 'not provided' %></span></div><div><span class="badge"><%= paymentStatus(row) %></span><strong><%= helpers.money(row.balance_minor,row.currency) %> owed</strong></div></summary><div class="accounting-record-body">
      <div class="accounting-equation"><p><span>Sale total</span><strong><%= helpers.money(row.total_minor,row.currency) %></strong></p><p><span>Customer paid</span><strong>− <%= helpers.money(row.paidMinor,row.currency) %></strong></p><p class="total"><span>Still owed</span><strong><%= helpers.money(row.balance_minor,row.currency) %></strong></p></div>
      <details class="accounting-source"><summary>Show what was sold</summary><div><% row.lines.forEach(function(line) { %><div class="accounting-line"><div><strong><%= line.item_name || line.description %><%= line.variant_label ? ' / ' + line.variant_label : '' %></strong><span><%= line.quantity %> × <%= helpers.money(line.unit_price_minor,row.currency) %></span></div><div><span>Sale <%= helpers.money(line.line_total_minor,row.currency) %></span><span>Recorded cost <%= line.costMinor === null ? 'missing' : helpers.money(line.costMinor,row.currency) %></span><strong>Gross profit <%= line.grossProfitMinor === null ? 'not proven' : helpers.money(line.grossProfitMinor,row.currency) %></strong></div></div><% }) %><div class="accounting-explanation"><% if (row.productCostMinor === null) { %>The exact product cost is missing, so Foundry will not invent gross profit for this sale.<% } else { %>You sold these products for <%= helpers.money(row.total_minor,row.currency) %>. They cost <%= helpers.money(row.productCostMinor,row.currency) %>. That created <%= helpers.money(row.total_minor-row.productCostMinor,row.currency) %> of gross profit before other business expenses.<% } %></div></div></details>
      <details class="accounting-source"><summary>Show customer payments</summary><div><% if (!row.payments.length) { %><p>No customer payment has been recorded.</p><% } %><% row.payments.forEach(function(payment) { %><p><strong><%= payment.payment_date %> · <%= helpers.money(payment.applied_minor,row.currency) %></strong> <%= payment.reference || payment.method || '' %></p><% }) %></div></details>
      <% if (row.refunds.length) { %><details class="accounting-source"><summary>Show customer refunds</summary><div><% row.refunds.forEach(function(refund) { %><p><strong><%= refund.refund_date %> · <%= helpers.money(refund.amountMinor,row.currency) %> refunded</strong> <%= refund.refund_reference || '' %><%= refund.physical_return ? ' · inventory returned' : ' · inventory unchanged' %></p><% }) %></div></details><% } %>
      <details class="accounting-source"><summary>Show evidence and audit trail</summary><div><p>Created <strong><%= String(row.created_at).replace('T',' ').slice(0,19) %></strong><%= row.recorded_by ? ' by ' + row.recorded_by : ' automatically from the completed sale' %>.</p><% if (row.sales_order_id) { %><p>Sale evidence: <a href="/sales/orders/<%= row.sales_order_id %>"><%= row.order_number %></a>.</p><% } %><% if (row.journal_entry_id) { %><p><a href="/accounting/entries/<%= row.journal_entry_id %>">Show the posted accounting record</a></p><% } %></div></details>
      <% if (['OPEN','PARTIALLY_PAID'].includes(row.status)) { %><details class="accounting-action"><summary>Record a customer payment</summary><form method="post" action="/accounting/receivables/<%= row.id %>/payment" class="form-inline"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="idempotencyKey" value="<%= row.id %>-<%= Date.now() %>"><input type="hidden" name="returnTo" value="/accounting#customer-<%= row.id %>"><label class="field"><span class="field-label">Payment date</span><input class="input" type="date" name="paymentDate" value="<%= asOf %>" required></label><label class="field"><span class="field-label">Amount actually received</span><input class="input" name="amount" inputmode="decimal" value="<%= (row.balance_minor/100).toFixed(2) %>" required></label><label class="field"><span class="field-label">Reference</span><input class="input" name="reference" placeholder="Deposit, card, check…"></label><button class="btn btn--primary" type="submit">Record payment</button></form></details><% } %>
      <% if (row.sales_order_id) { %><a class="btn btn--ghost" href="/sales/orders/<%= row.sales_order_id %>">Review customer order</a><% } %>
      <% if (row.originalJournalEntryId && row.refundedMinor < row.total_minor) { %><a class="btn btn--ghost" href="/accounting/refunds/new?invoiceId=<%= row.id %>">Record refund</a><% } %>
    </div></details><% }) %></div>
  </div>
</section>

<section class="card accounting-owner-section" id="inventory">
  <div class="card-head"><div><p class="eyebrow">Inventory you currently own</p><h2><%= owner.inventory.totalUnits %> units · <%= helpers.money(owner.inventory.totalCostMinor,currency) %> recorded cost</h2><p class="hint"><%= owner.inventory.skuCount %> products/variants across <%= owner.inventory.locationCount %> location<%= owner.inventory.locationCount === 1 ? '' : 's' %>.<%= owner.inventory.missingCostUnits ? ` Cost evidence is missing for ${owner.inventory.missingCostUnits} unit${owner.inventory.missingCostUnits === 1 ? '' : 's'}.` : '' %></p></div><a class="btn btn--ghost" href="/inventory">Open Inventory</a></div>
  <div class="card-body"><div class="accounting-explanation"><strong>This is property the business still owns.</strong> It is not cash and it is not profit. Its recorded cost becomes product cost only as units are sold or otherwise leave the business.</div>
    <details class="accounting-source"><summary>Show what I own</summary><div><% owner.inventory.rows.forEach(function(row) { %><div class="accounting-line"><div><strong><%= row.item_name %><%= row.variant_label ? ' / ' + row.variant_label : '' %></strong><span><%= row.location_name %> · <%= row.code %></span></div><div><span><%= row.quantityUnits %> units<%= row.averageUnitCostMinor === null ? '' : ' × ' + helpers.money(row.averageUnitCostMinor,currency) %></span><strong><%= row.missingCostUnits ? `Cost missing for ${row.missingCostUnits} · ` : '' %><%= row.costedUnits ? helpers.money(row.totalCostMinor,currency) + ' recorded' : 'No cost recorded' %></strong></div></div><% }) %><% if (!owner.inventory.rows.length) { %><p>No inventory is physically on hand.</p><% } %></div></details>
    <details class="accounting-source"><summary>Show how Foundry calculated this</summary><div class="accounting-equation"><% if (inventoryAcquired.openingCostMinor) { %><p><span>Started with inventory already on hand</span><strong><%= helpers.money(inventoryAcquired.openingCostMinor,currency) %></strong></p><% } %><p><span>Inventory received after setup</span><strong><%= helpers.money(inventoryAcquired.receivedCostMinor,currency) %></strong></p><p><span>Less cost of sold items</span><strong>− <%= helpers.money(lifetimePnl.cogsMinor,currency) %></strong></p><% if (inventoryAcquired.otherInventoryReductionMinor > 0) { %><p><span>Less adjustments and other removals</span><strong>− <%= helpers.money(inventoryAcquired.otherInventoryReductionMinor,currency) %></strong></p><% } %><p class="total"><span>Inventory still owned</span><strong><%= helpers.money(owner.inventory.totalCostMinor,currency) %></strong></p></div></details>
  </div>
</section>

<section class="card accounting-owner-section" id="removed">
  <div class="card-head"><div><p class="eyebrow">What left inventory</p><h2>Every removal for <%= period.label.toLowerCase() %></h2><p class="hint">Customer sales stay separate from damage, loss, adjustments, supplier returns, and transfers.</p></div></div>
  <div class="card-body"><div class="accounting-mini-grid"><% owner.removals.categories.forEach(function(category) { %><div><span><%= category.label %></span><strong><%= category.units %> units</strong><small><%= helpers.money(category.costMinor,currency) %> recorded cost</small></div><% }) %><% if (!owner.removals.categories.length) { %><div><span>No removals</span><strong>0 units</strong></div><% } %></div>
    <details class="accounting-source"><summary>Show inventory that left</summary><div><% owner.removals.rows.forEach(function(row) { %><div class="accounting-line"><div><strong><%= row.item_name %><%= row.variant_label ? ' / ' + row.variant_label : '' %></strong><span><%= row.category %> · <%= row.location_name %> · <%= String(row.occurred_at).slice(0,10) %><%= row.order_number ? ' · ' + row.order_number : '' %></span></div><div><span><%= row.quantityUnits %> units</span><strong><%= helpers.money(row.costMinor,currency) %> cost</strong></div></div><% }) %><% if (!owner.removals.rows.length) { %><p>No costed inventory left during this period.</p><% } %></div></details>
  </div>
</section>

<section class="card accounting-owner-section" id="profit">
  <div class="card-head"><div><p class="eyebrow">Are you making money?</p><h2><%= owner.pnl.netIncomeMinor >= 0 ? helpers.money(owner.pnl.netIncomeMinor,currency) + ' recorded profit' : helpers.money(Math.abs(owner.pnl.netIncomeMinor),currency) + ' recorded loss' %></h2><p class="hint"><%= from %> through <%= to %>. Profit is earned activity; it is not the same as cash received.</p></div></div>
  <div class="card-body"><div class="accounting-profit-story"><div class="accounting-equation"><p><span>Sales completed</span><strong><%= helpers.money(owner.pnl.revenueMinor,currency) %></strong></p><p><span>Cost of products sold</span><strong>− <%= helpers.money(owner.pnl.cogsMinor,currency) %></strong></p><p class="subtotal"><span>Gross profit</span><strong><%= helpers.money(owner.pnl.grossProfitMinor,currency) %></strong></p><p><span>Other business expenses</span><strong>− <%= helpers.money(owner.pnl.operatingExpenseMinor,currency) %></strong></p><p class="total"><span>Net profit</span><strong><%= helpers.money(owner.pnl.netIncomeMinor,currency) %></strong></p></div><div class="accounting-explanation">You sold <%= helpers.money(owner.pnl.revenueMinor,currency) %> of products. Those products cost <%= helpers.money(owner.pnl.cogsMinor,currency) %>. That left <%= helpers.money(owner.pnl.grossProfitMinor,currency) %> before normal business expenses. After <%= helpers.money(owner.pnl.operatingExpenseMinor,currency) %> of other recorded expenses, the business <%= owner.pnl.netIncomeMinor >= 0 ? 'earned ' + helpers.money(owner.pnl.netIncomeMinor,currency) : 'lost ' + helpers.money(Math.abs(owner.pnl.netIncomeMinor),currency) %>. Customer payment timing does not change this earned-profit calculation.</div></div>
    <details class="accounting-source"><summary>Show how Foundry calculated profit</summary><div><% owner.pnl.income.forEach(function(row) { if (row.net_minor) { %><p><%= row.name %>: <strong><%= helpers.money(row.normal_balance === 'DEBIT' ? -row.net_minor : row.net_minor,currency) %></strong></p><% } }) %><% owner.pnl.cogs.forEach(function(row) { if (row.net_minor) { %><p><%= row.name %>: <strong><%= helpers.money(row.net_minor,currency) %></strong></p><% } }) %><% owner.pnl.expenses.forEach(function(row) { if (row.net_minor) { %><p><%= row.name %>: <strong><%= helpers.money(row.net_minor,currency) %></strong></p><% } }) %><% if (!owner.pnl.revenueMinor && !owner.pnl.cogsMinor && !owner.pnl.operatingExpenseMinor) { %><p>No posted profit activity exists for this period.</p><% } %></div></details>
  </div>
</section>

<section class="card accounting-owner-section" id="cash">
  <div class="card-head"><div><p class="eyebrow">Where your cash went</p><h2><%= helpers.money(owner.cash.netCashChangeMinor,currency) %> net cash movement</h2><p class="hint"><%= period.label %> activity. Current proven cash position: <%= helpers.money(cashMinor,currency) %>.</p></div></div>
  <div class="card-body"><div class="accounting-equation"><p><span>Money received from customers</span><strong><%= helpers.money(owner.cashActivity.customerReceivedMinor,currency) %></strong></p><p><span>Other cash received</span><strong><%= helpers.money(otherCashIn,currency) %></strong></p><p><span>Payments sent to suppliers</span><strong>− <%= helpers.money(owner.cashActivity.supplierPaidMinor,currency) %></strong></p><p><span>Other recorded cash paid</span><strong>− <%= helpers.money(otherCashOut,currency) %></strong></p><p class="total"><span>Net cash movement</span><strong><%= helpers.money(owner.cash.netCashChangeMinor,currency) %></strong></p></div>
    <div class="accounting-explanation"><strong>Profit and cash answer different questions.</strong> Profit explains what the business earned after product cost and recorded expenses. Cash explains money that actually arrived or left. They differ when customers still owe you, supplier bills remain unpaid, or cash was used to buy inventory that has not sold yet.</div>
    <details class="accounting-source"><summary>Show every cash movement</summary><div><% owner.cash.rows.forEach(function(row) { %><div class="accounting-line"><div><strong><%= row.description %></strong><span><%= row.posting_date %> · <%= row.source_type.replaceAll('_',' ') %></span></div><strong><%= Number(row.cash_change_minor) >= 0 ? '+' : '−' %> <%= helpers.money(Math.abs(Number(row.cash_change_minor)),currency) %></strong></div><% }) %><% if (!owner.cash.rows.length) { %><p>No cash movement is recorded for this period.</p><% } %></div></details>
  </div>
</section>

<section class="card accounting-owner-section" id="inventory-money">
  <div class="card-head"><div><p class="eyebrow">The money in your inventory</p><h2>Where your inventory purchase stands</h2><p class="hint">Foundry keeps the products you bought visible here. It does not hide them inside “other expenses.”</p></div><a class="btn btn--ghost" href="#inventory">Show the inventory I own</a></div>
  <div class="card-body">
    <div class="accounting-mini-grid">
      <div><span>Total inventory cost recorded</span><strong><%= helpers.money(inventoryAcquired.costMinor,currency) %></strong><small><%= inventoryAcquired.openingCostMinor ? helpers.money(inventoryAcquired.openingCostMinor,currency) + ' was already on hand at setup; ' : '' %><%= helpers.money(inventoryAcquired.receivedCostMinor,currency) %> arrived later. This does not prove when or whether suppliers were paid.</small></div>
      <div><span>Cash paid to suppliers</span><strong><%= helpers.money(cashHistory.supplierPaidMinor,currency) %></strong><small>Only payments Foundry has evidence actually left.</small></div>
      <div><span>Still owed on supplier bills</span><strong><%= helpers.money(owner.suppliers.balanceMinor,currency) %></strong><small>Approved supplier bills minus payments and credits.</small></div>
      <div><span>Product cost still in stock</span><strong><%= helpers.money(owner.inventory.totalCostMinor,currency) %></strong><small>Inventory you still own. It is not profit and it is not cash.</small></div>
      <div><span>Product cost already sold</span><strong><%= helpers.money(lifetimePnl.cogsMinor,currency) %></strong><small>The purchase cost that became an expense when those products sold.</small></div>
    </div>
    <div class="accounting-explanation"><strong>The simple rule:</strong> buying inventory uses or commits money, but unsold products remain something the business owns. Their cost becomes a profit expense only as the products sell. Foundry therefore shows opening inventory, later receipts, supplier bills, supplier payments, inventory still owned, and product cost sold as separate facts.</div>
    <% if (owner.missingBills.length) { %><div class="quiet-note quiet-note--warn"><strong>The purchase did not disappear.</strong> <%= helpers.money(owner.missingBills.reduce(function(sum,row){ return sum + row.receivedCostMinor; },0),currency) %> of received inventory has no linked supplier bill. Foundry knows what the products cost from the purchase order, but will not say you owe that amount until the supplier bill exists.</div><% } %>
  </div>
</section>

<section class="card accounting-owner-section" id="expenses">
  <div class="card-head"><div><p class="eyebrow">Other business expenses</p><h2><%= helpers.money(owner.expenses.totalMinor,currency) %> recorded for <%= period.label.toLowerCase() %></h2><p class="hint">This is intentionally separate from inventory purchases above. It covers rent, payroll, shipping, fees, advertising, insurance, professional services, taxes, and other operating costs.</p></div><a class="btn btn--primary" href="/accounting/payables/new?kind=expense">Record another expense</a></div>
  <div class="card-body"><% if (!owner.expenses.rows.length) { %><div class="empty"><strong>No other business expenses are recorded for this period.</strong><p>If the business had expenses, add the real bill or receipt so Foundry can finish net profit without guessing.</p></div><% } %><details class="accounting-source"><summary>Show expenses</summary><div><% owner.expenses.rows.forEach(function(row) { %><div class="accounting-line"><div><strong><%= row.category_name %><%= row.supplier_name ? ' · ' + row.supplier_name : '' %></strong><span><%= row.posting_date %> · <%= row.entry_description %><%= row.bill_status ? ' · ' + row.bill_status.replaceAll('_',' ') : '' %></span></div><strong><%= helpers.money(row.amountMinor,currency) %></strong></div><% }) %><% if (!owner.expenses.rows.length) { %><p>Nothing to show.</p><% } %></div></details></div>
</section>

<details class="card advanced-settings accounting-details">
  <summary class="card-head"><div><h2>Show me the accounting details</h2><p class="hint">Optional reports for an accountant. Owners do not need these to understand the page above.</p></div></summary>
  <div class="card-body stack">
    <div class="accounting-source-facts">
      <% if (inventoryAcquired.openingCostMinor) { %><p><span>Product cost already on hand when Foundry started</span><strong><%= helpers.money(inventoryAcquired.openingCostMinor,currency) %></strong></p><% } %>
      <p><span>Product cost recorded from later receipts</span><strong><%= helpers.money(inventoryAcquired.receivedCostMinor,currency) %></strong></p>
      <p><span>Cost of products already sold</span><strong><%= helpers.money(lifetimePnl.cogsMinor,currency) %></strong></p>
      <% if (inventoryAcquired.otherInventoryReductionMinor > 0) { %><p><span>Cost removed through earlier inventory activity</span><strong><%= helpers.money(inventoryAcquired.otherInventoryReductionMinor,currency) %></strong></p><% } %>
      <p><span>Cost of products still in stock</span><strong><%= helpers.money(owner.inventory.totalCostMinor,currency) %> · <%= owner.inventory.totalUnits %> units you still own</strong></p>
      <p><span>Customer sales completed</span><strong><%= helpers.money(lifetimePnl.revenueMinor,currency) %></strong></p>
      <p><span>Customer cash actually received</span><strong><%= helpers.money(cashHistory.customerReceivedMinor,currency) %></strong></p>
      <p><span>Customers still need to pay you</span><strong><%= helpers.money(owner.customers.balanceMinor,currency) %></strong></p>
      <p><span>Total cash paid out</span><strong><%= helpers.money(cashHistory.cashOutMinor,currency) %></strong></p>
      <p><span>Cash paid specifically to suppliers</span><strong><%= helpers.money(cashHistory.supplierPaidMinor,currency) %></strong></p>
    </div>
    <div><h3>Where the product cost went</h3><div class="accounting-cost-flow"><p><span>All recorded inventory cost</span><strong><%= helpers.money(inventoryAcquired.costMinor,currency) %></strong></p><p><span>Minus product cost already sold</span><strong><%= helpers.money(lifetimePnl.cogsMinor,currency) %></strong></p><% if (inventoryAcquired.otherInventoryReductionMinor > 0) { %><p><span>Minus earlier inventory reductions</span><strong><%= helpers.money(inventoryAcquired.otherInventoryReductionMinor,currency) %></strong></p><% } %><p class="accounting-cost-flow__total"><span>Product cost still in your inventory</span><strong><%= helpers.money(owner.inventory.totalCostMinor,currency) %></strong></p></div></div>
    <div class="accounting-next-list"><h3>What updates automatically</h3><p>Customer shipments create the completed sale and customer balance. Customer payments reduce only that balance and increase cash. Supplier invoices create supplier debt. Supplier payments reduce only that debt. Physical receipts change inventory without pretending a bill was paid.</p></div>
    <div><h3>Orders, history, and accountant reports</h3><p class="hint">Source records or formal reports are available below.</p><div class="action-grid"><a href="/accounting/reports/profit-and-loss?from=<%= from %>&to=<%= to %>">Profit and loss</a><a href="/accounting/reports/balance-sheet?to=<%= asOf %>">Balance sheet</a><a href="/accounting/receivables">Customer invoice register</a><a href="/accounting/payables">Supplier bill register</a><a href="/accounting/reports/inventory-valuation">Inventory valuation</a><a href="/accounting/transactions">Full transaction history</a><a href="/accounting/reports/general-ledger?from=<%= from %>&to=<%= to %>">General ledger</a><a href="/accounting/banking">Bank reconciliation</a><a href="/accounting/periods">Periods and closing</a><a href="/activity">Audit trail</a></div></div>
  </div>
</details>
