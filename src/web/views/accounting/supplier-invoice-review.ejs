<header class="rm-head"><p class="eyebrow">Supplier invoice evidence</p><h1><%= bill.supplier_invoice_number||bill.bill_number %> · <%= bill.supplier_name %></h1><p><%= bill.status==='DISPUTED'?'This bill is disputed and is not included in posted supplier debt.':'Recorded status: '+bill.status.toLowerCase().replaceAll('_',' ')+'.' %> Reading it does not receive stock or pay the supplier.</p></header>
<section class="card"><div class="card-body"><dl><dt>Supplier</dt><dd><%= bill.supplier_name %></dd><dt>Invoice amount</dt><dd><strong><%= helpers.money(bill.total_minor,bill.currency) %></strong></dd><dt>Issued</dt><dd><%= helpers.shortDate(bill.issue_date) %></dd><dt>Due</dt><dd><%= bill.due_date?helpers.shortDate(bill.due_date):'Not supplied' %></dd><% if(bill.purchase_order_id){ %><dt>Purchase order</dt><dd><a href="/purchasing/orders/<%= bill.purchase_order_id %>"><%= bill.po_number %></a></dd><% } %></dl><% if(bill.source_message_id){ %><p><a class="btn" href="/mail/<%= bill.source_message_id %>">Read the source email and attachments</a></p><% } %></div><div class="table-scroll"><table class="table"><thead><tr><th>Product or service</th><th>Quantity</th><th>Price each</th><th>Line total</th></tr></thead><tbody><% for(const line of bill.lines){ %><tr><th scope="row"><%= line.description %></th><td><%= line.quantity %></td><td><%= helpers.money(line.unit_cost_minor,bill.currency) %></td><td><%= helpers.money(line.line_total_minor,bill.currency) %></td></tr><% } %></tbody></table></div><div class="card-body"><% for(const charge of bill.charges||[]){ %><p><%= charge.label %>: <%= helpers.money(charge.amountMinor,bill.currency) %></p><% } %><p>Tax: <%= helpers.money(bill.tax_minor,bill.currency) %>.</p></div></section>
<section class="card"><div class="card-body"><h2>What needs attention</h2><% const differences=review?review.differences:bill.exception_detail.differences||[];if(differences.length){ %><ul><% for(const difference of differences){ %><li><%= differenceLabel(difference.kind) %></li><% } %></ul><% }else{ %><p><%= review?'The recorded invoice now matches the approved purchase order and physically confirmed receipts.':'No unresolved matching difference is recorded.' %></p><% } %>
<% if(canReview&&review){ %><form method="post" action="/accounting/payables/<%= bill.id %>/review"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="matchFingerprint" value="<%= review.matchFingerprint %>"><input type="hidden" name="revision" value="<%= review.billRevision %>"><label class="field"><span class="field-label">Review note</span><input class="input" name="reason" required maxlength="1000" placeholder="Explain the evidence you checked"></label><p><%= review.status==='OPEN'?'Approval posts this exact existing bill for '+helpers.money(review.totalMinor,review.currency)+'.':'Saving keeps this exact bill disputed; it does not bypass the remaining differences.' %> No stock or payment changes.</p><button class="btn btn--primary" type="submit"><%= review.status==='OPEN'?'Approve matched bill and post invoice':'Save review; keep bill disputed' %></button></form><% }else if(['DRAFT','DISPUTED'].includes(bill.status)){ %><p><%= canReview?'This older bill needs an evidenced accounting correction before it can be posted.':'An owner or accountant must review this invoice before it can be posted.' %></p><% } %><p><a href="/ask?from=<%= encodeURIComponent('/accounting/payables/'+bill.id) %>">Ask StockChief about this invoice</a> · <a href="/accounting/payables">All supplier bills</a></p></div></section>
<% if(bill.exception_detail.reviews?.length){ %><details class="card"><summary class="card-head">Review history</summary><div class="card-body"><% for(const entry of bill.exception_detail.reviews){ %><p><time datetime="<%= entry.at %>"><time data-local-time datetime="<%= entry.at %>"><%= helpers.dateTime(entry.at) %></time></time> · <%= entry.reason %> · <%= entry.status.toLowerCase() %></p><% } %></div></details><% } %>
