<% const m=model,amount=n=>helpers.money(n,m.currency),q=new URLSearchParams({from:m.from,to:m.to}).toString(),places=r=>[r.location,r.source_channel].filter(Boolean).join(' · '); %><a class="back-link" href="/money?<%= q %>">‹ Money</a><header class="sc-business-head"><div><h1><%= title %></h1><p><%= helpers.shortDate(m.from) %> – <%= helpers.shortDate(m.to) %> · <%= m.currency %> · <%= m.basis %> basis</p></div><strong class="sc-headline <%= totalMinor<0?'is-urgent':'' %>" data-source-total="<%= totalMinor %>"><%= amount(totalMinor) %></strong></header><%- include('customer-period',{model:m,action:metric==='cash'?'/money/cash':'/money/sources/'+metric}) %><p class="sc-business-note">Every record that adds up to this total. Open one to see where it came from. Negative amounts reduce the total.<%= metric==='cash'?' This view shows recorded cash movements only.':'' %></p>
<section class="sc-business-card md-list"><% if(!records.length){ %><p class="sc-empty">No recorded amounts match these dates.</p><% }else{ %><div class="md-row md-row--source md-row--head" aria-hidden="true"><span>Date</span><span>What happened</span><span>Who</span><span class="is-num">Amount</span></div><% } %><div class="sc-record-list"><% for(const r of records){ %><article class="md-row md-row--source" data-source-row data-amount-minor="<%= r.amountMinor %>"><a class="md-row__open" href="<%= r.href %>" aria-label="View source record"></a><time><%= helpers.shortDate(r.posting_date) %></time><div><strong><%= helpers.customerCopy(r.description) %></strong><small><%= r.account_name %><% if(places(r)){ %> · <%= places(r) %><% } %><% if(r.item_id){ %> · <a href="/inventory/<%= r.item_id %>">View product</a><% } %></small></div><div class="md-row__who"><% if(r.customer_id){ %><a href="/sales/customers/<%= r.customer_id %>"><%= r.customer %></a><% } %><% if(r.supplier_id){ %><a href="/suppliers/<%= r.supplier_id %>"><%= r.supplier %></a><% } %></div><strong class="is-num <%= r.amountMinor<0?'is-urgent':'' %>"><%= amount(r.amountMinor) %></strong></article><% } %></div><footer class="sc-list-total"><span><%= listTotal %> contributing record<%= listTotal===1?'':'s' %></span><strong><%= amount(totalMinor) %></strong></footer><%- include('../partials/pager') %></section>
