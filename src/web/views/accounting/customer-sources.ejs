<% const m=model,amount=n=>helpers.money(n,m.currency),q=new URLSearchParams({from:m.from,to:m.to}).toString(); %><a class="back-link" href="/money?<%= q %>">‹ Money</a><header class="sc-business-head"><div><h1><%= title %></h1><p><%= helpers.shortDate(m.from) %> – <%= helpers.shortDate(m.to) %> · <%= m.timeZone %> · <%= m.currency %></p></div><strong class="sc-headline" data-source-total="<%= totalMinor %>"><%= amount(totalMinor) %></strong></header><%- include('customer-period',{model:m,action:metric==='cash'?'/money/cash':'/money/sources/'+metric}) %><p class="sc-business-note">These are the exact contributing records. Negative amounts reduce this total. <%= m.basis %> basis<%= metric==='cash'?' for the profit reports; this view shows recorded cash movements only':'' %>.</p>
<section class="sc-business-card"><div class="sc-record-list"><% if(!records.length){ %><p class="sc-empty">No recorded amounts match these dates.</p><% } %><% for(const r of records){ %><article data-source-row data-amount-minor="<%= r.amountMinor %>"><div><strong><%= r.description %></strong><a href="<%= r.href %>">View source record</a><small><%= r.account_name %></small></div><div><time><%= helpers.shortDate(r.posting_date) %></time><% if(r.customer_id){ %><a href="/sales/customers/<%= r.customer_id %>"><%= r.customer %></a><% } %><% if(r.supplier_id){ %><a href="/suppliers/<%= r.supplier_id %>"><%= r.supplier %></a><% } %><small><%= r.location||'Location not recorded' %> · <%= r.source_channel||'Channel not recorded' %> · <%= r.source_type.replaceAll('_',' ') %></small><% if(r.item_id){ %><a href="/inventory/<%= r.item_id %>">Product</a><% } %></div><strong><%= amount(r.amountMinor) %></strong></article><% } %></div><footer class="sc-list-total"><span><%= records.length %> contributing records</span><strong><%= amount(totalMinor) %></strong></footer></section>
