<div class="page-head"><div><a class="back-link" href="/accounting">‹ Accounting</a><p class="eyebrow"><%= kind === 'receivables' ? 'Accounts receivable' : 'Accounts payable' %></p><h1><%= title %></h1>
  <p class="lede"><%= kind === 'receivables' ? 'Customer invoices and payments, with the remaining balance kept separate from revenue.' : 'Supplier bills and payments, matched to purchasing evidence where available.' %></p></div><a class="btn" href="<%= kind === 'receivables' ? '/sales/new' : '/purchasing/orders' %>"><%= kind === 'receivables' ? 'Create in Sales' : 'Open Purchasing' %></a></div>

<div class="notice"><div><strong><%= kind === 'receivables' ? 'Invoices normally start with the customer order.' : 'Bills normally start with the supplier invoice or purchasing record.' %></strong><br><%= kind === 'receivables' ? 'Foundry uses the confirmed selling price and posts the invoice automatically from that source.' : 'Mission 13 supplier email and PO matching carry the supplier, amounts, and evidence into Accounting automatically.' %></div></div>

<section class="card"><div class="card-head"><h2>Aging</h2><strong><%= helpers.money(aging.totalMinor) %> open</strong></div><div class="card-body"><div class="stat-grid">
  <div class="stat"><span>Current</span><strong><%= helpers.money(aging.buckets.current) %></strong></div><div class="stat"><span>1–30 days late</span><strong><%= helpers.money(aging.buckets.days1to30) %></strong></div><div class="stat"><span>31–60</span><strong><%= helpers.money(aging.buckets.days31to60) %></strong></div><div class="stat"><span>61–90</span><strong><%= helpers.money(aging.buckets.days61to90) %></strong></div><div class="stat"><span>Over 90</span><strong><%= helpers.money(aging.buckets.over90) %></strong></div>
</div></div></section>

<section class="card"><div class="card-head"><h2><%= kind === 'receivables' ? 'Customer invoices' : 'Supplier bills' %></h2></div><div class="card-body">
  <% if (!rows.length) { %><div class="empty"><strong>Nothing recorded yet.</strong><p><%= kind === 'receivables' ? 'Customer invoices will appear here.' : 'Supplier bills and matched Mission 13 invoices will appear here.' %></p></div><% } else { %><div class="stack"><% rows.forEach(function(row){ var open = ['OPEN','PARTIALLY_PAID'].includes(row.status); %>
    <details class="list-row"><summary><div><strong><%= kind === 'receivables' ? row.invoice_number : row.bill_number %> · <%= kind === 'receivables' ? row.customer_name : row.supplier_name %></strong><p class="muted">Due <%= row.due_date || 'not set' %> · <%= row.status.replaceAll('_',' ') %><%= kind === 'payables' ? ` · ${row.match_status.replaceAll('_',' ')}` : '' %></p></div><strong><%= helpers.money(row.balance_minor,row.currency) %></strong></summary>
      <div class="stack-sm"><p>Original total: <strong><%= helpers.money(row.total_minor,row.currency) %></strong>. Remaining: <strong><%= helpers.money(row.balance_minor,row.currency) %></strong>.</p>
      <% if (open) { %><details class="advanced-settings"><summary><strong>Record a payment that did not arrive through a connection</strong><p class="hint">Manual fallback only. Connected or imported bank evidence should be matched instead of entered twice.</p></summary><form method="post" action="/accounting/<%= kind %>/<%= row.id %>/payment" class="form-inline"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="idempotencyKey" value="<%= row.id %>-<%= Date.now() %>"><label class="field"><span class="field-label">Payment date</span><input class="input" type="date" name="paymentDate" value="<%= new Date().toISOString().slice(0,10) %>" required></label><label class="field"><span class="field-label">Amount actually paid</span><input class="input" name="amount" inputmode="decimal" value="<%= (row.balance_minor/100).toFixed(2) %>" required></label><label class="field"><span class="field-label">Reference</span><input class="input" name="reference" placeholder="Check, transfer, card…"></label><button class="btn btn--sm" type="submit">Record this payment</button></form><p class="hint">This reduces the open balance; it does not create revenue or expense again.</p></details><% } %></div>
    </details><% }) %></div><% } %>
</div></section>

<details class="card advanced-settings"><summary class="card-head"><div><p class="eyebrow">Manual exception</p><h2><%= kind === 'receivables' ? 'Record an invoice created outside Foundry' : 'Record a bill Foundry did not receive' %></h2><p class="hint">Use only when there is no Sales, Purchasing, supplier-email, document, or connection record to use as the source.</p></div></summary><div class="card-body"><a class="btn btn--ghost" href="/accounting/<%= kind %>/new">Open manual entry</a></div></details>
