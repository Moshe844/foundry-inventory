<div class="page-head"><div><a class="back-link" href="/accounting/reports/general-ledger">‹ General ledger</a><p class="eyebrow">Posted journal entry</p><h1>Entry #<%= entry.entry_number %></h1><p class="lede"><%= entry.description %></p></div><span class="badge badge--success">Posted</span></div>
<section class="card"><div class="card-head"><h2><%= entry.posting_date %></h2><span class="hint"><%= entry.engine_version %></span></div><div class="card-body">
  <div class="table-wrap"><table class="table"><thead><tr><th>Account</th><th>Memo</th><th class="num">Debit</th><th class="num">Credit</th></tr></thead><tbody>
  <% entry.lines.forEach(function(line) { %><tr><td><%= line.account_code %> · <%= line.account_name %></td><td><%= line.memo || '—' %></td><td class="num"><%= line.debit_minor ? helpers.money(line.debit_minor, line.currency) : '—' %></td><td class="num"><%= line.credit_minor ? helpers.money(line.credit_minor, line.currency) : '—' %></td></tr><% }) %>
  </tbody><tfoot><tr><th colspan="2">Total</th><th class="num"><%= helpers.money(entry.lines.reduce((n,l)=>n+Number(l.debit_minor),0), entry.lines[0].currency) %></th><th class="num"><%= helpers.money(entry.lines.reduce((n,l)=>n+Number(l.credit_minor),0), entry.lines[0].currency) %></th></tr></tfoot></table></div>
</div></section>
<section class="card"><div class="card-head"><h2>Why this exists</h2></div><div class="card-body grid grid--2"><div><span class="field-label">Source</span><p><%= entry.source_type.replaceAll('_',' ') %></p></div><div><span class="field-label">Source record</span><p><%= entry.source_record_type || '—' %> <%= entry.source_record_id || '' %></p></div><div><span class="field-label">Domain event</span><p><%= entry.source_event_id || 'Manual approved entry' %></p></div><div><span class="field-label">Correction</span><p><%= entry.reversal_of_entry_id ? 'Reverses an earlier posted entry' : 'Original entry' %></p></div></div></section>
<% if (!entry.reversal_of_entry_id) { %><details class="card"><summary class="card-head"><div><h2>Correct this entry</h2><p class="hint">The original is never edited or deleted. Foundry posts a linked reversal.</p></div></summary><form class="card-body form-inline" method="post" action="/accounting/entries/<%= entry.id %>/reverse"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><label class="field"><span class="field-label">Correction date</span><input class="input" type="date" name="postingDate" required></label><label class="field field--wide"><span class="field-label">Why</span><input class="input" name="reason" required maxlength="250"></label><button class="btn btn--danger" type="submit">Post reversal</button></form></details><% } %>
