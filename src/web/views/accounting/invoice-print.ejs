<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Invoice <%= document.row.invoice_number %></title><style>body{font:14px/1.5 Arial,sans-serif;color:#172033;max-width:850px;margin:40px auto;padding:0 24px}h1{color:#302766}table{border-collapse:collapse;width:100%;margin:28px 0}th,td{padding:10px;border-bottom:1px solid #ddd;text-align:left;vertical-align:top}.number{text-align:right}.totals{margin-left:auto;max-width:370px}footer{margin-top:35px;color:#666}.toolbar{display:flex;gap:20px;margin-bottom:30px}@media print{.toolbar{display:none}body{margin:0;max-width:none}thead{display:table-header-group}tr{break-inside:avoid}a{color:inherit}}</style></head><body>
<nav class="toolbar"><a href="/money/invoices/<%= document.row.id %>">Back to invoice</a><button type="button" onclick="window.print()">Print invoice</button><a href="/money/invoices/<%= document.row.id %>/pdf" download="invoice.pdf">Download PDF</a></nav>
<h1><%= document.issuer %></h1><h2>Invoice <%= document.row.invoice_number %><%= ['DRAFT','VOID'].includes(document.row.status)?' — '+document.row.status:'' %></h2><p>Issued <%= document.row.issue_date %> · Due <%= document.dueDate %></p>
<h3>Bill to</h3><p><strong><%= document.customer.company||document.customer.name %></strong><% if(document.customer.company){ %><br><%= document.customer.name %><% } %><% if(document.customer.shipping_address){ %><br><%= document.customer.shipping_address %><% } %><% if(document.customer.email){ %><br><%= document.customer.email %><% } %></p><p>Terms: <%= document.terms %><% if(document.dueInferred){ %><br><small>Due date uses the current customer payment terms.</small><% } %></p>
<table><thead><tr><th>Product / variant</th><th class="number">Quantity</th><th class="number">Unit price</th><th class="number">Amount</th></tr></thead><tbody><% for(const line of document.lines){ %><tr><td><%= line.description %></td><td class="number"><%= line.document_quantity||line.quantity %></td><td class="number"><%= invoiceMoney.format(Number(line.unit_price_minor),document.row.currency) %></td><td class="number"><%= invoiceMoney.format(Number(line.document_amount_minor??line.line_total_minor),document.row.currency) %></td></tr><% } %></tbody></table>
<% if(document.credits.length){ %><p>The lines above show the original invoice. Posted return credits:</p><ul><% for(const c of document.credits){ %><li><%= c.return_number %>: <%= invoiceMoney.format(Number(c.revenue_minor)+Number(c.tax_minor),document.row.currency) %></li><% } %></ul><% } %>
<table class="totals"><tbody><% for(const [label,value] of [['Current subtotal',document.row.subtotal_minor],['Discount',-Number(document.row.discount_minor)],['Tax',document.row.tax_minor],['Charges',document.row.charges_minor||0],['Invoice total',document.row.total_minor],['Balance due',document.row.balance_minor]]){ %><tr><th><%= label %></th><td class="number"><%= invoiceMoney.format(Number(value),document.row.currency) %></td></tr><% } %></tbody></table>
<% if(document.row.notes){ %><p><%= document.row.notes %></p><% } %><footer>Prepared with StockChief</footer></body></html>
