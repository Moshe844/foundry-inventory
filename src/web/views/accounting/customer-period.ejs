<% const zone=model.timeZone||'UTC',today=new Intl.DateTimeFormat('en-CA',{timeZone:zone,year:'numeric',month:'2-digit',day:'2-digit'}).format(new Date()),[year,month]=today.split('-').map(Number),day=value=>value.toISOString().slice(0,10),ranges=[['This month',day(new Date(Date.UTC(year,month-1,1))),today],['Last month',day(new Date(Date.UTC(year,month-2,1))),day(new Date(Date.UTC(year,month-1,0)))],['Last 30 days',day(new Date(Date.parse(today+'T12:00:00Z')-29*86400000)),today],['This year',year+'-01-01',today]]; %><div class="sc-period"><nav class="sc-period__quick" aria-label="Quick date ranges"><% for(const [label,from,to] of ranges){ %><a href="<%= action %>?<%= new URLSearchParams({from,to,picked:'period'}) %>" <% if(model.from===from&&model.to===to){ %>aria-current="true"<% } %>><%= label %></a><% } %></nav><form method="get" action="<%= action %>" class="sc-date-filter"><input type="hidden" name="picked" value="period"><label>From<input class="input" type="date" name="from" value="<%= model.from %>" required></label><label>To<input class="input" type="date" name="to" value="<%= model.to %>" required></label><button class="btn" type="submit">Update dates</button></form></div>
