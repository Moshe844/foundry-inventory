<section class="rm-head"><p class="eyebrow">Review before posting</p><h1>Invoice pricing</h1><p><%= description %>. This records the invoice in Money. It does not send a message, move stock or collect payment.</p></section><section class="card"><div class="card-body"><dl><dt>Customer</dt><dd><%= customerName %></dd><dt>Issue date</dt><dd><%= issueDate %></dd><dt>Due date</dt><dd><%= dueDate || 'Not supplied' %></dd><dt>Units</dt><dd><%= quote.lines[0].quantity %></dd><dt>Price each</dt><dd><%= helpers.money(quote.lines[0].unitPriceMinor,quote.currency) %></dd><dt>Discount</dt><dd><%= helpers.money(quote.discountMinor,quote.currency) %></dd><dt>Tax</dt><dd><%= helpers.money(quote.taxMinor,quote.currency) %></dd><dt>Amount owed</dt><dd><strong><%= helpers.money(quote.totalMinor,quote.currency) %></strong></dd></dl><% for(const applied of quote.applied){ %><p><%= applied.name %>: −<%= helpers.money(applied.amountMinor,quote.currency) %></p><% } %><% if(quote.unusedCodes.length){ %><p>Codes not applied: <%= quote.unusedCodes.join(', ') %>.</p><% } %><% if(quote.violations.length){ %><p class="notice notice--warn">A pricing safeguard prevents posting: <%= quote.violations.map(v=>v.kind.replaceAll('_',' ')).join(', ') %>.</p><% }else{ %><form method="post" action="/accounting/receivables/price-reviews/<%= reviewId %>/approve"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="btn btn--primary">Approve pricing and post invoice</button></form><% } %><a href="/accounting/receivables/new">Back to invoice entry</a></div></section>
