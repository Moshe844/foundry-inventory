<% const r=detail.row,bill=kind==='bills',amount=n=>helpers.money(Number(n||0),r.currency),number=bill?r.bill_number:r.invoice_number,statusText=String(r.status||'').replaceAll('_',' ').toLowerCase(),paid=Number(r.balance_minor)<=0,late=Number(listed?.daysLate||0),reminder=action==='reminder'; %>
<a class="back-link" href="/money/<%= kind %>">‹ <%= bill?'Bills to pay':'Customer invoices' %></a>
<header class="sc-business-head md-head"><div><h1><%= number %> <span class="badge <%= paid?'badge--success':late>60?'badge--danger':late?'badge--warn':'' %>"><%= listed?.label||statusText.charAt(0).toUpperCase()+statusText.slice(1) %></span></h1><p><% if(listed){ %><a href="<%= listed.partyHref %>"><%= listed.party_name %></a><% if(listed.orderHref){ %> · <a href="<%= listed.orderHref %>"><%= listed.order_number %></a><% } %> · <% } %>Issued <%= helpers.shortDate(r.issue_date) %><% if(listed){ %> · Due <%= helpers.shortDate(listed.due_date) %><% } %></p></div><div class="md-head__owed"><strong class="sc-headline <%= late>60?'is-urgent':late?'is-important':'' %>"><%= amount(r.balance_minor) %> outstanding</strong><small>of <%= amount(r.total_minor) %> total</small></div></header>
<% if(kind==='invoices'){ %><nav class="md-doc-actions" aria-label="Invoice document"><a class="btn" href="/money/invoices/<%= r.id %>/pdf" download="invoice.pdf">Download PDF</a> <a class="btn" href="/money/invoices/<%= r.id %>/print" target="_blank" rel="noopener">Print invoice</a> <a class="btn" href="/money/invoices/<%= r.id %>/email">Email invoice to customer</a></nav><% } %>
<div class="pd-grid md-grid">
<div class="pd-main">
  <section class="sc-business-card"><h2><%= bill?'What this bill is for':'What this invoice is for' %></h2>
    <div class="pd-table-wrap"><table class="pd-table"><thead><tr><th>Item</th><th class="is-num">Quantity</th><th class="is-num">Amount</th></tr></thead><tbody><% for(const l of detail.lines){ %><tr><td><strong><%= l.description||l.supplier_sku||'Item' %></strong></td><td class="is-num"><%= l.quantity||l.quantity_units %></td><td class="is-num"><%= amount(l.line_total_minor) %></td></tr><% } %></tbody></table></div>
    <% if(detail.credits?.length){ %><p class="pd-note">Original order lines are shown above. Posted return credits:</p><% for(const c of detail.credits){ %><p class="pd-note"><a href="/returns/<%= c.customer_return_id %>"><%= c.return_number %></a>: <%= amount(Number(c.revenue_minor)+Number(c.tax_minor)) %> credited, including <%= amount(c.tax_minor) %> tax.</p><% } %><% } %>
    <div class="md-totals"><div class="sc-profit-row"><span>Current item subtotal</span><strong><%= amount(r.subtotal_minor) %></strong></div><% if(Number(r.discount_minor)){ %><div class="sc-profit-row"><span>Discount</span><strong><%= amount(r.discount_minor) %></strong></div><% } %><div class="sc-profit-row"><span>Tax</span><strong><%= amount(r.tax_minor) %></strong></div><% if(Number(r.charges_minor||0)){ %><div class="sc-profit-row"><span>Charges</span><strong><%= amount(r.charges_minor) %></strong></div><% } %><div class="sc-profit-row md-total"><span>Total</span><strong><%= amount(r.total_minor) %></strong></div><% if(Number(r.total_minor)!==Number(r.balance_minor)){ %><div class="sc-profit-row"><span>Paid or credited</span><strong><%= amount(Number(r.total_minor)-Number(r.balance_minor)) %></strong></div><div class="sc-profit-row md-total"><span>Outstanding</span><strong><%= amount(r.balance_minor) %></strong></div><% } %></div>
    <% if(r.journal_entry_id||listed?.orderHref){ %><p class="pd-note"><a href="<%= r.journal_entry_id?'/accounting/entries/'+r.journal_entry_id:listed.orderHref %>">Where did this come from?</a></p><% } %>
  </section>
</div>
<aside class="pd-side">
  <% if(listed){ %><section class="sc-business-card md-action" id="record-payment">
    <% if(!bill){ %><nav class="pd-range" aria-label="What to do"><a href="/money/<%= kind %>/<%= r.id %>?action=payment" aria-current="<%= reminder?'false':'true' %>">Record payment</a><a href="/money/<%= kind %>/<%= r.id %>?action=reminder" aria-current="<%= reminder?'true':'false' %>">Send reminder</a></nav><% } %>
    <h2><%= reminder?'Prepare a payment reminder':bill?'Record a payment already made':'Record a payment already received' %></h2>
    <p class="pd-note">This goes to Approvals first. No money moves and nothing is emailed until you approve it.</p>
    <form class="sc-document-action" method="post" action="/money/<%= kind %>/<%= r.id %>/prepare"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="action" value="<%= reminder?'reminder':'payment' %>"><% if(!reminder){ %><label>Amount (<%= r.currency %>)<input class="input" name="amount" type="number" step="<%= paymentStep %>" min="<%= paymentStep %>" max="<%= paymentAmount %>" value="<%= paymentAmount %>" required></label><label>Payment date<input class="input" name="paymentDate" type="date" value="<%= today %>" required></label><label>Payment method<input class="input" name="method" required maxlength="80" list="money-payment-methods" placeholder="Card, cash, bank transfer…"><datalist id="money-payment-methods"><option value="Card"><option value="Cash"><option value="Bank transfer"><option value="Check"></datalist></label><label>Reference <small>optional</small><input class="input" name="reference" maxlength="160"></label><% } %><button class="btn btn--primary" type="submit">Prepare for approval</button></form>
    <% if(bill){ %><p class="pd-note"><a href="/accounting/payables/<%= r.id %>/review">Review bill →</a></p><% } %>
  </section><% }else{ %><section class="sc-business-card"><h2>Nothing left to do</h2><p class="pd-note"><%= paid?'This has been paid in full.':'This is not on the outstanding list.' %></p></section><% } %>
</aside>
</div>
