<% const r=detail.row,bill=kind==='bills',amount=n=>helpers.money(Number(n||0),r.currency),number=bill?r.bill_number:r.invoice_number; %><a class="back-link" href="/money/<%= kind %>">‹ <%= bill?'Bills to pay':'Customer invoices' %></a><header class="sc-business-head"><div><h1><%= number %></h1><p><%= r.status.replaceAll('_',' ').toLowerCase() %> · issued <%= helpers.shortDate(r.issue_date) %><% if(listed){ %> · due <%= helpers.shortDate(listed.due_date) %><% } %></p></div><strong class="sc-headline"><%= amount(r.balance_minor) %> outstanding</strong></header><section class="sc-business-card"><% if(listed){ %><p><a href="<%= listed.partyHref %>"><%= listed.party_name %></a><% if(listed.orderHref){ %> · <a href="<%= listed.orderHref %>"><%= listed.order_number %></a><% } %></p><% } %><div class="sc-record-list"><% for(const l of detail.lines){ %><article><div><strong><%= l.description||l.supplier_sku||'Item' %></strong><small>Quantity <%= l.quantity||l.quantity_units %></small></div><strong><%= amount(l.line_total_minor) %></strong></article><% } %></div><% if(detail.credits?.length){ %><p>Original order lines are shown above. Posted return credits:</p><% for(const c of detail.credits){ %><p><a href="/returns/<%= c.customer_return_id %>"><%= c.return_number %></a>: <%= amount(Number(c.revenue_minor)+Number(c.tax_minor)) %> credited, including <%= amount(c.tax_minor) %> tax.</p><% } %><% } %><div class="sc-profit-row"><span>Current item subtotal</span><strong><%= amount(r.subtotal_minor) %></strong></div><div class="sc-profit-row"><span>Discount</span><strong><%= amount(r.discount_minor) %></strong></div><div class="sc-profit-row"><span>Tax</span><strong><%= amount(r.tax_minor) %></strong></div><% if(r.charges_minor!==undefined){ %><div class="sc-profit-row"><span>Charges</span><strong><%= amount(r.charges_minor) %></strong></div><% } %><div class="sc-profit-row"><span>Total</span><strong><%= amount(r.total_minor) %></strong></div><% if(r.journal_entry_id||listed?.orderHref){ %><p><a href="<%= r.journal_entry_id?'/accounting/entries/'+r.journal_entry_id:listed.orderHref %>">Where did this come from?</a></p><% } %></section>
<% if(listed){ %><section class="sc-business-card"><h2><%= action==='reminder'?'Prepare a payment reminder':bill?'Record a payment already made':'Record a payment already received' %></h2><p>StockChief prepares this for approval. This form does not send money or email.</p><form class="sc-document-action" method="post" action="/money/<%= kind %>/<%= r.id %>/prepare"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="action" value="<%= action==='reminder'?'reminder':'payment' %>"><% if(action!=='reminder'){ %><label>Amount (<%= r.currency %>)<input class="input" name="amount" type="number" step="<%= paymentStep %>" min="<%= paymentStep %>" max="<%= paymentAmount %>" value="<%= paymentAmount %>" required></label><label>Payment date<input class="input" name="paymentDate" type="date" value="<%= today %>" required></label><label>Payment method<input class="input" name="method" required maxlength="80"></label><label>Reference<input class="input" name="reference" maxlength="160"></label><% } %><button class="btn btn--primary" type="submit">Prepare for approval</button></form></section><% } %>
