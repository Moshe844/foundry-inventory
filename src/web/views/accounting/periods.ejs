<div class="page-head"><div><a class="back-link" href="/accounting">‹ Money</a><p class="eyebrow">Financial control</p><h1>Accounting periods</h1><p class="lede">Closing locks the period. Later corrections post as linked reversals in an open period.</p></div></div>
<section class="card"><div class="card-body"><div class="stack"><% periods.forEach(function(period){ %><div class="list-row"><div><strong><%= period.starts_on %> to <%= period.ends_on %></strong><p class="muted"><%= period.status %><%= period.close_note ? ` · ${period.close_note}` : '' %></p></div><% if(period.status === 'OPEN'){ %><form class="form-inline" method="post" action="/accounting/periods/<%= period.id %>/close"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input class="input" name="note" maxlength="250" placeholder="Close note (optional)"><button class="btn btn--danger btn--sm" type="submit">Close period</button></form><% } else { %><span class="badge">Closed</span><% } %></div><% }) %></div><% if(!periods.length){ %><div class="empty"><strong>No periods yet.</strong><p>A period is created with the first posting.</p></div><% } %></div></section>
