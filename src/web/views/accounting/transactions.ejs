<div class="page-head"><div><a class="back-link" href="/accounting">‹ Money</a><p class="eyebrow">Audit trail</p><h1>Accounting transactions</h1><p class="lede">Foundry posts these from real business activity. Open one to see its source and debit/credit detail.</p></div></div>
<div class="notice"><div><strong>This is an audit trail, not a routine data-entry screen.</strong><br>Sales, receipts, supplier invoices, payments, refunds, and transfers create their own entries automatically.</div></div>
<form class="card card-body form-inline" method="get"><label class="field"><span class="field-label">From</span><input class="input" type="date" name="from" value="<%= from %>"></label><label class="field"><span class="field-label">To</span><input class="input" type="date" name="to" value="<%= to %>"></label><button class="btn btn--sm" type="submit">Update</button></form>
<section class="card"><div class="card-head"><h2><%= entries.length %> posted entr<%= entries.length === 1 ? 'y' : 'ies' %></h2></div><div class="card-body">
<% if (!entries.length) { %><div class="empty"><strong>No entries in this period.</strong></div><% } else { %><div class="table-wrap"><table class="table"><thead><tr><th>Date</th><th>Entry</th><th>Description</th><th>Source</th><th>Posted</th></tr></thead><tbody>
<% entries.forEach(function(entry){ %><tr><td><%= entry.posting_date %></td><td><a href="/accounting/entries/<%= entry.id %>">#<%= entry.entry_number %></a></td><td><%= entry.description %></td><td><%= entry.source_type.replaceAll('_',' ') %></td><td><%= entry.posted_at %></td></tr><% }) %>
</tbody></table></div><% } %></div></section>
<details class="card advanced-settings"><summary class="card-head"><div><p class="eyebrow">Accountant tool</p><h2>Post a manual adjustment</h2><p class="hint">Only for a financial correction or event with no operational source. Posted history is never silently rewritten.</p></div></summary><div class="card-body"><a class="btn btn--ghost" href="/accounting/adjustments/new">Open adjustment form</a></div></details>
