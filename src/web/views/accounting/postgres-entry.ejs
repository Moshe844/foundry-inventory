<div class="page-head"><div><a class="back-link" href="/accounting/reports/general-ledger">General ledger</a><h1>Journal entry #<%= entry.entry_number %></h1><p class="lede"><%= entry.posting_date %> · <%= entry.description %></p></div></div>
<div class="card"><table class="table"><thead><tr><th>Account</th><th>Memo</th><th class="num">Debit</th><th class="num">Credit</th></tr></thead><tbody><% lines.forEach(function(line){ %><tr><td><%= line.account_code %> · <%= line.account_name %></td><td><%= line.memo || '—' %></td><td class="num"><%= line.debit_minor ? helpers.money(line.debit_minor,line.currency) : '—' %></td><td class="num"><%= line.credit_minor ? helpers.money(line.credit_minor,line.currency) : '—' %></td></tr><% }) %></tbody></table></div>
