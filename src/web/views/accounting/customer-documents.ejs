<% const m=model,amount=n=>helpers.money(n,m.currency),bill=kind==='bills'; %><a class="back-link" href="/money">‹ Money</a><header class="sc-business-head"><div><h1><%= title %></h1><p><%= rows.length %> outstanding <%= bill?'bills':'invoices' %> · <%= m.currency %> · current balances</p></div><strong class="sc-headline" data-list-total="<%= totalMinor %>"><%= amount(totalMinor) %></strong></header>
<div class="sc-aging"><% for(const [key,label]of [['not_due','Not due'],['1_30','1–30 days late'],['31_60','31–60 days late'],['60_plus','60+ days late']]){ %><a href="/money/<%= kind %>?aging=<%= key %>" aria-current="<%= filter===key?'page':'false' %>"><span><%= label %></span><strong><%= amount(summary.aging[key==='60_plus'?'sixty_plus':key]) %></strong></a><% } %></div><% if(summary.aging.unknown){ %><p class="notice"><a href="/money/<%= kind %>?aging=unknown"><%= amount(summary.aging.unknown) %> has no recorded due date. Review these documents.</a></p><% } %>
<nav class="sc-filter-chips" aria-label="Payment due filters"><% for(const [key,label]of [['all','All'],['late','Late'],['due_week','Due within 7 days'],['not_due','Not due']]){ %><a class="btn" href="/money/<%= kind %>?aging=<%= key %>" aria-current="<%= filter===key?'page':'false' %>"><%= label %></a><% } %></nav>
<section class="sc-business-card"><% if(!rows.length){ %><p class="sc-empty">No outstanding <%= bill?'bills':'invoices' %> match this filter.</p><% } %><div class="sc-record-list"><% for(const r of rows){ %><article data-money-row data-amount-minor="<%= r.balance_minor %>"><div><a href="<%= r.partyHref %>"><strong><%= r.party_name %></strong></a><a href="<%= r.href %>"><%= r.number %></a><% if(r.orderHref){ %><a href="<%= r.orderHref %>"><%= r.order_number %></a><% } %></div><div><time><%= helpers.shortDate(r.due_date) %></time><small><%= r.dueInferred?'Calculated from terms':'Due date' %></small><span class="badge <%= r.daysLate?'badge--warn':'badge--success' %>"><%= r.label %></span></div><strong><%= amount(r.balance_minor) %></strong><div class="sc-row-actions"><% if(!bill){ %><a class="btn" href="<%= r.href %>?action=reminder">Send reminder</a><% } %><a class="btn" href="<%= r.href %>?action=payment"><%= bill?'Mark paid':'Record payment' %></a><% if(bill){ %><a class="btn" href="/accounting/payables/<%= r.id %>/review">Review bill</a><% } %></div></article><% } %></div><footer class="sc-list-total"><span><%= rows.length %> shown</span><strong><%= amount(totalMinor) %></strong></footer></section>
