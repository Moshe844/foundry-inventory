<% const m=model,amount=n=>helpers.money(n,m.currency),bill=kind==='bills'; %><a class="back-link" href="/money">‹ Money</a><header class="sc-business-head"><div><h1><%= title %></h1><p><%= listTotal %> outstanding <%= bill?(listTotal===1?'bill':'bills'):(listTotal===1?'invoice':'invoices') %> · <%= m.currency %> · current balances</p></div><strong class="sc-headline" data-list-total="<%= totalMinor %>"><%= amount(totalMinor) %></strong></header>
<div class="sc-tiles sc-aging"><% for(const [key,label,tone]of [['not_due','Not due',''],['1_30','1–30 days late','is-important'],['31_60','31–60 days late','is-important'],['60_plus','60+ days late','is-urgent']]){const value=summary.aging[key==='60_plus'?'sixty_plus':key]; %><a class="sc-tile <%= Number(value)>0?tone:'' %>" href="/money/<%= kind %>?aging=<%= key %>" aria-current="<%= filter===key?'page':'false' %>"><span><%= label %></span><strong><%= amount(value) %></strong></a><% } %></div><% if(summary.aging.unknown){ %><p class="notice"><a href="/money/<%= kind %>?aging=unknown"><%= amount(summary.aging.unknown) %> has no recorded due date. Review these documents.</a></p><% } %>
<nav class="sc-section-tabs md-filter" aria-label="Payment due filters"><% for(const [key,label]of [['all','All'],['late','Late'],['due_week','Due within 7 days']]){ %><a href="/money/<%= kind %>?aging=<%= key %>" aria-current="<%= filter===key?'page':'false' %>"><%= label %></a><% } %></nav>
<section class="sc-business-card md-list"><% if(!rows.length){ %><p class="sc-empty">No outstanding <%= bill?'bills':'invoices' %> match this filter.</p><% }else{ %><div class="md-row md-row--head" aria-hidden="true"><span><%= bill?'Supplier':'Customer' %></span><span>Due</span><span class="is-num">Balance</span><span></span></div><% } %><div class="sc-record-list"><% for(const r of rows){const late=Number(r.daysLate||0); %><article class="md-row" data-money-row data-amount-minor="<%= r.balance_minor %>"><a class="md-row__open" href="<%= r.href %>" aria-label="Open <%= r.number %>"></a><div><a class="md-row__who" href="<%= r.partyHref %>"><strong><%= r.party_name %></strong></a><small><a href="<%= r.href %>"><%= r.number %></a><% if(r.orderHref){ %> · <a href="<%= r.orderHref %>"><%= r.order_number %></a><% } %></small></div><div class="md-row__due"><time><%= helpers.shortDate(r.due_date) %></time><span class="badge <%= late>60?'badge--danger':late?'badge--warn':'' %>"><%= r.label %></span><% if(r.dueInferred){ %><small>Calculated from terms</small><% } %></div><strong class="is-num <%= late>60?'is-urgent':late?'is-important':'' %>"><%= amount(r.balance_minor) %></strong><div class="sc-row-actions"><% if(!bill){ %><a class="btn btn--sm" href="<%= r.href %>?action=reminder">Send reminder</a><% } %><a class="btn btn--sm" href="<%= r.href %>?action=payment"><%= bill?'Mark paid':'Record payment' %></a><% if(bill){ %><a class="btn btn--sm" href="/accounting/payables/<%= r.id %>/review">Review bill</a><% } %></div></article><% } %></div><footer class="sc-list-total"><span><%= listTotal %> <%= bill?(listTotal===1?'bill':'bills'):(listTotal===1?'invoice':'invoices') %></span><strong><%= amount(totalMinor) %></strong></footer><%- include('../partials/pager') %></section>
