<div class="page-head"><div><a class="back-link" href="/accounting">‹ Money</a><p class="eyebrow">Cash control</p><h1>Banking and reconciliation</h1><p class="lede">Bank activity proves money movement; it does not create a second sale or expense. Exact matches connect automatically where the evidence is sufficient.</p></div></div>
<div class="notice"><div><strong>You should not re-enter an amount Foundry already received from a payment or connected source.</strong><br>Import or connect the bank evidence, then match it to the existing record. Manual statement entry below is only a fallback when no file or connection is available.</div></div>
<section class="card"><div class="card-head"><h2>Financial accounts</h2></div><div class="card-body"><% if(!banks.length){ %><div class="empty"><strong>No bank or credit-card accounts yet.</strong></div><% } else { %><div class="stack"><% banks.forEach(function(bank){ %><details class="list-row"><summary><div><strong><%= bank.name %></strong><p class="muted"><%= bank.account_kind.replace('_',' ') %> · <%= bank.ledger_account_code %> <%= bank.ledger_account_name %></p></div><span class="badge"><%= bank.currency %></span></summary><div class="grid grid--2 accounting-detail">
<details class="advanced-settings"><summary><strong>Fallback: enter one statement line manually</strong><p class="hint">Use only when no bank connection or statement import is available.</p></summary><form class="stack" method="post" action="/accounting/banking/<%= bank.id %>/import"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><label class="field"><span class="field-label">Date</span><input class="input" type="date" name="transactionDate" value="<%= today %>" required></label><label class="field"><span class="field-label">Amount shown by the bank</span><input class="input" name="amount" placeholder="Use - for money out" required></label><label class="field"><span class="field-label">Description</span><input class="input" name="description" required></label><label class="field"><span class="field-label">Bank reference (optional)</span><input class="input" name="externalId"></label><button class="btn btn--sm" type="submit">Import as unmatched evidence</button></form></details>
<form class="stack" method="post" action="/accounting/banking/<%= bank.id %>/reconcile"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><h3>Reconcile a statement</h3><label class="field"><span class="field-label">Statement end date</span><input class="input" type="date" name="statementEndDate" value="<%= today %>" required></label><label class="field"><span class="field-label">Statement ending balance</span><input class="input" name="statementEndingBalance" required></label><label><input type="checkbox" name="complete" value="yes"> Complete only if exact and every line is matched</label><button class="btn btn--sm" type="submit">Check reconciliation</button></form></div></details><% }) %></div><% } %></div></section>
<details class="card"><summary class="card-head"><div><h2>Add a financial account</h2><p class="hint">Connect it to the matching ledger account.</p></div></summary><form class="card-body grid grid--3" method="post" action="/accounting/banking/accounts"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><label class="field"><span class="field-label">Name</span><input class="input" name="name" required></label><label class="field"><span class="field-label">Kind</span><select class="select" name="kind"><option value="BANK">Bank</option><option value="CREDIT_CARD">Credit card</option></select></label><label class="field"><span class="field-label">Ledger account</span><select class="select" name="ledgerAccountId" required><% accounts.forEach(function(account){ %><option value="<%= account.id %>"><%= account.code %> · <%= account.name %></option><% }) %></select></label><button class="btn" type="submit">Add account</button></form></details>
<section class="card"><div class="card-head"><div><h2>Imported statement activity</h2><p class="hint">Match each line to the payment or posted entry it proves. Foundry checks the exact amount and account effect.</p></div></div><div class="card-body"><% if(!transactions.length){ %><div class="empty"><strong>No statement activity imported.</strong></div><% } else { %><div class="stack"><% transactions.forEach(function(row){ %><details class="list-row"><summary><div><strong><%= row.description %></strong><p class="muted"><%= row.transaction_date %> · <%= row.bank_name %> · <%= helpers.money(row.amount_minor) %></p></div><span class="badge"><%= row.status.replaceAll('_',' ') %></span></summary><% if(row.status === 'UNMATCHED'){ %><div class="accounting-detail stack"><p>Matching links bank evidence to an existing posting; it never creates a second sale or expense.</p><form class="grid grid--2" method="post" action="/accounting/banking/transactions/<%= row.id %>/match"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><label class="field"><span class="field-label">What does this line prove?</span><select class="select" name="matchTarget" required><option value="">Choose the exact record</option><optgroup label="Customer and supplier payments"><% paymentMatches.forEach(function(payment){ %><option value="payment:<%= payment.id %>"><%= payment.payment_date %> · <%= payment.counterparty %> · <%= helpers.money(payment.direction === 'SUPPLIER_PAYMENT' ? -payment.amount_minor : payment.amount_minor) %></option><% }) %></optgroup><optgroup label="Other posted accounting entries"><% journalMatches.forEach(function(entry){ %><option value="journal:<%= entry.id %>"><%= entry.posting_date %> · <%= entry.entry_number %> · <%= entry.description %></option><% }) %></optgroup></select></label><button class="btn btn--sm" type="submit">Match exact activity</button></form></div><% } else { %><div class="accounting-detail"><p>This line is already linked and will be included in reconciliation.</p></div><% } %></details><% }) %></div><% } %></div></section>
<section class="card"><div class="card-head"><h2>Reconciliation history</h2></div><div class="card-body"><% if(!reconciliations.length){ %><div class="empty"><strong>No statements checked yet.</strong></div><% } else { %><div class="table-wrap"><table class="table"><thead><tr><th>Account</th><th>Statement end</th><th class="num">Statement</th><th class="num">Foundry</th><th class="num">Difference</th><th>Status</th></tr></thead><tbody><% reconciliations.forEach(function(row){ %><tr><td><%= row.bank_name %></td><td><%= row.statement_end_date %></td><td class="num"><%= helpers.money(row.statement_ending_balance_minor) %></td><td class="num"><%= helpers.money(row.ledger_ending_balance_minor) %></td><td class="num"><%= helpers.money(row.difference_minor) %></td><td><%= row.status %></td></tr><% }) %></tbody></table></div><% } %></div></section>
