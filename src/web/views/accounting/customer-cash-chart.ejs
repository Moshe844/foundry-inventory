<% const maximum=Math.max(1,...model.months.flatMap(r=>[r.inMinor,r.outMinor])); %><div class="sc-cash-chart" role="img" aria-label="Recorded monthly cash in and out"><% for(const r of model.months){ %><div><div class="sc-cash-bars"><i style="height:<%= Math.max(0,r.inMinor/maximum*100) %>%" title="In <%= helpers.money(r.inMinor,model.currency) %>"></i><i style="height:<%= Math.max(0,r.outMinor/maximum*100) %>%" title="Out <%= helpers.money(r.outMinor,model.currency) %>"></i></div><strong><%= r.label %></strong><small><%= helpers.money(r.netMinor,model.currency) %></small></div><% } %></div>
