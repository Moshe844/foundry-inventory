<%
  /*
   * Money, as an accountant would tell it to you — not as accounting software.
   *
   * The page this replaced already asked the right questions in its headings:
   * what needs you, what changed, coming up, worth knowing. Then it answered
   * every one of them with a card, so the answer to "how is the business
   * doing" was eight equally weighted boxes and a profit-and-loss equation.
   *
   * Here it is a sentence, then a four-line ledger — the one place in the
   * product where a table is the right shape, because money genuinely is a
   * column of figures — then the single thing that needs a person.
   *
   * The general ledger has not been removed. Forty routes of it sit behind one
   * line at the bottom, named for the person who actually wants them. An owner
   * should never land on a journal during ordinary work.
   */
  var currency = story.currency;
  var money = function (minor) {
    var amount = Number(minor || 0) / 100;
    var sign = amount < 0 ? '-' : '';
    return sign + (currency === 'USD' ? '$' : currency + ' ')
      + Math.abs(amount).toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
  };
  var round = function (minor) {
    var amount = Number(minor || 0) / 100;
    var sign = amount < 0 ? '-' : '';
    return sign + (currency === 'USD' ? '$' : currency + ' ')
      + Math.abs(amount).toLocaleString('en-US', { maximumFractionDigits: 0 });
  };
  var day = function (value) {
    if (!value) return '';
    var d = new Date(value + 'T00:00:00Z');
    return d.toLocaleDateString('en-GB', { day: 'numeric', month: 'short', timeZone: 'UTC' });
  };
  var net = story.profit.netMinor;
  var out = (story.comingUp || []).filter(function (r) { return r.direction === 'out'; });
  var inbound = (story.comingUp || []).filter(function (r) { return r.direction === 'in'; });
%>

<p class="rm-stamp">
  <%= story.status.caughtUp ? 'Books caught up' : story.status.headline %>
  · <%= day(story.from) %> to <%= day(story.to) %>
</p>

<h1 class="rm-figure">
  <a href="/accounting/reports/profit-and-loss?from=<%= story.from %>&to=<%= story.to %>"><%= money(Math.abs(net)) %> <%= net < 0 ? 'lost' : 'earned' %> this period.</a>
</h1>
<p class="rm-sub">
  <% if (story.profit.why && story.profit.why.length) { %>
    <%= story.profit.why.join(' ') %>
  <% } else { %>
    <%= money(story.profit.revenueMinor) %> of sales, <%= money(story.profit.cogsMinor) %> of stock sold,
    <%= money(story.profit.expensesMinor) %> of other costs.
    <%= story.profit.marginPct === null ? '' : story.profit.marginPct + '% gross margin.' %>
  <% } %>
</p>

<div class="rm-ledger">
  <div class="rm-ledger__row">
    <span class="rm-ledger__k">You owe</span>
    <span class="rm-ledger__v"><a href="/accounting/payables"><%= money(story.position.suppliersCommittedMinor) %></a></span>
    <span class="rm-ledger__n">
      <% if (out.length) { %><a href="<%= out[0].href %>"><%= out.length %> to pay · next <%= day(out[0].date) %></a>
      <% } else { %>nothing dated<% } %>
    </span>
  </div>
  <div class="rm-ledger__row">
    <span class="rm-ledger__k">You're owed</span>
    <span class="rm-ledger__v"><a href="/accounting/receivables"><%= money(story.position.customersOweMinor) %></a></span>
    <span class="rm-ledger__n<%= inbound.length && inbound[0].date < story.to ? ' is-warn' : '' %>">
      <% if (inbound.length) { %><a href="<%= inbound[0].href %>"><%= inbound.length %> completed-sale invoice<%= inbound.length === 1 ? '' : 's' %> · next <%= day(inbound[0].date) %></a>
      <% } else if (story.position.confirmedCustomerOrders.length) { var waitingOrder = story.position.confirmedCustomerOrders[0]; %>
        <a href="/sales/orders/<%= waitingOrder.id %>"><%= story.position.confirmedCustomerOrders.length %> confirmed order<%= story.position.confirmedCustomerOrders.length === 1 ? '' : 's' %> awaiting payment</a>
      <% } else { %>nothing outstanding<% } %>
    </span>
  </div>
  <div class="rm-ledger__row">
    <span class="rm-ledger__k">In the bank</span>
    <span class="rm-ledger__v"><a href="/accounting/banking"><%= money(story.position.cashMinor) %></a></span>
    <span class="rm-ledger__n">what Foundry can prove you hold</span>
  </div>
  <div class="rm-ledger__row">
    <span class="rm-ledger__k"><%= story.inventory.missingCostUnits ? 'Known stock cost' : 'Stock you own' %></span>
    <span class="rm-ledger__v"><a href="/accounting#inventory"><%= money(story.position.inventoryMinor) %></a></span>
    <span class="rm-ledger__n"><a href="/accounting#inventory"><%= story.position.inventoryUnits %> units · <%= story.inventory.missingCostUnits ? story.inventory.missingCostUnits + ' missing cost' : 'full cost recorded' %></a></span>
  </div>
</div>

<%
  /*
   * The one thing that needs a person, in the same shape it takes everywhere
   * else in the product. If there are several, this names the largest and says
   * how many are behind it — a page with four equally weighted asks is a queue,
   * and the queue has its own screen.
   */
  var first = (story.attention || [])[0];
%>
<% if (first) { %>
  <div class="rm-decision">
    <span class="rm-decision__arrow" aria-hidden="true">→</span>
    <span class="rm-decision__txt">
      <%= first.title %>
      <small>
        <%= first.why %>
        <% if (story.attention.length > 1) { %>
          <%= story.attention.length - 1 %> other<%= story.attention.length === 2 ? '' : 's' %> behind it.
        <% } %>
      </small>
    </span>
    <span class="rm-decision__go"><a class="rm-btn" href="<%= first.href %>"><%= first.actionLabel %></a></span>
  </div>
<% } %>

<div class="rm-bands">
  <% if ((story.changed || []).length) { %>
    <div class="rm-band">
      <span class="rm-band__k">What changed</span>
      <span class="rm-band__v">
        <% story.changed.slice(0, 4).forEach(function (row, i) { %><%
          %><% if (i) { %> <% } %><b><%= day(row.at) %></b> <%= row.what || row.headline || row.detail %>.<%
        %><% }) %>
        <% if (story.changed.length > 4) { %><span class="dim">and <%= story.changed.length - 4 %> more.</span><% } %>
      </span>
    </div>
  <% } %>

  <% if ((story.comingUp || []).length) { %>
    <div class="rm-band">
      <span class="rm-band__k">Coming up</span>
      <span class="rm-band__v">
        <% story.comingUp.slice(0, 5).forEach(function (row, i) { %><%
          %><% if (i) { %> · <% } %><a href="<%= row.href %>"><b><%= day(row.date) %></b> <%= row.what %> <%= round(row.amountMinor) %></a><%
        %><% }) %>
      </span>
    </div>
  <% } %>

  <% if ((story.noticed || []).length) { %>
    <div class="rm-band">
      <span class="rm-band__k">Worth knowing</span>
      <span class="rm-band__v">
        <% story.noticed.slice(0, 3).forEach(function (row) { %>
          <b><%= row.headline %>.</b> <% if (row.detail) { %><span class="dim"><%= row.detail %></span><% } %>
        <% }) %>
      </span>
    </div>
  <% } %>

  <% if (story.fees && story.fees.totalMinor) { %>
    <div class="rm-band">
      <span class="rm-band__k">On top of goods</span>
      <span class="rm-band__v">
        <b><%= money(story.fees.totalMinor) %></b> of freight, duty and handling was billed on your purchases.
        <% if (story.fees.needsPlacingMinor) { %>
          <span class="dim"><%= money(story.fees.needsPlacingMinor) %> of it is not in your profit yet, because
          nobody has said whether it is part of what the stock cost.</span>
        <% } %>
      </span>
    </div>
  <% } %>
</div>

<% var unplacedDocuments = (story.fees && story.fees.documents || []).filter(function (doc) {
     return doc.openedBooks && doc.unrecordedMinor;
   }); %>
<% if (unplacedDocuments.length) { %>
  <details class="rm-work" id="fees" open>
    <summary><%= money(story.fees.needsPlacingMinor) %> read off your documents and not in your books</summary>
    <div class="rm-work__body">
      <% unplacedDocuments.forEach(function (doc) { %>
        <section class="stack" style="margin-bottom:18px">
          <div>
            <strong><%= doc.documentNumber || doc.sourceName || 'Supplier document' %></strong>
            <% if (doc.supplierName) { %><span class="dim"> · <%= doc.supplierName %></span><% } %>
          </div>
          <% doc.charges.forEach(function (charge) { %>
            <div class="rm-ledger__row">
              <span class="rm-ledger__k"><%= charge.label %></span>
              <span class="rm-ledger__v"><%= money(charge.amountMinor) %></span>
              <span class="rm-ledger__n"><%= charge.status === 'UNRECORDED' ? 'waiting for your decision' : 'recorded' %></span>
            </div>
          <% }) %>
          <% if (doc.documentTotalMinor !== null) { %>
            <p class="rm-sub">The document totals <strong><%= money(doc.documentTotalMinor) %></strong>. Foundry keeps every charge separate so this can be checked against the source.</p>
          <% } %>
          <div class="rm-choices">
            <form method="post" action="/accounting/document-costs/<%= doc.documentId %>">
              <input type="hidden" name="_csrf" value="<%= csrfToken %>">
              <input type="hidden" name="treatment" value="stock_value">
              <button class="rm-btn" type="submit">Part of what this stock cost</button>
            </form>
            <form method="post" action="/accounting/document-costs/<%= doc.documentId %>">
              <input type="hidden" name="_csrf" value="<%= csrfToken %>">
              <input type="hidden" name="treatment" value="expense">
              <button class="rm-btn rm-btn--quiet" type="submit">A separate expense</button>
            </form>
          </div>
        </section>
      <% }) %>
    </div>
  </details>
<% } else if (story.fees && story.fees.documents && story.fees.documents.length) { %>
  <p class="rm-sub">Every cost on your documents is in your books.</p>
<% } %>

<p class="rm-disclose">
  <a href="/ask?about=<%= encodeURIComponent('my books') %>">Ask about your books</a>
  <a href="/accounting/books">Books &amp; accounting detail — for your accountant</a>
  <a href="/accounting/transactions">Every transaction</a>
  <a href="/accounting/banking">Banking</a>
</p>
