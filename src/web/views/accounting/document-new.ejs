<div class="page-head"><div><a class="back-link" href="/accounting">‹ Money</a><p class="eyebrow"><%= kind === 'invoice' ? 'Customer money' : expenseMode ? 'Business expense' : 'Supplier money' %></p><h1><%= title %></h1><p class="lede"><%= kind === 'invoice' ? 'Use this only for a customer invoice that did not come from Sales. Payment remains separate until money is actually received.' : prefill ? `Foundry filled this from ${prefill.poNumber}. Confirm the supplier invoice details; do not retype the products.` : expenseMode ? 'Record the real bill or receipt and whether money was actually paid. Foundry will update profit, supplier balance, and cash separately.' : 'Use this only when Foundry did not receive the supplier invoice through Purchasing or supplier email.' %></p></div></div>

<% if (kind === 'bill' && prefill) { %><div class="notice"><div><strong>The products and PO costs are already filled from <%= prefill.poNumber %>.</strong><br>Adding this bill changes only the money owed to the supplier. It does not receive inventory again and does not mark the supplier paid.</div></div><% } else { %><div class="notice notice--warning"><div><strong>Manual evidence fallback.</strong><br><%= kind === 'invoice' ? 'Normal customer sales and balances start automatically from the Sales Order.' : expenseMode ? 'Supplier email, connected documents, and matched Purchase Orders should flow in automatically when available.' : 'Matched supplier email and Purchase Orders normally create this record automatically.' %></div></div><% } %>

<form class="stack-xl" method="post" action="/accounting/<%= kind === 'invoice' ? 'receivables' : 'payables' %>">
  <input type="hidden" name="_csrf" value="<%= csrfToken %>">
  <% if (kind === 'bill' && prefill) { %><input type="hidden" name="purchaseOrderId" value="<%= prefill.purchaseOrderId %>"><% } %>
  <% if (expenseMode) { %><input type="hidden" name="returnSection" value="expenses"><% } %>
  <section class="card"><div class="card-head"><div><h2><%= kind === 'invoice' ? 'Who and when' : expenseMode ? 'Who charged you and when' : 'Supplier invoice details' %></h2></div></div><div class="card-body grid grid--3">
    <label class="field"><span class="field-label"><%= kind === 'invoice' ? 'Customer' : expenseMode ? 'Vendor / supplier' : 'Supplier' %></span><select class="select" name="counterpartyId" required><option value="">Choose…</option><% counterparties.forEach(function(row) { %><option value="<%= row.id %>" <%= kind === 'bill' && prefill && prefill.supplierId === row.id ? 'selected' : '' %>><%= row.name %></option><% }) %></select></label>
    <label class="field"><span class="field-label"><%= kind === 'invoice' ? 'Invoice number' : 'Supplier invoice or receipt number' %> (optional)</span><input class="input" name="documentNumber" maxlength="80"></label>
    <label class="field"><span class="field-label"><%= expenseMode ? 'Expense date' : 'Issue date' %></span><input class="input" type="date" name="issueDate" value="<%= today %>" required></label>
    <label class="field"><span class="field-label">Due date (optional)</span><input class="input" type="date" name="dueDate"></label>
  </div></section>

  <section class="card"><div class="card-head"><div><h2><%= prefill ? 'What the supplier billed' : expenseMode ? 'What the expense was' : 'What this document is for' %></h2><p class="hint"><%= prefill ? 'These lines come from the approved Purchase Order.' : 'Use the amount shown by the source document. Foundry never guesses it.' %></p></div></div><div class="card-body">
    <% if (kind === 'bill' && prefill) { %><div class="accounting-record-list"><% prefill.lines.forEach(function(line) { %><div class="accounting-line"><div><strong><%= line.description %></strong><span><%= line.quantity %> units × <%= line.unitAmount %></span></div><strong><%= helpers.money(Math.round(line.quantity * Number(line.unitAmount) * 100)) %></strong><input type="hidden" name="description" value="<%= line.description %>"><input type="hidden" name="quantity" value="<%= line.quantity %>"><input type="hidden" name="unitAmount" value="<%= line.unitAmount %>"><input type="hidden" name="skuId" value="<%= line.skuId %>"><input type="hidden" name="purchaseOrderLineId" value="<%= line.purchaseOrderLineId %>"></div><% }) %></div><% } else { %>
      <div class="grid grid--3"><label class="field field--wide"><span class="field-label"><%= expenseMode ? 'Plain description' : 'Description' %></span><input class="input" name="description" required maxlength="250" placeholder="<%= expenseMode ? 'Example: September warehouse rent' : '' %>"></label><label class="field"><span class="field-label">Quantity</span><input class="input" type="number" name="quantity" min="0.01" step="0.01" value="1" required></label><label class="field"><span class="field-label"><%= expenseMode ? 'Amount' : 'Unit ' + (kind === 'invoice' ? 'price' : 'cost') %></span><input class="input" name="unitAmount" inputmode="decimal" required placeholder="0.00"></label>
      <% if (kind === 'bill') { %><label class="field"><span class="field-label">Expense category</span><select class="select" name="accountId" required><% accounts.forEach(function(account) { %><option value="<%= account.id %>"><%= account.name %></option><% }) %></select></label><% } %></div>
    <% } %>
    <div class="grid grid--3"><label class="field"><span class="field-label">Exact tax amount (optional)</span><input class="input" name="tax" inputmode="decimal" placeholder="Leave blank to use a rate"></label><label class="field"><span class="field-label">Configured tax rate (optional)</span><select class="select" name="taxRateId"><option value="">No calculated tax</option><% taxRates.forEach(function(rate) { %><option value="<%= rate.id %>"><%= rate.name %> · <%= (rate.rate_millionths / 10000).toFixed(4).replace(/0+$/,'').replace(/\.$/,'') %>%</option><% }) %></select></label><label class="field"><span class="field-label">Notes (optional)</span><input class="input" name="notes" maxlength="500"></label></div>
  </div></section>

  <% if (kind === 'bill') { %><section class="card"><div class="card-head"><div><h2>Was money actually paid?</h2><p class="hint">A bill and a payment are separate. Choose only what really happened.</p></div></div><div class="card-body grid grid--3"><label class="field"><span class="field-label">Payment status</span><select class="select" name="paymentStatus"><option value="unpaid">Not paid — keep the full amount owed</option><option value="partially_paid">Partially paid</option><option value="paid">Paid in full</option></select></label><label class="field"><span class="field-label">Amount paid (only for partial)</span><input class="input" name="paymentAmount" inputmode="decimal" placeholder="0.00"></label><label class="field"><span class="field-label">Payment date</span><input class="input" type="date" name="paymentDate" value="<%= today %>"></label><label class="field"><span class="field-label">Payment method (optional)</span><input class="input" name="paymentMethod" placeholder="Card, check, transfer…"></label><label class="field"><span class="field-label">Payment reference (optional)</span><input class="input" name="paymentReference"></label></div></section><% } %>

  <div class="form-actions"><button class="btn btn--primary" type="submit"><%= expenseMode ? 'Record this expense' : kind === 'invoice' ? 'Record customer invoice' : 'Record supplier bill' %></button><span class="hint">This financial record never changes physical inventory.</span></div>
</form>
