<% const m=model,amount=n=>helpers.money(n,m.currency),q=new URLSearchParams({from:m.from,to:m.to}).toString(),percent=n=>m.pnl.revenueMinor?(n/m.pnl.revenueMinor*100).toFixed(1)+'%':'Not applicable'; %><a class="back-link" href="/money?<%= q %>">‹ Money</a><header class="sc-business-head"><div><h1>Profit</h1><p><%= helpers.shortDate(m.from) %> – <%= helpers.shortDate(m.to) %> · <%= m.timeZone %> · <%= m.currency %></p></div><a class="btn" href="/accounting/reports/profit-and-loss?<%= q %>">Accountant view</a></header><%- include('customer-period',{model:m,action:'/money/profit'}) %><div class="sc-business-two"><section class="sc-business-card"><h2>From sales to profit</h2><% for(const [key,label,value]of [['revenue','Sales',m.pnl.revenueMinor],['cogs','− Cost of goods sold',m.pnl.cogsMinor],['gross','= Gross profit',m.pnl.grossProfitMinor],['expenses','− Operating expenses',m.pnl.operatingExpenseMinor],['net','= Net profit',m.pnl.netIncomeMinor]]){ %><a class="sc-profit-row" href="/money/sources/<%= key %>?<%= q %>" data-profit="<%= key %>" data-amount-minor="<%= value %>"><span><%= label %></span><strong><%= amount(value) %></strong><small>Where did this come from? →</small></a><% } %><p>Gross margin <strong><%= percent(m.pnl.grossProfitMinor) %></strong> · Net margin <strong><%= percent(m.pnl.netIncomeMinor) %></strong></p></section><section class="sc-business-card"><span class="badge badge--warn">Incomplete cost coverage</span><h2>What this figure includes</h2><p><%= m.profitNote %></p><p><%= m.missingCostUnits %> physical units have no recorded cost.</p><h3><%= m.basis %> accounting</h3><p><%= m.basisDescription %></p><p>Cash basis instead recognizes income and expenses when paid. This profit view uses accrual consistently and does not treat unbilled receipts as supplier bills.</p></section></div>
<section class="sc-business-card"><h2>Compare periods</h2><div class="sc-profit-comparison"><% const max=Math.max(1,...comparisons.map(p=>Math.abs(p.pnl.netIncomeMinor)));for(const p of comparisons){ %><a href="/money/profit?from=<%= p.from %>&amp;to=<%= p.to %>"><strong><%= p.label %></strong><b><%= amount(p.pnl.netIncomeMinor) %></b><span style="width:<%= Math.abs(p.pnl.netIncomeMinor)/max*100 %>%"></span><small>Gross <%= amount(p.pnl.grossProfitMinor) %> · expenses <%= amount(p.pnl.operatingExpenseMinor) %></small></a><% } %></div></section>
