<p class="rm-stamp">Ledger-backed · <%= from %> to <%= to %></p><h1 class="rm-figure"><a href="/accounting/reports/profit-and-loss?from=<%= from %>&to=<%= to %>"><%= helpers.money(pnl.netIncomeMinor,pnl.currency) %> net income this period.</a></h1>
<p class="rm-sub"><%= helpers.money(pnl.revenueMinor,pnl.currency) %> revenue, <%= helpers.money(pnl.cogsMinor,pnl.currency) %> product cost, and <%= helpers.money(pnl.operatingExpenseMinor,pnl.currency) %> operating expenses.</p>
<div class="rm-ledger"><div class="rm-ledger__row"><span class="rm-ledger__k">Customers owe</span><span class="rm-ledger__v"><%= helpers.money(receivableMinor,pnl.currency) %></span><span class="rm-ledger__n">open and partially paid invoices</span></div>
  <div class="rm-ledger__row"><span class="rm-ledger__k">You owe suppliers</span><span class="rm-ledger__v"><%= helpers.money(payableMinor,pnl.currency) %></span><span class="rm-ledger__n">open, partial and disputed bills</span></div>
  <div class="rm-ledger__row"><span class="rm-ledger__k">Assets</span><span class="rm-ledger__v"><%= helpers.money(balance.assetMinor,pnl.currency) %></span><span class="rm-ledger__n">as of <%= to %></span></div>
  <div class="rm-ledger__row"><span class="rm-ledger__k">Liabilities and equity</span><span class="rm-ledger__v"><%= helpers.money(balance.liabilitiesAndEquityMinor,pnl.currency) %></span><span class="rm-ledger__n"><%= balance.balanced?'balanced':'needs review' %></span></div></div>
<p class="rm-disclose"><a href="/accounting/reports/profit-and-loss?from=<%= from %>&to=<%= to %>">Profit and loss</a><a href="/accounting/reports/balance-sheet?asOf=<%= to %>">Balance sheet</a><a href="/accounting/reports/trial-balance?to=<%= to %>">Trial balance</a><a href="/accounting/reports/general-ledger?from=<%= from %>&to=<%= to %>">General ledger</a></p>
