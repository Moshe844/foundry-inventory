<div class="page-head"><div><a class="back-link" href="/accounting">‹ Money</a><p class="eyebrow">Accountant control</p><h1>Chart of accounts</h1><p class="lede">Foundry’s control accounts are protected. Owners and accountants can add business-specific accounts without changing posting logic.</p></div></div>
<section class="card"><div class="card-head"><h2>Accounts</h2></div><div class="card-body"><div class="table-wrap"><table class="table"><thead><tr><th>Code</th><th>Name</th><th>Type</th><th>Purpose</th></tr></thead><tbody>
<% accounts.forEach(function(account){ %><tr><td><%= account.code %></td><td><%= account.name %></td><td><%= account.account_type %></td><td><%= account.is_control ? 'Foundry control account' : (account.subtype || 'Custom account') %></td></tr><% }) %>
</tbody></table></div></div></section>
<details class="card"><summary class="card-head"><div><h2>Add a custom account</h2><p class="hint">Advanced. Existing posted entries are never rewritten.</p></div></summary><form class="card-body grid grid--3" method="post" action="/accounting/chart"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><label class="field"><span class="field-label">Code</span><input class="input" name="code" required maxlength="30"></label><label class="field"><span class="field-label">Name</span><input class="input" name="name" required maxlength="120"></label><label class="field"><span class="field-label">Type</span><select class="select" name="type"><option>ASSET</option><option>LIABILITY</option><option>EQUITY</option><option>INCOME</option><option>COGS</option><option>EXPENSE</option></select></label><label class="field"><span class="field-label">Subtype (optional)</span><input class="input" name="subtype"></label><label class="field"><span class="field-label">Normal balance</span><select class="select" name="normalBalance"><option>DEBIT</option><option>CREDIT</option></select></label><div class="field"><span class="field-label">Action</span><button class="btn" type="submit">Add account</button></div></form></details>
