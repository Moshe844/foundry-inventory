<header class="page-head"><div><a href="/settings">← Settings</a><h1>Remove a Staging test account</h1><p>Remove the actual sign-in account so its email can register again. This control is restricted to authorized developers on Staging.</p></div></header>
<form method="get" action="/commercial-admin/accounts" class="card"><div class="card-body"><label class="field"><span>Test account email</span><input class="input" type="email" name="email" value="<%= searchEmail %>" required autofocus></label><button class="btn" type="submit">Review account</button></div></form>
<% if(review){ %><section class="card"><div class="card-body"><h2><%= review.target.email %></h2><p><%= review.target.name %> · <%= review.workspaces.length %> owned inventories</p><ul><% for(const w of review.workspaces){ %><li><%= w.name %> — <%= w.products %> products, <%= w.journals %> journal entries</li><% } %></ul>
<p class="notice notice--warn">Permanent removal deletes this account’s owned inventories, stock and financial test records, contacts, local connection credentials and sign-in sessions. Connected provider accounts are not deleted. Anonymous cost receipts remain to preserve the approved testing budget. No payment or refund is made.</p>
<% if(!review.canDelete){ %><ul role="alert"><% for(const reason of review.blockers){ %><li><%= reason %></li><% } %></ul><% }else{ %>
<form method="post" action="/commercial-admin/accounts/remove"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="email" value="<%= review.target.email %>"><input type="hidden" name="reviewHash" value="<%= review.reviewHash %>"><label class="field"><span>Type the exact account email</span><input class="input" type="email" name="confirmEmail" required autocomplete="off"></label><label class="field"><span>Your developer password</span><input class="input" type="password" name="password" required autocomplete="current-password"></label><label><input type="checkbox" name="confirmed" value="yes" required> I confirm permanent removal of this exact Staging test account and all its owned inventories.</label><p><button class="btn btn--danger" type="submit">Permanently remove this test account</button></p></form>
<% } %></div></section><% } %>
