<div class="rm-head"><div><span class="rm-eyebrow">INTERNAL</span><h1>Commercial control</h1><p>Prices, Stripe IDs, public visibility, trials, allowances and grace periods update without a code deployment.</p></div></div>
<% var packagingReviewed=plans.length>0&&plans.every(function(plan){return plan.packaging_reviewed_at;}); %><div class="notice <%= packagingReviewed?'notice--ok':'notice--warn' %>"><% if(packagingReviewed){ %><strong>Packaging reviewed.</strong> Checkout remains closed for each plan until both Stripe Price IDs are entered and checkout approval is enabled.<% }else{ %><strong>Packaging review required.</strong> Review every major entitlement before freezing Starter, Growth and Pro.<% } %></div>
<div class="rm-grid rm-grid--2" style="margin-bottom:16px">
  <section class="rm-panel" id="grants"><div class="rm-panel__head"><h2>Comp, trial or extension</h2></div><form method="post" action="/commercial-admin/grants" style="padding:18px"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><label class="rm-field"><span>Account email</span><input type="email" name="email" required></label><label class="rm-field"><span>Plan</span><select name="planId"><% plans.forEach(function(plan){ %><option value="<%= plan.id %>"><%= plan.public_name %></option><% }); %></select></label><label class="rm-field"><span>Access</span><select name="kind"><option value="comp">Comp access</option><option value="trial">Time-limited trial or extension</option></select></label><label class="rm-field"><span>Days from now</span><input type="number" min="1" name="days" value="1"></label><button class="rm-btn" type="submit">Grant or extend access</button></form></section>
  <section class="rm-panel" id="promotions"><div class="rm-panel__head"><h2>Promotion</h2></div><form method="post" action="/commercial-admin/promos" style="padding:18px"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><label><input type="checkbox" name="active" value="1" checked> Active</label><label class="rm-field"><span>Code</span><input name="code" required></label><label class="rm-field"><span>Plan</span><select name="planId"><option value="">Any plan</option><% plans.forEach(function(plan){ %><option value="<%= plan.id %>"><%= plan.public_name %></option><% }); %></select></label><label class="rm-field"><span>Trial days</span><input type="number" min="0" name="trialDays" value="0"></label><label class="rm-field"><span>Discount percent</span><input type="number" min="0" max="100" name="discountPercent" value="0"></label><label class="rm-field"><span>Stripe promotion code ID</span><input name="stripePromotionCodeId"><small>Required when a discount is offered.</small></label><label class="rm-field"><span>Redemption limit</span><input type="number" min="1" name="redemptionLimit"></label><label class="rm-field"><span>Starts at</span><input type="datetime-local" name="startsAt"></label><label class="rm-field"><span>Ends at</span><input type="datetime-local" name="endsAt"></label><button class="rm-btn" type="submit">Save promotion</button></form></section>
</div>
<section class="rm-panel" style="margin-bottom:16px"><div class="rm-panel__head"><h2>Customer-specific capability</h2></div><form method="post" action="/commercial-admin/overrides" style="padding:18px"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><div class="rm-grid rm-grid--2"><label class="rm-field"><span>Account email</span><input type="email" name="email" required></label><label class="rm-field"><span>Capability key</span><input name="capability" placeholder="connection.email" required></label><label class="rm-field"><span>State</span><select name="enabled"><option value="1">Granted</option><option value="0">Restricted</option></select></label><label class="rm-field"><span>Ends at (optional)</span><input type="datetime-local" name="endsAt"></label></div><label class="rm-field"><span>Reason</span><input name="reason" required></label><button class="rm-btn" type="submit">Save override</button></form></section>
<section class="rm-panel" id="limits" style="margin-bottom:16px"><div class="rm-panel__head"><h2>Customer-specific usage limit</h2></div><form method="post" action="/commercial-admin/meter-overrides" style="padding:18px"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><div class="rm-grid rm-grid--2"><label class="rm-field"><span>Account email</span><input type="email" name="email" required></label><label class="rm-field"><span>Meter</span><select name="meter"><option value="workspaces">Inventories</option><option value="members">People</option><option value="locations">Locations</option><option value="connections">Connections</option><option value="processing_units">Business processing units</option><option value="external_events">External events</option></select></label><label class="rm-field"><span>Limit units</span><input type="number" min="0" name="limitUnits" required></label><label class="rm-field"><span>Ends at (optional)</span><input type="datetime-local" name="endsAt"></label></div><label class="rm-field"><span>Reason</span><input name="reason" required></label><button class="rm-btn" type="submit">Save customer limit</button></form></section>
<div class="rm-stack"><% plans.forEach(function(plan){ %><section class="rm-panel" id="<%= plan.id %>"><div class="rm-panel__head"><h2><%= plan.public_name %></h2><span class="right"><span class="rm-pillbadge"><%= plan.status %></span></span></div>
  <form method="post" action="/commercial-admin/plans/<%= plan.id %>" style="padding:20px"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><div class="rm-grid rm-grid--2"><label class="rm-field"><span>Public name</span><input name="publicName" value="<%= plan.public_name %>" required></label><label class="rm-field"><span>Status</span><select name="status"><% ['DRAFT','ACTIVE','ARCHIVED'].forEach(function(state){ %><option <%= plan.status===state?'selected':'' %>><%= state %></option><% }); %></select></label><label class="rm-field"><span>Monthly price</span><input name="monthlyAmount" type="number" step="0.01" value="<%= plan.monthly_amount_minor===null?'':Number(plan.monthly_amount_minor)/100 %>"></label><label class="rm-field"><span>Annual price</span><input name="annualAmount" type="number" step="0.01" value="<%= plan.annual_amount_minor===null?'':Number(plan.annual_amount_minor)/100 %>"></label><label class="rm-field"><span>Stripe monthly price ID</span><input name="stripeMonthlyPriceId" value="<%= plan.stripe_monthly_price_id||'' %>"></label><label class="rm-field"><span>Stripe annual price ID</span><input name="stripeAnnualPriceId" value="<%= plan.stripe_annual_price_id||'' %>"></label><label class="rm-field"><span>Trial days</span><input name="trialDays" type="number" min="0" value="<%= plan.trial_days %>"></label><label class="rm-field"><span>Failed-payment grace days</span><input name="graceDays" type="number" min="0" value="<%= plan.grace_days %>"></label></div><label class="rm-field"><span>Outcome</span><textarea name="outcome" required><%= plan.outcome %></textarea></label><label class="rm-field"><span>Audience</span><textarea name="audience" required><%= plan.audience %></textarea></label><label><input type="checkbox" name="isPublic" value="1" <%= Number(plan.is_public)?'checked':'' %>> Public</label> <label><input type="checkbox" name="isRecommended" value="1" <%= Number(plan.is_recommended)?'checked':'' %>> Recommended</label><div class="notice <%= plan.packaging_status==='APPROVED'?'notice--ok':'notice--warn' %>" style="margin-top:16px"><label><input type="checkbox" name="packagingApproved" value="1" <%= plan.packaging_status==='APPROVED'?'checked':'' %>> I reviewed this plan's price, every entitlement and every usage limit; allow real checkout.</label></div><div class="rm-choices"><button class="rm-btn" type="submit">Save <%= plan.public_name %></button></div></form>
  <details style="padding:0 20px 20px"><summary>Entitlements and limits</summary><div class="rm-told"><% plan.entitlements.forEach(function(item){ %><form class="rm-told__row" method="post" action="/commercial-admin/plans/<%= plan.id %>/entitlements/<%= encodeURIComponent(item.capability) %>"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><span class="rm-told__t"><%= item.capability %></span><input type="hidden" name="enabled" value="<%= Number(item.enabled)?'0':'1' %>"><button class="rm-btn rm-btn--ghost rm-btn--sm" type="submit"><%= Number(item.enabled)?'Included':'Not included' %></button></form><% }); %></div><% plan.meters.forEach(function(meter){ %><form method="post" action="/commercial-admin/plans/<%= plan.id %>/meters/<%= encodeURIComponent(meter.meter) %>" style="border-top:1px solid var(--line-2);padding:14px 0"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><strong><%= meter.meter %></strong><div class="rm-grid rm-grid--2"><label class="rm-field"><span>Label</span><input name="label" value="<%= meter.label %>"></label><label class="rm-field"><span>Included units</span><input type="number" name="includedUnits" value="<%= meter.included_units??'' %>"></label><label class="rm-field"><span>Hard limit</span><input type="number" name="hardLimit" value="<%= meter.hard_limit??'' %>"></label><label class="rm-field"><span>Overage block units</span><input type="number" name="overageBlockUnits" value="<%= meter.overage_block_units??'' %>"></label><label class="rm-field"><span>Overage price</span><input type="number" step="0.01" name="overageAmount" value="<%= meter.overage_amount_minor===null?'':Number(meter.overage_amount_minor)/100 %>"></label></div><button class="rm-btn rm-btn--ghost rm-btn--sm" type="submit">Save allowance</button></form><% }); %></details>
</section><% }); %></div>
