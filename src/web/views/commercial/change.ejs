<div class="rm-head"><div><span class="rm-eyebrow">PLAN CHANGE</span><h1>Review before anything changes.</h1><p>StockChief keeps your current plan active until Stripe confirms an upgrade or the paid period reaches a scheduled downgrade.</p></div></div>
<section class="rm-panel"><div class="rm-panel__head"><h2><%= quote.currentPlan.public_name %> → <%= quote.target.public_name %></h2><span class="right"><span class="rm-pillbadge <%= quote.downgrade?'is-warn':'is-ok' %>"><%= quote.downgrade?'At renewal':'After Stripe confirms' %></span></span></div><div style="padding:20px">
  <div class="rm-grid rm-grid--2"><div><span class="rm-eyebrow">CURRENT</span><h3><%= quote.currentPlan.public_name %></h3><p><%= String(quote.current.billing_interval||'').toLowerCase() %> billing</p></div><div><span class="rm-eyebrow">NEW PLAN</span><h3><%= quote.target.public_name %></h3><p><%= quote.interval.toLowerCase() %> billing · <strong><%= (Number(quote.interval==='ANNUAL'?quote.target.annual_amount_minor:quote.target.monthly_amount_minor)/100).toLocaleString('en-US',{style:'currency',currency:quote.target.currency}) %></strong></p></div></div>
  <% if(quote.downgrade){ %><div class="notice notice--warn"><strong>Scheduled for <%= new Date(quote.effectiveAt).toLocaleDateString() %>.</strong> Your current capabilities remain active until then. No records, locations, connections or history are deleted.</div><% } else { %><div class="notice notice--ok"><strong>Immediate upgrade after Stripe confirms it.</strong> The estimated proration is <%= (Number(quote.prorationAmountMinor||0)/100).toLocaleString('en-US',{style:'currency',currency:quote.target.currency}) %>. Stripe remains authoritative if taxes, credits or discounts alter the final amount.</div><% } %>
  <% var excess=Object.values(quote.excess||{});if(excess.length){ %><div class="notice notice--warn"><strong>This downgrade cannot be scheduled yet.</strong><% excess.forEach(function(item){ %><br><%= item.label %>: <%= item.used %> active, <%= item.allowed %> allowed<% }); %><br>Nothing was deleted or disabled.</div><% } %>
  <div class="rm-choices"><a class="rm-btn rm-btn--ghost" href="/billing">Keep current plan</a><% if(!excess.length){ %><form method="post" action="/billing/change"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="planId" value="<%= quote.target.id %>"><input type="hidden" name="interval" value="<%= quote.interval.toLowerCase() %>"><button class="rm-btn" type="submit"><%= quote.downgrade?'Schedule downgrade':'Confirm upgrade' %></button></form><% } %></div>
</div></section>
