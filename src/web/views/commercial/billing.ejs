<div class="rm-head"><div><span class="rm-eyebrow">ACCOUNT</span><h1>Plan &amp; Usage</h1><p>Your plan, included usage and purchased usage in one place. Included usage is pooled across your account; purchased packs belong to the selected inventory.</p></div></div>
<form method="post" action="/logout-all" data-confirm="Sign out all devices?"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="rm-btn rm-btn--ghost" type="submit">Sign out all devices</button></form>
<% if(!checkoutOpen){ %><div class="notice notice--warn">Checkout is closed pending commercial readiness approval. Allowances and usage pack prices below are provisional.</div><% } %>
<div class="rm-grid rm-grid--2"><section class="rm-panel"><div class="rm-panel__head"><h2>Current plan</h2></div><div style="padding:18px">
<% if(summary.subscription){var sub=summary.subscription; %><h3><%= sub.plan_name %></h3><p><%= sub.status %></p>
<% if(sub.current_period_end){ %><p><%= sub.cancel_at_period_end?'Access through':'Renews' %> <%= new Date(sub.current_period_end).toLocaleDateString() %></p><% } %>
<% if(sub.status==='GRACE'){ %><div class="notice notice--warn">Update your payment method before <%= new Date(sub.grace_ends_at).toLocaleDateString() %> to keep operations running.</div><% } %>
<% if(sub.stripe_customer_id){ %><form method="post" action="/billing/portal"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="rm-btn">Update payment method</button></form><% } %>
<% if(sub.stripe_subscription_id){ %><form method="post" action="/billing/<%= sub.cancel_at_period_end?'reactivate':'cancel' %>"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="rm-btn rm-btn--ghost"><%= sub.cancel_at_period_end?'Keep my subscription':'Cancel at renewal' %></button></form><% } %>
<% }else{ %><p>No subscription yet.</p><a href="/pricing" class="rm-btn">Compare plans</a><% } %>
</div></section><section class="rm-panel"><div class="rm-panel__head"><h2>Monthly usage</h2></div><div style="padding:18px">
<% usageWarnings.forEach(function(w){ %><div class="notice notice--warn"><%= w.threshold %>% of included <%= w.label %> used. <%= w.threshold===100?'Purchased usage is used next. Optional processing pauses when no usage remains.':'Buy more, upgrade, or wait for your next monthly reset.' %></div><% }); %>
<% summary.meters.filter(function(m){return m.definition?.kind==='USAGE'&&m.definition.customerVisible;}).forEach(function(m){ %><article style="margin-bottom:20px" data-usage-category="<%= m.meter %>"><h3><%= m.label %></h3><p><%= m.includedUsed||0 %> of <%= m.included||0 %> included · <%= m.includedRemaining||0 %> included remaining</p><p><%= m.purchasedRemaining||0 %> purchased remaining · <strong><%= m.remaining||0 %> total remaining</strong><%= m.reserved?' · '+m.reserved+' in progress':'' %></p><small>Resets <%= m.periodEnd?new Date(m.periodEnd).toLocaleDateString():'monthly' %></small>
<details><summary>Buy More</summary><% packs.filter(function(p){return p.category===m.meter;}).forEach(function(p){ %><form method="post" action="/billing/buy-more" style="margin:10px 0"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="purchaseKey" value="<%= purchaseKey %>:<%= p.id %>"><input type="hidden" name="packId" value="<%= p.id %>"><button class="rm-btn" <%= checkoutOpen&&p.purchasable?'':'disabled' %>>Buy <%= Number(p.units).toLocaleString() %> — <%= (Number(p.amount_minor)/100).toLocaleString('en-US',{style:'currency',currency:p.currency}) %></button></form><% }); %></details>
<% if(m.grants?.length){ %><details><summary>Purchased usage expiration</summary><% m.grants.forEach(function(g){ %><p><%= g.remaining %> remaining · expires <%= new Date(g.expires_at).toLocaleDateString() %><% if(Number(g.dispute_hold_units)>0){ %> · <%= g.dispute_hold_units %> temporarily held while payment is disputed<% } %></p><% }); %></details><% } %>
</article><% }); %></div></section></div>
<section class="rm-panel" style="margin-top:18px"><div class="rm-panel__head"><h2>Auto-top-up</h2></div><div style="padding:18px"><p>Off by default. An enabled category buys your chosen pack when total remaining usage falls below 10% of its monthly included allowance. Each cap applies to this inventory and category, in a UTC calendar month. Pending charges count toward that cap. Failed payments require attention.</p>
<% ['ai_work_credits','connected_operations'].forEach(function(category){var pref=topups.find(function(t){return t.category===category;});var choices=packs.filter(function(p){return p.category===category;}); %><form method="post" action="/billing/auto-top-up" style="margin-bottom:18px"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="category" value="<%= category %>"><h3><%= category==='ai_work_credits'?'AI Work Credits':'Connected Operations' %></h3><label class="rm-field"><span>Usage pack</span><select name="packId"><% choices.forEach(function(p){ %><option value="<%= p.id %>" <%= pref?.pack_id===p.id?'selected':'' %>><%= p.units %> for $<%= Number(p.amount_minor)/100 %></option><% }); %></select></label><label class="rm-field"><span>Monthly cap for this inventory/category (USD)</span><input type="number" min="0" step="0.01" name="monthlyCap" value="<%= Number(pref?.monthly_cap_minor||0)/100 %>"></label><label><input type="checkbox" name="enabled" value="1" <%= pref?.enabled?'checked':'' %> <%= checkoutOpen?'':'disabled' %>> Enable automatic purchases</label><p><label><input type="checkbox" name="consent" value="1"> I authorize off-session charges for this pack up to my monthly cap.</label></p><button class="rm-btn">Save auto-top-up</button></form><% }); %></div></section>
<section class="rm-panel" style="margin-top:18px"><div class="rm-panel__head"><h2>Upgrade or change plan</h2></div><div style="padding:18px"><% plans.forEach(function(p){if(p.id===summary.subscription?.plan_id)return; %><p><a href="<%= p.sales_only?'/contact?plan=enterprise':summary.subscription?.stripe_subscription_id?'/billing/change?plan='+p.id+'&interval=monthly':'/pricing#'+p.id %>"><%= p.public_name %></a></p><% }); %><% pendingChanges.forEach(function(c){ %><p><%= c.target_plan_name %> scheduled for <%= new Date(c.effective_at).toLocaleDateString() %>.</p><% }); %></div></section>
<section class="rm-panel" style="margin-top:18px"><div class="rm-panel__head"><h2>Billing history</h2></div><div style="padding:18px"><% if(!invoices.length&&!purchases.length){ %><p>No billing documents yet.</p><% } %><% invoices.forEach(function(i){ %><p><%= i.number||i.id %> · <%= i.status %> · <%= (Number(i.amount_paid||0)/100).toLocaleString('en-US',{style:'currency',currency:(i.currency||'usd').toUpperCase()}) %><% if(i.hosted_invoice_url){ %> · <a href="<%= i.hosted_invoice_url %>" rel="noopener">View invoice</a><% } %></p><% }); %><% purchases.forEach(function(p){ %><p><%= new Date(p.created_at).toLocaleDateString() %> · <%= p.units %> <%= p.category==='ai_work_credits'?'AI Work Credits':'Connected Operations' %> · <%= p.status %> · $<%= Number(p.amount_minor)/100 %><%= p.kind==='AUTO'?' · Auto-top-up':'' %></p><% }); %></div></section>
