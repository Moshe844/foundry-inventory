<header class="rm-head"><h1>Settings</h1><p>Manage your business, team and StockChief preferences.</p></header>
<div class="sc-settings-layout"><%- include('../settings/navigation',{section:'billing',sections:searchableSettingsSections}) %><div class="sc-settings-content" data-settings-section="billing"><h2>Plan &amp; billing</h2><p>Your subscription, monthly allowances and billing history.</p>
<% if(locals.scheduleUnavailable){ %><p class="notice notice--warn">We could not refresh your scheduled plan change. Check the date in Stripe using Manage plan and payment below, or try again shortly.</p><% } %>
<% for(const change of pendingChanges){ %><aside class="notice <%= Object.keys(change.excess||{}).length?'notice--danger':'notice--warn' %>" role="status" data-scheduled-plan-change><strong><% if(new Date(change.effective_at)>new Date()){ %>Your plan changes to <%= change.target_plan_name %> on <%= helpers.dateTime(change.effective_at) %>.<% }else{ const due=change.request_quote?.amountDueMinor??change.proration_amount_minor; %><span data-upgrade-pending>Taking payment<%= due===null||due===undefined?'':' of '+(Number(due)/100).toLocaleString('en-US',{style:'currency',currency:change.request_quote?.target?.currency||'USD'}) %> for <%= change.target_plan_name %>. Your current plan stays active until the payment goes through.</span><% } %></strong><% if(Object.keys(change.excess||{}).length){ %><p>Your account currently exceeds this plan’s limits:</p><ul><% for(const value of Object.values(change.excess)){ %><li><%= value.label %>: <%= Number(value.used).toLocaleString('en-US') %> used; <%= Number(value.allowed).toLocaleString('en-US') %> allowed.</li><% } %></ul><p>This change is still scheduled in billing. Existing records will be preserved, but new records and features will be limited by the lower plan from that date. Reduce usage before then, or open Manage plan and payment in Stripe to keep a plan that covers your account. <a href="/support">Contact support</a> if you need help.</p><% }else{ %><p>Current plan access continues until the change date. Features and limits switch after Stripe confirms the change and any required payment.</p><% } %></aside><% } %>
<% if(locals.upgradeOutcome){ const paid=upgradeOutcome.status==='APPLIED',amount=upgradeOutcome.amountMinor===null||upgradeOutcome.amountMinor===undefined?'':(Number(upgradeOutcome.amountMinor)/100).toLocaleString('en-US',{style:'currency',currency:upgradeOutcome.currency}); %><div class="notice <%= paid?'notice--ok':'notice--warn' %>" role="status" data-upgrade-outcome><strong><%= paid?'Paid'+(amount?' '+amount:'')+'. You’re now on '+upgradeOutcome.plan+'.':'Your upgrade to '+upgradeOutcome.plan+' did not go through.' %></strong><% if(!paid){ %> Your current plan is unchanged. Check your payment method, then try again.<% } %></div><% } %>
<script>(()=>{if(!document.querySelector('[data-upgrade-pending]'))return;let n=0;try{n=Number(sessionStorage.getItem('upgradeChecks')||0);}catch{}if(n>=40)return;try{sessionStorage.setItem('upgradeChecks',String(n+1));}catch{}setTimeout(()=>location.reload(),3000);})();try{if(!document.querySelector('[data-upgrade-pending]'))sessionStorage.removeItem('upgradeChecks');}catch{}</script>
<link rel="stylesheet" href="/orders-ui.css?v=<%= locals.assetVersion||'current' %>">
<% const sub=summary.subscription,currentPlan=plans.find(p=>p.id===sub?.plan_id),interval=sub?.billing_interval==='ANNUAL'?'annual':'monthly',
   privatePilot=sub?.source==='ADMIN_PRIVATE_PILOT',
   showAiStatus=locals.aiCost&&(!aiCost.creditsOnly||aiCost.paused||aiCost.creditsBlocked||aiCost.creditWarning||aiCost.certificationPaused),
   money=(minor,currency)=>(Number(minor||0)/100).toLocaleString('en-US',{style:'currency',currency:currency||'USD',maximumFractionDigits:Number(minor)%100?2:0}),
   number=value=>Number(value||0).toLocaleString('en-US'),
   limit=(p,meter)=>{const row=(p.meters||[]).find(m=>m.meter===meter);if(!row)return null;const value=row.hard_limit??row.included_units;return value===null||value===undefined?'Unlimited':Number(value).toLocaleString('en-US');},
   renews=sub?.current_period_end?helpers.dateTime(sub.current_period_end):'the end of this billing period'; %>
<div class="ox ox-billing">
<section class="ox-card ox-plan-now" aria-labelledby="plan-now-title">
<% if(sub){ %>
  <div class="ox-plan-now__main"><span class="ox-plan-now__eyebrow">Current plan</span><h3 id="plan-now-title"><%= sub.plan_name %><% if(privatePilot){ %> <span class="ox-plan-now__pilot">Private pilot</span><% }else if(currentPlan&&!currentPlan.sales_only){ %> <small><%= money(interval==='annual'?currentPlan.annual_amount_minor:currentPlan.monthly_amount_minor,currentPlan.currency) %>/<%= interval==='annual'?'year':'month' %></small><% } %></h3>
    <% if(privatePilot){ %><p><% if(sub.current_period_end){ %>Pilot access ends <time datetime="<%= new Date(sub.current_period_end).toISOString() %>"><%= helpers.dateTime(sub.current_period_end) %></time>.<% } %></p>
    <% }else{ %><p><%= sub.status==='COMP'?'Complimentary':sub.status.replaceAll('_',' ').toLowerCase() %><% if(sub.current_period_end&&!sub.refunded_at&&sub.source!=='SELF_SERVICE_TRIAL'){ %> · <%= sub.status==='TRIALING'?'Trial ends':sub.cancel_at_period_end?'Your plan ends on':pendingChanges.some(c=>new Date(c.effective_at)>new Date())?'Current billing period ends':'Renews' %> <%= helpers.dateTime(sub.current_period_end) %><% } %></p><% } %></div>
  <div class="ox-plan-now__actions">
    <% if(!checkoutOpen){ %><a href="/pricing" class="ox-btn ox-btn--secondary ox-btn--sm">Compare plans</a><% } %>
    <% if(sub.stripe_customer_id){ %><form method="post" action="/billing/portal"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="ox-btn ox-btn--secondary ox-btn--sm">Manage cards and invoices</button></form><% } %>
    <% if(sub.stripe_subscription_id&&!sub.refunded_at&&sub.cancel_at_period_end){ %><form method="post" action="/billing/reactivate"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="ox-btn ox-btn--primary ox-btn--sm">Keep my subscription</button></form><% }else if(sub.stripe_subscription_id&&!sub.refunded_at){ %><button class="ox-btn ox-btn--ghost ox-btn--sm" type="button" data-modal-open="cancel-plan">Cancel subscription</button><% } %>
  </div>
  <% if(sub.stripe_customer_id){ %><p class="ox-plan-now__hint">Cards are kept by Stripe, our payment provider: add, change or remove a card and download invoices there. StockChief never sees your card number.</p><% } %>
  <% if(sub.stripe_subscription_id&&!sub.refunded_at&&!sub.cancel_at_period_end){ %><dialog class="ox ox-modal" id="cancel-plan" aria-labelledby="cancel-plan-h"><form method="post" action="/billing/cancel"><input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <div class="ox-modal__h"><h2 id="cancel-plan-h">Cancel your subscription?</h2><button class="ox-modal__x" type="button" data-modal-close aria-label="Close">×</button></div>
    <div class="ox-modal__b"><p>You won’t be charged again. <%= sub.plan_name %> stays fully active until <strong><%= renews %></strong>, the end of the period you already paid for; then the subscription ends.</p><p>Your records are kept and you can restart any time before then with one click. Within 14 days of your first payment you can <a href="/support?topic=subscription-refund">ask for a refund</a> instead.</p></div>
    <div class="ox-modal__f"><button class="ox-btn ox-btn--ghost" type="button" data-modal-close>Keep subscription</button><button class="ox-btn ox-btn--danger" type="submit">Cancel subscription</button></div></form></dialog><% } %>
  <% if(sub.refunded_at){ %><div class="notice notice--warn"><strong>Subscription refunded and cancelled.</strong> This inventory is read-only. Export your records before <%= helpers.dateTime(sub.refund_deletion_at) %>; its workspace data is scheduled for permanent deletion after 30 days. Required account payment receipts are retained.</div><% }else if(sub.source==='SELF_SERVICE_TRIAL'){ %><div class="notice notice--warn">Paid activation required. Your saved inventory is preserved.<% if(checkoutOpen){ %> <a href="/complete-signup">Choose a paid plan</a>.<% } %></div><% } %>
  <% if(sub.status==='GRACE'){ %><div class="notice notice--warn">Update your payment method before <%= helpers.dateTime(sub.grace_ends_at) %> to keep operations running.</div><% } %>
  <% const latestOffer=plans.find(p=>p.id===sub.plan_id);if(['starter','growth','pro'].includes(sub.plan_id)&&latestOffer?.active_plan_version_id&&sub.plan_version_id!==latestOffer.active_plan_version_id){ %><p class="notice" data-earlier-plan-terms>Your account uses earlier <%= sub.plan_name %> terms. Your accepted limits are shown here and stay in place until you approve a change. <a href="/billing/terms">Review the updated plan and allowances</a>.</p><% } %><% if(packs.some(p=>p.termsReviewRequired)){ %><p>Your saved plan terms stay in place. <a href="/billing/terms">Review the updated allowances and credit definition</a> to use the new AI packs.</p><% } %>
<% }else{ %><div class="ox-plan-now__main"><span class="ox-plan-now__eyebrow">Current plan</span><h3 id="plan-now-title">No subscription yet</h3><% if(checkoutOpen){ %><p>Choose a plan below to start.</p><% } %></div><a href="/pricing" class="ox-btn ox-btn--secondary ox-btn--sm">Compare plans</a><% } %>
<% if(!checkoutOpen){ %><p class="ox-plan-now__hint">Plan changes are paused. <a href="/support">Contact support</a> for help with your plan.</p><% } %>
</section>

<% if(checkoutOpen){ %>
<section class="ox-plans" aria-labelledby="plans-title"><div class="ox-plans__head"><h3 id="plans-title">Plans</h3>
  <% if(checkoutOpen&&sub?.stripe_subscription_id){ const alternate=interval==='annual'?'monthly':'annual'; %><a href="/billing/change?plan=<%= sub.plan_id %>&interval=<%= alternate %>">Change to <%= alternate %> billing</a><% } %></div>
  <p class="ox-plans__rule">Upgrades: you see the amount due today, pay it, and the new plan starts right away. Downgrades: no charge; the new plan starts when your current billing period ends.</p>
  <div class="ox-plans__grid">
  <% plans.forEach(function(p){ const isCurrent=p.id===sub?.plan_id,up=!currentPlan||Number(p.display_order)>Number(currentPlan.display_order),name=p.id==='enterprise'?'Custom':p.public_name,
       href=p.sales_only?'/contact?plan='+p.id:(sub?.stripe_subscription_id?'/billing/change':'/complete-signup')+'?plan='+p.id+'&interval='+interval; %>
    <article class="ox-plan<%= isCurrent?' is-current':'' %>">
      <h4><%= name %></h4>
      <p class="ox-plan__price"><% if(p.sales_only){ %>Custom pricing<% }else{ %><%= money(interval==='annual'?p.annual_amount_minor:p.monthly_amount_minor,p.currency) %><small>/<%= interval==='annual'?'year':'month' %></small><% } %></p>
      <ul class="ox-plan__limits"><% [['products','products'],['active_skus','SKUs'],['locations','locations per inventory'],['members','people'],['ai_work_credits','AI credits a month']].forEach(function(row){ const value=limit(p,row[0]);if(value){ %><li><b><%= value %></b> <%= row[1] %></li><% } }) %></ul>
      <% if(isCurrent){ %><span class="ox-plan__current">Your plan</span>
      <% }else{ %><a class="ox-btn <%= up?'ox-btn--primary':'ox-btn--secondary' %> ox-btn--block" href="<%= href %>" aria-label="<%= name %>" aria-describedby="plan-<%= p.id %>-what"><%= p.sales_only?'Contact us':!currentPlan?'Choose':up?'Upgrade':'Downgrade' %></a>
        <p class="ox-plan__what" id="plan-<%= p.id %>-what"><%= p.sales_only?'We set this up with you.':!sub?.stripe_subscription_id?'Secure checkout.':up?'Pay the difference today; starts now.':'No charge. Starts '+renews+'.' %></p>
        <% if(!p.sales_only&&interval==='monthly'){ %><a class="ox-plan__alt" href="<%= (sub?.stripe_subscription_id?'/billing/change':'/complete-signup')+'?plan='+p.id+'&interval=annual' %>"><%= p.public_name %> annual · <%= money(p.annual_amount_minor,p.currency) %>/year</a><% } %>
      <% } %>
    </article>
  <% }) %>
  </div>
</section>
<% } %>
</div>

<% if(checkoutOpen||sub?.stripe_subscription_id){ %><section class="rm-panel sc-guarantee"><h3>14-day money-back guarantee</h3>
<% if(locals.guarantee?.request){ const status=guarantee.request.status; %><p role="status"><strong><%= status==='REFUNDED'?'Stripe confirmed your refund.':status==='PENDING'?'Stripe is processing your refund.':status==='REVIEW'?'Your refund needs a billing check. StockChief will retry safely.':'Your cancellation and refund request is saved.' %></strong></p><p>Refresh this page to check progress. A confirmed refund returns to your original payment method; your bank may take several business days to show it. <a href="/support/request?topic=subscription-refund">Get refund help</a>.</p>
<% }else if(locals.guarantee?.eligible){ %><p>You can cancel now and receive a full refund of your subscription payments. Request by <strong><%= helpers.dateTime(guarantee.deadline) %></strong>. After Stripe confirms the refund, your records stay read-only for 30 days so you can export them.</p><form method="post" action="/billing/refund" class="stack"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><label><input type="checkbox" name="confirm" value="refund" required> Cancel my subscription now and refund my subscription payments.</label><button class="rm-btn rm-btn--secondary" type="submit">Cancel and refund</button></form>
<% }else{ %><p>Request a refund within 14 days of your first subscription payment. Cancelling renewal alone keeps access until the paid period ends and does not issue a refund. <a href="/support/request?topic=subscription-refund&amp;from=/settings/billing">Get refund help</a>.</p><% } %></section><% } %>
<% if(showAiStatus){ %><%- include('../partials/ai-spending-status') %><% } %>
<% const usageMeters=summary.meters.filter(m=>m.definition?.kind==='USAGE'&&m.definition.customerVisible),
   metered=usageMeters.filter(m=>m.remaining!==null),
   firstPeriodEnd=metered[0]?.periodEnd,
   sharedEnd=firstPeriodEnd&&metered.every(m=>m.periodEnd&&new Date(m.periodEnd).getTime()===new Date(firstPeriodEnd).getTime())?firstPeriodEnd:null; %>
<section class="rm-panel ox-billing-section" aria-labelledby="usage-packs">
  <div class="rm-panel__head ox-usage-heading">
    <div><h2 id="usage-packs">Monthly usage</h2><% if(sharedEnd&&(!privatePilot||new Date(sharedEnd).getTime()!==new Date(sub.current_period_end).getTime())){ %><p>Resets <%= helpers.dateTime(sharedEnd) %></p><% } %></div>
    <a href="/usage">Usage details</a>
  </div>
  <div class="ox-usage-grid">
    <% for(const warning of usageWarnings){ %>
      <div class="notice notice--warn"><%= warning.threshold %>% of included <%= warning.label %> used. <%= warning.threshold===100?'Purchased usage is used next. Optional processing pauses when no usage remains.':checkoutOpen?'You can add more or wait for your next reset.':'Check your current balance below.' %></div>
    <% } %>
    <% for(const meter of usageMeters){
      const availablePacks=checkoutOpen&&meter.remaining!==null?packs.filter(p=>p.category===meter.meter):[];
      const includedUsed=meter.includedUsed??meter.used??0;
      const remaining=meter.meter==='ai_work_credits'&&locals.aiCost?helpers.aiCustomerMeter(aiCost).usableCredits??meter.remaining:meter.remaining;
    %>
      <article class="ox-usage-card" data-usage-category="<%= meter.meter %>"<% if(!showAiStatus&&meter.meter==='ai_work_credits'){ %> aria-label="AI availability"<% } %>>
        <h3><%= meter.label %></h3>
        <% if(meter.remaining===null){ %>
          <p class="ox-usage-card__balance">Included under your accepted terms</p><p><%= number(meter.used) %> used this period</p>
        <% }else{ %>
          <p class="ox-usage-card__balance"><strong><%= number(remaining) %></strong> <%= meter.meter==='ai_work_credits'?'available':'remaining' %></p>
          <% if(Number(meter.included)>0){ %><progress aria-label="<%= meter.label %> used" max="<%= meter.included %>" value="<%= Math.min(includedUsed,meter.included) %>"></progress><% } %>
          <p><%= number(includedUsed) %> of <%= number(meter.included) %> included used</p>
          <% if(meter.purchasedRemaining>0||meter.reserved>0){ %><p><% if(meter.purchasedRemaining>0){ %><%= number(meter.purchasedRemaining) %> purchased remaining<% } %><% if(meter.purchasedRemaining>0&&meter.reserved>0){ %> · <% } %><% if(meter.reserved>0){ %><%= number(meter.reserved) %> in progress<% } %></p><% } %>
          <% if(!sharedEnd&&meter.periodEnd){ %><small>Resets <%= helpers.dateTime(meter.periodEnd) %></small><% } %>
        <% } %>
        <% if(availablePacks.length){ %><details><summary>Add more</summary>
          <% for(const pack of availablePacks){ %><form method="post" action="/billing/buy-more">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="purchaseKey" value="<%= purchaseKey %>:<%= pack.id %>"><input type="hidden" name="packId" value="<%= pack.id %>">
            <button data-pack="<%= pack.id %>" data-pack-amount-minor="<%= pack.amount_minor %>" class="rm-btn" <%= pack.purchasable?'':'disabled' %>>Buy <%= number(pack.units) %> — <%= money(pack.amount_minor,pack.currency) %></button>
          </form><% } %>
        </details><% } %>
        <% if(meter.rollover?.units){ %><p><%= number(meter.rollover.remaining) %> carried credits remaining · expires <%= helpers.dateTime(meter.rollover.expiresAt) %></p><% } %>
        <% if(meter.grants?.length){ %><details><summary>Purchased usage expiration</summary><% for(const grant of meter.grants){ %><p><%= number(grant.remaining) %> remaining · expires <%= helpers.dateTime(grant.expires_at) %><% if(Number(grant.dispute_hold_units)>0){ %> · <%= number(grant.dispute_hold_units) %> temporarily held while payment is disputed<% } %></p><% } %></details><% } %>
      </article>
    <% } %>
  </div>
</section>
<section class="rm-panel ox-billing-section" data-plan-capacity><div class="rm-panel__head"><h2>Your plan limits</h2></div><div style="padding:18px"><p>Items are products; each unique combination of option values is an active SKU. Location limits apply per inventory. The count below is the highest use across your inventories, matching the account-wide downgrade check. Import rows are the maximum rows in one file.</p><dl><% summary.meters.filter(m=>['products','active_skus','import_rows','workspaces','locations','members','scheduled_reports'].includes(m.meter)).forEach(m=>{ %><dt data-meter="<%= m.meter %>"><%= m.label %></dt><dd><%= m.hardLimit===null?'No configured limit':Number(m.hardLimit).toLocaleString('en-US') %><%= m.meter==='import_rows'?' per import':' · '+Number(m.used||0).toLocaleString('en-US')+(m.meter==='locations'?' used in your busiest inventory':' used') %><% if(m.meter==='locations'&&m.currentInventoryUsed!==undefined){ %> · <%= Number(m.currentInventoryUsed).toLocaleString('en-US') %> in this inventory<% } %></dd><% }); %></dl><details class="ox-more"><summary>Every limit and how it is counted</summary><div><% summary.meters.filter(m=>['STRUCTURAL','PER_OPERATION'].includes(m.definition?.kind)).forEach(function(m){const storage=m.meter==='storage_bytes',format=n=>storage?(Number(n)/1e9).toLocaleString('en-US',{maximumFractionDigits:3})+' GB':Number(n).toLocaleString('en-US'); %><p data-capacity-meter="<%= m.meter %>"><strong><%= m.label %>:</strong> <%= m.definition.kind==='STRUCTURAL'||['active_imports','agent_jobs'].includes(m.meter)?format(m.used)+' / ':'' %><%= m.hardLimit===null?'By contract':format(m.hardLimit) %><%= m.inventoryName?' · '+m.inventoryName:'' %><% if(storage&&m.reserved){ %> · <%= format(m.reserved) %> reserved for files and approved imports<% } %></p><% }); %><p>Storage totals are measured in the background. Files and approved imports reserve capacity until the next completed measurement. Everyday stock, sales and purchasing work stays available when storage is full.</p><p>A product may have many SKUs. Stock quantities do not use product or SKU capacity. People include pending invitations. Account limits are shared across inventories; warehouse, bin and role limits apply per inventory. Add-ons show their separate included capacities. Import row limits apply per source. Your accepted plan version is preserved until you approve a change.</p></div></details><p><a href="/pricing">Compare every plan and its allowances</a></p></div></section>
<% if(usageCheckoutOpen){ %><details class="rm-panel ox-billing-section"><summary class="rm-panel__head"><h2>Auto-top-up</h2></summary><div style="padding:18px"><p>Off by default. An enabled category buys your chosen pack when total remaining usage falls below 10% of its monthly included allowance. Each cap applies to this inventory and category, in a UTC calendar month. Pending charges count toward that cap. Failed payments require attention.</p>
<% summary.meters.filter(m=>m.remaining!==null&&['ai_work_credits','incoming_emails','emails_sent','connected_operations'].includes(m.meter)).map(m=>m.meter).forEach(function(category){var pref=topups.find(function(t){return t.category===category;});var choices=packs.filter(function(p){return p.category===category;}); %><form method="post" action="/billing/auto-top-up" style="margin-bottom:18px"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="category" value="<%= category %>"><h3><%= summary.meters.find(m=>m.meter===category)?.label||category %></h3><label class="rm-field"><span>Usage pack</span><select name="packId"><% choices.forEach(function(p){ %><option value="<%= p.id %>" <%= pref?.pack_id===p.id?'selected':'' %>><%= p.units %> for $<%= Number(p.amount_minor)/100 %></option><% }); %></select></label><label class="rm-field"><span>Monthly cap for this inventory/category (USD)</span><input type="number" min="0" step="0.01" name="monthlyCap" value="<%= Number(pref?.monthly_cap_minor||0)/100 %>"></label><label><input type="checkbox" name="enabled" value="1" <%= pref?.enabled?'checked':'' %> <%= checkoutOpen?'':'disabled' %>> Enable automatic purchases</label><p><label><input type="checkbox" name="consent" value="1"> I authorize off-session charges for this pack up to my monthly cap.</label></p><button class="rm-btn">Save auto-top-up</button></form><% }); %></div></details><% } %>
<% if(checkoutOpen||capacityOrders.length){ %><details class="rm-panel ox-billing-section"><summary class="rm-panel__head"><h2>Extra capacity</h2></summary><div style="padding:18px"><p>Warehouse and bin limits apply separately to each inventory, including paid extra inventories. Warehouse bundles apply to the inventory selected in this browser tab. Monthly add-ons are billed separately from your main plan, including when your main plan is annual. Paid capacity becomes available after payment confirmation.</p><% if(checkoutOpen)for(const p of capacityProducts){const unlimited=summary.meters.find(m=>m.meter===p.meter)?.hardLimit===null; const awaitingReview=p.awaiting_ai_review; %><form method="post" action="/billing/capacity"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="productId" value="<%= p.id %>"><input type="hidden" name="purchaseKey" value="<%= purchaseKey %>:<%= p.id %>"><label class="rm-field"><span><%= p.label %> — $<%= Number(p.monthly_amount_minor)/100 %>/month each</span><input type="number" name="quantity" value="1" min="1" max="1000" required></label><button class="rm-btn" <%= checkoutOpen&&p.stripe_price_id&&!awaitingReview&&!unlimited&&summary.subscription?.stripe_customer_id?'':'disabled' %>><%= unlimited?'Included under your contract':awaitingReview?'Awaiting usage cost review':'Review secure checkout' %></button></form><% } %><% for(const o of capacityOrders){ %><p><%= o.quantity %> × <%= o.label %> · <%= o.status==='ACTIVE'?(o.cancel_at_period_end?'This add-on ends on ':'Paid through ')+helpers.dateTime(o.paid_through):o.status==='PENDING'?'Awaiting payment':'Cancelled' %></p><% if(o.stripe_subscription_id&&o.status!=='CANCELLED'&&!o.cancel_at_period_end){ %><form method="post" action="/billing/capacity/<%= o.id %>/cancel"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="rm-btn rm-btn--ghost">Cancel this add-on at renewal</button></form><% } %><% } %></div></details><% } %>
<section class="rm-panel ox-billing-section"><div class="rm-panel__head"><h2>Billing history</h2></div><div style="padding:18px"><% if(!invoices.length&&!purchases.length){ %><p>No billing documents yet.</p><% } %><% invoices.forEach(function(i){ %><p><%= i.number||i.id %> · <%= i.status %> · <%= (Number(i.amount_paid||0)/100).toLocaleString('en-US',{style:'currency',currency:(i.currency||'usd').toUpperCase()}) %><% if(i.hosted_invoice_url){ %> · <a href="<%= i.hosted_invoice_url %>" rel="noopener">View invoice</a><% } %></p><% }); %><% purchases.forEach(function(p){ %><p><%= helpers.dateTime(p.created_at) %> · <%= p.units %> <%= ({ai_work_credits:'AI credits',incoming_emails:'Incoming emails',emails_sent:'Outgoing recipients',connected_operations:'Connected Operations'}[p.category]||p.category) %> · <%= p.status %> · $<%= Number(p.amount_minor)/100 %><%= p.kind==='AUTO'?' · Auto-top-up':'' %></p><% }); %></div></section>
</div></div>
