<header class="rm-head"><h1>Settings</h1><p>Manage your business, team and StockChief preferences.</p></header>
<div class="sc-settings-layout"><%- include('../settings/navigation',{section:'billing',sections:searchableSettingsSections}) %><div class="sc-settings-content" data-settings-section="billing"><h2>Plan &amp; billing</h2><p>Your subscription, monthly allowances and billing history.</p>
<%- include('../partials/ai-spending-status') %>
<% if(locals.scheduleUnavailable){ %><p class="notice notice--warn">We could not refresh your scheduled plan change. Check the date in Stripe using Manage plan and payment below, or try again shortly.</p><% } %>
<% for(const change of pendingChanges){ %><aside class="notice <%= Object.keys(change.excess||{}).length?'notice--danger':'notice--warn' %>" role="status" data-scheduled-plan-change><strong><% if(new Date(change.effective_at)>new Date()){ %>Your plan changes to <%= change.target_plan_name %> on <%= helpers.dateTime(change.effective_at) %>.<% }else{ const due=change.request_quote?.amountDueMinor??change.proration_amount_minor; %><span data-upgrade-pending>Taking payment<%= due===null||due===undefined?'':' of '+(Number(due)/100).toLocaleString('en-US',{style:'currency',currency:change.request_quote?.target?.currency||'USD'}) %> for <%= change.target_plan_name %>. Your current plan stays active until the payment goes through.</span><% } %></strong><% if(Object.keys(change.excess||{}).length){ %><p>Your account currently exceeds this plan’s limits:</p><ul><% for(const value of Object.values(change.excess)){ %><li><%= value.label %>: <%= Number(value.used).toLocaleString('en-US') %> used; <%= Number(value.allowed).toLocaleString('en-US') %> allowed.</li><% } %></ul><p>This change is still scheduled in billing. Existing records will be preserved, but new records and features will be limited by the lower plan from that date. Reduce usage before then, or open Manage plan and payment in Stripe to keep a plan that covers your account. <a href="/support">Contact support</a> if you need help.</p><% }else{ %><p>Current plan access continues until the change date. Features and limits switch after Stripe confirms the change and any required payment.</p><% } %></aside><% } %>
<% if(locals.upgradeOutcome){ const paid=upgradeOutcome.status==='APPLIED',amount=upgradeOutcome.amountMinor===null||upgradeOutcome.amountMinor===undefined?'':(Number(upgradeOutcome.amountMinor)/100).toLocaleString('en-US',{style:'currency',currency:upgradeOutcome.currency}); %><div class="notice <%= paid?'notice--ok':'notice--warn' %>" role="status" data-upgrade-outcome><strong><%= paid?'Paid'+(amount?' '+amount:'')+'. You’re now on '+upgradeOutcome.plan+'.':'Your upgrade to '+upgradeOutcome.plan+' did not go through.' %></strong><% if(!paid){ %> Your current plan is unchanged. Check your payment method, then try again.<% } %></div><% } %>
<script>(()=>{if(!document.querySelector('[data-upgrade-pending]'))return;let n=0;try{n=Number(sessionStorage.getItem('upgradeChecks')||0);}catch{}if(n>=40)return;try{sessionStorage.setItem('upgradeChecks',String(n+1));}catch{}setTimeout(()=>location.reload(),3000);})();try{if(!document.querySelector('[data-upgrade-pending]'))sessionStorage.removeItem('upgradeChecks');}catch{}</script>
<% if(!checkoutOpen){ %><div class="notice notice--warn">Plan changes are paused right now. Please <a href="/support">contact support</a>. <%= 'Existing records are preserved. New subscriptions require payment and include a 14-day money-back guarantee.' %></div><% } %>
<link rel="stylesheet" href="/orders-ui.css?v=<%= locals.assetVersion||'current' %>">
<% const sub=summary.subscription,currentPlan=plans.find(p=>p.id===sub?.plan_id),interval=sub?.billing_interval==='ANNUAL'?'annual':'monthly',
   money=(minor,currency)=>(Number(minor||0)/100).toLocaleString('en-US',{style:'currency',currency:currency||'USD',maximumFractionDigits:Number(minor)%100?2:0}),
   limit=(p,meter)=>{const row=(p.meters||[]).find(m=>m.meter===meter);if(!row)return null;const value=row.hard_limit??row.included_units;return value===null||value===undefined?'Unlimited':Number(value).toLocaleString('en-US');},
   renews=sub?.current_period_end?helpers.dateTime(sub.current_period_end):'the end of this billing period'; %>
<div class="ox ox-billing">
<section class="ox-card ox-plan-now" aria-labelledby="plan-now-title">
<% if(sub){ %>
  <div class="ox-plan-now__main"><span class="ox-plan-now__eyebrow">Current plan</span><h3 id="plan-now-title"><%= sub.plan_name %><% if(currentPlan&&!currentPlan.sales_only){ %> <small><%= money(interval==='annual'?currentPlan.annual_amount_minor:currentPlan.monthly_amount_minor,currentPlan.currency) %>/<%= interval==='annual'?'year':'month' %></small><% } %></h3>
    <p><%= sub.status==='COMP'?'Complimentary':sub.status.replaceAll('_',' ').toLowerCase() %><% if(sub.current_period_end&&!sub.refunded_at&&sub.source!=='SELF_SERVICE_TRIAL'){ %> · <%= sub.status==='TRIALING'?'Trial ends':sub.cancel_at_period_end?'Your plan ends on':pendingChanges.some(c=>new Date(c.effective_at)>new Date())?'Current billing period ends':'Renews' %> <%= helpers.dateTime(sub.current_period_end) %><% } %></p></div>
  <div class="ox-plan-now__actions">
    <% if(sub.stripe_customer_id){ %><form method="post" action="/billing/portal"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="ox-btn ox-btn--secondary ox-btn--sm"><%= locals.planPortal?'Payment method and invoices':'Update payment method' %></button></form><% } %>
    <% if(sub.stripe_subscription_id&&!sub.refunded_at){ %><form method="post" action="/billing/<%= sub.cancel_at_period_end?'reactivate':'cancel' %>"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="ox-btn ox-btn--ghost ox-btn--sm"><%= sub.cancel_at_period_end?'Keep my subscription':'Cancel at renewal' %></button></form><% } %>
  </div>
  <% if(sub.refunded_at){ %><div class="notice notice--warn"><strong>Subscription refunded and cancelled.</strong> This inventory is read-only. Export your records before <%= helpers.dateTime(sub.refund_deletion_at) %>; its workspace data is scheduled for permanent deletion after 30 days. Required account payment receipts are retained.</div><% }else if(sub.source==='SELF_SERVICE_TRIAL'){ %><div class="notice notice--warn">Paid activation required. Your saved inventory is preserved. <a href="/complete-signup">Choose a paid plan</a>.</div><% } %>
  <% if(sub.status==='GRACE'){ %><div class="notice notice--warn">Update your payment method before <%= helpers.dateTime(sub.grace_ends_at) %> to keep operations running.</div><% } %>
  <% const latestOffer=plans.find(p=>p.id===sub.plan_id);if(['starter','growth','pro'].includes(sub.plan_id)&&latestOffer?.active_plan_version_id&&sub.plan_version_id!==latestOffer.active_plan_version_id){ %><p class="notice" data-earlier-plan-terms>Your account uses earlier <%= sub.plan_name %> terms. Your accepted limits are shown here and stay in place until you approve a change. <a href="/billing/terms">Review the updated plan and allowances</a>.</p><% } %><% if(packs.some(p=>p.termsReviewRequired)){ %><p>Your saved plan terms stay in place. <a href="/billing/terms">Review the updated allowances and credit definition</a> to use the new AI packs.</p><% } %>
<% }else{ %><div class="ox-plan-now__main"><span class="ox-plan-now__eyebrow">Current plan</span><h3 id="plan-now-title">No subscription yet</h3><p>Choose a plan below to start.</p></div><a href="/pricing" class="ox-btn ox-btn--secondary ox-btn--sm">Compare plans</a><% } %>
</section>

<section class="ox-plans" aria-labelledby="plans-title"><div class="ox-plans__head"><h3 id="plans-title">Plans</h3>
  <% if(checkoutOpen&&sub?.stripe_subscription_id){ const alternate=interval==='annual'?'monthly':'annual'; %><a href="/billing/change?plan=<%= sub.plan_id %>&interval=<%= alternate %>">Change to <%= alternate %> billing</a><% } %></div>
  <p class="ox-plans__rule">Upgrades: you see the amount due today, pay it, and the new plan starts right away. Downgrades: no charge; the new plan starts when your current billing period ends.</p>
  <div class="ox-plans__grid">
  <% plans.forEach(function(p){ const isCurrent=p.id===sub?.plan_id,up=!currentPlan||Number(p.display_order)>Number(currentPlan.display_order),name=p.id==='enterprise'?'Custom':p.public_name,
       href=p.sales_only?'/contact?plan='+p.id:(sub?.stripe_subscription_id?'/billing/change':'/complete-signup')+'?plan='+p.id+'&interval='+interval; %>
    <article class="ox-plan<%= isCurrent?' is-current':'' %>">
      <h4><%= name %></h4>
      <p class="ox-plan__price"><% if(p.sales_only){ %>Custom pricing<% }else{ %><%= money(interval==='annual'?p.annual_amount_minor:p.monthly_amount_minor,p.currency) %><small>/<%= interval==='annual'?'year':'month' %></small><% } %></p>
      <ul class="ox-plan__limits"><% [['products','products'],['active_skus','SKUs'],['locations','locations per inventory'],['members','people'],['ai_work_credits','AI credits a month']].forEach(function(row){ const value=limit(p,row[0]);if(value){ %><li><b><%= value %></b> <%= row[1] %></li><% } }) %></ul>
      <% if(isCurrent){ %><span class="ox-plan__current">Your plan</span>
      <% }else{ %><a class="ox-btn <%= up?'ox-btn--primary':'ox-btn--secondary' %> ox-btn--block" href="<%= href %>" aria-label="<%= name %>" aria-describedby="plan-<%= p.id %>-what"><%= p.sales_only?'Contact us':!currentPlan?'Choose':up?'Upgrade':'Downgrade' %></a>
        <p class="ox-plan__what" id="plan-<%= p.id %>-what"><%= p.sales_only?'We set this up with you.':!sub?.stripe_subscription_id?'Secure checkout.':up?'Pay the difference today; starts now.':'No charge. Starts '+renews+'.' %></p>
        <% if(!p.sales_only&&interval==='monthly'){ %><a class="ox-plan__alt" href="<%= (sub?.stripe_subscription_id?'/billing/change':'/complete-signup')+'?plan='+p.id+'&interval=annual' %>"><%= p.public_name %> annual · <%= money(p.annual_amount_minor,p.currency) %>/year</a><% } %>
      <% } %>
    </article>
  <% }) %>
  </div>
</section>
</div>

<p class="ox-billing-note">New subscriptions include a 14-day money-back guarantee. <a href="/support?topic=subscription-refund">Request a refund</a> within 14 days of your first payment. A successful subscription refund cancels renewal and starts the 30-day read-only retention period.</p>
<section class="rm-panel ox-billing-section"><div class="rm-panel__head"><h2 id="usage-packs">Monthly usage</h2></div><div style="padding:18px">
<% usageWarnings.forEach(function(w){ %><div class="notice notice--warn"><%= w.threshold %>% of included <%= w.label %> used. <%= w.threshold===100?'Purchased usage is used next. Optional processing pauses when no usage remains.':'Buy more, upgrade, or wait for your next monthly reset.' %></div><% }); %>
<% summary.meters.filter(function(m){return m.definition?.kind==='USAGE'&&m.definition.customerVisible;}).forEach(function(m){ %><article style="margin-bottom:20px" data-usage-category="<%= m.meter %>"><h3><%= m.label %></h3><% if(m.remaining===null){ %><p><strong>Included under your accepted terms</strong> · <%= Number(m.used||0).toLocaleString('en-US') %> used this period</p><% }else{ %><p><%= m.includedUsed??m.used??0 %> of <%= m.included??'contract' %> included · <%= m.includedRemaining??m.remaining??'contract' %> included remaining</p><p><%= m.purchasedRemaining||0 %> purchased remaining · <strong><%= m.meter==='ai_work_credits'&&locals.aiCost?helpers.aiCustomerMeter(aiCost).usableCredits||0:m.remaining??'contract' %> <%= m.meter==='ai_work_credits'?'available for AI work':'total remaining' %></strong><%= m.reserved?' · '+m.reserved+' in progress':'' %></p><small>Resets <%= m.periodEnd?helpers.dateTime(m.periodEnd):'monthly' %></small><% } %>
<% if(m.remaining!==null){ %><details><summary>Add more</summary><% packs.filter(function(p){return p.category===m.meter;}).forEach(function(p){ %><form method="post" action="/billing/buy-more" style="margin:10px 0"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="purchaseKey" value="<%= purchaseKey %>:<%= p.id %>"><input type="hidden" name="packId" value="<%= p.id %>"><button data-pack="<%= p.id %>" data-pack-amount-minor="<%= p.amount_minor %>" class="rm-btn" <%= checkoutOpen&&p.purchasable?'':'disabled' %>>Buy <%= Number(p.units).toLocaleString() %> — <%= (Number(p.amount_minor)/100).toLocaleString('en-US',{style:'currency',currency:p.currency}) %></button></form><% }); %></details><% }else{ %><p>Your accepted terms have no separate count limit for this category. No additional pack is needed.</p><% } %>
<% if(m.rollover?.units){ %><p><%= m.rollover.remaining %> carried credits remaining · expires <%= helpers.dateTime(m.rollover.expiresAt) %></p><% } %>
<% if(m.grants?.length){ %><details><summary>Purchased usage expiration</summary><% m.grants.forEach(function(g){ %><p><%= g.remaining %> remaining · expires <%= helpers.dateTime(g.expires_at) %><% if(Number(g.dispute_hold_units)>0){ %> · <%= g.dispute_hold_units %> temporarily held while payment is disputed<% } %></p><% }); %></details><% } %>
</article><% }); %></div></section>
<section class="rm-panel ox-billing-section" data-plan-capacity><div class="rm-panel__head"><h2>Your plan limits</h2></div><div style="padding:18px"><p>Items are products; each unique combination of option values is an active SKU. Location limits apply per inventory. The count below is the highest use across your inventories, matching the account-wide downgrade check. Import rows are the maximum rows in one file.</p><dl><% summary.meters.filter(m=>['products','active_skus','import_rows','workspaces','locations','members','scheduled_reports'].includes(m.meter)).forEach(m=>{ %><dt data-meter="<%= m.meter %>"><%= m.label %></dt><dd><%= m.hardLimit===null?'No configured limit':Number(m.hardLimit).toLocaleString('en-US') %><%= m.meter==='import_rows'?' per import':' · '+Number(m.used||0).toLocaleString('en-US')+(m.meter==='locations'?' used in your busiest inventory':' used') %><% if(m.meter==='locations'&&m.currentInventoryUsed!==undefined){ %> · <%= Number(m.currentInventoryUsed).toLocaleString('en-US') %> in this inventory<% } %></dd><% }); %></dl><details class="ox-more"><summary>Every limit and how it is counted</summary><div><% summary.meters.filter(m=>['STRUCTURAL','PER_OPERATION'].includes(m.definition?.kind)).forEach(function(m){const storage=m.meter==='storage_bytes',format=n=>storage?(Number(n)/1e9).toLocaleString('en-US',{maximumFractionDigits:3})+' GB':Number(n).toLocaleString('en-US'); %><p data-capacity-meter="<%= m.meter %>"><strong><%= m.label %>:</strong> <%= m.definition.kind==='STRUCTURAL'||['active_imports','agent_jobs'].includes(m.meter)?format(m.used)+' / ':'' %><%= m.hardLimit===null?'By contract':format(m.hardLimit) %><%= m.inventoryName?' · '+m.inventoryName:'' %></p><% }); %><p>A product may have many SKUs. Stock quantities do not use product or SKU capacity. People include pending invitations. Account limits are shared across inventories; warehouse, bin and role limits apply per inventory. Add-ons show their separate included capacities. Import row limits apply per source. Your accepted plan version is preserved until you approve a change.</p></div></details><p><a href="/pricing">Compare every plan and its allowances</a></p></div></section>
<% if(usageCheckoutOpen){ %><details class="rm-panel ox-billing-section"><summary class="rm-panel__head"><h2>Auto-top-up</h2></summary><div style="padding:18px"><p>Off by default. An enabled category buys your chosen pack when total remaining usage falls below 10% of its monthly included allowance. Each cap applies to this inventory and category, in a UTC calendar month. Pending charges count toward that cap. Failed payments require attention.</p>
<% summary.meters.filter(m=>m.remaining!==null&&['ai_work_credits','incoming_emails','emails_sent','connected_operations'].includes(m.meter)).map(m=>m.meter).forEach(function(category){var pref=topups.find(function(t){return t.category===category;});var choices=packs.filter(function(p){return p.category===category;}); %><form method="post" action="/billing/auto-top-up" style="margin-bottom:18px"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="category" value="<%= category %>"><h3><%= summary.meters.find(m=>m.meter===category)?.label||category %></h3><label class="rm-field"><span>Usage pack</span><select name="packId"><% choices.forEach(function(p){ %><option value="<%= p.id %>" <%= pref?.pack_id===p.id?'selected':'' %>><%= p.units %> for $<%= Number(p.amount_minor)/100 %></option><% }); %></select></label><label class="rm-field"><span>Monthly cap for this inventory/category (USD)</span><input type="number" min="0" step="0.01" name="monthlyCap" value="<%= Number(pref?.monthly_cap_minor||0)/100 %>"></label><label><input type="checkbox" name="enabled" value="1" <%= pref?.enabled?'checked':'' %> <%= checkoutOpen?'':'disabled' %>> Enable automatic purchases</label><p><label><input type="checkbox" name="consent" value="1"> I authorize off-session charges for this pack up to my monthly cap.</label></p><button class="rm-btn">Save auto-top-up</button></form><% }); %></div></details><% } %>
<details class="rm-panel ox-billing-section"><summary class="rm-panel__head"><h2>Extra capacity</h2></summary><div style="padding:18px"><p>Warehouse and bin limits apply separately to each inventory, including paid extra inventories. Warehouse bundles apply to the inventory selected in this browser tab. Monthly add-ons are billed separately from your main plan, including when your main plan is annual. Paid capacity becomes available after payment confirmation.</p><% for(const p of capacityProducts){const unlimited=summary.meters.find(m=>m.meter===p.meter)?.hardLimit===null; %><form method="post" action="/billing/capacity"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="productId" value="<%= p.id %>"><input type="hidden" name="purchaseKey" value="<%= purchaseKey %>:<%= p.id %>"><label class="rm-field"><span><%= p.label %> — $<%= Number(p.monthly_amount_minor)/100 %>/month each</span><input type="number" name="quantity" value="1" min="1" max="1000" required></label><button class="rm-btn" <%= checkoutOpen&&p.stripe_price_id&&!unlimited&&summary.subscription?.stripe_customer_id?'':'disabled' %>><%= unlimited?'Included under your contract':'Review secure checkout' %></button></form><% } %><% for(const o of capacityOrders){ %><p><%= o.quantity %> × <%= o.label %> · <%= o.status==='ACTIVE'?(o.cancel_at_period_end?'This add-on ends on ':'Paid through ')+helpers.dateTime(o.paid_through):o.status==='PENDING'?'Awaiting payment':'Cancelled' %></p><% if(o.stripe_subscription_id&&o.status!=='CANCELLED'&&!o.cancel_at_period_end){ %><form method="post" action="/billing/capacity/<%= o.id %>/cancel"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="rm-btn rm-btn--ghost">Cancel this add-on at renewal</button></form><% } %><% } %></div></details>
<section class="rm-panel ox-billing-section"><div class="rm-panel__head"><h2>Billing history</h2></div><div style="padding:18px"><% if(!invoices.length&&!purchases.length){ %><p>No billing documents yet.</p><% } %><% invoices.forEach(function(i){ %><p><%= i.number||i.id %> · <%= i.status %> · <%= (Number(i.amount_paid||0)/100).toLocaleString('en-US',{style:'currency',currency:(i.currency||'usd').toUpperCase()}) %><% if(i.hosted_invoice_url){ %> · <a href="<%= i.hosted_invoice_url %>" rel="noopener">View invoice</a><% } %></p><% }); %><% purchases.forEach(function(p){ %><p><%= helpers.dateTime(p.created_at) %> · <%= p.units %> <%= ({ai_work_credits:'AI credits',incoming_emails:'Incoming emails',emails_sent:'Outgoing recipients',connected_operations:'Connected Operations'}[p.category]||p.category) %> · <%= p.status %> · $<%= Number(p.amount_minor)/100 %><%= p.kind==='AUTO'?' · Auto-top-up':'' %></p><% }); %></div></section>
</div></div>
