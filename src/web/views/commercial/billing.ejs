<header class="rm-head"><h1>Settings</h1><p>Manage your business, team and StockChief preferences.</p></header>
<div class="sc-settings-layout"><%- include('../settings/navigation',{section:'billing',sections:searchableSettingsSections}) %><div class="sc-settings-content" data-settings-section="billing"><h2>Plan &amp; billing</h2><p>Your subscription, monthly allowances and billing history.</p>
<%- include('../partials/ai-spending-status') %>
<section class="rm-panel"><div class="rm-panel__head"><h3>Inventory capacity</h3></div><div style="padding:18px"><% summary.meters.filter(m=>['active_skus','import_rows'].includes(m.meter)).forEach(function(m){ %><p><strong><%= m.label %>:</strong> <%= m.meter==='active_skus'?Number(m.used).toLocaleString()+' / ':'' %><%= m.hardLimit===null?'By contract':Number(m.hardLimit).toLocaleString() %></p><% }); %><p>Each active variant counts as one SKU. SKU capacity is shared across inventories. Product add-ons increase product and SKU capacity by the same amount. Import row limits apply separately to each source.</p></div></section>
<% if(!checkoutOpen){ %><div class="notice notice--warn">New paid subscriptions are unavailable here. <%= 'Existing records are preserved. New subscriptions require payment and include a 14-day money-back guarantee.' %></div><% } %>
<div class="rm-grid"><section class="rm-panel"><div class="rm-panel__head"><h2>Current plan</h2></div><div style="padding:18px">
<% if(summary.subscription){var sub=summary.subscription; %><% if(sub.refunded_at){ %><div class="notice notice--warn"><strong>Subscription refunded and cancelled.</strong> This inventory is read-only. Export your records before <%= helpers.dateTime(sub.refund_deletion_at) %>; its workspace data is scheduled for permanent deletion after 30 days. Required account payment receipts are retained.</div><% }else if(sub.source==='SELF_SERVICE_TRIAL'){ %><div class="notice notice--warn">Paid activation required. Your saved inventory is preserved. <a href="/complete-signup">Choose a paid plan</a>.</div><% } %><h3><%= sub.plan_name %></h3><% if(packs.some(p=>p.termsReviewRequired)){ %><p>Your saved plan terms stay in place. <a href="/billing/terms">Review the updated allowances and credit definition</a> to use the new AI packs.</p><% } %><p><%= sub.status==='COMP'?'Complimentary':sub.status.replaceAll('_',' ').toLowerCase() %></p>
<% if(sub.current_period_end&&!sub.refunded_at&&sub.source!=='SELF_SERVICE_TRIAL'){ %><p><%= sub.status==='TRIALING'?'Trial ends':sub.cancel_at_period_end?'Access through':'Renews' %> <%= helpers.dateTime(sub.current_period_end) %></p><% } %>
<% if(sub.status==='GRACE'){ %><div class="notice notice--warn">Update your payment method before <%= helpers.dateTime(sub.grace_ends_at) %> to keep operations running.</div><% } %>
<% if(sub.stripe_customer_id){ %><form method="post" action="/billing/portal"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="rm-btn">Update payment method</button></form><% } %>
<% if(sub.stripe_subscription_id&&!sub.refunded_at){ %><form method="post" action="/billing/<%= sub.cancel_at_period_end?'reactivate':'cancel' %>"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="rm-btn rm-btn--ghost"><%= sub.cancel_at_period_end?'Keep my subscription':'Cancel at renewal' %></button></form><% } %>
<% }else{ %><p>No subscription yet.</p><a href="/pricing" class="rm-btn">Compare plans</a><% } %>
<p>New subscriptions include a 14-day money-back guarantee. <a href="/support?topic=subscription-refund">Request a refund</a> within 14 days of your first payment. A successful subscription refund cancels renewal and starts the 30-day read-only retention period.</p></div></section><section class="rm-panel"><div class="rm-panel__head"><h2 id="usage-packs">Monthly usage</h2></div><div style="padding:18px">
<% usageWarnings.forEach(function(w){ %><div class="notice notice--warn"><%= w.threshold %>% of included <%= w.label %> used. <%= w.threshold===100?'Purchased usage is used next. Optional processing pauses when no usage remains.':'Buy more, upgrade, or wait for your next monthly reset.' %></div><% }); %>
<% summary.meters.filter(function(m){return m.definition?.kind==='USAGE'&&m.definition.customerVisible;}).forEach(function(m){ %><article style="margin-bottom:20px" data-usage-category="<%= m.meter %>"><h3><%= m.label %></h3><p><%= m.includedUsed||0 %> of <%= m.included||0 %> included · <%= m.includedRemaining||0 %> included remaining</p><p><%= m.purchasedRemaining||0 %> purchased remaining · <strong><%= m.meter==='ai_work_credits'&&locals.aiCost?helpers.aiCustomerMeter(aiCost).usableCredits||0:m.remaining||0 %> <%= m.meter==='ai_work_credits'?'available for AI work':'total remaining' %></strong><%= m.reserved?' · '+m.reserved+' in progress':'' %></p><small>Resets <%= m.periodEnd?helpers.dateTime(m.periodEnd):'monthly' %></small>
<details><summary>Add more</summary><% packs.filter(function(p){return p.category===m.meter;}).forEach(function(p){ %><form method="post" action="/billing/buy-more" style="margin:10px 0"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="purchaseKey" value="<%= purchaseKey %>:<%= p.id %>"><input type="hidden" name="packId" value="<%= p.id %>"><button data-pack="<%= p.id %>" data-pack-amount-minor="<%= p.amount_minor %>" class="rm-btn" <%= checkoutOpen&&p.purchasable?'':'disabled' %>>Buy <%= Number(p.units).toLocaleString() %> — <%= (Number(p.amount_minor)/100).toLocaleString('en-US',{style:'currency',currency:p.currency}) %></button></form><% }); %></details>
<% if(m.rollover?.units){ %><p><%= m.rollover.remaining %> carried credits remaining · expires <%= helpers.dateTime(m.rollover.expiresAt) %></p><% } %>
<% if(m.grants?.length){ %><details><summary>Purchased usage expiration</summary><% m.grants.forEach(function(g){ %><p><%= g.remaining %> remaining · expires <%= helpers.dateTime(g.expires_at) %><% if(Number(g.dispute_hold_units)>0){ %> · <%= g.dispute_hold_units %> temporarily held while payment is disputed<% } %></p><% }); %></details><% } %>
</article><% }); %></div></section></div>
<% if(usageCheckoutOpen){ %><section class="rm-panel" style="margin-top:18px"><div class="rm-panel__head"><h2>Auto-top-up</h2></div><div style="padding:18px"><p>Off by default. An enabled category buys your chosen pack when total remaining usage falls below 10% of its monthly included allowance. Each cap applies to this inventory and category, in a UTC calendar month. Pending charges count toward that cap. Failed payments require attention.</p>
<% ['ai_work_credits','emails_sent'].forEach(function(category){var pref=topups.find(function(t){return t.category===category;});var choices=packs.filter(function(p){return p.category===category;}); %><form method="post" action="/billing/auto-top-up" style="margin-bottom:18px"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="category" value="<%= category %>"><h3><%= category==='ai_work_credits'?'AI credits':'Emails sent' %></h3><label class="rm-field"><span>Usage pack</span><select name="packId"><% choices.forEach(function(p){ %><option value="<%= p.id %>" <%= pref?.pack_id===p.id?'selected':'' %>><%= p.units %> for $<%= Number(p.amount_minor)/100 %></option><% }); %></select></label><label class="rm-field"><span>Monthly cap for this inventory/category (USD)</span><input type="number" min="0" step="0.01" name="monthlyCap" value="<%= Number(pref?.monthly_cap_minor||0)/100 %>"></label><label><input type="checkbox" name="enabled" value="1" <%= pref?.enabled?'checked':'' %> <%= checkoutOpen?'':'disabled' %>> Enable automatic purchases</label><p><label><input type="checkbox" name="consent" value="1"> I authorize off-session charges for this pack up to my monthly cap.</label></p><button class="rm-btn">Save auto-top-up</button></form><% }); %></div></section><% } %>
<section class="rm-panel" style="margin-top:18px"><div class="rm-panel__head"><h2>Upgrade or change plan</h2></div><div style="padding:18px"><% plans.forEach(function(p){if(p.id===summary.subscription?.plan_id)return; %><p><a href="<%= p.sales_only?'/contact?plan='+p.id:summary.subscription?.stripe_subscription_id?'/billing/change?plan='+p.id+'&interval=monthly':'/complete-signup?plan='+p.id+'&interval=monthly' %>"><%= p.id==='enterprise'?'Custom':p.public_name %></a></p><% }); %><% pendingChanges.forEach(function(c){ %><p><%= c.target_plan_name %> scheduled for <%= helpers.dateTime(c.effective_at) %>.</p><% }); %></div></section>
<section class="rm-panel" style="margin-top:18px"><div class="rm-panel__head"><h2>Extra capacity</h2></div><div style="padding:18px"><p>Monthly add-ons are billed separately from your main plan, including when your main plan is annual. Paid capacity becomes available after payment confirmation.</p><% for(const p of capacityProducts){const unlimited=summary.meters.find(m=>m.meter===p.meter)?.hardLimit===null; %><form method="post" action="/billing/capacity"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="productId" value="<%= p.id %>"><input type="hidden" name="purchaseKey" value="<%= purchaseKey %>:<%= p.id %>"><label class="rm-field"><span><%= p.label %> — $<%= Number(p.monthly_amount_minor)/100 %>/month each</span><input type="number" name="quantity" value="1" min="1" max="1000" required></label><button class="rm-btn" <%= checkoutOpen&&p.stripe_price_id&&!unlimited&&summary.subscription?.stripe_customer_id?'':'disabled' %>><%= unlimited?'Included without a limit':'Review secure checkout' %></button></form><% } %><% for(const o of capacityOrders){ %><p><%= o.quantity %> × <%= o.label %> · <%= o.status==='ACTIVE'?'Paid through '+helpers.dateTime(o.paid_through):o.status==='PENDING'?'Awaiting payment':'Cancelled' %></p><% if(o.stripe_subscription_id&&o.status!=='CANCELLED'&&!o.cancel_at_period_end){ %><form method="post" action="/billing/capacity/<%= o.id %>/cancel"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="rm-btn rm-btn--ghost">Cancel this add-on at renewal</button></form><% } %><% } %></div></section>
<section class="rm-panel" style="margin-top:18px"><div class="rm-panel__head"><h2>Billing history</h2></div><div style="padding:18px"><% if(!invoices.length&&!purchases.length){ %><p>No billing documents yet.</p><% } %><% invoices.forEach(function(i){ %><p><%= i.number||i.id %> · <%= i.status %> · <%= (Number(i.amount_paid||0)/100).toLocaleString('en-US',{style:'currency',currency:(i.currency||'usd').toUpperCase()}) %><% if(i.hosted_invoice_url){ %> · <a href="<%= i.hosted_invoice_url %>" rel="noopener">View invoice</a><% } %></p><% }); %><% purchases.forEach(function(p){ %><p><%= helpers.dateTime(p.created_at) %> · <%= p.units %> <%= p.category==='ai_work_credits'?'AI credits':p.category==='emails_sent'?'Emails sent':'Connected operations' %> · <%= p.status %> · $<%= Number(p.amount_minor)/100 %><%= p.kind==='AUTO'?' · Auto-top-up':'' %></p><% }); %></div></section>

</div></div>
