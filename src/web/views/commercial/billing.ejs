<div class="rm-head"><div><span class="rm-eyebrow">ACCOUNT</span><h1>Plan and billing</h1><p>Your subscription controls commercial access. Your inventory records remain yours in every billing state.</p></div></div>
<div class="rm-grid rm-grid--2">
  <section class="rm-panel"><div class="rm-panel__head"><h2>Current plan</h2><span class="right"><span class="rm-pillbadge <%= summary.access.canOperate ? 'is-ok' : 'is-warn' %>"><%= summary.subscription ? summary.subscription.status.replaceAll('_',' ') : 'Not subscribed' %></span></span></div><div style="padding:20px">
    <% if(summary.subscription){ %><h3 style="font-size:28px;margin:0"><%= summary.subscription.plan_name %></h3><p><%= summary.subscription.plan_outcome %></p>
      <% if(summary.subscription.cancel_at_period_end){ %><div class="notice notice--warn">Cancellation is scheduled. Operational access remains available through <%= new Date(summary.subscription.current_period_end).toLocaleDateString() %>.</div><% } %>
      <% if(summary.subscription.status==='GRACE'){ %><div class="notice notice--warn">Payment failed. StockChief remains operational during the grace period. Update the payment method before <%= new Date(summary.subscription.grace_ends_at).toLocaleDateString() %>.</div><% } %>
      <% if(summary.subscription.stripe_customer_id){ %><form method="post" action="/billing/portal"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="rm-btn" type="submit">Manage payment, invoices or cancellation</button></form><% } %>
    <% } else { %><h3>No paid plan yet</h3><p>Choose a plan to create or continue operating a real business workspace.</p><a class="rm-btn" href="/pricing">Choose a plan</a><% } %>
  </div></section>
  <section class="rm-panel"><div class="rm-panel__head"><h2>Current-period usage</h2></div><div class="rm-told"><% if(!summary.meters.length){ %><div class="rm-empty"><p>Usage appears after a plan is active.</p></div><% } %><% summary.meters.forEach(function(meter){var overLimit=meter.hardLimit!==null&&meter.used>meter.hardLimit;var manage={workspaces:'/inventories',members:'/settings#people',locations:'/locations',connections:'/settings/connections'}[meter.meter]; %><div class="rm-told__row"><span class="rm-told__t"><%= meter.label %><small><%= meter.included===null ? 'No plan limit' : meter.used+' of '+meter.included+' included' %><%= meter.overageUnits ? ' · '+meter.overageUnits+' overage units' : '' %><% if(overLimit){ %> · <strong>above the plan limit</strong><% } %></small></span><span><strong><%= meter.used %></strong><% if(overLimit&&manage){ %> · <a href="<%= manage %>">Choose what remains active</a><% } %></span></div><% }); %></div></section>
</div>
<section class="rm-panel" style="margin-top:16px"><div class="rm-panel__head"><h2>Change plan</h2></div><div class="rm-choices" style="padding:18px">
  <% plans.forEach(function(plan){ if(summary.subscription&&plan.id===summary.subscription.plan_id)return; var over=[];
    (plan.meters||[]).forEach(function(policy){var current=summary.meters.find(function(meter){return meter.meter===policy.meter;});
      if(current&&policy.hard_limit!==null&&Number(current.used)>Number(policy.hard_limit))over.push(current.label+': '+current.used+' used, '+policy.hard_limit+' allowed');}); %>
    <article class="rm-choice" style="display:block"><h3><%= plan.public_name %></h3><p><%= plan.outcome %></p>
      <% if(over.length){ %><div class="notice notice--warn"><strong>Current usage is above this plan:</strong><br><%= over.join(' · ') %><br>Nothing is deleted. Choose what remains active before the lower limits take effect.</div><% } %>
      <% if(plan.sales_only){ %><a class="rm-btn rm-btn--ghost" href="/contact?plan=enterprise">Contact StockChief directly</a><% } else { %>
        <p><strong><%= (Number(plan.monthly_amount_minor||0)/100).toLocaleString('en-US',{style:'currency',currency:plan.currency}) %>/month</strong></p>
        <form method="post" action="/billing/checkout"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="planId" value="<%= plan.id %>"><input type="hidden" name="interval" value="monthly"><button class="rm-btn" type="submit"><%= summary.subscription?.stripe_subscription_id?'Manage change in Stripe':'Choose '+plan.public_name %></button></form>
      <% } %>
    </article>
  <% }); %>
</div><div style="padding:0 18px 18px"><p class="rm-quiet">Stripe shows the exact effective date, proration or credit before you confirm. Downgrades preserve records and historical connections.</p></div></section>
<section class="rm-panel" style="margin-top:16px"><div class="rm-panel__head"><h2>Session security</h2></div><div style="padding:18px"><p>Sign this account out everywhere, including this browser. Use this if a device is lost or account access may be compromised.</p><form method="post" action="/logout-all" data-confirm="Sign this account out on every device?"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="rm-btn rm-btn--ghost" type="submit">Sign out all devices</button></form></div></section>
<section class="rm-panel" style="margin-top:16px"><div class="rm-panel__head"><h2>StockChief invoices and receipts</h2></div><div class="rm-told"><% if(!invoices.length){ %><div class="rm-empty"><p>No billing documents are available yet.</p></div><% } %><% invoices.forEach(function(invoice){ %><div class="rm-told__row"><span class="rm-told__t"><%= new Date(invoice.created*1000).toLocaleDateString() %><small><%= invoice.number||invoice.id %> · <%= invoice.status %></small></span><span><strong><%= (Number(invoice.amount_paid||invoice.amount_due||0)/100).toLocaleString('en-US',{style:'currency',currency:(invoice.currency||'usd').toUpperCase()}) %></strong><% if(invoice.hosted_invoice_url){ %> · <a href="<%= invoice.hosted_invoice_url %>" rel="noopener">Open</a><% } %></span></div><% }); %></div></section>
