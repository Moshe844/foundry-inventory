<div class="rm-head"><div><span class="rm-eyebrow">PLAN CAPABILITY</span><h1>Let StockChief handle <%= capabilityLabel %>.</h1><p>This part of the operation is available at a higher autonomy level. Your current records and workflows are unchanged.</p></div></div>
<section class="rm-panel"><div class="rm-panel__head"><h2>Available on</h2><% if(current){ %><span class="right"><span class="rm-pillbadge">Current: <%= current.plan_name %></span></span><% } %></div><div class="rm-choices" style="padding:20px"><% candidates.forEach(function(plan){ %><article class="rm-choice" style="display:block"><h3><%= plan.public_name %></h3><p><%= plan.outcome %></p><% if(plan.sales_only){ %><a class="rm-btn rm-btn--ghost" href="/contact?plan=<%= plan.id %>">Contact StockChief directly</a><% } else { %><form method="post" action="/billing/checkout"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="planId" value="<%= plan.id %>"><input type="hidden" name="interval" value="monthly"><input type="hidden" name="returnPath" value="<%= returnPath %>"><button class="rm-btn" type="submit">Upgrade to <%= plan.public_name %></button></form><% } %></article><% }); %></div><div style="padding:0 20px 20px"><a href="<%= returnPath %>">Return without upgrading</a></div></section>
