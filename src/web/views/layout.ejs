<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
  <meta name="color-scheme" content="light">
  <title><%= title %> · StockChief</title>
  <meta name="description" content="StockChief manages your inventory operation and brings you the exceptions that need your judgement.">
  <meta property="og:title" content="StockChief">
  <meta property="og:description" content="StockChief handles routine inventory work and brings you the exceptions that need your judgement.">
  <meta property="og:type" content="website">
  <meta property="og:image" content="<%= origin %>/og.png">
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content="StockChief — Your inventory operation, managed.">
  <meta name="twitter:description" content="StockChief handles routine inventory work and brings you the exceptions that need your judgement.">
  <meta name="twitter:image" content="<%= origin %>/og.png">
  <%# Keep the application shell self-contained. A remote font stylesheet used
      to block every navigation when Google Fonts was slow or unavailable. %>
  <%# The first four sheets carry what is specific to a single screen. The
      design system loads last and owns everything shared — the tokens they all
      read, and the components every screen is assembled out of — so both
      vocabularies in the views produce one product rather than two. %>
  <link rel="stylesheet" href="/app.css">
  <link rel="stylesheet" href="/product-clarity.css">
  <link rel="stylesheet" href="/foundry.css">
  <link rel="stylesheet" href="/room.css">
  <link rel="stylesheet" href="/design.css">
  <link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24'%3E%3Crect width='24' height='24' rx='5' fill='%235B4BE8'/%3E%3Cpath d='M6 8.5 12 5.8l6 2.7v6L12 17.2 6 14.5z' fill='none' stroke='white' stroke-width='1.5' stroke-linejoin='round'/%3E%3C/svg%3E">
</head>
<body class="page-<%= nav || 'plain' %>">
<%
  /*
   * Three states, not eight destinations.
   *
   * The rail carries what a person actually does in a day: read what StockChief
   * left them, settle what it could not, say something to it. Inventory,
   * Orders, Money and Activity are no longer places — they are lenses, and
   * they are reached from the brief, from a story, or by asking. Everything
   * that used to be a sidebar entry still has its address and is listed, in
   * full, at /everything.
   */
  var isRoom = !!locals.room;
  var railTab = nav === 'home' || nav === 'overview' || nav === 'brief'
    ? 'brief'
    : nav === 'attention' ? 'needs' : nav === 'ask' ? 'ask' : null;
  var allWorkspaces = typeof workspaces !== 'undefined' && workspaces ? workspaces : [];
  var others = allWorkspaces.filter(function (w) { return !workspace || w.workspaceId !== workspace.id; });
%>
<a class="skip-link" href="#main">Skip to content</a>
<div class="app">

  <header class="rm-rail">
    <a class="rm-rail__brand" href="/" aria-label="StockChief">
      <span class="rm-rail__mark" aria-hidden="true">
        <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"><path d="M4 8.2 12 4.4l8 3.8v7.6L12 19.6l-8-3.8z"/><path d="m4 8.2 8 3.8 8-3.8M12 12v7.6"/></svg>
      </span>
      <span class="rm-rail__name">StockChief</span>
    </a>

    <nav class="rm-rail__nav" aria-label="Primary navigation">
      <% if (workspace) { %>
        <a class="rm-tab <%= railTab === 'brief' ? 'is-on' : '' %>" href="/"<%- railTab === 'brief' ? ' aria-current="page"' : '' %>><span class="rm-tab__icon"><%- helpers.icon('overview', { size: 18 }) %></span><span>Brief</span></a>
        <a class="rm-tab <%= railTab === 'needs' ? 'is-on' : '' %>" href="/needs-you"<%- railTab === 'needs' ? ' aria-current="page"' : '' %>><span class="rm-tab__icon"><%- helpers.icon('attention', { size: 18 }) %></span><span>Needs you</span><% if (attentionCount > 0) { %><span aria-label="<%= attentionCount %> waiting" class="rm-tab__count nav-count"><%= attentionCount %></span><% } %></a>
        <a class="rm-tab <%= railTab === 'ask' ? 'is-on' : '' %>" href="/ask"<%- railTab === 'ask' ? ' aria-current="page"' : '' %>><span class="rm-tab__icon"><%- helpers.icon('foundry', { size: 18 }) %></span><span>Ask StockChief</span></a>
      <% } else { %>
        <a class="rm-tab <%= nav === 'inventories' ? 'is-on' : '' %>" href="/inventories"><span class="rm-tab__icon"><%- helpers.icon('layers', { size: 18 }) %></span><span>Your inventories</span></a>
        <a class="rm-tab" href="/inventories/new"><span class="rm-tab__icon"><%- helpers.icon('plus', { size: 18 }) %></span><span>New inventory</span></a>
      <% } %>
    </nav>

    <span class="rm-rail__spacer"></span>

    <%# Every record in the inventory, from anywhere in it. The type-ahead and
        the endpoint behind it already existed; what was missing was the field
        to type into, so the fastest route to a product or an order was not
        reachable from any screen. Press / to jump into it. %>
    <% if (workspace) { %>
      <div class="rail-search" role="search">
        <span class="search-icon" aria-hidden="true"><%- helpers.icon('search', { size: 14 }) %></span>
        <input class="search-input" type="search" data-search autocomplete="off"
               placeholder="Search products, orders, suppliers…" aria-label="Search this inventory">
        <div class="search-results" data-search-results hidden role="listbox" aria-label="Search results"></div>
      </div>
    <% } %>

    <% if (workspace) { %>
      <div class="rm-switch" data-switcher>
        <button class="rm-switch__btn" type="button" data-switcher-toggle aria-expanded="false" aria-haspopup="true">
          <%= workspace.name %><%- helpers.icon('chevron', { size: 12 }) %>
        </button>
        <div class="rm-switch__menu" data-switcher-menu hidden>
          <% if (others.length) { %>
            <div class="rm-switch__label">Switch to</div>
            <% others.forEach(function (other) { %>
              <form method="post" action="/inventories/switch">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                <input type="hidden" name="workspaceId" value="<%= other.workspaceId %>">
                <input type="hidden" name="next" value="/">
                <button class="rm-switch__item" type="submit"><span><%= other.name %></span><% if (other.attentionCount > 0) { %><span class="rm-tab__count"><%= other.attentionCount %></span><% } %></button>
              </form>
            <% }) %>
          <% } %>
          <div class="rm-switch__label">Elsewhere</div>
          <a class="rm-switch__item" href="/inventories">All inventories</a>
          <a class="rm-switch__item" href="/inventories/new">New inventory</a>
          <a class="rm-switch__item" href="/what-you-told-me">What you've told me</a>
          <a class="rm-switch__item" href="/everything">Everything else</a>
        </div>
      </div>
    <% } %>

    <% if (currentUser || account) { %>
      <% var signedInPerson = currentUser || account; %>
      <span class="rm-rail__who">
        <span><%= signedInPerson.name %></span>
        <form method="post" action="/logout" style="margin:0"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="rm-tab" type="submit">Sign out</button></form>
      </span>
    <% } else { %>
      <a class="rm-tab" href="/login">Sign in</a>
    <% } %>
  </header>

  <main class="rm-canvas <%= isRoom ? 'rm' : 'rm rm-legacy' %>" id="main">
    <% if (workspace && workspace.data_mode === 'synthetic') { %>
      <p class="rm-stamp" role="status" style="color:var(--copper)">Test environment · generated records, kept separate from your real inventories</p>
    <% } %>
    <% if (flash && flash.length) { %>
      <div class="flash-stack" data-flash-stack><% flash.forEach(function (message) {
        var live = message.type === 'error' || message.type === 'warn' ? 'alert' : 'status';
      %><div class="flash flash--<%= message.type %>" role="<%= live %>"><span><%= message.message %></span></div><% }) %></div>
    <% } %>
    <% if (typeof navigationArrival !== 'undefined' && navigationArrival) { %>
      <div class="flash flash--success" role="status" data-navigation-arrival>
        <span><%= navigationArrival.message %></span>
      </div>
    <% } %>
    <% if (!isRoom && typeof screenGuide !== 'undefined' && screenGuide) { %>
      <%- include('partials/screen-guide', { screenGuide: screenGuide }) %>
    <% } %>
    <% if (typeof backTo !== 'undefined' && backTo && backTo.href) { %>
      <a class="page-back" href="<%= backTo.href %>"><span aria-hidden="true">←</span> Back to <%= backTo.label %></a>
    <% } %>
    <%- body %>
  </main>
</div>
<script src="/app.js" defer></script>
</body>
</html>
