<!doctype html>
<html lang="en" data-time-zone="<%= locals.account?.timeZone||'' %>" data-account-id="<%= locals.account?.id||'' %>" data-workspace-id="<%= locals.workspace?.id||'' %>">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
  <meta name="color-scheme" content="light">
  <title><%= title %> · StockChief</title>
  <meta name="description" content="StockChief manages your inventory operation and brings you the exceptions that need your judgement.">
  <meta property="og:title" content="StockChief">
  <meta property="og:description" content="StockChief handles routine inventory work and brings you the exceptions that need your judgement.">
  <meta property="og:type" content="website">
  <meta property="og:image" content="<%= origin %>/og.png">
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content="StockChief — Your inventory operation, managed.">
  <meta name="twitter:description" content="StockChief handles routine inventory work and brings you the exceptions that need your judgement.">
  <meta name="twitter:image" content="<%= origin %>/og.png">
  <%# Keep the application shell self-contained. A remote font stylesheet used
      to block every navigation when Google Fonts was slow or unavailable. %>
  <% if(locals.productionPage){ %><link rel="stylesheet" href="/manufacturing.css?v=<%= assetVersion %>"><% } %>
  <% if(locals.globalImportActivity?.length||nav==='imports'){ %><link rel="stylesheet" href="/import-progress.css?v=<%= assetVersion %>"><% } %>
  <% if (nav === 'home') { %><link rel="stylesheet" href="/home.css?v=<%= assetVersion %>"><% } %>
  <% if (nav === 'ask') { %><link rel="stylesheet" href="/ask.css?v=<%= assetVersion %>"><% } %>
  <link rel="stylesheet" data-design-system href="/app-system.css?v=<%= assetVersion %>">
  <link rel="stylesheet" href="/business-system.css?v=<%= assetVersion %>">
  <link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24'%3E%3Crect width='24' height='24' rx='5' fill='%235B4BE8'/%3E%3Cpath d='M6 8.5 12 5.8l6 2.7v6L12 17.2 6 14.5z' fill='none' stroke='white' stroke-width='1.5' stroke-linejoin='round'/%3E%3C/svg%3E">
<script src="/presentation-format.js?v=<%= assetVersion %>" defer></script>
<link rel="stylesheet" href="/professional-system.css?v=<%= locals.assetVersion||'current' %>">
<link rel="stylesheet" href="/customer-usage.css?v=<%= assetVersion %>"><% if(['/onboarding','/onboarding/describe'].includes(currentHref.split('?')[0])){ %><link rel="stylesheet" href="/onboarding.css?v=<%= assetVersion %>"><script src="/onboarding.js?v=<%= assetVersion %>" defer></script><% } %></head>
<body class="page-<%= nav || 'plain' %><%= locals.panelMode?' sc-embedded-chat':'' %>">
<% var isRoom=!!locals.room;var allWorkspaces=locals.workspaces||[];var others=allWorkspaces.filter(w=>!workspace||w.workspaceId!==workspace.id); %>
<a class="skip-link" href="#main">Skip to content</a>
<div class="app">

  <%- include('components/app-navigation',{others}) %>

  <main class="rm-canvas <%= isRoom ? 'rm' : 'rm rm-legacy' %>" id="main">
    <%- include('components/app-toolbar') %>
    <%- include('components/section-tabs') %>
    <% if (locals.onboardingEntry) { %>
      <%- include('partials/inventory-entry', { entry: onboardingEntry, entryPage: currentHref.split('?')[0] }) %>
    <% } %>
    <% if (workspace && workspace.data_mode === 'synthetic') { %>
      <p class="rm-stamp" role="status" style="color:var(--copper)">Test environment · generated records, kept separate from your real inventories</p>
    <% } %>
    <% if (flash && flash.length) { %>
      <div class="flash-stack" data-flash-stack><% flash.forEach(function (message) {
        var live = message.type === 'error' || message.type === 'warn' ? 'alert' : 'status';
      %><div class="flash flash--<%= message.type %>" role="<%= live %>"><span><%= message.message %></span></div><% }) %></div>
    <% } %>
    <% if(workspace){ (locals.globalSourceUploads||[]).filter(upload=>upload.id!==locals.sourceUpload?.id).forEach(upload=>{ %><%- include('imports/source-upload-panel',{upload,detail:false}) %><% }); } %>
    <% const visibleImports=(locals.globalImportActivity||[]).filter(function(activity){return activity.id!==locals.importProgress?.id;}); if(workspace&&visibleImports.length){ %>
      <section class="import-activity" aria-label="File import activity">
        <div class="import-activity__head"><span>File import activity</span><a href="/imports">All imports and results</a></div>
        <% visibleImports.forEach(function(importState){ %>
          <div class="import-activity__row" data-import-progress="<%= importState.href %>/progress" aria-live="polite">
            <div class="import-activity__copy"><strong data-import-status><%= importState.label %></strong><span><%= importState.sourceName %> · <%= helpers.qty(importState.readyRows) %> <%= importState.state==='UPDATING_PREVIEW'?'preview':'approved' %> rows</span><small data-import-note><%= importState.state==='UPDATING_PREVIEW'?'Checking the preview only; no stock changes.':'Products and stock appear after verification finishes.' %></small><small data-import-timing><%= importState.startedAt?'Started':'Queued' %> <time data-import-time datetime="<%= importState.startedAt||importState.queuedAt||importState.createdAt %>"><%= helpers.dateTime(importState.startedAt||importState.queuedAt||importState.createdAt) %></time></small></div>
            <a class="btn btn--secondary btn--sm" href="<%= importState.href %>" data-import-result>View progress</a>
              <%- include('partials/import-meter',{activity:importState}) %>
          </div>
        <% }) %>
      </section>
    <% } %>
    <%#
      The rest of what was said. A message with several parts runs one at a
      time; the next part is offered here, on whatever page the first one led
      to, until it is done or the person chooses to leave it — either way it
      is written in the ledger.
    %>
    <% if (typeof assistantQueue !== 'undefined' && assistantQueue) { %>
      <div class="rm-queue" role="status">
        <div class="rm-queue__t">
          <strong><%= assistantQueue.remaining === 1 ? 'One more thing' : assistantQueue.remaining + ' more things' %> from your message</strong>
          <span>Next: “<%= assistantQueue.next.text.length > 140 ? assistantQueue.next.text.slice(0, 140) + '…' : assistantQueue.next.text %>”</span>
        </div>
        <div class="rm-queue__a">
          <form method="post" action="/foundry/tell" data-busy>
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <input type="hidden" name="assistantGoal" value="<%= assistantQueue.next.id %>">
            <input type="hidden" name="message" value="<%= assistantQueue.next.text %>">
            <% if (assistantQueue.queryConversation) { %><input type="hidden" name="queryConversation" value="1"><% } %>
            <button class="rm-btn rm-btn--sm" type="submit">Continue with it</button>
          </form>
          <form method="post" action="/ask/leave-the-rest">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <input type="hidden" name="back" value="<%= typeof currentHref !== 'undefined' ? currentHref : '/' %>">
            <button class="rm-btn rm-btn--ghost rm-btn--sm" type="submit">Leave the rest</button>
          </form>
        </div>
      </div>
    <% } %>
    <% if (typeof navigationArrival !== 'undefined' && navigationArrival) { %>
      <div class="flash flash--success" role="status" data-navigation-arrival>
        <span><%= navigationArrival.message %></span>
      </div>
    <% } %>
    <% if (!isRoom && typeof screenGuide !== 'undefined' && screenGuide) { %>
      <%- include('partials/screen-guide', { screenGuide: screenGuide }) %>
    <% } %>
    <% if (typeof backTo !== 'undefined' && backTo && backTo.href) { %>
      <a class="page-back" data-return-to href="<%= backTo.href %>"><span aria-hidden="true">←</span> Back to <%= backTo.label %></a>
    <% } %>
    <% if(locals.passwordUpgradeRequired){ %><div class="notice notice--warn" role="status"><div><strong>Please strengthen your password.</strong><p>Your account uses an older password policy. <a href="/settings/password">Update your password</a> to meet the current security requirements.</p><form method="post" action="/settings/password/remind-later"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="returnTo" value="<%= locals.currentPath||'/' %>"><button class="btn btn--sm" type="submit">Remind me next sign-in</button></form></div></div><% } %>
    <%- body %>
  </main>
</div>
<script src="/ask-request-kind.js?v=<%= assetVersion %>" defer></script>
<script src="/product-shell.js?v=<%= assetVersion %>" defer></script>
<script src="/table-overflow.js?v=<%= assetVersion %>" defer></script>
<script src="/local-time.js?v=<%= assetVersion %>" defer></script>
<script src="/navigation-state.js?v=<%= assetVersion %>" defer></script>
<script src="/app.js?v=<%= assetVersion %>" defer></script>
<% if(locals.globalImportActivity?.length||nav==='imports'){ %><script src="/import-progress.js?v=<%= assetVersion %>" defer></script><% } %>
<% if(locals.agentArrival){ %>
<div hidden data-agent-arrival data-token="<%= agentArrival.token %>" data-csrf="<%= csrfToken %>"></div>
<script src="/agent-navigation.js?v=<%= assetVersion %>" defer></script>
<% } %>
</body>
</html>
