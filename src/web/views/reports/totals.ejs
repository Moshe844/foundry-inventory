<% const list=locals.totals?.metrics||[],span=locals.totals?.comparison; if(list.length){ %><section class="report-card report-kpis-card" data-report-total><div class="report-kpis"><% for(const metric of list){ %><div class="report-kpi"><span><%= metric.label %></span><strong><%= metric.display %></strong><% if(metric.change!==null){ %><small class="report-delta <%= metric.good===true?'is-good':metric.good===false?'is-bad':'' %>"><%= (metric.change>0?'▲ ':metric.change<0?'▼ ':'')+Math.abs(metric.change).toFixed(1)+'%' %></small><% } %><% if(metric.previousDisplay){ %><em>was <%= metric.previousDisplay %></em><% }else if(span){ %><em>No earlier records</em><% } %></div><% } %><% if(span){ %><p class="report-kpis__note"><%= helpers.shortDate(span.from) %> – <%= helpers.shortDate(span.to) %> compared with <%= helpers.shortDate(span.previousFrom) %> – <%= helpers.shortDate(span.previousTo) %></p><% } %></div></section><% } %>
