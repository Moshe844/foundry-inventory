<% var selection=saved?.definition||draft||null,unavailable=new Set(locals.unavailableSources||[]); %>
<div class="page-head"><div><a class="back-link" href="/reports">Reports</a><h1><%= saved?'Edit report':draft?'Customize report':'Build a report' %></h1>
  <p class="lede">Choose what you want to see. StockChief will use your business records.</p></div></div>
<section class="report-start" aria-label="Start a custom report">
  <form action="/reports/describe" method="get" class="report-describe"><label for="report-description">Describe the report you want</label>
    <textarea id="report-description" name="q" rows="3" maxlength="1800" required placeholder="For example, profit by customer by month this year"></textarea>
    <button class="btn btn--primary" type="submit">Build it for me</button></form>
  <div class="report-template-start"><h2>Start from a template</h2><div class="report-template-grid"><% for(const item of builderEntry.templates){if(unavailable.has(item.definition.dataset)){ %>
    <div class="report-template-locked" aria-disabled="true"><strong><%= item.name %></strong><span><%= item.description %></span><small>Available on a higher plan</small></div>
    <% }else{ %><a href="/reports/template/<%= item.key %>" data-dest="/reports/builder?draft=1"><strong><%= item.name %></strong><span><%= item.description %></span></a><% } %>
  <% } %></div></div>
  <a class="report-manual-link" href="#report-manual">Build manually ↓</a>
</section>
<div class="report-builder-layout" id="report-manual"><form class="report-builder" method="post" action="/reports/run" data-report-builder>
  <input type="hidden" name="_csrf" value="<%= csrfToken %>">
  <% if(saved){ %><input type="hidden" name="id" value="<%= saved.id %>"><% } %>
  <div class="report-card"><label for="report-dataset">Start with</label>
    <select id="report-dataset" name="dataset" onchange="location.href='/reports/builder?dataset='+encodeURIComponent(this.value)">
      <% for(const entry of datasets){ %><option value="<%= entry.key %>" <%= entry.key===dataset.key?'selected':'' %> <%= unavailable.has(entry.key)?'disabled':'' %>><%= builderEntry.sourceNames[entry.key]||entry.label %><%= unavailable.has(entry.key)?' — higher plan':'' %></option><% } %>
    </select>
    <label for="report-title">Report title</label><input id="report-title" name="title" maxlength="100"
      value="<%= saved?.title||draft?.title||dataset.label %>" required>
  </div>
  <div class="report-card"><h2>Columns</h2><p>Choose the details to show. Grouping gives you a summary instead of individual rows.</p>
    <div class="report-column-order" data-report-column-order
      data-initial-columns="<%= JSON.stringify(selection?.columns||Object.keys(dataset.fields).slice(0,5)) %>"
      data-initial-labels="<%= JSON.stringify(selection?.columnLabels||{}) %>">
      <strong>Shown columns, in order</strong><p>Drag a row or use the arrows. Rename a heading without changing the source data.</p>
      <ol data-report-column-list></ol>
    </div>
    <label for="report-field-search">Find a field</label><input id="report-field-search" type="search" placeholder="Search fields" data-report-field-search>
    <div class="report-checks"><% for(const group of builderEntry.fieldsFor(dataset)){ %><fieldset class="report-field-area"><legend><%= group.area %></legend><% for(const {key:field,label,type} of group.fields){ %>
      <label><input type="checkbox" name="columns" value="<%= field %>" data-report-column-choice data-report-column-label="<%= label %>"
        <%= (selection?.columns||Object.keys(dataset.fields).slice(0,5)).includes(field)?'checked':'' %>>
        <%= label %> <small><%= type==='money_minor'?'money':type %></small></label>
    <% } %></fieldset><% } %></div>
  </div>
  <div class="report-card"><h2>Filter records</h2><p>Up to eight exact, text or range filters. Blank rows are ignored.</p>
    <% for(let index=0;index<8;index++){const filter=selection?.filters?.[index]||{}; %>
      <div class="report-filter" data-report-filter <%= index<=(selection?.filters?.length||0)?'':'hidden' %>><select name="filters[<%= index %>][field]" aria-label="Filter field <%= index+1 %>">
        <option value="">Field</option><% for(const field of Object.keys(dataset.fields)){ %>
          <option value="<%= field %>" <%= filter.field===field?'selected':'' %>><%= builderEntry.friendlyField(field) %></option>
        <% } %></select><select name="filters[<%= index %>][operator]" aria-label="Filter comparison <%= index+1 %>">
        <% for(const option of ['equals','is_not','contains','greater_than','less_than','at_least','at_most','after','before','is_empty','not_empty','relative']){ %>
          <option value="<%= option %>" <%= filter.operator===option?'selected':'' %>><%= option.replaceAll('_',' ') %></option>
        <% } %></select><input name="filters[<%= index %>][value]" value="<%= filter.value||'' %>"
          aria-label="Filter value <%= index+1 %>" placeholder="Value, date, or relative period" list="report-relative-periods"></div>
    <% } %>
    <datalist id="report-relative-periods"><% Object.entries(reportRelativePeriods).forEach(([value,label])=>{ %><option value="<%= value %>"><%= label %></option><% }); %></datalist><button class="btn" type="button" data-report-add-filter>Add another filter</button>
  </div>
  <div class="report-card"><h2>Summarize and visualize</h2>
    <label><input type="checkbox" name="summary" value="on" <%= selection?.summary?'checked':'' %>>
      One whole-dataset total (the detail columns above will not be used)</label>
    <p><small>For a breakdown, choose grouping below instead. Weighted ratios use the full recorded numerator and denominator, not an average of percentages.</small></p>
    <div class="report-controls">
    <% for(let position=0;position<3;position++){ %><label><%= position===0?'Group by':'Then group by' %>
      <select name="groups"><option value="">No <%= position===0?'grouping':'additional grouping' %></option>
        <% for(const field of Object.keys(dataset.fields)){ %><option value="<%= field %>"
          <%= selection?.groups?.[position]===field?'selected':'' %>><%= builderEntry.friendlyField(field) %></option><% } %>
      </select></label><% } %>
    <label>Date grouping<select name="dateGrain">
      <% for(const option of ['exact','day','week','month','quarter','year']){ %>
        <option value="<%= option %>" <%= (selection?.dateGrain||'exact')===option?'selected':'' %>><%= option==='exact'?'Exact dates':option %></option>
      <% } %></select></label>
    <label>Calculation<select name="aggregate"><% for(const option of ['count','count_distinct','sum','average','minimum','maximum','ratio']){ %>
      <option value="<%= option %>" <%= (selection?.aggregate||'count')===option?'selected':'' %>><%= option==='ratio'?'weighted percentage':option==='count_distinct'?'count unique values':option %></option><% } %></select></label>
    <label>Measure<select name="measure"><option value="">Count rows</option>
      <% for(const [field,type] of Object.entries(dataset.fields)){ %>
        <option value="<%= field %>" <%= selection?.measure===field?'selected':'' %>><%= builderEntry.friendlyField(field) %></option>
      <% } %>
      <% for(const [key,metric] of Object.entries(dataset.metrics||{})){ %>
        <option value="<%= key %>" <%= selection?.measure===key?'selected':'' %>><%= metric.label %> · weighted ratio</option>
      <% } %></select></label>
    <label>Display<select name="chart"><% for(const option of ['table','bar','line']){ %>
      <option value="<%= option %>" <%= (selection?.chart||'table')===option?'selected':'' %>><%= option==='line'?'line (date trend)':option %></option><% } %></select></label>
    <label>Layout<select name="layout"><% for(const option of ['chart_first','table_first','dashboard']){ %>
      <option value="<%= option %>" <%= (selection?.layout||'chart_first')===option?'selected':'' %>><%= option.replaceAll('_',' ') %></option><% } %></select></label>
    <label>Sort<select name="sort"><option value="">Default</option>
      <% for(const field of Object.keys(dataset.fields)){ %><option value="<%= field %>"
          <%= selection?.sort===field?'selected':'' %>><%= builderEntry.friendlyField(field) %></option><% } %>
      <% for(const field of ['count','distinct_count','total','average','minimum','maximum','ratio']){ %><option value="<%= field %>"
        <%= selection?.sort===field?'selected':'' %>><%= field %></option><% } %></select></label>
    <label>Direction<select name="direction"><option value="desc">High to low / newest</option>
      <option value="asc" <%= selection?.direction==='asc'?'selected':'' %>>Low to high / oldest</option></select></label>
    <label>Show only the first results<input name="topN" type="number" min="1" max="1000" step="1"
      value="<%= selection?.topN??'' %>" placeholder="All results" aria-describedby="report-top-limit-help"></label>
    <small id="report-top-limit-help">Sort high to low for top results, or low to high for bottom results.</small>
  </div></div>
  <section class="report-card"><h2>Automatic delivery</h2><%- include('schedule-controls',{saved:locals.saved||null,draftSchedule:locals.draftSchedule||null}) %></section>
  <div class="report-actions"><button class="btn btn--primary" type="submit">Run report</button>
    <button class="btn" type="submit" formaction="/reports/save">Save template</button></div>
</form><aside class="report-live-preview" aria-label="Live preview"><h2>Preview</h2><p data-report-preview-status>Choose fields to see a preview.</p><div data-report-preview-table class="report-preview-table"></div><p class="report-preview-note">Preview shows up to 30 rows. Open the full report to browse more.</p></aside></div>
<link rel="stylesheet" href="/reports.css?v=<%= assetVersion %>">
<script defer src="/reports.js?v=<%= assetVersion %>"></script>
