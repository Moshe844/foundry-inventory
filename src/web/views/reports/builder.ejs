<% var selection=saved?.definition||draft||null; %>
<div class="page-head"><div><a class="back-link" href="/reports">Reports</a><h1><%= saved?'Edit report':draft?'Customize Ask report':'Build a report' %></h1>
  <p class="lede">Your selections are translated into a safe, workspace-scoped query. No free-form SQL is accepted.</p></div></div>
<form class="report-builder" method="post" action="/reports/run">
  <input type="hidden" name="_csrf" value="<%= csrfToken %>">
  <% if(saved){ %><input type="hidden" name="id" value="<%= saved.id %>"><% } %>
  <div class="report-card"><label for="report-dataset">Dataset</label>
    <select id="report-dataset" name="dataset" onchange="location.href='/reports/builder?dataset='+encodeURIComponent(this.value)">
      <% for(const entry of datasets){ %><option value="<%= entry.key %>" <%= entry.key===dataset.key?'selected':'' %>><%= entry.label %></option><% } %>
    </select>
    <label for="report-title">Report title</label><input id="report-title" name="title" maxlength="100"
      value="<%= saved?.title||draft?.title||dataset.label %>" required>
  </div>
  <div class="report-card"><h2>Columns</h2><p>Choose the detail fields to display. Grouping replaces detail rows with an aggregate.</p>
    <div class="report-checks"><% for(const [field,type] of Object.entries(dataset.fields)){ %>
      <label><input type="checkbox" name="columns" value="<%= field %>"
        <%= (selection?.columns||Object.keys(dataset.fields).slice(0,5)).includes(field)?'checked':'' %>>
        <%= field.replaceAll('_',' ') %> <small><%= type==='money_minor'?'cents':type %></small></label>
    <% } %></div>
  </div>
  <div class="report-card"><h2>Filter records</h2><p>Up to eight exact, text or range filters. Blank rows are ignored.</p>
    <% for(let index=0;index<8;index++){const filter=selection?.filters?.[index]||{}; %>
      <div class="report-filter" data-report-filter <%= index<=(selection?.filters?.length||0)?'':'hidden' %>><select name="filters[<%= index %>][field]" aria-label="Filter field <%= index+1 %>">
        <option value="">Field</option><% for(const field of Object.keys(dataset.fields)){ %>
          <option value="<%= field %>" <%= filter.field===field?'selected':'' %>><%= field.replaceAll('_',' ') %></option>
        <% } %></select><select name="filters[<%= index %>][operator]" aria-label="Filter comparison <%= index+1 %>">
        <% for(const option of ['equals','contains','at_least','at_most','after','before','is_null']){ %>
          <option value="<%= option %>" <%= filter.operator===option?'selected':'' %>><%= option.replaceAll('_',' ') %></option>
        <% } %></select><input name="filters[<%= index %>][value]" value="<%= filter.value||'' %>"
          aria-label="Filter value <%= index+1 %>" placeholder="Value or YYYY-MM-DD"></div>
    <% } %>
    <button class="button button--secondary" type="button" data-report-add-filter>Add another filter</button>
  </div>
  <div class="report-card"><h2>Summarize and visualize</h2><div class="report-controls">
    <% for(let position=0;position<3;position++){ %><label><%= position===0?'Group by':'Then group by' %>
      <select name="groups"><option value="">No <%= position===0?'grouping':'additional grouping' %></option>
        <% for(const field of Object.keys(dataset.fields)){ %><option value="<%= field %>"
          <%= selection?.groups?.[position]===field?'selected':'' %>><%= field.replaceAll('_',' ') %></option><% } %>
      </select></label><% } %>
    <label>Calculation<select name="aggregate"><% for(const option of ['count','sum','average','minimum','maximum']){ %>
      <option value="<%= option %>" <%= (selection?.aggregate||'count')===option?'selected':'' %>><%= option %></option><% } %></select></label>
    <label>Numeric measure<select name="measure"><option value="">Count rows</option>
      <% for(const [field,type] of Object.entries(dataset.fields)){if(type==='number'||type==='money_minor'){ %>
        <option value="<%= field %>" <%= selection?.measure===field?'selected':'' %>><%= field.replaceAll('_',' ') %></option>
      <% }} %></select></label>
    <label>Display<select name="chart"><% for(const option of ['table','bar','line']){ %>
      <option value="<%= option %>" <%= (selection?.chart||'table')===option?'selected':'' %>><%= option==='line'?'line (date trend)':option %></option><% } %></select></label>
    <label>Sort<select name="sort"><option value="">Default</option>
      <% for(const field of Object.keys(dataset.fields)){ %><option value="<%= field %>"
          <%= selection?.sort===field?'selected':'' %>><%= field.replaceAll('_',' ') %></option><% } %>
      <% for(const field of ['count','total','average','minimum','maximum']){ %><option value="<%= field %>"
        <%= selection?.sort===field?'selected':'' %>><%= field %></option><% } %></select></label>
    <label>Direction<select name="direction"><option value="desc">High to low / newest</option>
      <option value="asc" <%= selection?.direction==='asc'?'selected':'' %>>Low to high / oldest</option></select></label>
  </div></div>
  <div class="report-card"><h2>Automatic delivery</h2><p>Delivery goes only to your verified account email.</p>
    <div class="report-controls"><label>Frequency<select name="frequency">
      <% for(const option of ['none','daily','weekly']){ %><option value="<%= option %>"
        <%= (saved?.schedule_frequency||'none')===option?'selected':'' %>><%= option %></option><% } %></select></label>
      <label>Hour (UTC)<input type="number" name="hour" min="0" max="23" value="<%= saved?.schedule_hour_utc??9 %>"></label>
    </div></div>
  <div class="report-actions"><button class="button" type="submit">Run report</button>
    <button class="button button--secondary" type="submit" formaction="/reports/save">Save template</button></div>
</form>
<link rel="stylesheet" href="/reports.css?v=<%= assetVersion %>">
<script defer src="/reports.js?v=<%= assetVersion %>"></script>
