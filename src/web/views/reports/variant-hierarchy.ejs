<section class="sc-business-card"><h2>Stock value by item</h2><p>Each item total includes all its variants and locations, including archived variants with stock. Open an item to see its variants. Values include recorded purchase costs only.</p>
<% if(!r.hierarchy.items.length){ %><p>No recorded stock matches this page.</p><% } %>
<% for(const parent of r.hierarchy.items){ %><details class="sc-business-card" data-item-valuation><summary><strong><%= parent.name %></strong><% if(helpers.productCode(parent.base_code)){ %> · <%= helpers.productCode(parent.base_code) %><% } %> · <%= parent.valueLabel %> known value · <%= parent.variant_count %> variants<% if(Number(parent.missing)){ %> · <%= helpers.qty(parent.missing) %> units need purchase costs<% } %></summary>
<div class="sc-report-table"><table><thead><tr><th>Variant</th><th>SKU</th><th>On hand</th><th>Units with cost</th><th>Recorded value</th></tr></thead><tbody><% for(const variant of parent.variants){ %><tr><td><a href="/inventory/<%= parent.item_id %>#sku-<%= variant.sku_id %>"><%= parent.name %><%= variant.variant_label?' — '+variant.variant_label:'' %></a></td><td><%= variant.code %></td><td><%= helpers.qty(variant.units) %></td><td><%= helpers.qty(variant.costed) %><% if(Number(variant.missing)){ %> · <%= helpers.qty(variant.missing) %> need cost<% } %></td><td><%= variant.valueLabel %><%= Number(variant.missing)?' known':'' %></td></tr><% } %></tbody></table></div>
<% if(parent.variant_count>parent.variants.length){ %><p>Showing <%= parent.variants.length %> of <%= parent.variant_count %> variants. The item total includes every variant. <a href="/inventory/<%= parent.item_id %>">Review all variants</a>.</p><% } %></details><% } %>
<% if(r.hierarchy.hasMore){ %><a class="btn" href="/reports/business/stock-value?<%= q %>&amp;afterItem=<%= encodeURIComponent(r.hierarchy.nextAfterItem) %>">Next items</a><% } %></section>
