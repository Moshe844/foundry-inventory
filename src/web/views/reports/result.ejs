<div class="page-head"><div><a class="back-link" href="/reports">Reports</a><h1><%= result.config.title %></h1>
  <p class="lede"><%= result.rows.length %><%= result.hasMore?' or more':'' %> displayed ·
    <%= result.provenance.source %> · checked <%= result.asOf %></p></div>
  <div><a href="<%= saved?'/reports/builder?dataset='+encodeURIComponent(result.config.dataset)+'&saved='+encodeURIComponent(saved.id):'/reports/builder?draft=1' %>">Customize</a></div></div>
<% if(result.config.chart!=='table'&&result.config.groups.length&&result.rows.length){
  const values=result.rows.map(row=>Number(row[result.columns.at(-1)]));
  const chartSafe=result.comparisonSafe!==false&&values.every(value=>Number.isFinite(value)&&Math.abs(value)<=Number.MAX_SAFE_INTEGER);
  if(chartSafe){
  const maximum=Math.max(1,...values.map(Math.abs)); %>
  <section class="report-card"><h2><%= result.config.chart==='line'?(result.rows.length>1?'Trend':'Recorded value'):'Comparison' %></h2>
    <% if(result.config.chart==='line'){
      const plotted=values.slice(0,40);const bottom=Math.min(0,...plotted),top=Math.max(1,...plotted);
      const points=plotted.map((value,index)=>`${30+index*640/Math.max(1,plotted.length-1)},${180-(value-bottom)*150/(top-bottom||1)}`).join(' '); %>
      <svg class="report-line" role="img" aria-label="Line chart of <%= result.config.title %>"
        viewBox="0 0 700 210" preserveAspectRatio="none"><line x1="30" y1="180" x2="670" y2="180" stroke="#aeb4c6"/>
        <polyline points="<%= points %>" fill="none" stroke="#6756e8" stroke-width="3"/>
        <% points.split(' ').forEach(function(point){const xy=point.split(','); %>
          <circle cx="<%= xy[0] %>" cy="<%= xy[1] %>" r="4" fill="#6756e8"/>
        <% }); %></svg>
    <% }else{ %><div class="report-bars"><% for(let index=0;index<Math.min(40,result.rows.length);index++){
      const row=result.rows[index],value=values[index]; %>
      <div class="report-bar"><span><%= result.config.groups.map(field=>row[field]).join(' · ') %></span>
        <i style="width:<%= Math.max(1,Math.round(Math.abs(value)/maximum*100)) %>%"></i><strong><%= result.displayRows[index][result.columns.at(-1)] %></strong></div>
    <% } %></div><% } %><p><small>Chart shows the first 40 displayed groups. The table below contains the exact values.</small></p>
  </section><% }else{ %><p class="report-error"><%= result.comparisonSafe===false?'Amounts in different currencies cannot be compared on one chart. Filter to a single currency.':'This chart cannot safely plot these values.' %> The exact figures remain in the verified table.</p><% } %><% } %>
<% var insights=result.insights||[]; if(insights.length){ %>
  <section class="report-card"><h2>What stands out</h2>
    <% insights.forEach(function(insight){ %><p><strong><%= insight.title %>.</strong> <%= insight.text %></p><% }); %>
    <p><small>These are comparisons of recorded rows, not a claim about causes or future outcomes.</small></p>
  </section>
<% } %>
<section class="report-card report-results"><h2>Verified rows</h2>
  <% if(!result.rows.length){ %><p>No matching records. Try a wider date or different filter.</p><% }else{ %>
    <div class="report-table-wrap"><table><thead><tr><% for(const column of result.columns){ %>
      <th scope="col"><%= column.replaceAll('_',' ') %></th><% } %><th scope="col">Source</th></tr></thead>
      <tbody><% for(const [index,row] of result.rows.slice(0,200).entries()){ %><tr><% for(const column of result.columns){ %>
        <td><%= result.displayRows[index][column]??'—' %></td><% } %><td><% if(row.href){ %><a href="<%= row.href %>">Open record</a><% }else if(result.config.groups.length){ %>
          <form method="post" action="/reports/drilldown"><input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <input type="hidden" name="definition" value="<%= JSON.stringify(result.config) %>">
            <input type="hidden" name="groupValues" value="<%= JSON.stringify(result.config.groups.map(field=>row[field])) %>">
            <button class="report-link" type="submit">See source records</button></form><% } %></td></tr><% } %></tbody>
    </table></div>
    <% if(result.hasMore){ %><p>More rows match. Narrow the filters or export the saved report to inspect more.</p><% } %>
  <% } %>
</section>
<section class="report-card"><h2>Save and export</h2>
  <% if(saved){ %><p>Saved report · <%= saved.schedule_frequency==='none'?'on demand':saved.schedule_frequency+' delivery' %></p>
    <% if(saved.last_error){ %><p class="report-error">Delivery needs attention: <%= saved.last_error %></p><% } %>
    <div class="report-actions"><a href="/reports/saved/<%= saved.id %>/export.csv">CSV</a>
      <a href="/reports/saved/<%= saved.id %>/export.xlsx">Excel</a>
      <a href="/reports/saved/<%= saved.id %>/export.pdf">PDF</a></div>
  <% }else{ %><form action="/reports/save" method="post"><input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <input type="hidden" name="definition" value="<%= JSON.stringify(result.config) %>">
    <button class="button" type="submit">Save this report</button></form><% } %>
</section>
<link rel="stylesheet" href="/reports.css?v=<%= assetVersion %>">
