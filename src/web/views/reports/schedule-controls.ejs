<% const scheduleSource=locals.saved||{},draft=locals.draftSchedule||{},zone=scheduleSource.schedule_time_zone||draft.timeZone||reportBusinessTimeZone,hour=scheduleSource.schedule_hour_local??scheduleSource.schedule_hour_utc??draft.hour??9,minute=scheduleSource.schedule_minute??draft.minute??0,weekday=scheduleSource.schedule_weekday??draft.weekday??1; %>
<p>Choose the local delivery time. StockChief adjusts for daylight saving. Delivery goes to your account email.</p>
<div class="report-controls"><label>Frequency<select name="frequency"><% for(const value of ['none','daily','weekly']){ %><option value="<%= value %>" <%= (scheduleSource.schedule_frequency||draft.frequency||'none')===value?'selected':'' %>><%= value==='none'?'On demand':value==='daily'?'Daily':'Weekly' %></option><% } %></select></label>
<label>Hour<input type="number" name="hour" min="0" max="23" value="<%= hour %>" required></label><label>Minute<input type="number" name="minute" min="0" max="59" value="<%= minute %>" required></label>
<label>Weekly day<select name="weekday"><% ['Sunday','Monday','Tuesday','Wednesday','Thursday','Friday','Saturday'].forEach((name,index)=>{ %><option value="<%= index %>" <%= Number(weekday)===index?'selected':'' %>><%= name %></option><% }) %></select></label>
<label>Time zone<select name="timeZone"><% [...new Set([reportBusinessTimeZone,zone,'UTC',...Intl.supportedValuesOf('timeZone')])].forEach(value=>{ %><option value="<%= value %>" <%= value===zone?'selected':'' %>><%= value.replaceAll('_',' ') %></option><% }) %></select></label></div>
<% if(locals.saved){ %><input type="hidden" name="expectedRevision" value="<%= saved.revision %>"><% } %>
