<% const r=report,d=r.definition,c=r.context,q=new URLSearchParams({from:c.from,to:c.to}).toString(),result=r.result,metric=result.columns.at(-1); %><a class="back-link" href="/reports?<%= q %>">‹ Reports</a><header class="sc-business-head"><div><h1><%= d.title %></h1><p><%= d.question %> · <%= c.timeZone %> · <%= c.currency %></p></div><div class="sc-row-actions"><a class="btn" download="stockchief-<%= d.key %>.csv" href="/reports/business/<%= d.key %>/export.csv?<%= q %>">Export</a><a class="btn" data-dest="/reports/builder?draft=1" href="/reports/business/<%= d.key %>/customize?weekly=1&amp;<%= q %>">Email me weekly</a></div></header><%- include('../accounting/customer-period',{model:c,action:'/reports/business/'+d.key}) %><section class="sc-business-card"><% if(r.needsReorderSetup){ %><p data-report-headline data-reorder-setup>Set reorder levels to see low stock.</p><a class="btn btn--primary" href="/purchasing/setup">Set reorder levels</a><% }else{ %><strong class="sc-report-headline" data-report-headline><%= r.headline %></strong><% } %><p><%= d.current?'Current recorded position. Changing dates does not turn this into a historical stock valuation.':'Complete total for the selected dates; the table below may show a shorter page.' %></p><% if(d.key==='stock-value'&&c.missingCostUnits){ %><p class="notice" data-cost-coverage>Known value only: <%= helpers.unitCount(c.missingCostUnits,'unit') %> <%= Number(c.missingCostUnits)===1?'needs':'need' %> actual stock cost. This valuation is incomplete.</p><% } %><% if(d.key==='profit'){ %><p class="notice">Recorded profit is incomplete until all business costs are included. <a href="/money/profit?<%= q %>">Gross profit, net profit and cost coverage →</a></p><% } %><% if(d.key==='sales'){ %><a href="/money/sources/revenue?<%= q %>">Where did this come from? →</a><% }else if(d.key==='profit'){ %><a href="/money/sources/net?<%= q %>">Where did this come from? →</a><% }else{ %><a href="/reports/business/<%= d.key %>?detail=1&amp;<%= q %>">Where did this come from? Review the records →</a><% } %></section>
<% if(!result.rows.length){ %><section class="sc-business-card"><p class="sc-empty">No recorded activity matches these dates and filters.</p></section><% }else{const values=result.rows.slice(0,30).map(row=>Number(row.total??row.on_hand??0)),max=Math.max(1,...values.map(Math.abs)); %><section class="sc-business-card"><h2><%= d.current?'Recorded positions':'Recorded activity' %></h2><div class="sc-report-bars"><% for(let i=0;i<values.length;i++){const row=result.rows[i]; %><div><span><%= row[result.columns[0]] %></span><i style="width:<%= Math.abs(values[i])/max*100 %>%"></i><strong><%= result.displayRows[i][metric] %></strong></div><% } %></div></section><section class="sc-business-card"><h2>Records behind this report</h2><p><%= result.rows.length %> shown<%= result.hasMore?' · additional records are available through Customize':'' %></p><div class="sc-report-table"><table><thead><tr><% for(const col of result.columns){ %><th><%= result.columnLabels[col]||helpers.columnLabel(col) %></th><% } %></tr></thead><tbody><% result.rows.forEach((row,i)=>{ %><tr><% for(const col of result.columns){ %><td data-label="<%= result.columnLabels[col]||col %>"><% if(row.href&&col===result.columns[0]){ %><a href="<%= row.href %>"><%= result.columnTypes[col]==='date'?helpers.shortDate(result.displayRows[i][col]):result.displayRows[i][col] %></a><% }else{ %><%= result.columnTypes[col]==='date'?helpers.shortDate(result.displayRows[i][col]):result.displayRows[i][col] %><% } %></td><% } %></tr><% }); %></tbody></table></div></section><% } %><% if(r.worst?.rows.length){ %><section class="sc-business-card"><h2>Lowest fulfilled sales in the same period</h2><% for(const row of r.worst.rows){ %><p><%= row.product %> · <%= row.sku %>: <%= helpers.unitCount(row.total,'unit') %></p><% } %><p>Products with no order lines are not represented in this ranking. Returns are reported separately.</p></section><% } %>