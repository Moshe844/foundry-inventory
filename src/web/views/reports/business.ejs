<% const r=report,d=r.definition,c=r.context,q=new URLSearchParams({from:c.from,to:c.to,...(['sellers','stock-value'].includes(d.key)?{view:r.hierarchy?'items':r.view}:{})}).toString(),result=r.result,metric=result.metricColumns?.[0]||result.columns.at(-1),first=result.columns[0],numeric=col=>['money_minor','number'].includes(result.columnTypes[col]),grain=result.config.dateGrain,monthly=value=>new Intl.DateTimeFormat('en-US',{month:'short',year:'numeric',timeZone:'UTC'}).format(new Date(String(value).slice(0,10)+'T12:00:00Z')),dayText=value=>grain==='month'?monthly(value):helpers.shortDate(value),cellText=(col,value)=>result.columnTypes[col]==='date'?dayText(value):value,lead=locals.totals?.metrics?.[0],span=locals.totals?.comparison; %>
<a class="back-link" href="/reports?<%= q %>">‹ Reports</a>
<header class="sc-business-head"><div><h1><%= d.title %></h1><p><%= d.question %></p></div><div class="sc-row-actions"><a class="btn" download="stockchief-<%= d.key %>.csv" href="/reports/business/<%= d.key %>/export.csv?<%= q %>">Export</a><a class="btn" data-dest="/reports/builder?draft=1" href="/reports/business/<%= d.key %>/customize?weekly=1&amp;<%= q %>">Email me weekly</a><a class="btn btn--primary" data-dest="/reports/builder?draft=1" href="/reports/business/<%= d.key %>/customize?<%= q %>">Customize</a></div></header>
<% if(!d.current){ %><%- include('../accounting/customer-period',{model:c,action:'/reports/business/'+d.key}) %><% } %>
<section class="report-card report-hero">
  <% if(r.needsReorderSetup){ %><p data-report-headline data-reorder-setup>Set reorder levels to see low stock.</p><a class="btn btn--primary" href="/purchasing/setup">Set reorder levels</a>
  <% }else{ %><div class="report-hero__figure"><strong class="sc-report-headline" data-report-headline><%= r.headline %></strong><% if(lead&&lead.change!==null){ %><span class="report-delta <%= lead.good===true?'is-good':lead.good===false?'is-bad':'' %>"><%= (lead.change>0?'▲ ':lead.change<0?'▼ ':'')+Math.abs(lead.change).toFixed(1)+'%' %></span><% } %><% if(lead?.previousDisplay&&span){ %><span class="report-hero__was">was <%= lead.previousDisplay %> in <%= helpers.shortDate(span.previousFrom) %> – <%= helpers.shortDate(span.previousTo) %></span><% } %></div>
  <p class="report-hero__note"><%= d.current?'Where things stand right now. Dates do not change this report.':helpers.shortDate(c.from)+' – '+helpers.shortDate(c.to) %><% if(d.key==='sales'){ %> · <a href="/money/sources/revenue?<%= q %>">Where did this come from? →</a><% }else if(d.key==='profit'){ %> · <a href="/money/sources/net?<%= q %>">Where did this come from? →</a><% }else{ %> · <a href="/reports/business/<%= d.key %>?detail=1&amp;<%= q %>">Where did this come from? Review the records →</a><% } %></p><% } %>
  <% if(d.key==='stock-value'&&c.missingCostUnits){ %><p class="notice" data-cost-coverage>Known value only: cost is not recorded for <%= helpers.unitCount(c.missingCostUnits,'unit') %>. This valuation is incomplete.</p><% } %>
  <% if(d.key==='profit'&&locals.profitBreakdown){ const pb=profitBreakdown,pm=n=>helpers.money(n,pb.currency); %><dl class="report-breakdown" data-profit-breakdown><div><dt>Sales</dt><dd><%= pm(pb.revenueMinor) %></dd></div><div><dt>Product cost</dt><dd><%= pm(pb.cogsMinor) %></dd></div><div class="is-sub"><dt>Gross profit</dt><dd><%= pm(pb.grossProfitMinor) %></dd></div><% if(pb.stockCountMinor){ %><div><dt>Stock count gains / losses</dt><dd><%= pm(pb.stockCountMinor) %></dd></div><% } %><div><dt>Expenses</dt><dd><%= pm(pb.operatingExpenseMinor) %></dd></div><div class="is-sub"><dt>Net profit</dt><dd><%= pm(pb.netIncomeMinor) %></dd></div></dl><% } %>
  <% if(d.key==='profit'){ %><p class="notice">Recorded profit is incomplete until all business costs are included. <a href="/money/profit?<%= q %>">Gross profit, net profit and cost coverage →</a></p><% } %>
</section>
<%- include('warnings',{warnings:result.warnings||[]}) %>
<% if(['sellers','stock-value'].includes(d.key)){ %><nav class="segmented" aria-label="Report grouping"><a class="segmented__item <%= r.hierarchy||r.view==='items'?'is-on':'' %>" href="/reports/business/<%= d.key %>?<%= new URLSearchParams({from:c.from,to:c.to,view:'items'}) %>">By item</a><a class="segmented__item <%= !r.hierarchy&&r.view!=='items'?'is-on':'' %>" href="/reports/business/<%= d.key %>?<%= new URLSearchParams({from:c.from,to:c.to,view:'variants'}) %>">By variant</a></nav><% } %>
<% if(r.hierarchy){ %><%- include('variant-hierarchy',{r,q}) %><% }else if(!result.rows.length){ %><section class="report-card"><p class="sc-empty">No recorded activity matches these dates and filters.</p></section><% }else{
  const overTime=result.config.groups.length===1&&result.columnTypes[first]==='date',indexes=result.rows.map((_,i)=>i),plotted=overTime?indexes.sort((a,b)=>String(result.rows[a][first]).localeCompare(String(result.rows[b][first]))).slice(-60):indexes.slice(0,20);
  const value=i=>Number(result.rows[i].total??result.rows[i].on_hand??0),values=plotted.map(value),peak=Math.max(1,...values.map(Math.abs)),low=Math.min(0,...values),high=Math.max(1,...values),range=high-low||1,y=v=>100-(v-low)/range*100,axis=v=>result.columnTypes[metric]==='money_minor'?helpers.money(Math.round(v),c.currency):helpers.qty(Math.round(v)); %>
<section class="report-card report-chart"><h2><%= result.columnLabels[metric]||helpers.columnLabel(metric) %><%= overTime?' over time':'' %></h2>
  <% if(overTime&&plotted.length>1){ %><div class="report-plot report-plot--columns"><% for(const v of [high,(high+low)/2,low]){ %><div class="report-plot__grid" style="top:<%= y(v) %>%"><span><%= axis(v) %></span></div><% } %><% plotted.forEach((i,n)=>{const v=value(i); %><div class="report-column" title="<%= dayText(result.rows[i][first]) %>: <%= result.displayRows[i][metric] %>" style="left:<%= n/plotted.length*100 %>%;width:<%= 100/plotted.length %>%"><i class="<%= v<0?'is-negative':'' %>" style="top:<%= y(Math.max(v,0)) %>%;bottom:<%= 100-y(Math.min(v,0)) %>%"></i></div><% }); %></div><div class="report-plot__axis"><% for(const i of [...new Set([plotted[0],plotted[Math.floor((plotted.length-1)/2)],plotted.at(-1)])]){ %><span><%= dayText(result.rows[i][first]) %></span><% } %></div>
  <% }else{ %><div class="report-bars"><% for(const i of plotted){ %><div class="report-bar"><span class="report-bar__label"><%= cellText(first,result.displayRows[i][first]) %></span><span class="report-bar__track"><i class="<%= value(i)<0?'is-negative':'' %>" style="width:<%= Math.max(1,Math.abs(value(i))/peak*100) %>%"></i></span><strong><%= result.displayRows[i][metric] %></strong></div><% } %></div><% } %>
</section>
<section class="report-card report-results"><h2><%= d.current?'Right now':'The numbers' %></h2><div class="sc-report-table report-table-wrap"><table><thead><tr><% for(const col of result.columns){ %><th class="<%= numeric(col)?'is-num':'' %>"><%= result.columnLabels[col]||helpers.columnLabel(col) %></th><% } %></tr></thead><tbody><% result.rows.forEach((row,i)=>{ %><tr><% for(const col of result.columns){ %><td class="<%= numeric(col)?'is-num':'' %>" data-label="<%= result.columnLabels[col]||col %>"><% if(row.href&&col===result.columns[0]){ %><a href="<%= row.href %>"><%= cellText(col,result.displayRows[i][col]) %></a><% }else{ %><%= cellText(col,result.displayRows[i][col]) %><% } %></td><% } %></tr><% }); %></tbody></table></div><p class="report-note"><%= result.rows.length %> shown<% if(result.hasMore){ %> · <a data-dest="/reports/builder?draft=1" href="/reports/business/<%= d.key %>/customize?<%= q %>">Customize to see the rest</a><% } %></p></section><% } %>
<% if(r.worst?.rows.length){ %><section class="report-card"><h2>Lowest fulfilled sales in the same period</h2><% for(const row of r.worst.rows){ %><p class="report-line-item"><span><%= row.product_variant||row.product %> · <%= row.sku||row.item_code %></span><strong><%= helpers.unitCount(row.total,'unit') %></strong></p><% } %><p class="report-note">Products with no order lines are not represented in this ranking. Returns are reported separately.</p></section><% } %>
<link rel="stylesheet" href="/reports.css?v=<%= assetVersion %>">
