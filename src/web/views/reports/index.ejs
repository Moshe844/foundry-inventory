<div class="page-head"><div><p class="eyebrow">Your business records</p><h1>Reports</h1>
<p class="lede">Build reports from your business records and trace each figure to its source.</p></div></div>
<div class="report-grid">
  <section class="report-card"><h2>New report</h2><p>Choose the records to analyze, then select columns, filters, grouping and a chart.</p>
    <% if(compositions.length){ %><p><a class="button" href="/reports/compose">Combine business records</a></p><% } %>
    <div class="report-datasets"><% for(const dataset of datasets){ %>
      <a href="/reports/builder?dataset=<%= encodeURIComponent(dataset.key) %>"><strong><%= dataset.label %></strong><span>Build report →</span></a>
    <% } %></div></section>
  <section class="report-card"><h2>Saved reports</h2>
    <% if(!saved.length){ %><p>No saved reports yet.</p><% } %>
    <p class="muted">Opening a saved report runs its current read-only query.</p>
    <% for(const report of saved){ %><article class="report-card"><a href="/reports/saved/<%= report.id %>" aria-label="Run saved report: <%= report.title %>"><%= report.title %></a>
      <%- include('delivery-actions',{report}) %>
      <% if(report.last_error){ %><small class="report-error">Delivery needs attention: <%= report.last_error %></small><% } %></article><% } %>
  </section>
</div>
<link rel="stylesheet" href="/reports.css?v=<%= assetVersion %>">
