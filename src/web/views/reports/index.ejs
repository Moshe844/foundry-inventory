<header class="sc-business-head"><div><h1>Reports</h1><p>Straight answers from your business records.</p></div><div class="sc-row-actions"><a class="btn btn--ghost" href="/reports/compose">Combine sources</a><a class="btn btn--primary" href="/reports/builder">Create custom report</a></div></header><% if(saved.length){ %><section class="report-saved" aria-label="Saved and scheduled reports"><h2>Your saved reports</h2><% for(const report of saved){ %><article class="sc-saved-report"><a href="/reports/saved/<%= report.id %>" aria-label="Open saved report: <%= report.title %>"><strong><%= report.title %></strong></a><%- include('delivery-actions',{report}) %><% if(report.last_error){ %><p class="report-error">Delivery needs attention: <%= report.last_error %></p><% } %></article><% } %></section><% } %><%- include('../accounting/customer-period',{model:businessContext,action:'/reports'}) %><div class="sc-report-cards"><% for(const card of businessCards){const q=new URLSearchParams({from:businessContext.from,to:businessContext.to}).toString(); %><a class="sc-report-card" href="/reports/business/<%= card.key %>?<%= q %>" data-business-report="<%= card.key %>"><h2><%= card.title %></h2><strong><%= card.needsReorderSetup?'Set reorder levels':card.value %></strong><span><%= card.question %></span><% if(card.hasRecords&&(card.trend.length===1||new Set(card.trend).size>1)){const lo=Math.min(0,...card.trend),hi=Math.max(1,...card.trend),points=card.trend.map((v,i)=>(5+i*190/Math.max(1,card.trend.length-1))+','+(45-(v-lo)*38/(hi-lo))).join(' '); %><svg viewBox="0 0 200 50" class="sc-sparkline" role="img" aria-label="Recorded values" data-chart-kind="<%= card.chartKind %>"><% if(card.chartKind==='line'){if(card.trend.length===1){ %><circle cx="100" cy="25" r="4" fill="currentColor"/><% }else{ %><polyline points="<%= points %>" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linejoin="round" stroke-linecap="round"/><% } }else{const baseline=45-(0-lo)*38/(hi-lo),width=180/card.trend.length;for(let i=0;i<card.trend.length;i++){const y=45-(card.trend[i]-lo)*38/(hi-lo); %><rect x="<%= 10+i*width %>" y="<%= Math.min(y,baseline) %>" width="<%= Math.min(36,Math.max(2,width-4)) %>" height="<%= Math.max(1,Math.abs(y-baseline)) %>" rx="2" fill="currentColor"/><% } } %></svg><% }else if(!card.hasRecords){ %><small>No recorded activity in this scope.</small><% } %><% if(card.note){ %><small class="is-warn"><%= card.note %></small><% } %><% if(card.needsReorderSetup){ %><b>Set reorder levels to see low stock →</b><% }else if(card.current){ %><small>Current position</small><% } %></a><% } %></div><% if(!saved.length){ %><p class="report-quiet">Reports you save appear here. Open any report to have it emailed to you each week.</p><% } %><link rel="stylesheet" href="/reports.css?v=<%= assetVersion %>">