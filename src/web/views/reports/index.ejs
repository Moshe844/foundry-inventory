<header class="sc-business-head"><div><h1>Reports</h1><p>Straight answers from your business records.</p></div><a class="btn" href="/reports/builder">Custom report</a></header><%- include('../accounting/customer-period',{model:businessContext,action:'/reports'}) %><div class="sc-report-cards"><% for(const card of businessCards){const q=new URLSearchParams({from:businessContext.from,to:businessContext.to}).toString(); %><a class="sc-report-card" href="/reports/business/<%= card.key %>?<%= q %>" data-business-report="<%= card.key %>"><span><%= card.question %></span><h2><%= card.title %></h2><strong><%= card.needsReorderSetup?'Set reorder levels':card.value %></strong><% if(card.hasRecords&&card.trend.length){const lo=Math.min(0,...card.trend),hi=Math.max(1,...card.trend),points=card.trend.map((v,i)=>(5+i*190/Math.max(1,card.trend.length-1))+','+(45-(v-lo)*38/(hi-lo))).join(' '); %><svg viewBox="0 0 200 50" class="sc-sparkline" role="img" aria-label="Recorded values" data-chart-kind="<%= card.chartKind %>"><% if(card.chartKind==='line'){if(card.trend.length===1){ %><circle cx="100" cy="25" r="4" fill="currentColor"/><% }else{ %><polyline points="<%= points %>" fill="none" stroke="currentColor" stroke-width="2.5"/><% for(let i=0;i<card.trend.length;i++){ %><circle cx="<%= 5+i*190/Math.max(1,card.trend.length-1) %>" cy="<%= 45-(card.trend[i]-lo)*38/(hi-lo) %>" r="2.5" fill="currentColor"/><% } } }else{const baseline=45-(0-lo)*38/(hi-lo),width=180/card.trend.length;for(let i=0;i<card.trend.length;i++){const y=45-(card.trend[i]-lo)*38/(hi-lo); %><rect x="<%= 10+i*width %>" y="<%= Math.min(y,baseline) %>" width="<%= Math.max(2,width-4) %>" height="<%= Math.max(1,Math.abs(y-baseline)) %>" rx="2" fill="currentColor"/><% } } %></svg><% }else{ %><small>No recorded activity in this scope.</small><% } %><% if(card.note){ %><small class="is-warn"><%= card.note %></small><% } %><small><%= card.current?'Current position · not a historical valuation':'Selected dates' %></small><b><%= card.needsReorderSetup?'Set reorder levels to see low stock →':'Open report →' %></b></a><% } %></div><section class="sc-business-card"><header><h2>Saved and scheduled reports</h2><a href="/reports/builder">Create custom report</a></header><% if(!saved.length){ %><p class="sc-empty">No saved reports yet. Open a report to set up a weekly email.</p><% } %><% for(const report of saved){ %><article class="sc-saved-report"><a href="/reports/saved/<%= report.id %>" aria-label="Open saved report: <%= report.title %>"><strong><%= report.title %></strong></a><%- include('delivery-actions',{report}) %><% if(report.last_error){ %><p>Delivery needs attention: <%= report.last_error %></p><% } %></article><% } %></section><link rel="stylesheet" href="/reports.css?v=<%= assetVersion %>">