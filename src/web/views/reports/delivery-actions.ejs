<div class="report-delivery-controls" aria-label="Report delivery controls"><p><strong><%= report.schedule_paused?'Paused':report.schedule_frequency==='none'?'On demand':report.schedule_frequency+' delivery' %></strong> · <%= report.schedule_time_zone||'UTC' %></p><p>Next send: <%= report.next_send_at&&!report.schedule_paused?helpers.dateTime(report.next_send_at):'Not scheduled' %><span class="report-sep"> · </span><br>Last sent: <%= report.last_delivered_at?helpers.dateTime(report.last_delivered_at):'Not sent yet' %></p><% if(report.latest_delivery){ %><p role="status">Latest delivery request: <strong><%= {PENDING:'Preparing or sending',SENT:'Accepted by email provider',FAILED:'Needs attention',CANCELLED:'Cancelled before sending',HELD:'Waiting for you'}[report.latest_delivery.status]||report.latest_delivery.status %></strong><% if(report.latest_delivery.status==='HELD'&&report.latest_delivery.reason){ %>: <%= report.latest_delivery.reason %><% } %><% if(report.latest_delivery.requestedAt){ %> · <%= helpers.dateTime(report.latest_delivery.requestedAt) %><% } %>. “Last sent” changes only after email acceptance is confirmed.</p><% } %>
<% if(locals.reportEmail&&report.schedule_frequency!=='none'){ const ids=report.recipient_user_ids&&report.recipient_user_ids.length?report.recipient_user_ids:[report.owner_user_id],names=ids.map(id=>(reportEmail.people.find(p=>p.id===id)||{}).name||'someone no longer in the business'); %><p data-report-recipients>Scheduled emails go to <%= names.join(', ') %>, with <%= report.attachment_format==='pdf'?'a PDF':'an Excel file' %> attached<%= reportEmail.mailbox?', from '+reportEmail.mailbox:'' %>.<% if(!reportEmail.mailbox){ %> <%= reportEmail.problem %><% } %></p><% } %>
<% if(report.latest_delivery?.id){ %><p data-report-delivery-reference="<%= report.latest_delivery.id %>">Latest report email request is saved.</p><% } %>
<div class="report-actions"><a href="/reports/<%= report.definition.dataset==='composed'?'compose':'builder' %>?saved=<%= report.id %><%= report.definition.dataset==='composed'?'':'&dataset='+encodeURIComponent(report.definition.dataset) %>">Edit report and schedule</a>
<form method="post" action="/reports/saved/<%= report.id %>/send-now"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="requestKey" value="<%= reportActionKey %>:<%= report.id %>"><button class="btn btn--sm" type="submit">Send now</button></form>
<% if(report.schedule_frequency!=='none'){ %><form method="post" action="/reports/saved/<%= report.id %>/<%= report.schedule_paused?'resume':'pause' %>"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="expectedRevision" value="<%= report.revision %>"><button class="btn btn--sm" type="submit"><%= report.schedule_paused?'Resume':'Pause' %></button></form><% } %>
<details><summary>Delete report</summary><form method="post" action="/reports/saved/<%= report.id %>/delete"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="expectedRevision" value="<%= report.revision %>"><label><input type="checkbox" name="confirmed" value="yes" required> Delete this saved report and stop future delivery. Past delivery records stay in history.</label><button class="btn btn--sm btn--danger" type="submit">Delete this report</button></form></details></div></div>
