<h1>Review supplier email updates</h1>
<p><a href="/mail/<%= message.id %>">Original message</a> · <a href="/autopilot/reviews/supplier-email-details">Supplier update history and rules</a></p>
<p>Starter does not include this job. Growth can handle matching taught work. Pro and Custom can handle routine updates inside an explicit owner-authorized scope. Every new account starts with 14 days of Watch. Day 15 does not enable automatic work.</p>
<% if(locked){ %><section class="card"><div class="card-body"><span class="badge">Growth</span><h2>Supplier email updates need Growth or above</h2><a class="btn" href="/settings/billing">Upgrade</a></div></section><% } %>
<% if(problem){ %><p role="status"><%= problem %></p><% } %>
<section class="card"><div class="card-body"><h2>Original supplier instructions</h2><p>From <%= message.sender %> · <%= message.subject %></p><pre style="white-space:pre-wrap;overflow-wrap:anywhere"><%= message.body_text %></pre></div></section>
<% if(prepared){ const p=prepared.facts; %>
<section class="card"><div class="card-body"><h2><%= p.supplierName %></h2><p>Effective date: <%= p.effectiveDate %>. Minimum quantities are counted in the stated purchase unit. Prices, pack sizes, payment terms, ordering addresses and other fields require separate review.</p>
<div style="overflow-x:auto"><table><thead><tr><th>Product</th><th>Purchase unit</th><th>Field</th><th>Current</th><th>From this email</th></tr></thead><tbody><% for(const change of p.changes){ %><tr><td><%= change.product?.code||p.supplierName %></td><td><%= change.product?change.product.purchaseUnit+' ('+change.product.unitsPerPurchaseUnit+' '+change.product.unit+')':'—' %></td><td><%= labels[change.field] %></td><td><%= change.before??'Not set' %></td><td><%= change.value %></td></tr><% } %></tbody></table></div>
<% if(receipt?.processed_at){ %><p role="status">Processed once · <%= receipt.changed_count %> fields changed. Reopening or retrying this email does not update it again.</p><p>This supplier update used 0 AI credits.</p><% }else if(!locked&&p.effectiveDate<=prepared.today){ %><form method="post" action="/mail/<%= message.id %>/supplier-details"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="expectedFingerprint" value="<%= p.sourceFingerprint %>"><% if(prepared.older){ %><p>A newer supplier source or owner edit exists. Compare the original email with the current values first.</p><label><input type="checkbox" name="overrideNewer" value="yes" required> I intentionally replace the newer record with these exact original instructions.</label><% } %><label><input type="checkbox" name="confirmed" value="yes" required> I approve these exact supplier values and purchase units.</label><button class="btn" type="submit">Apply reviewed supplier updates</button></form><% }else if(p.effectiveDate>prepared.today){ %><p>These details take effect on <%= p.effectiveDate %>. Current records stay as they are until that date. Routine work checks the current plan and authority again when due.</p><% } %>
</div></section><% } %>
<% if(setting?.enabled){ %><section class="card"><div class="card-body"><h2>Current routine authority</h2><p>Supplier and mailbox must match the saved scope. New emails only; older mail is never applied as a backlog.</p><p>Fields: <%= setting.scope.fields.map(field=>labels[field]).join(', ') %>. Products: <%= setting.scope.products.map(product=>product.code+' — '+product.purchaseUnit).join(', ')||'Contact fields only' %>.</p><p>Lead-time maximum: <%= setting.limits.maximumLeadDays %> days; maximum change: <%= setting.limits.maximumLeadChangeDays %> days. Minimum-order maximum: <%= setting.limits.maximumMoq %> purchase units; maximum change: <%= setting.limits.maximumMoqChange %> purchase units.</p><form method="post" action="/mail/<%= message.id %>/supplier-details-settings"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="revision" value="<%= setting.revision %>"><button class="btn" name="stop" value="yes">Stop routine supplier updates</button></form></div></section><% } %>
<% if(!locked&&message.supplier_id){ %><section class="card"><div class="card-body"><h2>Choose routine supplier authority</h2><p>Fill every limit explicitly. Growth also needs individually reviewed examples covering every field and product. Lower taught limits remain in force on Pro and Custom.</p><form method="post" action="/mail/<%= message.id %>/supplier-details-settings"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="revision" value="<%= setting?.revision||0 %>"><label>Source mailbox<select name="connectorId" required><option value="">Choose mailbox</option><% for(const box of mailboxes){ %><option value="<%= box.id %>" <%= setting?.scope.connectorId===box.id?'selected':'' %>><%= box.display_name %></option><% } %></select></label><fieldset><legend>Allowed supplier fields</legend><% for(const [field,label]of Object.entries(labels)){ %><label><input type="checkbox" name="fields" value="<%= field %>" <%= setting?.scope.fields.includes(field)?'checked':'' %>> <%= label %></label><% } %></fieldset><fieldset><legend>Exact supplier products (first 250)</legend><% for(const product of products){ %><label><input type="checkbox" name="skuIds" value="<%= product.sku_id %>" <%= setting?.scope.products.some(p=>p.skuId===product.sku_id)?'checked':'' %>> <%= product.code %> · <%= product.purchase_unit %> (<%= product.units_per_purchase_unit %> <%= product.unit_label %>)</label><% } %></fieldset>
<%- include('supplier-term-limits',{values:setting?.limits||{}}) %>
<label><input type="checkbox" name="confirmed" value="yes" required> I authorize only this supplier, mailbox, products, fields and limits for new routine email updates.</label><button class="btn" type="submit">Enable routine supplier updates</button></form></div></section><% } %>
<% if(canTeach&&!locked){ %><section class="card"><div class="card-body"><h2>Teach this reviewed supplier scope</h2><form method="post" action="/mail/<%= message.id %>/supplier-details-rule"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="revision" value="<%= rule?.revision||0 %>"><%- include('supplier-term-limits',{values:rule?.limits||{}}) %><label><input type="checkbox" name="confirmed" value="yes" required> I authorize only the fields and products from this individually approved email within these limits.</label><button class="btn" type="submit">Teach supplier update scope</button></form></div></section><% } %>
<% if(rule){ %><form method="post" action="/mail/<%= message.id %>/supplier-details-rule"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="revision" value="<%= rule.revision %>"><label><input type="checkbox" name="confirmed" value="yes" required> I confirm removing this learned supplier limit. Current routine settings still apply on Pro and Custom.</label><button class="btn" name="remove" value="yes">Remove learned supplier update rule</button></form><% } %>
