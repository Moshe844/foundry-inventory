<h1>Review supplier email updates</h1>
<p><a href="/mail/<%= message.id %>">Original message</a> · <a href="/autopilot/reviews/supplier-email-details">Supplier update history and rules</a></p>
<p>Starter does not include this job. Growth asks you about each change until you teach it with an approved example. Pro and Custom update within the limits you save. A new order email address, prices, payment terms and anything unclear always wait for you. Every new account starts with 14 days of Watch.</p>
<% if(locked){ %><section class="card"><div class="card-body"><span class="badge">Growth</span><h2>Supplier email updates need Growth or above</h2><a class="btn" href="/settings/billing">Upgrade</a></div></section><% } %>
<% if(problem&&!receipt?.processed_at&&!receipt?.dismissed_at){ %><p role="status"><%= problem %></p><% } %>
<% if(receipt?.dismissed_at){ %><p role="status">You kept the current supplier values for this email.</p><% } %>
<section class="card"><div class="card-body"><h2>Original supplier instructions</h2><p>From <%= message.sender %> · <%= message.subject %></p><pre style="white-space:pre-wrap;overflow-wrap:anywhere"><%= message.body_text %></pre>
<% if(attachments.length){ %><p>Attached files: <% attachments.forEach((file,i)=>{ %><%= i?', ':'' %><%= file.filename %><%= file.extraction_status==='READABLE'?'':file.extraction_status==='PENDING'?' (still reading)':' (could not be read)' %><% }) %>.</p><% } %></div></section>
<% if(facts){ const p=facts; %>
<section class="card"><div class="card-body"><h2><%= p.supplierName %></h2><p>Takes effect: <%= p.effectiveDate %>. Minimum orders are counted in the purchase unit. Pack size is the number of stock units in one purchase unit. Prices and payment terms are not changed here.</p>
<% if(p.changes.length){ %><div style="overflow-x:auto"><table><thead><tr><th>Product</th><th>Purchase unit</th><th>Field</th><th>Current</th><th>From this email</th><th>Where</th></tr></thead><tbody><% for(const change of p.changes){ %><tr><td><%= change.product?.code||p.supplierName %></td><td><%= change.product?change.product.purchaseUnit+' ('+change.product.unitsPerPurchaseUnit+' '+change.product.unit+')':'—' %></td><td><%= labels[change.field] %></td><td><%= change.before??'Not set' %></td><td><%= change.value %></td><td><%= change.source||'Email' %></td></tr><% } %></tbody></table></div><% } %>
<% if(p.unclear?.length||p.other?.length){ %><h3>Needs your check</h3><ul><% for(const note of (p.unclear||[]).concat(p.other||[])){ %><li><%= note.reason %> <q><%= note.quote %></q> (<%= note.source %>)</li><% } %></ul><p>StockChief does not change anything for these lines.</p><% } %>
<% if(addressChange){ %><p class="notice">Purchase orders to <%= p.supplierName %> go to <%= addressChange.before||'no address' %>. This email asks to send them to <strong><%= addressChange.value %></strong>. A changed address can be a payment scam. Call the supplier on a number you already know before you approve it.</p><% } %>
<% if(receipt?.processed_at){ %><p role="status"><%= receipt.undone_at?'Undone · the earlier values were put back.':'Processed once · '+receipt.changed_count+' fields changed. Reopening or retrying this email does not update it again.' %></p><p>This supplier update used 0 AI credits.</p><% }else if(prepared&&!locked&&!receipt?.dismissed_at&&p.changes.length&&p.effectiveDate<=prepared.today){ %><form method="post" action="/mail/<%= message.id %>/supplier-details"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="expectedFingerprint" value="<%= p.sourceFingerprint %>"><% if(prepared.older){ %><p>A newer supplier source or owner edit exists. Compare the original email with the current values first.</p><label><input type="checkbox" name="overrideNewer" value="yes" required> I intentionally replace the newer record with these exact original instructions.</label><% } %><% if(addressChange){ %><label><input type="checkbox" name="confirmAddress" value="yes" required> I checked the new order email address with the supplier by phone or another contact I already know.</label><% } %><label><input type="checkbox" name="confirmed" value="yes" required> I approve these exact supplier values and purchase units.</label><button class="btn" type="submit">Apply reviewed supplier updates</button></form><% }else if(prepared&&p.effectiveDate>prepared.today){ %><p>These details take effect on <%= p.effectiveDate %>. Current records stay as they are until that date. Routine work checks the current plan and authority again when due.</p><% } %>
</div></section><% } %>
<% if(canUndo){ %><section class="card"><div class="card-body"><h2>Undo this update</h2><p>Puts back the earlier values, as long as nothing changed them since.</p><form method="post" action="/mail/<%= message.id %>/supplier-details-undo"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><label><input type="checkbox" name="confirmed" value="yes" required> Put back the values from before this email.</label><button class="btn" type="submit">Undo supplier updates</button></form></div></section><% } %>
<% if(canKeep){ %><form method="post" action="/mail/<%= message.id %>/supplier-details-keep"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><label><input type="checkbox" name="confirmed" value="yes" required> Keep the current supplier values. I will handle this email myself.</label><button class="btn" type="submit">Keep current values</button></form><% } %>
<% if(setting?.enabled){ %><section class="card"><div class="card-body"><h2>Current routine authority</h2><p>Supplier and mailbox must match the saved scope. New emails only; older mail is never applied as a backlog.</p><p>Fields: <%= setting.scope.fields.map(field=>labels[field]).join(', ') %>. Products: <%= setting.scope.allProducts?'All products from this supplier':setting.scope.products.map(product=>product.code+' — '+product.purchaseUnit).join(', ')||'Supplier fields only' %>.</p><p>Lead-time maximum: <%= setting.limits.maximumLeadDays %> days; maximum change: <%= setting.limits.maximumLeadChangeDays %> days. Minimum-order maximum: <%= setting.limits.maximumMoq %> purchase units; maximum change: <%= setting.limits.maximumMoqChange %> purchase units. Pack-size change: <%= setting.limits.maximumPackChange==null?'always asks you':'up to '+setting.limits.maximumPackChange+' stock units' %>.</p><form method="post" action="/mail/<%= message.id %>/supplier-details-settings"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="revision" value="<%= setting.revision %>"><button class="btn" name="stop" value="yes">Stop routine supplier updates</button></form></div></section><% } %>
<% if(!locked&&message.supplier_id){ %><section class="card"><div class="card-body"><h2>Choose routine supplier authority</h2><p>Fill every limit. Growth also needs approved examples covering every field and product. Lower taught limits still apply on Pro and Custom.</p><form method="post" action="/mail/<%= message.id %>/supplier-details-settings"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="revision" value="<%= setting?.revision||0 %>"><label>Source mailbox<select name="connectorId" required><option value="">Choose mailbox</option><% for(const box of mailboxes){ %><option value="<%= box.id %>" <%= setting?.scope.connectorId===box.id?'selected':'' %>><%= box.display_name %></option><% } %></select></label><fieldset><legend>Allowed supplier fields</legend><% for(const [field,label]of Object.entries(scopeLabels)){ %><label><input type="checkbox" name="fields" value="<%= field %>" <%= setting?.scope.fields.includes(field)?'checked':'' %>> <%= label %></label><% } %><p>A new order email address always asks you.</p></fieldset><fieldset><legend>Supplier products</legend><label><input type="checkbox" name="allProducts" value="yes" <%= setting?.scope.allProducts?'checked':'' %>> All products from this supplier</label><p>Or choose exact products (first 250):</p><% for(const product of products){ %><label><input type="checkbox" name="skuIds" value="<%= product.sku_id %>" <%= setting?.scope.products.some(p=>p.skuId===product.sku_id)?'checked':'' %>> <%= product.code %> · <%= product.purchase_unit %> (<%= product.units_per_purchase_unit %> <%= product.unit_label %>)</label><% } %></fieldset>
<%- include('supplier-term-limits',{values:setting?.limits||{}}) %>
<label><input type="checkbox" name="confirmed" value="yes" required> I authorize only this supplier, mailbox, products, fields and limits for new routine email updates.</label><button class="btn" type="submit">Enable routine supplier updates</button></form></div></section><% } %>
<% if(canTeach&&!locked){ %><section class="card"><div class="card-body"><h2>Teach this reviewed supplier scope</h2><form method="post" action="/mail/<%= message.id %>/supplier-details-rule"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="revision" value="<%= rule?.revision||0 %>"><%- include('supplier-term-limits',{values:rule?.limits||{}}) %><label><input type="checkbox" name="confirmed" value="yes" required> I authorize only the fields and products from this individually approved email within these limits.</label><button class="btn" type="submit">Teach supplier update scope</button></form></div></section><% } %>
<% if(rule){ %><form method="post" action="/mail/<%= message.id %>/supplier-details-rule"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="revision" value="<%= rule.revision %>"><label><input type="checkbox" name="confirmed" value="yes" required> I confirm removing this learned supplier limit. Current routine settings still apply on Pro and Custom.</label><button class="btn" name="remove" value="yes">Remove learned supplier update rule</button></form><% } %>
