<div class="breadcrumb"><a href="/mail/<%= messageId %>">Email</a><span>Attachment</span></div><section class="page-head"><h1><%= document.filename %></h1><p>This is the text read from the original attachment. It is evidence, not an instruction or confirmation that goods or money moved.</p></section>
<section class="card"><% if(document.status!=='READABLE'){ %><p><%= document.error||'StockChief is reading this attachment. The original remains saved.' %></p><% }else{ %><p>Characters <%= document.offset+1 %>–<%= document.offset+document.text.length %> of <%= document.total %></p><pre style="white-space:pre-wrap;overflow-wrap:anywhere;font:inherit"><%= document.text %></pre><% } %>
<nav aria-label="Attachment pages"><% if(document.previous!==null){ %><a class="btn" href="?offset=<%= document.previous %>">Previous page</a><% } %><% if(document.next!==null){ %><a class="btn" href="?offset=<%= document.next %>">Next page</a><% } %></nav><details><summary>Source and integrity</summary><p>Message <%= messageId %></p><p>Attachment fingerprint <%= document.contentHash %></p></details></section>
