<p class="rm-stamp"><a href="/mail">Mail</a> · <%= message.display_name %></p><h1 class="rm-verdict"><%= message.subject || '(No subject)' %></h1>
<p class="rm-sub">From <%= message.sender %> · <%= message.received_at %> · <%= message.classification %></p>
<article class="section"><p class="rm-prose"><%= message.body_text || 'This message had no plain-text body.' %></p></article>
<section class="section"><div class="section-head"><h2>Reply</h2></div><p class="rm-sub">Saving and sending are separate. StockChief sends exactly the approved text below and never retries an uncertain provider outcome automatically.</p>
  <% if(message.outbox_status==='AMBIGUOUS'){ %><div class="quiet-note">Delivery could not be verified. StockChief did not retry and will not send another reply for this message. Check the mailbox Sent folder, then mark the conversation waiting or handled.</div><% } %>
  <% if(message.outbox_status==='FAILED'){ %><div class="quiet-note">The mailbox provider refused the last send. Nothing was reported as sent; review the connection before trying again.</div><% } %>
  <% if(message.outbox_status==='SENDING'){ %><div class="quiet-note">The send outcome is still being checked. StockChief will not start another send for this message.</div><% } %>
  <% if(message.outbox_status==='PENDING'){ %><div class="quiet-note">Reply queued securely. A separate worker will contact the mailbox provider; nothing is marked sent yet.</div><% } %>
  <% if(message.reply_sent_at){ %><div class="quiet-note">Reply sent and verified at <%= message.reply_sent_at %>. This message is waiting on them.</div><% } else if(!['PENDING','SENDING','AMBIGUOUS'].includes(message.outbox_status)){ %><form method="post" action="/mail/<%= message.id %>/draft" class="stacked-form"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><label>Subject<input name="subject" value="<%= message.draft_subject || ('Re: '+(message.subject || 'Your message')) %>" required></label><label>Reply<textarea name="body" rows="8" required><%= message.draft_body || '' %></textarea></label><div class="rm-choices"><button class="rm-btn rm-btn--ghost" type="submit" name="action" value="save">Save draft</button><button class="rm-btn" type="submit" name="action" value="send">Send exact reply</button></div></form><% } %>
</section>
<section class="section"><div class="section-head"><h2>Sort this conversation</h2></div><form method="post" action="/mail/<%= message.id %>/state" class="inline-form"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><label>State<select name="state"><% drawers.forEach(function(drawer){ %><option value="<%= drawer.state %>" <%= drawer.state===message.reply_state?'selected':'' %>><%= drawer.label %></option><% }) %></select></label><label>Reason<input name="reason" value="<%= message.reply_reason || '' %>"></label><button class="rm-btn rm-btn--ghost" type="submit">Update state</button></form></section>
