<p class="rm-stamp">Business mail only</p><h1 class="rm-verdict"><%= counts.NEEDS_REPLY || 0 %> message<%= (counts.NEEDS_REPLY||0)===1?' needs':'s need' %> a reply.</h1>
<p class="rm-prose">Only mail from a customer or supplier address on file appears here. Unrelated inbox mail is not stored in StockChief.</p>
<p class="rm-disclose"><% drawers.forEach(function(item){ %><a class="<%= item.key===drawer.key?'is-active':'' %>" href="/mail?show=<%= item.key %>"><%= item.label %> (<%= counts[item.state] || 0 %>)</a><% }) %></p>
<section class="section"><div class="section-head"><h2><%= drawer.label %></h2></div><% if(!messages.length){ %><div class="quiet-note">Nothing in this drawer.</div><% } else { %><div class="rm-feed"><% messages.forEach(function(message){ %><a class="rm-feed__row" href="/mail/<%= message.id %>"><span class="rm-feed__ic">✉</span><span class="rm-feed__t"><%= message.subject || '(No subject)' %><small><%= message.sender %> · <%= message.display_name %></small></span><span class="rm-feed__m"><%= message.received_at %></span></a><% }) %></div><% } %></section>
