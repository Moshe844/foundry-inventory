<%
  /*
   * One message, and the only three things anybody does with it.
   *
   * The body is shown as it arrived. Replies remain editable and never send
   * without the operator pressing Send.
   */
  var m = message;
  var productionMail = typeof productionMail !== 'undefined' && productionMail;
  var allowReplyChanges = !productionMail || Boolean(locals.canWriteReply);
  var sending = m.outbox_status === 'PENDING' || m.outbox_status === 'SENDING';
  var attachmentOnlyReplyState = productionMail && attachments.length > 0 && m.reply_state === 'HANDLED' && !m.decidedByPerson && !m.reply_sent_at && !sending && m.outbox_status !== 'AMBIGUOUS';
  var visibleReplyState = attachmentOnlyReplyState ? 'No reply requested' : m.stateWords;
  var badge = sending || attachmentOnlyReplyState ? 'info' : { NEEDS_REPLY: 'warn', WAITING: 'info', HANDLED: 'ok' }[m.reply_state];
%>
<div class="breadcrumb">
  <a href="/mail">Mail</a>
  <%- helpers.icon('chevron', { size: 13 }) %>
  <span><%= m.subject || 'No subject' %></span>
</div>
<% if(typeof productionMail!=='undefined'&&productionMail&&message.native_review_goal_id){ %><section class="card"><div class="card-body"><h2>StockChief’s document review</h2><p>This supplier document has a saved agent request under your existing authority. Open it for its current status, required approvals and verified outcomes.</p><a class="btn" href="/ask?goal=<%= message.native_review_goal_id %>#focused-goal">Open this review</a></div></section><% }else if(typeof productionMail!=='undefined'&&productionMail&&message.native_review_state==='NEEDS_REVIEW'){ %><div class="notice notice--warn"><strong>This document needs attention</strong><p><%= message.native_review_reason %></p></div><% } %>
<div class="page-head">
  <div>
    <h1><%= m.subject || 'No subject' %> <span class="badge badge--<%= badge %>"><%= visibleReplyState %></span></h1>
    <p class="page-sub">
      From <%= m.sender %><% if (m.supplier_name) { %> · <%= m.supplier_name %><% } %>
      · <%= helpers.dateTime(m.received_at) %>
      · arrived in <%= m.connector_name %>
    </p>
  </div>
  <% if (allowReplyChanges && m.reply_state === 'NEEDS_REPLY' && !sending && m.outbox_status !== 'AMBIGUOUS' && !(draft && draft.sentAt)) { %>
    <a class="btn btn--primary" href="#reply">Reply now</a>
  <% } %>
</div>

<div class="notice notice--<%= m.reply_state === 'NEEDS_REPLY' && !sending ? 'warn' : 'info' %>">
  <div>
    <strong><%= sending ? 'StockChief is sending your approved reply.' : m.decidedByPerson ? 'You put this in ' + m.stateWords.toLowerCase() + '.' : visibleReplyState + '.' %></strong><br>
    <%= sending ? 'No second reply or manual filing is needed. The conversation will move to Waiting on them after provider verification.' : attachmentOnlyReplyState ? 'StockChief received the attachments. Check their reading status and any document review below.' : m.reply_reason %>
  </div>
</div>

<% if (m.outbox_status === 'PENDING' || m.outbox_status === 'SENDING') { %>
  <div class="notice notice--info"><div><strong>Reply queued securely.</strong><br>The mailbox worker is verifying delivery. StockChief will not report it sent before the provider confirms it.</div></div>
<% } else if (m.outbox_status === 'AMBIGUOUS') { %>
  <div class="notice notice--warn"><div><strong>Delivery could not be verified.</strong><br>StockChief did not retry and will not send another copy. Check the mailbox Sent folder, then mark the conversation appropriately.</div></div>
<% } else if (m.outbox_status === 'FAILED') { %>
  <div class="notice notice--warn"><div><strong>The mailbox provider refused the last send.</strong><br>Nothing was reported as sent. Review the connection and revise the draft before trying again.</div></div>
<% } else if (m.reply_sent_at) { %>
  <div class="notice notice--ok"><div><strong>Reply sent and verified.</strong><br>This conversation is waiting on them.</div></div>
<% } %>

<section class="section">
  <div class="panel">
    <div class="panel-head">
      <div>
        <h2>What they wrote</h2>
        <% if (m.trust_status !== 'TRUSTED') { %>
          <span class="t-xs t-muted">
            This sender is not one StockChief treats as evidence — nothing in it changed any record.
          </span>
        <% } %>
      </div>
    </div>
    <div class="card-body">
      <% if (m.body_text) { %>
        <pre class="message-body"><%= m.body_text %></pre>
      <% } else { %>
        <p class="empty">This message had no text in it.</p>
      <% } %>

      <% if (attachments.length) { %>
        <div id="attachments" <% if(typeof attachmentReading!=='undefined'){ %>data-mail-attachments data-status-url="/mail/<%= message.id %>/attachments/status"<% } %>>
        <h3 class="t-sm" style="margin-top:18px;">Attached</h3>
        <ul class="plain-list">
          <% attachments.forEach(function (file) { %>
            <li style="overflow-wrap:anywhere">
              <%= file.filename %>
              <% if(typeof attachmentReading!=='undefined'){ %><span class="tag tag--quiet" data-attachment-state="<%= file.id %>"><%= file.extraction_status==='READABLE'?'Ready to read':attachmentReading.active?'Reading':'Needs review' %></span><% } %>
                <% if(typeof productionMail!=='undefined'&&productionMail){ %> · <a href="/mail/<%= message.id %>/attachments/<%= file.id %>/text">Read attachment</a><% } %>
              <% if (file.mime_type) { %><span class="t-xs t-muted"> · <%= file.mime_type %></span><% } %>
            </li>
          <% }) %>
        </ul>
        <p class="hint">
          <% if(typeof attachmentReading!=='undefined'){ %><span role="status" aria-live="polite" data-attachment-progress><%= attachmentReading.active?'Reading attached documents. ':attachmentReading.stopped?'Reading stopped. ':'' %><%= attachmentReading.ready %> of <%= attachmentReading.total %> documents ready.</span><br><% } %>
          What StockChief did with these is on
          <a href="/settings/connections/<%= m.connector_id %>#message-<%= m.id %>">the mailbox connection</a>.
        </p>
        <% if(typeof attachmentReading!=='undefined'&&typeof canWriteReply!=='undefined'&&canWriteReply){ %><form method="post" action="/mail/<%= message.id %>/attachments/recheck"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="btn btn--ghost" data-attachment-recheck type="submit" <%= attachmentReading.active?'disabled':'' %>>Read saved attachments again</button></form><% } %>
        </div>
        <% if(typeof attachmentReading!=='undefined'){ %><script src="/mail-attachments.js?v=<%= assetVersion %>" defer></script><% } %>
      <% } %>
    </div>
  </div>
</section>

<% if (prepared && (prepared.order || prepared.because)) { %>
  <%
    /*
     * What StockChief did about this before anybody read it.
     *
     * A draft order is not a decision — it is the work done, waiting for one.
     * And when there is no draft, the reason belongs here just as much: an
     * order email that quietly produced nothing is the failure the owner most
     * needs to hear about.
     */
  %>
  <section class="section">
    <div class="panel">
      <div class="panel-head"><div><h2>What StockChief prepared</h2></div></div>
      <div class="card-body">
        <% if (prepared.order) { %>
          <p class="lede">
            <a href="/sales/orders/<%= prepared.order.id %>"><%= prepared.order.order_number %></a>
            for <%= prepared.order.customer_name %>, read out of this email.
          </p>
          <p class="hint">
            <% if (prepared.order.status === 'DRAFT') { %>
              It is a draft. Nothing is committed, no stock is held and no reply has been sent —
              approve it, change it, or throw it away.
            <% } else { %>
              You have since taken this order to <%= prepared.order.status.toLowerCase() %>.
            <% } %>
          </p>
        <% } else { %>
          <p class="lede">StockChief did not turn this into an order.</p>
          <p class="hint"><%= prepared.because %></p>
        <% } %>
      </div>
      <% if (!prepared.order && m.classification === 'customer_order_request') { %>
        <div class="card-foot">
          <form method="post" action="/mail/<%= m.id %>/reread" data-busy>
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <button class="btn" type="submit">Read it as an order again</button>
          </form>
        </div>
      <% } %>
    </div>
  </section>
<% } %>

<% if(productionMail){ %><p><a class="btn btn--ghost" href="/ask?from=<%= encodeURIComponent('/mail/'+m.id) %>">Review with Ask StockChief</a></p><% } %>
<section class="section" id="reply">
  <div class="panel">
    <div class="panel-head">
      <div>
        <h2><%= draft ? 'The reply' : 'Reply to this' %></h2>
        <% if (draft && draft.sentAt) { %>
          <span class="t-xs t-muted">Sent <%= helpers.dateTime(draft.sentAt) %></span>
        <% } else if (draft) { %>
          <span class="t-xs t-muted">
            <%= draft.source === 'model' ? 'Written by StockChief from your records'
              : draft.source === 'person' ? 'Your words'
              : 'Unsent draft—verify the details' %> · nothing has been sent
          </span>
        <% } %>
      </div>
    </div>

    <% if (draft && draft.rejected) { %>
      <div class="card-body">
        <div class="notice notice--warn"><div>
          <strong>StockChief wrote a reply and threw it away.</strong><br>
          It was rejected because <%= draft.rejected %>. The previous unsent draft remains unchanged.
        </div></div>
      </div>
    <% } %>

    <% if (draft && draft.sentAt) { %>
      <div class="card-body">
        <p class="t-sm"><strong><%= draft.subject %></strong></p>
        <pre class="message-body"><%= draft.body %></pre>
      </div>
    <% } else if (draft && !sending && m.outbox_status !== 'AMBIGUOUS' && allowReplyChanges && (!productionMail || m.reply_state === 'NEEDS_REPLY')) { %>
      <form method="post" action="/mail/<%= m.id %>/draft" data-busy>
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <div class="card-body">
          <label class="field">
            <span class="field-label">Subject</span>
            <input class="input" type="text" name="subject" value="<%= draft.subject %>">
          </label>
          <label class="field">
            <span class="field-label">Reply</span>
            <textarea class="input textarea message-edit" name="body" rows="14"><%= draft.body %></textarea>
            <span class="field-hint">
              You write and approve this reply. Check its facts before sending it.
            </span>
          </label>
        </div>
        <div class="card-foot">
          <button class="btn btn--primary" type="submit" name="action" value="send">
            Send to <%= m.sender %>
          </button>
          <button class="btn" type="submit" name="action" value="save">Save for later</button>
          <% if (!productionMail) { %><button class="btn btn--ghost" type="submit" name="action" value="write">Write it again</button><% } %>
          <% if(productionMail && canImproveDraft && draft.source !== 'person' && m.reply_state === 'NEEDS_REPLY'){ %>
            <button class="btn btn--ghost" type="submit" name="action" value="improve">Prepare from verified records</button>
          <% } %>
        </div>
      </form>
    <% } else if (productionMail && !sending && m.outbox_status !== 'AMBIGUOUS' && allowReplyChanges && m.reply_state === 'NEEDS_REPLY') { %>
      <div class="card-body">
        <p class="lede"><%= ['PENDING','RETRY','RUNNING'].includes(m.draft_job_status)
          ? 'StockChief is preparing a reply from this message and your verified records.'
          : 'No reply has been prepared for ' + m.sender + ' yet.' %></p>
        <p class="hint">Read their message above. You can leave it for later, write your own reply, or ask StockChief to prepare one from the message and verified records. Nothing is sent without your approval.</p>
        <% if (['DEAD','PAUSED'].includes(m.draft_job_status) || (m.draft_job_status === 'COMPLETED' && m.draft_job_skip)) { %><p class="hint">Automatic drafting stopped without a verified reply. You can write one yourself<% if (canImproveDraft) { %> or try preparing it again<% } %>.</p><% } %>
      </div>
      <form method="post" action="/mail/<%= m.id %>/draft" data-busy>
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <div class="card-body">
          <label class="field"><span class="field-label">Subject</span><input class="input" type="text" name="subject" value="<%= m.subject && /^re:/i.test(m.subject) ? m.subject : 'Re: ' + (m.subject || 'Your message') %>" required></label>
          <label class="field"><span class="field-label">Your reply</span><textarea class="input textarea message-edit" name="body" rows="10" required></textarea></label>
        </div>
        <div class="card-foot">
          <button class="btn btn--primary" type="submit" name="action" value="send">Send to <%= m.sender %></button>
          <button class="btn" type="submit" name="action" value="save">Save for later</button>
          <% if (canImproveDraft && m.reply_state === 'NEEDS_REPLY') { %>
            <button class="btn btn--ghost" type="submit" name="action" value="improve" formnovalidate>Prepare from verified records</button>
          <% } %>
          <a class="btn btn--ghost" href="/mail">Read only—back to mail</a>
        </div>
      </form>
    <% } else if (!productionMail && !sending && m.outbox_status !== 'AMBIGUOUS') { %>
      <div class="card-body"><p class="lede">StockChief can draft this from what it holds about <%= m.sender %>.</p></div>
      <div class="card-foot">
        <form method="post" action="/mail/<%= m.id %>/draft" data-busy>
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <button class="btn btn--primary" type="submit" name="action" value="write">Draft a reply</button>
        </form>
      </div>
    <% } else if (productionMail && !allowReplyChanges) { %>
      <div class="card-body">
        <p class="hint">You can read this message<%= draft ? ' and its unsent draft' : '' %>. Your inventory access does not allow you to draft, send, or file replies.</p>
        <% if (draft) { %><p class="t-sm"><strong><%= draft.subject %></strong></p><pre class="message-body"><%= draft.body %></pre><% } %>
      </div>
    <% } else if (productionMail && m.reply_state !== 'NEEDS_REPLY' && !m.reply_sent_at) { %>
      <div class="card-body"><p class="hint">This conversation is not awaiting a reply. If that changes, mark it “Still needs a reply” below before composing.</p></div>
    <% } %>
  </div>
</section>

<% if (!sending && allowReplyChanges) { %><section class="section">
  <div class="panel">
    <div class="panel-head"><div><h2>Where this belongs</h2></div></div>
    <form method="post" action="/mail/<%= m.id %>/state" data-busy>
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <div class="card-body">
        <label class="field">
          <span class="field-label">Why <span class="t-muted">(optional)</span></span>
          <input class="input" type="text" name="reason"
            placeholder="Phoned them instead — they are sending two replacement cartons">
          <span class="field-hint">
            Kept with the message, so the next person to open it knows what happened.
          </span>
        </label>
      </div>
      <div class="card-foot">
        <% drawers.filter(function (entry) { return entry.state !== 'SENDING' && entry.state !== 'UNCERTAIN'; }).forEach(function (entry) { %>
          <% if (entry.state !== m.reply_state) { %>
            <button class="btn <%= entry.state === 'NEEDS_REPLY' ? '' : 'btn--primary' %>"
              type="submit" name="state" value="<%= entry.state %>">
              <%= entry.state === 'NEEDS_REPLY' ? 'Still needs a reply'
                : entry.state === 'WAITING' ? 'I answered — waiting on them'
                : 'Dismiss — no reply needed' %>
            </button>
          <% } %>
        <% }) %>
      </div>
    </form>
  </div>
  <p class="section-foot t-muted">
    Sending a reply moves this to waiting on them by itself. These are for when you
    answered somewhere else, or when nothing is owed.
  </p>
</section>
<% } %>
