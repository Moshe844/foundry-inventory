<%
  /*
   * One message, and the only three things anybody does with it.
   *
   * The body is shown as it arrived. StockChief offers no reply here, and the
   * page says so plainly rather than leaving somebody hunting for a button
   * that does not exist.
   */
  var m = message;
  var badge = { NEEDS_REPLY: 'warn', WAITING: 'info', HANDLED: 'ok' }[m.reply_state];
%>
<div class="breadcrumb">
  <a href="/mail">Mail</a>
  <%- helpers.icon('chevron', { size: 13 }) %>
  <span><%= m.subject || 'No subject' %></span>
</div>

<div class="page-head">
  <div>
    <h1><%= m.subject || 'No subject' %> <span class="badge badge--<%= badge %>"><%= m.stateWords %></span></h1>
    <p class="page-sub">
      From <%= m.sender %><% if (m.supplier_name) { %> · <%= m.supplier_name %><% } %>
      · <%= helpers.dateTime(m.received_at) %>
      · arrived in <%= m.connector_name %>
    </p>
  </div>
  <% if (m.reply_state === 'NEEDS_REPLY' && !(draft && draft.sentAt)) { %>
    <a class="btn btn--primary" href="#reply">Reply now</a>
  <% } %>
</div>

<div class="notice notice--<%= m.reply_state === 'NEEDS_REPLY' ? 'warn' : 'info' %>">
  <div>
    <strong><%= m.decidedByPerson ? 'You put this in ' + m.stateWords.toLowerCase() + '.' : m.stateWords + '.' %></strong><br>
    <%= m.reply_reason %>
  </div>
</div>

<% if (m.outbox_status === 'PENDING' || m.outbox_status === 'SENDING') { %>
  <div class="notice notice--info"><div><strong>Reply queued securely.</strong><br>The mailbox worker is verifying delivery. StockChief will not report it sent before the provider confirms it.</div></div>
<% } else if (m.outbox_status === 'AMBIGUOUS') { %>
  <div class="notice notice--warn"><div><strong>Delivery could not be verified.</strong><br>StockChief did not retry and will not send another copy. Check the mailbox Sent folder, then mark the conversation appropriately.</div></div>
<% } else if (m.outbox_status === 'FAILED') { %>
  <div class="notice notice--warn"><div><strong>The mailbox provider refused the last send.</strong><br>Nothing was reported as sent. Review the connection before trying again.</div></div>
<% } else if (m.reply_sent_at) { %>
  <div class="notice notice--ok"><div><strong>Reply sent and verified.</strong><br>This conversation is waiting on them.</div></div>
<% } %>

<section class="section">
  <div class="panel">
    <div class="panel-head">
      <div>
        <h2>What they wrote</h2>
        <% if (m.trust_status !== 'TRUSTED') { %>
          <span class="t-xs t-muted">
            This sender is not one StockChief treats as evidence — nothing in it changed any record.
          </span>
        <% } %>
      </div>
    </div>
    <div class="card-body">
      <% if (m.body_text) { %>
        <pre class="message-body"><%= m.body_text %></pre>
      <% } else { %>
        <p class="empty">This message had no text in it.</p>
      <% } %>

      <% if (attachments.length) { %>
        <h3 class="t-sm" style="margin-top:18px;">Attached</h3>
        <ul class="plain-list">
          <% attachments.forEach(function (file) { %>
            <li>
              <%= file.filename %>
              <% if (file.mime_type) { %><span class="t-xs t-muted"> · <%= file.mime_type %></span><% } %>
            </li>
          <% }) %>
        </ul>
        <p class="hint">
          What StockChief did with these is on
          <a href="/settings/connections/<%= m.connector_id %>#message-<%= m.id %>">the mailbox connection</a>.
        </p>
      <% } %>
    </div>
  </div>
</section>

<% if (prepared && (prepared.order || prepared.because)) { %>
  <%
    /*
     * What StockChief did about this before anybody read it.
     *
     * A draft order is not a decision — it is the work done, waiting for one.
     * And when there is no draft, the reason belongs here just as much: an
     * order email that quietly produced nothing is the failure the owner most
     * needs to hear about.
     */
  %>
  <section class="section">
    <div class="panel">
      <div class="panel-head"><div><h2>What StockChief prepared</h2></div></div>
      <div class="card-body">
        <% if (prepared.order) { %>
          <p class="lede">
            <a href="/sales/orders/<%= prepared.order.id %>"><%= prepared.order.order_number %></a>
            for <%= prepared.order.customer_name %>, read out of this email.
          </p>
          <p class="hint">
            <% if (prepared.order.status === 'DRAFT') { %>
              It is a draft. Nothing is committed, no stock is held and no reply has been sent —
              approve it, change it, or throw it away.
            <% } else { %>
              You have since taken this order to <%= prepared.order.status.toLowerCase() %>.
            <% } %>
          </p>
        <% } else { %>
          <p class="lede">StockChief did not turn this into an order.</p>
          <p class="hint"><%= prepared.because %></p>
        <% } %>
      </div>
      <% if (!prepared.order && m.classification === 'customer_order_request') { %>
        <div class="card-foot">
          <form method="post" action="/mail/<%= m.id %>/reread" data-busy>
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <button class="btn" type="submit">Read it as an order again</button>
          </form>
        </div>
      <% } %>
    </div>
  </section>
<% } %>

<section class="section" id="reply">
  <div class="panel">
    <div class="panel-head">
      <div>
        <h2><%= draft ? 'The reply' : 'Reply to this' %></h2>
        <% if (draft && draft.sentAt) { %>
          <span class="t-xs t-muted">Sent <%= helpers.dateTime(draft.sentAt) %></span>
        <% } else if (draft) { %>
          <span class="t-xs t-muted">
            <%= draft.source === 'model' ? 'Written by StockChief from your records'
              : draft.source === 'person' ? 'Your words'
              : 'Built from your records' %> · nothing has been sent
          </span>
        <% } %>
      </div>
    </div>

    <% if (draft && draft.rejected) { %>
      <div class="card-body">
        <div class="notice notice--warn"><div>
          <strong>StockChief wrote a reply and threw it away.</strong><br>
          It was rejected because <%= draft.rejected %>. What is below uses your records only,
          so it is duller and it is true. Edit it however you like before sending.
        </div></div>
      </div>
    <% } %>

    <% if (draft && draft.sentAt) { %>
      <div class="card-body">
        <p class="t-sm"><strong><%= draft.subject %></strong></p>
        <pre class="message-body"><%= draft.body %></pre>
      </div>
    <% } else if (draft) { %>
      <form method="post" action="/mail/<%= m.id %>/draft" data-busy>
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <div class="card-body">
          <label class="field">
            <span class="field-label">Subject</span>
            <input class="input" type="text" name="subject" value="<%= draft.subject %>">
          </label>
          <label class="field">
            <span class="field-label">Reply</span>
            <textarea class="input textarea message-edit" name="body" rows="14"><%= draft.body %></textarea>
            <span class="field-hint">
              StockChief may only use figures and dates that are already in your records. Anything
              it wrote that was not is gone before you saw it — but you are the one sending this,
              so read it.
            </span>
          </label>
        </div>
        <div class="card-foot">
          <button class="btn btn--primary" type="submit" name="action" value="send">
            Send to <%= m.sender %>
          </button>
          <button class="btn" type="submit" name="action" value="save">Save for later</button>
          <button class="btn btn--ghost" type="submit" name="action" value="write">Write it again</button>
        </div>
      </form>
    <% } else { %>
      <div class="card-body">
        <p class="lede">StockChief can draft this from what it holds about <%= m.sender %>.</p>
        <p class="hint">
          It reads their orders, shipments, tracking and balances first, and may only use
          figures and dates that are already there. Nothing is sent until you send it.
        </p>
      </div>
      <div class="card-foot">
        <form method="post" action="/mail/<%= m.id %>/draft" data-busy>
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <button class="btn btn--primary" type="submit" name="action" value="write">Draft a reply</button>
        </form>
      </div>
    <% } %>
  </div>
</section>

<section class="section">
  <div class="panel">
    <div class="panel-head"><div><h2>Where this belongs</h2></div></div>
    <form method="post" action="/mail/<%= m.id %>/state" data-busy>
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <div class="card-body">
        <label class="field">
          <span class="field-label">Why <span class="t-muted">(optional)</span></span>
          <input class="input" type="text" name="reason"
            placeholder="Phoned them instead — they are sending two replacement cartons">
          <span class="field-hint">
            Kept with the message, so the next person to open it knows what happened.
          </span>
        </label>
      </div>
      <div class="card-foot">
        <% drawers.forEach(function (entry) { %>
          <% if (entry.state !== m.reply_state) { %>
            <button class="btn <%= entry.state === 'NEEDS_REPLY' ? '' : 'btn--primary' %>"
              type="submit" name="state" value="<%= entry.state %>">
              <%= entry.state === 'NEEDS_REPLY' ? 'Still needs a reply'
                : entry.state === 'WAITING' ? 'I answered — waiting on them'
                : 'Handled, nothing needed' %>
            </button>
          <% } %>
        <% }) %>
        <% if (!m.decidedByPerson) { %>
          <button class="btn btn--ghost" type="submit" name="state" value="RETHINK">Ask StockChief to look again</button>
        <% } %>
      </div>
    </form>
  </div>
  <p class="section-foot t-muted">
    Sending a reply moves this to waiting on them by itself. These are for when you
    answered somewhere else, or when nothing is owed.
  </p>
</section>
