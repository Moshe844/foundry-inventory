<header><p class="eyebrow">Human support</p><h1>Support Inbox</h1><p>Receive and reply to every customer conversation here.</p></header><% const me=staffProfiles.find(p=>p.account_id===account.id); %><section class="card" data-support-desk data-staff-account="<%= actor.id %>" data-after="<%= after||'' %>" data-time-zone="<%= account.timeZone %>"><div class="row"><div><h2>Your availability</h2><p role="status" data-support-live-status>You are offline. Customers can leave messages.</p></div><button type="button" data-support-presence aria-pressed="false">Go online for live chat</button></div><h2>Open conversations <span data-support-inbox-count>(<%= tickets.length %>)</span></h2><p data-support-empty <%= tickets.length?'hidden':'' %>>No customers are waiting. New messages appear here automatically.</p><div class="table-wrap"><table><thead><tr><th>Conversation</th><th>Customer and business</th><th>Status</th><th>Last message</th></tr></thead><tbody data-support-queue><% for(const ticket of tickets){ %><tr data-support-ticket-id="<%= ticket.id %>"><td><a href="/support/<%= ticket.id %>"><%= ticket.subject %></a></td><td><%= ticket.business_name||'Website enquiry' %> · <%= ticket.contact_email %></td><td><%= ticket.first_response_at?'In conversation':'Waiting for reply' %></td><td><%= helpers.dateTime(ticket.updated_at) %></td></tr><% } %></tbody></table></div><nav class="pager"><a href="/support">First page</a><a data-support-next href="<%= nextCursor?'/support?after='+encodeURIComponent(nextCursor):'/support' %>" <%= nextCursor?'':'hidden' %>>Next conversations</a></nav></section><details class="card" <%= me?'':'open' %>><summary>Your support name and email</summary><form method="post" action="/support/profile"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><label>Public support name<input name="displayName" value="<%= me?.display_name||actor.name %>" maxlength="120" required></label><label>Public support contact email<input type="email" name="contactEmail" value="<%= me?.contact_email||'support@stockchiefhq.com' %>" required></label><input type="hidden" name="active" value="1"><button>Save support profile</button></form></details><script src="/support-chat.js" defer></script>
