<header><a href="/customers/<%= customer.account.id %>">Customer account</a><h1>Subscription payments</h1><p><%= customer.account.name %> · Existing Stripe subscription records</p></header><% if(unavailable){ %><p class="notice" role="alert">Stripe could not load these invoices. The customer’s saved subscription is preserved.</p><% }else if(!invoices.length){ %><p class="card">No invoices returned for this customer.</p><% }else{ %><div class="table-wrap"><table><thead><tr><th>Invoice</th><th>Status</th><th>Amount paid</th><th>View</th></tr></thead><tbody><% for(const invoice of invoices){ %><tr><td><%= invoice.number||'Stripe invoice' %></td><td><%= invoice.status %></td><td><%= new Intl.NumberFormat('en-US',{style:'currency',currency:invoice.currency||'USD'}).format(Number(invoice.amount_paid||0)/100) %></td><td><% if(invoice.hosted_invoice_url&&/^https:\/\/invoice\.stripe\.com\//.test(invoice.hosted_invoice_url)){ %><a href="<%= invoice.hosted_invoice_url %>" rel="noopener noreferrer">Stripe invoice</a><% } %></td></tr><% } %></tbody></table></div><% } %>
