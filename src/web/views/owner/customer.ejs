<header><a href="/customers">All customers</a><h1><%= account.name %></h1><p><%= account.email %></p></header><div class="split"><section class="card"><h2>Subscription</h2><% if(subscription){ %><p><%= subscription.plan_id %> · <%= subscription.status %></p><p>Renewal <%= subscription.cancel_at_period_end?'will stop':'is active' %></p><% if(actor.role!=='SUPPORT'){ %><a class="button" href="/customers/<%= account.id %>/billing">Payments and invoices</a><a class="button" href="/customers/<%= account.id %>/cancellation">Review renewal change</a><% } %><% }else{ %><p>No subscription record.</p><% } %></section><section class="card"><h2>Businesses</h2><% for(const w of businesses){ %><p><strong><%= w.name %></strong> · <%= w.time_zone||'Time zone not set' %></p><% } %><p>Business content requires an active support conversation and the customer’s read-only access approval.</p></section></div><section class="card"><h2>Support conversations</h2><% if(!tickets.length){ %><p>No conversations yet.</p><% } %><% for(const ticket of tickets){ %><p><a href="/support/<%= ticket.id %>"><%= ticket.subject %></a> · <%= ticket.status %></p><% } %></section>
