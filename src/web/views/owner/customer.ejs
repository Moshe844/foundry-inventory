<header class="page-heading"><div><a class="back-link" href="/customers">← Customers</a><h1><%= customer.account.name %></h1><p><%= customer.account.email %> <span class="pill <%= customer.account.disabled_at?'attention':'' %>"><%= customer.account.disabled_at?'Access disabled':'Access enabled' %></span></p></div><% if(actor.role==='OWNER'&&!customer.protectedAccount){ %><div class="actions"><a class="button secondary" href="/customers/<%= customer.account.id %>/access"><%= customer.account.disabled_at?'Restore access':'Disable access' %></a><a class="button secondary" href="/customers/<%= customer.account.id %>/access?action=sign_out">Sign out all sessions</a><a class="button danger-outline" href="/customers/<%= customer.account.id %>/deletion">Delete account</a></div><% } %></header>
<% if(customer.account.disabled_at){ %><p class="notice"><strong>Account access is disabled.</strong> <%= customer.account.access_reason %> Billing has its own controls below.</p><% } %>
<nav class="section-tabs" aria-label="Customer account sections"><% for(const [tab,label] of [['overview','Overview'],['businesses','Businesses & team'],['billing','Plan & billing'],['usage','Usage & costs'],['connections','Connections'],['support','Support & activity']]){if(actor.role==='SUPPORT'&&['billing','usage'].includes(tab)||actor.role==='BILLING'&&['connections','support'].includes(tab))continue; %><a href="?tab=<%= tab %>" <%= customerTab===tab?'aria-current=page':'' %>><%= label %></a><% } %></nav>
<% if(customerTab==='overview'){ %><section class="metrics"><article class="card metric"><span>Plan</span><strong><%= customer.subscription?.plan_name||'No plan' %></strong><small><%= ownerFormat.words(customer.subscription?.status||'NO_PLAN') %></small></article><article class="card metric"><span>Businesses</span><strong><%= customer.businesses.length %></strong><small><%= customer.memberships.length %> business memberships</small></article><article class="card metric"><span>Connections</span><strong><%= customer.connections.length %></strong><small>Open Connections to see synchronization status</small></article></section><section class="card"><h2>Account details</h2><dl class="details-grid"><dt>Email verification</dt><dd><%= customer.account.email_verified_at?'Verified':'Waiting for verification' %></dd><dt>Joined</dt><dd><%= helpers.dateTime(customer.account.created_at) %></dd><dt>Time zone</dt><dd><%= customer.account.time_zone||'Not chosen' %></dd></dl><% if(customer.protectedAccount){ %><p class="muted">This is a protected platform operator account. Customer access/deletion controls cannot lock out the platform owner.</p><% } %></section><% } %>
<% if(['overview','businesses'].includes(customerTab)){ %><section class="card"><h2>Businesses owned by this customer</h2><% if(!customer.businesses.length){ %><p>No business has been created yet.</p><% } %><% for(const w of customer.businesses){ %><a class="attention-row" href="/businesses/<%= w.id %>"><div><strong><%= w.name %></strong><small><%= w.product_count %> products · <%= w.member_count %> team members · <%= w.connection_count %> connections</small></div><span>Manage business →</span></a><% } %></section><% } %>
<% if(customerTab==='businesses'){ %><section class="card"><h2>Team memberships</h2><% for(const m of customer.memberships){ %><a class="attention-row" href="/businesses/<%= m.workspace_id %>"><strong><%= m.business_name %></strong><span><%= ownerFormat.words(m.role) %></span></a><% } %></section><% } %>
<% if(customerTab==='billing'&&actor.role!=='SUPPORT'){ %><section class="card"><h2><%= customer.subscription?.plan_name||'No subscription yet' %></h2><% if(customer.subscription){ %><dl class="details-grid"><dt>Status</dt><dd><%= ownerFormat.words(customer.subscription.status) %></dd><dt>Billing interval</dt><dd><%= ownerFormat.words(customer.subscription.billing_interval) %></dd><dt>Current period ends</dt><dd><%= customer.subscription.current_period_end?helpers.dateTime(customer.subscription.current_period_end):'Not set' %></dd><dt>Renewal</dt><dd><%= customer.subscription.cancel_at_period_end?'Will stop at the end of this period':customer.subscription.status==='COMP'?'Complimentary':'Continues' %></dd></dl><div class="actions"><a class="button" href="/customers/<%= customer.account.id %>/billing">Payments and invoices</a><a class="button secondary" href="/customers/<%= customer.account.id %>/cancellation">Review renewal change</a></div><% } %></section><% } %>
<% if(customerTab==='usage'&&actor.role!=='SUPPORT'){ %><section class="card"><h2>Current plan allowances</h2><% for(const meter of customer.usage?.meters||[]){if(meter.definition?.customerVisible===false)continue; %><div class="attention-row"><strong><%= meter.label||meter.definition?.label||ownerFormat.words(meter.meter) %></strong><span><%= ownerFormat.number(meter.used) %><%= meter.included===null?' used · no included limit':' of '+ownerFormat.number(meter.included)+' included' %></span></div><% } %><p class="muted">Usage and add-on balances come from the existing plan and usage engine.</p></section><section class="card"><h2>Recorded service cost · last 30 days</h2><% if(!customer.costs.length){ %><p>No cost entries recorded for this period.</p><% } %><% for(const cost of customer.costs){ %><div class="attention-row"><strong><%= ownerFormat.words(cost.provider) %></strong><span><%= ownerFormat.money(cost.amount_minor,cost.currency) %></span></div><% } %><p class="muted">This is the recorded subtotal; provider invoice reconciliation may still be incomplete.</p></section><% } %>
<% if(customerTab==='connections'){ %><section class="card"><h2>Connected business systems</h2><% if(!customer.connections.length){ %><p>No connections have been created.</p><% } %><% for(const c of customer.connections){ %><a class="attention-row" href="/businesses/<%= c.workspace_id %>?tab=connections"><div><strong><%= c.display_name %></strong><small><%= c.business_name %> · Last sync: <%= c.last_sync_at?helpers.dateTime(c.last_sync_at):'Not yet synchronized' %></small></div><span class="pill"><%= ownerFormat.words(c.status) %></span></a><% } %></section><% } %>
<% if(customerTab==='support'){ %><section class="card"><h2>Support conversations</h2><% if(!customer.tickets.length){ %><p>No conversations yet. Open a business to request read-only support access.</p><% } %><% for(const ticket of customer.tickets){ %><a class="attention-row" href="/support/<%= ticket.id %>"><strong><%= ticket.subject %></strong><span><%= ownerFormat.words(ticket.status) %></span></a><% } %></section><section class="card"><h2>Recent account activity</h2><% if(!customer.activity.length){ %><p>No account-level actions have been recorded.</p><% } %><% for(const event of customer.activity){ %><article class="activity-row"><strong><%= ownerFormat.words(event.action) %></strong><p><%= event.reason %></p><small><%= event.actor_name||'System' %> · <%= helpers.dateTime(event.created_at) %></small></article><% } %></section><% } %>
