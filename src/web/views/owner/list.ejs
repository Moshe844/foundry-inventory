<header class="page-heading"><div><p class="eyebrow">StockChief company</p><h1><%= section.label %></h1><p>Find a customer, understand their status and open the relevant account.</p></div></header>
<%- include('section-tabs',{sectionKey:key}) %>
<form class="search card toolbar" method="get"><label>Search <%= section.label.toLowerCase() %><input type="search" name="q" value="<%= q %>" placeholder="Name, email or business"></label><button>Search</button><% if(q){ %><a class="button secondary" href="/<%= key %>">Clear</a><% } %></form>
<% if(!rows.length){ %><section class="card empty-state"><h2>No matching <%= section.label.toLowerCase() %></h2><p>Try another name or email. Empty data is shown honestly.</p></section><% }else{ %>
<div class="table-wrap card" role="region" aria-label="<%= section.label %> table" tabindex="0"><table><thead><tr><% for(const col of section.columns){ %><th><%= col.label %></th><% } %><th><span class="sr-only">Actions</span></th></tr></thead><tbody><% for(const row of rows){ %><tr><% for(const col of section.columns){ %><td data-label="<%= col.label %>"><% if(col.type==='person'){ %><div class="person-cell"><strong><%= row[col.key]||'Unnamed account' %></strong><small><%= row.email||'No email linked' %></small></div><% }else if(col.type==='customer'){ %><div class="person-cell"><% if(row.customer_id){ %><a href="/customers/<%= row.customer_id %>"><%= row[col.key]||row.customer_email||'Customer' %></a><% }else{ %><span>Shared platform</span><% } %><small><%= row.customer_email||'' %></small></div><% }else if(col.type==='business'){ %><% if(row.workspace_id){ %><a href="/businesses/<%= row.workspace_id %>"><%= row[col.key]||'Business' %></a><% }else{ %>Platform-wide<% } %><% }else if(col.type==='status'){ %><span class="pill <%= ['ERROR','DEAD','PAST_DUE','DISABLED','REAUTHORIZATION_REQUIRED'].includes(String(row[col.key]).toUpperCase())?'attention':'' %>"><%= ownerFormat.value(row,col,helpers) %></span><% }else{ %><%= ownerFormat.value(row,col,helpers) %><% } %></td><% } %><td><% if(row.href){ %><a class="button compact secondary" href="<%= row.href %>"><%= key==='customers'||key==='users'?'Manage':key==='errors'||key==='incidents'?'Review':'Open' %></a><% } %></td></tr><% } %></tbody></table></div><% } %>
<nav class="pager" aria-label="Pagination"><span><%= total?((page-1)*50+1)+'–'+Math.min(page*50,total)+' of '+ownerFormat.number(total):'0 results' %></span><div><% if(page>1){ %><a class="button secondary" href="?q=<%= encodeURIComponent(q) %>&page=<%= page-1 %>&status=<%= encodeURIComponent(status||'') %>">Previous</a><% } %><% if(hasMore){ %><a class="button secondary" href="?q=<%= encodeURIComponent(q) %>&page=<%= page+1 %>&status=<%= encodeURIComponent(status||'') %>">Next</a><% } %></div></nav>
