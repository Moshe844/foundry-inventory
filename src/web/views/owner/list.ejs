<header><p class="eyebrow">Platform operations</p><h1><%= section.label %></h1></header><form class="search" method="get"><label>Search <%= section.label.toLowerCase() %><input type="search" name="q" value="<%= q %>"></label><button>Search</button></form><% if(!rows.length){ %><section class="card"><h2>No matching records</h2><p>Try a different search. This view shows real records only.</p></section><% }else{ %><div class="table-wrap" role="region" aria-label="<%= section.label %> table" tabindex="0"><table><thead><tr><% for(const field of fields){ %><th><%= field.replaceAll('_',' ') %></th><% } %><th>Open</th></tr></thead><tbody><% for(const row of rows){ %><tr><% for(const field of fields){ %><td><%= row[field] instanceof Date?helpers.dateTime(row[field]):row[field]===null?'—':String(row[field]) %></td><% } %><td><% if(key==='customers'){ %><a href="/customers/<%= row.id %>">Customer account</a><% }else if(row.account_id||row.owner_account_id){ %><a href="/customers/<%= row.account_id||row.owner_account_id %>">Customer account</a><% }else if(row.workspace_id||key==='businesses'){ %><a href="/businesses/<%= row.workspace_id||row.id %>/inspect">Request-approved inspection</a><% }else{ %>—<% } %></td></tr><% } %></tbody></table></div><% } %><nav class="pager" aria-label="Pagination"><% if(page>1){ %><a href="?q=<%= encodeURIComponent(q) %>&page=<%= page-1 %>">Previous</a><% } %><span>Page <%= page %> · up to 50 records</span><% if(hasMore){ %><a href="?q=<%= encodeURIComponent(q) %>&page=<%= page+1 %>">Next</a><% } %></nav>
