<% const billingKeys=['subscriptions','revenue','payments','cancellations'],usageKeys=['usage','costs'],problemKeys=['errors','incidents'];const group=billingKeys.includes(sectionKey)?billingKeys:usageKeys.includes(sectionKey)?usageKeys:problemKeys.includes(sectionKey)?problemKeys:[]; %><% if(group.length){ %><nav class="section-tabs" aria-label="<%= billingKeys.includes(sectionKey)?'Billing':usageKeys.includes(sectionKey)?'Usage and costs':'Problems' %>"><% for(const tab of group){ if(sections[tab].roles.includes(actor.role)){ %><a href="/<%= tab %>" <%= sectionKey===tab?'aria-current=page':'' %>><%= sections[tab].label %></a><% }} %></nav><% } %>
