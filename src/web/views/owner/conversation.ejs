<header><a href="/support">Support Inbox</a><h1><%= ticket.subject %></h1><p><%= ticket.business_name||'Website enquiry' %> · <%= ticket.contact_email %></p><% if(ticket.owner_account_id){ %><a href="/customers/<%= ticket.owner_account_id %>">Customer account and subscription</a><% } %></header><div class="conversation-layout"><section><%- include('../support/thread',{supportBase:'/support',ownerConsole:true}) %></section><aside class="card context"><h2>Conversation context</h2><a href="/support/<%= ticket.id %>/service">Service agreement</a><p><strong>Business:</strong> <%= ticket.business_name||'No business linked' %></p><p><strong>Customer page:</strong> <%= recordPath||'Not supplied' %></p><p>Integration status and operational errors are available in the console navigation. Credentials and raw request payloads are never displayed.</p><% if(ticket.workspace_id){ %><p><a href="/integrations?q=<%= encodeURIComponent(ticket.workspace_id||'') %>">Connection diagnostics</a> · <a href="/incidents?q=<%= encodeURIComponent(ticket.workspace_id||'') %>">Application alerts</a></p><% } %><h2>Read-only support access</h2><% for(const grant of grants){ %><article class="grant"><p><%= grant.scopes.map(s=>scopes[s]).join(', ') %> · <%= grant.status %></p><p><%= grant.reason %></p><% if(grant.status==='APPROVED'&&new Date(grant.expires_at)>new Date()&&grant.operator_account_id===actor.id){ %><p>Until <%= helpers.dateTime(grant.expires_at) %></p><% if(relatedRecord&&grant.scopes.includes(relatedRecord.area)){ %><a class="button" href="/businesses/<%= ticket.workspace_id %>/inspect?area=<%= relatedRecord.area %>&amp;record=<%= encodeURIComponent(relatedRecord.id) %><%= relatedRecord.dataset?'&dataset='+relatedRecord.dataset:'' %>">Open related <%= relatedRecord.label %></a><% } %><% for(const area of grant.scopes){ %><a class="button" href="/businesses/<%= ticket.workspace_id %>/inspect?area=<%= area %>">Inspect <%= scopes[area] %></a><% } %><% } %></article><% } %><% if(ticket.workspace_id){ %><form method="post" action="/support/<%= ticket.id %>/access"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="requestKey" value="<%= accessKey %>"><fieldset><legend>Request customer permission to view</legend><% for(const [key,label] of Object.entries(scopes)){ %><label class="check"><input type="checkbox" name="scopes" value="<%= key %>"><%= label %></label><% } %></fieldset><label>Reason<textarea name="reason" maxlength="1000" required></textarea></label><label>Minutes<input type="number" name="minutes" min="5" max="60" value="30" required></label><button>Request read-only access</button></form><% } %></aside></div><script src="/support-chat.js" defer></script>
