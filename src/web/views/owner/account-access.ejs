<header class="page-heading"><div><a class="back-link" href="/customers/<%= accessReview.target.id %>">← <%= accessReview.target.name %></a><h1><%= accountAction==='restore'?'Restore account access':accountAction==='sign_out'?'Sign out all sessions':'Disable account access' %></h1><p><%= accessReview.target.name %> · <%= accessReview.target.email %></p></div></header>
<section class="card"><h2>What this changes</h2><% if(accountAction==='disable'){ %><p>Blocks this person’s sign-in and ends their current sessions. Future queued work for businesses they own will pause. Existing records and subscription billing remain intact.</p><p>Work already in progress keeps its recorded outcome and verification path.</p><% }else if(accountAction==='restore'){ %><p>Allows this person to sign in again and lets their queued business work continue under the existing plan and approvals.</p><% }else{ %><p>Ends the customer’s current sign-in sessions. They can sign in again with their own credentials. Their records, plan and business work remain intact.</p><% } %><dl class="details-grid"><dt>Current access</dt><dd><%= accessReview.target.disabled_at?'Disabled':'Enabled' %></dd><dt>Owned businesses</dt><dd><%= accessReview.businesses.map(w=>w.name).join(', ')||'None' %></dd><dt>Stored sign-in sessions</dt><dd><%= accessReview.sessions %></dd></dl></section>
<% if(errorMessage){ %><p class="notice" role="alert"><%= errorMessage %></p><% } %>
<% if(!accessReview.canManage){ %><p class="notice">This account is protected because it is your own account or an active platform operator.</p><% }else if(!freshMfa){ %><section class="card"><h2>Confirm your identity</h2><p>A recent authenticator sign-in is required for account access changes.</p><a class="button" href="/login?return=<%= encodeURIComponent(currentPath+(accountAction==='sign_out'?'?action=sign_out':'')) %>">Sign in again with MFA</a></section><% }else{ %><form class="card form-stack" method="post" action="/customers/<%= accessReview.target.id %>/access" data-owner-action><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="requestKey" value="<%= actionKey %>"><input type="hidden" name="revision" value="<%= accessReview.target.revision %>"><input type="hidden" name="action" value="<%= accountAction %>"><label>Reason<textarea name="reason" minlength="8" maxlength="1000" required><%= formValues?.reason||'' %></textarea></label><label>Type the customer’s email to confirm<input type="email" name="confirmEmail" required autocomplete="off" value="<%= formValues?.confirmEmail||'' %>"></label><label class="check"><input type="checkbox" name="confirmed" value="yes" required>I reviewed this account and approve this exact change.</label><div class="actions"><button><%= accountAction==='restore'?'Restore access':accountAction==='sign_out'?'Sign out sessions':'Disable access' %></button><a class="button secondary" href="/customers/<%= accessReview.target.id %>">Cancel</a></div></form><% } %>
