<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><meta name="robots" content="noindex,nofollow"><title><%= title %> · StockChief Owner</title><link rel="stylesheet" href="/owner-console.css"><script src="/owner-console.js" defer></script></head><body data-owner-console="true"><a class="skip" href="#main">Skip to content</a><% if(actor){ %><aside class="owner-nav"><a class="brand" href="/">◈ StockChief <span>Owner console</span></a><nav aria-label="Private platform navigation"><a href="/" <%= currentPath==='/'?'aria-current=page':'' %>>Overview</a><% for(const [key,section] of Object.entries(sections)){if(!section.roles.includes(actor.role))continue; %><a href="/<%= key %>" <%= currentPath==='/'+key?'aria-current=page':'' %>><%= section.label %></a><% } %><% if(actor.role==='OWNER'){ %><a href="/commercial-admin">Commercial controls</a><% } %><% if(actor.role!=='BILLING'){ %><a href="/support" <%= currentPath.startsWith('/support')?'aria-current=page':'' %>>Support Inbox</a><% } %></nav><footer><strong><%= actor.name %></strong><small><%= actor.role %> · MFA verified</small><form method="post" action="/logout"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button>Sign out of console</button></form></footer></aside><% } %><main id="main" class="<%= actor?'owner-main':'owner-auth' %>"><% if(env==='staging'||env==='test'){ %><p class="environment" role="status"><%= env==='test'?'Isolated test environment':'Staging — test customer records' %></p><% } %><% for(const notice of flash||[]){ %><div class="notice" role="<%= notice.type==='error'?'alert':'status' %>"><%= notice.message %></div><% } %><%- include(view) %></main></body></html>
