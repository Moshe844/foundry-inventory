<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><meta name="robots" content="noindex,nofollow"><title><%= title %> · StockChief Owner</title><link rel="stylesheet" href="/owner-console.css"><script src="/owner-console.js" defer></script></head><body data-owner-console="true"><a class="skip" href="#main">Skip to content</a><% if(actor){ %><aside class="owner-nav"><a class="brand" href="/">◈ StockChief <span>Company console</span></a><nav aria-label="Private platform navigation"><a href="/" <%= currentPath==='/'?'aria-current=page':'' %>>Overview</a><span class="nav-label">Customers</span><% for(const [key,label] of [['customers','Customers'],['businesses','Businesses'],['users','Users']]){if(sections[key].roles.includes(actor.role)){ %><a href="/<%= key %>" <%= currentPath.startsWith('/'+key)?'aria-current=page':'' %>><%= label %></a><% }} %><% if(actor.role!=='SUPPORT'){ %><span class="nav-label">Revenue & service</span><a href="/subscriptions" <%= ['/subscriptions','/revenue','/payments','/cancellations'].includes(currentPath)?'aria-current=page':'' %>>Plan & billing</a><a href="/usage" <%= ['/usage','/costs'].includes(currentPath)?'aria-current=page':'' %>>Usage & costs</a><% } %><% if(actor.role!=='BILLING'){ %><span class="nav-label">Customer care</span><a href="/support" <%= currentPath.startsWith('/support')?'aria-current=page':'' %>>Support Inbox</a><a href="/integrations" <%= currentPath==='/integrations'?'aria-current=page':'' %>>Connections</a><a href="/errors" <%= ['/errors','/incidents'].includes(currentPath)||currentPath.startsWith('/problems')?'aria-current=page':'' %>>Problems</a><% } %><% if(actor.role==='OWNER'){ %><span class="nav-label">Advanced</span><a href="/audit" <%= currentPath==='/audit'?'aria-current=page':'' %>>Audit history</a><a href="/commercial-admin">Commercial settings</a><% } %></nav><footer><strong><%= actor.name %></strong><small><%= ownerFormat.words(actor.role) %> · MFA verified</small><form method="post" action="/logout"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button>Sign out of console</button></form></footer></aside><% } %><main id="main" class="<%= actor?'owner-main':'owner-auth' %>"><% if(env==='staging'||env==='test'){ %><p class="environment" role="status"><%= env==='test'?'Isolated test environment':'Staging — test customer records' %></p><% } %><% for(const notice of flash||[]){ %><div class="notice" role="<%= notice.type==='error'?'alert':'status' %>"><%= notice.message %></div><% } %><%- include(view) %></main></body></html>
