<header><a href="/support/<%= ticket.id %>">Back to conversation</a><h1>Support service agreement</h1><p>The customer must approve the exact prepared terms before they become active.</p></header><% if(ticket.owner_account_id){const agreement=serviceAgreement; %><section class="card"><form method="post" action="/support/<%= ticket.id %>/agreement"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><label>Account manager<select name="managerAccountId"><option value="">No named manager</option><% for(const profile of staffProfiles){ %><option value="<%= profile.account_id %>" <%= agreement?.manager_account_id===profile.account_id?'selected':'' %>><%= profile.display_name %></option><% } %></select></label><label>First-response target in elapsed hours<input type="number" name="responseHours" min="1" max="720" value="<%= agreement?.response_hours||'' %>"></label><label>Exact service and SLA terms<textarea name="serviceText" maxlength="8000" required><%= agreement?.service_text||'' %></textarea></label><button>Prepare for customer approval</button></form></section><% } %>
