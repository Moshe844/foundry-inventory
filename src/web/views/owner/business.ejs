<header class="page-heading"><div><a class="back-link" href="/businesses">← Businesses</a><h1><%= business.workspace.name %></h1><p><a href="/customers/<%= business.workspace.owner_account_id %>"><%= business.workspace.customer_name %></a> · <%= business.workspace.customer_email %></p></div><span class="pill <%= business.workspace.disabled_at?'attention':'' %>"><%= business.workspace.disabled_at?'Owner access disabled':'Owner access enabled' %></span></header>
<section class="metrics"><article class="card metric"><span>Products</span><strong><%= ownerFormat.number(business.totals.products) %></strong></article><article class="card metric"><span>Sales orders</span><strong><%= ownerFormat.number(business.totals.orders) %></strong></article><article class="card metric"><span>Purchase orders</span><strong><%= ownerFormat.number(business.totals.purchases) %></strong></article></section>
<nav class="section-tabs" aria-label="Business sections"><% for(const [tab,label] of [['overview','Overview'],['team','Team'],['connections','Connections'],['support','Support access']]){if(actor.role==='BILLING'&&tab!=='overview')continue; %><a href="?tab=<%= tab %>" <%= businessTab===tab?'aria-current=page':'' %>><%= label %></a><% } %></nav>
<% if(businessTab==='overview'){ %><section class="card"><h2>Business details</h2><dl class="details-grid"><dt>Customer</dt><dd><%= business.workspace.customer_name %></dd><dt>Time zone</dt><dd><%= business.workspace.time_zone||'Not set' %></dd><dt>Data</dt><dd><%= business.workspace.data_mode==='synthetic'?'Generated test records':'Customer records' %></dd><dt>Team members</dt><dd><%= business.members.length %></dd><dt>Connections</dt><dd><%= business.connections.length %></dd></dl><% if(actor.role!=='BILLING'){ %><a class="button" href="?tab=support">Request permission to inspect business records</a><% } %></section><% } %>
<% if(businessTab==='team'){ %><section class="card"><h2>People with business access</h2><% for(const member of business.members){ %><div class="attention-row"><div><strong><%= member.name %></strong><small><%= member.email||'No sign-in email linked' %> · <%= ownerFormat.words(member.role) %></small></div><% if(member.account_id){ %><a class="button compact secondary" href="/customers/<%= member.account_id %>">Manage account</a><% } %></div><% } %></section><% } %>
<% if(businessTab==='connections'){ %><section class="card"><h2>Connected systems</h2><% if(!business.connections.length){ %><p>No connections have been created.</p><% } %><% for(const c of business.connections){ %><div class="attention-row"><div><strong><%= c.display_name %></strong><small><%= ownerFormat.words(c.provider_type) %> · Last sync: <%= c.last_sync_at?helpers.dateTime(c.last_sync_at):'Not synchronized yet' %></small></div><span class="pill"><%= ownerFormat.words(c.status) %></span></div><% } %><a href="/errors?q=<%= encodeURIComponent(business.workspace.name) %>">Review problems for this business</a></section><% } %>
<% if(businessTab==='support'){ %><section class="card"><h2>Customer-authorized inspection</h2><p>The customer owner approves the areas and duration. Inspection is read-only and never signs you into their account.</p><% for(const grant of business.grants){ %><article class="grant"><strong><%= grant.scopes.map(s=>scopes[s]).join(', ') %></strong><p><%= grant.reason %> · <%= ownerFormat.words(grant.status) %></p><% if(grant.status==='APPROVED'&&new Date(grant.expires_at)>new Date()){ %><p>Until <%= helpers.dateTime(grant.expires_at) %></p><div class="actions"><% for(const area of grant.scopes){ %><a class="button secondary" href="/businesses/<%= business.workspace.id %>/inspect?area=<%= area %>">Inspect <%= scopes[area] %></a><% } %></div><% } %></article><% } %><form class="form-stack" method="post" action="/businesses/<%= business.workspace.id %>/access" data-owner-action><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="requestKey" value="<%= accessKey %>"><fieldset><legend>Request permission to inspect</legend><% for(const [key,label] of Object.entries(scopes)){ %><label class="check"><input type="checkbox" name="scopes" value="<%= key %>"><%= label %></label><% } %></fieldset><label>Reason for access<textarea name="reason" maxlength="1000" required></textarea></label><label>Access duration in minutes<input type="number" name="minutes" min="5" max="60" value="30" required></label><button>Request customer permission</button></form></section><section class="card"><h2>Related support conversations</h2><% if(!business.tickets.length){ %><p>No conversations yet. A direct access request still notifies the customer owner.</p><% } %><% for(const ticket of business.tickets){ %><a class="attention-row" href="/support/<%= ticket.id %>"><strong><%= ticket.subject %></strong><span><%= ownerFormat.words(ticket.status) %></span></a><% } %></section><% } %>
