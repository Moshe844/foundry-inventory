<header><a class="back-link" href="<%= grant.request_id?'/support/'+grant.request_id:'/businesses/'+workspace.id+'?tab=support' %>">← <%= grant.request_id?'Support conversation':'Business support access' %></a><h1><%= workspace.name %> · <%= scopes[area] %></h1><p class="notice">Customer-approved read-only access. Changes use the customer’s normal review and approval workflows.</p></header>
<nav class="section-tabs" aria-label="Support record views"><a href="?area=<%= area %>"><%= scopes[area] %></a><% for(const view of views){ %><a href="?area=<%= area %>&dataset=<%= view.key %>" <%= dataset===view.key?'aria-current=page':'' %>><%= view.label %></a><% } %></nav>
<% if(recordId){ %><p><a href="?area=<%= area %>&dataset=<%= dataset||'' %>">Show all records in this view</a></p><% } %>
<div class="table-wrap card"><table><thead><tr><% for(const col of viewColumns){ %><th><%= col.label %></th><% } %></tr></thead><tbody><% for(const row of rows){ %><tr><% for(const col of viewColumns){ %><td data-label="<%= col.label %>"><%= ownerFormat.value(row,col,helpers) %></td><% } %></tr><% } %></tbody></table></div><% if(!rows.length){ %><p class="card">No matching records in this business.</p><% } %><nav class="pager"><span>Page <%= page %></span><div><% if(page>1){ %><a class="button secondary" href="?area=<%= area %>&page=<%= page-1 %>&dataset=<%= dataset||'' %>">Previous</a><% } %><% if(hasMore){ %><a class="button secondary" href="?area=<%= area %>&page=<%= page+1 %>&dataset=<%= dataset||'' %>">Next</a><% } %></div></nav>
