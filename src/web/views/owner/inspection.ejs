<header><a href="/support/<%= grant.request_id %>">Back to support conversation</a><h1><%= workspace.name %> · <%= scopes[area] %></h1><p class="notice">Customer-approved read-only access. Changes must be reviewed and approved through the customer’s existing StockChief workflows.</p></header><nav class="pager" aria-label="Support record views"><a href="?area=<%= area %>"><%= scopes[area] %></a><% for(const view of views){ %><a href="?area=<%= area %>&dataset=<%= view.key %>"><%= view.label %></a><% } %></nav><div class="table-wrap"><table><thead><tr><% for(const field of fields){ %><th><%= field.replaceAll('_',' ') %></th><% } %></tr></thead><tbody><% for(const row of rows){ %><tr><% for(const field of fields){ %><td><%= row[field] instanceof Date?helpers.dateTime(row[field]):row[field]??'—' %></td><% } %></tr><% } %></tbody></table></div><% if(!rows.length){ %><p class="card">No matching records in this business.</p><% } %><nav class="pager"><span>Page <%= page %></span><% if(page>1){ %><a href="?area=<%= area %>&page=<%= page-1 %>&dataset=<%= dataset||'' %>">Previous</a><% } %><% if(hasMore){ %><a href="?area=<%= area %>&page=<%= page+1 %>&dataset=<%= dataset||'' %>">Next</a><% } %></nav>
