<header><a class="back-link" href="/customers/<%= deletionReview.target.id %>">← <%= deletionReview.target.name %></a><h1>Delete customer account</h1><p><%= deletionReview.target.name %> · <%= deletionReview.target.email %></p></header>
<section class="card danger-card"><h2>Permanent removal</h2><p>Removes this sign-in account and all businesses it owns, including their products, orders and business records. The email can then be used to register a new account. This action cannot be undone.</p><p>Billing must be resolved first. The existing deletion engine checks active work, uncertain outcomes, linked memberships and protected spending records before it removes anything.</p></section>
<section class="card"><h2>Business impact</h2><% if(!deletionReview.workspaces.length){ %><p>No owned businesses.</p><% } %><% for(const w of deletionReview.workspaces){ %><div class="attention-row"><strong><%= w.name %></strong><span><%= ownerFormat.number(w.products) %> products · <%= ownerFormat.number(w.journals) %> posted accounting entries</span></div><% } %></section>
<% if(errorMessage){ %><p class="notice" role="alert"><%= errorMessage %></p><% } %>
<% if(deletionReview.blockers.length){ %><section class="card"><h2>Resolve these before deletion</h2><ul><% for(const blocker of deletionReview.blockers){ %><li><%= blocker %></li><% } %></ul><div class="actions"><a class="button secondary" href="/customers/<%= deletionReview.target.id %>/access">Review account access</a><a class="button secondary" href="/customers/<%= deletionReview.target.id %>?tab=billing">Review billing</a></div></section><% }else if(!freshMfa){ %><section class="card"><h2>Confirm your identity</h2><p>A recent authenticator sign-in is required before deletion can be approved.</p><a class="button" href="/login?return=<%= encodeURIComponent(currentPath) %>">Sign in again with MFA</a></section><% }else{ %><form class="card form-stack danger-card" method="post" action="/customers/<%= deletionReview.target.id %>/deletion" data-owner-action><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="email" value="<%= deletionReview.target.email %>"><input type="hidden" name="reviewHash" value="<%= deletionReview.reviewHash %>"><input type="hidden" name="requestKey" value="<%= actionKey %>"><label>Reason for permanent deletion<textarea name="reason" minlength="8" maxlength="1000" required><%= formValues?.reason||'' %></textarea></label><label>Type the customer’s email to confirm<input type="email" name="confirmEmail" required autocomplete="off" value="<%= formValues?.confirmEmail||'' %>"></label><label>Your owner-console password<input type="password" name="password" autocomplete="current-password" required></label><label class="check"><input type="checkbox" name="confirmed" value="yes" required>I approve permanent deletion of this exact account and every business listed above.</label><div class="actions"><button class="danger">Permanently delete account</button><a class="button secondary" href="/customers/<%= deletionReview.target.id %>">Cancel</a></div></form><% } %>
