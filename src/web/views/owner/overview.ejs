<header class="page-heading"><div><p class="eyebrow">Your StockChief company</p><h1>Platform overview</h1><p>Customers, billing, service delivery and the work that needs your attention.</p></div><% if(actor.role!=='BILLING'){ %><a class="button" href="/support">Open Support Inbox</a><% } %></header>
<section class="metrics four"><a class="card metric" href="/customers"><span>Customer accounts</span><strong><%= ownerFormat.number(metrics.customers) %></strong><small><%= ownerFormat.number(metrics.disabled) %> with access disabled</small></a><a class="card metric" href="/businesses"><span>Customer businesses</span><strong><%= ownerFormat.number(metrics.businesses) %></strong><small>Separate inventories and teams</small></a><% if(actor.role!=='SUPPORT'){ %><a class="card metric" href="/subscriptions"><span>Paid subscriptions</span><strong><%= ownerFormat.number(metrics.paid) %></strong><small>Active provider-backed subscriptions</small></a><% } %><% if(actor.role!=='BILLING'){ %><a class="card metric" href="/support"><span>Open conversations</span><strong><%= ownerFormat.number(metrics.waiting) %></strong><small>Reply from your private inbox</small></a><% } %></section>
<% if(actor.role!=='SUPPORT'){ %><section class="split"><a class="card metric" href="/revenue"><span>Gross subscription & usage receipts · last 30 days</span><strong><%= metrics.receipts.length?metrics.receipts.map(r=>ownerFormat.money(r.amount_minor,r.currency)).join(' · '):'No receipts recorded' %></strong><small>Recorded receipts before refunds and fees, grouped by currency</small></a><a class="card metric" href="/costs"><span>Recorded service costs · last 30 days</span><strong><%= metrics.costs.length?metrics.costs.map(r=>ownerFormat.money(r.amount_minor,r.currency)).join(' · '):'No costs recorded' %></strong><small>Recorded costs may not include every provider invoice</small></a></section><% } %>
<div class="split"><% if(actor.role!=='BILLING'){ %><section class="card"><div class="row"><h2>Customers waiting for you</h2><a href="/support">All conversations</a></div><% if(!metrics.conversations.length){ %><p class="empty-copy">No open support conversations.</p><% } %><% for(const c of metrics.conversations){ %><a class="attention-row" href="/support/<%= c.id %>"><div><strong><%= c.subject %></strong><small><%= c.contact_email %></small></div><span><%= helpers.dateTime(c.updated_at) %> →</span></a><% } %></section><% } %><% if(actor.role!=='SUPPORT'){ %><section class="card"><div class="row"><h2>Billing needs attention</h2><a href="/subscriptions">All subscriptions</a></div><% if(!metrics.billing.length){ %><p class="empty-copy">No subscriptions need payment follow-up.</p><% } %><% for(const c of metrics.billing){ %><a class="attention-row" href="/customers/<%= c.id %>"><div><strong><%= c.name %></strong><small><%= c.email %> · <%= c.plan_name %></small></div><span class="pill attention"><%= ownerFormat.words(c.status) %></span></a><% } %></section><% } %></div>
<% if(actor.role!=='BILLING'){ %><section class="card"><div class="row"><h2>Work needing investigation</h2><a href="/errors">Review all problems</a></div><% if(!metrics.problems.length){ %><p class="empty-copy">No failed or retrying work is recorded.</p><% } %><% for(const p of metrics.problems){ %><a class="attention-row" href="/problems/jobs/<%= p.id %>"><div><strong><%= ownerFormat.words(p.kind) %> · <%= p.business_name||'StockChief platform' %></strong><small><%= p.last_error %></small></div><span class="pill attention"><%= ownerFormat.words(p.status) %></span></a><% } %></section><% } %>
