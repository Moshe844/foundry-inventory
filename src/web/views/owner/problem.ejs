<header><a class="back-link" href="/errors">← Work needing attention</a><h1><%= ownerFormat.words(record.title) %></h1><p><%= record.business_name||'StockChief platform' %><% if(record.customer_id){ %> · <a href="/customers/<%= record.customer_id %>"><%= record.customer_name %></a><% } %></p></header><section class="card"><span class="pill attention"><%= ownerFormat.words(record.status) %></span><h2>What happened</h2><p><%= record.explanation %></p><dl class="details-grid"><dt>Last update</dt><dd><%= helpers.dateTime(record.updated_at) %></dd><% if(record.attempt_count!==undefined){ %><dt>Attempts</dt><dd><%= record.attempt_count %> of <%= record.max_attempts %></dd><% } %></dl><div class="actions"><% if(record.workspace_id){ %><a class="button" href="/businesses/<%= record.workspace_id %>">Open business</a><a class="button secondary" href="/businesses/<%= record.workspace_id %>?tab=support">Request support inspection</a><% } %></div><p class="muted">An uncertain external result must be verified before work is retried. This page does not create or repeat a business action.</p></section><% if(events.length){ %><section class="card"><h2>Recorded progress</h2><% for(const event of events){ %><div class="attention-row"><strong><%= ownerFormat.words(event.event_type) %></strong><span><%= helpers.dateTime(event.created_at) %></span></div><% } %></section><% } %><details class="card"><summary>Technical reference</summary><code><%= record.id %></code><p>Share this reference with engineering when investigating the problem.</p></details>
