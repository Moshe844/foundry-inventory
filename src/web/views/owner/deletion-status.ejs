<header><a class="back-link" href="/customers">← Customers</a><h1>Account deletion</h1><p><%= removal.target_name||'Reviewed customer account' %></p></header>
<section class="card" data-deletion-status="<%= removal.status==='COMPLETED'?'completed':job?.status==='DEAD'?'stopped':'pending' %>"><h2><%= removal.status==='COMPLETED'?'Account deleted':job?.status==='DEAD'?'Deletion did not finish':job?.status==='RUNNING'?'Deleting the reviewed account':'Deletion queued' %></h2>
<% if(removal.status==='COMPLETED'){ %><p>The sign-in account and its reviewed businesses were removed. The email is available for a new registration.</p>
<% }else if(job?.status==='DEAD'){ %><p>The account is still disabled. This attempt did not remove its sign-in account or business records.</p><p>Review the current account and confirm permanent deletion again. A stopped attempt will not restart automatically.</p><% if(removal.target_id){ %><a class="button danger" href="/customers/<%= removal.target_id %>/deletion">Review deletion again</a><a class="button secondary" href="/customers/<%= removal.target_id %>">Open customer account</a><% } %>
<% }else{ %><p>The account stays disabled while this request runs. Check the saved status below for confirmation of removal.</p><p class="muted">Refreshing checks the saved result and does not submit another deletion.</p><a class="button secondary" href="<%= currentPath %>">Check deletion status</a><% } %><a class="button secondary" href="/customers">Back to customers</a></section>
