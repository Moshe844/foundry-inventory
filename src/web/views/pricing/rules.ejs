<link rel="stylesheet" href="/pricing-rules.css">
<section class="pricing-page-head"><p class="eyebrow">Clear prices. Protected margins.</p><h1>Pricing &amp; promotions</h1><p>Set customer rates, quantity tiers and offers. Every order keeps its own pricing history.</p><p>Higher priority wins. At the same priority, a customer-specific rate takes precedence, followed by product/category scope, the qualifying quantity tier and the lower rate. Offers combine only when their approved combination rules allow it.</p>
<% if(canManage){ %><a class="btn btn--primary" href="/sales/pricing/rules/new">Create a pricing rule</a><% } %> <a href="/ask?from=%2Fsales%2Fpricing">Ask StockChief to help</a></section>
<% if(!rules.length){ %><section class="card"><h2>Your product prices are the starting point</h2><p>No pricing rules are active yet. Create a price list, promotion or margin safeguard when you need one.</p></section><% } %>
<div class="pricing-rules-grid"><% for(const rule of rules){const scheduled=rule.startsAt&&Date.parse(rule.startsAt)>now,ended=rule.endsAt&&Date.parse(rule.endsAt)<=now; %><section class="card"><p class="eyebrow"><%= rule.kind.replaceAll('_',' ') %> · <%= rule.currency %></p><h2><%= rule.name %></h2><p><%= rule.enabled===false?'Disabled':ended?'Ended':scheduled?'Scheduled':'Active' %> · revision <%= rule.version %></p>
<% if(rule.discount){ %><p><strong><%= rule.discount.type==='percent'?(rule.discount.value/100)+'%':rule.discount.value/100+' '+rule.currency %></strong> · <%= rule.discount.type.replaceAll('_',' ') %></p><% } %>
<% if(rule.entries){ %><p><%= rule.entries.length %> price tiers</p><% } %><% if(rule.code){ %><p>Code: <strong><%= rule.code %></strong></p><% } %><% if(canManage){ %><a href="/sales/pricing/rules/<%= rule.id %>/edit">Edit rule</a> · <% } %><a href="/sales/pricing/rules/<%= rule.id %>/history">Details &amp; history</a></section><% } %></div>
