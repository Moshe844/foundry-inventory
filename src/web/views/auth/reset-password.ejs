<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1">
  <%# The first screen anybody sees is the same product as the rest of it: it
      loads exactly what the application loads, and keeps no private copy of
      the design in a style block of its own. %>
  <link rel="stylesheet" href="/app.css">
  <link rel="stylesheet" href="/product-clarity.css">
  <link rel="stylesheet" href="/foundry.css">
  <link rel="stylesheet" href="/room.css">
  <link rel="stylesheet" href="/design.css">
<body><div class="auth"><div class="auth-card"><div class="auth-title"><h1><%= title %></h1></div>
<% if (flash && flash.length) { %><div class="flash-stack"><% flash.forEach(function (m) { %><div class="flash flash--<%= m.type %>" role="alert"><span><%= m.message %></span></div><% }); %></div><% } %>
<% if (valid) { %><div class="card"><div class="card-body"><form method="post" action="/reset-password"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="token" value="<%= token %>"><label class="field"><span class="label">New password</span><input class="input" type="password" name="password" required minlength="8" maxlength="200" autocomplete="new-password" autofocus></label><button class="btn btn--primary btn--block" type="submit">Change password</button></form></div></div>
<% } else { %><div class="notice notice--warn"><div><strong>This reset link is invalid or has expired.</strong><br>Request another link and use the newest email.</div></div><% } %>
<p class="auth-foot"><a href="/forgot-password">Request another link</a> · <a href="/login">Sign in</a></p></div></div></body></html>
