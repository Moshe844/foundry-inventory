<!doctype html>
<html lang="en">
<head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title><%= title %> · StockChief</title><link rel="stylesheet" href="/commercial.css?v=auth"></head>
<body class="commercial-auth"><main class="auth-centered"><a class="pub-brand" href="/"><span class="pub-brand__mark">◇</span><span>StockChief</span></a><div class="auth-centered__card"><span class="pub-eyebrow">SECURE RESET</span><h1><%= title %></h1>
<% if(flash&&flash.length){flash.forEach(function(message){%><div class="auth-message auth-message--<%= message.type %>" role="alert"><%= message.message %></div><%});}%>
<% if(valid){ %>
<p>Choose a new password. Completing this reset signs the account out on every device.</p>
<form method="post" action="/reset-password" data-loading><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="token" value="<%= token %>">
<label class="auth-field"><span>New password</span><span class="password-field"><input id="new-password" type="password" name="password" required minlength="12" maxlength="200" pattern="(?=.*[A-Za-z])(?=.*[^A-Za-z0-9\s]).{12,200}" title="Use at least 12 characters with at least one letter and one symbol." autocomplete="new-password" aria-describedby="password-help" autofocus><button type="button" data-password-toggle="new-password">Show</button></span><small id="password-help">Use at least 12 characters with at least one letter and one symbol.</small></label>
<button class="pub-btn pub-btn--block" type="submit">Change password</button></form>
<% } else { %><span class="auth-mail">!</span><p>This link is invalid, expired or was already used. Request a new one to continue safely.</p><a class="pub-btn pub-btn--block" href="/forgot-password">Request another link</a><% } %>
<p class="auth-foot"><a href="/login">Return to sign in</a></p></div></main><script src="/commercial.js?v=auth" defer></script></body></html>
