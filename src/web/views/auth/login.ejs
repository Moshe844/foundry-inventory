<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Sign in · Foundry Inventory</title>
  <meta name="description" content="Foundry manages your inventory operation and brings you the exceptions that need your judgement.">
  <meta property="og:title" content="Foundry — Your inventory operation, managed.">
  <meta property="og:description" content="Foundry handles routine inventory work and brings you the exceptions that need your judgement.">
  <meta property="og:image" content="<%= origin %>/og.png">
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:image" content="<%= origin %>/og.png">
  <link rel="stylesheet" href="/app.css">
  <link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24'%3E%3Crect width='24' height='24' rx='5' fill='%230f766e'/%3E%3Cpath d='M6 8.5 12 5.8l6 2.7v6L12 17.2 6 14.5z' fill='none' stroke='white' stroke-width='1.5' stroke-linejoin='round'/%3E%3C/svg%3E">
  <style>
    .auth { min-height: 100vh; display: grid; place-items: center; padding: 28px 16px; }
    .auth-card { width: 100%; max-width: 392px; }
    .auth-brand { display: flex; align-items: center; gap: 10px; justify-content: center; margin-bottom: 20px; }
    .auth-brand .brand-mark { width: 34px; height: 34px; }
    .auth-brand strong { font-size: 17px; letter-spacing: -0.01em; }
    .auth-title { text-align: center; margin-bottom: 18px; }
    .auth-title h1 { font-size: 19px; }
    .auth-title p { color: var(--muted); margin-top: 4px; font-size: 13.5px; }
    .auth-pitch { text-align: center; margin-bottom: 18px; }
    .auth-pitch p { font-size: 13.5px; color: var(--muted); margin: 0 0 6px; line-height: 1.5; }
    .auth-pitch strong { color: var(--text); }
    .auth-foot { text-align: center; color: var(--muted); font-size: 13px; margin-top: 16px; }
  </style>
</head>
<body>
<div class="auth">
  <div class="auth-card">
    <div class="auth-brand">
      <span class="brand-mark">
        <svg width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linejoin="round"><path d="M4 8.2 12 4.4l8 3.8v7.6L12 19.6l-8-3.8z"/><path d="m4 8.2 8 3.8 8-3.8M12 12v7.6"/></svg>
      </span>
      <strong>Foundry Inventory</strong>
    </div>

    <%# The first screen a stranger sees. Without this it says only "your
        inventory, exactly as your team left it" — perfectly good for somebody
        coming back, and meaningless to somebody deciding whether this is even
        the right kind of product. %>
    <div class="auth-pitch">
      <p><strong>Foundry runs your inventory. You handle the exceptions.</strong></p>
      <p>It keeps the counts, watches what is moving, prepares the routine work — receiving,
        transfers, what to reorder — and brings you only what needs a person.</p>
    </div>

    <div class="auth-title">
      <h1>Sign in</h1>
      <p>Your inventory, exactly as your team left it.</p>
    </div>

    <% if (flash && flash.length) { %>
      <div class="flash-stack">
        <% flash.forEach(function (message) { %>
          <div class="flash flash--<%= message.type %>" role="alert"><span><%= message.message %></span></div>
        <% }) %>
      </div>
    <% } %>

    <div class="card">
      <div class="card-body">
        <form method="post" action="/login">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <input type="hidden" name="next" value="<%= next %>">
          <div class="field">
            <label class="label" for="email">Email</label>
            <input class="input" id="email" name="email" type="email" value="<%= email %>" required autocomplete="username" autofocus>
          </div>
          <div class="field">
            <label class="label" for="password">Password</label>
            <input class="input" id="password" name="password" type="password" required autocomplete="current-password">
          </div>
          <button class="btn btn--primary btn--block" type="submit">Sign in</button>
        </form>
      </div>
    </div>

    <p class="auth-foot">New to Foundry? <a href="/register">Create a workspace</a></p>
  </div>
</div>
</body>
</html>
