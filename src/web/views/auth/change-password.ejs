<div class="page-head"><div><h1>Update your password</h1><p>Use at least 12 characters, including a letter and a symbol. Your inventory and records stay the same.</p></div></div>
<section class="card card-body"><% if(error){ %><p role="alert" class="is-warn"><%= error %></p><% } %>
<form method="post" action="/settings/password" class="stack-form"><input type="hidden" name="_csrf" value="<%= csrfToken %>">
<label class="field"><span>Current password</span><input class="input" type="password" name="currentPassword" required autocomplete="current-password" maxlength="200"></label>
<label class="field"><span>New password</span><input class="input" type="password" name="password" minlength="12" maxlength="200" required autocomplete="new-password"></label>
<label class="field"><span>Confirm new password</span><input class="input" type="password" name="confirmPassword" minlength="12" maxlength="200" required autocomplete="new-password"></label>
<button class="btn btn--primary" type="submit">Update password</button></form></section>
