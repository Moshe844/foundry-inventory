<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Create your account · StockChief</title><link rel="stylesheet" href="/commercial.css?v=<%= assetVersion %>"></head><body class="commercial-auth"><main class="auth-form"><a href="/">StockChief</a><h1>Create your local account</h1><p>StockChief runs your inventory, including receiving, reordering and transfers, so you can handle the exceptions.</p><p>This local reference application does not start a paid subscription.</p>
<% for(const message of flash||[]){ %><p role="alert"><%= message.message %></p><% } %>
<form method="post" action="/register"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><label class="auth-field">Business name<input name="businessName" value="<%= form.businessName||'' %>" maxlength="120" required></label><label class="auth-field">Your name<input name="name" value="<%= form.name||'' %>" required></label><label class="auth-field">Email<input type="email" name="email" value="<%= form.email||'' %>" required></label><label class="auth-field">Password<input type="password" name="password" required autocomplete="new-password"></label><button class="pub-btn" type="submit">Create account</button></form><p><a href="/login">Sign in</a></p></main></body></html>
