<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <title>Choose your plan · StockChief</title>
  <link rel="stylesheet" href="/commercial.css?v=auth-plan-choice">
<link rel="stylesheet" href="/signup.css?v=<%= locals.assetVersion||'signup' %>"><link rel="stylesheet" href="/professional-system.css?v=<%= locals.assetVersion||'current' %>">
</head>
<body class="commercial-auth signup-auth">
  <main class="auth-centered">
    <a class="pub-brand" href="/"><span class="pub-brand__mark">◇</span><span>StockChief</span></a>
    <div class="auth-centered__card"><%- include('../components/signup-progress',{step:3}) %>
      <span class="auth-mail auth-mail--ok">✓</span>
      <h1>3. Activate your workspace.</h1>
      <p>Your email is verified. Review a paid plan and enter your card securely to activate your business workspace. Includes a 14-day money-back guarantee.</p>
      <% if(flash&&flash.length){flash.forEach(function(message){ %>
        <div class="auth-message auth-message--<%= message.type %>" role="alert"><%= message.message %></div>
      <% });} %>
      <% if(locals.subscriptionTestMode){ %><p class="auth-message" role="status">Test checkout: use a Stripe test card. No real payment is taken.</p><% } %><% if(checkoutOpen){ %><form method="post" action="/billing/checkout">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <input type="hidden" name="promoCode" value="<%= selection.promoCode||'' %>">
        <label class="auth-field" for="activation-plan">
          <span id="activation-plan-label">Plan</span>
          <select id="activation-plan" name="planId" aria-labelledby="activation-plan-label" required>
            <option value="" <%= !(lastSelection?.planId||selection.planId)?'selected':'' %> disabled>Choose a plan</option>
            <% plans.filter(function(plan){return !plan.sales_only;}).forEach(function(plan){
              const monthly=Number(plan.monthly_amount_minor||0)/100;
            %>
              <option data-price-name="<%= plan.public_name %>" data-monthly="<%= Number(plan.monthly_amount_minor)/100 %>" data-annual="<%= Number(plan.annual_amount_minor)/100 %>" value="<%= plan.id %>" <%= (lastSelection?.planId||selection.planId)===plan.id?'selected':'' %>><%= plan.public_name %><%= checkoutOpen?' — '+monthly.toLocaleString('en-US',{style:'currency',currency:plan.currency,maximumFractionDigits:0})+'/month':'' %></option>
            <% }); %>
          </select>
        </label>
        <label class="auth-field" for="activation-interval">
          <span id="activation-billing-label">Billing</span>
          <select id="activation-interval" name="interval" aria-labelledby="activation-billing-label" data-billing-interval><option value="monthly" <%= (lastSelection?.interval||selection.interval)!=='annual'?'selected':'' %>>Monthly</option><option value="annual" <%= (lastSelection?.interval||selection.interval)==='annual'?'selected':'' %>>Annual — 2 months free</option></select>
        </label>
        <button class="pub-btn pub-btn--block" type="submit">Continue to secure checkout</button>
      </form>
      <p class="auth-help">Stripe handles payment details. StockChief never receives your card number.</p><% }else{ %>
        <% const chosen=plans.find(function(plan){return plan.id===(lastSelection?.planId||selection.planId);}); %>
        <p><%= chosen?'You selected '+chosen.public_name+' with monthly billing.':'No plan has been selected yet.' %></p>
        <div class="auth-message auth-message--warning" role="status">Checkout is not open yet. Your email is verified, but no payment has been taken and no inventory has been activated. We will not send you to a checkout that cannot complete.</div>
      <% } %>
      <p class="auth-foot"><a href="/pricing#<%= lastSelection?.planId||selection.planId||'starter' %>">Compare monthly plans</a></p>
      <form method="post" action="/logout" class="auth-foot"><input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <button class="pub-link" type="submit">Use a different account</button></form>
    </div>
  </main>
<script src="/billing-interval.js?v=<%= locals.assetVersion||'billing' %>" defer></script></body>
</html>
