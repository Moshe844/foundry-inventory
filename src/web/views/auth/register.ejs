<!doctype html>
<html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1">
<title>Start with StockChief</title>
<link rel="stylesheet" href="/design.css?v=<%= typeof assetVersion==='undefined'?'auth':assetVersion %>">
<link rel="stylesheet" href="/commercial.css?v=<%= typeof assetVersion==='undefined'?'auth':assetVersion %>"></head>
<% var commercialSignup=typeof plans!=='undefined'&&Array.isArray(plans)&&plans.length>0;
   var signupPlan=commercialSignup?(typeof selectedPlan==='undefined'?'growth':selectedPlan):null;
   var signupInterval=typeof selectedInterval==='undefined'?'monthly':selectedInterval;
   var signupPromo=typeof selectedPromo==='undefined'?'':selectedPromo; %>
<body class="commercial-auth"><main class="auth-split auth-split--register"><section class="auth-form">
<a class="pub-brand" href="/"><span class="pub-brand__mark">◇</span><span>StockChief</span></a><div class="auth-form__body"><span class="pub-eyebrow">START WITH STOCKCHIEF</span>
<h1>Create your business workspace.</h1><p>StockChief runs your inventory—from reordering and receiving to transfers and orders—while you handle the exceptions. <%= commercialSignup?'After payment, go straight to your inventory source.':'Your first inventory is created for you, then you go straight to source selection.' %></p>
<% if(flash&&flash.length){ %><div class="auth-messages"><% flash.forEach(function(message){ %><div class="auth-message auth-message--<%= message.type %>" role="alert"><%= message.message %></div><% }); %></div><% } %>
<form method="post" action="/register" data-loading><input type="hidden" name="_csrf" value="<%= csrfToken %>"><% if(commercialSignup){ %><input type="hidden" name="planId" value="<%= signupPlan %>"><input type="hidden" name="interval" value="<%= signupInterval %>"><% } %>
<label class="auth-field"><span>Business name</span><input id="businessName" name="businessName" value="<%= form.businessName||'' %>" required maxlength="120" autocomplete="organization" placeholder="e.g. Harbour Clothing"></label>
<label class="auth-field"><span>Your name</span><input id="name" name="name" value="<%= form.name||'' %>" required autocomplete="name"></label>
<label class="auth-field"><span>Work email</span><input id="email" name="email" type="email" value="<%= form.email||'' %>" required autocomplete="username"></label>
<label class="auth-field"><span>Password</span><span class="password-field"><input id="password" name="password" type="password" required minlength="8" maxlength="200" autocomplete="new-password"><button type="button" data-password-toggle="password" aria-pressed="false">Show</button></span><small>At least 8 characters. A password manager is recommended.</small></label>
<% if(commercialSignup){ %><details class="auth-promo" <%= signupPromo?'open':'' %>><summary>Have a promotion code?</summary><label class="auth-field"><span>Promotion code</span><input id="promoCode" name="promoCode" value="<%= signupPromo %>" maxlength="40" autocomplete="off"></label></details><% } %>
<button class="pub-btn pub-btn--block" type="submit" data-loading-label="Creating your account…">Create account</button><p class="auth-consent">By continuing, you agree to the <a href="/terms">terms</a> and acknowledge the <a href="/privacy">privacy notice</a>.</p></form>
<p class="auth-foot">Already have an account? <a href="/login">Sign in</a></p></div></section>
<aside class="auth-plan"><% if(commercialSignup){var selected=plans.find(function(plan){return plan.id===signupPlan})||plans[0]; %><span class="pub-eyebrow">YOUR SELECTION</span><h2><%= selected.public_name %></h2><p><%= selected.outcome %></p>
<div class="auth-plan__price"><strong><%= signupInterval==='annual'?'$'+Math.round(Number(selected.annual_amount_minor||0)/1200).toLocaleString('en-US'):'$'+(Number(selected.monthly_amount_minor||0)/100).toLocaleString('en-US') %></strong><span>/month</span><small><%= signupInterval==='annual'?'billed annually':'billed monthly' %></small></div>
<ul><li>No long free trial consuming your data</li><li>Payment is handled securely by Stripe</li><li>Cancel and manage invoices in the billing portal</li><li>Your first inventory is created automatically after payment</li></ul><a href="/pricing">Change plan</a><% }else{ %><span class="pub-eyebrow">YOUR OPERATION</span><h2>Start with your own records.</h2><p>Your first inventory is created from the business name you enter.</p><ul><li>Choose files, a connected system or manual entry next</li><li>Review imported records before they change inventory</li><li>Set authority only when you are ready</li><li>Keep each business inventory isolated</li></ul><% } %></aside>
</main><script src="/commercial.js?v=<%= typeof assetVersion==='undefined'?'auth':assetVersion %>" defer></script></body></html>
