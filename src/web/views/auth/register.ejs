<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Create your account · StockChief</title><link rel="stylesheet" href="/commercial.css?v=<%= assetVersion %>"><link rel="stylesheet" href="/signup.css?v=<%= assetVersion %>"><link rel="stylesheet" href="/professional-system.css?v=<%= locals.assetVersion||'current' %>">
</head>
<% var availablePlans=typeof plans!=='undefined'?plans.filter(function(p){return !p.sales_only;}):[];var chosenPlan=typeof selectedPlan==='undefined'?'':selectedPlan; %>
<body class="commercial-auth signup-auth"><main class="auth-split auth-split--register"><section class="auth-form"><a class="pub-brand" href="/"><span class="pub-brand__mark"><i aria-hidden="true"></i></span><span>StockChief</span></a><div class="auth-form__body">
<%- include('../components/signup-progress',{step:1}) %><h1>Start running your business with StockChief.</h1>
<p>Choose a paid plan. Your workspace opens after secure card payment, with a 14-day money-back guarantee.</p>
<% if(flash&&flash.length){flash.forEach(function(message){ %><div class="auth-message auth-message--<%= message.type %>" role="alert"><%= message.message %></div><% });} %>
<form method="post" action="/register" data-loading data-signup-form data-signup-enabled="<%= locals.paidSignup===true %>"><input type="hidden" name="_csrf" value="<%= csrfToken %>">
<section class="signup-panel" data-signup-panel="account" aria-labelledby="signup-account-heading"><h2 id="signup-account-heading">1. Your account</h2><label class="auth-field"><span>Business name</span><input id="businessName" name="businessName" value="<%= form.businessName||'' %>" required maxlength="120" autocomplete="organization" placeholder="e.g. Harbour Clothing"></label>
<label class="auth-field"><span>Your name</span><input id="name" name="name" value="<%= form.name||'' %>" required autocomplete="name"></label>
<label class="auth-field"><span>Work email</span><input id="email" name="email" type="email" value="<%= form.email||'' %>" required maxlength="254" autocomplete="username" inputmode="email"></label>
<label class="auth-field"><span>Business time zone</span><input name="timeZone" required data-business-time-zone value="<%= form.timeZone||'' %>" maxlength="100" placeholder="Detected from your browser"><small>Used for posting dates and scheduled reports. You can change it in Settings.</small></label>
<label class="auth-field"><span>Password</span><span class="password-field"><input id="password" name="password" type="password" required minlength="12" maxlength="200" pattern="(?=.*[A-Za-z])(?=.*[^A-Za-z0-9\s]).{12,200}" title="Use at least 12 characters with at least one letter and one symbol." autocomplete="new-password" aria-describedby="password-help"><button type="button" data-password-toggle="password" aria-pressed="false">Show</button></span><small id="password-help">Use at least 12 characters with at least one letter and one symbol.</small></label>
<label class="auth-field"><span>Confirm password</span><span class="password-field"><input id="confirmPassword" name="confirmPassword" type="password" required minlength="12" maxlength="200" autocomplete="new-password" data-confirm-password="password"><button type="button" data-password-toggle="confirmPassword" aria-pressed="false">Show</button></span></label>
<button class="pub-btn pub-btn--block" type="button" data-signup-next hidden>Choose your plan</button></section>
<section class="signup-panel" data-signup-panel="plan" aria-labelledby="signup-plan-heading"><h2 id="signup-plan-heading" tabindex="-1">2. Choose your plan</h2><p>All plans include a 14-day money-back guarantee. Billing begins after payment. Annual plans charge the listed yearly price once a year.</p>
<label class="auth-field"><span>Billing</span><select name="interval" data-billing-interval><option value="monthly" <%= selectedInterval!=='annual'?'selected':'' %>>Monthly</option><option value="annual" <%= selectedInterval==='annual'?'selected':'' %>>Annual billing</option></select></label><div class="signup-plans"><% availablePlans.forEach(function(plan){ %><label class="signup-plan"><input type="radio" name="planId" data-signup-plan value="<%= plan.id %>" <%= chosenPlan===plan.id?'checked':'' %> <%= locals.paidSignup===true?'required':'' %>><span><strong><%= plan.public_name %></strong><small><%= plan.outcome %></small></span><span class="signup-plan__price" data-billing-price data-monthly="<%= Number(plan.monthly_amount_minor)/100 %>" data-annual="<%= Number(plan.annual_amount_minor)/100 %>"><%= (Number((selectedInterval==='annual'?plan.annual_amount_minor:plan.monthly_amount_minor)||0)/100).toLocaleString('en-US',{style:'currency',currency:plan.currency||'USD',maximumFractionDigits:0}) %><small>/<%= selectedInterval==='annual'?'year':'month' %></small></span></label><% }); %></div>
<details class="auth-promo" <%= selectedPromo?'open':'' %>><summary>Have a promotion code?</summary><label class="auth-field"><span>Promotion code</span><input name="promoCode" value="<%= selectedPromo||'' %>" maxlength="40" autocomplete="off"></label></details>
<p class="auth-consent">By creating your account, you agree to the <a href="/terms">terms</a> and acknowledge the <a href="/privacy">privacy notice</a>. We will verify your email before taking you to secure payment.</p>
<div class="signup-actions"><button class="signup-link" type="button" data-signup-back hidden>Back to account</button><button class="pub-btn" type="submit" data-loading-label="Creating your account…">Create account and verify email</button></div></section></form><p class="auth-foot">Already have an account? <a href="/login">Sign in</a></p></div></section>
<aside class="auth-plan"><span class="pub-eyebrow">ONE PLACE TO RUN THE WORK</span><h2>Your records. Your decisions. Less routine work.</h2><ul><li>Import your inventory or connect your existing platforms</li><li>Manage orders, purchasing, stock and money together</li><li>Ask questions and review prepared actions in plain language</li><li>Set the authority StockChief has in your business</li></ul><div class="signup-summary"><strong>14-day money-back guarantee</strong><p>A qualifying subscription refund cancels the subscription. The workspace stays read-only for 30 days before scheduled deletion.</p></div><a href="/pricing">Compare plan details</a></aside></main><script src="/commercial.js?v=<%= assetVersion %>" defer></script><script src="/signup.js?v=<%= assetVersion %>" defer></script><script src="/billing-interval.js?v=<%= assetVersion %>" defer></script></body></html>
