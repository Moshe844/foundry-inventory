<!doctype html>
<html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1">
<title>Start with StockChief</title>
<link rel="stylesheet" href="/design.css?v=<%= typeof assetVersion==='undefined'?'auth':assetVersion %>">
<link rel="stylesheet" href="/commercial.css?v=<%= typeof assetVersion==='undefined'?'auth':assetVersion %>"></head>
<% var commercialSignup=typeof plans!=='undefined'&&Array.isArray(plans)&&plans.length>0;
   var signupPlan=commercialSignup?(typeof selectedPlan==='undefined'?'':selectedPlan):null;
   var signupInterval=typeof selectedInterval==='undefined'?'monthly':selectedInterval;
   var signupPromo=typeof selectedPromo==='undefined'?'':selectedPromo; %>
<body class="commercial-auth"><main class="auth-split auth-split--register"><section class="auth-form">
<a class="pub-brand" href="/"><span class="pub-brand__mark">◇</span><span>StockChief</span></a><div class="auth-form__body"><span class="pub-eyebrow">START WITH STOCKCHIEF</span>
<h1>Create your business workspace.</h1><p>StockChief runs your inventory—from reordering and receiving to transfers and orders—while you handle the exceptions. <%= locals.trialPolicy?.enabled?'Verify your email, then start your '+trialPolicy.days+'-day trial and choose your inventory source.':commercialSignup?'After payment, go straight to your inventory source.':'Your first inventory is created for you, then you go straight to source selection.' %></p>
<% if(commercialSignup&&!checkoutOpen){ %><div class="auth-message" role="status"><%= locals.trialPolicy?.enabled?'Start a '+trialPolicy.days+'-day trial after verifying your email. No credit card or automatic charge.':'You can create and verify your account now. Paid activation is not open yet.' %></div><% } %>
<% if(flash&&flash.length){ %><div class="auth-messages"><% flash.forEach(function(message){ %><div class="auth-message auth-message--<%= message.type %>" role="alert"><%= message.message %></div><% }); %></div><% } %>
<form method="post" action="/register" data-loading><input type="hidden" name="_csrf" value="<%= csrfToken %>"><% if(commercialSignup){ %><input type="hidden" name="planId" value="<%= signupPlan %>"><input type="hidden" name="interval" value="<%= signupInterval %>"><% } %>
<label class="auth-field"><span>Business name</span><input id="businessName" name="businessName" value="<%= form.businessName||'' %>" required maxlength="120" autocomplete="organization" placeholder="e.g. Harbour Clothing"></label>
<label class="auth-field"><span>Your name</span><input id="name" name="name" value="<%= form.name||'' %>" required autocomplete="name"></label>
<label class="auth-field"><span>Work email</span><input id="email" name="email" type="email" value="<%= form.email||'' %>" required maxlength="254" autocomplete="username" inputmode="email"></label>
<label class="auth-field"><span>Business time zone</span><input name="timeZone" data-business-time-zone value="<%= form.timeZone||'' %>" maxlength="100" placeholder="Detected from your browser"><small>Used for posting dates and scheduled reports. You can change it in Settings.</small></label>
<label class="auth-field"><span>Password</span><span class="password-field"><input id="password" name="password" type="password" required minlength="12" maxlength="200" pattern="(?=.*[A-Za-z])(?=.*[^A-Za-z0-9\s]).{12,200}" title="Use at least 12 characters with at least one letter and one symbol." autocomplete="new-password" aria-describedby="password-help"><button type="button" data-password-toggle="password" aria-pressed="false">Show</button></span><small id="password-help">Use at least 12 characters with at least one letter and one symbol.</small></label>
<label class="auth-field"><span>Confirm password</span><span class="password-field"><input id="confirmPassword" name="confirmPassword" type="password" required minlength="12" maxlength="200" autocomplete="new-password" data-confirm-password="password"><button type="button" data-password-toggle="confirmPassword" aria-pressed="false">Show</button></span></label>
<% if(commercialSignup){ %><details class="auth-promo" <%= signupPromo?'open':'' %>><summary>Have a promotion code?</summary><label class="auth-field"><span>Promotion code</span><input id="promoCode" name="promoCode" value="<%= signupPromo %>" maxlength="40" autocomplete="off"></label></details><% } %>
<button class="pub-btn pub-btn--block" type="submit" data-loading-label="Creating your account…">Create account</button><p class="auth-consent">By continuing, you agree to the <a href="/terms">terms</a> and acknowledge the <a href="/privacy">privacy notice</a>.</p></form>
<p class="auth-foot">Already have an account? <a href="/login">Sign in</a></p></div></section>
<aside class="auth-plan"><% if(locals.trialPolicy?.enabled){ %><span class="pub-eyebrow">YOUR TRIAL</span><h2>Start with your own business.</h2><p><%= trialPolicy.days %> days on the <%= trialPolicy.planId %> plan with its standard limits.</p><ul><li>Verify your email, then create your first inventory</li><li>Bring files, connect a platform or add products</li><li>No card and no automatic charge</li><li>Review every stock and financial change before approval</li></ul><% }else if(commercialSignup&&signupPlan){var selected=plans.find(function(plan){return plan.id===signupPlan}); %><span class="pub-eyebrow">YOUR SELECTION</span><h2><%= selected.public_name %></h2><p><%= selected.outcome %></p>
<div class="auth-plan__price"><strong><%= checkoutOpen?'$'+(Number(selected.monthly_amount_minor||0)/100).toLocaleString('en-US'):'Coming soon' %></strong><% if(checkoutOpen){ %><span>/month</span><% } %><small>monthly plans only</small></div>
<ul><li>No long free trial consuming your data</li><li>Payment is handled securely by Stripe</li><li>Cancel and manage invoices in the billing portal</li><li>Your first inventory is created automatically after payment</li></ul><a href="/pricing">Change plan</a><% }else if(commercialSignup){ %><span class="pub-eyebrow">NO PLAN SELECTED</span><h2>Choose after verifying your email.</h2><p>Creating an account does not enroll you in Growth—or any other plan.</p><ul><li>Compare Starter, Growth and Pro before checkout</li><li>No paid access begins without your explicit choice</li><li>Stripe confirms payment before capabilities unlock</li><li>Your first inventory is created only after activation</li></ul><a href="/pricing">Review plans</a><% }else{ %><span class="pub-eyebrow">YOUR OPERATION</span><h2>Start with your own records.</h2><p>Your first inventory is created from the business name you enter.</p><ul><li>Choose files, a connected system or manual entry next</li><li>Review imported records before they change inventory</li><li>Set authority only when you are ready</li><li>Keep each business inventory isolated</li></ul><% } %></aside>
</main><script src="/commercial.js?v=<%= typeof assetVersion==='undefined'?'auth':assetVersion %>" defer></script></body></html>
