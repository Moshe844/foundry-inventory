<!doctype html>
<html lang="en">
<head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Workspace invitation · StockChief</title><link rel="stylesheet" href="/commercial.css?v=auth"></head>
<body class="commercial-auth"><main class="auth-centered"><a class="pub-brand" href="/"><span class="pub-brand__mark">◇</span><span>StockChief</span></a><div class="auth-centered__card">
<% if(invitation&&invitation.status==='PENDING'){ %><span class="pub-eyebrow">WORKSPACE INVITATION</span><h1>Join <%= invitation.workspace_name %>.</h1><p><%= invitation.inviter_name %> invited <strong><%= invitation.email %></strong> as <%= invitation.role %>.</p>
<% if(flash&&flash.length){flash.forEach(function(message){%><div class="auth-message auth-message--<%= message.type %>"><%= message.message %></div><%});}%>
<form method="post" action="/invite" data-loading><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="token" value="<%= token %>">
<% if(!account){ %><label class="auth-field"><span>Your name</span><input name="name" value="<%= invitation.name||'' %>" required autocomplete="name"></label><label class="auth-field"><span>Create a password</span><input name="password" type="password" minlength="12" maxlength="200" pattern="(?=.*[A-Za-z])(?=.*[^A-Za-z0-9\s]).{12,200}" title="Use at least 12 characters with at least one letter and one symbol." required autocomplete="new-password" aria-describedby="password-help"><small id="password-help">Use at least 12 characters with at least one letter and one symbol.</small></label><% } %>
<button class="pub-btn pub-btn--block" type="submit">Accept invitation</button></form>
<% } else { %><span class="auth-mail">!</span><h1>This invitation is no longer available.</h1><p>It may have expired, been revoked or already been accepted. Ask the workspace owner to send a new invitation.</p><a class="pub-btn pub-btn--secondary pub-btn--block" href="/login">Sign in</a><% } %>
</div></main><script src="/commercial.js?v=auth" defer></script></body></html>
