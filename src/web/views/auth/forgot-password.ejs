<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title><%= title %> · StockChief</title><link rel="stylesheet" href="/commercial.css?v=auth"></head><body class="commercial-auth"><main class="auth-centered"><a class="pub-brand" href="/"><span class="pub-brand__mark">◇</span><span>StockChief</span></a><div class="auth-centered__card"><span class="pub-eyebrow">ACCOUNT RECOVERY</span><h1><%= title %></h1><p>Enter your account email. If it matches, StockChief sends a single-use link that expires after 30 minutes.</p><% if(flash&&flash.length){flash.forEach(function(message){%><div class="auth-message auth-message--<%= message.type %>" role="status"><%= message.message %></div><%});}%><form method="post" action="/forgot-password" data-loading><input type="hidden" name="_csrf" value="<%= csrfToken %>"><label class="auth-field"><span>Work email</span><input type="email" name="email" required autocomplete="email" autofocus></label><button class="pub-btn pub-btn--block" type="submit" data-loading-label="Sending secure link…">Send reset link</button></form><p class="auth-foot"><a href="/login">Back to sign in</a></p></div></main><script src="/commercial.js?v=auth" defer></script></body></html>
