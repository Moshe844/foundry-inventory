<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1">
  <%# The first screen anybody sees is the same product as the rest of it: it
      loads exactly what the application loads, and keeps no private copy of
      the design in a style block of its own. %>
  <link rel="stylesheet" href="/app.css">
  <link rel="stylesheet" href="/product-clarity.css">
  <link rel="stylesheet" href="/foundry.css">
  <link rel="stylesheet" href="/room.css">
  <link rel="stylesheet" href="/design.css?v=<%= typeof assetVersion === 'undefined' ? 'auth' : assetVersion %>">
<body><div class="auth"><div class="auth-card"><div class="auth-title"><h1><%= title %></h1><p>Enter the email used for StockChief. The link expires after 30 minutes.</p></div>
<% if (flash && flash.length) { %><div class="flash-stack"><% flash.forEach(function (m) { %><div class="flash flash--<%= m.type %>" role="alert"><span><%= m.message %></span></div><% }); %></div><% } %>
<div class="card"><div class="card-body"><form method="post" action="/forgot-password"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><label class="field"><span class="label">Email</span><input class="input" type="email" name="email" required autocomplete="email" autofocus></label><button class="btn btn--primary btn--block" type="submit">Send reset link</button></form></div></div>
<p class="auth-foot"><a href="/login">Back to sign in</a></p></div></div></body></html>
