<% const rememberChoices=locals.rememberDays||[30,60],rememberChosen=Number(locals.remember)||0; %><span class="auth-remember"><label><input type="checkbox" name="rememberMe" value="1"<%= rememberChosen?' checked':'' %>> Remember this device for</label><select name="rememberDays" aria-label="How long to remember this device"><% for(const day of rememberChoices){ %><option value="<%= day %>"<%= (rememberChosen||rememberChoices[0])===day?' selected':'' %>><%= day %> days</option><% } %></select></span>
