<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Verify your email · StockChief</title><link rel="stylesheet" href="/commercial.css?v=auth"></head>
<body class="commercial-auth"><main class="auth-centered"><a class="pub-brand" href="/"><span class="pub-brand__mark">◇</span><span>StockChief</span></a>
<div class="auth-centered__card"><span class="auth-mail">✉</span><span class="pub-eyebrow">ONE SAFE STEP</span>
<h1>Verify your email.</h1><p>Confirm that <strong><%= verification.email %></strong> belongs to you. Verification alone does not charge you or activate a business workspace.</p>
<form method="post" action="/verify-email" data-loading><input type="hidden" name="_csrf" value="<%= csrfToken %>">
<input type="hidden" name="token" value="<%= token %>"><button class="pub-btn pub-btn--block" type="submit" data-loading-label="Verifying…">Verify and continue</button></form>
<p class="auth-help">This extra click prevents email security scanners from using your verification link.</p>
<form method="post" action="/logout" class="auth-foot"><input type="hidden" name="_csrf" value="<%= csrfToken %>">
<button class="pub-link" type="submit">Not your account?</button></form></div></main>
<script src="/commercial.js?v=auth" defer></script></body></html>
