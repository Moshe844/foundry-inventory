<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Two-step sign-in · StockChief</title><link rel="stylesheet" href="/design.css"><link rel="stylesheet" href="/commercial.css"></head><body class="commercial-auth"><main class="auth-split"><section class="auth-form"><a class="pub-brand" href="/" data-dest="/">StockChief</a><div class="auth-form__body"><h1>Two-step sign-in</h1><% for(const notice of flash||[]){ %><p role="alert"><%= notice.message %></p><% } %>
<% if(mode==='challenge'){ %><p>Enter the current six-digit code from your authenticator app, or an unused recovery code.</p><form method="post" action="/auth/mfa"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><label class="auth-field">Authenticator or recovery code<input name="code" autocomplete="one-time-code" autofocus required maxlength="40"></label><button class="pub-btn" type="submit">Verify and sign in</button></form>
<% }else if(mode==='setup'){ %><p>In your authenticator app, choose “Enter a setup key.” Use <strong><%= account.email %></strong> as the account, choose a time-based code, and enter this key:</p><p><code data-authenticator-secret><%= secret %></code></p><p>This setup expires in 10 minutes. Confirm a code to turn protection on.</p><form method="post" action="/settings/security/confirm"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><label class="auth-field">Six-digit authenticator code<input name="code" autocomplete="one-time-code" inputmode="numeric" pattern="[0-9]{6}" required></label><button class="pub-btn" type="submit">Enable two-step sign-in</button></form>
<% }else if(mode==='recovery'){ %><h2>Save your recovery codes</h2><p>Two-step sign-in is enabled. Store these codes somewhere safe. Each works once if you lose your authenticator. These codes are shown once.</p><ul><% for(const code of recoveryCodes){ %><li><code data-recovery-code><%= code %></code></li><% } %></ul><p><a href="/settings/security" data-dest="/settings/security">I saved my recovery codes</a></p>
<% }else{ %><p>Use an authenticator app for your StockChief account. This is available on every plan.</p><p><strong><%= state.enabled?'Enabled':'Not enabled' %></strong><%= state.enabled?' · '+state.recovery_remaining+' unused recovery codes':'' %></p><% if(state.required){ %><p role="status">Your business requires two-step sign-in. Enable your authenticator to continue.</p><% } %>
<% if(!state.enabled){ %><form method="post" action="/settings/security/setup"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><label class="auth-field">Current password<input type="password" name="currentPassword" autocomplete="current-password" required></label><button class="pub-btn" type="submit">Set up authenticator app</button></form><% }else{ %><form method="post" action="/settings/security/disable"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><label class="auth-field">Current password<input type="password" name="currentPassword" autocomplete="current-password" required></label><label class="auth-field">Current authenticator or unused recovery code<input name="code" autocomplete="one-time-code" required></label><button type="submit">Disable two-step sign-in</button></form><% } %>
<% if(owner){ %><h2>Team requirement</h2><p>When required, team members must enable an authenticator before using this inventory. Enable yours first.</p><form method="post" action="/settings/security/team"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><label><input type="checkbox" name="required" value="1" <%= state.required?'checked':'' %>> Require two-step sign-in for this team</label><label class="auth-field">Current password<input type="password" name="currentPassword" autocomplete="current-password" required></label><button type="submit">Save team requirement</button></form><% } %><p><a href="/settings" data-dest="/settings">Back to settings</a></p><% } %>
<form method="post" action="/logout"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button type="submit">Sign out</button></form></div></section></main></body></html>
