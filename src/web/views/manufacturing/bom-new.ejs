<div class="production-page">
<section class="page-head"><div><h1>Prepare a bill of materials</h1><p>Define one production batch. Review and approve this revision before using it in a work order.</p></div></section>
<form method="post" action="/manufacturing/boms" class="form-stack"><input type="hidden" name="_csrf" value="<%= csrfToken %>">
 <section class="section"><h2>Finished output</h2><%- include('picker',{catalogue,label:'Finished product',field:'outputSkuId'}) %><label class="rm-field"><span>Finished units per batch</span><input name="outputQuantity" type="number" min="1" max="1000000000" value="1" required></label><label class="rm-field"><span>Production lead time in calendar days</span><input name="leadTimeDays" type="number" min="0" max="3650" value="0" required></label></section>
 <section class="section" data-production-repeat><h2>Components per batch</h2><div data-production-rows><div data-production-row><%- include('picker',{catalogue,label:'Component product',field:'componentSkuId'}) %><label class="rm-field"><span>Component units per batch</span><input name="componentQuantity" type="number" min="1" max="1000000000" value="1" required></label></div></div><button class="btn" type="button" data-add-row>Add another component</button></section>
 <section class="section" data-production-repeat><h2>Routing operations</h2><p>Optional. Record each operation in order; all required operations must be completed before finished goods are received.</p><div data-production-rows><div data-production-row><label class="rm-field"><span>Operation name</span><input name="operationName" maxlength="120"></label><label class="rm-field"><span>Work centre</span><select name="workCentreId"><option value="">No assigned centre</option><% centres.forEach(c=>{ %><option value="<%= c.id %>"><%= c.name %></option><% }) %></select></label><label class="rm-field"><span>Setup minutes</span><input name="setupMinutes" type="number" min="0" value="0"></label><label class="rm-field"><span>Minutes per batch</span><input name="minutesPerBatch" type="number" min="0" value="0"></label></div></div><button class="btn" type="button" data-add-row>Add another operation</button></section>
 <button class="btn btn--primary">Save BOM for review</button>
</form><script src="/manufacturing.js" defer></script>

</div>
