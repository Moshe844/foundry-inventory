<div class="production-page">
<section class="page-head"><div><h1>Material planning</h1><p>Net dated demand against uncommitted stock, dated purchase orders and production already in progress. Recommendations create no orders or stock.</p></div></section>
<form method="post" action="/manufacturing/planning" class="section form-stack" data-production-repeat><input type="hidden" name="_csrf" value="<%= csrfToken %>"><div data-production-rows><div data-production-row><%- include('picker',{catalogue,label:'Required product',field:'skuId'}) %><label class="rm-field"><span>Quantity needed</span><input name="quantity" type="number" min="1" max="1000000000" required></label><label class="rm-field"><span>Needed by</span><input name="neededBy" type="date" value="<%= today %>" required></label></div></div><button class="btn" type="button" data-add-row>Add another demand</button><button class="btn btn--primary">Calculate material plan</button></form>
<% if(plan){ %><section class="section"><h2>Recommended work</h2><p>Lead-time estimates do not reserve work-centre capacity. Review supplier and production availability before committing.</p><p class="table-hint">On a small screen, swipe the table sideways to see all columns.</p><div class="table-scroll" role="region" aria-label="Material recommendations" tabindex="0"><table class="table"><thead><tr><th>Action</th><th>Product</th><th>Quantity</th><th>Needed by</th><th>Start or order by</th></tr></thead><tbody><% plan.orders.forEach(r=>{ %><tr><td><%= r.kind==='MAKE'?'Make':'Buy' %></td><td><%= plan.products.find(p=>p.id===r.skuId)?.name %> · <%= plan.products.find(p=>p.id===r.skuId)?.code %></td><td><%= r.quantity %></td><td><%= r.neededBy %></td><td><%= r.releaseDate||'Review lead time' %></td></tr><% }) %></tbody></table></div><ul><% (plan.notes||[]).forEach(n=>{ %><li><%= plan.products.find(p=>p.id===n.skuId)?.code||'' %> <%= n.message %></li><% }) %></ul></section><% } %><script src="/manufacturing.js" defer></script>

</div>
