<div class="production-page">
<% const statusLabels={DRAFT:'Draft',IN_PROGRESS:'In progress',RECOVERING:'Recovering unused materials',COMPLETED:'Completed',CANCELLED:'Cancelled'},remaining=Number(job.quantity)-Number(job.good_quantity)-Number(job.scrap_quantity)-Number(job.cancelled_quantity),amount=n=>helpers.money(Number(n),job.currency),action=(name)=>'/manufacturing/work-orders/'+job.id+'/'+name; %>
<section class="page-head"><div><p class="eyebrow"><%= statusLabels[job.status] %> · needed <%= job.needed_by %></p><h1><%= job.order_number %> · <%= definition.name %></h1><p><a href="/manufacturing/boms/<%= job.bom_id %>">BOM revision <%= job.revision %></a> · <%= job.quantity %> planned · <%= job.good_quantity %> finished · <%= job.scrap_quantity %> scrapped · <%= job.cancelled_quantity %> cancelled</p></div></section>
<% if(canViewCosts){ %><section class="section"><h2>Production value</h2><dl class="detail-list"><div><dt>Consumed components</dt><dd><%= amount(job.material_cost_minor) %></dd></div><div><dt>Other evidenced production costs</dt><dd><%= amount(job.additional_cost_minor) %></dd></div><div><dt>Still in progress</dt><dd><%= amount(job.wip_cost_minor) %></dd></div></dl></section><% } %>
<section class="section"><h2>Work-centre schedule</h2><p>Daily capacity is reserved on calendar dates. Earlier routing operations finish on a prior day; no time-of-day sequencing is assumed.</p><ul><% bookings.forEach(b=>{ %><li><%= b.scheduled_day %> · <%= b.centre_name %> · <%= job.definition.routing[b.operation].name %> · <%= b.minutes %> minutes</li><% }) %></ul>
<% if(job.status==='DRAFT'&&canOperate&&job.definition.routing.length){ %><form method="post" action="<%= action('capacity') %>" class="form-stack"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="idempotencyKey" value="<%= formKey %>:capacity"><label class="rm-field"><span>Earliest allowed start</span><input name="earliestStart" type="date" value="<%= today %>" required></label><label><input type="checkbox" name="confirmed" value="yes" required> Reserve this capacity, replacing this job’s previous schedule if present.</label><button class="btn">Reserve work-centre capacity</button></form><% } %></section>
<% if(job.status==='DRAFT'&&canPost){ %><section class="section"><h2>Start actual production</h2><p>Record the components physically entering this job. This consumes stock and transfers its recorded cost into work in progress. A draft does not reserve materials.</p>
<form method="post" action="<%= action('start') %>" class="form-stack"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="idempotencyKey" value="<%= formKey %>:start">
<% definition.components.forEach((p,index)=>{ %><fieldset><legend><%= p.name %> · <%= p.code %></legend><input type="hidden" name="materialSkuId" value="<%= p.skuId %>"><input type="hidden" name="materialComponent" value="<%= index %>"><label class="rm-field"><span>Source location</span><select name="materialLocationId" required><option value="">Choose a location</option><% locations.forEach(l=>{ %><option value="<%= l.id %>"><%= l.name %></option><% }) %></select></label><label class="rm-field"><span>Actual component units</span><input name="materialQuantity" type="number" min="1" value="<%= Number(p.quantity)*(Number(job.quantity)/job.definition.outputQuantity) %>" required></label>
<% if(p.tracking_mode==='lot'){ %><label class="rm-field"><span>Lot code</span><input name="materialLotCode" required></label><% }else{ %><input type="hidden" name="materialLotCode" value=""><% } %>
<% if(p.tracking_mode==='serial'){ %><label class="rm-field"><span>Serial numbers, separated by commas</span><textarea name="materialSerials" required></textarea></label><% }else{ %><input type="hidden" name="materialSerials" value=""><% } %></fieldset><% }) %>
<label><input type="checkbox" name="confirmed" value="yes" required> These exact components physically entered production.</label><button class="btn btn--primary">Consume components and start</button></form></section><% } %>
<% if(job.status==='IN_PROGRESS'){ %>
<% if(canOperate&&job.definition.routing.length){ %><section class="section"><h2>Record a routing operation</h2><form method="post" action="<%= action('operation') %>" class="form-stack"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="idempotencyKey" value="<%= formKey %>:operation"><label class="rm-field"><span>Operation</span><select name="operation"><% job.definition.routing.forEach((r,i)=>{ %><option value="<%= i %>"><%= i+1 %>. <%= r.name %></option><% }) %></select></label><label class="rm-field"><span>Units completed at this operation</span><input name="quantity" type="number" min="1" max="<%= job.quantity %>" required></label><label class="rm-field"><span>Actual minutes</span><input name="actualMinutes" type="number" min="0" value="0" required></label><button class="btn">Record operation</button></form></section><% } %>
<% if(canPost){ %><section class="section"><h2>Receive actual finished output</h2><p><%= remaining %> units remain. Required routing operations must be complete. Scrapped units create a recorded loss and no finished stock.</p><form method="post" action="<%= action('complete') %>" class="form-stack"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="idempotencyKey" value="<%= formKey %>:complete"><label class="rm-field"><span>Good finished units</span><input name="good" type="number" min="0" max="<%= remaining %>" value="0" required></label><label class="rm-field"><span>Scrapped output units</span><input name="scrap" type="number" min="0" max="<%= remaining %>" value="0" required></label><label class="rm-field"><span>Finished stock location</span><select name="locationId" required><option value="">Choose a location</option><% locations.forEach(l=>{ %><option value="<%= l.id %>"><%= l.name %></option><% }) %></select></label>
<details><summary>Finished lot or serial tracking</summary><label class="rm-field"><span>Lot code, if lot tracked</span><input name="lotCode"></label><label class="rm-field"><span>Expiry, if recorded</span><input name="expiresAt" type="date"></label><label class="rm-field"><span>Finished serial numbers, one per line</span><textarea name="serials"></textarea></label></details><label><input type="checkbox" name="confirmed" value="yes" required> These finished and scrapped quantities were physically confirmed.</label><button class="btn btn--primary">Receive finished output</button></form></section>
<% if(!Number(job.good_quantity)&&!Number(job.scrap_quantity)){ %><section class="section"><h2>Allocate an actual production expense</h2><p>Allocate a posted expense before completing output. The same expense amount cannot be used twice.</p><form method="post" action="<%= action('add-cost') %>" class="form-stack"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="idempotencyKey" value="<%= formKey %>:cost"><label class="rm-field"><span>Recorded expense</span><select name="sourceJournalLineId" required><option value="">Choose a posted expense</option><% expenses.forEach(e=>{ %><option value="<%= e.id %>"><%= e.description %> · <%= e.account_name %> · <%= amount(e.debit_minor) %></option><% }) %></select></label><label class="rm-field"><span>Amount to allocate (<%= job.currency %>)</span><input name="amount" inputmode="decimal" required></label><label><input type="checkbox" name="confirmed" value="yes" required> This amount belongs to this production job.</label><button class="btn">Allocate production expense</button></form>
<% costs.filter(c=>!c.reversed_by_event_id).forEach(c=>{ %><form method="post" action="<%= action('reverse-cost') %>"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="idempotencyKey" value="<%= formKey %>:reverse:<%= c.id %>"><input type="hidden" name="costAdditionId" value="<%= c.id %>"><label><input type="checkbox" name="confirmed" value="yes" required> Reverse this <%= amount(c.amount_minor) %> allocation.</label><button class="btn">Reverse expense allocation</button></form><% }) %></section><% } %><% } %><% } %>
<% if(['DRAFT','IN_PROGRESS','RECOVERING'].includes(job.status)&&canPost){ %><section class="section"><h2>Cancel this work order</h2><p>This writes off any remaining <%= amount(job.wip_cost_minor) %> in progress. It does not return consumed components or undo finished goods. Keep the job open if recoverable material still needs to be accounted for.</p><form method="post" action="<%= action('cancel') %>" class="form-stack"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="idempotencyKey" value="<%= formKey %>:cancel"><label class="rm-field"><span>Cancellation and loss explanation</span><textarea name="reason" maxlength="1000" required></textarea></label><label><input type="checkbox" name="confirmed" value="yes" required> Cancel the remaining work and write off its remaining value.</label><button class="btn">Cancel and record remaining loss</button></form></section><% } %>
<% if(['IN_PROGRESS','RECOVERING'].includes(job.status)&&canPost){ %><section class="section"><h2>Recover unused materials before cancellation</h2><p>Record only components that physically returned. Finished and scrapped output retain their material use. Once recovery starts, further output is blocked; recover remaining usable components, then cancel the unfinished work.</p><% materials.forEach(m=>{const maximum=Math.max(0,Number(BigInt(m.quantity)*BigInt(Number(job.quantity)-Number(job.good_quantity)-Number(job.scrap_quantity))/BigInt(job.quantity))-Number(m.recovered_quantity));if(maximum){ %><form method="post" action="<%= action('recover-material') %>" class="form-stack"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="idempotencyKey" value="<%= formKey %>:recover:<%= m.id %>"><input type="hidden" name="materialUseId" value="<%= m.id %>"><h3><%= m.name %> · <%= m.code %></h3><label class="rm-field"><span>Unused quantity returned (up to <%= maximum %>)</span><input name="quantity" type="number" min="1" max="<%= maximum %>" required></label><label class="rm-field"><span>Return location</span><select name="locationId" required><% locations.forEach(l=>{ %><option value="<%= l.id %>" <%= l.id===m.location_id?'selected':'' %>><%= l.name %></option><% }) %></select></label><% if(m.tracking.serialUnitIds?.length){ %><label class="rm-field"><span>Original serial numbers physically returned</span><select name="serialUnitIds" multiple required><% m.recoverable_serials.forEach(serial=>{ %><option value="<%= serial.id %>"><%= serial.serial %></option><% }) %></select></label><% } %><label><input type="checkbox" name="confirmed" value="yes" required> These unused components physically returned in usable condition.</label><button class="btn">Record material recovery</button></form><% }}); %></section><% } %>
<section class="section"><h2>Production history</h2><ol><% events.forEach(e=>{ %><li><strong><%= e.kind.replaceAll('_',' ').toLowerCase() %></strong> · <%= e.actor_name %> · <time data-local-time datetime="<%= new Date(e.created_at).toISOString() %>"><%= helpers.dateTime(e.created_at) %></time><% if(e.result.quantity!=null){ %> · <%= e.result.quantity %> units<% } %><% if(e.result.good!=null){ %> · <%= e.result.good %> finished · <%= e.result.scrap %> scrapped<% } %></li><% }) %></ol></section><a class="btn" href="/manufacturing">Back to manufacturing</a>

</div>
