<%
  var gone = message.status === 'SENT';
  var over = gone || message.status === 'CANCELLED';
  var senderUnavailable = message.connectorId && !(mailboxes || []).some(function (box) { return box.id === message.connectorId; });
  var label = { PREPARED: 'Written, not sent', QUEUED: 'Waiting', SENDING: 'Sending',
                SENT: 'Sent', FAILED: 'Did not send', CANCELLED: 'Not sent' }[message.status];
%>
<nav class="breadcrumb" aria-label="Breadcrumb">
  <a href="/#tell-foundry">Tell StockChief</a><span>›</span><span>Message</span>
</nav>

<section class="section">
  <div class="panel">
    <div class="panel-head">
      <div>
        <h1 style="font-size:1.25rem; margin:0;"><%= gone ? 'What was sent' : 'Read it before it goes' %></h1>
        <span class="t-xs t-muted">
          <% if (gone) { %>
            Sent <%= helpers.shortDate(message.sentAt) %> to <%= message.recipient %>
          <% } else if (message.status === 'CANCELLED') { %>
            Not sent
          <% } else { %>
            Ready to send to <%= message.recipient %>
          <% } %>
        </span>
      </div>
      <span class="spacer"></span>
      <span class="badge badge--<%= gone ? 'ok' : message.status === 'FAILED' ? 'warn' : 'info' %>"><%= label %></span>
    </div>

    <% if (message.errorMessage && message.status === 'FAILED') { %>
      <div class="card-body">
        <div class="notice notice--warn"><div>
          <strong>This did not send.</strong><br><%= message.errorMessage %>
        </div></div>
      </div>
    <% } %>

    <% if (over) { %>
      <div class="card-body">
        <p class="t-sm"><strong>To:</strong> <%= message.recipient %></p>
        <p class="t-sm"><strong><%= message.subject %></strong></p>
        <pre class="message-body"><%= message.body %></pre>
      </div>
    <% } else { %>
      <form method="post" action="/messages/<%= message.id %>" data-busy>
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <div class="card-body">
          <label class="field">
            <span class="field-label">To</span>
            <input class="input" type="email" name="recipient" value="<%= message.recipient %>" required>
          </label>
          <label class="field">
            <span class="field-label">Subject</span>
            <input class="input" type="text" name="subject" value="<%= message.subject %>">
          </label>
          <label class="field">
            <span class="field-label">Message</span>
            <textarea class="input textarea message-edit" name="body" rows="10"><%= message.body %></textarea>
            <span class="field-hint">
              <% if (message.messageKind === 'assistant_draft') { %>
                StockChief wrote this from your records for what you asked<%= locals.draftFacts && draftFacts.instruction ? ' (“' + draftFacts.instruction + '”)' : '' %>. Every order number, date and figure in it
                comes from the facts listed below; nothing else was used. Read it and change whatever you like before it goes.
              <% } else if (message.messageKind === 'owner_message') { %>
                These are your words as you typed them. StockChief has not added, expanded or
                reworded anything. Change whatever you like before it goes.
              <% } else if (message.messageKind === 'payment_request') { %>
                Written from the order's own record: the amount owed and the page they pay on.
                StockChief states nothing here it cannot show you on the order.
              <% } else { %>
                Written from the shipment's own record. StockChief states nothing here it cannot
                show you elsewhere. Change whatever you like before it goes.
              <% } %>
            </span>
          </label>
          <% if (locals.draftFacts && draftFacts.facts && draftFacts.facts.length) { %>
            <details class="field" open>
              <summary class="field-label">What this draft is based on</summary>
              <ul class="plain-list t-sm">
                <% draftFacts.facts.forEach(function (fact) { var used = (draftFacts.used || []).some(function (u) { return u.n === fact.n; }); %>
                  <li><%= used ? '●' : '○' %> <%= fact.text %><%= used ? '' : ' (available, not used)' %></li>
                <% }) %>
              </ul>
            </details>
          <% } %>
          <% if (mailboxes && mailboxes.length) { %>
            <label class="field">
              <span class="field-label">Send from</span>
              <select class="input" name="connectorId" required>
                <% if (senderUnavailable || (!message.connectorId && mailboxes.length > 1)) { %><option value="" selected disabled>Choose the sending mailbox</option><% } %>
                <% mailboxes.forEach(function (box) { %>
                  <option value="<%= box.id %>" <%= message.connectorId === box.id ? 'selected' : '' %>>
                    <%= box.display_name %><%= box.provider_account_name ? ' · ' + box.provider_account_name : '' %>
                  </option>
                <% }) %>
              </select>
              <% if (senderUnavailable) { %><span class="field-hint">The originally chosen mailbox is unavailable. Reconnect or resume it, or explicitly choose a different sender. Nothing was substituted.</span><% } %>
            </label>
          <% } else { %>
            <p class="hint">
              No mailbox is connected, so StockChief cannot send this for you. Copy the words
              above into your own email, or
              <a href="/settings/connections">connect a mailbox</a>.
            </p>
          <% } %>
        </div>
        <div class="card-foot">
          <% if (canSend && mailboxes && mailboxes.length) { %>
            <button class="btn btn--primary" type="submit" name="action" value="send">
              Send to <%= message.recipient %>
            </button>
          <% } %>
          <button class="btn" type="submit" name="action" value="save" formnovalidate>Save for later</button>
          <button class="btn btn--ghost" type="submit" name="action" value="cancel" formnovalidate>Do not send</button>
        </div>
      </form>
    <% } %>
  </div>
</section>
