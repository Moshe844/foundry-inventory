<div class="rm-head"><a class="rm-head__back" href="/ask"><span aria-hidden="true">←</span> Ask StockChief</a><div class="rm-title"><div><p class="rm-stamp">Business email</p><h1><%= message.subject %></h1></div><span class="badge badge--<%= message.status==='SENT'?'ok':message.status==='FAILED'?'warn':'muted' %>"><%= message.status %></span></div></div>
<section class="section measure"><dl class="summary-list"><div><dt>To</dt><dd><%= message.contact_name || message.recipient %> · <%= message.recipient %></dd></div><div><dt>Mailbox</dt><dd><%= message.display_name || 'Unavailable' %></dd></div><div><dt>Provider verification</dt><dd><%= message.provider_status || 'Not queued' %></dd></div></dl><div class="quiet-note"><strong>Exact approved message</strong><p><%= message.body %></p></div><% if(message.status==='SENT'){ %><p class="notice">The mailbox provider confirmed this message at <%= helpers.dateTime(message.sent_at) %>.</p><% } %><% if(message.provider_status==='AMBIGUOUS'){ %><p class="notice">Delivery could not be verified. StockChief did not retry. Check Sent mail before taking another action.</p><% } else if(message.status==='FAILED'){ %><p class="notice"><%= message.provider_error || message.error_message %></p><% } %></section>
