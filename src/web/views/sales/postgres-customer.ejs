<header class="page-head"><div class="titles"><a class="back-link" href="/customers">‹ Customers</a><h1><%= customer.name %></h1><p class="page-sub"><%= customer.record_state==='ARCHIVED'?'Archived · ':'' %><%= orders.length %> recent order<%= orders.length===1?'':'s' %> · <%= helpers.money(balanceMinor,currency) %> outstanding</p></div>
  <div class="page-actions"><% if(customer.record_state==='ACTIVE'){ %><a class="btn btn--primary" href="/orders/new?customer=<%= customer.id %>">New order</a><% } %></div></header>
<div class="grid grid--2 section">
  <form class="card" method="post" action="/sales/customers/<%= customer.id %>"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><div class="card-head"><h2>Customer details</h2></div><div class="card-body grid">
    <label class="field"><span class="field-label">Name</span><input class="input" name="name" value="<%= customer.name %>" required></label>
    <label class="field"><span class="field-label">Company</span><input class="input" name="company" value="<%= customer.company||'' %>"></label>
    <label class="field"><span class="field-label">Email</span><input class="input" type="email" name="email" value="<%= customer.email||'' %>"></label>
    <label class="field"><span class="field-label">Phone</span><input class="input" name="phone" value="<%= customer.phone||'' %>"></label>
    <div class="field"><span class="field-label">Delivery address</span><%- include('../partials/address-fields',{idPrefix:'customer-edit-addr',target:'customer-edit-address'}) %></div><label class="field addr-native"><span class="field-label">Default shipping address</span><textarea class="input" id="customer-edit-address" name="shippingAddress" rows="3"><%= customer.shipping_address||'' %></textarea><span class="field-help">Changing this does not change an existing order's destination.</span></label>
    <label class="field"><span class="field-label">Notes</span><textarea class="input" name="notes" rows="3"><%= customer.notes||'' %></textarea></label>
  </div><div class="card-foot"><button class="btn btn--primary" type="submit">Save customer</button></div></form>
  <section class="card"><div class="card-head"><h2>Order history</h2></div><div class="card-body"><% if(!orders.length){ %><p class="muted">No orders yet.</p><% } else { %><div class="list-rows"><% orders.forEach(function(order){ %><a class="list-row" href="/orders/<%= order.id %>"><strong><%= order.order_number %></strong><span><%= helpers.shortDate(order.order_date) %> · <%= order.status.replaceAll('_',' ') %></span></a><% }); %></div><% } %></div></section>
</div>
<% if(locals.habits){ const h=habits.habit; %>
<section class="card section" id="customer-habits" data-customer-habits><div class="card-head"><h2>Habits</h2></div><div class="card-body">
<% if(habits.locked){ %><p class="cell-sub">Learning each customer’s habits comes with Growth. <a href="/billing">Review plans</a></p>
<% }else if(!h){ %><p class="cell-sub"><%= habits.empty %></p>
<% }else{ %><dl class="kv">
  <dt>How often</dt><dd><%= h.interval %></dd>
  <dt>Usual day</dt><dd><%= h.weekday %></dd>
  <dt>Usual order</dt><dd><%= h.size %></dd>
  <dt>Next order</dt><dd><% if(h.due.state!=='later'){ %><span class="badge badge--<%= h.due.state==='late'?'warn':'info' %>"><%= h.due.state==='late'?'Later than usual':'Due now' %></span> <% } %><%= h.due.detail %></dd>
</dl><p class="cell-sub">From <%= h.samples %> ordering days, the last on <%= h.latest %>.</p><% } %>
</div></section><% } %>
<% if(locals.canEditTerms){ const own=terms?.customer_id===customer.id?terms:null; %>
<section class="card section"><div class="card-head"><h2>Agreed payment terms</h2></div>
<form class="card-body form-stack" method="post" action="/sales/customers/<%= customer.id %>/payment-terms">
  <input type="hidden" name="_csrf" value="<%= csrfToken %>">
  <input type="hidden" name="expectedUpdatedAt" value="<%= own?.updated_at||'' %>">
  <label>Payment terms <select name="kind">
    <% for(const [kind,label] of [['ON_ACCOUNT','On account'],['DEPOSIT','Deposit before fulfillment'],['BEFORE_FULFILMENT','Pay before fulfillment']]){ %>
    <option value="<%= kind %>" <%= (own?.kind||'ON_ACCOUNT')===kind?'selected':'' %>><%= label %></option><% } %>
  </select></label>
  <label>Net days <input name="netDays" type="number" min="0" step="1" value="<%= own?.net_days??'' %>"></label>
  <label>Deposit percentage <input name="depositPercent" type="number" min="0.01" max="100" step="0.01" value="<%= own?.deposit_percent??'' %>"></label>
  <label>Or fixed deposit <input name="depositAmount" inputmode="decimal" value="<%= own?depositInput:'' %>"></label>
  <label>Fixed deposit currency <input name="depositCurrency" minlength="3" maxlength="3" value="<%= own?.deposit_currency||currency %>"></label>
  <label><input name="holdShipping" type="checkbox" value="1" <%= Number(own?.hold_shipping)?'checked':'' %>> Balance due before shipping</label>
  <label><input name="creditApproved" type="checkbox" value="1" <%= Number(own?.credit_approved)?'checked':'' %>> Credit approved</label>
  <button class="btn" type="submit">Save agreed terms</button>
</form></section><% } %>
<section class="section"><form method="post" action="/sales/customers/<%= customer.id %>/archive"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><% if(customer.record_state==='ARCHIVED'){ %><input type="hidden" name="restore" value="1"><button class="btn" type="submit">Restore customer</button><% } else { %><p class="muted">Archiving removes this customer from new-order choices. Their history remains. Deleting removes a customer nothing refers to completely.</p><div class="rd-actions rd-actions--start"><button class="btn btn--ghost" type="submit">Archive customer</button><a class="btn btn--ghost rd-delete" href="/delete/customer/<%= encodeURIComponent(customer.id) %>">Delete customer</a></div><% } %></form></section>
