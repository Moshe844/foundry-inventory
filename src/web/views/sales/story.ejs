<%
  /*
   * A customer order, end to end, on one page.
   *
   * This replaced five addresses: the order, the fulfilment queue, the
   * mailbox, the receivable and the payment panel. Sales, purchasing,
   * customer email, picking, shipping and the accounting consequence are all
   * lines of one story, in one column, with no tabs — because from the
   * owner's side they are one thing that is happening, and the fact that
   * StockChief runs them in six services is StockChief's business rather than
   * theirs.
   *
   * The operational detail — the lines, the prices, the payment controls, the
   * picking form — has not gone anywhere. It is one link at the bottom, which
   * is where somebody who wants to work on the order rather than understand it
   * will look for it.
   */
  var short = locals.shortageDetails || [];
  var pay = locals.money || {};
  var paidInFull = Number(pay.totalMinor || 0) > 0 && Number(pay.remainingMinor || 0) === 0;
  var held = Number(order.totals && order.totals.allocated || 0);
  var next = locals.orderNext || {};
  var nextSection = next.href && next.href.startsWith('#') ? next.href.slice(1) : 'fulfilment';
  var postedAccounting = locals.accounting && locals.accounting.status === 'POSTED'
    ? (locals.accounting.outcome || {}) : null;
%>

<a class="rm-head__back" href="/orders"><span aria-hidden="true">←</span> Orders</a>
<%- include('../partials/spine', { story: story, collapseHistory: true }) %>
<%- include('allocation-settings') %>

<section class="rm-panel" style="margin-top:22px">
  <div class="rm-panel__head">
    <h2>This order right now</h2>
    <span class="right"><%= paidInFull ? 'Paid in full' : (pay.state || '') %></span>
  </div>
  <div style="padding:18px 20px">
    <h3 style="margin:0 0 8px"><%= paidInFull && next.text === 'Ready to pick' ? 'Paid in full — ready to pick' : next.text %></h3>
    <% if (paidInFull) { %>
      <p style="margin:0 0 8px">The customer paid <strong><%= helpers.money(pay.paidMinor, pay.currency) %></strong>. StockChief recorded the cash, and the customer now owes <strong><%= helpers.money(pay.remainingMinor, pay.currency) %></strong>.</p>
      <% if (order.status !== 'FULFILLED') { %>
        <p class="rm-sub" style="margin:0"><%= held %> <%= held === 1 ? 'unit is' : 'units are' %> held for this customer but the goods have not left yet. This is cash received, not earned revenue or profit yet.</p>
      <% } %>
    <% } else { %>
      <% if (next.detail) { %><p style="margin:0"><%= next.detail %></p><% } %>
      <% if (Number(pay.remainingMinor || 0) > 0) { %><p class="rm-sub" style="margin:8px 0 0">The customer still needs to pay <%= helpers.money(pay.remainingMinor, pay.currency) %>.</p><% } %>
    <% } %>
    <% if (postedAccounting) { %>
      <div class="accounting-explanation" style="margin-top:14px">
        You completed a <strong><%= helpers.money(postedAccounting.revenueMinor || 0, pay.currency) %></strong> sale.
        The products cost <strong><%= helpers.money(postedAccounting.cogsMinor || 0, pay.currency) %></strong>,
        creating <strong><%= helpers.money((postedAccounting.revenueMinor || 0) - (postedAccounting.cogsMinor || 0), pay.currency) %></strong>
        gross profit before other expenses.
        <% if (Number(pay.remainingMinor || 0) > 0) { %>
          The customer still owes <strong><%= helpers.money(pay.remainingMinor, pay.currency) %></strong>.
        <% } else { %>
          The customer has paid in full.
        <% } %>
        <a href="/accounting/entries/<%= locals.accounting.journal_entry_id %>">Show the exact sale and product cost</a>.
      </div>
    <% } %>
    <%# The next step and the money, side by side: one row of buttons, not a
        column of them. Delivery is named here because a shipped order with no
        address stops at dispatch, and that was the first place it said so. %>
    <% var noAddress = order.delivery_method !== 'PICKUP' && !order.ship_to_address && order.status !== 'CANCELLED' && order.status !== 'FULFILLED'; %>
    <p class="rm-sub" style="margin:10px 0 0">
      <% if (order.delivery_method === 'PICKUP') { %>
        Customer collects it.
      <% } else if (order.ship_to_address) { %>
        Ships to <%= order.ship_to_address %>.
      <% } else if (noAddress) { %>
        <span class="is-warn">No delivery address yet</span> — it can be picked, but nothing can leave until there is one.
        <a href="/orders/<%= order.id %>?open=fulfilment#fulfilment">Add the address or switch to collection</a>.
      <% } %>
    </p>
    <% if (next.action || (Number(pay.remainingMinor || 0) > 0 && order.status !== 'CANCELLED')) { %>
      <div class="rm-choices" style="margin-top:16px">
        <% if (next.action) { %><a class="rm-btn" href="/orders/<%= order.id %>?open=<%= nextSection %>#<%= nextSection %>"><%= next.action %></a><% } %>
        <% if (Number(pay.remainingMinor || 0) > 0 && order.status !== 'CANCELLED') { %><a class="rm-btn rm-btn--wash" href="/orders/<%= order.id %>?open=money#money">Record or request payment</a><% } %>
      </div>
      <% if (Number(pay.remainingMinor || 0) > 0 && order.status !== 'CANCELLED') { %>
        <p class="rm-sub" style="margin:10px 0 0">Picking and packing do not reduce on-hand stock; dispatch does. Dispatch never marks the order paid.</p>
      <% } %>
    <% } %>
  </div>
</section>

<%# What the customer ordered, always in view. %>
<p class="rm-stamp" style="margin-top:30px">What is on it</p>
<div class="table-wrap rm-lines">
  <table class="table table--stack">
    <thead><tr>
      <th>Product</th>
      <th class="num">Ordered</th>
      <th class="num">Held</th>
      <th class="num">Shipped</th>
      <th class="num">Price</th>
      <th class="num">Total</th>
    </tr></thead>
    <tbody>
      <% (order.lines || []).forEach(function (line) { %>
        <tr>
          <td data-label="Product">
            <div class="cell-main">
              <span class="cell-title"><% if (line.item_id) { %><a class="rm-u" href="/inventory/<%= line.item_id %>#sku-<%= line.sku_id %>"><%= line.displayName %></a><% } else { %><%= line.displayName %><% } %></span>
              <span class="cell-sub"><span class="mono"><%= line.code %></span><% if (line.backordered) { %> · <span class="is-warn"><%= line.backordered %> short</span><% } %></span>
            </div>
          </td>
          <td class="num" data-label="Ordered"><%= line.quantity_ordered %></td>
          <td class="num" data-label="Held"><% if (line.allocated) { %><%= line.allocated %><% } else { %><span class="rm-quiet">0</span><% } %></td>
          <td class="num" data-label="Shipped"><% if (Number(line.quantity_fulfilled) >= Number(line.quantity_ordered)) { %><span class="badge badge--ok">all <%= line.quantity_fulfilled %></span><% } else if (Number(line.quantity_fulfilled) > 0) { %><span class="badge badge--warn"><%= line.quantity_fulfilled %> of <%= line.quantity_ordered %></span><% } else { %><span class="rm-quiet">0</span><% } %></td>
          <td class="num" data-label="Price"><% if (line.unit_price_minor != null) { %><%= helpers.money(line.unit_price_minor, order.currency) %><% } else { %><span class="badge badge--warn">no price</span><% } %></td>
          <td class="num" data-label="Total"><% if (line.lineTotalMinor != null) { %><%= helpers.money(line.lineTotalMinor, order.currency) %><% } else { %>—<% } %></td>
        </tr>
      <% }) %>
    </tbody>
    <tfoot><tr>
      <td colspan="5" class="num"><strong><%= order.totals.ordered %> units</strong> · <%= (order.lines || []).length %> line<%= (order.lines || []).length === 1 ? '' : 's' %></td>
      <td class="num"><strong><%= helpers.money(order.pricing && order.pricing.subtotalMinor != null ? order.pricing.subtotalMinor : (order.lines || []).reduce(function (s, l) { return s + (l.lineTotalMinor || 0); }, 0), order.currency) %></strong></td>
    </tr></tfoot>
  </table>
</div>

<% if (locals.evidenceTrace) { %>
  <details class="rm-work" style="margin-top:24px">
    <summary>See how this order is connected</summary>
    <div class="rm-work__body">
      <p style="margin-top:0"><%= evidenceTrace.ownerSummary %></p>
      <div class="accounting-next-list">
        <% evidenceTrace.ownerSteps.forEach(function (step, index) { %>
          <p>
            <strong><%= index + 1 %>. <%= step.label %></strong><br>
            <span><%= step.text %></span>
            <% if (step.href) { %> <a href="<%= step.href %>"><%= step.linkText %></a>.<% } %>
          </p>
        <% }) %>
      </div>
      <% evidenceTrace.unknown.forEach(function (gap) { %><p class="rm-sub"><%= gap %></p><% }) %>
      <details class="disclose" style="margin-top:16px">
        <summary>Advanced evidence records</summary>
        <div class="disclose__body">
          <p class="rm-sub">These are the immutable record links StockChief used. They are here for audit and troubleshooting, not for reading the order day to day.</p>
          <% evidenceTrace.details.forEach(function (link) { %>
            <p class="rm-sub">
              <% if (link.from.href) { %><a href="<%= link.from.href %>"><%= link.from.title %></a><% } else { %><%= link.from.title %><% } %>
              <%= link.phrase %>
              <% if (link.to.href) { %><a href="<%= link.to.href %>"><%= link.to.title %></a><% } else { %><%= link.to.title %><% } %>.
            </p>
          <% }) %>
        </div>
      </details>
    </div>
  </details>
<% } %>

<%
  /*
   * A shortage is a decision, not a dead end. If StockChief has already ordered
   * the missing stock the spine says so; what belongs here is the case where
   * it cannot, and the decision it is waiting on.
   */
  var uncovered = short.filter(function (row) { return row.availableNow < row.missing; });
%>
<% if (uncovered.length) { %>
  <div class="rm-decision" style="margin-top:30px">
    <span class="rm-decision__arrow" aria-hidden="true">→</span>
    <span class="rm-decision__txt">
      <%= uncovered.length === 1 ? uncovered[0].displayName + ' is ' + uncovered[0].missing + ' short' : uncovered.length + ' products are short' %>.
      <small>
        <% if (uncovered[0].availableNow) { %>
          <%= uncovered[0].availableNow %> of them are on a shelf somewhere else.
        <% } %>
        I have checked the other locations and what is on order. What is left needs a supplier decision.
      </small>
    </span>
    <span class="rm-decision__go"><a class="rm-btn" href="<%= uncovered[0].actionHref %>"><%= uncovered[0].actionLabel %></a></span>
  </div>
<% } %>

<div class="rm-spine-foot">
  <a class="rm-btn rm-btn--ghost" href="/ask?about=<%= encodeURIComponent(order.order_number + ' for ' + (order.customer ? order.customer.name : '')) %>">Ask about this order</a>
</div>

<%
  /*
   * The working detail, on the same page, one disclosure down.
   *
   * Progressive detail rather than a second address: the story is what
   * somebody reads, and the lines, prices, payment controls and picking form
   * are what somebody works with. Putting them behind a link would have made
   * understanding an order one page and acting on it another, which is the
   * split this redesign exists to close — so they stay here, closed, and the
   * rule that nothing is more than one story deep still holds.
   *
   * /orders/:id/detail renders the same thing on its own for anybody who wants
   * only the working page.
   */
%>
<details class="rm-work" id="working"<% if (locals.paymentCompleted) { %> open<% } %>>
  <summary>Money, shipping, documents and the full working record</summary>
  <div class="rm-work__body"><%- include('order') %></div>
</details>

<p class="rm-disclose">
  <% if (order.customer && order.customer.id) { %><a href="/sales/customers/<%= order.customer.id %>">Everything for <%= order.customer.name %></a><% } %>
  <% if ((locals.shipments || []).length) { %><a href="/fulfilment/<%= shipments[0].id %>">The shipment</a><% } %>
  <% if (pay.remainingMinor) { %><a href="/money">What you're owed</a><% } %>
  <a href="/orders">Other orders</a>
</p>
