<section class="card section"><div class="card-body"><h2>Order contact and destination</h2><p><%= order.customer.name %> · <%= order.customer.email||'No email' %> · <%= order.customer.phone||'No phone' %></p><p><%= order.delivery_method==='PICKUP'?'Customer pickup':order.ship_to_address||'Delivery address missing' %></p><div class="form-actions"><% if(order.status==='DRAFT'){ %><a class="btn" href="/orders/<%= order.id %>/edit">Edit draft order</a><% } %><a class="btn btn--ghost" href="/orders/new?duplicate=<%= order.id %>">Duplicate order</a></div></div></section>
