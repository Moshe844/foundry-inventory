<section class="card section ox-contact"><div class="card-body"><h2><%= order.delivery_method==='PICKUP'?'Customer and pickup':'Customer and delivery' %></h2><p><a href="/sales/customers/<%= order.customer.id %>"><strong><%= order.customer.name %></strong></a></p><p><%= order.customer.email||'No email' %> · <%= order.customer.phone||'No phone' %></p><p><%= order.delivery_method==='PICKUP'?'Customer pickup':order.ship_to_address||'Delivery address missing' %></p><div class="form-actions"><a class="btn btn--ghost" href="/orders/new?duplicate=<%= order.id %>">Duplicate order</a></div></div></section>
