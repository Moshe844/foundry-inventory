<% const list=v=>Array.isArray(v)?v:[v??''];const ids=list(form.skuId),qty=list(form.quantity),prices=list(form.unitPrice),overrides=list(form.priceOverride);const count=Math.max(1,ids.length); %>
<div class="rm-head"><a href="<%= locals.quotation?'/quotes':'/orders' %>">← <%= locals.quotation?'Quotes':'Orders' %></a><h1><%= locals.quotation?'Prepare a customer quotation':editOrder?'Edit draft order':'What did the customer order?' %></h1><p>Choose the customer and products. Prices and totals use your saved pricing rules.<% if(locals.quotation){ %> Saving a quote reserves no stock and sends no message.<% } %></p></div>
<% if(formError){ %><div class="notice notice--warn" role="alert"><div><strong><%= locals.quotation?'Quotation':'Order' %> not saved.</strong> <%= formError %></div></div><% } %>
<form method="post" action="<%= locals.quotation?'/quotes':editOrder?'/orders/'+editOrder.id+'/edit':'/sales/orders' %>" class="card form-card" id="sales-entry">
 <input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="currency" value="<%= currency %>">
 <input type="hidden" name="idempotencyKey" value="<%= form.idempotencyKey||operationKey %>">
 <% if(locals.quotation){ %><label class="rm-field"><span>Quotation valid through</span><input type="date" name="validUntil" min="<%= today %>" value="<%= form.validUntil||today %>" required></label><input type="hidden" name="supersedesId" value="<%= form.supersedesId||'' %>"><% } %>
 <% ['email','phone','address'].forEach(key=>{ %><input type="hidden" data-contact-manual="<%= key %>" name="<%= key %>Manual" value="<%= form[key+'Manual']||'' %>"><% }) %>
 <% if(editOrder){ %><input type="hidden" name="expectedVersion" value="<%= editOrder.version %>"><input type="hidden" name="editOrderId" value="<%= editOrder.id %>"><% } %>
 <section class="rm-step-panel"><div class="rm-step-panel__h"><h2>Customer and delivery</h2></div><div class="rm-step-panel__b form-grid">
 <label class="rm-field"><span>Customer</span><select name="customerId" id="order-customer" aria-label="Customer" required><option value="">Choose a customer</option><% customers.forEach(c=>{ %><option value="<%= c.id %>" data-email="<%= c.email||'' %>" data-phone="<%= c.phone||'' %>" data-address="<%= c.shipping_address||'' %>" <%= form.customerId===c.id?'selected':'' %>><%= c.name %></option><% }) %></select></label>
 <button class="btn btn--ghost" type="button" data-modal-open="new-order-customer">+ New customer</button>
 <label class="rm-field"><span>Their email <small>order updates</small></span><input type="email" name="customerEmail" id="order-customer-email" data-customer-field="email" value="<%= form.customerEmail??'' %>"></label>
 <label class="rm-field"><span>Phone</span><input type="tel" name="customerPhone" data-customer-field="phone" value="<%= form.customerPhone??'' %>"></label>
 <fieldset class="rm-picks"><legend>How will they receive it?</legend><label><input type="radio" name="deliveryMethod" value="SHIP" <%= form.deliveryMethod!=='PICKUP'?'checked':'' %>> Send by carrier</label><label><input type="radio" name="deliveryMethod" value="PICKUP" <%= form.deliveryMethod==='PICKUP'?'checked':'' %>> Customer pickup</label></fieldset>
 <div id="order-destination"><label class="rm-field"><span>Delivery address for this order</span><textarea name="customerShippingAddress" id="order-customer-address" data-customer-field="address" rows="3"><%= form.customerShippingAddress??'' %></textarea><small>Saved with this order. Customer defaults stay unchanged.</small></label></div>
 <label class="rm-field"><span>Ship from</span><select name="fulfillmentLocationId" id="order-location"><option value="">Use available stock across locations</option><% locations.forEach((l,i)=>{ %><option value="<%= l.id %>" <%= form.fulfillmentLocationId!==undefined?(form.fulfillmentLocationId===l.id?'selected':''):(i===0?'selected':'') %>><%= l.name %></option><% }) %></select></label>
 </div></section>
 <section class="rm-step-panel"><div class="rm-step-panel__h"><h2>Products</h2></div><div class="rm-step-panel__b">
 <div id="order-lines"><% for(let n=0;n<count;n++){ %><%- include('entry-line',{n,selected:ids[n]||'',quantity:form.quantity===undefined?'1':qty[n]??'',secondaryQuantity:list(form.secondaryQuantity)[n]||'',price:prices[n]??'',override:overrides[n]??(prices[n]?'1':'0'),catalogue}) %><% } %></div>
 <button type="button" class="btn btn--ghost" id="add-order-line">+ Add another product</button>
 <p id="order-stock-check" role="status">Choose products to see available stock.</p>
 <p id="order-weight" class="hint"></p>
 </div></section>
 <% if(!taxRates.length){ %><aside class="notice notice--warn" role="status"><strong>Set up your sales tax before invoicing.</strong> <a href="/accounting/tax?next=/orders/new">Add a tax rate</a>, if your business charges sales tax. You can save a tax-free draft while you finish setup.</aside><% } %><details class="rm-work"><summary>Optional order details — dates, tax, discount, reference, and notes</summary><div class="rm-work__body form-grid">
 <label class="rm-field"><span>Order number <small>optional</small></span><input name="orderNumber" value="<%= form.orderNumber||'' %>" <%= editOrder?'disabled':'' %>></label>
 <label class="rm-field"><span>Order date</span><input type="date" name="orderDate" value="<%= form.orderDate||today %>" required></label>
 <label class="rm-field"><span>Needed by</span><input type="date" name="neededBy" value="<%= form.neededBy||'' %>"></label>
 <label class="rm-field"><span>Discount amount</span><input name="discount" inputmode="decimal" value="<%= form.discount||'' %>"></label>
 <label class="rm-field"><span>Tax rate</span><select name="taxRateId"><option value=""><%= taxRates.length?'Select a tax rate':'No tax rate set up' %></option><% taxRates.forEach(t=>{ %><option value="<%= t.id %>" <%= form.taxRateId===t.id?'selected':'' %>><%= t.name %> · <%= Number(t.rate_millionths)/10000 %>%</option><% }) %></select><small><a href="/accounting/tax">Manage tax rates</a></small></label>
 <label class="rm-field"><span>Tax amount <small>only without a configured rate</small></span><input name="tax" inputmode="decimal" value="<%= form.tax||'' %>"></label>
 <label class="rm-field"><span>Promotion codes</span><input name="couponCodes" value="<%= form.couponCodes||'' %>"></label>
 <input type="hidden" name="priceListId" value="<%= form.priceListId||'' %>">
 <label class="rm-field"><span>Reference</span><input name="reference" value="<%= form.reference||'' %>"></label><label class="rm-field"><span>Notes</span><textarea name="notes"><%= form.notes||'' %></textarea></label>
 </div></details>
 <section class="section" aria-live="polite" aria-label="Order totals"><p id="order-quote-status">Choose a customer and product to calculate totals.</p><dl class="kv"><dt>Subtotal</dt><dd data-total="subtotalMinor">—</dd><dt>Discount</dt><dd data-total="discountMinor">—</dd><dt>Tax</dt><dd data-total="taxMinor">—</dd><dt>Total</dt><dd data-total="totalMinor">—</dd></dl></section>
 <div class="form-actions"><% if(locals.quotation){ %><button class="rm-btn" type="submit">Save quotation</button><% }else if(editOrder){ %><button class="rm-btn" type="submit">Save draft changes</button><% }else{ %><button class="rm-btn" id="order-confirm-button" name="nextStep" value="confirm">Create order and reserve stock</button><button class="rm-btn" id="order-complete-button" name="nextStep" value="fulfill" hidden>Customer has it now — complete pickup</button><button class="rm-btn rm-btn--ghost" name="nextStep" value="draft">Save draft</button><% } %><a href="<%= locals.quotation?'/quotes':'/orders' %>">Cancel</a></div>
</form>
<dialog class="modal" id="new-order-customer"><form action="/sales/customers" method="post" data-inline-customer><input type="hidden" name="_csrf" value="<%= csrfToken %>"><div class="modal-head"><h2>New customer</h2><button type="button" data-modal-close aria-label="Close">×</button></div><div class="modal-body"><label class="field"><span>Customer name</span><input name="name" required></label><label class="field"><span>Customer email</span><input name="email" type="email"></label><label class="field"><span>Customer phone</span><input name="phone"></label><label class="field"><span>Customer shipping address</span><textarea name="shippingAddress"></textarea></label><p role="status" data-customer-status></p><button class="btn btn--primary">Save customer</button></div></form></dialog><script src="/inline-customer.js?v=<%= assetVersion %>" defer></script>
<template id="order-line-template"><%- include('entry-line',{n:0,selected:'',quantity:'1',secondaryQuantity:'',price:'',override:'0',catalogue}) %></template>
<script type="application/json" id="order-catalogue"><%- JSON.stringify(catalogue).replace(/</g,'\\u003c') %></script>
<script src="/sales-entry.js?v=<%= assetVersion %>" defer></script>
