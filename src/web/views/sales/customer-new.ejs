<%
  /*
   * Adding a customer.
   *
   * One question — who are they — asked as a card head, a hint, a form grid and
   * a fold, all wrapped around five fields. What matters is that the name is
   * the only requirement and everything else can wait, and that was the one
   * thing the layout did not make obvious.
   */
%>

<div class="rm-head">
  <a class="rm-head__back" href="/customers"><span aria-hidden="true">←</span> Customers</a>
  <p class="rm-head__eyebrow"><%- helpers.icon('user', { size: 15 }) %> Customer</p>
  <h1>Who is the customer?</h1>
  <p>Name them once. Contact and delivery details can be added now or later.</p>
</div>

<% if (locals.formError) { %>
  <div class="rm-note rm-note--warn">
    <%- helpers.icon('alert', { size: 16 }) %>
    <div><strong>Customer not saved.</strong> <%= locals.formError %></div>
  </div>
<% } %>

<form method="post" action="/sales/customers" class="rm-form">
  <input type="hidden" name="_csrf" value="<%= csrfToken %>">

  <section class="rm-panel">
    <div class="rm-panel__head">
      <h2>Customer details</h2>
      <span class="right">Only the name is required</span>
    </div>
    <div class="rm-panel__body">
      <label class="rm-field">
        <span>Name</span>
        <input name="name" value="<%= form.name || '' %>" required autofocus placeholder="Person or business name">
      </label>
      <div class="rm-grid2" style="margin-bottom:0">
        <label class="rm-field">
          <span>Email <small>for order and shipping messages</small></span>
          <input type="email" name="email" value="<%= form.email || '' %>" placeholder="name@example.com">
        </label>
        <label class="rm-field">
          <span>Phone <small>optional</small></span>
          <input name="phone" value="<%= form.phone || '' %>">
        </label>
      </div>
      <% if(locals.postgresCustomer){ %><fieldset class="rm-work"><legend>Default delivery address · optional</legend><div class="rm-grid2"><label class="rm-field"><span>Street address</span><input name="addressLine1" maxlength="200" autocomplete="address-line1" value="<%= form.addressLine1||'' %>"></label><label class="rm-field"><span>Apartment, suite or unit</span><input name="addressLine2" maxlength="200" autocomplete="address-line2" value="<%= form.addressLine2||'' %>"></label><label class="rm-field"><span>City</span><input name="city" maxlength="200" autocomplete="address-level2" value="<%= form.city||'' %>"></label><label class="rm-field"><span>State or province</span><input name="state" maxlength="200" autocomplete="address-level1" value="<%= form.state||'' %>"></label><label class="rm-field"><span>Postal code</span><input name="postalCode" maxlength="200" autocomplete="postal-code" value="<%= form.postalCode||'' %>"></label><label class="rm-field"><span>Country code</span><input name="country" maxlength="2" autocomplete="country" value="<%= form.country||'US' %>" placeholder="US"></label></div></fieldset><% } %>
      <% if(!locals.postgresCustomer||form.shippingAddress){ %><label class="rm-field">
        <span>Default shipping address <small>optional</small></span>
        <textarea name="shippingAddress" rows="3" placeholder="Street, town, state, postcode"><%= form.shippingAddress || '' %></textarea>
        <small>Each Sales Order keeps its own confirmed destination; this is only the starting default.</small>
      </label><% } %>
    </div>
    <p class="rm-panel__foot">
      StockChief will say what is missing when an order needs delivery or an email.
    </p>
  </section>

  <details class="rm-work">
    <summary>Company and notes</summary>
    <div class="rm-work__body">
      <div class="rm-grid2" style="margin:12px 0 0">
        <label class="rm-field"><span>Company</span><input name="company" value="<%= form.company || '' %>"></label>
        <label class="rm-field"><span>Notes</span><textarea name="notes"><%= form.notes || '' %></textarea></label>
      </div>
    </div>
  </details>
  <% if(locals.postgresCustomer){ %><details class="rm-work" <%= form.termsKind||form.taxExempt?'open':'' %>><summary>Payment terms and tax</summary><div class="rm-work__body"><label class="rm-field"><span>Payment terms</span><select name="termsKind"><% [['','No separate terms agreed'],['ON_ACCOUNT','On account / net terms'],['BEFORE_FULFILMENT','Paid before fulfillment'],['DEPOSIT','Deposit before fulfillment']].forEach(([key,name])=>{ %><option value="<%= key %>" <%= form.termsKind===key?'selected':'' %>><%= name %></option><% }); %></select></label><label class="rm-field"><span>Net days · on-account terms</span><input type="number" name="netDays" min="0" step="1" value="<%= form.netDays||'' %>"></label><label class="rm-field"><span>Deposit percentage · deposit terms</span><input type="number" name="depositPercent" min="0.01" max="100" step="0.01" value="<%= form.depositPercent||'' %>"></label><label><input type="checkbox" name="holdShipping" value="1" <%= form.holdShipping==='1'?'checked':'' %>> Hold shipping while an agreed balance is unpaid</label><% if(locals.canSetTaxExemption){ %><label><input type="checkbox" name="taxExempt" value="1" <%= form.taxExempt==='1'?'checked':'' %>> Customer is tax exempt</label><label class="rm-field"><span>Exemption reference · optional</span><input name="taxExemptReference" value="<%= form.taxExemptReference||'' %>" maxlength="200"></label><% } %><p>New orders use these defaults. Existing invoices and their tax history remain unchanged.</p></div></details><% } %>

  <div class="rm-choices" style="margin-top:18px">
    <button class="rm-btn" type="submit">Create customer</button>
    <a class="rm-btn rm-btn--ghost" href="/customers">Cancel</a>
  </div>
</form>
