<%
  /*
   * One box, from the shelf to the customer's door.
   *
   * The page shows exactly one thing to do next, because a person holding a
   * scanner does not read a screen of options — they do the step in front of
   * them. Picking shows where to walk. Packing shows what to weigh. Shipping
   * asks for the carrier and the tracking number, and nothing else.
   *
   * The line that matters most is the one about stock: until this ships,
   * everything in it is still on the shelf as far as StockChief is concerned,
   * and saying so plainly is what stops somebody from believing a count is
   * wrong when it is simply not yet time.
   */
  var s = shipment;
  var isOpen = s.status === 'PICKING' || s.status === 'PACKED';
  var badge = { PICKING: 'info', PACKED: 'info', SHIPPED: 'ok', DELIVERED: 'ok', CANCELLED: 'muted' }[s.status];
  var words = s.status === 'SHIPPED' && s.handover === 'COLLECTED' ? 'Collected'
    : s.status === 'SHIPPED' && s.handover === 'DELIVERED_BY_US' ? 'Delivered by us'
    : { PICKING: 'Being picked', PACKED: 'Packed', SHIPPED: 'Shipped',
      DELIVERED: 'Delivered', CANCELLED: 'Cancelled' }[s.status];
  var plannedHandover = s.delivery_method === 'PICKUP' ? 'COLLECTED'
    : s.delivery_method === 'DELIVER' ? 'DELIVERED_BY_US' : 'CARRIER';
  var plannedHandoverLabel = plannedHandover === 'COLLECTED'
    ? 'Collected by the customer' : plannedHandover === 'DELIVERED_BY_US'
      ? 'Delivered by us' : 'Sent by carrier';
%>
<div class="breadcrumb">
  <a href="/fulfilment">Fulfilment</a>
  <%- helpers.icon('chevron', { size: 13 }) %>
  <a href="/sales/orders/<%= s.sales_order_id %>"><%= s.order_number %></a>
  <%- helpers.icon('chevron', { size: 13 }) %>
  <span><%= s.shipment_number %></span>
</div>

<section class="section" id="payment-status"><div class="panel">
  <div class="panel-head"><div><h2>Payment for this order</h2></div></div>
  <div class="card-body">
    <p class="lede"><%= paymentPosition.status %> · <%= helpers.money(paymentPosition.remainingMinor, paymentPosition.currency) %> remaining</p>
    <p class="hint"><%= paymentPosition.termsText %></p>
    <% if (paymentPosition.terms.source === 'nothing agreed') { %><p class="notice notice--warn">No payment terms have been configured. The current default allows unpaid orders to leave. Agree customer terms before relying on a payment hold.</p><% } %>
    <% if (paymentPosition.blocksShipping) { %><p class="notice notice--warn">This order cannot leave until its payment hold is resolved. <%= paymentPosition.heldReason.ship %></p>
    <% } else if (paymentPosition.remainingMinor > 0) { %><p class="hint">The recorded terms allow fulfilment with this balance still owed. Shipping does not mark it paid.</p><% } %>
    <a class="btn btn--primary" href="/orders/<%= s.sales_order_id %>?open=money#money">Payment options: request payment or record money received</a>
    <p class="field-hint">Online payment links require a connected payment provider. Recording a payment is only for money actually received.</p>
  </div>
</div></section>

<div class="page-head">
  <div>
    <h1><%= s.shipment_number %> <span class="badge badge--<%= badge %>"><%= words %></span></h1>
    <p class="page-sub">
      <%= s.units %> <%= s.units === 1 ? 'unit' : 'units' %> for <%= s.customer_name || 'a customer' %>
      on <%= s.order_number %><% if (s.ship_from_location_name) { %> · from <%= s.ship_from_location_name %><% } %>
    </p>
  </div>
</div>

<% if (s.delivery_method === 'PICKUP') { %>
  <section class="section">
    <div class="panel">
      <div class="panel-head"><div><h2>How the customer will receive it</h2></div></div>
      <div class="card-body">
        <p class="lede"><strong>Customer pickup.</strong></p>
        <p class="hint">No carrier, shipping label, or delivery address is needed for this order.</p>
      </div>
    </div>
  </section>
<% } else if (s.ship_to_address) { %>
  <section class="section">
    <div class="panel">
      <div class="panel-head"><div><h2><%= isOpen ? 'Where it is going' : 'Where it went' %></h2></div></div>
      <div class="card-body">
        <address class="ship-to"><%= s.customer_name %>
<%= s.ship_to_address %></address>
        <% if (isOpen) { %>
          <p class="hint">
            Copied from <%= s.order_number %> when this box was started. The order and this
            box keep their agreed destination even if the customer's default changes later.
          </p>
        <% } %>
      </div>
    </div>
  </section>
<% } else if (!isOpen) { %>
  <%#
    A shipped parcel with no address on file.

    Saying nothing here leaves the page unable to answer the first question
    anybody asks of a shipment — where did it go? — and looking like the
    address is simply missing from the screen rather than from the records.
  %>
  <section class="section">
    <div class="panel">
      <div class="panel-head"><div><h2>Where it went</h2></div></div>
      <div class="card-body">
        <p class="lede">StockChief has no address for <%= s.customer_name || 'this customer' %>.</p>
        <p class="hint">
          None was on file when this shipped, so StockChief does not claim one. Add one to the
          customer and it will be on the next parcel.
          <% if (s.customer_id) { %>
            <a href="/sales/customers/<%= s.customer_id %>">Add their address</a>.
          <% } %>
        </p>
      </div>
    </div>
  </section>
<% } else if (isOpen) { %>
  <div class="notice notice--warn">
    <div>
      <strong>No address on file for <%= s.customer_name || 'this customer' %>.</strong><br>
      StockChief has nowhere to say this is going. Correct the Sales Order destination before
      shipping or buying a label. Enter the destination below, or explicitly choose customer pickup.
    </div>
  </div>
  <form class="card section" method="post" action="/fulfilment/<%= s.id %>/destination" data-busy>
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <div class="card-body">
      <label class="field"><span class="field-label">How will the customer receive this order?</span>
        <select name="deliveryMethod" class="input" required><option value="">Choose delivery or pickup</option><option value="SHIP">Send to a delivery address</option><option value="PICKUP">Customer pickup</option></select>
      </label>
      <label class="field"><span class="field-label">Full delivery address (required when sending)</span><textarea name="shippingAddress" class="input" placeholder="Street, city, state, postal code and country"></textarea></label>
    </div>
    <div class="card-foot"><button class="btn btn--primary" type="submit">Save delivery choice — no stock moves</button></div>
  </form>
<% } %>

<% if (isOpen) { %>
  <p class="lede">
    Nothing in this box has left stock yet. StockChief still counts every one of these
    <%= s.units %> as on the shelf, and will until you confirm the customer collected it.
  </p>
<% } %>

<section class="section">
  <div class="panel">
    <div class="panel-head">
      <div>
        <h2><%= s.status === 'PICKING' ? 'What to collect'
          : s.status === 'PACKED' ? 'What is in the box' : 'What went' %></h2>
        <span class="t-xs t-muted">
          <% if (s.status === 'PICKING') { %>
            <%= pickList.stops.length %>
            <%= pickList.stops.length === 1 ? 'place to visit' : 'places to visit' %>
          <% } else { %>
            from <%= pickList.stops.length %>
            <%= pickList.stops.length === 1 ? 'place' : 'places' %>
          <% } %>
        </span>
      </div>
    </div>
    <div class="card-body">
      <% pickList.stops.forEach(function (stop) { %>
        <div class="pick-stop">
          <h3 class="pick-stop-name">
            <%- helpers.icon('locations', { size: 14 }) %> <%= stop.locationName %>
          </h3>
          <table class="table">
            <thead>
              <tr>
                <th>Item</th>
                <th class="num">Quantity</th>
                <% if (s.status === 'PICKING') { %><th class="num">Change</th><% } %>
              </tr>
            </thead>
            <tbody>
              <% stop.lines.forEach(function (line) { %>
                <tr>
                  <td>
                    <strong><%= line.item_name %></strong>
                    <% if (line.variant_label) { %>
                      <span class="t-muted">· <%= line.variant_label %></span>
                    <% } %>
                    <div class="t-xs t-muted"><%= line.sku_code %></div>
                  </td>
                  <td class="num"><strong><%= line.quantity %></strong>
                    <span class="t-muted"><%= helpers.unitLabel(line.quantity, line.unit_label || 'unit') %></span></td>
                  <% if (s.status === 'PICKING') { %>
                    <td class="num">
                      <form method="post" action="/fulfilment/<%= s.id %>/line" class="inline-form">
                        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                        <input type="hidden" name="lineId" value="<%= line.sales_order_line_id %>">
                        <input type="hidden" name="locationId" value="<%= line.location_id %>">
                        <input type="hidden" name="kitComponentId" value="<%= line.kit_component_id || '' %>">
                        <input class="input input--tiny" type="number" name="quantity" min="0"
                          value="<%= line.quantity %>" aria-label="Quantity of <%= line.item_name %> in this box">
                        <button class="btn btn--ghost btn--sm" type="submit">Set</button>
                      </form>
                    </td>
                  <% } %>
                </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
      <% }) %>
      <% if (!pickList.stops.length) { %>
        <p class="empty">This box is empty. Add something to it, or cancel it.</p>
      <% } %>
    </div>
  </div>
</section>

<% if (s.status === 'PICKING' && s.delivery_method === 'PICKUP') { %>
  <section class="section">
    <div class="panel">
      <div class="panel-head"><div><h2>When the customer has it</h2></div></div>
      <form method="post" action="/fulfilment/<%= s.id %>/ship" data-busy>
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <input type="hidden" name="handover" value="COLLECTED">
        <div class="card-body">
          <p class="lede">Confirm only after the customer physically collects these <%= s.units %> units.</p>
          <p class="hint">This removes them from stock, records the sale and product cost, and updates what the customer owes. There is no carrier step.</p>
        </div>
        <div class="card-foot">
          <button class="btn btn--primary" type="submit">Customer collected it — <%= s.units %> leaves stock</button>
        </div>
      </form>
    </div>
  </section>
<% } else if (s.status === 'PICKING') { %>
  <section class="section">
    <div class="panel">
      <div class="panel-head"><div><h2>Once it is in the box</h2></div></div>
      <form method="post" action="/fulfilment/<%= s.id %>/packed" data-busy>
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <div class="card-body">
          <div class="field-row">
            <label class="field">
              <span class="field-label">Packages</span>
              <input class="input" type="number" name="packageCount" min="1" value="1">
              <span class="field-hint">How many boxes this shipment is going in.</span>
            </label>
            <label class="field">
              <span class="field-label">Weight in grams <span class="t-muted">(optional)</span></span>
              <input class="input" type="number" name="weightGrams" min="1" placeholder="e.g. 3400">
              <span class="field-hint">Only useful if your carrier asks for it.</span>
            </label>
          </div>
        </div>
        <div class="card-foot">
          <button class="btn btn--primary" type="submit">Mark packed</button>
          <span class="hint">Still nothing leaves stock.</span>
        </div>
      </form>
    </div>
  </section>
<% } %>

<%
  /*
   * Ready to ship, through a carrier.
   *
   * Everything a person needs to decide with, on one screen: what is in the
   * box, where it is going, what each carrier would charge and when they say
   * it would arrive. The recommendation is a sentence, not a badge, because
   * "cheapest that still arrives by Monday" is the reasoning and the reasoning
   * is what makes it trustworthy.
   *
   * Nothing here has happened yet. Asking a carrier what something costs
   * commits nobody, so the only button that matters is the last one.
   */
  var ship = typeof shipping === 'undefined' ? null : shipping;
  var lbs = function (grams) { return (Number(grams || 0) / 453.59237).toFixed(1); };
  var canSetPackageWeights = ship && ship.blocked.every(function (problem) { return problem.key === 'weight'; });
%>
<% if (ship && s.status === 'PACKED' && (!s.tracking_number || s.label_status === 'VOIDED')) { %>
  <section class="section" id="carrier">
    <div class="panel">
      <div class="panel-head">
        <div>
          <h2>Ready to ship</h2>
          <span class="t-xs t-muted">
            <%= ship.boxes.length %> package<%= ship.boxes.length === 1 ? '' : 's' %>
            <% if (ship.boxes.some(function (b) { return b.weightGrams; })) { %>
              · <%= lbs(ship.boxes.reduce(function (sum, b) { return sum + Number(b.weightGrams || 0); }, 0)) %> lb total
            <% } %>
            <% if (ship.to && ship.to.line1) { %> · Ship to: <%= ship.to.line1 %><% } %>
            <% if (ship.promised) { %> · promised <%= ship.promised %><% } %>
          </span>
        </div>
      </div>

      <details class="disclosure">
        <summary>Customer delivery promise</summary>
        <form method="post" action="/fulfilment/<%= s.id %>/promise" data-busy>
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <div class="card-body grid grid--2">
            <label class="field">
              <span class="field-label">Service promised</span>
              <input class="input" name="service" value="<%= ship.promise && ship.promise.service || '' %>"
                placeholder="Standard, Ground, 2-Day…">
            </label>
            <label class="field">
              <span class="field-label">Customer paid for shipping</span>
              <input class="input" name="customerShipping" inputmode="decimal"
                value="<%= ship.promise && ship.promise.customerShippingMinor !== null ? (ship.promise.customerShippingMinor / 100).toFixed(2) : '' %>"
                placeholder="0.00">
            </label>
            <label class="field">
              <span class="field-label">Window starts</span>
              <input class="input" type="date" name="windowStart" value="<%= ship.promise && ship.promise.windowStart || '' %>">
            </label>
            <label class="field">
              <span class="field-label">Deliver no later than</span>
              <input class="input" type="date" name="windowEnd" value="<%= ship.promise && ship.promise.windowEnd || '' %>">
            </label>
          </div>
          <div class="card-foot">
            <button class="btn" type="submit">Save promise</button>
            <span class="hint">This records what the customer was told. Carrier estimates never rewrite it.</span>
          </div>
        </form>
      </details>

      <% if (ship.blocked.length) { %>
        <div class="card-body stack">
          <% ship.blocked.forEach(function (problem) { %>
            <article class="planning-item">
              <p><%= problem.what %></p>
              <% if (problem.href) { %><a class="btn btn--sm" href="<%= problem.href %>">Fix this</a><% } %>
            </article>
          <% }) %>
          <p class="t-xs t-muted">
            You can still hand this parcel over yourself and record it below. Nothing about carriers
            is required to ship an order.
          </p>
        </div>
      <% } %>

      <% if (canSetPackageWeights) { %>
        <div class="card-body">
          <form method="post" action="/fulfilment/<%= s.id %>/packages" class="inline-form" data-busy>
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <% ship.boxes.forEach(function (box, index) { %>
            <label class="field">
              <span class="field-label"><%= ship.boxes.length > 1 ? `Weight of package ${index + 1} (grams)` : 'Weight of this parcel (grams)' %></span>
              <input class="input" type="number" name="weightGrams" min="1"
                value="<%= box.weightGrams || '' %>">
              <span class="field-hint">
                <% if (box.estimated) { %>
                  Added up from the product weights StockChief has. Weigh the box and correct it if that is wrong —
                  a rate quoted on a guess gets corrected at the counter.
                <% } else { %>What you measured.<% } %>
              </span>
            </label>
            <% }) %>
            <button class="btn btn--sm" type="submit"><%= ship.boxes.length > 1 ? 'Save package weights' : 'Save weight' %></button>
          </form>
        </div>
      <% } %>

      <% if (!ship.blocked.length) { %>
        <div class="card-foot">
          <form method="post" action="/fulfilment/<%= s.id %>/rates" data-busy>
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <button class="btn <%= ship.rates.length ? '' : 'btn--primary' %>" type="submit">
              <%= ship.rates.length ? 'Get fresh rates' : 'Get carrier rates' %>
            </button>
          </form>
        </div>
      <% } %>

      <% if (ship.rates.length) { %>
        <div class="card-body">
          <% if (ship.ruled && ship.ruled.rate) { %>
            <div class="notice"><div>
              <strong>A rule of yours covers this.</strong><br><%= ship.ruled.because %>
            </div></div>
          <% } else if (ship.recommended) { %>
            <p class="lede">
              StockChief recommends <%= ship.recommended.rate.carrierName %> <%= ship.recommended.rate.service %>
              — <%= helpers.money(ship.recommended.rate.amountMinor, ship.recommended.rate.currency) %>.
            </p>
            <p class="hint"><%= ship.recommended.because %>
              <% if (ship.ruled) { %> <%= ship.ruled.because %><% } %></p>
          <% } %>

          <form method="post" action="/fulfilment/<%= s.id %>/label" data-busy>
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <%
              var preferredRate = ship.ruled && ship.ruled.rate ? ship.ruled.rate
                : ship.recommended && ship.recommended.rate ? ship.recommended.rate : ship.rates[0];
              var otherRates = ship.rates.filter(function (rate) {
                return !preferredRate || rate.id !== preferredRate.id;
              });
            %>
            <ul class="rate-list">
              <% if (preferredRate) { var rate = preferredRate; %>
                <li class="rate-row is-pick">
                  <label class="choice">
                    <input type="radio" name="rateId" value="<%= rate.id %>" checked required>
                    <span>
                      <strong><%= rate.carrierName %> <%= rate.service %></strong>
                      — <%= helpers.money(rate.amountMinor, rate.currency) %>
                      <% if (rate.deliveryDate) { %>
                        · expected <%= rate.deliveryDate %><% if (rate.guaranteed) { %> (guaranteed)<% } %>
                      <% } else if (rate.deliveryDays) { %>
                        · <%= rate.deliveryDays %> days
                      <% } else { %>
                        · no date given
                      <% } %>
                      <% if (ship.promised && rate.deliveryDate && rate.deliveryDate > ship.promised) { %>
                        <span class="badge badge--warn">after the promised date</span>
                      <% } %>
                    </span>
                  </label>
                </li>
              <% } %>
            </ul>
            <% if (otherRates.length) { %>
              <details class="disclosure">
                <summary>Compare <%= otherRates.length %> other rate<%= otherRates.length === 1 ? '' : 's' %></summary>
                <ul class="rate-list">
                  <% otherRates.forEach(function (rate) { %>
                    <li class="rate-row">
                      <label class="choice">
                        <input type="radio" name="rateId" value="<%= rate.id %>" <%= preferredRate ? '' : 'required' %>>
                        <span>
                          <strong><%= rate.carrierName %> <%= rate.service %></strong>
                          — <%= helpers.money(rate.amountMinor, rate.currency) %>
                          <% if (rate.deliveryDate) { %>
                            · expected <%= rate.deliveryDate %><% if (rate.guaranteed) { %> (guaranteed)<% } %>
                          <% } else if (rate.deliveryDays) { %>
                            · <%= rate.deliveryDays %> days
                          <% } else { %>
                            · no date given
                          <% } %>
                        </span>
                      </label>
                    </li>
                  <% }) %>
                </ul>
              </details>
            <% } %>
            <p class="t-xs t-muted">
              Quoted <%= ship.rates[0].quotedAt.slice(0, 16).replace('T', ' ') %>. Rates go stale;
              get fresh ones if this has been sitting.
            </p>
            <div class="button-row" style="margin-top:12px;">
              <button class="btn btn--primary" type="submit">Buy label</button>
            </div>
            <p class="t-xs t-muted" style="margin-top:8px;">
              This buys postage only. The parcel remains packed and every unit stays in inventory
              until you confirm it was physically handed over.
            </p>
          </form>
        </div>
      <% } %>
    </div>
  </section>
<% } %>

<% if (ship && s.tracking_number && s.label_url) { %>
  <section class="section" id="label">
    <div class="panel">
      <div class="panel-head"><div><h2><%= s.label_status === 'VOIDED' ? 'Label voided' : s.label_status === 'VOID_PENDING' ? 'Label void pending' : s.status === 'PACKED' ? 'Label ready — not handed over yet' : 'Shipment' %></h2></div></div>
      <div class="card-body">
        <div class="accounting-equation">
          <p><span>Carrier</span><strong><%= helpers.carrierName ? helpers.carrierName(s.carrier) : s.carrier %> <%= s.service || '' %></strong></p>
          <p><span>Tracking</span><strong>
            <% if (s.tracking_url) { %><a href="<%= s.tracking_url %>" rel="noreferrer noopener" target="_blank"><%= s.tracking_number %></a>
            <% } else { %><%= s.tracking_number %><% } %>
          </strong></p>
          <% if (s.expected_delivery_date) { %><p><span>Expected</span><strong><%= s.expected_delivery_date %></strong></p><% } %>
          <% if (s.shipping_cost_minor) { %><p><span>Postage</span><strong><%= helpers.money(s.shipping_cost_minor, s.currency || 'USD') %></strong></p><% } %>
          <% if (s.postage_refund_minor) { %><p><span>Refunded</span><strong><%= helpers.money(s.postage_refund_minor, s.currency || 'USD') %></strong></p><% } %>
          <% if (s.postage_adjustment_minor) { %><p><span>Carrier adjustments</span><strong><%= helpers.money(s.postage_adjustment_minor, s.currency || 'USD') %></strong></p><% } %>
          <% if (s.tracking_status) { %><p><span>Where it is</span><strong><%= s.tracking_status.toLowerCase().replace(/_/g, ' ') %></strong></p><% } %>
        </div>
        <div class="button-row" style="margin-top:12px;">
          <% if (s.label_status !== 'VOIDED' && s.label_status !== 'VOID_PENDING') { %>
            <a class="btn btn--primary" href="<%= s.label_url %>" rel="noreferrer noopener" target="_blank">Print label</a>
          <% } %>
          <% if (s.status === 'PACKED' && s.label_status !== 'VOIDED' && s.label_status !== 'VOID_PENDING' && ship.providerCapabilities.voidLabel) { %>
            <form method="post" action="/fulfilment/<%= s.id %>/label/void" data-busy>
              <input type="hidden" name="_csrf" value="<%= csrfToken %>">
              <button class="btn btn--ghost" type="submit">Void unused label</button>
            </form>
          <% } %>
        </div>
      </div>
      <% if (ship.events.length) { %>
        <div class="card-body">
          <h3 class="t-sm">What the carrier has reported</h3>
          <ul class="money-feed">
            <% ship.events.forEach(function (entry) { %>
              <li class="money-feed-item">
                <span class="money-feed-when"><%= String(entry.occurred_at).slice(0, 16).replace('T', ' ') %></span>
                <span class="money-feed-what">
                  <strong><%= entry.status.toLowerCase().replace(/_/g, ' ') %></strong>
                  <small><%= [entry.detail, entry.location].filter(Boolean).join(' · ') %></small>
                </span>
              </li>
            <% }) %>
          </ul>
        </div>
      <% } %>
      <% if (ship.transactions && ship.transactions.length) { %>
        <div class="card-body">
          <h3 class="t-sm">Postage audit trail</h3>
          <ul class="money-feed">
            <% ship.transactions.slice().reverse().forEach(function (entry) { %>
              <li class="money-feed-item">
                <span class="money-feed-when"><%= String(entry.requested_at).slice(0, 16).replace('T', ' ') %></span>
                <span class="money-feed-what"><strong><%= entry.operation.toLowerCase() %> · <%= entry.status.toLowerCase() %></strong>
                  <small><%= entry.detail || entry.error_message || '' %></small></span>
                <% if (entry.amount_minor !== null) { %><strong><%= helpers.money(entry.amount_minor, entry.currency) %></strong><% } %>
              </li>
            <% }) %>
          </ul>
        </div>
      <% } %>
    </div>
  </section>
<% } %>

<% if (s.status === 'PACKED') { %>
  <section class="section">
    <div class="panel">
      <div class="panel-head">
        <div>
          <h2>Confirm the handoff</h2>
          <span class="t-xs t-muted">This is the only step that removes stock</span>
        </div>
      </div>
      <% if (s.label_url && s.tracking_number && s.label_status !== 'VOIDED' && s.label_status !== 'VOID_PENDING') { %>
      <form method="post" action="/fulfilment/<%= s.id %>/ship" data-busy>
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <input type="hidden" name="handover" value="CARRIER">
        <div class="card-body">
          <p class="lede">The label is ready, but StockChief still counts these goods in inventory.</p>
          <p class="hint">Confirm only when the parcel is physically with the carrier. That moment moves stock, records the sale, and prepares the customer update.</p>
        </div>
        <div class="card-foot">
          <button class="btn btn--primary" type="submit">Handed to carrier — <%= s.units %> leaves stock</button>
        </div>
      </form>
      <% } else { %>
      <form method="post" action="/fulfilment/<%= s.id %>/ship" data-busy>
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <div class="card-body">
          <div class="notice notice--info">
            <div><strong>This order is set to: <%= plannedHandoverLabel %></strong><br>Confirm it only after the goods physically leave. If the real handoff changed, choose the correct method below first.</div>
          </div>
          <details class="advanced-settings">
            <summary>Use a different handoff method</summary>
            <fieldset class="ship-method">
              <legend class="visually-hidden">How did these goods leave?</legend>
              <% [['CARRIER','Sent by carrier'],['COLLECTED','Collected by the customer'],['DELIVERED_BY_US','Delivered by us']].forEach(function (choice) { %>
                <label class="choice">
                  <input type="radio" name="handover" value="<%= choice[0] %>" required <%= plannedHandover === choice[0] ? 'checked' : '' %> data-handover-choice>
                  <span><%= choice[1] %></span>
                </label>
              <% }) %>
            </fieldset>
          </details>
          <div data-carrier-handoff-fields <%= plannedHandover === 'CARRIER' ? '' : 'hidden' %>>
          <div class="field-row">
            <label class="field">
              <span class="field-label">Carrier <span class="t-muted">(optional)</span></span>
              <select class="input" name="carrier">
                <option value="">Work it out from the tracking number</option>
                <% carriers.forEach(function (carrier) { %>
                  <option value="<%= carrier.code %>"><%= carrier.name %></option>
                <% }) %>
              </select>
              <span class="field-hint">Leave this alone and StockChief reads it off the number where it can.</span>
            </label>
            <label class="field">
              <span class="field-label">Tracking number <span class="t-muted">(optional)</span></span>
              <input class="input" type="text" name="trackingNumber" placeholder="1Z999AA10123456784" autocomplete="off">
              <span class="field-hint">Paste or scan it. It becomes a link the customer can follow.</span>
            </label>
          </div>
          <div class="field-row">
            <label class="field">
              <span class="field-label">Service <span class="t-muted">(optional)</span></span>
              <input class="input" type="text" name="service" placeholder="Ground">
            </label>
            <label class="field">
              <span class="field-label">Expected delivery <span class="t-muted">(optional)</span></span>
              <input class="input" type="date" name="expectedDeliveryDate">
            </label>
            <label class="field">
              <span class="field-label">Carrier postage paid <span class="t-muted">(optional)</span></span>
              <input class="input" type="number" step="0.01" min="0" name="shippingCost" placeholder="12.50">
              <span class="field-hint">What this business paid the carrier. Any delivery charge paid by the customer is recorded separately.</span>
            </label>
          </div>
          </div>
        </div>
        <div class="card-foot">
          <button class="btn btn--primary" type="submit" data-handover-confirm data-units="<%= s.units %>">
            <%= plannedHandover === 'COLLECTED' ? 'Customer collected it'
              : plannedHandover === 'DELIVERED_BY_US' ? 'Delivered by us' : 'Confirm carrier handoff' %>
            — <%= s.units %> leaves stock
          </button>
          <span class="hint" data-handover-explanation>
            Stock leaves only after this confirmation. StockChief records the sale, product cost, and handoff against <%= s.order_number %> together.
          </span>
        </div>
      </form>
      <% } %>
    </div>
  </section>
<% } %>

<script>
(function () {
  var choices = document.querySelectorAll('[data-handover-choice]');
  var carrierFields = document.querySelector('[data-carrier-handoff-fields]');
  var confirm = document.querySelector('[data-handover-confirm]');
  if (!choices.length || !carrierFields || !confirm) return;
  function refresh() {
    var selected = document.querySelector('[data-handover-choice]:checked');
    var method = selected ? selected.value : 'CARRIER';
    var units = confirm.getAttribute('data-units');
    carrierFields.hidden = method !== 'CARRIER';
    confirm.textContent = (method === 'COLLECTED' ? 'Customer collected it'
      : method === 'DELIVERED_BY_US' ? 'Delivered by us' : 'Confirm carrier handoff')
      + ' — ' + units + ' leaves stock';
  }
  choices.forEach(function (choice) { choice.addEventListener('change', refresh); });
  refresh();
}());
</script>

<% if (notices && notices.length) { %>
  <%
    /*
     * What the customer was told, or is about to be.
     *
     * The words are shown in full and editable, because a shipping notice
     * leaves the building under the owner's name. StockChief writes the draft
     * from records; the person who has to answer the reply gets the last read
     * of it.
     */
    var notice = notices[0];
    var gone = notice.status === 'SENT';
  %>
  <section class="section">
    <div class="panel">
      <div class="panel-head">
        <div>
          <h2><%= gone ? 'What the customer was told' : 'Tell the customer' %></h2>
          <span class="t-xs t-muted">
            <% if (gone) { %>
              Sent <%= helpers.shortDate(notice.sentAt) %> to <%= notice.recipient %>
            <% } else if (notice.status === 'CANCELLED') { %>
              Not sent
            <% } else if (notice.recipient) { %>
              Ready to send to <%= notice.recipient %>
            <% } else { %>
              No email address on file for this customer
            <% } %>
          </span>
        </div>
        <span class="spacer"></span>
        <span class="badge badge--<%= gone ? 'ok' : notice.status === 'FAILED' ? 'warn' : 'info' %>">
          <%= { PREPARED: 'Written, not sent', QUEUED: 'Waiting', SENDING: 'Sending',
                SENT: 'Sent', FAILED: 'Did not send', CANCELLED: 'Cancelled' }[notice.status] %>
        </span>
      </div>

      <% if (notice.errorMessage && notice.status === 'FAILED') { %>
        <div class="card-body">
          <div class="notice notice--warn"><div>
            <strong>This did not send.</strong><br><%= notice.errorMessage %>
          </div></div>
        </div>
      <% } %>

      <% if (gone || notice.status === 'CANCELLED') { %>
        <div class="card-body">
          <p class="t-sm"><strong><%= notice.subject %></strong></p>
          <pre class="message-body"><%= notice.body %></pre>
        </div>
      <% } else { %>
        <form method="post" action="/fulfilment/<%= s.id %>/notice" data-busy>
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <input type="hidden" name="messageId" value="<%= notice.id %>">
          <div class="card-body">
            <label class="field">
              <span class="field-label">Subject</span>
              <input class="input" type="text" name="subject" value="<%= notice.subject %>">
            </label>
            <label class="field">
              <span class="field-label">Message</span>
              <textarea class="input textarea message-edit" name="body" rows="14"><%= notice.body %></textarea>
              <span class="field-hint">
                Written from this order handover's own record — the items and how the customer
                received them. StockChief states nothing here it cannot show you elsewhere.
              </span>
            </label>
            <% if (mailboxes && mailboxes.length) { %>
              <label class="field">
                <span class="field-label">Send from</span>
                <select class="input" name="connectorId">
                  <option value="">Choose a mailbox</option>
                  <% mailboxes.forEach(function (box) { %>
                    <option value="<%= box.id %>" <%= notice.connectorId === box.id ? 'selected' : '' %>>
                      <%= box.display_name %>
                    </option>
                  <% }) %>
                </select>
              </label>
            <% } else { %>
              <p class="hint">
                No mailbox is connected, so StockChief cannot send this for you. Copy the words
                above into your own email, or
                <a href="/settings/connections">connect a mailbox</a>.
              </p>
            <% } %>
          </div>
          <div class="card-foot">
            <% if (notice.recipient && mailboxes && mailboxes.length) { %>
              <button class="btn btn--primary" type="submit" name="action" value="send">
                Send to <%= notice.recipient %>
              </button>
            <% } %>
            <button class="btn" type="submit" name="action" value="save">Save for later</button>
            <button class="btn btn--ghost" type="submit" name="action" value="rewrite">Start again</button>
            <button class="btn btn--ghost" type="submit" name="action" value="cancel">Do not send</button>
          </div>
        </form>
      <% } %>
    </div>
  </section>
<% } %>

<% if (s.status === 'SHIPPED' || s.status === 'DELIVERED') { %>
  <section class="section">
    <div class="panel">
      <div class="panel-head"><div><h2><%= s.handover === 'COLLECTED' ? 'Collected by the customer' : s.status === 'DELIVERED' ? 'Delivered' : s.handover === 'DELIVERED_BY_US' ? 'Out for delivery with us' : 'On its way' %></h2></div></div>
      <div class="card-body">
        <dl class="detail-list">
          <div><dt><%= s.handover === 'COLLECTED' ? 'Collected' : 'Left' %></dt><dd><%= helpers.shortDate(s.shipped_at) %></dd></div>
          <% if (s.carrierName) { %><div><dt>Carrier</dt><dd><%= s.carrierName %><% if (s.service) { %> · <%= s.service %><% } %></dd></div><% } %>
          <% if (s.tracking_number) { %>
            <div>
              <dt>Tracking</dt>
              <dd>
                <% if (s.trackingUrl) { %>
                  <a href="<%= s.trackingUrl %>" target="_blank" rel="noopener noreferrer"><%= s.tracking_number %></a>
                <% } else { %>
                  <%= s.tracking_number %>
                  <span class="t-xs t-muted">— no tracking link for this carrier</span>
                <% } %>
              </dd>
            </div>
          <% } %>
          <% if (s.package_count && s.handover !== 'COLLECTED') { %><div><dt>Packages</dt><dd><%= s.package_count %></dd></div><% } %>
          <% if (s.expected_delivery_date) { %><div><dt>Expected</dt><dd><%= helpers.shortDate(s.expected_delivery_date) %></dd></div><% } %>
          <% if (s.shipping_cost_minor) { %>
            <div><dt>Shipping cost</dt><dd><%= helpers.money(s.shipping_cost_minor, s.currency || 'USD') %></dd></div>
          <% } %>
          <% if (s.delivered_at) { %><div><dt>Delivered</dt><dd><%= helpers.shortDate(s.delivered_at) %></dd></div><% } %>
        </dl>
      </div>
      <% if (s.status === 'SHIPPED' && s.handover !== 'COLLECTED') { %>
        <div class="card-foot">
          <form method="post" action="/fulfilment/<%= s.id %>/delivered" data-busy>
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <button class="btn" type="submit">Mark delivered</button>
            <span class="hint">
              StockChief has no carrier account, so it cannot see a delivery scan.
              This is you telling it what you know.
            </span>
          </form>
        </div>
      <% } %>
    </div>
  </section>
<% } %>

<% if (isOpen) { %>
  <section class="section">
    <details class="disclosure">
      <summary>Cancel this box</summary>
      <div class="card-body">
        <form method="post" action="/fulfilment/<%= s.id %>/cancel" data-busy>
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <label class="field">
            <span class="field-label">Why <span class="t-muted">(optional)</span></span>
            <input class="input" type="text" name="reason" placeholder="Customer pushed the date">
          </label>
          <button class="btn btn--ghost" type="submit">Cancel <%= s.shipment_number %></button>
          <p class="hint">
            Nothing physical moved, so nothing physical comes back. What this box was
            holding simply becomes free to pick again.
          </p>
        </form>
      </div>
    </details>
  </section>
<% } %>
