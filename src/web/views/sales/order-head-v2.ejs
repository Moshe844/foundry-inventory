<%
  /*
   * Order page header, PostgreSQL order page only.
   *
   * The page's own breadcrumb and .page-head stay exactly as rendered (other
   * code reads their text) and are restyled. This adds the back link and the
   * actions, which the script moves onto the header row: Edit while nothing
   * has shipped, Cancel order with a confirmation, and the one next step,
   * which follows how the customer gets the goods.
   */
  var oxOpen = ['CONFIRMED', 'PARTIALLY_FULFILLED', 'BACKORDERED'].includes(order.status);
  var oxShipped = Number(order.totals && order.totals.fulfilled || 0) > 0;
  var oxPicking = (locals.shipments || []).some(function (s) { return s.status !== 'CANCELLED'; });
  var oxHeld = Number(order.totals && order.totals.allocated || 0) > 0;
  var oxPickup = order.delivery_method === 'PICKUP';
  var oxNext = order.status === 'DRAFT' ? { label: 'Confirm order', href: '#approve-order' }
    : oxOpen && oxPickup ? (oxHeld ? { label: 'Mark picked up', href: '#record-left' } : null)
    : oxOpen ? { label: 'Ship order', href: '/orders/' + order.id + '?open=fulfilment#fulfilment' }
    : null;
  var oxCanEdit = locals.canEdit !== false && (order.status === 'DRAFT'
    || (['CONFIRMED', 'BACKORDERED'].includes(order.status) && !oxShipped && !oxPicking));
  var oxCanCancel = locals.canEdit !== false && !['FULFILLED', 'CANCELLED'].includes(order.status);
%>
<link rel="stylesheet" href="/orders-ui.css?v=<%= assetVersion %>">
<div class="ox ox-ohead-wrap">
  <a class="ox-back" href="/orders"><span aria-hidden="true">←</span> Orders</a>
  <div class="ox ox-oactions ox-head__actions" data-ox-order-actions>
    <button class="ox-btn ox-btn--ghost" type="button" onclick="window.print()">Print</button>
    <% if (oxCanCancel) { %><button class="ox-btn ox-btn--ghost" type="button" data-modal-open="ox-cancel"><%= oxShipped ? 'Cancel the rest' : 'Cancel order' %></button><% } %>
    <% if (oxCanEdit) { %><a class="ox-btn ox-btn--secondary" href="/orders/<%= order.id %>/edit">Edit</a><% } %>
    <% if (oxNext) { %><a class="ox-btn ox-btn--primary" href="<%= oxNext.href %>"><%= oxNext.label %></a><% } %>
  </div>
  <% if (oxCanCancel) { %>
  <dialog class="ox-modal" id="ox-cancel" aria-labelledby="ox-h-cancel">
    <form method="post" action="/sales/orders/<%= order.id %>/cancel">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <div class="ox-modal__h"><h2 id="ox-h-cancel"><%= oxShipped ? 'Cancel what has not shipped?' : 'Cancel ' + order.order_number + '?' %></h2><button class="ox-modal__x" type="button" data-modal-close aria-label="Close">×</button></div>
      <div class="ox-modal__b">
        <p><%= oxShipped ? 'The items still waiting are cancelled and their held stock is released. What already shipped stays on the order and its invoice.' : (oxHeld ? 'The stock held for this order goes back to available.' : 'Nothing is held for this order yet.') %><% if (Number(locals.money && money.paidMinor || 0) > 0) { %> The <%= helpers.money(money.paidMinor, money.currency || order.currency) %> already paid stays recorded on the order.<% } %></p>
        <label class="ox-field"><span>Reason <small>optional</small></span><input name="reason" maxlength="200" placeholder="For example: customer changed their mind"></label>
      </div>
      <div class="ox-modal__f"><button class="ox-btn ox-btn--ghost" type="button" data-modal-close>Keep order</button><button class="ox-btn ox-btn--danger" type="submit"><%= oxShipped ? 'Cancel the rest' : 'Cancel order' %></button></div>
    </form>
  </dialog>
  <% } %>
</div>
<script src="/orders-ui.js?v=<%= assetVersion %>" defer></script>
