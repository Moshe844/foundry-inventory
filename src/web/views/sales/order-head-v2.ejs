<%
  /*
   * Order page header, PostgreSQL order page only.
   *
   * The page's own breadcrumb and .page-head stay exactly as rendered — other
   * code reads their text (the status wording, the badge) — and are restyled
   * here. This adds the back link, the action buttons and the money strip,
   * which the script moves onto and under the header row.
   *
   * Payment is its own act, separate from creating and from fulfilling. Before
   * any invoice exists the full payments panel further down does not render,
   * so collecting is offered here: a payment recorded now is a customer
   * deposit, applied to the invoice when the goods leave.
   */
  var oxMoney = locals.money || {};
  var oxCurrency = oxMoney.currency || order.currency || 'USD';
  var oxTotal = Number(oxMoney.totalMinor || 0), oxPaid = Number(oxMoney.paidMinor || 0), oxOwed = Number(oxMoney.outstandingMinor || 0);
  var oxCancelled = order.status === 'CANCELLED';
  var oxState = oxTotal > 0 && oxOwed === 0 && oxPaid > 0 ? ['Paid', 'green'] : oxPaid > 0 ? ['Partly paid', 'amber'] : ['Unpaid', oxMoney.invoiced ? 'rose' : 'grey'];
  var oxProviders = locals.paymentProviders || [];
  var oxOnline = oxProviders.some(function (name) { return name !== 'stripe'; }) || Boolean(locals.paymentAccount && locals.paymentAccount.connected);
  var oxCollect = !oxCancelled && oxOwed > 0;
  // The next step follows how the customer gets the goods: a pickup order is
  // handed over at the counter ("Record what physically left"), never shipped.
  var oxOpen = ['CONFIRMED', 'PARTIALLY_FULFILLED', 'BACKORDERED'].includes(order.status);
  var oxHeld = Number(order.totals && order.totals.allocated || 0) > 0;
  var oxNext = order.status === 'DRAFT' ? { label: 'Confirm order', href: '#approve-order' }
    : oxOpen && order.delivery_method === 'PICKUP' ? (oxHeld ? { label: 'Mark picked up', href: '#record-left' } : null)
    : oxOpen ? { label: 'Ship order', href: '/orders/' + order.id + '?open=fulfilment#fulfilment' }
    : null;
  // Drafts are edited in the order form; a confirmed order can take more
  // products or cancel what has not gone, which is what the server allows.
  var oxEdit = order.status === 'DRAFT' ? { label: 'Edit order', href: '/orders/' + order.id + '/edit' }
    : oxOpen ? { label: 'Change order', href: '#change-order' } : null;
  var oxAsk = Number(oxMoney.dueNowMinor || 0) > 0 && Number(oxMoney.dueNowMinor) < oxOwed ? Number(oxMoney.dueNowMinor) : oxOwed;
%>
<link rel="stylesheet" href="/orders-ui.css?v=<%= assetVersion %>">
<div class="ox ox-ohead-wrap">
  <a class="ox-back" href="/orders"><span aria-hidden="true">←</span> Orders</a>
  <div class="ox ox-oactions ox-head__actions" data-ox-order-actions>
    <button class="ox-btn ox-btn--ghost" type="button" onclick="window.print()">Print</button>
    <% if (oxEdit) { %><a class="ox-btn ox-btn--ghost" href="<%= oxEdit.href %>" data-ox-edit><%= oxEdit.label %></a><% } %>
    <% if (oxCollect) { %><a class="ox-btn <%= oxNext ? 'ox-btn--secondary' : 'ox-btn--primary' %>" href="<%= oxMoney.invoiced ? '/orders/' + order.id + '?open=money#money' : '#ox-collect' %>" data-ox-collect-open>Collect payment</a><% } %>
    <% if (oxNext) { %><a class="ox-btn ox-btn--primary" href="<%= oxNext.href %>"><%= oxNext.label %></a><% } %>
  </div>
  <%# Once invoiced, the page's own Payment card shows these figures; one is enough. %>
  <% if (oxTotal > 0 && !oxMoney.invoiced) { %>
  <section class="ox ox-money" data-ox-order-money aria-label="Payment">
    <div class="ox-money__cells">
      <div><span>Order total</span><b class="ox-num"><%= helpers.money(oxTotal, oxCurrency) %></b></div>
      <div><span>Paid</span><b class="ox-num"><%= helpers.money(oxPaid, oxCurrency) %></b></div>
      <div><span>Balance due</span><b class="ox-num ox-money__due"><%= helpers.money(oxOwed, oxCurrency) %></b></div>
      <div><span>Payment</span><span class="ox-badge ox-badge--<%= oxState[1] %>"><%= oxState[0] %></span></div>
    </div>
    <% var oxReceipts = locals.customerReceipts || []; %>
    <% if (oxReceipts.length) { %>
    <ul class="ox-receipts" aria-label="Payments received">
      <% oxReceipts.forEach(function (receipt) { %>
        <li><b class="ox-num"><%= helpers.money(receipt.amount_minor, oxCurrency) %></b>
          <span><%= receipt.method ? receipt.method.replace(/_/g, ' ') : 'payment' %><%= receipt.reference ? ' · ' + receipt.reference : '' %> · <%= helpers.shortDate(receipt.payment_date) %></span>
          <a href="/orders/<%= order.id %>/receipt/<%= receipt.id %>">Receipt <%= receipt.payment_number %></a></li>
      <% }) %>
    </ul>
    <% } %>
    <% if (oxCollect && !oxMoney.invoiced) { %>
    <details class="ox-collect" id="ox-collect">
      <summary class="ox-sr">Collect payment</summary>
      <div class="ox-collect__body<%= oxOnline ? '' : ' ox-collect__body--one' %>">
        <form method="post" action="/sales/orders/<%= order.id %>/payment" class="ox-collect__record" data-busy>
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <h3>Record a payment</h3>
          <div class="ox-collect__row">
            <label class="ox-field"><span>Amount</span><input type="number" name="amount" step="0.01" min="0.01" max="<%= (oxOwed / 100).toFixed(2) %>" value="<%= (oxAsk / 100).toFixed(2) %>" required data-ox-collect-amount></label>
            <label class="ox-field"><span>When</span><input type="date" name="paymentDate" value="<%= helpers.dateInputValue(new Date()) %>"></label>
          </div>
          <div class="ox-field"><span>How did they pay?</span><select name="method"><option value="cash">Cash</option><option value="card">Card machine</option><option value="bank transfer">Bank transfer</option><option value="cheque">Cheque</option><option value="other">Something else</option></select></div>
          <label class="ox-field"><span>Reference</span><input name="reference" maxlength="160"></label>
          <p class="ox-help">A full or part payment. Nothing has to have shipped; it is applied to the invoice when the goods leave.</p>
          <button class="ox-btn ox-btn--primary" type="submit">Record payment</button>
          <% if (!oxOnline) { %><p class="ox-help ox-collect__connect"><% if (locals.canManagePaymentAccount) { %>To take cards or send payment links, <a href="/settings/connections?only=payments&amp;return=/orders/<%= order.id %>">connect a payment gateway</a>.<% } else { %>Cards and payment links need a payment gateway; a workspace owner can connect one.<% } %></p><% } %>
        </form>
        <% if (oxOnline) { %>
        <div class="ox-collect__online">
          <h3>Card or payment link</h3>
          <p class="ox-help">The connected gateway hosts the payment page; StockChief never sees the card.</p>
          <a class="ox-btn ox-btn--secondary" href="#secure-payment" data-ox-link-open>Send a payment link</a>
        </div>
        <% } %>
      </div>
    </details>
    <% } %>
  </section>
  <% } %>
</div>
<script src="/orders-ui.js?v=<%= assetVersion %>" defer></script>
