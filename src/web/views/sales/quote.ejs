<% const q=quotation; %><div class="rm-head"><a href="/quotes">← Quotes</a><h1><%= q.quote_number %></h1><p><%= q.customer_name %> · <%= q.status %> · Valid through <%= q.valid_until %></p></div>
<section class="rm-panel"><div class="rm-panel__body"><% if(q.supersedes_id){ %><p>Revises <a href="/quotes/<%= q.supersedes_id %>">the previous quotation</a>. Its original terms remain in history.</p><% } %><p>Prepared <%= helpers.dateTime(q.created_at) %>. No stock, invoice or payment was recorded by this quote.</p><div class="table-wrap"><table><thead><tr><th>Product</th><th>Quantity</th><th>Unit price</th><th>Discount</th><th>Tax</th><th>Total</th></tr></thead><tbody><% q.pricing.lines.forEach(line=>{ %><tr><td><%= q.line_labels[line.skuId]||line.description||line.skuId %></td><td><%= line.quantity %></td><td><%= helpers.money(line.unitPriceMinor,q.pricing.currency) %></td><td><%= helpers.money(line.discountMinor||0,q.pricing.currency) %></td><td><%= helpers.money(line.taxMinor||0,q.pricing.currency) %></td><td><%= helpers.money(line.totalMinor,q.pricing.currency) %></td></tr><% }); %></tbody></table></div><dl class="kv"><dt>Subtotal</dt><dd><%= helpers.money(q.pricing.subtotalMinor,q.pricing.currency) %></dd><dt>Discount</dt><dd><%= helpers.money(q.pricing.discountMinor,q.pricing.currency) %></dd><dt>Tax</dt><dd><%= helpers.money(q.pricing.taxMinor,q.pricing.currency) %></dd><dt>Total</dt><dd><%= helpers.money(q.pricing.totalMinor,q.pricing.currency) %></dd></dl>
<% if(q.sales_order_id){ %><a class="rm-btn" href="/orders/<%= q.sales_order_id %>">Open accepted order</a><% }else if(q.status==='OPEN'){ %><% if(q.valid_until<today){ %><p class="notice notice--warn">This quotation expired. Prepare a revision before accepting it.</p><% }else{ %><form method="post" action="/quotes/<%= q.id %>/decision"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="expectedHash" value="<%= q.pricing_hash %>"><button class="rm-btn" name="decision" value="accept">Accept and create draft order</button><button class="rm-btn rm-btn--ghost" name="decision" value="decline">Mark declined</button></form><% } %><a class="rm-btn rm-btn--ghost" href="/quotes/new?revise=<%= q.id %>">Prepare a revision</a><p>Acceptance checks current pricing and creates a draft only. If prices or promotion availability changed, review a revised quote first.</p><% } %></div></section>
