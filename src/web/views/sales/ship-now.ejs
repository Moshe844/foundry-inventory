<%#
  Ship this order, for the parcel that is open right now: choose a rate, buy
  the label, print it, confirm the handover. Every step returns here, so a
  person never has to read the full shipment record to send one box.
%>
<%
  var s = sn.shipment, owner = locals.currentUser && currentUser.role === 'owner';
  var labelReady = s.label_status === 'PURCHASED' && s.label_url;
  var working = ['PENDING', 'VOID_PENDING'].indexOf(s.label_status) >= 0;
  var review = s.label_status === 'REVIEW';
  var step = labelReady ? 3 : 2;
  var exactGrams = s.weight_grams && !Number.isInteger(Number(s.weight_grams));
  var displayWeight = s.weight_grams ? (exactGrams ? s.weight_grams + ' g' : (Number(s.weight_grams) / 453.59237).toFixed(1) + ' lb') : null;
  var cheapest = sn.rates[0];
  var accounts = sn.accounts.join(', ');
  var addressHeld = Boolean(sn.addressCheck && sn.addressCheck.held);
  var ar = sn.agentRun, chosenRate = ar && ar.rate_id && sn.rates.some(function (r) { return r.id === ar.rate_id; }) ? ar.rate_id : null;
%>
<div class="card-body ship-now" id="ship-now">
  <ol class="ship-steps" aria-label="Shipping steps">
    <li class="is-done"><span>1</span>Parcel<% if (displayWeight) { %> · <%= displayWeight %><% } %></li>
    <li class="<%= step > 2 ? 'is-done' : 'is-now' %>"><span>2</span>Choose a rate</li>
    <li class="<%= step === 3 ? 'is-now' : '' %>"><span>3</span>Print and hand over</li>
  </ol>
  <p class="ship-now__to"><span>Ship to</span><strong><%= s.ship_to_address || order.ship_to_address %></strong></p>
  <% if (!labelReady && !working && !review) { %><%- include('../shipping/address-check', { ac: sn.addressCheck, shipmentId: s.id, returnTo: 'order' }) %><% } %>

  <% if (working) { %>
    <div class="ship-now__wait" data-ship-wait>
      <strong><%= s.label_status === 'VOID_PENDING' ? 'Voiding the label…' : 'Buying the label…' %></strong>
      <span>This takes a few seconds. The page updates on its own.</span>
    </div>
    <script>setTimeout(function () { location.reload(); }, 3000);</script>

  <% } else if (review) { %>
    <p class="ship-now__warn">The carrier’s answer about this label needs a look before anything else happens.
      <a href="/fulfilment/<%= s.id %>#label">Review the label</a></p>

  <% } else if (labelReady) { %>
    <div class="ship-label">
      <div class="ship-label__facts">
        <p><span>Carrier</span><strong><%= sn.carrierName || s.carrier %> <%= s.service || '' %></strong></p>
        <p><span>Tracking</span><strong><% if (sn.trackingUrl) { %><a href="<%= sn.trackingUrl %>" target="_blank" rel="noopener noreferrer"><%= s.tracking_number %></a><% } else { %><%= s.tracking_number || '—' %><% } %></strong></p>
        <% if (s.shipping_cost_minor !== null && s.shipping_cost_minor !== undefined) { %><p><span>Postage</span><strong><%= helpers.money(s.shipping_cost_minor, s.currency || 'USD') %></strong></p><% } %>
      </div>
      <div class="ship-label__do">
        <a class="btn btn--primary" href="<%= s.label_url %>" target="_blank" rel="noopener noreferrer">Print label</a>
        <form method="post" action="/fulfilment/<%= s.id %>/ship" data-busy>
          <input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="handover" value="CARRIER"><input type="hidden" name="returnTo" value="order">
          <button class="btn" type="submit">Handed to carrier</button>
        </form>
      </div>
      <p class="hint">Stock leaves only when you press <em>Handed to carrier</em>, once the parcel is with the carrier.</p>
      <% if (owner) { %>
        <form method="post" action="/fulfilment/<%= s.id %>/label/void" class="ship-now__minor" data-busy data-confirm="Void this unused label? The carrier refunds unused postage to your account.">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="returnTo" value="order">
          <input type="hidden" name="idempotencyKey" value="void:<%= s.id %>:<%= s.tracking_number %>">
          <button class="ship-now__link" type="submit">Void this label</button>
        </form>
      <% } %>
    </div>

  <% } else if (sn.rates.length) { %>
    <% if (ar && ar.status === 'HELD' && ar.hold !== 'address') { %>
      <p class="ship-now__warn" data-agent-rate><%= ar.reason %></p>
    <% } else if (ar && ar.carrierName && !addressHeld) { %>
      <div class="ship-now__wait" data-agent-rate>
        <strong><%= ar.mode === 'watch' ? 'StockChief would choose' : ar.status === 'CHOSEN' ? 'StockChief chose' : 'StockChief suggests' %> <%= ar.carrierName %> <%= ar.service %> · <%= ar.price %></strong>
        <span>Arrives <%= ar.arrival_date %>, promised by <%= ar.promised_date %>. It is the cheapest rate that arrives in time.<% if (ar.mode === 'watch') { %> StockChief is only watching for now.<% } %></span>
        <% if (ar.status === 'CHOSEN' && ar.label_reason) { %><span><%= ar.label_reason %></span><% } %>
        <% if (ar.tap && owner) { %>
          <div class="ship-now__buy">
            <form method="post" action="/fulfilment/<%= s.id %>/agent-label" class="ship-now__minor" data-busy>
              <input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="returnTo" value="order"><input type="hidden" name="runId" value="<%= ar.id %>">
              <button class="btn btn--primary" type="submit">Buy this label</button>
            </form>
            <form method="post" action="/fulfilment/<%= s.id %>/agent-label/dismiss" class="ship-now__minor" data-busy>
              <input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="returnTo" value="order"><input type="hidden" name="runId" value="<%= ar.id %>">
              <button class="ship-now__link" type="submit">Choose another rate</button>
            </form>
          </div>
        <% } %>
      </div>
    <% } %>
    <form method="post" action="/fulfilment/<%= s.id %>/label" data-busy>
      <input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="returnTo" value="order">
      <fieldset class="ship-rates">
        <legend>Rates from <%= accounts %></legend>
        <% sn.rates.forEach(function (rate, i) { %>
          <label class="ship-rate">
            <input type="radio" name="rateId" value="<%= rate.id %>" <%= (chosenRate ? rate.id === chosenRate : i === 0) ? 'checked' : '' %> required>
            <span class="ship-rate__name"><strong><%= rate.carrierName %></strong> <%= rate.service %>
              <% if (i === 0) { %><span class="ship-rate__tag">Cheapest</span><% } %><% if (rate.id === chosenRate && i !== 0) { %><span class="ship-rate__tag">Arrives in time</span><% } %></span>
            <span class="ship-rate__days"><%= rate.delivery_date ? 'By ' + rate.delivery_date : rate.deliveryDays ? rate.deliveryDays + (rate.deliveryDays === 1 ? ' day' : ' days') : '' %></span>
            <strong class="ship-rate__price"><%= helpers.money(rate.amountMinor, rate.currency) %></strong>
          </label>
        <% }) %>
      </fieldset>
      <% if (owner && !addressHeld) { %>
        <div class="ship-now__buy"><button class="btn btn--primary" type="submit">Buy label</button>
          <span class="hint">Charged to your <%= accounts %> account. Nothing leaves stock yet.</span></div>
      <% } else if (!owner) { %>
        <p class="hint">Only an owner can buy a label.</p>
      <% } %>
    </form>

  <% } else { %>
    <div class="ship-now__warn">
      <strong>No rates yet.</strong>
      <% if (sn.needs.any) { %> Fill in the details below and press Get rates.
      <% } else if (sn.blocked.length) { %>
        <ul><% sn.blocked.forEach(function (problem) { %><li><%= problem %></li><% }) %></ul>
      <% } else { %> The carrier returned nothing for this parcel. Check the weight and try again.<% } %>
    </div>
  <% } %>

  <% if (!labelReady && !working && !review) { %>
    <details class="ship-now__size" <%= sn.rates.length && !addressHeld ? '' : 'open' %>>
      <summary><%= sn.rates.length ? 'Change weight or box' : 'Weight and box' %></summary>
      <form method="post" action="/fulfilment/<%= s.id %>/reweigh" class="ship-now__form" data-busy>
        <input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="returnTo" value="order">
        <%- include('ship-needs', { needs: sn.rates.length ? (addressHeld ? { any: true, shipTo: { address: s.ship_to_address || '' } } : null) : sn.needs }) %>
        <label class="ship-now__field"><span>Weight <i class="ship-now__req" aria-hidden="true">*</i></span><span class="ship-now__pair"><input name="weight" inputmode="decimal" required value="<%= s.weight_grams ? (exactGrams ? s.weight_grams : (Number(s.weight_grams) / 453.59237).toFixed(2)) : '' %>" aria-label="New parcel weight">
          <select name="weightUnit" aria-label="New weight unit"><option value="lb">lb</option><option value="oz">oz</option><option value="kg">kg</option><option value="g" <%= exactGrams?'selected':'' %>>g</option></select></span></label>
        <label class="ship-now__field"><span>Box (L × W × H, optional)</span><span class="ship-now__pair"><input name="length" inputmode="decimal" placeholder="L" aria-label="New box length"><input name="width" inputmode="decimal" placeholder="W" aria-label="New box width"><input name="height" inputmode="decimal" placeholder="H" aria-label="New box height">
          <select name="sizeUnit" aria-label="New size unit"><option value="in">in</option><option value="cm">cm</option></select></span></label>
        <button class="btn <%= sn.rates.length ? '' : 'btn--primary' %>" type="submit"><%= sn.rates.length ? 'Get new rates' : 'Get rates' %></button>
      </form>
    </details>
  <% } %>
  <p class="ship-now__more"><a href="/fulfilment/<%= s.id %>">Shipment details</a></p>
</div>
