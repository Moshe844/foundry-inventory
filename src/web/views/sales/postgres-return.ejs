<p class="rm-stamp"><a href="/orders/<%= customerReturn.sales_order_id %>"><%= customerReturn.order_number %></a> · <%= customerReturn.customer_name %></p>
<h1 class="rm-verdict"><%= customerReturn.return_number %> is <%= customerReturn.status==='AWAITING_REFUND'&&refundFinancials.credited&&!refundFinancials.cashDueMinor?'awaiting closure':customerReturn.status.replaceAll('_',' ').toLowerCase() %>.</h1>
<% if(customerReturn.receipt_credit_policy==='RECEIPT_CREDIT_V1'){ %><p class="notice">Received goods receive a credit note for their original price, discount and tax. Unpaid invoices are reduced immediately; money already paid remains owed to the customer until a separate refund is approved.</p><% } %><p class="rm-prose"><% if(['REQUESTED','AUTHORIZED','PARTIALLY_RECEIVED'].includes(customerReturn.status)){ %>Nothing has been refunded. Only goods actually received can enter quarantine at <%= customerReturn.quarantine_name %>.<% } else if(customerReturn.status==='RECEIVED'){ %>Received goods are in quarantine at <%= customerReturn.quarantine_name %> awaiting inspection; <%= customerReturn.receipt_credit_policy==='RECEIPT_CREDIT_V1'?'the received goods have been credited. Any cash repayment still needs approval.':'the customer credit awaits separate approval. Product cost recovery is deferred for refund returns.' %><% } else if(customerReturn.status==='AWAITING_REFUND'){ %>Inspection and physical disposition are complete. <%= customerReturn.receipt_credit_policy==='RECEIPT_CREDIT_V1'?'The credit note is already posted. Any cash repayment needs separate approval.':'The customer credit or refund is still awaiting separate approval.' %><% } else { %>Physical disposition is complete. Review the recorded customer credit or refund and the linked order for its financial effect.<% } %></p>

<div class="rm-ledger"><% customerReturn.lines.forEach(function(line){ %><div class="rm-ledger__row"><span class="rm-ledger__k"><%= line.item_name %><%= line.variant_label?' / '+line.variant_label:'' %><small><%= line.code %> · <%= line.tracking_mode %> tracked</small></span><span class="rm-ledger__v"><%= line.quantity_received %> / <%= line.quantity_authorized %> received</span><span class="rm-ledger__n"><%= line.quantity_restocked %> restocked · <%= line.quantity_repair %> repair · <%= line.quantity_scrapped %> scrapped</span></div><% }) %></div>

<% if(needsReceiptMeasures){ %><p class="notice">Record the actual returned batches, serials and measured weight to calculate the exact credit from their original shipment.</p><% }else{ %>
<section class="section" aria-label="Return financial breakdown"><h2><%= refundFinancials.credited?'Posted credit note':refundFinancials.posted?'Posted refund':'Refund calculation' %></h2><dl class="kv"><dt>Original price share</dt><dd><%= helpers.money(refundFinancials.priceMinor,customerReturn.currency) %></dd><dt>Discount share</dt><dd>−<%= helpers.money(refundFinancials.discountMinor,customerReturn.currency) %></dd><% if(refundFinancials.chargesMinor){ %><dt>Other line adjustments</dt><dd><%= helpers.money(refundFinancials.chargesMinor,customerReturn.currency) %></dd><% } %><dt>Tax</dt><dd><%= helpers.money(refundFinancials.taxMinor,customerReturn.currency) %></dd><% if(refundFinancials.priceAdjustmentMinor){ %><dt>Recorded adjustment</dt><dd><%= helpers.money(refundFinancials.priceAdjustmentMinor,customerReturn.currency) %></dd><% } %><dt><%= refundFinancials.posted?'Amount posted':'Amount awaiting approval' %></dt><dd><strong data-refund-total><%= helpers.money(refundableMinor,customerReturn.currency) %></strong></dd></dl></section><% } %>
<section class="section"><h2>Return shipping</h2>
 <% if(returnParcel){ %><p><a class="rm-btn" href="/fulfilment/<%= returnParcel.id %>">Manage return postage and tracking</a></p>
 <% } else if(['AUTHORIZED','PARTIALLY_RECEIVED'].includes(customerReturn.status)){ %><p class="rm-sub">Prepare a carrier label using this business’s own postage accounts. Carrier delivery never replaces physical receipt and inspection.</p>
 <form method="post" action="/returns/<%= customerReturn.id %>/postage" class="stack-form"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><label>Return delivery location<select name="locationId" required><% locations.forEach(function(location){ %><option value="<%= location.id %>"><%= location.name %></option><% }); %></select></label><button class="rm-btn" type="submit">Prepare return postage</button></form>
 <% } else if(customerReturn.status==='REQUESTED'){ %><p class="rm-sub">Authorize the goods expected back before preparing a return label.</p><% } %>
 <% if(typeof returnLabel!=='undefined'&&returnLabel&&!returnLabel.locked&&customerReturn.status==='AUTHORIZED'){ const label=returnLabel; %>
 <div id="return-label" class="stack-form">
  <h3>Return label from StockChief</h3>
  <% if(label.email){ %><p>Label and instructions emailed to <%= label.email.recipient %>.</p>
  <% } else if(label.canSend){ %><p><%= label.run.reason||'The label is bought. The email to the customer is next.' %></p>
   <form method="post" action="/returns/<%= customerReturn.id %>/return-label/send" class="stack-form"><input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <% if(label.mailboxes.length>1){ %><label>Send from<select name="connectorId" required><% label.mailboxes.forEach(function(box){ %><option value="<%= box.id %>"><%= box.display_name %></option><% }); %></select></label><% } %>
    <label><input type="checkbox" name="confirmed" value="yes" required> Email the customer this label and the return steps.</label><button class="rm-btn" type="submit">Send the email</button></form>
  <% } else if(label.labelBought){ %><p>Label bought: <%= label.choice %>. The email to the customer follows.</p>
  <% } else if(label.run&&label.run.status==='QUEUED'){ %><p>Buying the label: <%= label.choice %>.</p>
  <% } else if(label.canApprove){ %><p><%= label.choice %>.<% if(label.run.label_reason){ %> <%= label.run.label_reason %><% } %></p>
   <form method="post" action="/returns/<%= customerReturn.id %>/return-label/approve" class="stack-form"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="runId" value="<%= label.run.id %>">
    <label><input type="checkbox" name="confirmed" value="yes" required> Buy this label and email it to the customer.</label><button class="rm-btn" type="submit">Approve the label</button></form>
   <form method="post" action="/returns/<%= customerReturn.id %>/return-label/dismiss"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="runId" value="<%= label.run.id %>"><button class="rm-btn" type="submit">No label needed</button></form>
  <% } else if(label.run&&label.run.status==='HELD'){ %><p class="notice"><%= label.run.reason %></p>
  <% } else if(label.waiting){ %><p class="notice"><%= label.waiting %></p>
  <% } else { %><p class="rm-sub"><%= label.alone?'StockChief buys the label and emails the customer on its own.':'StockChief prepares the label for you to approve.' %></p><% } %>
  <% if(label.canTeach){ %><form method="post" action="/returns/<%= customerReturn.id %>/return-label/rule" class="stack-form"><input type="hidden" name="_csrf" value="<%= csrfToken %>">
   <input type="hidden" name="locationId" value="<%= label.teachLocationId %>"><input type="hidden" name="connectorId" value="<%= label.teachConnectorId %>"><input type="hidden" name="currency" value="<%= label.currency %>">
   <label>Send return labels on their own for goods worth up to (<%= label.currency %>)<input type="text" inputmode="decimal" name="maximum" required></label>
   <label><input type="checkbox" name="confirmed" value="yes" required> Send labels like this one on their own: same return location and mailbox, within this limit and my $ per label.</label><button class="rm-btn" type="submit">Save rule</button></form><% } %>
  <% if(label.route){ %><form method="post" action="/returns/<%= customerReturn.id %>/return-label/rule"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="remove" value="yes"><button class="rm-btn" type="submit">Remove the return label rule</button></form><% } %>
 </div><% } %>
</section>
<% if(typeof returnCheck!=='undefined'&&returnCheck&&!returnCheck.locked&&(customerReturn.status==='RECEIVED'||returnCheck.current)){ const check=returnCheck; %>
<section class="section" id="return-check"><div class="section-head"><h2>Check the returned goods</h2></div>
 <% if(check.form){ %>
  <p class="rm-sub">Record the condition of each product. Good goods go back where they were sold from<%= check.alone&&check.limit?', on their own up to '+check.limit+' a return':', once the owner confirms' %>. Anything else waits for a decision.</p>
  <form method="post" action="/returns/<%= customerReturn.id %>/check" class="stack-form"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="sourceHash" value="<%= check.form.sourceHash %>">
   <% check.form.lines.forEach(function(l,i){ %><fieldset><legend><%= l.name %> · <%= l.code %> · <%= helpers.unitCount(l.quantity_received,'unit') %></legend><input type="hidden" name="lines[<%= i %>][lineId]" value="<%= l.id %>">
    <label>Condition of <%= l.code %><select name="lines[<%= i %>][conditionCode]" aria-label="Condition of <%= l.code %>" required><% check.conditions.forEach(function(c){ %><option value="<%= c[0] %>"><%= c[1] %></option><% }) %></select></label>
    <label>What you checked on <%= l.code %><input name="lines[<%= i %>][note]" aria-label="What you checked on <%= l.code %>" maxlength="500" required></label></fieldset><% }) %>
   <label><input type="checkbox" name="confirmed" value="yes" required> I checked every unit listed here.</label><button class="rm-btn" type="submit">Save the check</button></form>
 <% } else if(check.problem){ %><p class="notice"><%= check.problem %></p>
 <% } else if(check.current){ const a=check.current; %>
  <% (a.proposal?a.proposal.lines:a.observations).forEach(function(d){ var place=check.places.find(function(p){return p.id===d.destinationId}); %><p><strong><%= d.sku %> · <%= d.quantity %> · <%= d.conditionCode %></strong><br><%= d.outcome?({RESTOCK:'Back into stock',REPAIR:'To repair',SCRAP:'Scrap'}[d.outcome])+(place?' at '+place.name:''):(a.status==='STOPPED'?'Decided on the return':'Waiting for a decision') %><%= d.appliedAt?(d.appliedAutomatically?' · done on its own':' · done'):'' %></p><% }) %>
  <% if(a.problem){ %><p class="notice"><%= a.problem %></p><% } %>
  <% if(check.owner&&a.status==='READY'&&a.proposal.lines.some(function(d){return !d.appliedAt&&d.job===114})&&!a.proposal.lines.some(function(d){return !d.appliedAt&&d.outcome&&d.job!==114})){ %>
   <form method="post" action="/returns/<%= customerReturn.id %>/check/apply" class="stack-form"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="assessmentId" value="<%= a.id %>"><input type="hidden" name="revision" value="<%= a.revision %>"><input type="hidden" name="proposalHash" value="<%= a.proposalHash %>">
    <label><input type="checkbox" name="confirmed" value="yes" required> Put the goods marked good back into stock.</label><button class="rm-btn" type="submit">Put back into stock</button></form>
  <% } else if(check.owner&&['OBSERVED','READY'].includes(a.status)&&check.plan!=='growth'){ %><p><a class="rm-btn" href="/autopilot/return-disposition?id=<%= a.id %>">Review the decisions</a></p><% } %>
 <% } %>
 <% if(check.owner&&check.alone){ %><form method="post" action="/returns/<%= customerReturn.id %>/check/limit" class="stack-form"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="currency" value="<%= check.currency %>">
  <label>Put good returns back on their own up to (<%= check.currency %>)<input name="maximum" inputmode="decimal" value="<%= check.limitAmount %>" required></label>
  <label><input type="checkbox" name="confirmed" value="yes" required> Let StockChief put good returns back into stock on their own within this limit.</label><button class="rm-btn" type="submit">Save limit</button></form><% } %>
</section><% } %>
<section class="section"><div class="section-head"><h2>Next controlled step</h2></div>
  <% if(customerReturn.status==='REQUESTED'){ %>
    <p class="rm-sub">No stock or money moved. Authorization only confirms what may come back.</p>
    <form method="post" action="/returns/<%= customerReturn.id %>/authorize"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="idempotencyKey" value="<%= formKey %>-authorize"><button class="rm-btn" type="submit">Authorize this return</button></form>
  <% } else if(['AUTHORIZED','PARTIALLY_RECEIVED'].includes(customerReturn.status)){ %>
    <p class="rm-sub">Inventory still has not changed. Record only goods physically in hand; authorization by itself never increases stock.</p>
    <p class="rm-sub">Received goods enter quarantine and restore their proven original cost; no customer refund happens yet.</p>
    <form method="post" action="/returns/<%= customerReturn.id %>/receive" class="stack-form"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="idempotencyKey" value="<%= formKey %>-receive">
      <% customerReturn.lines.forEach(function(line){ const outstanding=Number(line.quantity_authorized)-Number(line.quantity_received); if(!outstanding)return; %><fieldset><legend><%= line.item_name %> — <%= outstanding %> still expected</legend><label>Quantity received<input aria-label="<%= line.item_name %> received quantity" type="number" name="quantity_<%= line.id %>" step="<%= line.quantity_increment||1 %>" min="0" max="<%= outstanding %>" value="<%= outstanding %>"></label><% if(line.secondary_unit_label){ %><label>Actual returned <%= line.secondary_unit_label %><input type="number" step="any" min="0" name="secondary_<%= line.id %>" <%= line.tracking_mode==='serial'?'':'required' %>></label><% } %><% if(line.tracking_mode==='lot'){ %><label>Returned lot / batch<input name="lot_<%= line.id %>" required></label><% } %><% if(line.tracking_mode==='serial'){ %><label>Returned serial numbers<input name="serials_<%= line.id %>" placeholder="Comma-separated, one per unit" required></label><% } %></fieldset><% }) %>
      <button class="rm-btn" type="submit"><%= customerReturn.receipt_credit_policy==='RECEIPT_CREDIT_V1'?'Receive goods and post credit note':'Record physical receipt into quarantine' %></button>
    </form>
  <% } else if(customerReturn.status==='RECEIVED'){ %>
    <p class="rm-sub">Every received unit must be assigned once. Transfers preserve its exact cost; scrapping removes both the stock and inventory value.</p>
    <form method="post" action="/returns/<%= customerReturn.id %>/inspect" class="stack-form"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="idempotencyKey" value="<%= formKey %>-inspect">
      <% customerReturn.lines.forEach(function(line){ if(Number(line.quantity_restocked)+Number(line.quantity_scrapped)+Number(line.quantity_repair)>0)return; %><fieldset><legend><%= line.item_name %> — disposition <%= helpers.unitCount(line.quantity_received,'unit') %></legend><div class="inline-form"><label>Restock<input aria-label="<%= line.item_name %> restock quantity" type="number" name="restock_<%= line.id %>" step="<%= line.quantity_increment||1 %>" min="0" max="<%= line.quantity_received %>" value="<%= line.quantity_received %>"></label><label>Restock location<select name="restockLocation_<%= line.id %>"><option value="">Choose location</option><% locations.forEach(function(location){ %><option value="<%= location.id %>"><%= location.name %></option><% }) %></select></label><label>Repair<input type="number" name="repair_<%= line.id %>" step="<%= line.quantity_increment||1 %>" min="0" max="<%= line.quantity_received %>" value="0"></label><label>Repair location<select name="repairLocation_<%= line.id %>"><option value="">Choose if needed</option><% locations.forEach(function(location){ %><option value="<%= location.id %>"><%= location.name %></option><% }) %></select></label><label>Scrap<input type="number" name="scrap_<%= line.id %>" step="<%= line.quantity_increment||1 %>" min="0" max="<%= line.quantity_received %>" value="0"></label></div><% if(line.secondary_unit_label){ %><p>When splitting measured goods, enter the actual weight for each disposition. Whole batches and individual serials keep their recorded weights.</p><% ['restock','repair','scrap'].forEach(kind=>{ %><label><%= kind %> <%= line.secondary_unit_label %><input type="number" step="any" min="0" name="<%= kind %>Secondary_<%= line.id %>"></label><% }) %><% } %><label>Condition note<input name="condition_<%= line.id %>" placeholder="What inspection found"></label></fieldset><% }) %>
      <button class="rm-btn" type="submit">Record inspection and disposition</button>
    </form>
  <% } else if(customerReturn.status==='AWAITING_REFUND'){ %>
    <p class="rm-sub">The goods have already been received and dispositioned. This step reverses only the proven selling amount; inventory will not move again.</p>
    <div class="quiet-note">Verified refund: <strong><%= helpers.money(refundFinancials.credited?(refundFinancials.cashDueMinor||0):refundableMinor,customerReturn.currency) %></strong></div>
    <% if(refundAccess&&!managedRefund&&!refundRequest){ %><form method="post" action="/returns/<%= customerReturn.id %>/prepare-refund" class="stack-form"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="idempotencyKey" value="<%= formKey %>-prepare-refund"><% if(refundFinancials.cashDueMinor||!refundFinancials.credited){ %><details><summary>Choose exact amounts for original receipts</summary><label>Receipt numbers and amounts<textarea name="refundPayments" placeholder="RCPT-00001=12.50&#10;RCPT-00002=7.50"></textarea></label><p>Enter one receipt number and amount per line. Leave blank to use the earliest eligible original receipts.</p></details><% } %><button class="rm-btn" type="submit">Prepare exact refund and credit</button></form><% } %>
    <% if(managedRefund){ %><p>See the approved original-payment breakdown below.</p><% } else if(refundRequest){ %><div class="quiet-note"><strong><%= refundRequest.status==='PENDING'?'Provider confirmation pending':refundRequest.status==='REVIEW'?'Provider outcome needs review':refundRequest.status==='SUCCEEDED'?'Provider refund confirmed':'Provider refund failed' %></strong><br><%= refundRequest.last_error||'StockChief will change cash and accounting only after the original payment provider confirms the refund.' %></div><% } else { %>
    <% if(refundAccess){ %><details><summary>Record a manual refund</summary><% } %>
    <form method="post" action="/returns/<%= customerReturn.id %>/refund" class="inline-form"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="idempotencyKey" value="<%= formKey %>-refund"><label>Refund destination<select name="destination"><% if(!refundFinancials.credited||refundFinancials.cashDueMinor){ %><option value="CASH">Repay through original paid funds</option><% } %><% if(!refundFinancials.credited||!refundFinancials.cashDueMinor){ %><option value="AR"><%= refundFinancials.credited?'Credit already applied — close return':'Reduce unpaid receivable' %></option><% } %></select></label><label>Refund date<input type="date" name="refundDate" value="<%= today %>"></label><button class="rm-btn" type="submit"><%= refundFinancials.credited&&!refundFinancials.cashDueMinor?'Close credited return':'Approve exact refund' %></button></form><p class="rm-sub">Online refunds are queued to the original provider. If no online payment exists, choosing original paid funds records your confirmed external cash refund.</p><% if(refundAccess){ %></details><% } %><% } %>
  <% } else if(customerReturn.status==='INSPECTED'){ %><p class="rm-sub">Inspection is complete. Prepare the replacement as a separate zero-price order so allocation, shipping, and fulfillment stay traceable.</p><form method="post" action="/returns/<%= customerReturn.id %>/exchange" class="stack-form"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="idempotencyKey" value="<%= formKey %>-exchange"><% customerReturn.lines.forEach(function(line){ %><label><%= line.item_name %> replacement quantity<input type="number" name="quantity_<%= line.id %>" step="<%= line.quantity_increment||1 %>" min="0" value="<%= line.quantity_authorized %>"></label><% }) %><label>Fulfillment location<select name="fulfillmentLocationId"><option value="">Allocate from any available location</option><% locations.forEach(function(location){ %><option value="<%= location.id %>"><%= location.name %></option><% }) %></select></label><label>Order date<input type="date" name="orderDate" value="<%= today %>"></label><label>Replacement note<input name="notes" placeholder="What the customer should receive"></label><button class="rm-btn" type="submit">Prepare replacement order</button></form>
  <% } else { %><div class="quiet-note">This return is complete. Its physical movements and financial evidence are retained below and on the customer order.</div><% } %>
</section>

<% if(managedRefund){ %><section class="section"><div class="section-head"><h2>Approved refund by original payment</h2></div>
  <p><%= managedRefund.invoiceNumber %> · <%= helpers.money(managedRefund.amountMinor,managedRefund.currency) %></p>
  <ul class="stack-form"><% managedRefund.parts.forEach(part=>{ %><li><strong><%= part.paymentNumber %> · <%= part.methodLabel %> · <%= helpers.money(part.amountMinor,managedRefund.currency) %></strong>
    <p><%= part.status==='SETTLED'?'Recorded in '+part.cashAccountName:part.status==='REVIEW'?'Provider confirmation needs review':part.status==='FAILED'?'Provider refused the request':'Provider refund pending' %></p>
    <% if(part.error){ %><p><%= part.error %></p><% } %>
    <% if(part.canVerify&&isRefundOwner){ %><form method="post" action="/returns/<%= customerReturn.id %>/refunds/<%= part.id %>/verify">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="idempotencyKey" value="<%= formKey %>-<%= part.id %>-verify">
      <button class="rm-btn" type="submit">Check existing Stripe refund</button></form><% } %>
  </li><% }) %></ul>
</section><% } %>
<section class="section"><div class="section-head"><h2>What changed</h2></div><div class="rm-ledger"><div class="rm-ledger__row"><span class="rm-ledger__k">Physical receipt<small>Only after goods arrived</small></span><span class="rm-ledger__v"><%= helpers.unitCount(customerReturn.lines.reduce((sum,line)=>sum+Number(line.quantity_received),0),'unit') %></span><span class="rm-ledger__n"><%= customerReturn.quarantine_name %></span></div><div class="rm-ledger__row"><span class="rm-ledger__k">Customer credit or refund<small>Separate approval from physical receipt</small></span><span class="rm-ledger__v"><%= refundFinancials.credited?'credit note posted':customerReturn.refund_id?'recorded':'not recorded' %></span><span class="rm-ledger__n"><%= helpers.money(refundableMinor,customerReturn.currency) %></span></div></div></section>
