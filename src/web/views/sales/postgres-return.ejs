<p class="rm-stamp"><a href="/orders/<%= customerReturn.sales_order_id %>"><%= customerReturn.order_number %></a> · <%= customerReturn.customer_name %></p>
<h1 class="rm-verdict"><%= customerReturn.return_number %> is <%= customerReturn.status==='AWAITING_REFUND'&&refundFinancials.credited&&!refundFinancials.cashDueMinor?'awaiting closure':customerReturn.status.replaceAll('_',' ').toLowerCase() %>.</h1>
<% if(customerReturn.receipt_credit_policy==='RECEIPT_CREDIT_V1'){ %><p class="notice">Received goods receive a credit note for their original price, discount and tax. Unpaid invoices are reduced immediately; money already paid remains owed to the customer until a separate refund is approved.</p><% } %><p class="rm-prose"><% if(['REQUESTED','AUTHORIZED','PARTIALLY_RECEIVED'].includes(customerReturn.status)){ %>Nothing has been refunded. Only goods actually received can enter quarantine at <%= customerReturn.quarantine_name %>.<% } else if(customerReturn.status==='RECEIVED'){ %>Received goods are in quarantine at <%= customerReturn.quarantine_name %> awaiting inspection; <%= customerReturn.receipt_credit_policy==='RECEIPT_CREDIT_V1'?'the received goods have been credited. Any cash repayment still needs approval.':'the customer credit awaits separate approval. Product cost recovery is deferred for refund returns.' %><% } else if(customerReturn.status==='AWAITING_REFUND'){ %>Inspection and physical disposition are complete. <%= customerReturn.receipt_credit_policy==='RECEIPT_CREDIT_V1'?'The credit note is already posted. Any cash repayment needs separate approval.':'The customer credit or refund is still awaiting separate approval.' %><% } else { %>Physical disposition is complete. Review the recorded customer credit or refund and the linked order for its financial effect.<% } %></p>

<div class="rm-ledger"><% customerReturn.lines.forEach(function(line){ %><div class="rm-ledger__row"><span class="rm-ledger__k"><%= line.item_name %><%= line.variant_label?' / '+line.variant_label:'' %><small><%= line.code %> · <%= line.tracking_mode %> tracked</small></span><span class="rm-ledger__v"><%= line.quantity_received %> / <%= line.quantity_authorized %> received</span><span class="rm-ledger__n"><%= line.quantity_restocked %> restocked · <%= line.quantity_repair %> repair · <%= line.quantity_scrapped %> scrapped</span></div><% }) %></div>

<section class="section" aria-label="Return financial breakdown"><h2><%= refundFinancials.credited?'Posted credit note':refundFinancials.posted?'Posted refund':'Refund calculation' %></h2><dl class="kv"><dt>Original price share</dt><dd><%= helpers.money(refundFinancials.priceMinor,customerReturn.currency) %></dd><dt>Discount share</dt><dd>−<%= helpers.money(refundFinancials.discountMinor,customerReturn.currency) %></dd><% if(refundFinancials.chargesMinor){ %><dt>Other line adjustments</dt><dd><%= helpers.money(refundFinancials.chargesMinor,customerReturn.currency) %></dd><% } %><dt>Tax</dt><dd><%= helpers.money(refundFinancials.taxMinor,customerReturn.currency) %></dd><% if(refundFinancials.priceAdjustmentMinor){ %><dt>Recorded adjustment</dt><dd><%= helpers.money(refundFinancials.priceAdjustmentMinor,customerReturn.currency) %></dd><% } %><dt><%= refundFinancials.posted?'Amount posted':'Amount awaiting approval' %></dt><dd><strong data-refund-total><%= helpers.money(refundableMinor,customerReturn.currency) %></strong></dd></dl></section>
<section class="section"><h2>Return shipping</h2>
 <% if(returnParcel){ %><p><a class="rm-btn" href="/fulfilment/<%= returnParcel.id %>">Manage return postage and tracking</a></p>
 <% } else if(['AUTHORIZED','PARTIALLY_RECEIVED'].includes(customerReturn.status)){ %><p class="rm-sub">Prepare a carrier label using this business’s own postage accounts. Carrier delivery never replaces physical receipt and inspection.</p>
 <form method="post" action="/returns/<%= customerReturn.id %>/postage" class="stack-form"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><label>Return delivery location<select name="locationId" required><% locations.forEach(function(location){ %><option value="<%= location.id %>"><%= location.name %></option><% }); %></select></label><button class="rm-btn" type="submit">Prepare return postage</button></form>
 <% } else if(customerReturn.status==='REQUESTED'){ %><p class="rm-sub">Authorize the goods expected back before preparing a return label.</p><% } %>
</section>
<section class="section"><div class="section-head"><h2>Next controlled step</h2></div>
  <% if(customerReturn.status==='REQUESTED'){ %>
    <p class="rm-sub">No stock or money moved. Authorization only confirms what may come back.</p>
    <form method="post" action="/returns/<%= customerReturn.id %>/authorize"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="idempotencyKey" value="<%= formKey %>-authorize"><button class="rm-btn" type="submit">Authorize this return</button></form>
  <% } else if(['AUTHORIZED','PARTIALLY_RECEIVED'].includes(customerReturn.status)){ %>
    <p class="rm-sub">Inventory still has not changed. Record only goods physically in hand; authorization by itself never increases stock.</p>
    <p class="rm-sub">Received goods enter quarantine and restore their proven original cost; no customer refund happens yet.</p>
    <form method="post" action="/returns/<%= customerReturn.id %>/receive" class="stack-form"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="idempotencyKey" value="<%= formKey %>-receive">
      <% customerReturn.lines.forEach(function(line){ const outstanding=Number(line.quantity_authorized)-Number(line.quantity_received); if(!outstanding)return; %><fieldset><legend><%= line.item_name %> — <%= outstanding %> still expected</legend><label>Quantity received<input aria-label="<%= line.item_name %> received quantity" type="number" name="quantity_<%= line.id %>" min="0" max="<%= outstanding %>" value="<%= outstanding %>"></label><% if(line.tracking_mode==='lot'){ %><label>Returned lot / batch<input name="lot_<%= line.id %>" required></label><% } %><% if(line.tracking_mode==='serial'){ %><label>Returned serial numbers<input name="serials_<%= line.id %>" placeholder="Comma-separated, one per unit" required></label><% } %></fieldset><% }) %>
      <button class="rm-btn" type="submit"><%= customerReturn.receipt_credit_policy==='RECEIPT_CREDIT_V1'?'Receive goods and post credit note':'Record physical receipt into quarantine' %></button>
    </form>
  <% } else if(customerReturn.status==='RECEIVED'){ %>
    <p class="rm-sub">Every received unit must be assigned once. Transfers preserve its exact cost; scrapping removes both the stock and inventory value.</p>
    <form method="post" action="/returns/<%= customerReturn.id %>/inspect" class="stack-form"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="idempotencyKey" value="<%= formKey %>-inspect">
      <% customerReturn.lines.forEach(function(line){ %><fieldset><legend><%= line.item_name %> — disposition <%= helpers.unitCount(line.quantity_received,'unit') %></legend><div class="inline-form"><label>Restock<input aria-label="<%= line.item_name %> restock quantity" type="number" name="restock_<%= line.id %>" min="0" max="<%= line.quantity_received %>" value="<%= line.quantity_received %>"></label><label>Restock location<select name="restockLocation_<%= line.id %>"><option value="">Choose location</option><% locations.forEach(function(location){ %><option value="<%= location.id %>"><%= location.name %></option><% }) %></select></label><label>Repair<input type="number" name="repair_<%= line.id %>" min="0" max="<%= line.quantity_received %>" value="0"></label><label>Repair location<select name="repairLocation_<%= line.id %>"><option value="">Choose if needed</option><% locations.forEach(function(location){ %><option value="<%= location.id %>"><%= location.name %></option><% }) %></select></label><label>Scrap<input type="number" name="scrap_<%= line.id %>" min="0" max="<%= line.quantity_received %>" value="0"></label></div><label>Condition note<input name="condition_<%= line.id %>" placeholder="What inspection found"></label></fieldset><% }) %>
      <button class="rm-btn" type="submit">Record inspection and disposition</button>
    </form>
  <% } else if(customerReturn.status==='AWAITING_REFUND'){ %>
    <p class="rm-sub">The goods have already been received and dispositioned. This step reverses only the proven selling amount; inventory will not move again.</p>
    <div class="quiet-note">Verified refund: <strong><%= helpers.money(refundFinancials.credited?(refundFinancials.cashDueMinor||0):refundableMinor,customerReturn.currency) %></strong></div>
    <% if(refundRequest){ %><div class="quiet-note"><strong><%= refundRequest.status==='PENDING'?'Provider confirmation pending':refundRequest.status==='REVIEW'?'Provider outcome needs review':refundRequest.status==='SUCCEEDED'?'Provider refund confirmed':'Provider refund failed' %></strong><br><%= refundRequest.last_error||'StockChief will change cash and accounting only after the original payment provider confirms the refund.' %></div><% } else { %>
    <form method="post" action="/returns/<%= customerReturn.id %>/refund" class="inline-form"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="idempotencyKey" value="<%= formKey %>-refund"><label>Refund destination<select name="destination"><% if(!refundFinancials.credited||refundFinancials.cashDueMinor){ %><option value="CASH">Repay through original paid funds</option><% } %><% if(!refundFinancials.credited||!refundFinancials.cashDueMinor){ %><option value="AR"><%= refundFinancials.credited?'Credit already applied — close return':'Reduce unpaid receivable' %></option><% } %></select></label><label>Refund date<input type="date" name="refundDate" value="<%= today %>"></label><button class="rm-btn" type="submit"><%= refundFinancials.credited&&!refundFinancials.cashDueMinor?'Close credited return':'Approve exact refund' %></button></form><p class="rm-sub">Online refunds are queued to the original provider. If no online payment exists, choosing original paid funds records your confirmed external cash refund.</p><% } %>
  <% } else if(customerReturn.status==='INSPECTED'){ %><p class="rm-sub">Inspection is complete. Prepare the replacement as a separate zero-price order so allocation, shipping, and fulfillment stay traceable.</p><form method="post" action="/returns/<%= customerReturn.id %>/exchange" class="stack-form"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="idempotencyKey" value="<%= formKey %>-exchange"><% customerReturn.lines.forEach(function(line){ %><label><%= line.item_name %> replacement quantity<input type="number" name="quantity_<%= line.id %>" min="0" value="<%= line.quantity_authorized %>"></label><% }) %><label>Fulfillment location<select name="fulfillmentLocationId"><option value="">Allocate from any available location</option><% locations.forEach(function(location){ %><option value="<%= location.id %>"><%= location.name %></option><% }) %></select></label><label>Order date<input type="date" name="orderDate" value="<%= today %>"></label><label>Replacement note<input name="notes" placeholder="What the customer should receive"></label><button class="rm-btn" type="submit">Prepare replacement order</button></form>
  <% } else { %><div class="quiet-note">This return is complete. Its physical movements and financial evidence are retained below and on the customer order.</div><% } %>
</section>

<section class="section"><div class="section-head"><h2>What changed</h2></div><div class="rm-ledger"><div class="rm-ledger__row"><span class="rm-ledger__k">Physical receipt<small>Only after goods arrived</small></span><span class="rm-ledger__v"><%= helpers.unitCount(customerReturn.lines.reduce((sum,line)=>sum+Number(line.quantity_received),0),'unit') %></span><span class="rm-ledger__n"><%= customerReturn.quarantine_name %></span></div><div class="rm-ledger__row"><span class="rm-ledger__k">Customer credit or refund<small>Separate approval from physical receipt</small></span><span class="rm-ledger__v"><%= refundFinancials.credited?'credit note posted':customerReturn.refund_id?'recorded':'not recorded' %></span><span class="rm-ledger__n"><%= helpers.money(refundableMinor,customerReturn.currency) %></span></div></div></section>
