<p class="rm-stamp"><a href="/orders">Orders</a> · <%= order.customer_name %></p>
<h1 class="rm-verdict"><%= order.order_number %> is <%= order.status.toLowerCase().replaceAll('_',' ') %>.</h1>
<p class="rm-prose"><%= order.delivery_method==='SHIP'?'Carrier delivery to '+order.ship_to_address:'Customer pickup; no shipping address is required.' %></p>
<% if(order.status==='DRAFT'){ %><p class="rm-sub">Stock is not committed until confirmation.</p><% } else if(['CONFIRMED','BACKORDERED'].includes(order.status)){ %><p class="rm-sub">Confirmation committed only the stock shown below; any shortage remains explicit.</p><% } %>
<% if(['PARTIALLY_FULFILLED','FULFILLED'].includes(order.status)){ %><p class="rm-sub">Inventory, revenue, COGS and the customer invoice changed together for the quantity actually fulfilled.</p><% } %>

<div class="rm-ledger"><% lines.forEach(function(line){ %><div class="rm-ledger__row"><span class="rm-ledger__k"><%= line.item_name %><%= line.variant_label?' / '+line.variant_label:'' %><small><%= line.code %> · <%= helpers.money(Number(line.unit_price_minor),order.currency) %> each</small></span><span class="rm-ledger__v"><%= line.quantity_fulfilled %> / <%= line.quantity_ordered %> fulfilled</span><span class="rm-ledger__n"><%= line.allocated %> committed</span></div><% }) %></div>

<section class="section"><div class="section-head"><h2>Next controlled step</h2></div>
  <% if(order.status==='DRAFT'){ %><form method="post" action="/orders/<%= order.id %>/confirm"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="rm-btn" type="submit">Confirm and commit available stock</button></form>
  <% } else if(['CONFIRMED','BACKORDERED','PARTIALLY_FULFILLED'].includes(order.status)){ const availableLine=lines.find((line)=>line.allocations.length); %>
    <% if(!availableLine){ %><div class="quiet-note">No stock is allocated yet. The shortage remains visible in Needs You.</div>
    <% } else if(order.delivery_method==='SHIP'){ const allocation=availableLine.allocations[0]; %><form method="post" action="/orders/<%= order.id %>/shipments" class="inline-form"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="lineId" value="<%= availableLine.id %>"><input type="hidden" name="locationId" value="<%= allocation.location_id %>"><input type="hidden" name="shipToAddress" value="<%= order.ship_to_address %>"><label>Pack quantity<input type="number" name="quantity" min="1" max="<%= allocation.quantity %>" value="<%= allocation.quantity %>" required></label><label>Measured weight (grams)<input type="number" name="weightGrams" min="1" step="1"></label><button class="rm-btn" type="submit">Prepare carrier parcel</button></form><p class="rm-sub">Preparing a parcel does not issue stock. The shipping page records label purchase and physical handoff separately.</p>
    <% } else { const allocation=availableLine.allocations[0]; %><form method="post" action="/orders/<%= order.id %>/fulfill" class="inline-form"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="lineId" value="<%= availableLine.id %>"><input type="hidden" name="locationId" value="<%= allocation.location_id %>"><label>Collected quantity<input type="number" name="quantity" min="1" max="<%= allocation.quantity %>" value="<%= allocation.quantity %>" required></label><button class="rm-btn" type="submit">Record customer collection</button></form><% } %>
  <% } else { %><div class="quiet-note">No fulfillment transition is waiting.</div><% } %>
</section>

<section class="section"><div class="section-head"><h2>Shipments</h2></div><% if(!shipments.length){ %><div class="quiet-note">No parcel has been prepared.</div><% } else { %><div class="rm-ledger"><% shipments.forEach(function(shipment){ %><a class="rm-ledger__row" href="/fulfilment/<%= shipment.id %>"><span class="rm-ledger__k"><%= shipment.shipment_number %><small><%= shipment.carrier || 'Carrier not selected' %></small></span><span class="rm-ledger__v"><%= shipment.status %></span><span class="rm-ledger__n"><%= shipment.tracking_number || 'No tracking yet' %></span></a><% }) %></div><% } %></section>

<section class="section"><div class="section-head"><h2>Customer money</h2></div>
  <p class="rm-sub">Online requests use this inventory’s own provider account and a provider-hosted page. Card numbers never enter StockChief. Confirmed payments and offline receipts use the same receivables and journal engine; neither moves physical stock.</p>
  <% const activeDeposit=paymentRequests.find((request)=>request.purpose==='DEPOSIT'&&['PENDING','OPEN','REVIEW'].includes(request.status)); %>
  <% if(!invoices.length){ %><div class="quiet-note">No invoice yet. Revenue and receivable are created only from actual fulfillment.</div>
    <% if(paymentTerms&&paymentTerms.kind==='DEPOSIT'){ %><p class="rm-sub">Agreed deposit: <strong><%= helpers.money(requiredDepositMinor,order.currency) %></strong>. Still due: <strong><%= helpers.money(depositDueMinor,order.currency) %></strong>. Money received before fulfillment remains a customer-deposit liability until an invoice exists.</p>
      <% if(depositDueMinor>0&&!activeDeposit){ %><form method="post" action="/orders/<%= order.id %>/payment-requests" class="inline-form"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="provider" value="stripe"><input type="hidden" name="purpose" value="DEPOSIT"><input type="hidden" name="idempotencyKey" value="<%= paymentRequestFormKey %>-deposit"><button class="rm-btn" type="submit">Prepare secure deposit link</button></form><p class="rm-sub">The provider worker prepares the exact agreed deposit. Nothing is marked paid until a signed result arrives.</p><% } %>
    <% } %>
  <% } %>
  <% if(paymentRequests.length){ %><h3>Secure payment requests</h3><div class="rm-ledger"><% paymentRequests.forEach(function(request){ %>
    <div class="rm-ledger__row"><span class="rm-ledger__k"><%= helpers.money(request.amount_minor,request.currency) %><small><%= request.provider %> · <%= request.purpose.toLowerCase() %> · <%= request.status %></small></span>
      <span class="rm-ledger__v"><%= request.status==='PENDING'?'Provider confirmation pending':request.status==='REVIEW'?'Provider outcome needs review':request.status==='PAID'?'Payment confirmed':request.last_error||'Ready for customer' %></span>
      <span class="rm-ledger__n"><% if(request.status==='OPEN'&&request.hosted_url){ %><a href="<%= request.hosted_url %>" target="_blank" rel="noopener">Open secure page ↗</a><% } else { %><%= request.status %><% } %></span></div>
  <% }) %></div><% } %>
  <% if(invoices.length){ %>
    <div class="rm-ledger"><% invoices.forEach(function(invoice){ %><div class="rm-ledger__row"><span class="rm-ledger__k"><%= invoice.invoice_number %><small><%= invoice.status %></small></span><span class="rm-ledger__v"><%= helpers.money(invoice.balance_minor,invoice.currency) %> due</span><span class="rm-ledger__n"><%= helpers.money(invoice.paid_minor,invoice.currency) %> paid</span></div><% }) %></div>
    <% const open=invoices.find((invoice)=>['OPEN','PARTIALLY_PAID'].includes(invoice.status)); if(open){ const activeRequest=paymentRequests.find((request)=>request.invoice_id===open.id&&['PENDING','OPEN','REVIEW'].includes(request.status)); %>
      <% if(!activeRequest){ %><form method="post" action="/orders/<%= order.id %>/payment-requests" class="inline-form"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="invoiceId" value="<%= open.id %>"><input type="hidden" name="provider" value="stripe"><input type="hidden" name="purpose" value="BALANCE"><input type="hidden" name="idempotencyKey" value="<%= paymentRequestFormKey %>"><button class="rm-btn" type="submit">Prepare secure payment link</button></form><p class="rm-sub">This queues provider work. It does not email the customer or mark anything paid.</p><% } %>
      <details class="rm-disclosure" open><summary>Record money received another way</summary><form method="post" action="/orders/<%= order.id %>/payments" class="inline-form"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="invoiceId" value="<%= open.id %>"><label>Payment amount<input type="number" name="amount" min="0.01" step="0.01" max="<%= (open.balance_minor/100).toFixed(2) %>" required></label><label>Date<input type="date" name="paymentDate" value="<%= today %>"></label><label>Method<input name="method" placeholder="ACH, check, external terminal"></label><button class="rm-btn" type="submit">Record customer payment</button></form></details>
    <% } %>
  <% } %>
</section>

<section class="section"><div class="section-head"><h2>Customer returns</h2></div>
  <p class="rm-sub">A request does not alter inventory or money. Returned goods first go to quarantine, then inspection decides whether they are restocked, repaired, or scrapped.</p>
  <% if(returns.length){ %><div class="rm-ledger"><% returns.forEach(function(customerReturn){ %><a class="rm-ledger__row" href="/returns/<%= customerReturn.id %>"><span class="rm-ledger__k"><%= customerReturn.return_number %><small><%= customerReturn.resolution.replaceAll('_',' ').toLowerCase() %></small></span><span class="rm-ledger__v"><%= customerReturn.status.replaceAll('_',' ').toLowerCase() %></span><span class="rm-ledger__n">Review →</span></a><% }) %></div><% } %>
  <% const returnable=lines.filter((line)=>Number(line.quantity_fulfilled)>Number(line.quantity_returned)); if(returnable.length){ %>
    <details class="rm-disclosure"><summary>Start a controlled return</summary><form method="post" action="/orders/<%= order.id %>/returns" class="stack-form"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="idempotencyKey" value="<%= returnFormKey %>">
      <label>Quarantine location<select name="quarantineLocationId" required><option value="">Choose where uninspected goods wait</option><% locations.forEach(function(location){ %><option value="<%= location.id %>"><%= location.name %></option><% }) %></select></label>
      <label>Expected outcome<select name="resolution"><option value="REFUND">Refund after inspection</option><option value="EXCHANGE">Prepare a replacement order after inspection</option><option value="NO_REFUND">No refund; physical return only</option></select></label>
      <div class="rm-ledger"><% returnable.forEach(function(line){ const maximum=Number(line.quantity_fulfilled)-Number(line.quantity_returned); %><label class="rm-ledger__row"><span class="rm-ledger__k"><%= line.item_name %><small><%= line.code %> · <%= maximum %> eligible</small></span><span class="rm-ledger__v">Quantity</span><input aria-label="Return <%= line.item_name %> quantity" type="number" name="quantity_<%= line.id %>" min="0" max="<%= maximum %>" value="0"></label><% }) %></div>
      <label>Reason<textarea name="reason" rows="2" placeholder="Why the customer is returning it"></textarea></label>
      <button class="rm-btn" type="submit">Request return</button><p class="rm-sub">Nothing moves until authorization and physical receipt.</p>
    </form></details>
  <% } else if(!returns.length && ['PARTIALLY_FULFILLED','FULFILLED'].includes(order.status)){ %><div class="quiet-note">Every fulfilled unit is already covered by a return.</div><% } %>
</section>

<section class="section"><div class="section-head"><h2>Verified history</h2></div><div class="rm-feed"><% events.forEach(function(event){ %><div class="rm-feed__row"><span class="rm-feed__ic">✓</span><span class="rm-feed__t"><%= event.event_type %><small><%= event.created_at %></small></span></div><% }) %></div></section>
