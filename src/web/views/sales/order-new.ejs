<%
  /*
   * Writing down what a customer ordered.
   *
   * The form asked the right questions in the right order and looked like a
   * database entry screen doing it: three numbered headings dropped inside a
   * field grid, a fieldset of radios styled as a legend and two labels, and
   * eleven optional fields folded behind a summary that read like a disabled
   * input. Everything below is the same set of questions, the same field names
   * and the same live stock check — laid out as three steps somebody can see
   * the shape of before they start typing.
   */
%>

<div class="rm-head">
  <a class="rm-head__back" href="/orders"><span aria-hidden="true">←</span> Orders</a>
  <p class="rm-head__eyebrow"><%- helpers.icon('sales', { size: 15 }) %> Customer order</p>
  <h1>What did the customer order?</h1>
  <p>
    Enter the customer, product, and quantity once. StockChief records customer demand before stock
    leaves, then you choose whether to reserve it or record that the customer already received it.
  </p>
</div>

<% if (locals.formError) { %>
  <div class="rm-note rm-note--warn">
    <%- helpers.icon('alert', { size: 16 }) %>
    <div><strong>This order is not ready.</strong> <%= locals.formError %></div>
  </div>
<% } %>

<form method="post" action="/sales/orders" class="card form-card" data-step-form>
  <input type="hidden" name="_csrf" value="<%= csrfToken %>">
  <input type="hidden" name="currency" value="USD">

  <section class="rm-step-panel">
    <div class="rm-step-panel__h"><span class="rm-step-panel__n">1</span><h2>Who ordered?</h2></div>
    <div class="rm-step-panel__b">
      <label class="rm-field">
        <span>Customer</span>
        <select name="customerId" id="order-customer">
          <option value="">+ Create a new customer with this order</option>
          <% customers.forEach(function (c) { %>
            <option value="<%= c.id %>" data-email="<%= c.email || '' %>" data-address="<%= c.shipping_address || '' %>" <%= form.customerId === c.id ? 'selected' : '' %>><%= c.name %><%= c.email ? ' · ' + c.email : '' %></option>
          <% }) %>
        </select>
      </label>
      <div id="order-new-customer">
        <label class="rm-field">
          <span>New customer's name</span>
          <input name="customerName" value="<%= form.customerName || '' %>" placeholder="Person or business name">
        </label>
      </div>
      <%#
        The two things StockChief cannot work without, asked for once.

        A new customer created here got a name and nothing else, so the parcel
        had nowhere to go and the shipping notice had nobody to reach. Both
        stay optional — plenty of orders are collected from the counter — but
        they are asked, which is the difference between "you did not tell me"
        and "I never asked".
      %>
      <label class="rm-field">
        <span>Their email <small>where order and shipping updates go</small></span>
        <input id="order-customer-email" type="email" name="customerEmail" value="<%= form.customerEmail || '' %>" placeholder="name@example.com">
        <small>StockChief cannot tell them anything without this. Filled in for an existing customer who has none.</small>
      </label>
    </div>
  </section>

  <section class="rm-step-panel">
    <div class="rm-step-panel__h"><span class="rm-step-panel__n">2</span><h2>How will they receive it?</h2></div>
    <div class="rm-step-panel__b">
      <fieldset class="rm-picks" style="border:0;padding:0;margin:0">
        <legend class="visually-hidden">How will they receive it?</legend>
        <label class="rm-pick">
          <input type="radio" name="deliveryMethod" value="SHIP" <%= form.deliveryMethod !== 'PICKUP' ? 'checked' : '' %>>
          <span class="rm-pick__box" aria-hidden="true"></span>
          <span><span class="rm-pick__t">Send by carrier</span>
            <span class="rm-pick__d">A complete delivery address is required before the order is created. Nothing ships until handover is confirmed later.</span></span>
        </label>
        <label class="rm-pick">
          <input type="radio" name="deliveryMethod" value="PICKUP" <%= form.deliveryMethod === 'PICKUP' ? 'checked' : '' %>>
          <span class="rm-pick__box" aria-hidden="true"></span>
          <span><span class="rm-pick__t">Customer pickup</span>
            <span class="rm-pick__d">No address is needed and no carrier is involved.</span></span>
        </label>
      </fieldset>

      <div id="order-destination" style="margin-top:14px">
        <label class="rm-field">
          <span>Delivery address for this order</span>
          <textarea id="order-customer-address" name="customerShippingAddress" rows="3" placeholder="Street, town, state, postcode"><%= form.customerShippingAddress || '' %></textarea>
          <small>Saved on this Sales Order. Changing the customer's address later will not change this order.</small>
        </label>
        <label class="checkbox">
          <input type="checkbox" name="saveCustomerAddress" value="1" <%= form.saveCustomerAddress === '1' ? 'checked' : '' %>>
          <span class="checkbox-text">Also make this the customer's default address for future orders</span>
        </label>
      </div>
    </div>
  </section>

  <section class="rm-step-panel">
    <div class="rm-step-panel__h"><span class="rm-step-panel__n">3</span><h2>What did they order?</h2></div>
    <div class="rm-step-panel__b">
      <%
        var formSkuIds = Array.isArray(form.skuId) ? form.skuId : [form.skuId || ''];
        var formQuantities = Array.isArray(form.quantity) ? form.quantity : [form.quantity || ''];
        var formPrices = Array.isArray(form.unitPrice) ? form.unitPrice : [form.unitPrice || ''];
        var formLineCount = Math.max(1, formSkuIds.length, formQuantities.length, formPrices.length);
      %>
      <div class="sales-order-lines" id="order-lines">
        <% for (var lineIndex = 0; lineIndex < formLineCount; lineIndex += 1) { %>
          <div class="sales-order-line" data-order-line>
            <label class="rm-field">
              <span>Product or variant</span>
              <select <%= lineIndex === 0 ? 'id="order-sku"' : '' %> name="skuId" required>
                <option value="">Choose a product</option>
                <% skus.forEach(function (s) { %>
                  <option value="<%= s.id %>" <%= formSkuIds[lineIndex] === s.id ? 'selected' : '' %>><%= s.display_name %> · <%= s.code %> · <%= s.price.isSet ? s.price.formatted : 'Price not set' %> · <%= s.stock.available %> available now</option>
                <% }) %>
              </select>
            </label>
            <label class="rm-field">
              <span>Quantity</span>
              <input <%= lineIndex === 0 ? 'id="order-quantity"' : '' %> type="number" name="quantity" min="1" step="1" value="<%= formQuantities[lineIndex] || '' %>" required>
            </label>
            <label class="rm-field">
              <span>Price <small>if not set</small></span>
              <input name="unitPrice" inputmode="decimal" value="<%= formPrices[lineIndex] || '' %>" placeholder="Use inventory price">
            </label>
            <button class="btn btn--ghost btn--sm" type="button" data-remove-order-line <%= formLineCount === 1 ? 'hidden' : '' %>>Remove</button>
          </div>
        <% } %>
      </div>
      <button class="btn btn--ghost btn--sm" id="add-order-line" type="button">+ Add another product</button>
      <p class="hint">Available stock excludes units already reserved for other customers.</p>

      <template id="order-line-template">
        <div class="sales-order-line" data-order-line>
          <label class="rm-field"><span>Product or variant</span><select name="skuId" required><option value="">Choose a product</option><% skus.forEach(function (s) { %><option value="<%= s.id %>"><%= s.display_name %> · <%= s.code %> · <%= s.price.isSet ? s.price.formatted : 'Price not set' %> · <%= s.stock.available %> available now</option><% }) %></select></label>
          <label class="rm-field"><span>Quantity</span><input type="number" name="quantity" min="1" step="1" required></label>
          <label class="rm-field"><span>Price <small>if not set</small></span><input name="unitPrice" inputmode="decimal" placeholder="Use inventory price"></label>
          <button class="btn btn--ghost btn--sm" type="button" data-remove-order-line>Remove</button>
        </div>
      </template>

      <div id="order-stock-check" class="notice notice--info" aria-live="polite">
        <div><strong>Choose products and quantities.</strong><br>StockChief will show what can be reserved before you create the order.</div>
      </div>
    </div>
  </section>

  <details class="rm-work">
    <summary>Optional order details — dates, location, tax, discount, reference, and notes</summary>
    <div class="rm-work__body">
      <div class="form-grid" style="margin-top:12px">
        <label class="rm-field"><span>Order number <small>optional</small></span><input name="orderNumber" value="<%= form.orderNumber || '' %>" placeholder="StockChief will assign one"></label>
        <label class="rm-field"><span>Order date</span><input type="date" name="orderDate" value="<%= form.orderDate || new Date().toISOString().slice(0,10) %>"></label>
        <label class="rm-field"><span>Needed by <small>optional</small></span><input type="date" name="neededBy" value="<%= form.neededBy || '' %>"></label>
        <label class="rm-field"><span>Allocation priority <small>lower numbers first</small></span><input type="number" name="allocationPriority" min="0" max="1000" step="1" value="<%= form.allocationPriority ?? 100 %>"></label>
        <label class="rm-field">
          <span>Ship from <small>optional</small></span>
          <select id="order-location" name="fulfillmentLocationId">
            <option value="">Let StockChief use available stock at any location</option>
            <% locations.forEach(function (l) { %>
              <option value="<%= l.id %>" <%= form.fulfillmentLocationId === l.id ? 'selected' : '' %>><%= l.name %></option>
            <% }) %>
          </select>
        </label>
        <label class="rm-field"><span>Discount amount <small>optional</small></span><input name="discount" inputmode="decimal" value="<%= form.discount || '' %>" placeholder="0.00"></label>
        <label class="rm-field"><span>Tax amount <small>optional</small></span><input name="tax" inputmode="decimal" value="<%= form.tax || '' %>" placeholder="0.00"></label>
      </div>
      <label class="rm-field"><span>Reference <small>optional</small></span><input name="reference" value="<%= form.reference || '' %>"></label>
      <label class="rm-field"><span>Notes <small>optional</small></span><textarea name="notes"><%= form.notes || '' %></textarea></label>
    </div>
  </details>

  <div class="rm-note<%= locals.unpricedCount ? ' rm-note--warn' : '' %>">
    <%- helpers.icon('shield', { size: 16 }) %>
    <div>
      <strong>Every customer order needs a price. StockChief will never invent one.</strong>
      It uses the product’s selling price or the order price above. Accounting updates only after
      items physically leave.
    </div>
  </div>

  <div class="rm-confirm">
    <span class="rm-confirm__t">
      <strong>Choose what is true now</strong>
      <span>Create and reserve holds available stock. If a pickup customer already has the goods,
        complete it now and StockChief records the shipment, stock change, sale, and amount owed together.</span>
    </span>
    <span class="rm-choices">
      <button class="rm-btn" id="order-confirm-button" type="submit" name="nextStep" value="confirm">Create order and continue</button>
      <button class="rm-btn rm-btn--wash" id="order-complete-button" type="submit" name="nextStep" value="fulfill" hidden>Customer has it now — complete pickup</button>
      <button class="rm-btn rm-btn--ghost" type="submit" name="nextStep" value="draft">Save draft</button>
      <a class="rm-btn rm-btn--ghost" href="/sales">Cancel</a>
    </span>
  </div>
</form>

<script>
(function () {
  var customer = document.getElementById('order-customer');
  var email = document.getElementById('order-customer-email');
  var address = document.getElementById('order-customer-address');
  var destination = document.getElementById('order-destination');
  var newCustomer = document.getElementById('order-new-customer');
  var methods = Array.prototype.slice.call(document.querySelectorAll('input[name="deliveryMethod"]'));
  var lines = document.getElementById('order-lines');
  var addLine = document.getElementById('add-order-line');
  var lineTemplate = document.getElementById('order-line-template');
  var location = document.getElementById('order-location');
  var stockCheck = document.getElementById('order-stock-check');
  var confirmButton = document.getElementById('order-confirm-button');
  var completeButton = document.getElementById('order-complete-button');
  var stock = <%- JSON.stringify(Object.fromEntries(skus.map(function (entry) { return [entry.id, entry.stock]; }))).replace(/</g, '\\u003c') %>;

  function useCustomerDefaults() {
    var option = customer && customer.options[customer.selectedIndex];
    if (newCustomer) newCustomer.hidden = Boolean(option && option.value);
    if (!option || !option.value) return;
    if (!email.value) email.value = option.getAttribute('data-email') || '';
    if (!address.value) address.value = option.getAttribute('data-address') || '';
  }

  function showDestination() {
    var method = methods.filter(function (entry) { return entry.checked; })[0];
    var ships = !method || method.value === 'SHIP';
    destination.hidden = !ships;
    address.disabled = !ships;
    address.required = ships;
  }

  function showStockPromise() {
    if (!stockCheck) return;
    var requestedBySku = {};
    Array.prototype.slice.call(lines.querySelectorAll('[data-order-line]')).forEach(function (row) {
      var skuInput = row.querySelector('select[name="skuId"]');
      var quantityInput = row.querySelector('input[name="quantity"]');
      var requested = quantityInput ? Number(quantityInput.value) : 0;
      if (!skuInput || !skuInput.value || !Number.isFinite(requested) || requested < 1) return;
      requestedBySku[skuInput.value] = (requestedBySku[skuInput.value] || 0) + requested;
    });
    var skuIds = Object.keys(requestedBySku);
    if (!skuIds.length) {
      stockCheck.className = 'notice notice--info';
      stockCheck.innerHTML = '<div><strong>Choose products and quantities.</strong><br>StockChief will show what can be reserved before you create the order.</div>';
      if (confirmButton) confirmButton.textContent = 'Create order and continue';
      if (completeButton) completeButton.hidden = true;
      return;
    }
    var totalRequested = 0;
    var totalAvailable = 0;
    var totalShort = 0;
    var locationName = 'all locations';
    skuIds.forEach(function (skuId) {
      var selected = stock[skuId];
      var requested = requestedBySku[skuId];
      var available = Number(selected && selected.available || 0);
      if (location && location.value) {
        var position = (selected.positions || []).filter(function (entry) { return entry.location_id === location.value; })[0];
        available = position ? Number(position.available || 0) : 0;
        locationName = location.options[location.selectedIndex].text;
      }
      totalRequested += requested;
      totalAvailable += available;
      totalShort += Math.max(0, requested - Math.max(0, available));
    });
    if (totalShort) {
      stockCheck.className = 'notice notice--warn';
      stockCheck.innerHTML = '<div><strong>This order is ' + totalShort + ' unit' + (totalShort === 1 ? '' : 's') + ' over the available stock.</strong><br>'
        + totalRequested + ' requested · ' + totalAvailable + ' available now at ' + locationName + ' · '
        + totalShort + ' will wait for stock. You may continue, but StockChief cannot promise the full order immediately.</div>';
      if (confirmButton) confirmButton.textContent = 'Create order — ' + totalShort + ' will wait for stock';
      if (completeButton) completeButton.hidden = true;
      return;
    }
    stockCheck.className = 'notice notice--success';
    stockCheck.innerHTML = '<div><strong>All ' + totalRequested + ' can be reserved now.</strong><br>'
      + skuIds.length + ' product' + (skuIds.length === 1 ? '' : 's') + ' checked at ' + locationName + '.</div>';
    if (confirmButton) confirmButton.textContent = 'Create order and reserve ' + totalRequested;
    var method = methods.filter(function (entry) { return entry.checked; })[0];
    if (completeButton) completeButton.hidden = !method || method.value !== 'PICKUP';
  }

  if (customer) customer.addEventListener('change', useCustomerDefaults);
  methods.forEach(function (entry) { entry.addEventListener('change', function () { showDestination(); showStockPromise(); }); });
  if (lines) {
    lines.addEventListener('change', showStockPromise);
    lines.addEventListener('input', showStockPromise);
    lines.addEventListener('click', function (event) {
      var remove = event.target.closest('[data-remove-order-line]');
      if (!remove) return;
      var rows = lines.querySelectorAll('[data-order-line]');
      if (rows.length <= 1) return;
      remove.closest('[data-order-line]').remove();
      if (lines.querySelectorAll('[data-order-line]').length === 1) {
        lines.querySelector('[data-remove-order-line]').hidden = true;
      }
      showStockPromise();
    });
  }
  if (addLine && lineTemplate) addLine.addEventListener('click', function () {
    lines.appendChild(lineTemplate.content.cloneNode(true));
    Array.prototype.slice.call(lines.querySelectorAll('[data-remove-order-line]')).forEach(function (button) { button.hidden = false; });
    lines.querySelector('[data-order-line]:last-child select').focus();
    showStockPromise();
  });
  if (location) location.addEventListener('change', showStockPromise);
  useCustomerDefaults();
  showDestination();
  showStockPromise();
}());
</script>
