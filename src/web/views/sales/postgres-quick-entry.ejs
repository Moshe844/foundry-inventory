<details class="owner-manual section"><summary><span><strong>Draft a customer order manually</strong><small>Use this when you already know the customer, products and terms.</small></span><span class="owner-manual__cue">Open form <%- helpers.icon('chevron', { size: 15 }) %></span></summary><div class="owner-manual__body">
  <% if(!customers.length || !catalogue.length){ %><div class="quiet-note">Add at least one customer and product before drafting an order.</div><% } else { %><form method="post" action="/orders" class="stacked-form"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><div class="form-grid">
    <label for="sales-customer">Customer</label><select id="sales-customer" name="customerId" required><option value="">Choose customer</option><% customers.forEach(function(customer){ %><option value="<%= customer.id %>" data-address="<%= customer.shipping_address || '' %>"><%= customer.name %></option><% }) %></select>
    <label>Product / SKU<select name="skuId" required><option value="">Choose product</option><% catalogue.forEach(function(sku){ %><option value="<%= sku.id %>"><%= sku.display_name %> · <%= sku.available %> available</option><% }) %></select></label>
    <label>Quantity<input type="number" name="quantity" min="1" step="1" required></label><label>Selling price<input type="number" name="unitPrice" min="0" step="0.01" required></label>
    <label>Delivery method<select name="deliveryMethod"><option value="SHIP">Ship by carrier</option><option value="PICKUP">Customer pickup</option></select></label><label>Fulfillment location<select name="fulfillmentLocationId"><option value="">Any location</option><% locations.forEach(function(location){ %><option value="<%= location.id %>"><%= location.name %></option><% }) %></select></label>
    <label>Shipping destination<textarea name="shipToAddress" placeholder="Required for carrier shipping"></textarea></label><label>Needed by<input type="date" name="neededBy"></label>
  </div><button class="rm-btn" type="submit">Draft customer order</button></form><% } %>
</div></details>

<details class="owner-manual section" id="customers"><summary><span><strong>Add a customer manually</strong><small>Only if you want to enter their details yourself.</small></span><span class="owner-manual__cue">Open form <%- helpers.icon('chevron', { size: 15 }) %></span></summary><div class="owner-manual__body"><form method="post" action="/sales/customers" class="stacked-form"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><div class="form-grid"><label>Name<input name="name" required></label><label>Email<input type="email" name="email"></label><label>Phone<input name="phone"></label><label>Shipping address<textarea name="shippingAddress"></textarea></label></div><button class="rm-btn" type="submit">Add customer</button></form></div></details>
