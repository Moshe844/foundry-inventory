<div class="rm-head"><a href="/orders">← Orders</a><h1>Quotes</h1><p>Review agreed prices before creating an order. Quotes reserve no stock and create no invoice.</p><a class="rm-btn" href="/quotes/new">Prepare a quote</a></div>
<section class="rm-panel"><div class="rm-panel__body"><% if(!quotes.length){ %><p>No quotations yet.</p><% }else{ %><div class="table-wrap"><table><thead><tr><th>Quotation</th><th>Customer</th><th>Status</th><th>Valid through</th><th>Total</th></tr></thead><tbody><% quotes.forEach(q=>{ %><tr><td><a href="/quotes/<%= q.id %>"><%= q.quote_number %></a></td><td><%= q.customer_name %></td><td><%= q.status %></td><td><%= q.valid_until %></td><td><%= helpers.money(q.pricing.totalMinor,q.pricing.currency) %></td></tr><% }); %></tbody></table></div><% } %></div></section>
