<%
  var statusLabels = { DRAFT: 'Being prepared', CONFIRMED: 'Confirmed — stock held',
    BACKORDERED: 'Confirmed — waiting for stock', PARTIALLY_FULFILLED: 'Partly shipped',
    FULFILLED: 'Shipped', CANCELLED: 'Cancelled' };
  var currentStep = order.status === 'DRAFT' ? 1
    : ['CONFIRMED','BACKORDERED'].includes(order.status) ? 2
      : order.status === 'PARTIALLY_FULFILLED' ? 3 : 4;

  /*
   * How much has actually gone.
   *
   * Declared at the top because it is read further up the page than it used
   * to be. The shortfall notice moved above the old declaration and read it
   * as undefined, so a page recording that thirty-four units shipped also
   * said "nothing was shipped" — the exact bug the comment on that notice
   * was written to record the first time.
   *
   * Reassuring somebody that nothing moved, on the screen recording that
   * something moved, undermines every other number on the page.
   */
  var shipped = order.totals.fulfilled || 0;
%>
<div class="breadcrumb"><a href="/orders">Orders</a> <%- helpers.icon('chevron', { size: 13 }) %> <span><%= order.order_number %></span></div>
<div class="page-head"><div class="titles"><p class="eyebrow">Customer order</p><h1><%= order.order_number %> · <%= order.customer.name %></h1><p>Created <%= order.order_date %><%= order.needed_by ? ' · customer needs it by ' + order.needed_by : '' %></p></div><span class="badge <%= order.status === 'BACKORDERED' ? 'badge--warn' : order.status === 'FULFILLED' ? 'badge--success' : 'badge--muted' %>"><%= statusLabels[order.status] || order.status %></span></div>

<% if (money.invoiced && (money.heldReason.pick || money.heldReason.ship)) { %>
  <div class="notice notice--<%= money.override ? 'info' : 'warn' %>" id="payment-hold">
    <div>
      <% if (money.override) { %>
        <strong>You let this one through unpaid.</strong><br>
        <%= money.heldReason.ship || money.heldReason.pick %>
        <% if (money.override.reason) { %><br><em><%= money.override.reason %></em><% } %>
        <form method="post" action="/sales/orders/<%= order.id %>/payment-hold" class="inline-form" style="margin-top:8px;">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <button class="btn btn--ghost btn--sm" type="submit" name="action" value="restore">Put the hold back</button>
        </form>
      <% } else { %>
        <strong><%= money.blocksPicking ? 'This order is on hold until it is paid.' : 'This order cannot ship until it is paid.' %></strong><br>
        <%= money.heldReason.pick || money.heldReason.ship %>
        <span class="t-xs t-muted">(<%= money.termsText %> — <%= money.terms.source %>.)</span>
        <details class="disclosure" style="margin-top:10px;">
          <summary>Let this one order through anyway</summary>
          <div class="card-body">
            <form method="post" action="/sales/orders/<%= order.id %>/payment-hold" data-busy>
              <input type="hidden" name="_csrf" value="<%= csrfToken %>">
              <label class="field">
                <span class="field-label">Why <span class="t-muted">(optional)</span></span>
                <input class="input" type="text" name="reason" placeholder="Long-standing customer, I called them">
              </label>
              <button class="btn" type="submit" name="action" value="override">Approve this order to go unpaid</button>
              <p class="hint">
                This lifts the hold for this order only, and keeps a note that you did.
                Their terms are unchanged.
              </p>
            </form>
          </div>
        </details>
      <% } %>
    </div>
  </div>
<% } %>


<%#
  Why before what.

  This explanation sat below "Do this next: record the items as shipped", so
  the page offered to ship an order before mentioning that four fifths of it
  was missing. Same order the payment hold uses: state the situation, then
  offer the thing to do about it.
%>
<% if (order.status !== 'DRAFT' && order.totals.backordered) { %><div class="notice notice--warn sales-outcome">
  <strong><%= order.totals.backordered %> unit<%= order.totals.backordered === 1 ? '' : 's' %> still short.</strong>
  <%
    // Stock is allocated when an order is confirmed and not again, so a
    // delivery can arrive against this very shortfall and the order still says
    // the stock is not there. Sixty units in the store room and an order
    // reading "the rest is not in stock yet" is a straightforward untruth.
    var available = locals.shortButAvailable || 0;
  %>
  <% if (shipped) { %>
    <p><%= shipped %> unit<%= shipped === 1 ? '' : 's' %> shipped and
      <%= order.totals.allocated %> held for this customer.
      <% if (available) { %>
        <%= available %> <%= available === 1 ? 'is' : 'are' %> on the shelf now and not committed to
        anyone.
      <% } else { %>
        The rest is not in stock yet.
      <% } %></p>
  <% } else { %>
    <p>The customer order is confirmed, but Foundry found only <%= order.totals.allocated %> unit<%= order.totals.allocated === 1 ? '' : 's' %> available to hold. <strong>No on-hand stock changed and nothing was shipped.</strong></p>
  <% } %>
  <p>Foundry automatically checked stock at other locations, incoming supplier orders and replenishment. If a decision or missing setup is required, it is in <a href="/needs-you">Needs you</a>.</p>
</div><% } %>

<% if (order.status === 'DRAFT' && !order.pricing.missingPriceLines) { %>
  <form class="card sales-action-card sales-primary-action" method="post" action="/sales/orders/<%= order.id %>/confirm">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <p class="eyebrow">Do this next</p><h2>Confirm this order and reserve stock</h2>
    <p>This is the only action needed now. Foundry will hold available stock for <%= order.customer.name %>; physical on-hand and Accounting remain unchanged until shipment.</p>
    <button class="btn btn--primary" type="submit">Confirm order and reserve stock</button>
  </form>
<% } else if (order.status === 'DRAFT') { %>
  <div class="notice notice--warn"><div><strong>This order cannot be confirmed yet.</strong><br>Set the missing selling price below. Foundry never treats a blank price as zero.</div></div>
<% } else if (!['FULFILLED','CANCELLED'].includes(order.status) && locals.shortButAvailable) { %>
  <form class="card sales-action-card sales-action-card--commit sales-primary-action" method="post" action="/sales/orders/<%= order.id %>/allocate">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <input type="hidden" name="idempotencyKey" value="web-allocate:<%= order.id %>:<%= order.version %>">
    <p class="eyebrow">Do this next</p><h2>Reserve the stock that is now available</h2>
    <p><%= locals.shortButAvailable %> unit<%= locals.shortButAvailable === 1 ? ' is' : 's are' %> free now. Reserving keeps it for <%= order.customer.name %>; nothing ships yet.</p>
    <button class="btn btn--primary" type="submit">Reserve <%= locals.shortButAvailable %> for <%= order.customer.name %></button>
  </form>
<% } else if (locals.money && (money.blocksPicking || money.blocksShipping)) { %>
  <%#
    Offering "record the items as shipped" on an order the engine will refuse
    to ship is the page telling somebody to do the one thing they cannot. The
    hold above already says what is wanted; this says what to do about it.
  %>
  <div class="card sales-action-card sales-primary-action">
    <p class="eyebrow">Do this next</p>
    <h2>Get the <%= helpers.money(money.dueNowMinor || money.outstandingMinor, money.currency) %></h2>
    <p>
      <% if (money.blocksPicking) { %>
        Nothing is picked or shipped for <%= order.customer.name %> until this arrives.
      <% } else { %>
        <%= order.customer.name %> can have this picked and packed, but it does not leave
        until the balance is settled.
      <% } %>
      Ask them to pay from the money panel below, or approve this one order to go without.
    </p>
    <a class="btn btn--primary" href="#payment-hold">Settle the hold</a>
  </div>
<% } else if (!['FULFILLED','CANCELLED'].includes(order.status) && (locals.shipments || [])
    .some(function (box) { return box.status === 'PICKING' || box.status === 'PACKED'; })) { %>
  <%
    /*
     * A box is already open on this order, so the direct "record it as
     * shipped" form stands down. Both do the same thing to the same stock,
     * and using this one would leave the box holding a claim on units that
     * had already gone - a shipment stuck being picked forever.
     */
    var openBox = (locals.shipments || []).filter(function (box) {
      return box.status === 'PICKING' || box.status === 'PACKED';
    })[0];
  %>
  <div class="card sales-action-card sales-primary-action">
    <p class="eyebrow">Do this next</p>
    <h2><%= openBox.status === 'PICKING' ? 'Finish picking' : 'Hand it to the carrier' %></h2>
    <p>
      <%= openBox.shipment_number %> already holds <%= openBox.units %>
      <%= openBox.units === 1 ? 'unit' : 'units' %> of this order. Ship it from there, so what
      leaves stock is exactly what went in the box.
    </p>
    <a class="btn btn--primary" href="/fulfilment/<%= openBox.id %>">Open <%= openBox.shipment_number %></a>
  </div>
<% } else if (!['FULFILLED','CANCELLED'].includes(order.status) && order.totals.allocated > 0) { %>
  <form class="card sales-action-card sales-primary-action" method="post" action="/sales/orders/<%= order.id %>/fulfill">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <input type="hidden" name="idempotencyKey" value="web-fulfill:<%= order.id %>:<%= order.version %>">
    <p class="eyebrow">Do this next</p><h2>Record the items as shipped</h2>
    <p>Only use this when the items physically leave. Foundry will reduce on-hand once and update Accounting automatically.</p>
    <% order.lines.forEach(function(line){ line.allocations.forEach(function(a){ %><div class="form-row"><input type="hidden" name="lineId" value="<%= line.id %>"><input type="hidden" name="locationId" value="<%= a.location_id %>"><label class="field"><span><%= line.displayName %> from <%= a.location_name %> (maximum <%= a.quantity %>)</span><input type="number" name="quantity" min="0" max="<%= a.quantity %>" value="<%= a.quantity %>"></label></div><% }) }) %>
    <%#
      Where it is going, and how.

      This form moved the stock and asked nothing else, so an order could be
      shipped with no destination and no way to follow it — and the page had no
      answer when somebody asked where it went. Both are optional, because a
      customer collecting from the counter needs neither, but they are asked.
    %>
    <div class="ship-details">
      <label class="field">
        <span>Carrier <small>optional</small></span>
        <select name="carrier">
          <option value="">Work it out from the tracking number</option>
          <% (locals.carriers || []).forEach(function (carrier) { %>
            <option value="<%= carrier.code %>"><%= carrier.name %></option>
          <% }) %>
        </select>
      </label>
      <label class="field">
        <span>Tracking number <small>optional</small></span>
        <input name="trackingNumber" placeholder="Paste or scan it" autocomplete="off">
        <small>Becomes a link the customer can follow.</small>
      </label>
    </div>
    <% if (order.customer && !order.customer.shipping_address) { %>
      <p class="hint">
        Foundry has no address for <%= order.customer.name %>, so this parcel will not carry one.
        <a href="/sales/customers/<%= order.customer.id %>">Add it</a> and every parcel after this
        one will.
      </p>
    <% } %>
    <button class="btn btn--primary" type="submit">Ship selected quantities</button>
  </form>
<% } %>

<%#
  This explains the two decisions somebody is about to make. On an order that
  has shipped they are both behind them, and it becomes a paragraph of
  onboarding sitting on top of a finished job. It stays while it is useful and
  goes when it is not.
%>
<% if (!['FULFILLED', 'CANCELLED'].includes(order.status)) { %>
  <div class="notice notice--info sales-order-explanation"><div><strong>Only two business decisions:</strong><br><strong>Reserve</strong> when the customer commits. <strong>Ship</strong> when the items physically leave. Accounting is automatic after shipment—it is not another step for you.</div></div>
<% } %>

<%#
  The same four figures, minus the ones that are only ever zero at this stage.
  A finished order showing "0 committed, 0 waiting for stock" is three-quarters
  of a table saying nothing happened, next to the one number that matters.
%>
<div class="stats-row">
  <div class="stat"><strong><%= order.totals.ordered %></strong><span>Units ordered</span></div>
  <% if (order.totals.allocated) { %>
    <div class="stat"><strong><%= order.totals.allocated %></strong><span>committed to this customer</span></div>
  <% } %>
  <% if (order.totals.backordered) { %>
    <div class="stat"><strong class="is-warn"><%= order.totals.backordered %></strong><span><%= order.status === 'DRAFT' ? 'not committed yet' : 'waiting for stock' %></span></div>
  <% } %>
  <% if (order.totals.fulfilled || order.totals.ordered === order.totals.fulfilled) { %>
    <div class="stat"><strong><%= order.totals.fulfilled %></strong><span>shipped</span></div>
  <% } %>
</div>

<% if (order.status === 'FULFILLED' || order.status === 'PARTIALLY_FULFILLED') { %>
  <% if (accounting.status === 'POSTED') { %>
    <div class="notice notice--success"><div><strong>Accounting updated automatically.</strong><br>Revenue, the customer receivable, product cost, and inventory value were posted from this shipment.</div><a class="btn btn--sm" href="/accounting/entries/<%= accounting.journal_entry_id %>">See entry #<%= accounting.entry_number %></a></div>
  <% } else if (accounting.status === 'NEEDS_REVIEW' || accounting.status === 'FAILED') { %>
    <div class="notice notice--warning"><div><strong>The shipment is complete, but Accounting still needs one decision.</strong><br><%= accounting.outcome.message || accounting.error_message %> Stock will not be changed again.</div><a class="btn btn--primary btn--sm" href="/accounting/review/<%= accounting.id %>">Review exact amounts</a></div>
  <% } else if (accounting.status === 'WAITING') { %>
    <div class="notice"><strong>Accounting is processing this shipment.</strong> Refresh once if this remains here.</div>
  <% } else { %>
    <div class="notice"><strong>Accounting is not active.</strong> The Sales Order and inventory are complete; no financial entry was created.</div>
  <% } %>
<% } %>





<%
  /*
   * Where this order physically stands, and the one thing to do about it.
   *
   * The order already had quantities: ordered, committed, short, shipped.
   * What it never had was a word for the state a person actually asks about —
   * "has it gone out yet?" — and a way to start the box. Both live here, and
   * both are derived, so this panel cannot disagree with the shipments below it.
   */
  var fulfilment = locals.fulfilment || null;
  var boxes = locals.shipments || [];
  var free = locals.pickable || [];
  var freeUnits = free.reduce(function (sum, row) { return sum + row.available; }, 0);
%>
<% if (fulfilment && order.status !== 'DRAFT') { %>
  <div class="panel section" id="fulfilment">
    <div class="panel-head">
      <div>
        <h2>Fulfilment</h2>
        <span class="t-xs t-muted">
          <% if (locals.money && money.blocksPicking) { %>Waiting on payment
          <% } else if (fulfilment.detail) { %><%= fulfilment.detail %><% } else { %>
            <%= boxes.length %> <%= boxes.length === 1 ? 'shipment' : 'shipments' %>
          <% } %>
        </span>
      </div>
      <span class="spacer"></span>
      <%
        /*
         * Money outranks stock in this word. An order with everything on the
         * shelf is not "ready to pick" when picking it would be refused, and a
         * badge saying so beside a sentence saying the opposite is the kind of
         * thing that makes somebody stop believing the screen.
         */
        var fulfilmentWord = (locals.money && money.blocksPicking && fulfilment.state === 'Ready to pick')
          ? 'Held until paid' : fulfilment.state;
      %>
      <span class="badge badge--<%= ['Shipped', 'Delivered'].indexOf(fulfilmentWord) >= 0 ? 'ok'
        : ['Waiting for stock', 'Held until paid'].indexOf(fulfilmentWord) >= 0 ? 'warn'
        : 'info' %>"><%= fulfilmentWord %></span>
    </div>

    <% if (boxes.length) { %>
      <table class="table">
        <thead>
          <%#
            "Where" is the first thing anybody asks of a shipment, and the
            order page could not answer it: a row saying "Shipped" and a dash
            for tracking, with the destination nowhere on the page. When
            Foundry has no address it says so here rather than leaving the
            question hanging.
          %>
          <tr><th>Shipment</th><th class="num">Units</th><th>State</th><th>Where</th><th>Tracking</th><th>Customer told</th></tr>
        </thead>
        <tbody>
          <% boxes.forEach(function (box) { %>
            <tr>
              <td><a href="/fulfilment/<%= box.id %>"><strong><%= box.shipment_number %></strong></a></td>
              <td class="num"><%= box.units %></td>
              <td>
                <%= { PICKING: 'Being picked', PACKED: 'Packed', SHIPPED: 'Shipped',
                      DELIVERED: 'Delivered', CANCELLED: 'Cancelled' }[box.status] %>
                <% if (box.shipped_at) { %>
                  <span class="t-xs t-muted">· <%= helpers.shortDate(box.shipped_at) %></span>
                <% } %>
              </td>
              <td>
                <% if (box.ship_to_address) { %>
                  <span class="cell-sub"><%= String(box.ship_to_address).split('\n')[0] %></span>
                <% } else { %>
                  <a class="t-warn" href="/sales/customers/<%= order.customer.id %>">No address on file</a>
                <% } %>
              </td>
              <td>
                <% if (box.tracking_number && box.trackingUrl) { %>
                  <a href="<%= box.trackingUrl %>" target="_blank" rel="noopener noreferrer"><%= box.tracking_number %></a>
                <% } else if (box.tracking_number) { %>
                  <%= box.tracking_number %>
                <% } else { %><span class="t-muted">—</span><% } %>
              </td>
              <td>
                <%
                  var told = (locals.customerNotices || [])
                    .filter(function (note) { return note.shipmentId === box.id; })[0];
                %>
                <% if (!told) { %>
                  <span class="t-muted">—</span>
                <% } else if (told.status === 'SENT') { %>
                  <span class="t-ok">Sent <%= helpers.shortDate(told.sentAt) %></span>
                <% } else if (told.status === 'CANCELLED') { %>
                  <span class="t-muted">Not sending</span>
                <% } else { %>
                  <a href="/fulfilment/<%= box.id %>">Written, not sent</a>
                <% } %>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    <% } %>

    <% if (freeUnits && locals.money && money.blocksPicking) { %>
      <div class="card-body">
        <p class="hint">
          <%= freeUnits %> <%= freeUnits === 1 ? 'unit is' : 'units are' %> committed and ready,
          but this order is held until it is paid. Picking it is refused until then.
        </p>
      </div>
    <% } else if (freeUnits) { %>
      <div class="card-foot">
        <form method="post" action="/sales/orders/<%= order.id %>/pick" data-busy>
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <button class="btn btn--primary" type="submit">
            Start picking <%= freeUnits %> <%= freeUnits === 1 ? 'unit' : 'units' %>
          </button>
          <span class="hint">
            This opens a box and a pick list. Nothing leaves stock until you mark it shipped.
          </span>
        </form>
      </div>
    <% } else if (fulfilment.state === 'Waiting for stock') { %>
      <div class="card-body">
        <p class="hint">
          There is nothing to pick because nothing is committed to this order yet.
          Commit stock above, or wait for the delivery it is short against.
        </p>
      </div>
    <% } %>
  </div>
<% } %>

<%
  /*
   * What the customer owes.
   *
   * The order carried quantities and no money: ordered, committed, short,
   * shipped, and nothing about whether it had been paid for. The invoice
   * already knew — it is linked to this order — so the figures were a query
   * away and the page simply never asked.
   *
   * It appears once there is an invoice. Before that there is nothing owed,
   * and a row of zeroes would only look like a debt of nothing.
   */
  var money = locals.money || { invoiced: false };
%>
<% if (money.invoiced) { %>
  <div class="panel section" id="money">
    <div class="panel-head">
      <div>
        <h2>Money</h2>
        <span class="t-xs t-muted">
          <%= money.invoices.map(function (invoice) { return invoice.invoice_number; }).join(', ') %><%
            %><% if (money.dueDate) { %> · due <%= money.dueDate %><% } %>
        </span>
      </div>
      <span class="badge badge--<%= money.state === 'Paid' ? 'ok' : money.state === 'Unpaid' ? 'warn' : 'info' %>">
        <%= money.state %>
      </span>
    </div>
    <div class="card-body">
      <div class="stat-strip">
        <div>
          <span class="stat-value"><%= helpers.money(money.totalMinor, money.currency) %></span>
          <span class="stat-label">invoiced</span>
        </div>
        <div>
          <span class="stat-value <%= money.paidMinor ? '' : 'stat-value--quiet' %>">
            <%= helpers.money(money.paidMinor, money.currency) %>
          </span>
          <span class="stat-label">paid</span>
        </div>
        <div>
          <span class="stat-value <%= money.outstandingMinor ? 'stat-value--warn' : 'stat-value--quiet' %>">
            <%= helpers.money(money.outstandingMinor, money.currency) %>
          </span>
          <span class="stat-label">still owed</span>
        </div>
        <% if (money.dueNowMinor) { %>
          <div>
            <span class="stat-value stat-value--warn"><%= helpers.money(money.dueNowMinor, money.currency) %></span>
            <span class="stat-label">due now</span>
          </div>
        <% } %>
      </div>
      <p class="hint">
        <strong><%= money.termsText %></strong>
        <span class="t-muted">(<%= money.terms.source %>)</span>
        <a href="/sales/customers/<%= order.customer.id %>#terms">Change</a>
      </p>

      <%
        /*
         * Asking them to pay, and the link once there is one.
         *
         * The link lives on the order because that is what it is for. It is
         * shown rather than hidden behind a send button so somebody can read
         * it, copy it, or put it in a message of their own — Foundry offering
         * to email it is a convenience, not the only route.
         */
        var requests = locals.paymentRequests || [];
        var live = requests.filter(function (rq) { return rq.status === 'OPEN' && rq.hostedUrl; })[0];
        var canAsk = (locals.paymentProviders || []).length > 0 && money.outstandingMinor > 0;
      %>
      <div id="pay-online">
        <% if (live) { %>
          <p class="hint">
            <strong><%= helpers.money(live.amountMinor, live.currency) %> asked for</strong>
            <%= live.purpose === 'DEPOSIT' ? 'as a deposit' : '' %> —
            <a href="<%= live.hostedUrl %>" target="_blank" rel="noopener noreferrer">the page they pay on</a>.
            Foundry updates this order by itself when they do; nobody has to check.
          </p>
          <form method="post" action="/sales/orders/<%= order.id %>/payment-request" class="inline-form">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <input type="hidden" name="requestId" value="<%= live.id %>">
            <button class="btn btn--ghost btn--sm" type="submit" name="action" value="void">
              Cancel that link
            </button>
          </form>
        <% } else if (canAsk) { %>
          <form method="post" action="/sales/orders/<%= order.id %>/payment-request" class="inline-form" data-busy>
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <% if (money.dueNowMinor) { %>
              <button class="btn btn--primary btn--sm" type="submit" name="purpose" value="DEPOSIT">
                Ask for the <%= helpers.money(money.dueNowMinor, money.currency) %> deposit
              </button>
            <% } %>
            <button class="btn btn--sm" type="submit" name="purpose" value="BALANCE">
              Ask for <%= helpers.money(money.outstandingMinor, money.currency) %>
            </button>
          </form>
          <p class="hint">
            Foundry creates the page they pay on and keeps the link here. It never sees a card number,
            and it learns they paid without anybody checking.
          </p>
        <% } %>
        <% if (requests.some(function (rq) { return rq.status === 'FAILED' || rq.lastError; })) { %>
          <% var trouble = requests.filter(function (rq) { return rq.lastError; })[0]; %>
          <p class="hint t-warn">Last attempt: <%= trouble.lastError %></p>
        <% } %>
      </div>
      <% if (money.outstandingMinor) { %>
        <%#
          Money that arrived in the room.

          The panel offered one route — a payment link — and a sentence
          suggesting you tell Foundry about anything else. But most of the
          money a small business takes arrives as cash, a cheque, a transfer,
          or a card machine on the counter, and none of that has a link. So the
          ordinary case gets an ordinary form, on the page where the balance
          is, going through exactly the same engine as everything else.
        %>
        <details class="disclosure take-payment" <%= money.dueNowMinor ? 'open' : '' %>>
          <summary>They paid me — record it</summary>
          <form method="post" action="/sales/orders/<%= order.id %>/payment" data-busy>
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <div class="card-body">
              <div class="field-row">
                <label class="field">
                  <span class="field-label">How much</span>
                  <div class="input-prefix">
                    <span>$</span>
                    <input class="input" type="number" name="amount" step="0.01" min="0.01"
                      value="<%= ((money.dueNowMinor || money.outstandingMinor) / 100).toFixed(2) %>" required>
                  </div>
                  <span class="field-hint">
                    <%= money.dueNowMinor ? 'The deposit that is due.' : 'The whole balance, or part of it.' %>
                  </span>
                </label>
                <label class="field">
                  <span class="field-label">How</span>
                  <select class="input" name="method">
                    <option value="cash">Cash</option>
                    <option value="card">Card machine</option>
                    <option value="bank transfer">Bank transfer</option>
                    <option value="cheque">Cheque</option>
                    <option value="other">Something else</option>
                  </select>
                </label>
                <label class="field">
                  <span class="field-label">When</span>
                  <input class="input" type="date" name="paymentDate" value="<%= helpers.dateInputValue(new Date()) %>">
                </label>
              </div>
              <label class="field">
                <span class="field-label">Reference <span class="t-muted">(optional)</span></span>
                <input class="input" type="text" name="reference" placeholder="Cheque number, or what the transfer said">
              </label>
            </div>
            <div class="card-foot">
              <button class="btn btn--primary" type="submit">Record this payment</button>
              <span class="hint">
                This settles the invoice and posts the receipt. It is the same record a card
                payment through the link makes, so nothing is entered twice.
              </span>
            </div>
          </form>
        </details>
      <% } %>
    </div>
  </div>
<% } %>

<div class="card">
  <div class="card-head"><h2>Order lines</h2></div>
  <%
    /*
     * Eight columns, minus the ones that are empty for every line.
     *
     * On a shipped order "Committed", "Short" and "Held at" are a zero, a zero
     * and a dash, repeated down the page — three columns of width spent saying
     * that nothing is outstanding, which the "Shipped" column already says.
     * A column earns its place by having something in it.
     */
    var showCommitted = order.lines.some(function (line) { return Number(line.allocated) > 0; });
    var showShort = order.lines.some(function (line) { return Number(line.backordered) > 0; });
    var showShipped = order.lines.some(function (line) { return Number(line.quantity_fulfilled) > 0; });
    var showHeldAt = order.lines.some(function (line) { return line.allocations.length > 0; });
  %>
  <div class="table-wrap"><table class="table table--stack sales-table"><thead><tr><th>Product</th><th>Ordered</th><th>Unit price</th><th>Line total</th><% if (showCommitted) { %><th class="num">Committed</th><% } %><% if (showShort) { %><th class="num">Short</th><% } %><% if (showShipped) { %><th class="num">Shipped</th><% } %><% if (showHeldAt) { %><th>Held at</th><% } %></tr></thead><tbody>
    <% order.lines.forEach(function(line){ %><tr><td class="cell-main"><strong><%= line.displayName %></strong><small><%= line.code %></small></td><td data-label="Ordered"><%= line.quantity_ordered %></td><td data-label="Unit price"><%= line.unit_price_minor === null ? 'Price not set' : helpers.money(line.unit_price_minor, order.currency) %></td><td data-label="Line total"><%= line.lineTotalMinor === null ? '—' : helpers.money(line.lineTotalMinor, order.currency) %></td><% if (showCommitted) { %><td class="num" data-label="Committed"><%= line.allocated %></td><% } %><% if (showShort) { %><td class="num" data-label="Short"><% if (line.backordered) { %><strong class="is-warn"><%= line.backordered %></strong><% } else { %><span class="t-muted">—</span><% } %></td><% } %><% if (showShipped) { %><td class="num" data-label="Shipped"><%= line.quantity_fulfilled %></td><% } %><% if (showHeldAt) { %><td data-label="Held at"><% if (!line.allocations.length) { %>—<% } else { line.allocations.forEach(function(a){ %><span class="pill"><%= a.location_name %> <strong><%= a.quantity %></strong></span><% }) } %></td><% } %></tr><% }) %>
  </tbody></table></div>
  <div class="sales-total-block">
    <div><span>Subtotal</span><strong><%= helpers.money(order.pricing.subtotalMinor, order.currency) %></strong></div>
    <% if (order.pricing.discountMinor) { %><div><span>Discount</span><strong>−<%= helpers.money(order.pricing.discountMinor, order.currency) %></strong></div><% } %>
    <% if (order.pricing.taxMinor) { %><div><span>Tax</span><strong><%= helpers.money(order.pricing.taxMinor, order.currency) %></strong></div><% } %>
    <div class="sales-total"><span>Order total</span><strong><%= helpers.money(order.pricing.totalMinor, order.currency) %></strong></div>
  </div>
  <% if (order.pricing.missingPriceLines) { %><div class="notice notice--warn"><strong>This draft cannot be confirmed yet.</strong> <%= order.pricing.missingPriceLines %> line<%= order.pricing.missingPriceLines === 1 ? '' : 's' %> has no selling price. <% order.lines.filter(function(line){ return line.unit_price_minor === null; }).forEach(function(line){ %><a href="/inventory/<%= line.item_id %>#selling-price">Set the price for <%= line.displayName %></a>. <% }) %></div><% } %>
</div>

<% if (!['FULFILLED','CANCELLED'].includes(order.status)) { %>
  <details class="card advanced-settings sales-secondary-actions" style="margin-top:16px;"><summary><strong>Change or cancel this order</strong><span class="hint">Optional</span></summary><div class="card-body grid grid--2">
    <form class="sales-action-card" method="post" action="/sales/orders/<%= order.id %>/lines"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="idempotencyKey" value="web-line:<%= order.id %>:<%= order.version %>"><h2>Add another product</h2><p>Foundry will recalculate what can be held.</p><label class="field"><span>Product</span><select name="skuId" required><option value="">Choose a product</option><% skus.forEach(function(s){ %><option value="<%= s.id %>"><%= s.display_name %> · <%= s.code %> · <%= s.price.isSet ? s.price.formatted : 'Price not set' %></option><% }) %></select></label><label class="field"><span>Quantity</span><input type="number" name="quantity" min="1" required></label><label class="field"><span>Selling price <small>only if not set in Inventory</small></span><input name="unitPrice" inputmode="decimal" placeholder="0.00"></label><button class="btn" type="submit">Add product</button></form>
    <form class="sales-action-card" method="post" action="/sales/orders/<%= order.id %>/cancel"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><h2>Cancel what has not shipped</h2><p>Held stock is released. Anything already shipped remains in history.</p><label class="field"><span>Reason <small>optional</small></span><input name="reason"></label><button class="btn btn--danger" type="submit">Cancel unshipped remainder</button></form>
  </div></details>
<% } %>

<% var eventLabels = { CREATED: 'Order created', CONFIRMED: 'Customer order confirmed and stock checked', CHANGED: 'Order changed and reservations recalculated', ALLOCATION_CHANGED: 'Stock reservation updated automatically', PARTIALLY_FULFILLED: 'Part of the order shipped', FULFILLED: 'Order shipped in full', ALLOCATED_FROM_STOCK: 'Stock that arrived was committed to this customer', CANCELLED: 'Remaining order cancelled' }; %>
<div class="card order-activity" style="margin-top:16px;"><div class="card-head"><h2>Order activity</h2></div><div class="list-rows"><% order.events.slice().reverse().forEach(function(event){ %><div class="list-row"><span><strong><%= eventLabels[event.event_type] || event.event_type.replace(/_/g,' ').toLowerCase() %></strong><small><%= event.actor_name || 'Foundry' %> · <%= helpers.dateTime(event.created_at) %></small></span></div><% }) %></div></div>
