<%
  var statusLabels = { DRAFT: 'Being prepared', CONFIRMED: 'Confirmed — stock held',
    BACKORDERED: 'Confirmed — waiting for stock', PARTIALLY_FULFILLED: 'Partly gone',
    FULFILLED: (locals.goneWord === 'shipped' ? 'Shipped'
      : locals.goneWord === 'collected' ? 'Collected'
      : locals.goneWord === 'delivered' ? 'Delivered' : 'Gone'),
    CANCELLED: 'Cancelled' };
  var setupRequired = Boolean(order.customer_decision_required || order.delivery_decision_required);
  var currentStep = order.status === 'DRAFT' ? 1
    : ['CONFIRMED','BACKORDERED'].includes(order.status) ? 2
      : order.status === 'PARTIALLY_FULFILLED' ? 3 : 4;

  /*
   * How much has actually gone.
   *
   * Declared at the top because it is read further up the page than it used
   * to be. The shortfall notice moved above the old declaration and read it
   * as undefined, so a page recording that thirty-four units shipped also
   * said "nothing was shipped" — the exact bug the comment on that notice
   * was written to record the first time.
   *
   * Reassuring somebody that nothing moved, on the screen recording that
   * something moved, undermines every other number on the page.
   */
  var shipped = order.totals.fulfilled || 0;
%>
<div class="breadcrumb"><a href="/orders">Orders</a> <%- helpers.icon('chevron', { size: 13 }) %> <span><%= order.order_number %></span></div>
<div class="page-head"><div class="titles"><p class="eyebrow">Customer order</p><h1><%= order.order_number %> · <%= order.customer.name %></h1><p>Created <%= order.order_date %><%= order.needed_by ? ' · customer needs it by ' + order.needed_by : '' %></p></div><span class="badge <%= setupRequired || order.status === 'BACKORDERED' ? 'badge--warn' : order.status === 'FULFILLED' ? 'badge--success' : 'badge--muted' %>"><%= setupRequired ? 'Waiting for customer details' : (statusLabels[order.status] || order.status) %></span></div>

<% if (money.invoiced && (money.heldReason.pick || money.heldReason.ship)) { %>
  <div class="notice notice--<%= money.override ? 'info' : 'warn' %>" id="payment-hold">
    <div>
      <% if (money.override) { %>
        <strong>You let this one through unpaid.</strong><br>
        <%= money.heldReason.ship || money.heldReason.pick %>
        <% if (money.override.reason) { %><br><em><%= money.override.reason %></em><% } %>
        <form method="post" action="/sales/orders/<%= order.id %>/payment-hold" class="inline-form" style="margin-top:8px;">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <button class="btn btn--ghost btn--sm" type="submit" name="action" value="restore">Put the hold back</button>
        </form>
      <% } else { %>
        <strong><%= money.blocksPicking ? 'This order is on hold until it is paid.' : 'This order cannot ship until it is paid.' %></strong><br>
        <%= money.heldReason.pick || money.heldReason.ship %>
        <span class="t-xs t-muted">(<%= money.termsText %> — <%= money.terms.source %>.)</span>
        <details class="disclosure" style="margin-top:10px;">
          <summary>Let this one order through anyway</summary>
          <div class="card-body">
            <form method="post" action="/sales/orders/<%= order.id %>/payment-hold" data-busy>
              <input type="hidden" name="_csrf" value="<%= csrfToken %>">
              <label class="field">
                <span class="field-label">Why <span class="t-muted">(optional)</span></span>
                <input class="input" type="text" name="reason" placeholder="Long-standing customer, I called them">
              </label>
              <button class="btn" type="submit" name="action" value="override">Approve this order to go unpaid</button>
              <p class="hint">
                This lifts the hold for this order only, and keeps a note that you did.
                Their terms are unchanged.
              </p>
            </form>
          </div>
        </details>
      <% } %>
    </div>
  </div>
<% } %>


<%#
  Why before what.

  This explanation sat below "Do this next: record the items as shipped", so
  the page offered to ship an order before mentioning that four fifths of it
  was missing. Same order the payment hold uses: state the situation, then
  offer the thing to do about it.
%>
<% if (order.status !== 'DRAFT' && order.totals.backordered) { %><div class="notice notice--warn sales-outcome" id="stock-shortage">
  <strong><%= order.totals.backordered %> unit<%= order.totals.backordered === 1 ? '' : 's' %> still short.</strong>
  <%
    // Stock is allocated when an order is confirmed and not again, so a
    // delivery can arrive against this very shortfall and the order still says
    // the stock is not there. Sixty units in the store room and an order
    // reading "the rest is not in stock yet" is a straightforward untruth.
    var available = locals.shortButAvailable || 0;
  %>
  <% if (shipped) { %>
    <p><%= shipped %> unit<%= shipped === 1 ? '' : 's' %> <%= locals.goneWord || 'gone' %> and
      <%= order.totals.allocated %> held for this customer.
      <% if (available) { %>
        <%= available %> <%= available === 1 ? 'is' : 'are' %> on the shelf now and not committed to
        anyone.
      <% } else { %>
        The rest is not in stock yet.
      <% } %></p>
  <% } else { %>
    <p>The customer order is confirmed, but Foundry found only <%= order.totals.allocated %> unit<%= order.totals.allocated === 1 ? '' : 's' %> available to hold. <strong>No on-hand stock changed and nothing was shipped.</strong></p>
  <% } %>
  <p>Foundry checked stock at every location. Use the exact action below to cover what is missing.</p>
</div><% } %>

<%#
  An order Foundry prepared has to show its source before it shows its
  contents. Approving a draft is a decision about whether Foundry read the
  customer correctly, and that decision cannot be made against a form — it is
  made against what the customer actually wrote, which is therefore here.
%>
<% if (locals.cameFromEmail && (order.status === 'DRAFT' || setupRequired)) { %>
  <div class="card sales-action-card">
    <p class="eyebrow">Foundry prepared this</p>
    <h2>Read from an email from <%= cameFromEmail.sender %></h2>
    <% if (cameFromEmail.subject) { %><p><strong>Subject:</strong> <%= cameFromEmail.subject %></p><% } %>
    <% if (cameFromEmail.body_text) { %>
      <blockquote class="quoted-source"><%= cameFromEmail.body_text %></blockquote>
    <% } %>
    <p><%= order.status === 'DRAFT' ? 'Nothing has been committed.' : 'Stock may already be held, but nothing can leave until the customer and delivery details below are resolved.' %> Check the products and quantities against what they wrote.</p>
    <a class="btn btn--sm" href="/mail/<%= cameFromEmail.id %>">Open the original message</a>
  </div>
<% } else if (locals.cameFromEmail) { %>
  <%#
    Once the order is confirmed the email is provenance, not a decision. The
    full quote, and a sentence telling the owner to confirm what they have
    just confirmed, were a screen of text above the thing they came to do.
  %>
  <details class="card sales-action-card">
    <summary><strong>Came in by email from <%= cameFromEmail.sender %></strong> <span class="hint">what they wrote</span></summary>
    <% if (cameFromEmail.subject) { %><p><strong>Subject:</strong> <%= cameFromEmail.subject %></p><% } %>
    <% if (cameFromEmail.body_text) { %><blockquote class="quoted-source"><%= cameFromEmail.body_text %></blockquote><% } %>
    <a class="btn btn--sm" href="/mail/<%= cameFromEmail.id %>">Open the original message</a>
  </details>
<% } %>

<% if (order.customer_decision_required) { %>
  <div class="card sales-action-card sales-primary-action" id="customer-decision">
    <p class="eyebrow">Do this next — 1 of <%= order.delivery_decision_required ? '2' : '1' %></p>
    <h2>Is this a new customer?</h2>
    <p><strong><%= cameFromEmail.sender %></strong> does not match any confirmed customer in Foundry. Foundry kept the order, but did not silently trust or merge the sender.</p>
    <div class="form-actions">
      <form method="post" action="/sales/orders/<%= order.id %>/resolve-customer">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <input type="hidden" name="action" value="create">
        <button class="btn btn--primary" type="submit">Create <%= order.customer.name %> as a customer</button>
      </form>
    </div>
    <% if ((locals.customers || []).length) { %>
      <details class="disclosure" style="margin-top:12px">
        <summary>This sender is an existing customer</summary>
        <form method="post" action="/sales/orders/<%= order.id %>/resolve-customer" class="form-actions" style="margin-top:12px">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <input type="hidden" name="action" value="match">
          <label class="field"><span>Match this order to</span><select name="customerId" required><option value="">Choose the existing customer</option><% customers.forEach(function (customer) { %><option value="<%= customer.id %>"><%= customer.name %><%= customer.email ? ' · ' + customer.email : '' %></option><% }) %></select></label>
          <button class="btn" type="submit">Match customer and continue</button>
        </form>
      </details>
    <% } %>
  </div>
<% } else if (order.delivery_decision_required) { %>
  <form class="card sales-action-card sales-primary-action" id="delivery-decision" method="post" action="/sales/orders/<%= order.id %>/resolve-delivery">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <p class="eyebrow">Do this next</p>
    <h2>Where should this order go?</h2>
    <% if (cameFromEmail && cameFromEmail.reply_sent_at) { %>
      <p><strong>Foundry already emailed <%= cameFromEmail.sender %></strong> asking for a full shipping address or pickup. The order is waiting for their answer; you can also enter it here if they tell you another way.</p>
    <% } else if (cameFromEmail && cameFromEmail.draft_at) { %>
      <p>Foundry wrote the exact question to ask, but the mailbox could not send it automatically. <a href="/mail/<%= cameFromEmail.id %>">Open the email and send it</a>, or enter the answer here.</p>
    <% } else { %>
      <p><%= cameFromEmail ? 'The email did not provide a usable destination.' : 'Choose how the customer will receive this order.' %> Nothing can ship until this is answered.</p>
    <% } %>
    <fieldset class="ship-method">
      <legend>How will the customer receive it?</legend>
      <label class="choice"><input type="radio" name="deliveryMethod" value="SHIP" required checked><span>Ship to this address</span></label>
      <label class="choice"><input type="radio" name="deliveryMethod" value="PICKUP" required><span>Customer pickup</span></label>
    </fieldset>
    <label class="field"><span>Full delivery address</span><textarea name="shippingAddress" rows="3" placeholder="Street, town, state, postcode"><%= order.ship_to_address || '' %></textarea><small>Not needed for pickup.</small></label>
    <label class="choice"><input type="checkbox" name="saveCustomerAddress" value="1"><span>Use this as the customer's default next time</span></label>
    <button class="btn btn--primary" type="submit">Save delivery choice and continue</button>
  </form>
<% } %>

<% if (setupRequired) { %>
  <details class="panel section fold">
    <summary class="panel-head"><div><h2>What they ordered</h2><span class="t-xs t-muted"><%= order.lines.length %> product<%= order.lines.length === 1 ? '' : 's' %> · nothing can leave yet</span></div></summary>
    <div class="card-body"><% order.lines.forEach(function (line) { %><p><strong><%= line.quantity_ordered %> × <%= line.displayName %></strong><% if (line.unit_price_minor !== null) { %> · <%= helpers.money(line.lineTotalMinor, order.currency) %><% } %></p><% }) %></div>
  </details>
<% } else { %>

<% if (order.status === 'DRAFT' && !order.pricing.missingPriceLines) { %>
  <form class="card sales-action-card sales-primary-action" id="approve-order" method="post" action="/sales/orders/<%= order.id %>/confirm">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <p class="eyebrow">Do this next</p><h2>Confirm this order and reserve stock</h2>
    <p>This is the only action needed now. Foundry will hold available stock for <%= order.customer.name %>; physical on-hand and Accounting remain unchanged until shipment.</p>
    <button class="btn btn--primary" type="submit">Confirm order and reserve stock</button>
  </form>
<% } else if (order.status === 'DRAFT') { %>
  <%#
    The approval and the missing number, in one place.

    A draft whose product has no selling price used to show a warning and no
    button, with the price link far down the page — and the owner, sent here
    by Needs you to approve an order, found nothing to press. Foundry will not
    invent a price; it asks for it here, where the decision is being made, and
    confirms in the same step.
  %>
  <form class="card sales-action-card sales-primary-action" id="approve-order" method="post" action="/sales/orders/<%= order.id %>/confirm">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <p class="eyebrow">Do this next</p><h2>Give the selling price, then confirm this order</h2>
    <p>Foundry has no selling price on file for <%= order.pricing.missingPriceLines === 1 ? 'this product' : 'these products' %>, and it will not treat a blank as zero. Enter what you charge and the order is confirmed in the same step — the price is kept for next time.</p>
    <% order.lines.filter(function (line) { return line.unit_price_minor === null; }).forEach(function (line) { %>
      <label class="field">
        <span class="field-label">Selling price for <%= line.displayName %> (<%= order.currency %>, per <%= line.unit_label || 'unit' %>)</span>
        <input class="input" name="price[<%= line.sku_id %>]" inputmode="decimal" placeholder="0.00" required>
      </label>
    <% }) %>
    <button class="btn btn--primary" type="submit">Set price and confirm order</button>
  </form>
<% } else if (!['FULFILLED','CANCELLED'].includes(order.status) && locals.shortButAvailable) { %>
  <form class="card sales-action-card sales-action-card--commit sales-primary-action" method="post" action="/sales/orders/<%= order.id %>/allocate">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <input type="hidden" name="idempotencyKey" value="web-allocate:<%= order.id %>:<%= order.version %>">
    <p class="eyebrow">Do this next</p><h2>Reserve the stock that is now available</h2>
    <p><%= locals.shortButAvailable %> unit<%= locals.shortButAvailable === 1 ? ' is' : 's are' %> free now. Reserving keeps it for <%= order.customer.name %>; nothing ships yet.</p>
    <button class="btn btn--primary" type="submit">Reserve <%= locals.shortButAvailable %> for <%= order.customer.name %></button>
  </form>
<% } else if (!['FULFILLED','CANCELLED'].includes(order.status) && order.totals.backordered) { %>
  <div class="card sales-action-card sales-primary-action">
    <p class="eyebrow">Do this next</p>
    <h2>Cover the <%= order.totals.backordered %> missing unit<%= order.totals.backordered === 1 ? '' : 's' %></h2>
    <p>The order is saved.<% if (shipped) { %> The <%= shipped %> already <%= locals.goneWord || 'gone' %> will not be changed.<% } else { %> The available stock is held and nothing was shipped.<% } %> Choose the exact missing product below to arrange replenishment.</p>
    <% (locals.shortageDetails || []).forEach(function (line) { %>
      <div class="list-row">
        <div><strong><%= line.displayName %></strong><br><span class="hint"><%= line.missing %> still needed</span></div>
        <a class="btn btn--primary btn--sm" href="<%= line.actionHref %>"><%= line.actionLabel %></a>
      </div>
    <% }) %>
  </div>
<% } else if (locals.money && (money.blocksPicking || money.blocksShipping)) { %>
  <%#
    Offering "record the items as shipped" on an order the engine will refuse
    to ship is the page telling somebody to do the one thing they cannot. The
    hold above already says what is wanted; this says what to do about it.
  %>
  <div class="card sales-action-card sales-primary-action">
    <p class="eyebrow">Do this next</p>
    <h2>Get the <%= helpers.money(money.dueNowMinor || money.outstandingMinor, money.currency) %></h2>
    <p>
      <% if (money.blocksPicking) { %>
        Nothing is picked or shipped for <%= order.customer.name %> until this arrives.
      <% } else { %>
        <%= order.customer.name %> can have this picked and packed, but it does not leave
        until the balance is settled.
      <% } %>
      Ask them to pay from the money panel below, or approve this one order to go without.
    </p>
    <a class="btn btn--primary" href="#payment-hold">Settle the hold</a>
  </div>
<% } else if (!['FULFILLED','CANCELLED'].includes(order.status) && (locals.shipments || [])
    .some(function (box) { return box.status === 'PICKING' || box.status === 'PACKED'; })) { %>
  <%
    /*
     * A box is already open on this order, so the direct "record it as
     * shipped" form stands down. Both do the same thing to the same stock,
     * and using this one would leave the box holding a claim on units that
     * had already gone - a shipment stuck being picked forever.
     */
    var openBox = (locals.shipments || []).filter(function (box) {
      return box.status === 'PICKING' || box.status === 'PACKED';
    })[0];
  %>
  <div class="card sales-action-card sales-primary-action">
    <p class="eyebrow">Do this next</p>
    <h2><%= openBox.status === 'PICKING' ? 'Finish picking' : 'Hand it to the carrier' %></h2>
    <p>
      <%= openBox.shipment_number %> already holds <%= openBox.units %>
      <%= openBox.units === 1 ? 'unit' : 'units' %> of this order. Ship it from there, so what
      leaves stock is exactly what went in the box.
    </p>
    <a class="btn btn--primary" href="/fulfilment/<%= openBox.id %>">Open <%= openBox.shipment_number %></a>
  </div>
<% } else if (!['FULFILLED','CANCELLED'].includes(order.status) && order.totals.allocated > 0) { %>
  <form class="card sales-action-card sales-primary-action" method="post" action="/sales/orders/<%= order.id %>/fulfill">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <input type="hidden" name="idempotencyKey" value="web-fulfill:<%= order.id %>:<%= order.version %>">
    <p class="eyebrow">Do this next</p><h2>Record what physically left</h2>
    <p>Only use this when the items physically leave. Foundry will reduce on-hand once and update Accounting automatically.</p>
    <% order.lines.forEach(function(line){ line.allocations.forEach(function(a){ %><div class="form-row"><input type="hidden" name="lineId" value="<%= line.id %>"><input type="hidden" name="locationId" value="<%= a.location_id %>"><label class="field"><span><%= line.displayName %> from <%= a.location_name %> (maximum <%= a.quantity %>)</span><input type="number" name="quantity" min="0" max="<%= a.quantity %>" value="<%= a.quantity %>"></label></div><% }) }) %>
    <%#
      Where it is going, and how.

      This form moved the stock and asked nothing else, so an order could be
      shipped with no destination and no way to follow it — and the page had no
      answer when somebody asked where it went. Both are optional, because a
      customer collecting from the counter needs neither, but they are asked.
    %>
    <%#
      How these goods left, asked before anything is claimed about them.

      There is no default and no pre-selected option on purpose. This form used
      to move the stock on one click and then report the order as "shipped" —
      shipped by whom, to where, nobody had said. The question is three
      buttons wide and it makes the record true.
    %>
    <fieldset class="ship-method">
      <legend>How did these goods leave?</legend>
      <% [['CARRIER','Sent by carrier'],['COLLECTED','Collected by the customer'],['DELIVERED_BY_US','Delivered by us']].forEach(function (choice) { %>
        <label class="choice">
          <input type="radio" name="handover" value="<%= choice[0] %>" required>
          <span><%= choice[1] %></span>
        </label>
      <% }) %>
    </fieldset>
    <div class="ship-details">
      <label class="field">
        <span>Carrier <small>optional</small></span>
        <select name="carrier">
          <option value="">Work it out from the tracking number</option>
          <% (locals.carriers || []).forEach(function (carrier) { %>
            <option value="<%= carrier.code %>"><%= carrier.name %></option>
          <% }) %>
        </select>
      </label>
      <label class="field">
        <span>Tracking number <small>optional</small></span>
        <input name="trackingNumber" placeholder="Paste or scan it" autocomplete="off">
        <small>Becomes a link the customer can follow.</small>
      </label>
    </div>
    <% if (order.delivery_method !== 'PICKUP' && !order.ship_to_address) { %>
      <p class="hint">
        This Sales Order has no delivery address, so Foundry cannot prepare a carrier label.
        The customer's profile is only a default; the order needs its own confirmed destination.
      </p>
    <% } %>
    <button class="btn btn--primary" type="submit">Record these goods as gone</button>
  </form>
<% } %>

<%#
  The same four figures, minus the ones that are only ever zero at this stage.
  A finished order showing "0 committed, 0 waiting for stock" is three-quarters
  of a table saying nothing happened, next to the one number that matters.
%>
<div class="stats-row">
  <div class="stat"><strong><%= order.totals.ordered %></strong><span>Units ordered</span></div>
  <% if (order.totals.allocated) { %>
    <div class="stat"><strong><%= order.totals.allocated %></strong><span>committed to this customer</span></div>
  <% } %>
  <% if (order.totals.backordered) { %>
    <div class="stat"><strong class="is-warn"><%= order.totals.backordered %></strong><span><%= order.status === 'DRAFT' ? 'not committed yet' : 'waiting for stock' %></span></div>
  <% } %>
  <% if (order.totals.fulfilled || order.totals.ordered === order.totals.fulfilled) { %>
    <div class="stat"><strong><%= order.totals.fulfilled %></strong><span><%= locals.goneWord || 'gone' %></span></div>
  <% } %>
</div>

<% if (order.status === 'FULFILLED' || order.status === 'PARTIALLY_FULFILLED') { %>
  <% if (accounting.status === 'POSTED') { %>
    <details class="card fold">
      <summary class="card-head">
        <h2>Accounting updated automatically.</h2>
        <span class="spacer"></span><span class="fold-note">nothing for you to do</span>
      </summary>
      <div class="card-body">
        <p>Revenue, the customer receivable, product cost, and inventory value were posted from this shipment.</p>
        <a class="btn btn--sm" href="/accounting/entries/<%= accounting.journal_entry_id %>">See entry #<%= accounting.entry_number %></a>
      </div>
    </details>
  <% } else if (accounting.status === 'NEEDS_REVIEW' || accounting.status === 'FAILED') { %>
    <div class="notice notice--warning"><div><strong>The shipment is complete, but Accounting still needs one decision.</strong><br><%= accounting.outcome.message || accounting.error_message %> Stock will not be changed again.</div><a class="btn btn--primary btn--sm" href="/accounting/review/<%= accounting.id %>">Review exact amounts</a></div>
  <% } else if (accounting.status === 'WAITING') { %>
    <div class="notice"><strong>Accounting is processing this shipment.</strong> Refresh once if this remains here.</div>
  <% } else { %>
    <div class="notice"><strong>Accounting is not active.</strong> The Sales Order and inventory are complete; no financial entry was created.</div>
  <% } %>
<% } %>





<%
  /*
   * Where this order physically stands, and the one thing to do about it.
   *
   * The order already had quantities: ordered, committed, short, shipped.
   * What it never had was a word for the state a person actually asks about —
   * "has it gone out yet?" — and a way to start the box. Both live here, and
   * both are derived, so this panel cannot disagree with the shipments below it.
   */
  var fulfilment = locals.fulfilment || null;
  var boxes = locals.shipments || [];
  var free = locals.pickable || [];
  var freeUnits = free.reduce(function (sum, row) { return sum + row.available; }, 0);
%>
<% if (fulfilment && order.status !== 'DRAFT') { %>
  <details class="panel section fold" id="fulfilment">
    <summary class="panel-head">
      <div>
        <h2>Fulfilment</h2>
        <span class="t-xs t-muted">
          <% if (locals.money && money.blocksPicking) { %>Waiting on payment
          <% } else if (fulfilment.detail) { %><%= fulfilment.detail %><% } else { %>
            <%= boxes.length %> <%= boxes.length === 1 ? 'shipment' : 'shipments' %>
          <% } %>
        </span>
      </div>
      <span class="spacer"></span>
      <%
        /*
         * Money outranks stock in this word. An order with everything on the
         * shelf is not "ready to pick" when picking it would be refused, and a
         * badge saying so beside a sentence saying the opposite is the kind of
         * thing that makes somebody stop believing the screen.
         */
        var fulfilmentWord = (locals.money && money.blocksPicking && fulfilment.state === 'Ready to pick')
          ? 'Held until paid' : (fulfilment.label || fulfilment.state);
      %>
      <span class="badge badge--<%= ['Shipped', 'Delivered'].indexOf(fulfilmentWord) >= 0 ? 'ok'
        : ['Waiting for stock', 'Held until paid'].indexOf(fulfilmentWord) >= 0 ? 'warn'
        : 'info' %>"><%= fulfilmentWord %></span>
    </summary>

    <% if (boxes.length) { %>
      <table class="table">
        <thead>
          <%#
            "Where" is the first thing anybody asks of a shipment, and the
            order page could not answer it: a row saying "Shipped" and a dash
            for tracking, with the destination nowhere on the page. When
            Foundry has no address it says so here rather than leaving the
            question hanging.
          %>
          <tr><th>Shipment</th><th class="num">Units</th><th>State</th><th>How it went</th><th>Tracking</th><th>Customer told</th></tr>
        </thead>
        <tbody>
          <% boxes.forEach(function (box) { %>
            <tr>
              <td><a href="/fulfilment/<%= box.id %>"><strong><%= box.shipment_number %></strong></a></td>
              <td class="num"><%= box.units %></td>
              <td>
                <%#
                  The state, and then how it actually left.

                  "Shipped" alone was a claim Foundry could not back: a box the
                  customer carried out themselves said "Shipped" and offered an
                  address nobody had entered.
                %>
                <%= { PICKING: 'Being picked', PACKED: 'Packed', SHIPPED: 'Gone',
                      DELIVERED: 'Delivered', CANCELLED: 'Cancelled' }[box.status] %>
                <% if (box.shipped_at) { %>
                  <span class="t-xs t-muted">· <%= helpers.shortDate(box.shipped_at) %></span>
                <% } %>
              </td>
              <td>
                <% if (box.wentBy) { %>
                  <span class="cell-sub"><%= box.wentBy %></span>
                <% } %>
                <% if (box.handover !== 'COLLECTED' && box.ship_to_address) { %>
                  <span class="cell-sub"><%= String(box.ship_to_address).split('\n')[0] %></span>
                <% } else if (box.handover !== 'COLLECTED' && !box.wentBy) { %>
                  <span class="t-warn">No delivery address on this order</span>
                <% } %>
              </td>
              <td>
                <% if (box.tracking_number && box.trackingUrl) { %>
                  <a href="<%= box.trackingUrl %>" target="_blank" rel="noopener noreferrer"><%= box.tracking_number %></a>
                <% } else if (box.tracking_number) { %>
                  <%= box.tracking_number %>
                <% } else { %><span class="t-muted">—</span><% } %>
              </td>
              <td>
                <%
                  var told = (locals.customerNotices || [])
                    .filter(function (note) { return note.shipmentId === box.id; })[0];
                %>
                <% if (!told) { %>
                  <span class="t-muted">—</span>
                <% } else if (told.status === 'SENT') { %>
                  <span class="t-ok">Sent <%= helpers.shortDate(told.sentAt) %></span>
                <% } else if (told.status === 'CANCELLED') { %>
                  <span class="t-muted">Not sending</span>
                <% } else { %>
                  <a href="/fulfilment/<%= box.id %>">Written, not sent</a>
                <% } %>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    <% } %>

    <% if (freeUnits && locals.money && money.blocksPicking) { %>
      <div class="card-body">
        <p class="hint">
          <%= freeUnits %> <%= freeUnits === 1 ? 'unit is' : 'units are' %> committed and ready,
          but this order is held until it is paid. Picking it is refused until then.
        </p>
      </div>
    <% } else if (freeUnits) { %>
      <div class="card-foot">
        <form method="post" action="/sales/orders/<%= order.id %>/pick" data-busy>
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <button class="btn btn--primary" type="submit">
            Start picking <%= freeUnits %> <%= freeUnits === 1 ? 'unit' : 'units' %>
          </button>
          <span class="hint">
            This opens a box and a pick list. Nothing leaves stock until you mark it shipped.
          </span>
        </form>
      </div>
    <% } else if (fulfilment.state === 'Waiting for stock') { %>
      <div class="card-body">
        <p class="hint">
          There is nothing to pick because nothing is committed to this order yet.
          Commit stock above, or wait for the delivery it is short against.
        </p>
      </div>
    <% } %>
  </details>
<% } %>

<%
  /*
   * What the customer owes.
   *
   * The order carried quantities and no money: ordered, committed, short,
   * shipped, and nothing about whether it had been paid for. The invoice
   * already knew — it is linked to this order — so the figures were a query
   * away and the page simply never asked.
   *
   * It appears once there is an invoice. Before that there is nothing owed,
   * and a row of zeroes would only look like a debt of nothing.
   */
  var money = locals.money || { invoiced: false };
%>
<% if (money.invoiced) { %>
  <%
    var completedReceipt = (locals.customerReceipts || []).slice(-1)[0];
    var completedRequest = (locals.paymentRequests || []).filter(function (rq) {
      return rq.status === 'PAID' && rq.hostedUrl;
    })[0];
  %>
  <% if (locals.paymentCompleted) { %>
    <div class="notice notice--ok section" role="status">
      <div>
        <strong>Payment completed and recorded on <%= order.order_number %>.</strong>
        <span>Foundry updated what the customer owes. You can print either document now.</span>
      </div>
      <div class="actions">
        <% if (completedReceipt) { %>
          <a class="btn btn--primary" href="/orders/<%= order.id %>/receipt/<%= completedReceipt.id %>">Print receipt</a>
        <% } %>
        <% if (completedRequest) { %>
          <a class="btn" href="<%= completedRequest.hostedUrl %>" target="_blank" rel="noopener noreferrer">View or print Stripe invoice</a>
        <% } %>
      </div>
    </div>
  <% } %>
  <details class="panel section fold" id="money"<% if (locals.paymentCompleted) { %> open<% } %>>
    <summary class="panel-head">
      <div>
        <h2>Money<%= money.outstandingMinor
          ? ' — ' + helpers.money(money.outstandingMinor, money.currency) + ' still owed'
          : '' %></h2>
        <span class="t-xs t-muted">
          <%= money.invoices.map(function (invoice) { return invoice.invoice_number; }).join(', ') %><%
            %><% if (money.dueDate) { %> · due <%= money.dueDate %><% } %>
        </span>
      </div>
      <span class="spacer"></span>
      <span class="badge badge--<%= money.state === 'Paid' ? 'ok' : money.state === 'Unpaid' ? 'warn' : 'info' %>">
        <%= money.state %>
      </span>
    </summary>
    <div class="card-body">
      <div class="stat-strip">
        <div>
          <span class="stat-value"><%= helpers.money(money.totalMinor, money.currency) %></span>
          <%#
            Before the invoice exists this is what the order is worth, not what
            anybody has been billed. Calling it "invoiced" would be Foundry
            stating a document that does not exist.
          %>
          <span class="stat-label"><%= money.hasInvoice ? 'invoiced' : 'order value' %></span>
        </div>
        <div>
          <span class="stat-value <%= money.paidMinor ? '' : 'stat-value--quiet' %>">
            <%= helpers.money(money.paidMinor, money.currency) %>
          </span>
          <span class="stat-label">paid</span>
        </div>
        <div>
          <span class="stat-value <%= money.outstandingMinor ? 'stat-value--warn' : 'stat-value--quiet' %>">
            <%= helpers.money(money.outstandingMinor, money.currency) %>
          </span>
          <span class="stat-label">still owed</span>
        </div>
        <% if (money.dueNowMinor) { %>
          <div>
            <span class="stat-value stat-value--warn"><%= helpers.money(money.dueNowMinor, money.currency) %></span>
            <span class="stat-label">due now</span>
          </div>
        <% } %>
      </div>
      <%
        /*
         * What was actually taken, and something to hand the customer.
         *
         * A payment that has been recorded and cannot be printed is a payment
         * the person at the counter has to describe from memory.
         */
        var receipts = (locals.customerReceipts || []);
      %>
      <% if (receipts.length) { %>
        <div class="pay-receipts">
          <% receipts.forEach(function (receipt) { %>
            <p class="hint">
              <strong><%= helpers.money(receipt.amount_minor, order.currency) %></strong>
              received <%= helpers.shortDate(receipt.payment_date) %><%= receipt.method ? ' by ' + receipt.method.replace(/_/g, ' ') : '' %>.
              <a href="/orders/<%= order.id %>/receipt/<%= receipt.id %>">Print receipt <%= receipt.payment_number %></a>
            </p>
          <% }) %>
          <% if (completedRequest) { %>
            <p class="hint">
              <a href="<%= completedRequest.hostedUrl %>" target="_blank" rel="noopener noreferrer">View or print the Stripe invoice</a>
            </p>
          <% } %>
        </div>
      <% } %>
      <p class="hint">
        <strong><%= money.termsText %></strong>
        <span class="t-muted">(<%= money.terms.source %>)</span>
        <a href="/sales/customers/<%= order.customer.id %>#terms">Change</a>
      </p>

      <%
        /*
         * Three ways money actually arrives, in the order a shop reaches for
         * them.
         *
         * Take payment is first because most of the time the customer is
         * standing there or on the phone, and the merchant wants to charge
         * them now. Sending a link is the remote version of the same thing.
         * Recording a payment that already happened is the third, and it is
         * secondary because it is bookkeeping rather than collecting.
         *
         * None of this waits for a shipment. A deposit before anything is
         * picked, a part payment mid-order and a balance after delivery are
         * all the same act — asking for what the terms say is due now — and
         * the amount comes from the payment position rather than from here.
         */
        var requests = locals.paymentRequests || [];
        var live = requests.filter(function (rq) { return rq.status === 'OPEN' && rq.hostedUrl; })[0];
        var owed = money.outstandingMinor;
        var askable = (locals.paymentProviders || []).length > 0 && owed > 0;
        var dueNow = money.dueNowMinor || 0;
        var askFor = dueNow && dueNow < owed ? dueNow : owed;
        var askPurpose = dueNow && dueNow < owed ? 'DEPOSIT' : 'BALANCE';
        /*
         * The email Foundry wrote to carry the link, when it was not allowed
         * to send it. The page said "wrote the email — it is on the order,
         * ready to send" and then showed a button to write it, which left the
         * owner asking where the email was. It is here: read it, then send it.
         */
        var waitingLink = (locals.customerNotices || []).filter(function (note) {
          return note.messageKind === 'payment_request' && !note.shipmentId
            && (note.status === 'PREPARED' || note.status === 'FAILED');
        })[0];
        var linkSent = (locals.customerNotices || []).filter(function (note) {
          return note.messageKind === 'payment_request' && note.status === 'SENT';
        })[0];
      %>
      <div id="pay-online" class="pay-actions">
        <% if (live) { %>
          <div class="pay-live">
            <%#
              An attempt that did not go through.

              Foundry knew a card had been declined and said nothing, so the order read
              "waiting to be paid" while the customer had already tried and failed. The
              provider's own words, because "the payment failed" is not something anybody
              can act on.
            %>
            <% if (live.lastError) { %>
              <div class="notice notice--warn"><div>
                <strong>The last attempt to pay this did not go through.</strong><br>
                <%= live.lastError %>
              </div></div>
            <% } %>
            <p class="pay-live-head">
              <strong><%= helpers.money(live.amountMinor, live.currency) %> asked for<%= live.purpose === 'DEPOSIT' ? ' as a deposit' : '' %>.</strong>
              <%= linkSent
                ? 'Foundry emailed it to ' + order.customer.name + ' on ' + helpers.shortDate(linkSent.sentAt) + '.'
                : waitingLink
                  ? 'Foundry wrote the email to ' + order.customer.name + '. It has not been sent.'
                  : 'Foundry updates this order by itself when they pay; nobody has to check.' %>
            </p>
            <div class="pay-buttons">
              <% if (waitingLink) { %>
                <a class="btn btn--primary" href="/messages/<%= waitingLink.id %>">Read the email and send it</a>
              <% } %>
              <button class="btn <%= waitingLink ? '' : 'btn--primary' %>" type="button"
                data-pay-open="<%= live.hostedUrl %>">
                Take payment now
              </button>
              <button class="btn" type="button" data-copy="<%= live.hostedUrl %>">Copy the link</button>
              <% if (order.customer.email && !waitingLink && !linkSent) { %>
                <form method="post" action="/sales/orders/<%= order.id %>/payment-request" class="inline-form" data-busy>
                  <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                  <input type="hidden" name="requestId" value="<%= live.id %>">
                  <button class="btn" type="submit" name="action" value="email">
                    Email it to <%= order.customer.name %>
                  </button>
                </form>
              <% } %>
            </div>
            <p class="hint t-muted">
              Take payment now opens the page the customer pays on, here on this order, so you
              can charge a card with them in front of you. Foundry never sees the card number.
            </p>
            <form method="post" action="/sales/orders/<%= order.id %>/payment-request" class="inline-form">
              <input type="hidden" name="_csrf" value="<%= csrfToken %>">
              <input type="hidden" name="requestId" value="<%= live.id %>">
              <button class="btn btn--ghost btn--sm" type="submit" name="action" value="void">Cancel that link</button>
            </form>
          </div>
        <% } else if (askable) { %>
          <div class="pay-buttons">
            <form method="post" action="/sales/orders/<%= order.id %>/payment-request" class="inline-form" data-busy>
              <input type="hidden" name="_csrf" value="<%= csrfToken %>">
              <input type="hidden" name="purpose" value="<%= askPurpose %>">
              <button class="btn btn--primary" type="submit" name="then" value="open">
                Take <%= helpers.money(askFor, money.currency) %> now
              </button>
              <button class="btn" type="submit" name="then" value="send">
                Send <%= order.customer.name %> a payment link
              </button>
            </form>
          </div>
          <p class="hint t-muted">
            <% if (askPurpose === 'DEPOSIT') { %>
              <%= helpers.money(dueNow, money.currency) %> is what the terms say is due now, out of
              <%= helpers.money(owed, money.currency) %> owed. Nothing has to have shipped.
            <% } else { %>
              Foundry creates the page they pay on. It never sees a card number, and it learns
              they paid without anybody checking.
            <% } %>
          </p>
        <% } %>
      </div>
      <% if (money.outstandingMinor) { %>
        <%#
          Money that arrived in the room.

          The panel offered one route — a payment link — and a sentence
          suggesting you tell Foundry about anything else. But most of the
          money a small business takes arrives as cash, a cheque, a transfer,
          or a card machine on the counter, and none of that has a link. So the
          ordinary case gets an ordinary form, on the page where the balance
          is, going through exactly the same engine as everything else.
        %>
        <%#
          Secondary, and closed by default. Collecting is the common act; recording
          something that already happened is bookkeeping, and it was sitting open
          above the two buttons that actually take money.
        %>
        <details class="disclosure take-payment">
          <summary>Record another payment — cash, cheque, transfer, card machine</summary>
          <form method="post" action="/sales/orders/<%= order.id %>/payment" data-busy>
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <div class="card-body">
              <div class="field-row">
                <label class="field">
                  <span class="field-label">How much</span>
                  <div class="input-prefix">
                    <span>$</span>
                    <input class="input" type="number" name="amount" step="0.01" min="0.01"
                      value="<%= ((money.dueNowMinor || money.outstandingMinor) / 100).toFixed(2) %>" required>
                  </div>
                  <span class="field-hint">
                    <%= money.dueNowMinor ? 'The deposit that is due.' : 'The whole balance, or part of it.' %>
                  </span>
                </label>
                <label class="field">
                  <span class="field-label">How</span>
                  <select class="input" name="method">
                    <option value="cash">Cash</option>
                    <option value="card">Card machine</option>
                    <option value="bank transfer">Bank transfer</option>
                    <option value="cheque">Cheque</option>
                    <option value="other">Something else</option>
                  </select>
                </label>
                <label class="field">
                  <span class="field-label">When</span>
                  <input class="input" type="date" name="paymentDate" value="<%= helpers.dateInputValue(new Date()) %>">
                </label>
              </div>
              <label class="field">
                <span class="field-label">Reference <span class="t-muted">(optional)</span></span>
                <input class="input" type="text" name="reference" placeholder="Cheque number, or what the transfer said">
              </label>
            </div>
            <div class="card-foot">
              <button class="btn btn--primary" type="submit">Record this payment</button>
              <span class="hint">
                This settles the invoice and posts the receipt. It is the same record a card
                payment through the link makes, so nothing is entered twice.
              </span>
            </div>
          </form>
        </details>
      <% } %>
    </div>
  </details>
<% } %>

<details class="card fold">
  <summary class="card-head">
    <h2>Order lines</h2>
    <span class="spacer"></span>
    <span class="fold-note">
      <%= order.lines.length %> <%= order.lines.length === 1 ? 'product' : 'products' %>
      · <%= helpers.money(order.pricing.totalMinor, order.currency) %>
    </span>
  </summary>
  <%
    /*
     * Eight columns, minus the ones that are empty for every line.
     *
     * On a shipped order "Committed", "Short" and "Held at" are a zero, a zero
     * and a dash, repeated down the page — three columns of width spent saying
     * that nothing is outstanding, which the "Shipped" column already says.
     * A column earns its place by having something in it.
     */
    var showCommitted = order.lines.some(function (line) { return Number(line.allocated) > 0; });
    var showShort = order.lines.some(function (line) { return Number(line.backordered) > 0; });
    var showShipped = order.lines.some(function (line) { return Number(line.quantity_fulfilled) > 0; });
    var showHeldAt = order.lines.some(function (line) { return line.allocations.length > 0; });
  %>
  <div class="table-wrap"><table class="table table--stack sales-table"><thead><tr><th>Product</th><th>Ordered</th><th>Unit price</th><th>Line total</th><% if (showCommitted) { %><th class="num">Committed</th><% } %><% if (showShort) { %><th class="num">Short</th><% } %><% if (showShipped) { %><th class="num"><%= (locals.goneWord || 'gone').replace(/^./, function (c) { return c.toUpperCase(); }) %></th><% } %><% if (showHeldAt) { %><th>Held at</th><% } %></tr></thead><tbody>
    <% order.lines.forEach(function(line){ %><tr><td class="cell-main"><strong><%= line.displayName %></strong><small><%= line.code %></small></td><td data-label="Ordered"><%= line.quantity_ordered %></td><td data-label="Unit price"><%= line.unit_price_minor === null ? 'Price not set' : helpers.money(line.unit_price_minor, order.currency) %></td><td data-label="Line total"><%= line.lineTotalMinor === null ? '—' : helpers.money(line.lineTotalMinor, order.currency) %></td><% if (showCommitted) { %><td class="num" data-label="Committed"><%= line.allocated %></td><% } %><% if (showShort) { %><td class="num" data-label="Short"><% if (line.backordered) { %><strong class="is-warn"><%= line.backordered %></strong><% } else { %><span class="t-muted">—</span><% } %></td><% } %><% if (showShipped) { %><td class="num" data-label="Shipped"><%= line.quantity_fulfilled %></td><% } %><% if (showHeldAt) { %><td data-label="Held at"><% if (!line.allocations.length) { %>—<% } else { line.allocations.forEach(function(a){ %><span class="pill"><%= a.location_name %> <strong><%= a.quantity %></strong></span><% }) } %></td><% } %></tr><% }) %>
  </tbody></table></div>
  <div class="sales-total-block">
    <div><span>Subtotal</span><strong><%= helpers.money(order.pricing.subtotalMinor, order.currency) %></strong></div>
    <% if (order.pricing.discountMinor) { %><div><span>Discount</span><strong>−<%= helpers.money(order.pricing.discountMinor, order.currency) %></strong></div><% } %>
    <% if (order.pricing.taxMinor) { %><div><span>Tax</span><strong><%= helpers.money(order.pricing.taxMinor, order.currency) %></strong></div><% } %>
    <div class="sales-total"><span>Order total</span><strong><%= helpers.money(order.pricing.totalMinor, order.currency) %></strong></div>
  </div>
  <% if (order.pricing.missingPriceLines) { %><div class="notice notice--warn"><strong>Enter the selling price in the confirm box above, or on the product.</strong> <%= order.pricing.missingPriceLines %> line<%= order.pricing.missingPriceLines === 1 ? '' : 's' %> has no selling price. <% order.lines.filter(function(line){ return line.unit_price_minor === null; }).forEach(function(line){ %><a href="/inventory/<%= line.item_id %>#selling-price">Set the price for <%= line.displayName %></a>. <% }) %></div><% } %>
</details>

<% if (!['FULFILLED','CANCELLED'].includes(order.status)) { %>
  <details class="card advanced-settings sales-secondary-actions" style="margin-top:16px;"><summary><strong>Change or cancel this order</strong><span class="hint">Optional</span></summary><div class="card-body grid grid--2">
    <form class="sales-action-card" method="post" action="/sales/orders/<%= order.id %>/lines"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="idempotencyKey" value="web-line:<%= order.id %>:<%= order.version %>"><h2>Add another product</h2><p>Foundry will recalculate what can be held.</p><label class="field"><span>Product</span><select name="skuId" required><option value="">Choose a product</option><% skus.forEach(function(s){ %><option value="<%= s.id %>"><%= s.display_name %> · <%= s.code %> · <%= s.price.isSet ? s.price.formatted : 'Price not set' %></option><% }) %></select></label><label class="field"><span>Quantity</span><input type="number" name="quantity" min="1" required></label><label class="field"><span>Selling price <small>only if not set in Inventory</small></span><input name="unitPrice" inputmode="decimal" placeholder="0.00"></label><button class="btn" type="submit">Add product</button></form>
    <form class="sales-action-card" method="post" action="/sales/orders/<%= order.id %>/cancel"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><h2>Cancel what has not shipped</h2><p>Held stock is released. Anything already shipped remains in history.</p><label class="field"><span>Reason <small>optional</small></span><input name="reason"></label><button class="btn btn--danger" type="submit">Cancel unshipped remainder</button></form>
  </div></details>
<% } %>

<% var eventLabels = { CREATED: 'Order created', CONFIRMED: 'Customer order confirmed and stock checked', CHANGED: 'Order changed and reservations recalculated', ALLOCATION_CHANGED: 'Stock reservation updated automatically', PARTIALLY_FULFILLED: 'Part of the order left', FULFILLED: 'The whole order left', ALLOCATED_FROM_STOCK: 'Stock that arrived was committed to this customer', CANCELLED: 'Remaining order cancelled' }; %>
<details class="card order-activity fold" style="margin-top:16px;"><summary class="card-head"><h2>Order activity</h2><span class="spacer"></span><span class="fold-note"><%= order.events.length %> <%= order.events.length === 1 ? 'entry' : 'entries' %></span></summary><div class="list-rows"><% order.events.slice().reverse().forEach(function(event){ %><div class="list-row"><span><strong><%= eventLabels[event.event_type] || event.event_type.replace(/_/g,' ').toLowerCase() %></strong><small><%= event.actor_name || 'Foundry' %> · <%= helpers.dateTime(event.created_at) %></small></span></div><% }) %></div></details>

<%#
  Taking a payment without losing the order.

  Stripe owns the page and takes the card; Foundry never sees a number. What
  this adds is somewhere to stand while that happens — the order itself,
  saying what is being paid and what it is waiting for, instead of an empty
  browser window and no way back.
%>
<% if (locals.paymentRequests) { %>
  <% var payable = paymentRequests.filter(function (rq) { return rq.status === 'OPEN' && rq.hostedUrl; })[0]; %>
  <% if (payable) { %>
    <%
      /*
       * The address of the payment page, as an attribute and nothing else.
       *
       * This was written with JSON.stringify to supply the quotes, and the
       * escaping output tag then turned those quotes into entities — so the
       * attribute arrived unquoted with literal quote characters inside its
       * value. The browser read the value as a string beginning with a quote
       * mark, which is not an absolute URL, so it resolved it as a path
       * relative to Foundry and opened /orders/%22https://... — a Foundry
       * page that does not exist.
       *
       * A merchant standing at the counter with a customer got a window
       * saying "We could not find that", and nothing anywhere said the link
       * was fine and only the markup was wrong.
       *
       * The quotes belong in the template, where the escaping cannot reach
       * them. Nothing in this comment may contain an EJS tag, for the same
       * reason: the parser reads comments too.
       */
    %>
    <div class="pay-modal" id="pay-window" hidden<% if (locals.openPaymentUrl) { %> data-open-now="<%= openPaymentUrl %>"<% } %>>
      <div class="pay-modal__sheet" role="dialog" aria-modal="true" aria-label="Taking a payment"
        data-order="<%= order.id %>">
        <div class="pay-modal__head">
          <div>
            <strong>Taking payment from <%= order.customer.name %></strong>
            <span class="fold-note">Stripe's own window. Foundry never sees the card number.</span>
          </div>
        </div>
        <div class="pay-modal__body">
          <p class="pay-modal__amount"><%= helpers.money(payable.amountMinor, payable.currency) %></p>
          <p id="pay-window-watching" hidden>
            The payment window is open in front of this one. Take the card there, and Foundry
            records it on <%= order.order_number %> by itself the moment Stripe confirms it —
            nobody has to come back and tell it.
          </p>
          <p id="pay-window-done" hidden>
            <strong id="pay-window-done-amount"></strong>
            Foundry recorded it on <%= order.order_number %>.
          </p>
          <p class="pay-modal__blocked" id="pay-window-blocked" hidden>
            This browser keeps new windows to itself, so open the payment page from here. Foundry
            still records the payment on <%= order.order_number %> by itself the moment Stripe
            confirms it.
          </p>
          <div class="pay-modal__buttons">
            <a class="btn btn--primary" id="pay-window-receipt" href="#" hidden>Print the receipt</a>
            <a class="btn" id="pay-window-invoice" href="#" target="_blank" rel="noopener noreferrer" hidden>View or print Stripe invoice</a>
            <a class="btn btn--primary" id="pay-window-tab" href="#" target="_blank" rel="noopener noreferrer">
              Open the payment page
            </a>
            <button class="btn" type="button" id="pay-window-front" data-pay-front hidden>Bring it forward</button>
            <button class="btn" type="button" data-copy="<%= payable.hostedUrl %>">Copy the link</button>
            <button class="btn btn--ghost" type="button" data-pay-close>Done</button>
          </div>
          <p class="fold-note">
            Done checks this order again, so a payment that has already landed shows up.
          </p>
        </div>
      </div>
    </div>
  <% } %>
<% } %>

<% } %>
