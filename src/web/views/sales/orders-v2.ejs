<%
  /*
   * Orders: one list, one primary action.
   *
   * The tabs are mutually exclusive buckets computed in orders-view.js, so
   * Needs you + To ship + Unpaid + Done is always All. Everything that used to
   * sit under the list (quick forms, the customer block, side links) lives in
   * its own place now: customers under Customers, Ask in the top bar.
   */
  var L = list;
  var m = function (minor) { return helpers.money(minor, L.currency); };
  var qs = function (over) {
    var p = { status: L.tab === 'all' ? '' : L.tab, q: L.q, page: '' };
    Object.keys(over || {}).forEach(function (k) { p[k] = over[k]; });
    var parts = Object.keys(p).filter(function (k) { return p[k]; }).map(function (k) { return k + '=' + encodeURIComponent(p[k]); });
    return '/orders' + (parts.length ? '?' + parts.join('&') : '');
  };
  var tabs = [['all', 'All'], ['needs', 'Needs you'], ['ship', 'To ship'], ['unpaid', 'Unpaid'], ['done', 'Done']];
%>
<link rel="stylesheet" href="/orders-ui.css?v=<%= assetVersion %>">
<div class="ox" data-ox-page="orders">
  <header class="ox-head">
    <div>
      <h1 class="ox-title">Orders</h1>
      <p class="ox-sub"><%= L.counts.all %> order<%= L.counts.all === 1 ? '' : 's' %><% if (L.counts.needs) { %> · <span class="ox-dot ox-dot--rose" aria-hidden="true"></span> <%= L.counts.needs %> need<%= L.counts.needs === 1 ? 's' : '' %> you<% } %></p>
    </div>
    <div class="ox-head__actions">
      <% if (canCreate) { %><a class="ox-btn ox-btn--primary" href="/orders/new" data-ox-new-order><span aria-hidden="true">+</span> New order</a><% } %>
    </div>
  </header>

  <%
    // The section's own tabs, the same ones its other pages show.
    var sectionTabs = (locals.pageSection && pageSection.id === 'orders' && pageSection.tabs) || [{ label: 'Orders', href: '/orders' }];
  %>
  <nav class="sc-section-tabs ox-subtabs" aria-label="Orders navigation">
    <% sectionTabs.forEach(function (t) { %><a <%- t.href === '/orders' ? 'class="is-on" aria-current="page"' : '' %> href="<%= t.href %>"><%= t.label %></a><% }) %>
  </nav>

  <section class="ox-kpis" aria-label="Order totals">
    <div class="ox-card ox-kpi"><span class="ox-kpi__k">Open orders</span><strong class="ox-kpi__n"><%= L.kpis.open.count %></strong><span class="ox-kpi__s ox-num"><%= m(L.kpis.open.minor) %></span></div>
    <div class="ox-card ox-kpi"><span class="ox-kpi__k">Ready to ship</span><strong class="ox-kpi__n"><%= L.kpis.ready.count %></strong><span class="ox-kpi__s"><%= L.kpis.ready.first || (L.kpis.ready.count ? 'orders confirmed' : 'Nothing waiting') %></span></div>
    <div class="ox-card ox-kpi"><span class="ox-kpi__k">Unpaid</span><strong class="ox-kpi__n ox-num <%= L.kpis.unpaid.minor ? 'ox-amber' : '' %>"><%= m(L.kpis.unpaid.minor) %></strong><span class="ox-kpi__s"><%= L.kpis.unpaid.count %> delivered order<%= L.kpis.unpaid.count === 1 ? '' : 's' %></span></div>
    <div class="ox-card ox-kpi"><span class="ox-kpi__k">Sales this month</span><strong class="ox-kpi__n ox-num"><%= m(L.kpis.month.minor) %></strong><span class="ox-kpi__s">Orders dated this month</span></div>
  </section>

  <section class="ox-card ox-list" aria-label="Order list">
    <div class="ox-toolbar">
      <nav class="ox-tabs" aria-label="Filter by status">
        <% tabs.forEach(function (t) { %>
          <a class="ox-tab <%= L.tab === t[0] ? 'is-on' : '' %>" href="<%= qs({ status: t[0] === 'all' ? '' : t[0], page: '' }) %>"<%- L.tab === t[0] ? ' aria-current="page"' : '' %> data-ox-tab="<%= t[0] %>"><%= t[1] %> <span class="ox-chip<%= t[0] === 'needs' && L.counts.needs ? ' ox-chip--rose' : '' %>" data-ox-count><%= L.counts[t[0]] %></span></a>
        <% }) %>
      </nav>
      <form class="ox-search" method="get" action="/orders" role="search" data-ox-search>
        <% if (L.tab !== 'all') { %><input type="hidden" name="status" value="<%= L.tab %>"><% } %>
        <svg class="ox-search__icon" viewBox="0 0 20 20" width="16" height="16" aria-hidden="true"><circle cx="9" cy="9" r="6" fill="none" stroke="currentColor" stroke-width="1.8"/><path d="m14 14 4 4" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/></svg>
        <input class="ox-input" type="search" name="q" value="<%= L.q %>" placeholder="Search order #, customer, product" aria-label="Search orders" autocomplete="off">
      </form>
    </div>

    <% if (!L.counts.all) { %>
      <div class="ox-empty">
        <strong>No orders yet</strong>
        <p>Orders you write here, or that arrive from a connected shop, show up in this list.</p>
        <div class="ox-empty__actions">
          <% if (canCreate) { %><a class="ox-btn ox-btn--primary" href="/orders/new">New order</a><% } %>
          <a class="ox-btn ox-btn--secondary" href="/settings/connections">Connect a shop</a>
        </div>
      </div>
    <% } else if (!L.rows.length) { %>
      <div class="ox-empty"><strong>No orders match</strong><p><a href="/orders">Show every order</a></p></div>
    <% } else { %>
      <table class="ox-table">
        <thead><tr>
          <th scope="col">Order</th><th scope="col" class="ox-hide-sm">Customer</th><th scope="col" class="ox-hide-sm">Date</th>
          <th scope="col">Status</th><th scope="col" class="ox-hide-sm">Payment</th><th scope="col" class="ox-r">Total</th>
          <th scope="col" class="ox-hide-sm"><span class="ox-sr">Next step</span></th>
        </tr></thead>
        <tbody>
          <% L.rows.forEach(function (row) { %>
            <tr class="ox-row<%= row.attention ? ' is-attention' : '' %><%= row.muted ? ' is-muted' : '' %>" data-href="/orders/<%= row.id %>">
              <td><a class="ox-order" href="/orders/<%= row.id %>"><%= row.number %></a><span class="ox-show-sm ox-cell-sub"><%= row.customer %></span></td>
              <td class="ox-hide-sm"><span class="ox-cust"><span class="ox-avatar" aria-hidden="true"><%= row.initials %></span><span><%= row.customer %></span></span></td>
              <td class="ox-hide-sm ox-muted"><%= row.date %></td>
              <td><span class="ox-badge ox-badge--<%= row.badge.tone %>"><%= row.badge.text %></span></td>
              <td class="ox-hide-sm"><% if (row.payment) { %><span class="ox-badge ox-badge--<%= row.payment.tone %>"><%= row.payment.text %></span><% } else { %><span class="ox-muted">—</span><% } %></td>
              <td class="ox-r ox-num"><%= m(row.totalMinor) %></td>
              <td class="ox-r ox-hide-sm"><% if (row.action) { %><a class="ox-btn ox-btn--sm ox-btn--<%= row.action.kind %>" href="<%= row.action.href %>" aria-label="<%= row.action.label %> <%= row.number %>"><%= row.action.label %></a><% } %></td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    <% } %>

    <footer class="ox-foot">
      <span class="ox-muted">Showing <%= L.shown %> of <%= L.matching %><% if (L.pages > 1) { %> ·
        <% if (L.page > 1) { %><a href="<%= qs({ page: L.page - 1 }) %>">Previous</a><% } %>
        Page <%= L.page %> of <%= L.pages %>
        <% if (L.page < L.pages) { %><a href="<%= qs({ page: L.page + 1 }) %>">Next</a><% } %>
      <% } %></span>
      <% if (!sellingConnectionCount) { %><a href="/settings/connections">Connect a shop so web orders arrive here on their own →</a><% } %>
    </footer>
  </section>
</div>
<script src="/orders-ui.js?v=<%= assetVersion %>" defer></script>
