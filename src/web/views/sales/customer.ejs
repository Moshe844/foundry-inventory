<div class="breadcrumb"><a href="/orders">Orders</a> <%- helpers.icon('chevron', { size: 13 }) %> <span><%= customer.name %></span></div>
<div class="page-head"><div class="titles"><h1><%= customer.name %><% if (customer.company) { %> <span class="t-muted"><%= customer.company %></span><% } %></h1></div><a class="btn btn--primary" href="/orders/new">New order</a></div>

<%#
  What this relationship is, in one line.

  The page used to open with a form for their phone number, under "Customer
  details needed to manage inventory commitments and delivery" — a sentence
  about the software rather than about them. What somebody wants on opening a
  customer is what they owe and how they pay.
%>
<p class="lede">
  <% if (customerOwes.minor) { %>
    Owes <strong><%= helpers.money(customerOwes.minor, 'USD') %></strong>
    across <%= customerOwes.invoices %> <%= customerOwes.invoices === 1 ? 'invoice' : 'invoices' %><%
      if (customerOwes.soonest) { %>, the first due <%= helpers.shortDate(customerOwes.soonest) %><% } %>.
  <% } else { %>
    Owes nothing.
  <% } %>
  <%= termsDescription %>
  <span class="t-xs t-muted">(<%= terms.source %>)</span>
</p>

<div class="grid grid--2">
  <form class="card form-card" method="post" action="/sales/customers/<%= customer.id %>">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <div class="card-head"><h2>Customer details</h2></div>
    <div class="form-grid">
      <label class="field"><span>Name</span><input name="name" value="<%= customer.name %>" required></label>
      <label class="field"><span>Company</span><input name="company" value="<%= customer.company || '' %>"></label>
      <label class="field"><span>Email</span><input type="email" name="email" value="<%= customer.email || '' %>"></label>
      <label class="field"><span>Phone</span><input name="phone" value="<%= customer.phone || '' %>"></label>
      <label class="field field--full"><span>Shipping or delivery information</span><textarea name="shippingAddress"><%= customer.shipping_address || '' %></textarea></label>
      <label class="field field--full"><span>Notes</span><textarea name="notes"><%= customer.notes || '' %></textarea></label>
    </div>
    <div class="form-actions"><button class="btn btn--primary" type="submit">Save customer</button></div>
  </form>

  <div class="card">
    <div class="card-head"><h2>Sales-order history</h2><span class="muted"><%= customer.orders.length %> order<%= customer.orders.length === 1 ? '' : 's' %></span></div>
    <% if (!customer.orders.length) { %><div class="empty"><p>No sales orders yet.</p></div><% } else { %>
      <div class="list-rows"><% customer.orders.forEach(function(order){ %><a class="list-row" href="/orders/<%= order.id %>"><span><strong><%= order.order_number %></strong><small><%= helpers.shortDate(order.order_date) %><%= order.needed_by ? ' · wanted ' + helpers.shortDate(order.needed_by) : '' %></small></span><span><span class="badge badge--<%= order.next.tone === 'go' ? 'info' : order.next.tone === 'danger' ? 'warn' : order.next.tone %>"><%= order.next.text %></span> <%- helpers.icon('chevron', { size: 13 }) %></span></a><% }) %></div>
    <% } %>
  </div>
</div>

<section class="section" id="terms">
  <div class="panel">
    <div class="panel-head">
      <div>
        <h2>How <%= customer.name %> pays</h2>
        <span class="t-xs t-muted"><%= terms.isDefault ? 'Following ' + terms.source : terms.source %></span>
      </div>
      <span class="spacer"></span>
      <span class="badge badge--<%= terms.kind === 'ON_ACCOUNT' ? 'info' : 'warn' %>">
        <%= terms.kind === 'ON_ACCOUNT' ? 'On account' : terms.kind === 'DEPOSIT' ? 'Deposit' : 'Pays first' %>
      </span>
    </div>
    <form method="post" action="/sales/customers/<%= customer.id %>/terms" data-busy>
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <div class="card-body">
        <div class="choice-grid">
          <label class="choice">
            <input type="radio" name="kind" value="ON_ACCOUNT" <%= terms.kind === 'ON_ACCOUNT' ? 'checked' : '' %>>
            <span class="choice-body">
              <strong>On account</strong>
              <span class="t-xs t-muted">They order, you invoice, they pay by the due date. Nothing waits for money.</span>
            </span>
          </label>
          <label class="choice">
            <input type="radio" name="kind" value="DEPOSIT" <%= terms.kind === 'DEPOSIT' ? 'checked' : '' %>>
            <span class="choice-body">
              <strong>A deposit up front</strong>
              <span class="t-xs t-muted">Nothing is picked until the deposit arrives. Set the share or the amount below.</span>
            </span>
          </label>
          <label class="choice">
            <input type="radio" name="kind" value="BEFORE_FULFILMENT" <%= terms.kind === 'BEFORE_FULFILMENT' ? 'checked' : '' %>>
            <span class="choice-body">
              <strong>Paid in full first</strong>
              <span class="t-xs t-muted">Nothing is picked or shipped until the invoice is settled.</span>
            </span>
          </label>
        </div>

        <div class="field-row">
          <label class="field">
            <span class="field-label">Deposit, as a share <span class="t-muted">(deposit only)</span></span>
            <input class="input" type="number" name="depositPercent" min="1" max="100" step="1"
              value="<%= terms.depositPercent === null || terms.depositPercent === undefined ? '' : terms.depositPercent %>"
              placeholder="30">
            <span class="field-hint">Per cent of the order.</span>
          </label>
          <label class="field">
            <span class="field-label">Or a fixed deposit</span>
            <div class="input-prefix">
              <span>$</span>
              <input class="input" type="number" name="depositAmount" min="0.01" step="0.01"
                value="<%= terms.depositMinor === null || terms.depositMinor === undefined ? '' : (terms.depositMinor / 100).toFixed(2) %>"
                placeholder="500.00">
            </div>
            <span class="field-hint">One or the other, never both.</span>
          </label>
          <label class="field">
            <span class="field-label">Days to pay <span class="t-muted">(on account only)</span></span>
            <input class="input" type="number" name="netDays" min="0" step="1"
              value="<%= terms.netDays === null || terms.netDays === undefined ? '' : terms.netDays %>"
              placeholder="30">
          </label>
        </div>

        <label class="choice">
          <input type="checkbox" name="holdShipping" value="1" <%= terms.holdShipping ? 'checked' : '' %>>
          <span class="choice-body">
            <strong>Hold the parcel until the balance is paid</strong>
            <span class="t-xs t-muted">
              Picking and packing still happen. Only the shipment waits, and you can always let one order
              through from the order itself.
            </span>
          </span>
        </label>

        <label class="field">
          <span class="field-label">Note <span class="t-muted">(optional)</span></span>
          <input class="input" type="text" name="note" value="<%= terms.note || '' %>"
            placeholder="Agreed with John on the phone, September">
        </label>
      </div>
      <div class="card-foot">
        <button class="btn btn--primary" type="submit">Save these terms</button>
        <% if (!terms.isDefault) { %>
          <button class="btn btn--ghost" type="submit" name="action" value="clear">
            Use your rule for everybody instead
          </button>
        <% } %>
      </div>
    </form>
  </div>
  <p class="section-foot t-muted">
    Foundry applies this to every future order for <%= customer.name %> without being asked again.
  </p>
</section>
