<%
  /*
   * The order page's Payment card and its Collect payment dialog.
   *
   * One place for money on the order. The card reads the same figures as the
   * page's payment summary (refunds and credits included) and lists what has
   * been received. Collecting asks how the customer pays and does that:
   *   Cash          - what they handed over; the change is worked out.
   *   Card          - charged on the connected gateway's secure page, or a
   *                   way to connect one. StockChief never sees the card.
   *   Bank transfer - the business's bank details to give them, then mark it
   *                   received when it arrives.
   *   Cheque        - the amount and, if wanted, the cheque number.
   * Before an invoice exists a payment is a customer deposit; the server
   * applies it to the invoice when the goods leave.
   */
  var sv = helpers.paymentSummary(money);
  var cur = money.currency || order.currency || 'USD';
  var owed = Number(money.outstandingMinor || 0);
  var dueNow = Number(money.dueNowMinor || 0);
  var ask = dueNow > 0 && dueNow < owed ? dueNow : owed;
  var askPurpose = dueNow > 0 && dueNow < owed ? 'DEPOSIT' : 'BALANCE';
  var refunded = Number(money.refundedMinor || 0), credited = Number(money.creditedMinor || 0);
  var receipts = locals.customerReceipts || [];
  var providers = locals.paymentProviders || [];
  var online = providers.some(function (n) { return n !== 'stripe'; }) || Boolean(locals.paymentAccount && paymentAccount.connected);
  var requests = locals.paymentRequests || [];
  var liveCard = requests.filter(function (r) { return r.status === 'OPEN' && r.hostedUrl; })[0];
  var pendingCard = requests.filter(function (r) { return r.status === 'PENDING'; })[0];
  var canCollect = owed > 0 && order.status !== 'CANCELLED' && locals.canRecordPayments !== false;
  // Paid means nothing is owed, before an invoice exists as well as after.
  var state = owed === 0 && Number(money.paidMinor || 0) > 0 && !refunded ? 'Paid' : sv.state;
  var stateTone = { Paid: 'green', 'Partly paid': 'amber', Unpaid: money.invoiced ? 'rose' : 'grey' }[state] || 'grey';
  var bank = locals.bankDetails;
  var bankText = bank ? [bank.bank_name, 'Account name: ' + bank.account_name, bank.routing_number ? 'Routing: ' + bank.routing_number : null, 'Account: ' + bank.account_number, bank.note].filter(Boolean).join('\n') : '';
  var dollars = function (minor) { return (Number(minor || 0) / 100).toFixed(2); };
  var gatewayHref = '/settings/connections?only=payments&return=/orders/' + order.id;
%>
<section class="ox ox-card ox-paycard" role="region" aria-label="Payment summary" data-ox-paycard>
  <div class="ox-paycard__h"><h2 id="ox-h-pay">Payment</h2><span class="ox-badge ox-badge--<%= stateTone %>"><%= state %></span></div>
  <dl class="ox-paycard__rows">
    <% if (money.invoiced) { %>
      <%# Once invoiced: the same rows the payment summary has always shown, refunds and credits included. %>
      <% sv.rows.filter(function (row) { return row.label !== 'Balance'; }).forEach(function (row) { %><div><dt><%= row.label %></dt><dd class="ox-num"><%= helpers.money(row.amountMinor, cur) %></dd></div><% }) %>
    <% } else { %>
      <div><dt>Order total</dt><dd class="ox-num"><%= helpers.money(money.totalMinor, cur) %></dd></div>
      <div><dt>Paid</dt><dd class="ox-num"><%= helpers.money(money.paidMinor, cur) %></dd></div>
    <% } %>
    <div class="ox-paycard__due"><dt>Balance due</dt><dd class="ox-num"><%= helpers.money(owed, cur) %></dd></div>
  </dl>
  <% if (receipts.length) { %>
  <ul class="ox-receipts" aria-label="Payments received">
    <% receipts.forEach(function (receipt) { %>
      <li><b class="ox-num"><%= helpers.money(receipt.amount_minor, cur) %></b>
        <span><%= receipt.method ? receipt.method.replace(/_/g, ' ') : 'payment' %><%= receipt.reference ? ' · ' + receipt.reference : '' %> · <%= helpers.shortDate(receipt.payment_date) %></span>
        <a href="/orders/<%= order.id %>/receipt/<%= receipt.id %>">Receipt</a></li>
    <% }) %>
  </ul>
  <% } %>
  <% if (liveCard) { %>
    <p class="ox-paycard__note"><strong>Card payment page ready</strong> for <%= helpers.money(liveCard.amountMinor || liveCard.amount_minor, cur) %>. <a href="<%= liveCard.hostedUrl %>" target="_blank" rel="noopener noreferrer">Open it to take the card</a>; this order updates when it's paid.</p>
  <% } else if (pendingCard) { %>
    <p class="ox-paycard__note">Preparing the secure card page… <a href="/orders/<%= order.id %>">Refresh</a></p>
  <% } %>
  <% if (money.invoices && money.invoices.length) { %>
  <div class="ox-paycard__docs">
    <% money.invoices.forEach(function (invoice) { %>
      <p><a href="/money/invoices/<%= invoice.id %>"><%= invoice.invoice_number %></a> · <a href="/money/invoices/<%= invoice.id %>/pdf" download="invoice.pdf">PDF</a> · <a href="/money/invoices/<%= invoice.id %>/print" target="_blank" rel="noopener">Print</a> · <a href="/money/invoices/<%= invoice.id %>/email">Email</a></p>
    <% }) %>
  </div>
  <% } %>
  <% if (canCollect) { %><button class="ox-btn ox-btn--primary ox-btn--block" type="button" data-modal-open="ox-pay">Collect payment</button><% } %>
</section>

<% if (canCollect) { %>
<dialog class="ox ox-modal ox-modal--pay" id="ox-pay" aria-labelledby="ox-h-collect" data-ox-pay data-owed="<%= owed %>" data-currency="<%= cur %>">
  <div class="ox-modal__h"><h2 id="ox-h-collect">Collect payment</h2><button class="ox-modal__x" type="button" data-modal-close aria-label="Close">×</button></div>
  <div class="ox-modal__b">
    <p class="ox-pay__due">Balance due <b class="ox-num"><%= helpers.money(owed, cur) %></b><% if (dueNow > 0 && dueNow < owed) { %> · deposit due now <b class="ox-num"><%= helpers.money(dueNow, cur) %></b><% } %></p>
    <div class="ox-pay__tabs" role="tablist" aria-label="How is the customer paying?">
      <button type="button" role="tab" data-ox-pay-tab="cash" aria-selected="true">Cash</button>
      <button type="button" role="tab" data-ox-pay-tab="card" aria-selected="false">Card</button>
      <button type="button" role="tab" data-ox-pay-tab="transfer" aria-selected="false">Bank transfer</button>
      <button type="button" role="tab" data-ox-pay-tab="cheque" aria-selected="false">Cheque</button>
    </div>

    <form class="ox-pay__panel" role="tabpanel" data-ox-pay-panel="cash" method="post" action="/sales/orders/<%= order.id %>/payment" data-ox-cash>
      <input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="method" value="cash">
      <input type="hidden" name="amount" value="<%= dollars(ask) %>" data-ox-cash-amount><input type="hidden" name="reference" data-ox-cash-note>
      <label class="ox-field"><span>Cash received</span><input type="number" step="0.01" min="0.01" inputmode="decimal" value="<%= dollars(ask) %>" required data-ox-cash-received></label>
      <dl class="ox-pay__calc">
        <div><dt>Goes to this order</dt><dd class="ox-num" data-ox-cash-applied><%= helpers.money(ask, cur) %></dd></div>
        <div class="ox-pay__change"><dt>Change to give back</dt><dd class="ox-num" data-ox-cash-change><%= helpers.money(0, cur) %></dd></div>
        <div><dt>Still owed after this</dt><dd class="ox-num" data-ox-cash-left><%= helpers.money(owed - ask, cur) %></dd></div>
      </dl>
      <details class="ox-pay__note"><summary>Add a note</summary><input maxlength="120" placeholder="Optional" data-ox-cash-extra aria-label="Note"></details>
      <button class="ox-btn ox-btn--primary ox-btn--block" type="submit" data-ox-cash-submit>Record <%= helpers.money(ask, cur) %> cash</button>
    </form>

    <div class="ox-pay__panel" role="tabpanel" data-ox-pay-panel="card" hidden>
      <% if (liveCard) { %>
        <p>A secure card page is ready for <%= helpers.money(liveCard.amountMinor || liveCard.amount_minor, cur) %>.</p>
        <a class="ox-btn ox-btn--primary ox-btn--block" href="<%= liveCard.hostedUrl %>" target="_blank" rel="noopener noreferrer">Open the card page</a>
        <p class="ox-help">Enter the card there, or hand the screen to the customer. The order updates by itself when the payment goes through.</p>
      <% } else if (online) { %>
        <form method="post" action="/orders/<%= order.id %>/payment-requests">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="purpose" value="<%= askPurpose %>">
          <input type="hidden" name="idempotencyKey" value="<%= paymentRequestFormKey %>-<%= askPurpose.toLowerCase() %>">
          <% if (providers.length > 1) { %>
            <label class="ox-field"><span>Charge with</span><select name="provider"><% providers.forEach(function (p) { %><option value="<%= p %>"><%= p === 'cardknox' ? 'Sola' : p === 'stripe' ? 'Stripe' : p %></option><% }) %></select></label>
          <% } else { %><input type="hidden" name="provider" value="<%= providers[0] || 'stripe' %>"><% } %>
          <p>StockChief opens a secure card page from your gateway for <b class="ox-num"><%= helpers.money(ask, cur) %></b>. The card is entered there, never in StockChief, and the payment records itself when it goes through.</p>
          <button class="ox-btn ox-btn--primary ox-btn--block" type="submit">Charge <%= helpers.money(ask, cur) %> by card</button>
        </form>
      <% } else { %>
        <p>Cards are charged through your own Sola or Stripe account. Connect one and you can charge cards right here.</p>
        <% if (locals.canManagePaymentAccount) { %><a class="ox-btn ox-btn--primary ox-btn--block" href="<%= gatewayHref %>">Connect Sola or Stripe</a>
        <% } else { %><p class="ox-help">A workspace owner can connect one under Settings.</p><% } %>
      <% } %>
    </div>

    <div class="ox-pay__panel" role="tabpanel" data-ox-pay-panel="transfer" hidden>
      <% if (bank) { %>
        <div class="ox-bank">
          <p class="ox-bank__h">Customer sends the money to</p>
          <dl>
            <% if (bank.bank_name) { %><div><dt>Bank</dt><dd><%= bank.bank_name %></dd></div><% } %>
            <div><dt>Account name</dt><dd><%= bank.account_name %></dd></div>
            <% if (bank.routing_number) { %><div><dt>Routing</dt><dd class="ox-num"><%= bank.routing_number %></dd></div><% } %>
            <div><dt>Account</dt><dd class="ox-num"><%= bank.account_number %></dd></div>
            <div><dt>Reference</dt><dd><%= order.order_number %></dd></div>
          </dl>
          <% if (bank.note) { %><p class="ox-help"><%= bank.note %></p><% } %>
          <button class="ox-btn ox-btn--secondary ox-btn--sm" type="button" data-copy="<%= bankText + '\nReference: ' + order.order_number %>">Copy details</button>
        </div>
      <% } %>
      <% if (locals.canManageBankDetails) { %>
        <details class="ox-bank-edit"<%= bank ? '' : ' open' %>>
          <summary><%= bank ? 'Change bank details' : 'Add your bank details' %></summary>
          <form method="post" action="/settings/bank-transfer-details" class="ox-bank-form">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="returnTo" value="/orders/<%= order.id %>">
            <p class="ox-help">Shown to you here whenever a customer pays by transfer, so you can give it to them.</p>
            <label class="ox-field"><span>Account name</span><input name="accountName" required maxlength="160" value="<%= bank ? bank.account_name : '' %>" placeholder="Your business name as the bank has it"></label>
            <div class="ox-grid2">
              <label class="ox-field"><span>Bank</span><input name="bankName" maxlength="120" value="<%= bank ? bank.bank_name || '' : '' %>"></label>
              <label class="ox-field"><span>Routing number</span><input name="routingNumber" maxlength="40" inputmode="numeric" value="<%= bank ? bank.routing_number || '' : '' %>"></label>
            </div>
            <label class="ox-field"><span>Account number</span><input name="accountNumber" required maxlength="40" inputmode="numeric" value="<%= bank ? bank.account_number : '' %>"></label>
            <label class="ox-field"><span>Note for customers <small>optional</small></span><input name="note" maxlength="300" value="<%= bank ? bank.note || '' : '' %>" placeholder="For example: include the order number"></label>
            <button class="ox-btn ox-btn--secondary" type="submit">Save bank details</button>
          </form>
        </details>
      <% } else if (!bank) { %>
        <p class="ox-help">No bank details are set up yet. Someone who manages accounting can add them here.</p>
      <% } %>
      <form method="post" action="/sales/orders/<%= order.id %>/payment" class="ox-pay__record">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="method" value="bank transfer">
        <p class="ox-pay__step">When the money is in your account:</p>
        <label class="ox-field"><span>Amount received</span><input type="number" name="amount" step="0.01" min="0.01" max="<%= dollars(owed) %>" inputmode="decimal" value="<%= dollars(ask) %>" required></label>
        <details class="ox-pay__note"><summary>Add a note</summary><input name="reference" maxlength="120" placeholder="Optional" aria-label="Note"></details>
        <button class="ox-btn ox-btn--primary ox-btn--block" type="submit">Mark transfer received</button>
      </form>
    </div>

    <form class="ox-pay__panel" role="tabpanel" data-ox-pay-panel="cheque" hidden method="post" action="/sales/orders/<%= order.id %>/payment">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="method" value="cheque">
      <label class="ox-field"><span>Cheque amount</span><input type="number" name="amount" step="0.01" min="0.01" max="<%= dollars(owed) %>" inputmode="decimal" value="<%= dollars(ask) %>" required></label>
      <label class="ox-field"><span>Cheque number <small>optional</small></span><input name="reference" maxlength="60" inputmode="numeric"></label>
      <button class="ox-btn ox-btn--primary ox-btn--block" type="submit">Record cheque</button>
    </form>
  </div>
</dialog>
<% } %>
