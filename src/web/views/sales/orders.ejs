<%
  /*
   * Sales, as customer demand rather than three tables of equal weight.
   *
   * Customer orders are what this page is for; completed sales from a connected
   * till are history, and customers are a supporting record created by the first
   * order. All three were cards of the same size, so the page had no subject.
   *
   * The order table also called the same number three different things. Stock
   * held for a customer is "committed" on the item page and in the inventory
   * list; here it was "Reserved", beside "Ordered" and "Waiting", none of which
   * said what they were counting. And the status column printed the stored enum
   * with its underscores swapped for spaces — "partially fulfilled" — except
   * for BACKORDERED, which somebody had already special-cased into English.
   * They all read as English now, from one list.
   */
  var openOrders = orders.filter(function (o) {
    return ['CONFIRMED', 'BACKORDERED', 'PARTIALLY_FULFILLED'].includes(o.status);
  });
  var committed = openOrders.reduce(function (n, o) { return n + o.totals.allocated; }, 0);
  var waiting = openOrders.reduce(function (n, o) { return n + o.totals.backordered; }, 0);

  var STATUS = {
    DRAFT: { label: 'Being prepared', tone: 'muted' },
    CONFIRMED: { label: 'Confirmed — stock held', tone: 'info' },
    BACKORDERED: { label: 'Confirmed — waiting for stock', tone: 'warn' },
    PARTIALLY_FULFILLED: { label: 'Partly shipped', tone: 'info' },
    FULFILLED: { label: 'Shipped', tone: 'ok' },
    CANCELLED: { label: 'Cancelled', tone: 'muted' },
  };
%>

<div class="page-head">
  <div>
    <h1>Orders</h1>
    <p class="page-sub">Every customer order from the promise to the parcel: held, picked, shipped, paid.</p>
  </div>
  <%#
    Picking, shipping and customer mail are part of Orders now rather than
    departments of their own, so this is where somebody finds them — including
    on the first morning, when there are no orders yet. Hiding them until an
    order exists would mean consolidating the sidebar had simply lost them.

    "New order" is the exception and stays conditional: with nothing here the
    empty state below already says it, and one call to action is enough.
  %>
  <%#
    One action, two directions.

    These were three buttons the same size, so the eye had to read all three to
    find out that two of them leave the page. Making an order is the thing you
    do here; picking and mail are where you go next, and they are sized like it.
  %>
  <div class="page-actions">
    <% if (orders.length) { %>
      <a class="btn btn--primary" href="/orders/new"><%- helpers.icon('plus', { size: 15 }) %> New order</a>
    <% } %>
  </div>
</div>

<%
  /*
   * One sentence instead of three numbers.
   *
   * "2 open customer orders / 120 committed / 0 units waiting for stock" is
   * three true figures that between them never say whether anything needs
   * doing. This says that and stops.
   */
%>
<p class="lede orders-verdict"><%= summary %></p>

<p class="orders-elsewhere t-muted">
  <a href="/fulfilment"><%- helpers.icon('box', { size: 14 }) %> Picking and shipping</a>
  <a href="/mail"><%- helpers.icon('send', { size: 14 }) %> Customer mail</a>
</p>

<%# ------------------------------------------------------------ Customer orders %>
<section class="section">
  <div class="section-head">
    <h2>Customer orders</h2>
    <% if (orders.length) { %><span class="section-more"><%= orders.length %> order<%= orders.length === 1 ? '' : 's' %></span><% } %>
  </div>

  <% if (!orders.length) { %>
    <div class="empty-state">
      <span class="empty-state__icon"><%- helpers.icon('sales', { size: 20 }) %></span>
      <p class="empty-state__title">No customer orders yet</p>
      <p class="empty-state__body">
        Create one when a customer commits to buy stock. Foundry holds what is available for them;
        the stock itself only moves when you fulfill it.
      </p>
      <a class="btn btn--primary" href="/sales/new">Create a customer order</a>
    </div>
  <% } else { %>
    <div class="panel">
      <div class="table-wrap">
        <table class="table table--stack">
          <thead>
            <tr>
              <th>Order</th>
              <th>Customer</th>
              <th>Waiting for</th>
              <th class="num">Value</th>
            </tr>
          </thead>
          <tbody>
            <% orders.forEach(function (order) { %>
              <tr>
                <td class="cell-main">
                  <a class="cell-title" href="/orders/<%= order.id %>"><%= order.order_number %></a>
                  <span class="cell-sub">
                    <% if (order.needed_by) { %>wanted <%= helpers.shortDate(order.needed_by) %>
                    <% } else { %><%= helpers.shortDate(order.order_date) %><% } %>
                  </span>
                </td>
                <td data-label="Customer">
                  <%= order.customer.name %>
                  <% if (order.customer.company) { %><span class="cell-sub"><%= order.customer.company %></span><% } %>
                </td>
                <td data-label="Waiting for">
                  <span class="badge badge--<%= order.next.tone === 'go' ? 'info'
                    : order.next.tone === 'danger' ? 'warn' : order.next.tone %>"><%= order.next.text %></span>
                  <% if (order.next.detail) { %>
                    <div class="cell-sub"><%= order.next.detail %></div>
                  <% } %>
                </td>
                <td class="num cell-end" data-label="Value">
                  <%= order.pricing.missingPriceLines ? '—' : helpers.money(order.pricing.totalMinor, order.currency) %>
                </td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    </div>

    <%# A shortfall is a decision, and it is made on the order itself — where
        Foundry shows what it can move and what it would have to buy. Saying so
        here stops somebody going off to Inventory and Purchasing by hand. %>
    <% if (waiting) { %>
      <p class="section-foot">
        <%= waiting %> unit<%= waiting === 1 ? '' : 's' %> across
        <%= openOrders.filter(function (o) { return o.totals.backordered; }).length %>
        order<%= openOrders.filter(function (o) { return o.totals.backordered; }).length === 1 ? '' : 's' %>
        <%= waiting === 1 ? 'is' : 'are' %> short. Open the order and Foundry shows what it can move
        and what it would have to buy.
      </p>
    <% } %>
  <% } %>
</section>

<%# ----------------------------------------------------------- Completed sales %>
<% if (completedSales.length) { %>
<section class="section">
  <div class="section-head">
    <h2>Completed sales</h2>
    <span class="section-more">From the tills and stores you have connected</span>
  </div>
  <% if (!completedSales.length) { %>
    <div class="quiet-note">
      Nothing yet. <a href="/settings/connections">Connect where checkout happens</a> and completed
      sales arrive here by themselves, reducing stock through the same records as everything else.
    </div>
  <% } else { %>
    <div class="panel">
      <div class="table-wrap">
        <table class="table table--stack">
          <thead>
            <tr><th>Sale</th><th>From</th><th>What sold</th><th>Where</th><th>When</th><th class="num">Total</th></tr>
          </thead>
          <tbody>
            <% completedSales.forEach(function (sale) { %>
              <tr>
                <td class="cell-main"><span class="cell-title"><%= sale.reference %></span></td>
                <td data-label="From"><%= sale.providerName %></td>
                <td data-label="What sold">
                  <%= sale.itemSummary %>
                  <span class="cell-sub"><%= sale.totalUnits %> unit<%= sale.totalUnits === 1 ? '' : 's' %></span>
                </td>
                <td data-label="Where" class="t-muted"><%= sale.locations.join(', ') %></td>
                <td data-label="When" class="t-muted"><%= helpers.dateTime(sale.occurredAt) %></td>
                <td class="num cell-end" data-label="Total">
                  <%= sale.priceComplete ? helpers.money(sale.totalMinor, sale.currency || 'USD') : '—' %>
                </td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    </div>
  <% } %>
</section>
<% } %>

<%# ---------------------------------------------------------------- Customers %>
<% if (customers.length) { %>
  <section class="section">
    <div class="section-head">
      <h2>Customers</h2>
      <span class="section-more"><%= customers.length %> on file</span>
    </div>
    <div class="panel">
      <% customers.forEach(function (customer) { %>
        <a class="conn" href="/sales/customers/<%= customer.id %>">
          <span class="conn__body">
            <span class="conn__name"><%= customer.name %></span>
            <span class="conn__meta"><%= customer.company || customer.email || 'No contact details yet' %></span>
          </span>
          <span class="t-xs t-muted"><%= customer.order_count %> order<%= customer.order_count === 1 ? '' : 's' %></span>
        </a>
      <% }) %>
    </div>
  </section>
<% } %>
