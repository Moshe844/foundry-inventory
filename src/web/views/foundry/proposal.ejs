<%
  var u = understanding;
  var mode = helpers.TRACKING_MODES[u.recommendedConfiguration.trackingMode];
  var configRecs = recommendations.filter(function (r) { return r.scope === 'configuration'; });
  var futureRecs = recommendations.filter(function (r) { return r.scope === 'future'; });
  var terms = Object.keys(u.terminology || {}).filter(function (k) { return u.terminology[k]; });
  var doc = setupDocument && setupDocument.interpretation;
  var docLines = doc ? doc.lines : [];
  var docUnits = docLines.reduce(function (sum, line) { return sum + line.quantity; }, 0);
  var docUnitText = doc ? helpers.unitLabel(docUnits, doc.unitLabel || 'unit') : 'units';
  var docValue = docLines.reduce(function (sum, line) { return sum + (line.unitCost == null ? 0 : line.quantity * line.unitCost); }, 0);
  var docStyles = new Set(docLines.map(function (line) { return [line.styleName, line.color].filter(Boolean).join(' / ').toLowerCase(); })).size;
  var docCodeLabel = setupDocument ? setupDocument.supplierCodeLabel : 'Supplier code';
%>

<div class="foundry-hero foundry-hero--tight">
  <span class="foundry-mark"><%- helpers.icon('foundry', { size: 22 }) %></span>
  <h1>Here's how I'd organize your inventory</h1>
  <p class="foundry-quote">“<%= u.businessDescription %>”</p>
</div>

<form method="post" action="/foundry/proposal/<%= understandingId %>/configure">
  <input type="hidden" name="_csrf" value="<%= csrfToken %>">

  <% if (doc) { %>
    <section class="card section setup-document-preview">
      <div class="card-head">
        <%- helpers.icon('document', { size: 18 }) %>
        <div>
          <h2>What Foundry read from <%= setupDocument.sourceName %></h2>
          <p class="hint"><%= doc.documentType.replace('_', ' ') %><% if (doc.documentNumber) { %> · <%= doc.documentNumber %><% } %><% if (doc.documentDate) { %> · <%= doc.documentDate %><% } %></p>
        </div>
        <span class="badge badge--ok" style="margin-left:auto;">Read from file</span>
      </div>
      <div class="card-body">
        <div class="document-facts">
          <div><span>Supplier</span><strong><%= doc.supplierName || 'Not shown' %></strong></div>
          <div><span>Stock goes to</span><strong><%= doc.destinationName %></strong></div>
          <div><span>Inventory</span><strong><%= docUnits %> <%= docUnitText %> · <%= docStyles %> styles · <%= docLines.length %> variants</strong></div>
          <div><span>Merchandise</span><strong><%= doc.currency %> <%= docValue.toFixed(2) %></strong></div>
        </div>
        <div class="notice" style="margin-top:16px;max-width:700px;">
          <%- helpers.icon('document', { size: 16 }) %>
          <span>This file calls the vendor's product identifier <strong><%= setupDocument.detectedSupplierCodeLabel %></strong>. Foundry read every value in that column as the vendor's code.</span>
        </div>
        <label class="field document-vocabulary" style="margin-top:16px;max-width:620px;">
          <span class="field-label">What do you want Foundry to call that field for <%= doc.supplierName || 'this vendor' %>?</span>
          <input class="input" type="text" name="supplierCodeLabel" value="<%= docCodeLabel %>" maxlength="60" required data-vendor-code-label-input>
          <span class="field-help">Examples: Style #, Item No., Vendor SKU, or Catalogue number. Set it once. Future documents from this vendor may use different headings; Foundry will recognize them as the same field and keep showing your chosen name.</span>
        </label>
        <div class="table-wrap" style="margin-top:16px;">
          <table class="table table--stack table--tight">
            <thead><tr><th>Style</th><th>Color</th><th>Size</th><th data-vendor-code-label><%= docCodeLabel %></th><th class="right">Qty</th><th class="right">Unit cost</th></tr></thead>
            <tbody>
              <% docLines.forEach(function (line) { %>
                <tr>
                  <td class="cell-main"><span class="cell-title"><%= line.styleName %></span></td>
                  <td data-label="Color"><%= line.color || '—' %></td>
                  <td data-label="Size"><%= line.size || '—' %></td>
                  <td data-label="<%= docCodeLabel %>" data-vendor-code-cell class="mono"><%= line.supplierSku || '—' %></td>
                  <td data-label="Qty" class="right"><strong><%= line.quantity %></strong></td>
                  <td data-label="Unit cost" class="right"><%= line.unitCost == null ? '—' : doc.currency + ' ' + line.unitCost.toFixed(2) %></td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
        <% if (doc.warnings && doc.warnings.length) { %>
          <div class="notice notice--warn" style="margin-top:14px;"><%- helpers.icon('alert', { size: 16 }) %><span><%= doc.warnings.join(' ') %></span></div>
        <% } %>
      </div>
    </section>
  <% } %>

  <div class="proposal">
    <section class="proposal-block">
      <div class="proposal-label"><%= helpers.plural(2, term('item')) %></div>
      <div class="proposal-body">
        <h2>
          <% if (u.recommendedConfiguration.usesVariants && u.variantDimensions.length) { %>
            <%= u.variantDimensions.map(function (d) { return d.name; }).join(' → ') %>
          <% } else { %>
            <%= mode.label %>
          <% } %>
        </h2>
        <p><%= u.recommendedConfiguration.summary || mode.blurb %></p>
        <div class="badge-row">
          <span class="<%= helpers.trackingBadgeClass(u.recommendedConfiguration.trackingMode) %>"><%= mode.label %></span>
          <% if (u.recommendedConfiguration.usesVariants) { %><span class="badge badge--variant">Variants</span><% } %>
          <% if (u.expirationTracking.applies) { %><span class="badge badge--warn">Expiration dates</span><% } %>
        </div>
        <% if (u.variantDimensions.length) { %>
          <ul class="proposal-list">
            <% u.variantDimensions.forEach(function (dim) { %>
              <li><strong><%= dim.name %></strong> — <%= dim.exampleValues.join(', ') %></li>
            <% }) %>
          </ul>
        <% } %>
      </div>
    </section>

    <section class="proposal-block">
      <div class="proposal-label"><%= helpers.plural(2, term('location')) %></div>
      <div class="proposal-body">
        <% if (u.likelyLocations.length) { %>
          <ul class="proposal-list">
            <% u.likelyLocations.forEach(function (loc) { %>
              <li><strong><%= loc.name %></strong> <span class="muted">· <%= helpers.locationKindLabel(loc.kind) %></span></li>
            <% }) %>
          </ul>
          <p><%= u.locationModel.summary || 'Stock will be tracked separately at each location.' %></p>
        <% } else { %>
          <p>No locations mentioned yet — you can add them any time.</p>
        <% } %>
      </div>
    </section>

    <section class="proposal-block">
      <div class="proposal-label">Receiving</div>
      <div class="proposal-body"><p><%= u.receivingWorkflow || 'Stock is received into a location and counted from there.' %></p></div>
    </section>

    <% if (u.locationModel.transfersExpected) { %>
      <section class="proposal-block">
        <div class="proposal-label">Transfers</div>
        <div class="proposal-body"><p><%= u.transferWorkflow || 'Inventory can move between locations while preserving the full movement history.' %></p></div>
      </section>
    <% } %>

    <section class="proposal-block">
      <div class="proposal-label">Adjustments</div>
      <div class="proposal-body"><p><%= u.adjustmentWorkflow || 'Physical-count corrections require a reason and remain auditable.' %></p></div>
    </section>

    <% if (terms.length) { %>
      <section class="proposal-block">
        <div class="proposal-label">Wording</div>
        <div class="proposal-body">
          <p>Foundry will use your words:</p>
          <div class="badge-row">
            <% terms.forEach(function (key) { %>
              <span class="pill"><%= key %> → <strong><%= u.terminology[key] %></strong></span>
            <% }) %>
          </div>
        </div>
      </section>
    <% } %>
  </div>

  <% if (u.unresolvedDecisions.length) { %>
    <div class="card section">
      <div class="card-head">
        <%- helpers.icon('question', { size: 17 }) %>
        <h2><%= u.unresolvedDecisions.length === 1 ? 'One thing worth deciding' : 'A few things worth deciding' %></h2>
      </div>
      <div class="card-body">
        <% u.unresolvedDecisions.forEach(function (decision) { %>
          <fieldset class="decision">
            <legend><%= decision.question %></legend>
            <p class="hint"><%= decision.whyItMatters %></p>
            <div class="choice-grid">
              <% decision.options.forEach(function (option) { %>
                <label class="choice">
                  <input type="radio" name="answer_<%= decision.id %>" value="<%= option.id %>"
                         <%= option.id === decision.recommendedOptionId ? 'checked' : '' %>>
                  <span class="choice-body">
                    <strong>
                      <%= option.label %>
                      <% if (option.id === decision.recommendedOptionId) { %><span class="badge badge--ok">Foundry recommends</span><% } %>
                    </strong>
                    <span><%= option.consequence %></span>
                  </span>
                </label>
              <% }) %>
              <label class="choice choice--muted">
                <input type="radio" name="answer_<%= decision.id %>" value="__foundry__">
                <span class="choice-body">
                  <strong>Let Foundry decide</strong>
                  <span>Foundry picks the option it recommends and records that it decided.</span>
                </span>
              </label>
            </div>
          </fieldset>
        <% }) %>
      </div>
    </div>
  <% } %>

  <% if (configRecs.length || futureRecs.length) { %>
    <div class="card section">
      <div class="card-head"><h2>A few things I'd recommend</h2></div>
      <div class="card-body">
        <% if (configRecs.length) { %>
          <p class="muted" style="margin:0 0 12px;">
            Tick anything you want to act on. Ticking it does not change the setup
            below — it records that you agreed, and Foundry lists it on the next
            screen with what to do about it. Leaving one unticked simply means no.
          </p>
        <% } %>
        <% configRecs.forEach(function (rec) { %>
          <label class="rec">
            <input type="checkbox" name="acceptRecommendation" value="<%= rec.id %>">
            <span class="rec-body">
              <strong><%= rec.title %></strong>
              <span class="rec-noticed">I noticed: <%= rec.noticed %></span>
              <span><%= rec.recommendation %></span>
              <span class="rec-why">Why it matters: <%= rec.why_it_matters %></span>
            </span>
          </label>
        <% }) %>

        <% if (futureRecs.length) { %>
          <div class="rec-future">
            <h3>Not available yet</h3>
            <% futureRecs.forEach(function (rec) { %>
              <div class="rec rec--future">
                <span class="rec-body">
                  <strong><%= rec.title %> <span class="badge badge--muted">Future</span></strong>
                  <span class="rec-noticed">I noticed: <%= rec.noticed %></span>
                  <span><%= rec.recommendation %></span>
                  <span class="rec-why">Why it matters: <%= rec.why_it_matters %></span>
                </span>
              </div>
            <% }) %>
          </div>
        <% } %>
      </div>
    </div>
  <% } %>

  <% if (u.assumptions.length) { %>
    <div class="card section">
      <div class="card-head"><h2>What I assumed</h2></div>
      <div class="card-body">
        <ul class="proposal-list">
          <% u.assumptions.forEach(function (assumption) { %><li><%= assumption %></li><% }) %>
        </ul>
      </div>
    </div>
  <% } %>

  <div class="foundry-confirm">
    <div>
      <strong>Ready when you are.</strong>
      <% if (doc) { %>
        <span class="muted">This approval creates the shown structure and records <%= docUnits %> <%= docUnitText %> from <%= setupDocument.sourceName %> as received inventory.</span>
      <% } else { %>
      <span class="muted">Foundry sets up structure only — no products, stock or serial numbers are invented.</span>
      <% } %>
    </div>
    <div class="btn-row">
      <a class="btn" href="/foundry">Start over</a>
      <% if (currentUser.role === 'owner') { %>
        <button class="btn btn--primary btn--lg" type="submit"><%= doc ? 'Configure and add ' + docUnits + ' ' + docUnitText : 'Configure my inventory' %></button>
      <% } else { %>
        <span class="muted">Only an owner can apply this.</span>
      <% } %>
    </div>
  </div>
</form>
