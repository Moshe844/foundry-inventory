<%
  var u = understanding;
  var mode = helpers.TRACKING_MODES[u.recommendedConfiguration.trackingMode];
  var configRecs = recommendations.filter(function (r) { return r.scope === 'configuration'; });
  var futureRecs = recommendations.filter(function (r) { return r.scope === 'future'; });
  var terms = Object.keys(u.terminology || {}).filter(function (k) { return u.terminology[k]; });
  var doc = setupDocument && setupDocument.interpretation;
  var docLines = doc ? doc.lines : [];
  var docUnits = docLines.reduce(function (sum, line) { return sum + line.quantity; }, 0);
  var docUnitText = doc ? helpers.unitLabel(docUnits, doc.unitLabel || 'unit') : 'units';
  var docValue = docLines.reduce(function (sum, line) { return sum + (line.unitCost == null ? 0 : line.quantity * line.unitCost); }, 0);
  var docStyles = new Set(docLines.map(function (line) { return [line.styleName, line.color].filter(Boolean).join(' / ').toLowerCase(); })).size;
  var docCodeLabel = setupDocument ? setupDocument.supplierCodeLabel : 'Supplier code';
  var addingToExisting = Boolean(doc && alreadyConfigured);
%>

<div class="foundry-hero foundry-hero--tight">
  <span class="foundry-mark"><%- helpers.icon('foundry', { size: 22 }) %></span>
  <h1><%= addingToExisting ? "Here's what Foundry read from your file" : "Here's how I'd organize your inventory" %></h1>
  <% if (u.businessDescription) { %>
    <details class="foundry-quote-fold">
      <summary>How Foundry described this file</summary>
      <p class="foundry-quote">“<%= u.businessDescription %>”</p>
    </details>
  <% } %>
</div>

<form method="post" action="/foundry/proposal/<%= understandingId %>/configure">
  <input type="hidden" name="_csrf" value="<%= csrfToken %>">

  <%#
    What this document means, before anything about what Foundry would build.

    The order is the point. A summary of products and quantities looks identical
    whether the goods exist or not, so somebody approving an import read one and
    assumed the other — a proforma invoice for shoes still being made became 800
    pairs on the shelf and $21,390 of inventory asset.

    So the page says what the paper proves, what Foundry will change, and what it
    is deliberately leaving alone, and only then describes the catalogue.
  %>
  <% if (locals.documentMeaning) { var dm = documentMeaning; %>
    <section class="doc-meaning">
      <p class="eyebrow">What I think this is</p>
      <h2><%= dm.headline %></h2>
      <p class="doc-meaning-because"><%= dm.means %>.</p>

      <div class="doc-meaning-grid">
        <div class="doc-panel">
          <h3>What I found</h3>
          <ul>
            <% dm.found.forEach(function (f) { %><li><%= f %></li><% }) %>
          </ul>
        </div>

        <div class="doc-panel doc-panel--will">
          <h3>What I'll do</h3>
          <% if (dm.willDo.length) { %>
            <ul>
              <% dm.willDo.forEach(function (d) { %><li><%= d %></li><% }) %>
            </ul>
          <% } else { %>
            <p class="t-muted">Nothing yet — see what I need from you.</p>
          <% } %>
        </div>

        <% if (dm.wontDo.length) { %>
          <div class="doc-panel doc-panel--wont">
            <h3>What I will <em>not</em> do</h3>
            <ul>
              <% dm.wontDo.forEach(function (d) { %>
                <li><strong><%= d.what %></strong><span class="t-xs t-muted"><%= d.why %></span></li>
              <% }) %>
            </ul>
          </div>
        <% } %>
      </div>

      <% if (dm.totals.goodsMinor || dm.totals.chargesMinor) { %>
        <%#
          The whole bill, not just the products. These figures used to be thrown
          away at extraction, so a document totalling one number imported as
          another and the difference was nowhere on the page.
        %>
        <table class="table doc-money">
          <tbody>
            <tr><td>Goods</td><td class="num"><%= helpers.money(dm.totals.goodsMinor, dm.totals.currency) %></td></tr>
            <% (setupDocument.interpretation.charges || []).forEach(function (c) { %>
              <tr><td><%= c.label %> <span class="t-xs t-muted">· <%= c.kind %></span></td>
                <td class="num"><%= helpers.money(c.amountMinor, dm.totals.currency) %></td></tr>
            <% }) %>
            <tr class="doc-money-total">
              <td><strong>Total on this document</strong></td>
              <td class="num"><strong><%= helpers.money(dm.totals.goodsMinor + dm.totals.chargesMinor, dm.totals.currency) %></strong></td>
            </tr>
            <% if (dm.totals.statedTotalMinor !== null) {
                 var reckoned = dm.totals.goodsMinor + dm.totals.chargesMinor; %>
              <tr>
                <td colspan="2" class="t-xs t-muted">
                  The document itself states <%= helpers.money(dm.totals.statedTotalMinor, dm.totals.currency) %><%
                    if (reckoned !== dm.totals.statedTotalMinor) { %> — <%= helpers.money(Math.abs(dm.totals.statedTotalMinor - reckoned), dm.totals.currency)
                    %> away from the lines above. Foundry has not adjusted anything to make them agree.<% } else { %>, and these lines come to the same.<% } %>
                </td>
              </tr>
            <% } %>
          </tbody>
        </table>
      <% } %>

      <% if (dm.needsYou.length) { %>
        <div class="doc-panel doc-panel--asks">
          <h3>What I need from you</h3>
          <% dm.needsYou.forEach(function (n) { %>
            <div class="doc-ask">
              <p class="doc-ask-q"><%= n.question %></p>
              <% if (n.because) { %><p class="t-xs t-muted"><%= n.because %></p><% } %>
            </div>
          <% }) %>
          <p class="t-xs t-muted">The answer is at the bottom of this page, once you have seen what it would do.</p>
        </div>
      <% } %>
    </section>
  <% } %>


  <% if (doc && scopeWarning && scopeWarning.needsConfirmation && !setupDocument.scopeConfirmedAt) { %>
    <dialog class="modal scope-warning" open data-scope-warning aria-labelledby="scope-warning-title">
      <div class="modal-head"><h2 id="scope-warning-title">This file looks different from <%= scopeWarning.workspaceName %></h2></div>
      <div class="modal-body">
        <p><%= scopeWarning.message %></p>
        <div class="scope-warning__compare">
          <div><span>Already here<% if (scopeWarning.currentProductCount > scopeWarning.currentExamples.length) { %> — showing 4 of <%= scopeWarning.currentProductCount %><% } %></span><strong><%= scopeWarning.currentExamples.join(', ') %></strong></div>
          <div><span>In this file<% if (scopeWarning.incomingProductCount > scopeWarning.incomingExamples.length) { %> — showing 4 of <%= scopeWarning.incomingProductCount %><% } %></span><strong><%= scopeWarning.incomingExamples.join(', ') %></strong></div>
        </div>
        <p class="muted">Foundry has read the file, but nothing has been added. Continue only if these records belong in the inventory currently open.</p>
      </div>
      <div class="modal-foot">
        <a class="btn" href="/">Cancel</a>
        <button class="btn btn--primary" type="submit" name="scopeDecision" value="confirm" formnovalidate>Continue with <%= scopeWarning.workspaceName %></button>
      </div>
    </dialog>
  <% } else if (doc && scopeWarning && scopeWarning.needsConfirmation && setupDocument.scopeConfirmedAt) { %>
    <div class="notice notice--warn section"><%- helpers.icon('alert', { size: 16 }) %><span>You confirmed that this file belongs in <strong><%= scopeWarning.workspaceName %></strong>. Nothing changes until you approve the exact records below.</span></div>
  <% } %>

  <% if (doc) { %>
    <section class="card section setup-document-preview">
      <div class="card-head">
        <%- helpers.icon('document', { size: 18 }) %>
        <div>
          <h2>What Foundry read from <%= setupDocument.sourceName %></h2>
          <p class="hint"><%= doc.documentType.replace('_', ' ') %><% if (doc.documentNumber) { %> · <%= doc.documentNumber %><% } %><% if (doc.documentDate) { %> · <%= doc.documentDate %><% } %></p>
        </div>
        <span class="badge badge--ok" style="margin-left:auto;">Read from file</span>
      </div>
      <div class="card-body">
        <div class="document-facts">
          <div><span>Supplier</span><strong><%= doc.supplierName || 'Not shown' %></strong></div>
          <div><span>Stock goes to</span><strong><%= doc.destinationName %></strong></div>
          <div><span>Inventory</span><strong><%= docUnits %> <%= docUnitText %> · <%= docStyles %> styles · <%= docLines.length %> variants</strong></div>
          <div><span>Merchandise</span><strong><%= doc.currency %> <%= docValue.toFixed(2) %></strong></div>
        </div>
        <div class="notice" style="margin-top:16px;max-width:700px;">
          <%- helpers.icon('document', { size: 16 }) %>
          <span>This file calls the vendor's product identifier <strong><%= setupDocument.detectedSupplierCodeLabel %></strong>. Foundry read every value in that column as the vendor's code.</span>
        </div>
        <label class="field document-vocabulary" style="margin-top:16px;max-width:620px;">
          <span class="field-label">What do you want Foundry to call that field for <%= doc.supplierName || 'this vendor' %>?</span>
          <input class="input" type="text" name="supplierCodeLabel" value="<%= docCodeLabel %>" maxlength="60" required data-vendor-code-label-input>
          <span class="field-help">Examples: Style #, Item No., Vendor SKU, or Catalogue number. Set it once. Future documents from this vendor may use different headings; Foundry will recognize them as the same field and keep showing your chosen name.</span>
        </label>
        <%#
          Forty-one rows of size run is a reference table, not a thing anybody
          reads top to bottom. The totals above already say what it comes to;
          this is here for the person who wants to check a line.
        %>
        <details class="doc-lines-fold" <%= docLines.length <= 8 ? 'open' : '' %>>
          <summary>
            <%= docLines.length %> line<%= docLines.length === 1 ? '' : 's' %> read from the file
            — <%= docUnits %> <%= docUnitText %>, <%= docStyles %> style<%= docStyles === 1 ? '' : 's' %>
          </summary>
        <div class="table-wrap" style="margin-top:16px;">
          <table class="table table--stack table--tight">
            <thead><tr><th>Style</th><th>Color</th><th>Size</th><th data-vendor-code-label><%= docCodeLabel %></th><th>Foundry action</th><th class="right">Qty</th><th class="right">Unit cost</th></tr></thead>
            <tbody>
              <% docLines.forEach(function (line, lineIndex) { var documentMatch = documentMatches[lineIndex]; %>
                <tr>
                  <td class="cell-main"><span class="cell-title"><%= line.styleName %></span></td>
                  <td data-label="Color"><%= line.color || '—' %></td>
                  <td data-label="Size"><%= line.size || '—' %></td>
                  <td data-label="<%= docCodeLabel %>" data-vendor-code-cell class="mono"><%= line.supplierSku || '—' %></td>
                  <td data-label="Foundry action"><span class="badge <%= documentMatch && documentMatch.status === 'match' ? 'badge--ok' : 'badge--muted' %>"><%= documentMatch ? documentMatch.label : 'Create as new' %></span></td>
                  <% if (line.locationQuantities && line.locationQuantities.length) { %><td data-label="Locations" colspan="2"><%= line.locationQuantities.map(function(entry) { return entry.locationName + ': ' + entry.quantity; }).join(' · ') %></td><% } else { %>
                  <td data-label="Qty" class="right"><strong><%= line.quantity %></strong></td>
                  <td data-label="Unit cost" class="right"><%= line.unitCost == null ? '—' : doc.currency + ' ' + line.unitCost.toFixed(2) %></td>
                  <% } %>
                </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
        </details>
      </div>
    </section>
  <% } %>

  <div class="proposal">
    <section class="proposal-block">
      <div class="proposal-label"><%= helpers.plural(2, term('item')) %></div>
      <div class="proposal-body">
        <h2>
          <% if (u.recommendedConfiguration.usesVariants && u.variantDimensions.length) { %>
            <%= u.variantDimensions.map(function (d) { return d.name; }).join(' → ') %>
          <% } else { %>
            <%= mode.label %>
          <% } %>
        </h2>
        <p><%= u.recommendedConfiguration.summary || mode.blurb %></p>
        <div class="badge-row">
          <span class="<%= helpers.trackingBadgeClass(u.recommendedConfiguration.trackingMode) %>"><%= mode.label %></span>
          <% if (u.recommendedConfiguration.usesVariants) { %><span class="badge badge--variant">Variants</span><% } %>
          <% if (u.expirationTracking.applies) { %><span class="badge badge--warn">Expiration dates</span><% } %>
        </div>
        <% if (u.variantDimensions.length) { %>
          <ul class="proposal-list">
            <% u.variantDimensions.forEach(function (dim) { %>
              <li><strong><%= dim.name %></strong> — <%= dim.exampleValues.join(', ') %></li>
            <% }) %>
          </ul>
        <% } %>
      </div>
    </section>

    <section class="proposal-block">
      <div class="proposal-label"><%= helpers.plural(2, term('location')) %></div>
      <div class="proposal-body">
        <% if (u.likelyLocations.length) { %>
          <ul class="proposal-list">
            <% u.likelyLocations.forEach(function (loc) { %>
              <li><strong><%= loc.name %></strong> <span class="muted">· <%= helpers.locationKindLabel(loc.kind) %></span></li>
            <% }) %>
          </ul>
          <p><%= u.locationModel.summary || 'Stock will be tracked separately at each location.' %></p>
        <% } else { %>
          <p>No locations mentioned yet — you can add them any time.</p>
        <% } %>
      </div>
    </section>

    <section class="proposal-block">
      <div class="proposal-label">Receiving</div>
      <div class="proposal-body"><p><%= u.receivingWorkflow || 'Stock is received into a location and counted from there.' %></p></div>
    </section>

    <% if (u.locationModel.transfersExpected) { %>
      <section class="proposal-block">
        <div class="proposal-label">Transfers</div>
        <div class="proposal-body"><p><%= u.transferWorkflow || 'Inventory can move between locations while preserving the full movement history.' %></p></div>
      </section>
    <% } %>

    <section class="proposal-block">
      <div class="proposal-label">Adjustments</div>
      <div class="proposal-body"><p><%= u.adjustmentWorkflow || 'Physical-count corrections require a reason and remain auditable.' %></p></div>
    </section>

    <% if (terms.length) { %>
      <section class="proposal-block">
        <div class="proposal-label">Wording</div>
        <div class="proposal-body">
          <p>Foundry will use your words:</p>
          <div class="badge-row">
            <% terms.forEach(function (key) { %>
              <span class="pill"><%= key %> → <strong><%= u.terminology[key] %></strong></span>
            <% }) %>
          </div>
        </div>
      </section>
    <% } %>
  </div>

  <% if (!addingToExisting) { %>
    <section class="card section">
      <%#
        True, and not a decision. It was six paragraphs of what Foundry can do
        sitting between somebody and the button they came here to press.
      %>
      <div class="card-head"><div><p class="eyebrow">The whole business stays connected</p>
        <h2>What starts working after this setup</h2>
        <p class="hint">This page chooses how stock is organized. The rest of Foundry is already built in and updates from the same verified activity.</p></div></div>
      <div class="card-body">
        <div class="explain-grid">
          <div><strong>Inventory</strong><p>Receipts, sales, transfers and counts keep physical stock current.</p></div>
          <div><strong>Customer orders</strong><p>Confirmed orders hold available stock; fulfilment updates inventory and the customer balance.</p></div>
          <div><strong>Purchasing</strong><p>Foundry calculates replenishment, prepares supplier orders and keeps incoming quantities separate from stock already here.</p></div>
          <div><strong>Supplier email</strong><p>Connect Gmail or Microsoft 365 and approve the supplier sender; Foundry then matches replies, invoices and shipment updates.</p></div>
          <div><strong>Accounting</strong><p>It is on automatically. Verified receipts, bills, sales and payments update what you own, owe, earned and received—without starting Accounting manually.</p></div>
          <div><strong>Needs you</strong><p>Foundry handles supported routine work and asks only when evidence, authority or a real business decision is missing.</p></div>
        </div>
      </div>
    </section>
  <% } %>

  <% if (u.unresolvedDecisions.length) { %>
    <div class="card section">
      <div class="card-head">
        <%- helpers.icon('question', { size: 17 }) %>
        <h2><%= u.unresolvedDecisions.length === 1 ? 'One thing worth deciding' : 'A few things worth deciding' %></h2>
      </div>
      <div class="card-body">
        <% u.unresolvedDecisions.forEach(function (decision) { %>
          <fieldset class="decision">
            <legend><%= decision.question %></legend>
            <p class="hint"><%= decision.whyItMatters %></p>
            <div class="choice-grid">
              <% decision.options.forEach(function (option) { %>
                <label class="choice">
                  <input type="radio" name="answer_<%= decision.id %>" value="<%= option.id %>"
                         <%= option.id === decision.recommendedOptionId ? 'checked' : '' %>>
                  <span class="choice-body">
                    <strong>
                      <%= option.label %>
                      <% if (option.id === decision.recommendedOptionId) { %><span class="badge badge--ok">Foundry recommends</span><% } %>
                    </strong>
                    <span><%= option.consequence %></span>
                  </span>
                </label>
              <% }) %>
              <label class="choice choice--muted">
                <input type="radio" name="answer_<%= decision.id %>" value="__foundry__">
                <span class="choice-body">
                  <strong>Let Foundry decide</strong>
                  <span>Foundry picks the option it recommends and records that it decided.</span>
                </span>
              </label>
            </div>
          </fieldset>
        <% }) %>
      </div>
    </div>
  <% } %>

  <% if (configRecs.length || futureRecs.length) { %>
    <div class="card section">
      <div class="card-head"><h2>A few things I'd recommend</h2></div>
      <div class="card-body">
        <% if (configRecs.length) { %>
          <p class="muted" style="margin:0 0 12px;">
            Tick anything you want to act on. Ticking it does not change the setup
            below — it records that you agreed, and Foundry lists it on the next
            screen with what to do about it. Leaving one unticked simply means no.
          </p>
        <% } %>
        <% configRecs.forEach(function (rec) { %>
          <label class="rec">
            <input type="checkbox" name="acceptRecommendation" value="<%= rec.id %>">
            <span class="rec-body">
              <strong><%= rec.title %></strong>
              <span class="rec-noticed">I noticed: <%= rec.noticed %></span>
              <span><%= rec.recommendation %></span>
              <span class="rec-why">Why it matters: <%= rec.why_it_matters %></span>
            </span>
          </label>
        <% }) %>

        <% if (futureRecs.length) { %>
          <div class="rec-future">
            <h3>Not available yet</h3>
            <% futureRecs.forEach(function (rec) { %>
              <div class="rec rec--future">
                <span class="rec-body">
                  <strong><%= rec.title %> <span class="badge badge--muted">Future</span></strong>
                  <span class="rec-noticed">I noticed: <%= rec.noticed %></span>
                  <span><%= rec.recommendation %></span>
                  <span class="rec-why">Why it matters: <%= rec.why_it_matters %></span>
                </span>
              </div>
            <% }) %>
          </div>
        <% } %>
      </div>
    </div>
  <% } %>

  <%
    var caveats = [];
    (u.assumptions || []).forEach(function (line) { caveats.push(String(line).trim()); });
    ((doc && doc.warnings) || []).forEach(function (line) {
      var clean = String(line).trim();
      // The extractor's warnings and the understanding's assumptions are the
      // same sentences more often than not. One copy is a caveat; two is noise.
      if (caveats.indexOf(clean) === -1) caveats.push(clean);
    });
    caveats = caveats.filter(Boolean);
  %>
  <% if (caveats.length) { %>
    <details class="card section proposal-caveats">
      <summary>
        <%= caveats.length %> thing<%= caveats.length === 1 ? '' : 's' %> Foundry had to assume
        or could not read cleanly
      </summary>
      <div class="card-body">
        <ul class="proposal-list">
          <% caveats.forEach(function (caveat) { %><li><%= caveat %></li><% }) %>
        </ul>
      </div>
    </details>
  <% } %>

  <%
    // Does approving this actually put stock on a shelf? The document says so
    // or it does not, and the button has to agree with the answer.
    var arrivesAsStock = Boolean(doc) && (locals.documentMeaning
      ? Boolean(documentMeaning.establishes && documentMeaning.establishes.onHand)
      : Boolean(doc.goodsHaveArrived));
    var askedOptions = (locals.documentMeaning && documentMeaning.needsYou.length
      && documentMeaning.needsYou[0].options) || [];
  %>
  <div class="foundry-confirm">
    <div>
      <strong><%= askedOptions.length ? 'What should Foundry do with this?' : 'Ready when you are.' %></strong>
      <% if (askedOptions.length) { %>
        <span class="muted">Three different answers, and they do different things. Nothing happens
          until you pick one.</span>
      <% } else if (!doc) { %>
        <span class="muted">Foundry sets up structure only — no products, stock or serial numbers are invented.</span>
      <% } else if (arrivesAsStock) { %>
        <span class="muted"><%= addingToExisting ? 'This adds the shown products and supplier records, then puts ' : 'This creates the shown structure and puts ' %><%= docUnits %> <%= docUnitText %> from <%= setupDocument.sourceName %> into stock, because the file is evidence they arrived.</span>
      <% } else { %>
        <span class="muted">This creates the products<%= doc.supplierName ? ' and records ' + doc.supplierName + ' as a supplier' : '' %>. <strong>No stock is added and no money is recorded as owed</strong> — <%= locals.documentMeaning ? documentMeaning.means : 'this file is not evidence that anything arrived' %>.</span>
      <% } %>
    </div>
    <div class="btn-row">
      <a class="btn" href="/foundry">Start over</a>
      <% if (currentUser.role !== 'owner') { %>
        <span class="muted">Only an owner can apply this.</span>
      <% } else if (askedOptions.length) { %>
        <%# Nothing here; the answers are laid out below with what each one does. %>
      <% } else { %>
        <button class="btn btn--primary btn--lg" type="submit"><%= doc
          ? (arrivesAsStock ? (addingToExisting ? 'Add ' : 'Set up and add ') + docUnits + ' ' + docUnitText + ' to stock'
             : 'Set up these products')
          : 'Configure my inventory' %></button>
      <% } %>
    </div>
  </div>

  <%#
    The answers, each saying what it does.

    Three bare buttons in a row asked somebody to guess the difference between
    "Place the order" and "This is what I already have in stock" — and the one
    sentence above them was true of two answers and flatly wrong about the
    third, which puts stock on the shelf. A choice this consequential gets its
    consequence written next to it.
  %>
  <% if (askedOptions.length && currentUser.role === 'owner') { %>
    <div class="doc-answers">
      <% askedOptions.forEach(function (option, index) { %>
        <button class="doc-answer <%= index === 0 ? 'is-primary' : '' %>"
          type="submit" name="documentIntent" value="<%= option.label || option %>">
          <strong><%= option.label || option %></strong>
          <% if (option.does) { %><span><%= option.does %></span><% } %>
        </button>
      <% }) %>
    </div>
  <% } %>
</form>
