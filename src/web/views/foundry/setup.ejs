<div class="foundry-hero">
  <span class="foundry-mark"><%- helpers.icon('foundry', { size: 26 }) %></span>
  <h1>Give Foundry what you already have</h1>
  <p>
    Start with an invoice or inventory sheet in the format you already have. Foundry reads
    the actual file, works out the inventory structure and opening transaction, then shows you exactly
    what it will create before anything changes.
  </p>
  <% if (typeof otherWorkspaces !== 'undefined' && otherWorkspaces > 0) { %>
    <p class="muted" style="font-size:13px;">
      This is a separate inventory. Nothing here is shared with the
      <%= otherWorkspaces %> you already have.
    </p>
  <% } %>
</div>

<% if (!aiConfigured) { %>
  <div class="notice notice--warn" style="max-width:760px;margin:0 auto 16px;">
    <%- helpers.icon('alert', { size: 16 }) %>
    <span>
      Foundry is not connected to a model provider yet. Add <code class="mono">ANTHROPIC_API_KEY</code>
      to your <code class="mono">.env</code> file and restart, or set things up manually below.
    </span>
  </div>
<% } %>

<% if (error) { %>
  <div class="flash flash--error" role="alert" style="max-width:760px;margin:0 auto 16px;">
    <%- helpers.icon('alert', { size: 18 }) %><span><%= error %></span>
  </div>
<% } %>

<form class="foundry-form" method="post" action="/foundry/understand" enctype="multipart/form-data" data-busy>
  <input type="hidden" name="_csrf" value="<%= csrfToken %>">
  <div class="card">
    <div class="card-body">
      <div class="foundry-source">
        <span class="foundry-source__icon"><%- helpers.icon('import', { size: 22 }) %></span>
        <span class="foundry-source__body">
          <strong data-source-name>Add the file you already use</strong>
          <span>PDF, Word (.docx), Excel, CSV, TSV, or text · up to 32 MB</span>
          <span class="foundry-source__truth">The file is read as evidence. Foundry never guesses quantities that are not in it.</span>
        </span>
        <button class="btn" type="button" data-source-picker>Choose file</button>
        <input id="source" name="source" type="file" accept=".pdf,.docx,.xlsx,.xls,.csv,.tsv,.txt,application/pdf" hidden>
      </div>

      <div class="foundry-divider"><span>or describe it in your own words</span></div>
      <label class="visually-hidden" for="description">Describe your inventory</label>
      <textarea class="textarea foundry-input" id="description" name="description" rows="4"
                placeholder="We wholesale children's shoes. Every style comes in colors and sizes. We keep stock in Brooklyn and New Jersey and transfer between them."><%= description %></textarea>
      <div class="foundry-actions">
        <button class="btn btn--primary btn--lg" type="submit" <%= aiConfigured ? '' : 'disabled' %>>
          <%- helpers.icon('foundry', { size: 17 }) %> Understand my inventory
        </button>
        <span class="foundry-hint">One preview. One approval. Then the products, supplier, order, and stock are live.</span>
      </div>
    </div>
  </div>
</form>

<div class="foundry-examples">
  <h2>Things people tell Foundry</h2>
  <div class="example-grid">
    <button class="example" type="button" data-fill="We wholesale children's shoes in different styles, colors and sizes across two warehouses.">
      “We wholesale children's shoes in different styles, colors and sizes across two warehouses.”
    </button>
    <button class="example" type="button" data-fill="We rent construction equipment and need to track every machine individually.">
      “We rent construction equipment and need to track every machine individually.”
    </button>
    <button class="example" type="button" data-fill="We distribute food and need lot numbers and expiration dates.">
      “We distribute food and need lot numbers and expiration dates.”
    </button>
    <button class="example" type="button" data-fill="We're a school tracking laptops assigned to students.">
      “We're a school tracking laptops assigned to students.”
    </button>
  </div>
</div>

<div class="foundry-alt">
  <form method="post" action="/foundry/manual">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <button class="btn btn--ghost" type="submit">Set it up manually instead</button>
  </form>
  <span class="muted">You can always ask Foundry later.</span>
</div>
