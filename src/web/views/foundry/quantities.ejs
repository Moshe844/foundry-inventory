<div class="foundry-hero foundry-hero--tight">
  <span class="foundry-mark foundry-mark--done"><%- helpers.icon('check', { size: 24 }) %></span>
  <h1>Your products are ready</h1>
  <p>
    <strong><%= item.name %></strong> is live with
    <strong><%= skuCount %></strong> trackable <%= skuCount === 1 ? 'item' : 'variants' %>
    across <strong><%= locations.length %></strong> <%= locations.length === 1 ? 'location' : 'locations' %>.
  </p>
</div>

<section class="card quantity-takeover">
  <div class="card-head">
    <div>
      <span class="setup-eyebrow">One last setup step</span>
      <h2>How should we get your current quantities into Foundry?</h2>
    </div>
  </div>
  <div class="card-body">
    <div class="quantity-status">
      <span>Currently recorded</span>
      <strong><%= total %> <%= total === 1 ? 'unit' : 'units' %></strong>
      <span>Foundry will never invent what is on your shelves.</span>
    </div>

    <div class="quantity-options">
      <% if (canEnterGrid) { %>
        <form class="quantity-option quantity-option--primary opening-grid" method="post" action="/foundry/quantities/<%= item.id %>/save">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <div class="opening-grid__head">
            <span class="quantity-option__icon"><%- helpers.icon('inventory', { size: 20 }) %></span>
            <div><h3>Type quantities yourself</h3><p>Enter what is physically on hand now. Leave a box empty if there is none at that location.</p></div>
          </div>
          <div class="table-wrap"><table class="table table--tight">
            <thead><tr><th>Variant</th><% locations.forEach(function (location) { %><th><%= location.name %></th><% }) %></tr></thead>
            <tbody><% skus.forEach(function (sku) { %><tr>
              <td><strong><%= sku.variant_label || item.name %></strong><small class="mono"><%= sku.code %></small></td>
              <% locations.forEach(function (location) { %><td>
                <input type="hidden" name="skuId" value="<%= sku.id %>">
                <input type="hidden" name="locationId" value="<%= location.id %>">
                <input class="input input--qty" type="number" min="0" step="1" name="quantity" aria-label="<%= sku.variant_label || item.name %> at <%= location.name %>" placeholder="0">
              </td><% }) %>
            </tr><% }) %></tbody>
          </table></div>
          <div><button class="btn btn--primary" type="submit">Save opening inventory</button></div>
        </form>
      <% } %>

      <div class="quantity-option quantity-option--primary">
        <span class="quantity-option__icon"><%- helpers.icon('foundry', { size: 20 }) %></span>
        <div>
          <h3>Tell Foundry</h3>
          <p>Describe what is on hand in ordinary language. Foundry will translate it, preview the exact changes, and ask for approval.</p>
          <form class="ask-form" method="post" action="/actions/ask" data-busy data-ask-form>
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <input class="input ask-input" type="text" name="instruction"
                   placeholder="Tell Foundry what is on hand and where it is…"
                   maxlength="500" autocomplete="off" autofocus>
            <button class="btn btn--primary" type="submit">Preview quantities</button>
          </form>
        </div>
      </div>

      <a class="quantity-option" href="/imports">
        <span class="quantity-option__icon"><%- helpers.icon('import', { size: 20 }) %></span>
        <div><h3>Upload Excel</h3><p>Give Foundry a spreadsheet or CSV and let it work out the quantities.</p></div>
        <%- helpers.icon('chevron', { size: 16 }) %>
      </a>

      <% if (!canEnterGrid) { %><a class="quantity-option" href="/inventory/<%= item.id %>?action=receive">
        <span class="quantity-option__icon"><%- helpers.icon('receive', { size: 20 }) %></span>
        <div><h3>Type quantities yourself</h3><p>Enter what you currently have for each variant and location.</p></div>
        <%- helpers.icon('chevron', { size: 16 }) %>
      </a><% } %>
    </div>
  </div>
  <div class="card-foot quantity-complete">
    <span class="muted">Already entered everything, or starting with no stock?</span>
    <form method="post" action="/foundry/quantities/complete">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <button class="btn" type="submit">Finish setup and let Foundry manage it</button>
    </form>
  </div>
</section>
