<%
  var s = summary || {};
  var mode = helpers.TRACKING_MODES[plan.inventoryModel.primaryArchetype];
  var created = s.locationsCreated || [];
  var existing = s.locationsAlreadyPresent || [];
  var locationCount = created.length + existing.length;
  var imported = setupDocument && setupDocument.result;
%>

<div class="foundry-hero foundry-hero--tight">
  <span class="foundry-mark foundry-mark--done"><%- helpers.icon('check', { size: 24 }) %></span>
  <h1>Your inventory is ready</h1>
  <p>Foundry configured the inventory engine. Everything below is live now.</p>
</div>

<% if (imported) { %>
  <div class="card ready-card" style="margin-bottom:16px;border-color:var(--accent-line);">
    <div class="card-head">
      <%- helpers.icon('check', { size: 17 }) %>
      <h2><%= setupDocument.sourceName %> is now inventory truth</h2>
    </div>
    <div class="card-body">
      <ul class="ready-list">
        <li><%- helpers.icon('check', { size: 16 }) %><span><strong><%= imported.products %></strong> products and <strong><%= imported.variants %></strong> variants created from the file</span></li>
        <li><%- helpers.icon('check', { size: 16 }) %><span><strong><%= imported.units %></strong> <%= helpers.plural(imported.units, imported.unitLabel || 'unit') %> received into <strong><%= imported.location %></strong></span></li>
        <li><%- helpers.icon('check', { size: 16 }) %><span><strong><%= imported.supplier %></strong> linked as supplier with its codes and unit costs</span></li>
        <li><%- helpers.icon('check', { size: 16 }) %><span>This file called the vendor identifier <strong><%= imported.detectedSupplierCodeLabel || setupDocument.detectedSupplierCodeLabel %></strong>. Foundry will call it <strong><%= imported.itemCodeLabel || setupDocument.supplierCodeLabel %></strong> for <%= imported.supplier %> and recognize alternate headings on future documents.</span></li>
        <li><%- helpers.icon('check', { size: 16 }) %><span>Purchase order <strong><%= imported.poNumber %></strong> recorded, approved, and fully received</span></li>
      </ul>
    </div>
    <div class="card-foot ready-next">
      <span class="muted">Every quantity is backed by a receipt and inventory movement.</span>
      <span class="btn-row" style="margin-left:auto;">
        <a class="btn" href="/purchasing/orders/<%= imported.purchaseOrderId %>">See the order</a>
        <a class="btn btn--primary" href="/inventory">See live inventory</a>
      </span>
    </div>
  </div>
<% } %>

<div class="card ready-card">
  <div class="card-body">
    <ul class="ready-list">
      <% if (locationCount) { %>
        <li><%- helpers.icon('check', { size: 16 }) %>
          <span><strong><%= locationCount %></strong> <%= helpers.plural(locationCount, term('location').toLowerCase()) %> configured
            <span class="muted">— <%= created.concat(existing.map(function (n) { return { name: n }; })).map(function (l) { return l.name; }).join(', ') %></span>
          </span>
        </li>
      <% } %>

      <li><%- helpers.icon('check', { size: 16 }) %>
        <span>
          <% if (plan.inventoryModel.usesVariants && plan.variantDimensions.length) { %>
            <%= helpers.plural(2, term('item')) %> use <strong><%= plan.variantDimensions.map(function (d) { return d.name; }).join(' → ') %></strong> variants
          <% } else { %>
            <%= helpers.plural(2, term('item')) %> are tracked by <strong><%= mode.label.toLowerCase() %></strong>
          <% } %>
        </span>
      </li>

      <li><%- helpers.icon('check', { size: 16 }) %>
        <span>
          <% if (plan.inventoryModel.usesVariants) { %>
            Quantity tracked separately by variant and <%= term('location').toLowerCase() %>
          <% } else if (plan.serialRules.enabled) { %>
            Every unit tracked individually, and never in two places at once
          <% } else if (plan.lotRules.enabled) { %>
            Quantity tracked by lot and <%= term('location').toLowerCase() %>
          <% } else { %>
            Quantity tracked separately at each <%= term('location').toLowerCase() %>
          <% } %>
        </span>
      </li>

      <% if (plan.expirationRules.enabled) { %>
        <li><%- helpers.icon('check', { size: 16 }) %><span>Expiration dates captured when stock is received</span></li>
      <% } %>

      <% if (plan.operationalDefaults.transfersEnabled && locationCount > 1) { %>
        <li><%- helpers.icon('check', { size: 16 }) %><span>Transfers enabled between <%= helpers.plural(2, term('location').toLowerCase()) %></span></li>
      <% } %>

      <li><%- helpers.icon('check', { size: 16 }) %><span>Physical adjustments require a reason</span></li>

      <% if (!plan.operationalDefaults.allowNegativeStock) { %>
        <li><%- helpers.icon('check', { size: 16 }) %><span>Stock cannot go negative</span></li>
      <% } %>
    </ul>
  </div>

  <div class="card-foot ready-next">
    <span class="muted">Configuration version <%= plan.configurationVersion %></span>
    <span class="btn-row" style="margin-left:auto;">
      <a class="btn" href="/foundry">Ask Foundry something</a>
      <% if (!firstItem && !imported) { %>
        <a class="btn btn--primary" href="/inventory/new">Add my first <%= term('item').toLowerCase() %></a>
      <% } %>
    </span>
  </div>
</div>

<%# Finish the sentence: they named the product and its options, so offer to
    make it rather than handing back an empty inventory. %>
<% if (firstItem) { %>
  <form method="post" action="/foundry/first-item" class="card section" data-busy>
    <div class="card-head"><h2>Shall I create it?</h2></div>
    <div class="card-body">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <%# Deliberately the tidied name rather than the raw example Foundry worked
          from: "you described Baby headband - White, 0-6 months" is not what
          they said, and reads as though it misheard them. %>
      <p class="lede">
        <% if (firstItem.combinations > 1) { %>
          I can create <strong><%= firstItem.name %></strong> with all
          <%= firstItem.combinations %> combinations, ready to receive stock into.
        <% } else { %>
          I can create <strong><%= firstItem.name %></strong> now, ready to receive stock into.
        <% } %>
      </p>

      <label class="field">
        <span class="field-label">Call it</span>
        <input class="input" type="text" name="name" value="<%= firstItem.name %>" maxlength="80" required>
      </label>

      <% if (firstItem.options.length) { %>
        <table class="table table--tight">
          <tbody>
            <% firstItem.options.forEach(function (option) { %>
              <tr>
                <td><%= option.name %></td>
                <td><%= option.values.join(', ') %></td>
                <td class="num"><%= option.values.length %></td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      <% } %>

      <p class="muted">
        This creates the <%= term('item').toLowerCase() %><% if (firstItem.options && firstItem.options.length) { %> and its combinations<% } %>, and nothing else.
        Foundry does not know what is on your shelves yet, so every one starts at zero — you receive
        stock next, or bring it in from a spreadsheet.
      </p>
    </div>
    <div class="card-foot">
      <div class="btn-row">
        <button class="btn btn--primary" type="submit">
          Create <%= firstItem.name %><% if (firstItem.combinations > 1) { %> and its <%= firstItem.combinations %> combinations<% } %>
        </button>
        <a class="btn btn--ghost" href="/inventory/new">I'll set it up myself</a>
      </div>
    </div>
  </form>
<% } %>

<% if (acceptedRecommendations && acceptedRecommendations.length) { %>
  <div class="card section">
    <div class="card-head"><h2>What you asked Foundry to keep an eye on</h2></div>
    <div class="card-body">
      <p class="muted" style="margin-top:0;">
        These are not part of the configuration above — they are things you agreed
        with that need something from you before Foundry can act on them.
      </p>
      <ul class="ready-list">
        <% acceptedRecommendations.forEach(function (rec) { %>
          <li>
            <%- helpers.icon('alert', { size: 16 }) %>
            <span>
              <strong><%= rec.title %></strong><br>
              <span class="muted"><%= rec.recommendation %></span>
            </span>
          </li>
        <% }) %>
      </ul>
    </div>
  </div>
<% } %>

<% if (decisions && decisions.length) { %>
  <div class="card section">
    <div class="card-head"><h2>Decisions on record</h2></div>
    <div class="table-wrap">
      <table class="table table--stack">
        <thead><tr><th>Question</th><th>Answer</th><th class="right">Decided by</th></tr></thead>
        <tbody>
          <% decisions.forEach(function (d) { %>
            <tr>
              <td class="cell-main"><span class="cell-title"><%= d.question %></span></td>
              <td data-label="Answer"><%= d.answer_label %></td>
              <td class="right cell-end" data-label="Decided by">
                <span class="badge <%= d.decided_by === 'foundry' ? 'badge--variant' : '' %>"><%= d.decided_by === 'foundry' ? 'Foundry' : 'You' %></span>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  </div>
<% } %>

<% if (plan.assumptions && plan.assumptions.length) { %>
  <div class="card section">
    <div class="card-head"><h2>What Foundry assumed</h2></div>
    <div class="card-body">
      <ul class="proposal-list">
        <% plan.assumptions.forEach(function (a) { %><li><%= a %></li><% }) %>
      </ul>
    </div>
  </div>
<% } %>
