<%
  /*
   * Setup is done and this says exactly what is now true.
   *
   * Everything here is a fact about the configuration that just took effect,
   * so it reads as a list of things StockChief can now be held to rather than as
   * a congratulations screen. The two things that are not facts — an offer to
   * create the first product, and what the owner asked StockChief to watch — are
   * kept visibly apart from it.
   */
  var s = summary || {};
  var mode = helpers.TRACKING_MODES[plan.inventoryModel.primaryArchetype];
  var created = s.locationsCreated || [];
  var existing = s.locationsAlreadyPresent || [];
  var locationCount = created.length + existing.length;
  var locationNames = created.map(function (l) { return l.name; }).concat(existing);
  var imported = setupDocument && setupDocument.result;
  var generated = s.syntheticGeneration || null;
  var ownerImported = s.ownerProvidedInventory || null;
  var hasInventoryRecords = Boolean(imported || generated || ownerImported);
%>

<% if (!addedToExisting) { %><%- include('../partials/setup-steps', { step: 3 }) %><% } %>

<div class="rm-head">
  <p class="rm-head__eyebrow" style="color:var(--good)"><%- helpers.icon('check', { size: 14 }) %> Live now</p>
  <h1><%= addedToExisting ? 'The file is now recorded.' : (hasInventoryRecords ? 'Your inventory is ready.' : 'Your inventory setup is ready.') %></h1>
  <p>
    <%= addedToExisting
      ? 'StockChief added exactly what you approved. Your existing inventory setup was not changed.'
      : (hasInventoryRecords
        ? 'StockChief configured the inventory engine and added the records you approved. Everything below is true as of now, and every quantity has a movement behind it.'
        : 'StockChief configured how this inventory will work. No products or stock were created because you have not supplied those records yet. Add or import them next.') %>
  </p>
</div>

<% if (!addedToExisting && !hasInventoryRecords && !firstItem) { %>
  <section class="rm-panel" style="margin-bottom:16px;border-color:var(--brand-line)">
    <div class="rm-panel__head"><%- helpers.icon('arrowRight', { size: 15 }) %><h2>Next: add your products and starting quantities</h2></div>
    <div style="padding:16px">
      <p style="margin:0 0 14px;color:var(--ink-2)">Choose the source that contains the real records. You are finished describing the setup.</p>
      <div class="rm-choices">
        <a class="rm-btn" href="/inventory/describe"><%- helpers.icon('spark', { size: 15 }) %> Tell StockChief what you sell</a>
        <a class="rm-btn rm-btn--ghost" href="/inventory/new">Add one manually</a>
        <a class="rm-btn rm-btn--ghost" href="/onboarding/migrations/new">Import a file</a>
        <a class="rm-btn rm-btn--ghost" href="/onboarding/system">Connect a business system</a>
      </div>
    </div>
  </section>
<% } %>

<% if (imported) { %>
  <section class="rm-panel" style="margin-bottom:16px;border-color:var(--brand-line)">
    <div class="rm-panel__head">
      <%- helpers.icon('check', { size: 15 }) %>
      <h2><%= setupDocument.sourceName %> is now inventory truth</h2>
      <span class="right"><a href="/purchasing/orders/<%= imported.purchaseOrderId %>">See the order</a></span>
    </div>
    <ul class="rm-checks">
      <li><span class="rm-checks__ic"><%- helpers.icon('check', { size: 13 }) %></span>
        <span><strong><%= imported.products %></strong> products and <strong><%= imported.variants %></strong> variants created from the file</span></li>
      <li><span class="rm-checks__ic"><%- helpers.icon('check', { size: 13 }) %></span>
        <span><strong><%= imported.units %></strong> <%= helpers.plural(imported.units, imported.unitLabel || 'unit') %> received into <strong><%= imported.location %></strong></span></li>
      <li><span class="rm-checks__ic"><%- helpers.icon('check', { size: 13 }) %></span>
        <span><strong><%= imported.supplier %></strong> linked as supplier, with its codes and unit costs</span></li>
      <li><span class="rm-checks__ic"><%- helpers.icon('check', { size: 13 }) %></span>
        <span>This file called the vendor identifier <strong><%= imported.detectedSupplierCodeLabel || setupDocument.detectedSupplierCodeLabel %></strong>.
          StockChief will call it <strong><%= imported.itemCodeLabel || setupDocument.supplierCodeLabel %></strong> for <%= imported.supplier %>
          and recognize alternate headings on future documents.</span></li>
      <li><span class="rm-checks__ic"><%- helpers.icon('check', { size: 13 }) %></span>
        <span>Purchase order <strong><%= imported.poNumber %></strong> recorded, approved, and fully received</span></li>
      <% if (imported.landedCostProposal && imported.landedCostProposal.proposed) { %>
        <li><span class="rm-checks__ic"><%- helpers.icon('spark', { size: 13 }) %></span>
          <span>StockChief prepared the supplier invoice's landed-cost split from the posted bill and received goods.
            <a href="/purchasing/orders/<%= imported.landedCostProposal.purchaseOrderId %>/landed-costs/<%= imported.landedCostProposal.documentId %>">Review it before applying</a>.</span></li>
      <% } else if (imported.landedCostProposal && imported.landedCostProposal.waitingFor === 'receipt') { %>
        <li><span class="rm-checks__ic"><%- helpers.icon('clock', { size: 13 }) %></span>
          <span>StockChief recorded the supplier's delivery charge and will prepare the landed-cost split after physical receipt is recorded.</span></li>
      <% } %>
    </ul>
    <div style="padding:12px 16px;border-top:1px solid var(--line-2);display:flex;flex-wrap:wrap;gap:10px;align-items:center">
      <span class="rm-quiet" style="font-size:12.5px">Every quantity is backed by a receipt and an inventory movement.</span>
      <span style="margin-left:auto"><a class="rm-btn rm-btn--sm" href="/inventory">See live inventory</a></span>
    </div>
  </section>
<% } %>

<% if (addedToExisting) { %>

  <div class="rm-spine-foot">
    <a class="rm-btn" href="/inventory"><%- helpers.icon('inventory', { size: 15 }) %> See live inventory</a>
    <a class="rm-btn rm-btn--ghost" href="/">Return to StockChief</a>
  </div>

<% } else { %>

<section class="rm-panel" style="margin-bottom:16px">
  <div class="rm-panel__head">
    <%- helpers.icon('shield', { size: 15, className: 'rm-quiet' }) %>
    <h2>How this inventory now works</h2>
    <span class="right">Configuration version <%= plan.configurationVersion %></span>
  </div>
  <ul class="rm-checks">
    <% if (generated) { %>
      <li><span class="rm-checks__ic"><%- helpers.icon('check', { size: 13 }) %></span>
        <span><strong><%= generated.products %></strong> realistic synthetic products with <strong><%= generated.skus %></strong> SKUs</span></li>
      <li><span class="rm-checks__ic"><%- helpers.icon('check', { size: 13 }) %></span>
        <span><strong><%= generated.suppliers %></strong> synthetic suppliers and <strong><%= generated.historyMonths %> months</strong> of traceable test activity</span></li>
      <li><span class="rm-checks__ic"><%- helpers.icon('check', { size: 13 }) %></span>
        <span><strong><%= generated.movements %></strong> synthetic stock movements, created through the normal inventory engine</span></li>
    <% } %>
    <% if (ownerImported) { %>
      <li><span class="rm-checks__ic"><%- helpers.icon('check', { size: 13 }) %></span>
        <span><strong><%= ownerImported.products %></strong> <%= helpers.plural(ownerImported.products, 'product') %> and
          <strong><%= ownerImported.skus %></strong> <%= helpers.plural(ownerImported.skus, 'variant') %> created exactly as approved</span></li>
      <li><span class="rm-checks__ic"><%- helpers.icon('check', { size: 13 }) %></span>
        <span><strong><%= ownerImported.units %></strong> units recorded as opening stock through traceable inventory movements</span></li>
    <% } %>
    <% if (locationCount) { %>
      <li><span class="rm-checks__ic"><%- helpers.icon('locations', { size: 13 }) %></span>
        <span><strong><%= locationCount %></strong> <%= helpers.plural(locationCount, term('location').toLowerCase()) %> configured
          — <span class="rm-quiet"><%= locationNames.join(', ') %></span></span></li>
    <% } %>

    <li><span class="rm-checks__ic"><%- helpers.icon('layers', { size: 13 }) %></span>
      <span>
        <% if (plan.inventoryModel.usesVariants && plan.variantDimensions.length) { %>
          <%= helpers.plural(2, term('item')) %> use <strong><%= plan.variantDimensions.map(function (d) { return d.name; }).join(' → ') %></strong> variants
        <% } else { %>
          <%= helpers.plural(2, term('item')) %> are tracked by <strong><%= mode.label.toLowerCase() %></strong>
        <% } %>
      </span></li>

    <li><span class="rm-checks__ic"><%- helpers.icon('box', { size: 13 }) %></span>
      <span>
        <% if (plan.inventoryModel.usesVariants) { %>
          Quantity tracked separately by variant and <%= term('location').toLowerCase() %>
        <% } else if (plan.serialRules.enabled) { %>
          Every unit tracked individually, and never in two places at once
        <% } else if (plan.lotRules.enabled) { %>
          Quantity tracked by lot and <%= term('location').toLowerCase() %>
        <% } else { %>
          Quantity tracked separately at each <%= term('location').toLowerCase() %>
        <% } %>
      </span></li>

    <% if (plan.expirationRules.enabled) { %>
      <li><span class="rm-checks__ic"><%- helpers.icon('calendar', { size: 13 }) %></span>
        <span>Expiration dates captured when stock is received</span></li>
    <% } %>
    <% if (plan.operationalDefaults.transfersEnabled && locationCount > 1) { %>
      <li><span class="rm-checks__ic"><%- helpers.icon('transfer', { size: 13 }) %></span>
        <span>Transfers enabled between <%= helpers.plural(2, term('location').toLowerCase()) %></span></li>
    <% } %>
    <li><span class="rm-checks__ic"><%- helpers.icon('shield', { size: 13 }) %></span>
      <span>Physical adjustments require a reason</span></li>
    <% if (!plan.operationalDefaults.allowNegativeStock) { %>
      <li><span class="rm-checks__ic"><%- helpers.icon('shield', { size: 13 }) %></span>
        <span>Stock cannot go negative</span></li>
    <% } %>
  </ul>
</section>

<%# Finish the sentence: they named the product and its options, so offer to
    make it rather than handing back an empty inventory. %>
<% if (firstItem) { %>
  <section class="rm-panel" style="margin-bottom:16px;border-color:var(--brand-line)">
    <div class="rm-panel__head">
      <%- helpers.icon('spark', { size: 15 }) %>
      <h2>Shall I create it?</h2>
    </div>
    <form method="post" action="/foundry/first-item" data-busy style="padding:16px">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <%# Deliberately the tidied name rather than the raw example StockChief
          worked from: "you described Baby headband - White, 0-6 months" is not
          what they said, and reads as though it misheard them. %>
      <p style="font-size:15px;line-height:1.55;margin:0 0 14px;max-width:70ch">
        <% if (firstItem.combinations > 1) { %>
          I can create <strong><%= firstItem.name %></strong> with all
          <%= firstItem.combinations %> combinations, ready to receive stock into.
        <% } else { %>
          I can create <strong><%= firstItem.name %></strong> now, ready to receive stock into.
        <% } %>
      </p>

      <label class="rm-field" style="max-width:420px">
        <span>Call it</span>
        <input type="text" name="name" value="<%= firstItem.name %>" maxlength="80" required>
      </label>

      <% if (firstItem.options.length) { %>
        <div style="overflow-x:auto;margin-bottom:14px">
          <table class="rm-qty">
            <thead><tr><th>Option</th><th>Values</th><th>Count</th></tr></thead>
            <tbody>
              <% firstItem.options.forEach(function (option) { %>
                <tr>
                  <td><strong><%= option.name %></strong></td>
                  <td style="text-align:left"><%= option.values.join(', ') %></td>
                  <td><%= option.values.length %></td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
      <% } %>

      <p class="rm-quiet" style="font-size:13px;margin:0 0 14px;max-width:70ch">
        This creates the <%= term('item').toLowerCase() %><% if (firstItem.options && firstItem.options.length) { %> and its combinations<% } %>,
        and nothing else. StockChief does not know what is on your shelves yet, so every one starts at
        zero — you receive stock next, or bring it in from a spreadsheet.
      </p>

      <div class="rm-choices">
        <button class="rm-btn" type="submit">
          Create <%= firstItem.name %><% if (firstItem.combinations > 1) { %> and its <%= firstItem.combinations %> combinations<% } %>
        </button>
        <a class="rm-btn rm-btn--ghost" href="/inventory/new">I'll set it up myself</a>
      </div>
    </form>
  </section>
<% } %>

<%# typeof, not a bare reference: a template that white-screens because one
    caller did not pass a local is a worse failure than the section going
    missing, and it takes a server restart to even see it. %>
<% if (typeof acceptedRecommendations !== 'undefined' && acceptedRecommendations && acceptedRecommendations.length) { %>
  <section class="rm-panel" style="margin-bottom:16px">
    <div class="rm-panel__head">
      <%- helpers.icon('eye', { size: 15, className: 'rm-quiet' }) %>
      <h2>What you asked StockChief to keep an eye on</h2>
      <span class="right">Not part of the configuration above</span>
    </div>
    <ul class="rm-checks">
      <% acceptedRecommendations.forEach(function (rec) { %>
        <li class="is-flag">
          <span class="rm-checks__ic"><%- helpers.icon('alert', { size: 13 }) %></span>
          <span><strong><%= rec.title %></strong><br><span class="rm-quiet"><%= rec.recommendation %></span></span>
        </li>
      <% }) %>
    </ul>
  </section>
<% } %>

<% if (decisions && decisions.length) { %>
  <section class="rm-panel" style="margin-bottom:16px">
    <div class="rm-panel__head">
      <%- helpers.icon('check', { size: 15, className: 'rm-quiet' }) %>
      <h2>Decisions on record</h2>
      <span class="right"><%= decisions.length %></span>
    </div>
    <div class="rm-told" style="border:0;border-radius:0;box-shadow:none">
      <% decisions.forEach(function (d) { %>
        <div class="rm-told__row">
          <span class="rm-told__t"><%= d.question %><small><%= d.answer_label %></small></span>
          <span class="rm-told__m">
            <span class="rm-pillbadge <%= d.decided_by === 'foundry' ? '' : 'is-ok' %>">
              <%= d.decided_by === 'foundry' ? 'StockChief decided' : 'You decided' %>
            </span>
          </span>
        </div>
      <% }) %>
    </div>
  </section>
<% } %>

<% if (plan.assumptions && plan.assumptions.length) { %>
  <details class="rm-work" style="margin-bottom:16px">
    <summary>What StockChief assumed · <%= plan.assumptions.length %></summary>
    <div class="rm-work__body">
      <ul class="plain-list">
        <% plan.assumptions.forEach(function (a) { %><li><%= a %></li><% }) %>
      </ul>
    </div>
  </details>
<% } %>

<div class="rm-spine-foot">
  <% if (!firstItem && !imported) { %>
    <a class="rm-btn" href="/inventory/new"><%- helpers.icon('plus', { size: 15 }) %> Add my first <%= term('item').toLowerCase() %></a>
  <% } %>
  <a class="rm-btn rm-btn--ghost" href="/ask">Ask StockChief something</a>
  <a class="rm-btn rm-btn--ghost" href="/">Go to the brief</a>
</div>

<% } %>
