<%
  var hour = new Date().getHours();
  var greeting = hour < 12 ? 'Good morning' : hour < 18 ? 'Good afternoon' : 'Good evening';
  var firstName = currentUser && currentUser.name ? currentUser.name.split(/\s+/)[0] : '';
  var needs = home.needsYou || [];
  var needsCount = Number(home.needsYouTotal || needs.length);
  var urgentCount = needs.filter(function (item) { return item.importance === 'Urgent'; }).length;
  var handled = (home.did && home.did.actions) || [];
  var handledCount = Number((home.did && home.did.counts && home.did.counts.handled) || 0);
  var handling = home.handling || [];
  var comingUp = locals.whatsNext || [];
  var observations = locals.noticed || [];
  var paused = home.status.paused || home.status.suspended;
  var empty = !!locals.isEmpty && !needsCount;
  var firstCheck = !empty && home.status.checkPending;
  var stale = !paused && !empty && home.status.checkStale;
  var migration = locals.activeMigration || null;
  var headline = paused ? 'StockChief is paused.'
    : empty ? (migration ? 'Your inventory is being prepared.' : 'StockChief is ready. Your inventory isn’t here yet.')
    : urgentCount ? (urgentCount === 1 ? 'One urgent thing needs you.' : urgentCount + ' urgent things need you.')
    : firstCheck ? 'Your inventory is here. Let’s do the first check.'
    : stale ? 'Here’s where things stood at the last check.'
    : needsCount ? 'Everything else is under control.'
    : 'Everything is under control.';
%>
<div class="sc-home <%= urgentCount ? 'sc-home--urgent' : '' %>">
  <header class="sc-home__hero" aria-labelledby="sc-home-title">
    <div class="sc-home__hero-main">
      <p class="sc-home__greeting"><%= greeting %><%= firstName ? ', ' + firstName : '' %></p>
      <h1 id="sc-home-title"><%= headline %></h1>
      <% if (paused) { %>
        <p class="sc-home__sentence"><%= home.status.suspendedReason || home.status.pausedReason || 'Automatic work is stopped until you resume it.' %><%= firstCheck ? ' No business check has run yet.' : '' %></p>
      <% } else if (empty) { %>
        <p class="sc-home__sentence"><%= migration ? 'Your source is saved; StockChief will not switch it live until the records reconcile and you approve them.' : 'Bring in the products and quantities you already have. StockChief has not checked your business yet, and nothing will be ordered, paid, or emailed without your approval or the limits you set.' %></p>
      <% } else if (firstCheck) { %>
        <p class="sc-home__sentence">Your records are in place, but StockChief has not checked them yet. Run the first check to see what needs attention. No automatic action goes beyond the limits you set.</p>
      <% } else { %>
        <p class="sc-home__sentence">
          <% if (handledCount) { %>StockChief <strong>handled <%= handledCount %> <%= handledCount === 1 ? 'thing' : 'things' %></strong> in the last 24 hours.<% } else { %>No new work was completed by StockChief in the last 24 hours.<% } %>
          <% if (needsCount) { %><br><strong><%= needsCount %> <%= needsCount === 1 ? 'thing needs' : 'things need' %> you.</strong><% } else { %><br>Nothing needs you right now.<% } %>
        </p>
      <% } %>
      <div class="sc-home__hero-actions">
        <% if (paused && canOperate) { %>
          <form method="post" action="/autopilot/resume"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="returnToHome" value="1"><button class="sc-home__primary" type="submit">Resume StockChief <%- helpers.icon('arrowRight', { size: 17 }) %></button></form>
        <% } else if (empty) { %>
          <a class="sc-home__primary" href="<%= migration ? '/onboarding/migrations/' + migration.id + (migration.remainingCount ? '/sources' : '') : '/onboarding' %>"><%= migration ? (migration.remainingCount ? 'Continue source review' : 'Run final checks') : 'Add your inventory' %> <%- helpers.icon('arrowRight', { size: 17 }) %></a>
        <% } else if (firstCheck && canOperate) { %>
          <form method="post" action="/autopilot/run"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="returnToHome" value="1"><button class="sc-home__primary" type="submit">Run first check <%- helpers.icon('arrowRight', { size: 17 }) %></button></form>
        <% } else if (needsCount) { %>
          <a class="sc-home__primary" href="#needs-you">Review <%= needsCount %> <%= needsCount === 1 ? 'thing' : 'things' %> <%- helpers.icon('arrowRight', { size: 17 }) %></a>
        <% } else if (stale && canOperate) { %>
          <form method="post" action="/autopilot/run"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="returnToHome" value="1"><button class="sc-home__primary" type="submit">Check now <%- helpers.icon('arrowRight', { size: 17 }) %></button></form>
        <% } %>
        <% if (!empty && handledCount) { %><a class="sc-home__text-link" href="#handled">See what was handled</a><% } %>
      </div>
    </div>
    <div class="sc-home__control">
      <div class="sc-home__status" aria-label="StockChief status"><span class="sc-home__status-dot <%= paused ? 'is-paused' : firstCheck || stale ? 'is-stale' : '' %>" aria-hidden="true"></span><span><%= paused ? 'Paused' : empty ? 'Ready to set up' : firstCheck ? 'First check needed' : stale ? 'Check overdue' : 'On duty' %></span><small><%= empty || firstCheck ? 'No business check yet' : 'Last checked ' + home.status.lastEvaluatedText %></small></div>
      <% if (canOperate && !paused) { %><form method="post" action="/autopilot/pause"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="returnToHome" value="1"><button class="sc-home__pause" type="submit"><%- helpers.icon('pause', { size: 14 }) %> Pause automatic work</button></form><% } %>
    </div>
  </header>

  <% if (!empty && home.coverageErrors && home.coverageErrors.length) { %><p class="sc-home__warning" role="alert">StockChief could not check every source. This is not a complete all-clear. <a href="/settings/operations">See operational health</a></p><% } %>
  <% if (!empty && stale) { %><p class="sc-home__warning" role="status">The automatic check has not run in over a day. Current conditions may have changed since the last check.</p><% } %>

  <section class="sc-home__ask" aria-labelledby="sc-home-ask-title">
    <div class="sc-home__ask-intro"><span class="sc-home__ask-mark" aria-hidden="true"><%- helpers.icon('foundry', { size: 22 }) %></span><div><p class="sc-home__eyebrow">Your direct line</p><h2 id="sc-home-ask-title">Ask or tell StockChief.</h2><p>Ask about your business, describe a change, or say what you want done. StockChief checks the records and asks before consequential action.</p></div></div>
    <%- include('../partials/composer', { composerPlaceholder: 'What would you like StockChief to know or do?', homeHandoff: !!locals.postgresAsk, hideAttachment: !!locals.postgresAsk }) %>
    <% var suggestions = (home.guidance && home.guidance.examples) || []; %>
    <% if (suggestions.length) { %><div class="sc-home__suggestions" aria-label="Things you can ask"><span>Try asking</span><% suggestions.slice(0, 3).forEach(function (line) { %><a href="/ask?q=<%= encodeURIComponent(line) %>"><%= line %></a><% }) %></div><% } %>
  </section>

  <% if (!empty) { %>
    <a class="sc-home__inventory-line" href="/inventory" aria-label="Open inventory">
      <span class="sc-home__inventory-line-icon"><%- helpers.icon('inventory', { size: 17 }) %></span>
      <span><small>Inventory now</small><strong><%= Number(stats.itemCount).toLocaleString() %> <%= stats.itemCount === 1 ? 'product' : 'products' %> · <%= Number(stats.unitsOnHand).toLocaleString() %> units on hand · <%= Number(stats.available).toLocaleString() %> available for orders</strong></span>
      <%- helpers.icon('arrowRight', { size: 16 }) %>
    </a>
  <% } %>

  <% if (empty && !migration) { %>
    <section class="sc-home__first-steps" aria-labelledby="sc-home-first-steps-title">
      <div class="sc-home__section-head"><div><p class="sc-home__eyebrow">One start, then StockChief takes over the routine</p><h2 id="sc-home-first-steps-title">What happens next</h2></div></div>
      <ol>
        <li><span>1</span><div><strong>Bring in what you have</strong><p>Use a spreadsheet, connect a system, or enter your first products.</p></div></li>
        <li><span>2</span><div><strong>Check it together</strong><p>StockChief shows what it understood before imported records become live.</p></div></li>
        <li><span>3</span><div><strong>Choose its limits</strong><p>You decide what StockChief can handle on its own and what still needs you.</p></div></li>
      </ol>
      <% if (currentUser && currentUser.role === 'owner' && onboardingEntry && !onboardingEntry.dismissed) { %>
        <div class="sc-home__sample"><span>Want to explore first? Sample data stays separate from your business.</span><form method="post" action="/onboarding/sample/load"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button type="submit">Explore with sample data <%- helpers.icon('arrowRight', { size: 15 }) %></button></form></div>
      <% } %>
    </section>
  <% } %>

  <% if (!empty) { %>
    <div class="sc-home__workline">
      <% if (handling.length && !paused) { %><details class="sc-home__working"><summary><span class="sc-home__working-dot" aria-hidden="true"></span><strong>StockChief is working</strong><span><%= handling.length %> <%= handling.length === 1 ? 'thing' : 'things' %> in progress</span></summary><div class="sc-home__working-body"><% handling.forEach(function (item) { %><a href="<%= item.link %>"><%= item.title %> — <%= item.detail %> <%- helpers.icon('arrowRight', { size: 14 }) %></a><% }) %></div></details>
      <% } else { %><span><span class="sc-home__working-dot <%= paused ? 'is-paused' : '' %>" aria-hidden="true"></span><%= paused ? 'Automatic work is paused' : 'StockChief is watching for work; automatic actions stay within your approved limits' %></span><% } %>
      <a href="/autopilot/history">View work history</a>
    </div>

    <section class="sc-home__decisions <%= urgentCount ? 'sc-home__decisions--urgent' : '' %>" id="needs-you" aria-labelledby="sc-home-needs-title">
      <div class="sc-home__section-head"><div><p class="sc-home__eyebrow">Decisions only you can make</p><h2 id="sc-home-needs-title">Needs you<% if (needsCount) { %><span class="sc-home__count"><%= needsCount %></span><% } %></h2></div><% if (needsCount > needs.length) { %><a href="/needs-you/all">See all <%= needsCount %></a><% } %></div>
      <% if (!needsCount) { %><p class="sc-home__all-clear"><%- helpers.icon('check', { size: 18 }) %> <%= firstCheck ? 'No decisions are waiting yet. Run the first check to find out what needs attention.' : 'Nothing needs you.' %></p><% } else { %>
        <div class="sc-home__decision-list"><% needs.forEach(function (item) { %><a class="sc-home__decision <%= item.importance === 'Urgent' ? 'is-urgent' : '' %>" href="<%= item.link || item.href %>"><span class="sc-home__decision-icon"><%- helpers.icon(item.importance === 'Urgent' ? 'alert' : 'hand', { size: 18 }) %></span><span class="sc-home__decision-copy"><% if (item.importance === 'Urgent') { %><small>Urgent</small><% } %><strong><%= item.title %></strong><% if (item.because) { %><span><%= item.because %></span><% } %></span><span class="sc-home__decision-action"><%= item.action || 'Review' %> <%- helpers.icon('arrowRight', { size: 16 }) %></span></a><% }) %></div>
        <% if (needsCount > needs.length) { %><a class="sc-home__more" href="/needs-you/all">Open all <%= needsCount %> decisions</a><% } %>
      <% } %>
    </section>

    <div class="sc-home__lower">
      <section class="sc-home__outcomes" id="handled" aria-labelledby="sc-home-handled-title"><div class="sc-home__section-head"><div><p class="sc-home__eyebrow">What StockChief finished · last 24 hours</p><h2 id="sc-home-handled-title">Handled</h2></div><a href="/autopilot/history">Work history</a></div>
        <% if (handled.length) { %><div class="sc-home__outcome-list"><% handled.slice(0, 4).forEach(function (item) { %><a href="<%= item.link %>" class="sc-home__outcome"><span class="sc-home__outcome-check"><%- helpers.icon('check', { size: 15 }) %></span><span><strong><%= item.headline %></strong><small><%= item.detail %></small></span><%- helpers.icon('arrowRight', { size: 15 }) %></a><% }) %></div><% if (handledCount > 4) { %><a class="sc-home__more" href="/autopilot/history">See more recent work</a><% } %>
        <% } else { %><p class="sc-home__quiet">No automatic work was completed in the last 24 hours.</p><% } %>
      </section>
      <div class="sc-home__right-column">
        <section class="sc-home__upcoming" aria-labelledby="sc-home-upcoming-title"><div class="sc-home__section-head"><div><p class="sc-home__eyebrow">Dates on your orders</p><h2 id="sc-home-upcoming-title">Coming up</h2></div></div><% if (comingUp.length) { %><div class="sc-home__upcoming-list"><% comingUp.forEach(function (item) { %><a href="<%= item.href %>"><span class="sc-home__date"><%= helpers.shortDate(item.when) %></span><span><%= item.text %></span><%- helpers.icon('arrowRight', { size: 14 }) %></a><% }) %></div><% } else { %><p class="sc-home__quiet">No dated customer commitments or supplier deliveries are approaching.</p><% } %></section>
        <section class="sc-home__noticed" aria-labelledby="sc-home-noticed-title"><div class="sc-home__section-head"><div><p class="sc-home__eyebrow">Worth knowing</p><h2 id="sc-home-noticed-title">StockChief noticed</h2></div></div><% if (observations.length) { %><div class="sc-home__observations"><% observations.slice(0, 2).forEach(function (item) { %><a href="<%= item.href %>"><%- helpers.icon('eye', { size: 16 }) %><span><strong><%= item.text %></strong><small><%= item.detail %></small></span><%- helpers.icon('arrowRight', { size: 14 }) %></a><% }) %></div><% } else { %><p class="sc-home__quiet">No additional observation to surface right now.</p><% } %></section>
      </div>
    </div>
  <% } %>

  <% if (!empty) { %><p class="sc-home__browse"><a href="/inventory">Inventory</a><a href="/orders">Customer orders</a><a href="/purchasing/orders">Purchases</a><a href="/money">Money</a><a href="/activity">Activity</a></p><% } %>
</div>
