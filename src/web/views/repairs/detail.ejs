<% var resolved = repairCase.status === 'RESOLVED';
   var waiting = repairCase.status === 'NEEDS_AUTHORITY';
   var authorized = repairCase.status === 'AUTHORIZED';
   var inconclusive = repairCase.status === 'INCONCLUSIVE';
   var failed = repairCase.status === 'FAILED'; %>
<section class="page-head">
  <div><p class="eyebrow">Repair case · <%= repairCase.status.replaceAll('_', ' ') %></p>
    <h1><%= repairCase.symptom %></h1>
    <p><%= resolved ? 'StockChief repaired the source records through their owning domains and verified that they now agree.'
      : inconclusive ? 'StockChief stopped because the evidence does not prove a safe correction.'
      : failed ? 'StockChief did not call this fixed because one or more post-repair checks did not pass.'
      : authorized ? 'The simulated correction is approved. No business record has changed yet.'
      : 'StockChief has diagnosed the problem and will not change anything until the simulated consequences are accepted.' %></p>
  </div>
</section>

<section class="section"><h2>What StockChief found</h2>
  <dl class="detail-list">
    <div><dt>Failed rule</dt><dd><%= repairCase.failedInvariant %></dd></div>
    <div><dt>Confidence</dt><dd><%= repairCase.confidence %></dd></div>
    <div><dt>Materiality</dt><dd><%= repairCase.materiality %></dd></div>
  </dl>
</section>

<section class="section"><h2><%= resolved ? 'What StockChief verified' : 'What the repair would do' %></h2>
  <p><%= repairCase.simulation.summary || 'The case is still being diagnosed.' %></p>
  <% if ((repairCase.simulation.consequences || []).length) { %><ul>
    <% repairCase.simulation.consequences.forEach(function (line) { %><li><%= line %></li><% }) %>
  </ul><% } %>
  <% if (resolved) { %>
    <ul><% (repairCase.verification.checks || []).forEach(function (check) { %>
      <li><strong><%= check.passed ? 'Passed' : 'Failed' %>:</strong> <%= check.name %></li>
    <% }) %></ul>
  <% } %>
</section>

<% if (!resolved && !inconclusive) { %>
<section class="section"><h2>One next step</h2>
  <% if (waiting) { %>
    <p>Approve only if the simulation matches the correction you intend. Approval still does not bypass verification.</p>
    <form method="post" action="/repairs/<%= repairCase.id %>/approve">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="btn btn--primary" type="submit">Approve this repair</button>
    </form>
  <% } else if (repairCase.status === 'AUTHORIZED') { %>
    <p>The repair is approved and ready to run through the owning domain services.</p>
    <form method="post" action="/repairs/<%= repairCase.id %>/execute">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="btn btn--primary" type="submit">Run and verify repair</button>
    </form>
  <% } else { %>
    <form method="post" action="/repairs/<%= repairCase.id %>/verify">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="btn btn--primary" type="submit">Check the records again</button>
    </form>
  <% } %>
</section>
<% } %>

<details class="section"><summary>See evidence and repair history</summary>
  <div class="section"><h3>Evidence</h3><pre><%= JSON.stringify(repairCase.evidence, null, 2) %></pre>
    <h3>Before / after</h3><pre><%= JSON.stringify({ before: repairCase.beforeEvidence, after: repairCase.afterEvidence }, null, 2) %></pre>
    <h3>Immutable case history</h3><ol><% events.forEach(function (event) { %>
      <li><strong><%= event.event.replaceAll('_', ' ') %></strong> · <%= event.createdAt %><% if (event.actorName) { %> · <%= event.actorName %><% } %></li>
    <% }) %></ol>
  </div>
</details>
