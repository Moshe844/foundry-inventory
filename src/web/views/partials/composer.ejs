<%
  /*
   * The line, wherever it is needed.
   *
   * One box for everything somebody says to StockChief — what happened, what they
   * want, how they want the operation run — because StockChief has one
   * understanding of a sentence and which box it was typed into must never
   * decide whether it understands them. It posts to the router that already
   * classifies fifteen kinds of intent.
   *
   * It sits at the foot of the brief as well as on its own page, because a
   * briefing you can reply to is the whole difference between reading a report
   * and talking to somebody.
   */
  var prompt = locals.composerPlaceholder
    || 'Tell me what happened, ask me anything, or tell me how you want this run…';
  var prefill = locals.composerPrefill || '';
%>
<form class="rm-composer" id="tell-foundry" method="post" action="/foundry/tell"
      enctype="multipart/form-data" data-busy data-ask-form data-operator-command-form<% if (locals.homeHandoff) { %> data-home-ask-handoff<% } %>>
  <input type="hidden" name="_csrf" value="<%= csrfToken %>">
  <% if (locals.sourcePath || (locals.homeHandoff && locals.currentPath)) { %><input type="hidden" name="sourcePath" value="<%= locals.sourcePath || locals.currentPath %>"><% } %>
  <% if (locals.usageKey) { %><input type="hidden" name="usageKey" value="<%= locals.usageKey %>"><% } %>
  <% if (locals.queryConversation) { %><input type="hidden" name="queryConversation" value="1"><% } %>
  <% if (locals.emailBodyContinuation) { %>
    <input type="hidden" name="continueInteractionId" value="<%= locals.emailBodyContinuation.interactionId %>">
    <p class="rm-composer__context">Replying to the email for <strong><%= locals.emailBodyContinuation.recipient %></strong>. Your next message becomes an editable draft, not a new stock question. To ask something else, start a new conversation.</p>
  <% } %>
  <% if (locals.actionClarification) { %>
    <input type="hidden" name="original" value="<%= locals.actionClarification.original %>">
    <input type="hidden" name="answerAction" value="1">
    <% if (locals.actionClarification.goalId) { %><input type="hidden" name="assistantGoal" value="<%= locals.actionClarification.goalId %>"><% } %>
  <% } %>
  <label class="visually-hidden" for="ask-question">Tell StockChief what happened, or ask it something</label>
  <textarea class="rm-composer__input" id="ask-question" data-ask-input name="<%= locals.actionClarification ? 'answer' : 'message' %>" rows="2"
    maxlength="2000" aria-label="Ask StockChief" placeholder="<%= prompt %>"><%= prefill %></textarea>
  <div class="rm-composer__foot">
  <% if (!locals.hideAttachment) { %><label class="rm-composer__attach" title="<%= locals.postgresAsk ? 'Attach an inventory table (CSV, Excel, PDF or image)' : 'Attach a file or a photo of a document' %>">
      <input type="file" name="file" accept="<%= locals.postgresAsk ? '.csv,.tsv,.xlsx,.txt,.pdf,.png,.jpg,.jpeg' : '.csv,.tsv,.xlsx,.xls,.txt,.pdf,.docx,image/*' %>" data-operator-attachment>
      <%- helpers.icon('paperclip', { size: 16 }) %><span>Attach</span>
    </label><% } %>
    <span class="right"><button class="rm-btn rm-btn--sm rm-composer__send" type="submit" aria-label="Continue" data-ask-submit><span>Send</span><%- helpers.icon('send', { size: 16 }) %></button></span>
  </div>
  <p class="rm-composer__pending" data-ask-pending role="status" aria-live="polite" hidden>
    StockChief is working out what that means…
  </p>
  <p class="rm-composer__pending" data-operator-attachment-status role="status" aria-live="polite" hidden>
    <strong data-operator-attachment-name></strong> attached. Add a note if useful, then send.
  </p>
</form>
