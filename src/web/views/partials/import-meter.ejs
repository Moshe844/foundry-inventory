<div class="import-meter" data-import-meter data-state="<%= activity.state.toLowerCase() %>">
  <div class="import-meter__status"><span class="import-meter__indicator" aria-hidden="true"></span><strong data-import-stage><%= activity.stageLabel %></strong><span data-import-count><%= activity.stage==='preparing'&&activity.preparedRows!=null?helpers.qty(activity.preparedRows)+' / '+helpers.qty(activity.readyRows)+' approved rows prepared':activity.processedRows===null?'':(activity.attempt>1?'Attempt '+activity.attempt+': ':'')+helpers.qty(activity.processedRows)+' / '+helpers.qty(activity.readyRows)+(activity.durable?' rows saved':' rows processed') %></span></div>
  <div class="import-meter__track <%= activity.progressPercent===null?'is-indeterminate':'' %>" role="progressbar" aria-label="Import processing progress" aria-valuemin="0" aria-valuemax="100" <% if(activity.progressPercent!==null){ %>aria-valuenow="<%= activity.progressPercent %>"<% } %> data-import-bar><span style="width:<%= activity.progressPercent===null?32:activity.progressPercent %>%"></span></div>
  <ol class="import-meter__steps" aria-label="Import stages"><% [['preparing','Prepare'],['processing','Apply records'],['verifying','Verify'],['complete','Complete']].forEach(function(step){ %><li data-import-step="<%= step[0] %>" class="<%= activity.stage===step[0]?'is-current':'' %>"><%= step[1] %></li><% }) %></ol>
  <div class="import-meter__details"><span data-import-summary><%= activity.verified?'Products, stock and accounting checks passed.':activity.durable?helpers.qty(activity.savedRows)+' approved rows saved with stock, accounting and extra fields. Saved batches will not be repeated.':activity.detailsPending?'Stock rows are prepared. Extra fields and reorder settings are still being applied before final verification. Inventory is not saved yet.':activity.processedRows===null?'Exact row progress is not available for this run. Inventory appears after verification.':'Processed rows are being prepared; inventory is saved together after verification.' %></span><span data-import-live><%= activity.active?'Receiving worker updates':'Saved status' %></span></div>
</div>
