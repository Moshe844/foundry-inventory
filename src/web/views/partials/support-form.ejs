<% if(locals.supportReceipt){ %><section class="card card-body" role="status"><h2>Your request is saved</h2><p>Reference <strong><%= supportReceipt.id %></strong>. StockChief has queued a confirmation to <%= supportReceipt.contact_email %>.</p><% if(supportReceipt.account_id){ %><p><a class="btn btn--primary" href="/support/requests/<%= supportReceipt.id %>">Open conversation</a></p><% } %><p>Keep this reference if you contact support. Submitting the form again will not create a second request.</p></section>
<% }else{ %><section class="card card-body"><h2>Tell us what happened</h2><p>Your request stays in StockChief. Replies go to your email. Please leave out passwords, API keys and payment-card details.</p>
<% if(locals.supportError){ %><p class="auth-message auth-message--error" role="alert"><%= supportError %></p><% } %>
<form method="post" action="/support/requests" class="stack-form"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="requestKey" value="<%= supportRequestKey %>"><input type="hidden" name="sourcePath" value="<%= locals.supportSourcePath||'' %>">
<label class="field"><span>Reply email</span><input class="input" type="email" name="email" <%= locals.account?.id?'readonly':'' %> value="<%= locals.supportContactEmail||'' %>" required maxlength="254" autocomplete="email"></label>
<label class="field"><span>Subject</span><input class="input" name="subject" required maxlength="180"></label>
<% if(locals.supportAccess&&(supportAccess.chat||supportAccess.assisted)){ %><label class="field"><span id="support-channel-label">How can we help?</span><select class="input" name="channel" aria-labelledby="support-channel-label"><option value="EMAIL">Email support</option><% if(supportAccess.chat){ %><option value="CHAT">Support chat in StockChief</option><% } %><% if(supportAccess.assisted){ %><option value="ONBOARDING">Onboarding and import help</option><option value="MIGRATION">Migration planning</option><% } %></select></label><% } %>
<label class="field"><span>What were you doing, and what went wrong?</span><textarea class="input" name="body" rows="6" required maxlength="10000"></textarea></label>
<button class="btn btn--primary pub-btn" type="submit">Send support request</button></form></section><% } %>
<% if(locals.supportRequests?.length){ %><section class="card card-body"><h2>Your recent requests</h2><ul><% supportRequests.forEach(function(r){ %><li><a href="/support/requests/<%= r.id %>"><%= r.subject %></a> · <%= r.priority?'Priority support · ':'' %><%= r.status==='RECEIVED'?'Received':r.status==='IN_REVIEW'?'In review':'Resolved' %> · <time datetime="<%= new Date(r.created_at).toISOString() %>"><%= helpers.dateTime(r.created_at) %></time></li><% }); %></ul></section><% } %>
