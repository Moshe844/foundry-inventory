<%
 const conversation=goal.conversation||{label:'Checking progress',message:'Your request is saved.',history:[],canReply:false};
 const phase=conversation.label;
 const active=['READY','RUNNING'].includes(goal.status);
 const pendingNavigation=goal.status==='WAITING_EVENT'&&['PENDING','DELIVERING'].includes(goal.checkpoint.navigation?.state)?goal.checkpoint.navigation:null;
 const delivered=locals.agentDelivery?locals.agentDelivery(goal):null;
%>
<div data-conversation-history-for="<%= goal.id %>" class="rm-agent__conversation">
  <% for(const [index,turn] of conversation.history.entries()){ if(index===conversation.history.length-1&&turn.role==='assistant'&&turn.text===conversation.message)continue; %>
    <div class="rm-agent__exchange"><p class="rm-stamp"><%= turn.role==='user'?'You':'StockChief' %></p><div><%- renderAgentAnswer(turn.text) %></div></div>
  <% } %>
</div>
<section class="rm-agent" aria-label="Goal progress" data-adaptive-goal="<%= goal.id %>" data-goal-status="<%= goal.status %>" data-goal-created="<%= new Date(goal.created_at).toISOString() %>" data-goal-updated="<%= new Date(goal.updated_at).toISOString() %>" data-goal-latest="<%= locals.isLatest?'true':'false' %>">
  <div class="rm-agent__header">
    <p class="rm-agent__phase" role="status" data-goal-phase><span class="rm-agent__dot" aria-hidden="true"></span><span data-goal-phase-text><%= phase %></span></p>
    <span class="rm-agent__elapsed" data-goal-elapsed data-run-started="<%= goal.checkpoint.runStartedAt||new Date(goal.created_at).toISOString() %>" <%= goal.status==='RUNNING'?'':'hidden' %>></span>
    <% if(!['COMPLETED','CANCELLED','BLOCKED'].includes(goal.status)){ %>
      <form method="post" action="/ask/goals/<%= goal.id %>/cancel"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="rm-btn rm-btn--ghost rm-btn--sm" type="submit">Stop</button></form>
    <% } %>
  </div>
  <div class="rm-agent__answer" data-goal-answer <%= conversation.message?'':'hidden' %>><%- renderAgentAnswer(conversation.message) %></div>
  <div data-goal-delivery data-revision="<%= delivered?.id||'' %>"><%- include('agent-delivery',{goal,delivery:delivered}) %></div>
  <p class="rm-agent__hint" data-goal-hint><%= active?'You can leave this page. I’ll keep working and show any required approval here.':'' %></p>
  <form method="post" action="/ask/goals/<%= goal.id %>/navigate" data-goal-navigation <%= pendingNavigation?'':'hidden' %>>
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <input type="hidden" name="automatic" value="0">
    <button class="rm-btn rm-btn--sm" data-navigation-label type="submit"><%= pendingNavigation?'Open '+pendingNavigation.label:'Open page' %></button>
  </form>
  <% if(goal.checkpoint.runtime==='codex-staging'){ %>
    <details class="rm-agent__details"><summary>Activity details</summary><ol data-goal-timeline aria-label="Agent activity"></ol></details>
    <% for(const card of locals.codexApprovals||[]){ %>
      <article class="rm-agent__approval" data-approval-id="<%= card.id %>">
        <p><strong>Approval required</strong></p><p><%= card.summary %></p>
        <p>Prepared only. Nothing has changed yet.</p>
        <form method="post" action="/ask/goals/<%= goal.id %>/approval">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <input type="hidden" name="deliveryId" value="<%= card.id %>">
          <input type="hidden" name="sha256" value="<%= card.sha256 %>">
          <button class="rm-btn rm-btn--sm" name="decision" value="approve">Approve exact operation</button>
          <button class="rm-btn rm-btn--ghost rm-btn--sm" name="decision" value="reject">Reject</button>
        </form>
      </article>
    <% } %>
  <% } %>
  <% for(const id of goal.checkpoint.waiting?.proposalIds||[]){ %>
    <p><a href="<%= goal.checkpoint.observations.find(o=>o.result.proposal?.id===id)?.result.proposal?.href || '/actions/'+encodeURIComponent(id) %>">Review prepared operation</a></p>
  <% } %>
    <form data-goal-reply method="post" action="/ask/goals/<%= goal.id %>/reply" <%= conversation.canReply&&!locals.isLatest?'':'hidden' %>><input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <input type="hidden" name="questionId" value="<%= conversation.input?.id||'' %>">
      <label>Your answer<input name="message" maxlength="4000" required></label><button class="rm-btn rm-btn--sm" type="submit">Continue this goal</button>
    </form>
</section>
