<% const reserved=locals.rotationSelection||null;if(reserved){ %><p>Reserved stock: <%= reserved.map(s=>(s.serial?'Serial '+s.serial:s.lotCode?'Lot '+s.lotCode:'Received '+s.receivedAt)+' · '+s.quantity+(s.expiresOn?' · expires '+s.expiresOn:'')).join('; ') %>. Confirm these actual goods; a different lot or serial requires a fresh reservation.</p><% } %>
<% if(trackingMode==='lot'){ %><fieldset><legend>Batch selection for <%= label %></legend><input type="hidden" name="lotStrategy_<%= field %>" value="<%= reserved?'RESERVED':'FEFO' %>"><p><%= reserved?'Use the exact reserved batches listed above. For a partial batch, enter its code and actual weight when applicable.':'Pick the unexpired batches with the earliest expiry first. StockChief records each batch used. To use one specific batch, enter its code below.' %></p><label>Lot / batch code <input name="lot_<%= field %>" maxlength="240" placeholder="<%= reserved?'Use the exact reserved batches':'Earliest expiry first' %>"></label></fieldset><% } %>
<% if(trackingMode==='serial'){ %><label>Serial numbers leaving for <%= label %><textarea name="serials_<%= field %>" maxlength="20000" placeholder="Scan one per unit, separated by commas or new lines"></textarea></label><% } %>
<% if(secondaryUnit){ %><label>Actual <%= secondaryUnit %> leaving for <%= label %><input name="secondary_<%= field %>" inputmode="decimal"></label><% } %>
