<% if(trackingMode==='lot'){ %><fieldset><legend>Batch selection for <%= label %></legend><input type="hidden" name="lotStrategy_<%= field %>" value="FEFO"><p>Pick the unexpired batches with the earliest expiry first. StockChief records each batch used. To use one specific batch, enter its code below.</p><label>Lot / batch code <input name="lot_<%= field %>" maxlength="240" placeholder="Earliest expiry first"></label></fieldset><% } %>
<% if(trackingMode==='serial'){ %><label>Serial numbers leaving for <%= label %><textarea name="serials_<%= field %>" maxlength="20000" placeholder="Scan one per unit, separated by commas or new lines"></textarea></label><% } %>
<% if(secondaryUnit){ %><label>Actual <%= secondaryUnit %> leaving for <%= label %><input name="secondary_<%= field %>" inputmode="decimal"></label><% } %>
