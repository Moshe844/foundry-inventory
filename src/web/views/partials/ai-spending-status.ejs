<% if(locals.aiCost?.creditsOnly){ const cost=aiCost,meter=helpers.aiCustomerMeter(cost); %><section class="card section" aria-label="AI availability"><div class="card-body"><h2>AI credits</h2><p role="status"><strong><%= meter.available?(meter.usableCredits===null?'AI work is available':Number(meter.usableCredits).toLocaleString()+' credits available for AI work'):cost.certificationPaused?'Staging test access is paused':'AI credits used up' %></strong></p><progress max="1" value="<%= meter.usedRatio %>" aria-label="AI credits used"></progress><% if(cost.certificationPaused){ %><p>The separately approved certification window or test allowance has ended. Customer credits are preserved; the ordinary customer service uses credits.</p><% }else if(cost.creditsBlocked){ %><p>Your saved files and records remain available. Credits renew with your plan.</p><% }else if(cost.creditWarning){ %><p role="status">At least 80% of your AI credits have been used.</p><% } %><p>Ask and file reading use the same credit balance. <%= cost.credits.reserved %> credits are reserved for work in progress.</p><% if(!cost.certificationPaused){ %><a class="btn btn--primary" href="/usage">Add more AI credits</a><a class="btn" href="/pricing">Upgrade your plan</a><% } %><a class="btn" href="/usage">Usage details</a></div></section><% }else{ %>
<% if(locals.aiCost){ const cost=aiCost,usd=n=>'$'+(n/100).toFixed(2),meter=helpers.aiCustomerMeter(cost); %><section class="card section" aria-label="AI availability"><div class="card-body"><h2>AI availability</h2><p role="status"><strong><%= meter.available?(meter.usableCredits===null?'AI work is available':Number(meter.usableCredits).toLocaleString()+' credits available for AI work'):'AI work is paused' %></strong></p><progress max="1" value="<%= meter.usedRatio %>" aria-label="AI allowance used"></progress><% if(cost.paused){ %><p class="notice notice--warn"><%= cost.reason==='SPENDING_LIMIT'?'Your spending limit has been reached.':'Your AI credits have been used.' %> <%= meter.unusedCredits>0?Number(meter.unusedCredits).toLocaleString()+' unused credits are preserved, but cannot be used until the owner raises the spending limit.':'' %></p><% }else if(cost.warning||cost.creditWarning){ %><p class="notice notice--warn">At least 80% of your AI allowance has been used.</p><% } %><details><summary>Allowance details</summary><p>Included provider cost: <%= usd(cost.accountMinor) %> of <%= usd(cost.accountCapMinor) %> account limit. This inventory: <%= usd(cost.workspaceMinor) %> of <%= usd(cost.workspaceCapMinor) %>.</p><p>Credit balance: <%= cost.credits.remaining===null?'Unlimited':cost.credits.remaining %>; reserved: <%= cost.credits.reserved %>. Both credits and spending protection must be available.</p><% if(cost.sharedTestAllowance){ %><p>Authorized shared AI testing cap: <%= usd(cost.sharedTestAllowance.maximumMinor) %> until <%= helpers.dateTime(cost.sharedTestAllowance.expiresAt) %>. Ask and AI file reading share this allowance. Request, daily and total test ceilings still apply.</p><% }else if(cost.nativeTestAllowance){ %><p>Authorized Ask testing cap: <%= usd(cost.nativeTestAllowance.maximumMinor) %> until <%= helpers.dateTime(cost.nativeTestAllowance.expiresAt) %>. Other AI work retains its standard spending limit.</p><% } %></details><a class="btn" href="/settings#ai-spending"><%= cost.paused?'Review and raise limit':'Manage AI allowance' %></a></div></section><% } %>

<% } %>