<% if(locals.aiCost){ const cost=aiCost,usd=n=>'$'+(n/100).toFixed(2); %><section class="card section" aria-label="AI availability"><div class="card-body"><h2>AI credits and spending limits</h2><p><strong><%= cost.credits.remaining===null?'No credit limit':Number(cost.credits.remaining).toLocaleString()+' AI credits remaining' %></strong><% if(cost.credits.reserved){ %> · <%= cost.credits.reserved %> in progress<% } %>.</p><p>Account AI cost: <%= usd(cost.accountMinor) %> / <%= usd(cost.accountCapMinor) %>. This inventory: <%= usd(cost.workspaceMinor) %> / <%= usd(cost.workspaceCapMinor) %>.</p><% if(cost.paused){ %><p role="alert" class="notice notice--warn"><%= cost.reason==='SPENDING_LIMIT'?'AI work is paused by a spending limit. Your remaining credits have not expired or disappeared. The account owner can review and raise the limit in Settings.':'AI work is paused because no credits remain. Review your plan and available usage packs.' %></p><% }else if(cost.warning||cost.creditWarning){ %><p role="status" class="notice notice--warn">At least 80% of an AI spending limit or included credit allowance has been used.</p><% } %><a href="/settings#ai-spending">Review AI spending limits</a> · <a href="/billing">Plan &amp; Usage</a></div></section><% } %>
