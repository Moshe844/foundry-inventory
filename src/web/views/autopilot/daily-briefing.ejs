<% const day=result.briefingDate,attention=result.rows.filter(row=>/approvals waiting|overdue|Out of stock|Running low/i.test(row.Activity||'')),activity=result.rows.filter(row=>!attention.includes(row)); %>
<div class="sc-briefing">
 <header class="sc-briefing-head"><div><p class="rm-eyebrow">Your business at a glance</p><h1>Daily briefing</h1><p><%= day?helpers.shortDate(day):'Your latest completed business day' %></p></div><div class="rm-actions"><a class="rm-btn rm-btn--quiet" href="/needs-you">Back to Needs you</a><% if(day){ %><form method="post" action="/autopilot/briefings/<%= day %>/dismiss"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="rm-btn rm-btn--quiet" type="submit">Dismiss this briefing</button></form><% } %></div></header>
 <section class="rm-card"><h2>Needs your attention</h2><% if(attention.length){ %><div class="sc-briefing-metrics"><% attention.forEach(row=>{ %><a href="<%= row.link %>" class="sc-briefing-metric"><strong><%= Number(row.Count||0).toLocaleString('en-US') %></strong><span><%= row.Activity %></span><small><%= Number(row.Count)>0?'Review':'Nothing waiting' %></small></a><% }); %></div><% }else{ %><p>No attention summary is available for this day.</p><% } %></section>
 <section class="rm-card"><h2>What happened</h2><% if(activity.some(row=>Number(row.Count)>0)){ %><ul class="sc-briefing-list"><% activity.filter(row=>Number(row.Count)>0).forEach(row=>{ %><li><span><%= row.Activity %></span><strong><%= Number(row.Count).toLocaleString('en-US') %></strong><a href="<%= row.link %>">View activity</a></li><% }); %></ul><% }else{ %><p>No stock movements, completed orders or automatic work were recorded for this day.</p><% } %><p class="rm-note"><%= result.summary %></p></section>
 <section class="rm-card"><h2>Briefing notices</h2><p><%= result.reportEmail.noticesEnabled?'New briefing notices appear in Needs you.':'Future briefing notices are hidden from Needs you.' %> You can still open briefing history. Email delivery is controlled separately below.</p><form method="post" action="/autopilot/briefing-notices"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="enabled" value="<%= result.reportEmail.noticesEnabled?'no':'yes' %>"><button class="rm-btn rm-btn--quiet" type="submit"><%= result.reportEmail.noticesEnabled?'Hide future briefing notices':'Show future briefing notices' %></button></form></section>
 <details class="rm-card sc-briefing-delivery"><summary>Email delivery and schedule</summary><%- include('report-email-delivery',{panel:result.reportEmail,csrfToken}) %></details>
</div>
