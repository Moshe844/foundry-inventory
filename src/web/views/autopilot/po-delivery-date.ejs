<% const isAmendment=Boolean(p?.amendmentInput); %>
<h1><%= isAmendment?'Supplier purchase changes':'Supplier delivery date' %></h1>
<p>Review the exact terms the supplier sent through its private purchase-order link, a reply on the purchase-order email thread or a saved supplier document.</p>
<% if(locked){ %><section class="card"><h2><span class="badge">Pro</span> Supplier date updates</h2><p>Pro lets you review dates and teach routine scopes. Custom can handle dates within your explicit settings. Starter and Growth do not include this agent job.</p><a class="btn" href="/settings/billing">Upgrade</a></section><% } %>
<% if(shadow){ %><p class="notice">StockChief watches during the first 14 days. You can compare the source here; agent date changes and new routine scopes wait until that period ends.</p><% } %>
<% if(problem){ %><p class="notice"><%= problem %></p><% } %>
<% if(p&&!locked){ %><section class="card"><h2><%= p.orderNumber %> · <%= p.supplierName %></h2><p><a href="/purchasing/orders/<%= p.orderId %>">Original purchase order</a></p><p>Receiving warehouse: <strong><%= p.destinationName %></strong> · Order currency: <%= p.currency %>.</p><p>Supplier response saved <time data-local-time datetime="<%= new Date(p.receivedAt).toISOString() %>"><%= helpers.dateTime(p.receivedAt) %></time>. Known supplier contact: <%= p.supplierEmail %>.</p>
<dl><dt>Current delivery promise</dt><dd><%= p.currentDate||'No date recorded' %></dd><dt>Supplier’s submitted date</dt><dd><%= p.proposedDate||'No change requested' %></dd><dt>Original promise used for the total-change limit</dt><dd><%= p.originalDate||'The first individually approved date' %></dd></dl>
<ul><% for(const product of p.products){ %><li><%= product.code %> · <%= product.purchaseUnit %> of <%= product.unitsPerPurchaseUnit %> <%= product.unit %></li><% } %></ul>
<% if(p.mailSource&&p.mailSource.source==='document'){ %><p><a href="/mail/<%= p.mailSource.id %>">Open the supplier’s original message</a></p>
  <p>These changes come from a supplier document saved from that message. Routine changes from saved documents need their own approval.</p><% } %>
<% if(isAmendment){ %>
  <% if(p.mailSource&&p.mailSource.source!=='document'){ %><p><a href="/mail/<%= p.mailSource.id %>">Open original supplier email</a></p>
    <p>This routine uses the connected mailbox that received this reply. A different mailbox needs its own approval.</p><% } %>
  <h3>Proposed changes to goods still due</h3>
  <% for(const line of p.amendments){ %>
  <p><strong>Line <%= line.number %> · <%= line.name %> · <%= line.code %></strong><br>
    Ordered <%= line.before.quantity %> <%= line.unit %><%= line.before.secondary?' · '+line.before.secondary+' '+line.weightUnit:'' %>
    at <%= line.before.price==null?'an unrecorded price':helpers.money(line.before.price,p.currency)+' per '+(line.weightUnit||line.unit) %>.<br>
    Revised remaining <%= line.remaining.quantity %> <%= line.unit %><%= line.remaining.secondary?' · '+line.remaining.secondary+' '+line.weightUnit:'' %>
    at <%= line.remaining.price==null?'an unrecorded price':helpers.money(line.remaining.price,p.currency)+' per '+(line.weightUnit||line.unit) %>.
    <% if(line.replacement){ %><br>Goods already received keep their original line and price.<% } %>
  </p>
  <% } %>
<% } %>
<% if(receipt?.processed_at){ %><p><strong><%= receipt.changed?(isAmendment?'Purchase order updated':'Delivery promise updated'):'Reviewed without changes' %></strong> · <%= receipt.automatic?'Within authorized routine limits':'Individually approved' %>.</p>
<% }else if(prepared){ %><form method="post" action="/autopilot/po-delivery-dates/<%= p.sourceId %>" class="form-stack"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="expectedFingerprint" value="<%= p.sourceFingerprint %>"><label><input type="checkbox" name="confirmed" value="yes" required> <%= isAmendment?'I approve these exact supplier terms for the current purchase order.':'I approve this exact supplier date for the current purchase order.' %></label>
<% if(prepared.older){ %><label><input type="checkbox" name="overrideNewer" value="yes" required> I reviewed newer supplier responses or owner edits and intend to replace the current terms with this source.</label><% } %><% if(p.proposedDate&&p.proposedDate<prepared.today){ %><label><input type="checkbox" name="pastDateConfirmed" value="yes" required> I intend to record this already-past supplier promise. It does not mean the goods arrived.</label><% } %><button class="btn" <%= shadow?'disabled':'' %>><%= isAmendment?'Apply reviewed changes':'Apply reviewed delivery date' %></button></form><% } %></section>
<section class="card"><h2><%= isAmendment?'Routine purchase changes':'Routine delivery-date scope' %></h2><p>Authorize this known supplier, these exact product and purchase-unit profiles, this receiving warehouse and currency. Future orders can contain a subset of these products. New products, changed units, newer owner edits, dates in the past and overlapping settings stop for review.</p><p><%= plan==='pro'?'On Pro, individually approve and teach a matching example before routine changes can run.':'Custom needs no taught example, but all your lower taught limits still apply.' %> Routine work also needs your inventory and job authority enabled.</p>
<form method="post" action="/autopilot/po-delivery-dates/<%= p.sourceId %>/settings" class="form-stack"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="revision" value="<%= setting?.revision||0 %>"><%- include('po-date-limits',{values:setting?.limits||{}}) %><% if(isAmendment){ %><%- include('po-commercial-limits',{values:setting?.limits.commercial,currency:p.currency}) %><% } %><label><input type="checkbox" name="confirmed" value="yes" required> I authorize only new supplier responses received after this approval, inside this exact scope and every limit above.</label><button class="btn" <%= shadow?'disabled':'' %>><%= isAmendment?'Authorize routine purchase changes':'Authorize routine date scope' %></button></form></section>
<% if(canTeach){ %><section class="card"><h2>Teach the reviewed supplier scope</h2><p>A lower taught limit continues to apply after a plan upgrade.</p><form method="post" action="/autopilot/po-delivery-dates/<%= p.sourceId %>/teach" class="form-stack"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="revision" value="<%= rule?.revision||0 %>"><%- include('po-date-limits',{values:rule?.limits||{}}) %><% if(isAmendment){ %><%- include('po-commercial-limits',{values:rule?.limits.commercial,currency:p.currency}) %><% } %><label><input type="checkbox" name="confirmed" value="yes" required> I teach only this individually reviewed supplier, warehouse, product and purchase-unit scope within these limits.</label><button class="btn" <%= shadow?'disabled':'' %>><%= isAmendment?'Teach purchase-change scope':'Teach delivery-date scope' %></button></form></section><% } %>
<% } %>
<% if(settings.length){ %><section class="card"><h2>Saved routine scopes</h2><% for(const row of settings){ %><section><h3><%= row.scope.supplierEmail %> · <%= row.destination_name %></h3><p><%= row.scope.currency %> · <%= row.scope.products.map(product=>product.code).join(', ') %> · <%= row.enabled?'Enabled':'Stopped' %>. Maximum changes: <%= row.limits.maximumShiftDays %> days per update, <%= row.limits.maximumTotalShiftDays %> days in total, <%= row.limits.maximumFutureDays %> days ahead.</p><% if(row.enabled){ %><form method="post" action="/autopilot/po-delivery-date-settings/<%= row.id %>/stop"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="revision" value="<%= row.revision %>"><button class="btn">Stop this date scope</button></form><% } %></section><% } %><% if(moreSettings){ %><p>Showing the first 100 scopes. Open the source response for the exact supplier and product set to manage its scope.</p><% } %></section><% } %>
<% if(rule){ %><section class="card"><h2>Current taught date limit</h2><p><%= rule.limits.maximumShiftDays %> days per update · <%= rule.limits.maximumTotalShiftDays %> days in total · <%= rule.limits.maximumFutureDays %> days ahead.</p><form method="post" action="/autopilot/po-delivery-date-rules/remove"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="scopeHash" value="<%= rule.scope_hash %>"><input type="hidden" name="revision" value="<%= rule.revision %>"><label><input type="checkbox" name="confirmed" value="yes" required> I confirm removing this current taught date limit. Other routine settings still apply.</label><button class="btn">Remove taught date scope</button></form></section><% } %>
<% if(settingsPage>1||moreSettings){ %><nav aria-label="Saved scope pages"><% if(settingsPage>1){ %><a href="/autopilot/po-delivery-dates/<%= sourceId %>?settingsPage=<%= settingsPage-1 %>">Previous saved scopes</a><% } %> <span>Saved scopes · page <%= settingsPage %></span> <% if(moreSettings){ %><a href="/autopilot/po-delivery-dates/<%= sourceId %>?settingsPage=<%= settingsPage+1 %>">Next saved scopes</a><% } %></nav><% } %>
<p>AI credits used: 0.</p>
