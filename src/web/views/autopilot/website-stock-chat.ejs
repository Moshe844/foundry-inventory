<style>.stock-chat-admin{max-width:950px;margin:auto}.stock-chat-admin section{padding:18px;border:1px solid var(--border,#d5dde6);border-radius:12px;margin:18px 0}.stock-chat-admin form{display:grid;gap:12px;margin:14px 0}.stock-chat-admin label{display:grid;gap:6px;min-width:0}.stock-chat-admin label:has(input[type=checkbox]){display:block}.stock-chat-admin input:not([type=checkbox]),.stock-chat-admin textarea,.stock-chat-admin select{width:100%;box-sizing:border-box;max-width:100%}.stock-chat-admin p{overflow-wrap:anywhere}.stock-chat-admin button{white-space:normal}</style><div class="stock-chat-admin"><p><a data-stock-chat-back href="<%= screen.allowed?'/autopilot/reviews/website-stock-chat':'/autopilot' %>">← <%= screen.allowed?'Website stock answer review':'StockChief AI' %></a></p><h1>Website stock and delivery answers</h1><p>Visitors can ask for an exact published product code’s current available stock or your checked public delivery policy. Customer commitments, requested transfers, return and repair/QC holds stay out of available stock. StockChief does not accept orders, take payments or promise delivery dates through this assistant.</p>
<% if(!screen.allowed){ %><section data-agent-plan-locked><h2>Pro or Custom required</h2><p>Website answers need no training on Pro or Custom, after the watch period within the owner’s current authority. Saved assistants can still be stopped.</p><a class="btn" href="/billing">Upgrade</a></section><% } %>
<% if(issuedUrl){ %><section role="status"><h2>Website assistant ready</h2><p><a class="btn btn--primary" href="<%= issuedUrl %>" target="_blank" rel="noopener noreferrer">Open the public stock assistant</a></p><label>Embed this assistant in an approved website<textarea readonly rows="4" aria-label="Embed this assistant in an approved website"><%= '<iframe src="'+issuedUrl+'" title="Stock and delivery assistant" width="360" height="580" style="max-width:100%;border:0" loading="lazy"></iframe>' %></textarea></label><p>Copy this embed code now. The link is shown only in this response; revising the assistant creates a new link and revokes the previous one.</p></section><% } %>
<% if(screen.allowed){ %><% if(screen.shadow){ %><p class="notice">The first 14 days are for watching. You can prepare the public scope; answers stay unavailable until the watch period ends and routine work is authorized.</p><% } %><section><h2>Publish checked public answers</h2><p>Choose up to 1,000 whole-unit product codes and one internal stock location. Only availability bands are shown unless you separately choose to publish exact available quantities. Enable routine work in StockChief AI to allow answers; Watch, pause, plan changes or invalid source facts stop them.</p><form method="post" action="/autopilot/website-stock-chat/publish"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><label>Public assistant title<input name="label" required maxlength="120" placeholder="Stock and delivery help"></label><label>Approved stock location<select name="locationId" aria-label="Approved stock location" required><% screen.places.forEach(function(l){ %><option value="<%= l.id %>"><%= l.name %></option><% }) %></select></label><label>Published SKU codes, one per line<textarea name="skuCodes" rows="5" required></textarea></label><label>Your checked public delivery answer<textarea name="deliveryAnswer" rows="4" required maxlength="600" placeholder="State your checked policy; the team confirms order-specific dates."></textarea></label><label>Exact websites allowed to embed this assistant<textarea name="embedOrigins" aria-label="Exact websites allowed to embed this assistant" rows="3" placeholder="https://shop.example.com"></textarea><small>One HTTPS origin per line, up to ten. Leave empty to open the assistant directly on StockChief.</small></label><label><input type="checkbox" name="showQuantity" value="yes"> Also publish exact available quantities for these products.</label><label><input type="checkbox" name="confirmed" value="yes" required> I approve publishing only these product names and stock answers, the selected quantity visibility and this checked delivery policy to website visitors until I stop it.</label><button class="btn btn--primary">Publish website stock assistant</button></form><% if(screen.morePlaces){ %><p>Showing the first 250 internal locations.</p><% } %></section><% } %>
<section><h2>Saved website assistants</h2><% screen.rows.forEach(function(p){ %><details><summary><%= p.label %> · <%= p.enabled?'Published within current authority':'Stopped' %></summary><p><%= p.location_name %> · <%= p.sku_ids.length %> products · <%= p.show_quantity?'Exact available quantities are published':'Availability bands only' %></p><p>Delivery answer: <%= p.delivery_answer %></p><p>Embedding: <%= p.embed_origins.length?p.embed_origins.join(', '):'StockChief only' %></p><% if(p.enabled){ %><form method="post" action="/autopilot/website-stock-chat/<%= p.id %>/stop"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="revision" value="<%= p.revision %>"><button class="btn">Stop public stock answers</button></form><% } %>
<% if(screen.allowed){ %><form method="post" action="/autopilot/website-stock-chat/publish"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="id" value="<%= p.id %>"><input type="hidden" name="revision" value="<%= p.revision %>"><input type="hidden" name="label" value="<%= p.label %>"><input type="hidden" name="locationId" value="<%= p.location_id %>"><label>Revised published SKU codes<textarea name="skuCodes" required rows="4"><%= p.source_snapshot.products.map(function(s){return s.code}).join('\n') %></textarea></label><label>Revised checked delivery answer<textarea name="deliveryAnswer" required maxlength="600"><%= p.delivery_answer %></textarea></label><label>Revised allowed website origins<textarea name="embedOrigins" rows="3"><%= p.embed_origins.join('\n') %></textarea></label><label><input type="checkbox" name="showQuantity" value="yes" <%= p.show_quantity?'checked':'' %>> Publish exact available quantities in this revised scope.</label><label><input type="checkbox" name="confirmed" value="yes" required> I approve this revised public scope and revoking the old assistant link.</label><button class="btn">Publish revised assistant link</button></form><% } %></details><% }) %><% if(screen.page>1){ %><a href="/autopilot/website-stock-chat?page=<%= screen.page-1 %>">Previous assistants</a><% } %><% if(screen.more){ %><a href="/autopilot/website-stock-chat?page=<%= screen.page+1 %>">Next assistants</a><% } %></section></div>
