<div class="page-head"><div class="titles">
  <h1>Late supplier delivery reminders</h1>
  <p>Authorize reminders for placed warehouse purchases that have missed their recorded delivery date. StockChief checks the original order, receipts and supplier replies each time.</p>
</div></div>
<% if(!allowed){ %><section class="notice"><span class="badge">Growth</span> Late supplier reminders require Growth, Pro or Custom. <a class="btn" href="/billing">Upgrade</a></section><% } %>
<% if(shadow){ %><p class="notice">StockChief is in its initial watch period. Authorized reminders can start once that period ends and routine work is enabled.</p><% } %>
<% if(allowed){ %>
  <% if(supplierProblem){ %><p class="notice"><%= supplierProblem %></p><% } %>
  <% if(!selected&&!supplier){ %><section class="card section"><h2>Choose the supplier</h2>
    <form method="get" action="<%= path %>" class="form-stack">
      <label>Exact supplier name <input name="supplierName" maxlength="240" required></label>
      <button class="btn" type="submit">Review supplier and mailbox</button>
    </form>
  </section><% } %>
  <% if(supplier){ %><section class="card section"><h2><%= supplier.name %></h2>
    <% if(!supplier.email){ %><p>Add the supplier’s purchase email on its contact record before creating a reminder rule.</p><% }else if(!mailboxes.length){ %>
      <p>Connect a Gmail or Microsoft 365 sending mailbox to authorize reminders.</p><a class="btn" href="/settings/connections">Open connections</a>
    <% }else{ %><p>Send overdue delivery reminders to <strong><%= supplier.email %></strong>.</p>
      <form method="post" action="<%= path %><%= selected?'/'+selected.id:'' %>" class="form-stack">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <input type="hidden" name="supplierId" value="<%= supplier.id %>">
        <input type="hidden" name="expectedRecipient" value="<%= supplier.email %>">
        <% if(selected){ %><input type="hidden" name="revision" value="<%= selected.revision %>"><% } %>
        <label>Sending mailbox <select name="connectorId" required><option value="">Choose the mailbox</option>
          <% mailboxes.forEach(box=>{ %><option value="<%= box.id %>" <%= selected?.connector_id===box.id?'selected':'' %>><%= [box.display_name,box.provider_account_name].filter(Boolean).join(' · ') %></option><% }) %>
        </select></label>
        <label>Maximum reminders for each late order <input type="number" name="maximumMessages" min="1" max="5" step="1" value="<%= selected?.maximum_messages||'' %>" required></label>
        <label>Minimum hours between late reminders <input type="number" name="intervalHours" min="24" max="720" step="1" value="<%= selected?.interval_hours||'' %>" required></label>
        <label><input type="checkbox" name="confirmed" value="yes" required> I authorize reminders for this supplier’s placed warehouse orders, from this mailbox, within these limits.</label>
        <button class="btn btn--primary" type="submit">Authorize late-delivery reminders</button>
      </form>
    <% } %>
  </section><% } %>
<% } %>
<section class="card section"><h2>Saved supplier rules</h2>
  <% if(!rules.length){ %><p>No supplier reminder rules yet.</p><% } %>
  <% for(const rule of rules){ %><article class="section">
    <h3><a href="<%= path %>/<%= rule.id %>"><%= rule.supplier_name %></a></h3>
    <p><%= rule.enabled?'Authorized':'Stopped' %> · <%= rule.recipient %> · <%= rule.mailbox_name %> · <%= rule.maximum_messages %> per late order · at least <%= rule.interval_hours %> hours apart.</p>
    <% if(rule.enabled){ %><form method="post" action="<%= path %>/<%= rule.id %>">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <input type="hidden" name="revision" value="<%= rule.revision %>">
      <button class="btn" type="submit" name="stop" value="yes">Stop future reminders</button>
    </form><% } %>
  </article><% } %>
  <% if(pageNumber>1){ %><a class="btn" href="<%= path %>?page=<%= pageNumber-1 %>">Previous</a><% } %>
  <% if(more){ %><a class="btn" href="<%= path %>?page=<%= pageNumber+1 %>">Next</a><% } %>
</section>
