<div class="page-head"><div class="titles"><h1>Supplier quote requests</h1><p>Prepare one product request for several suppliers, with a separate email to each recipient.</p></div></div>
<% if(locked){ %><section class="notice"><div><span class="badge">Pro</span> Supplier RFQs require Pro or Custom. <a class="btn" href="/settings/billing">Upgrade</a></div></section><% }else{ %>
<p>Pro learns from a completed manual RFQ batch. Custom can use your exact supplier, product, quantity and weekly limits without training. A first request for a new supplier needs approval. Each request asks for a quotation; it never places an order or accepts terms.</p>
<% if(shadow){ %><p class="notice">The first 14 days are Watch only. RFQ preparation and sending wait until that period ends.</p><% } %>
<% if(problem){ %><p class="notice"><%= problem %></p><% } %>
<% if(!routineReady){ %><p>Routine RFQ sending is paused. The owner can review StockChief’s routine-work authority in <a href="/autopilot">StockChief AI</a>. Individual RFQ review keeps its own current controls.</p><% } %>
<% if(saved){ const p=saved.snapshot; %><section class="card section"><h2><%= p.reference %></h2><p>Reply requested by <%= p.replyBy %>. <%= p.suppliers.length %> separate supplier emails.</p>
<% if(p.deliverBy){ %><p>Needed by <strong><%= p.deliverBy %></strong>, delivered to <%= p.location.name %>.</p><% } %>
<% if(fromRule){ %><p>Prepared by your quote rule “<%= fromRule.name %>”.</p><% } %>
<% if(saved.needs_person&&!deliveries.length){ %><p class="notice"><%= saved.needs_person %></p><% } %>
<% if(saved.closed_at){ %><p class="notice">Closed <%= helpers.dateTime(saved.closed_at) %>. No more reminders go out.</p><% } %>
<div class="table-scroll"><table><thead><tr><th>Product</th><th>Requested quantity</th></tr></thead><tbody><% for(const line of p.lines){ const item=p.products.find(v=>v.id===line.skuId); %><tr><td><%= item.code %> · <%= item.name %></td><td><%= line.quantity %> <%= item.unit_label %></td></tr><% } %></tbody></table></div>
<% for(const mail of words){ const delivered=deliveries.find(d=>d.supplier_id===mail.id); %><article class="section"><h3><%= mail.name %></h3><p>To <%= mail.email %> · <%= delivered?(delivered.status==='SENT'?'Accepted by the mailbox provider':delivered.effect_status==='AMBIGUOUS'?'Outcome uncertain — check the mailbox Sent folder':delivered.status==='FAILED'?'Needs review': 'Queued for sending'):'Draft for review' %></p><% if(delivered?.error_message||delivered?.effect_error){ %><p class="notice"><%= delivered.error_message||delivered.effect_error %></p><% } %>
<% if(delivered){ %><p><%= delivered.quote_document_id?'Quote recorded.':delivered.reply_message_id?'Replied.':'No reply yet.' %><% if(delivered.reply_message_id){ %> <a href="/mail/<%= delivered.reply_message_id %>">Open the reply</a><% } %><% if(delivered.chase_communication_id){ %> · Reminder <%= delivered.chase_status==='SENT'?'sent':'queued' %><%= delivered.chase_automatic?' by StockChief':'' %>.<% } %></p><% } %>
<details><summary>Review this supplier’s exact email</summary><p><strong><%= mail.subject %></strong></p><pre style="white-space:pre-wrap;overflow-wrap:anywhere;font:inherit"><%= mail.body %></pre></details>
<% if(delivered&&delivered.canChase){ %><form method="post" action="/autopilot/supplier-rfqs/<%= saved.id %>/chase/<%= delivered.id %>" class="form-stack"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="confirmed" value="yes"><button class="btn" <%= shadow?'disabled':'' %>>Send <%= mail.name %> a reminder</button></form><% } %>
<% if(delivered&&delivered.status==='SENT'&&!delivered.quote_document_id){ %><details class="section"><summary>Record <%= mail.name %>’s quote</summary><% if(delivered.replyProblem){ %><p><%= delivered.replyProblem %></p><% } %>
<form method="post" action="/autopilot/supplier-rfqs/<%= saved.id %>/quote/<%= mail.id %>" class="form-stack"><input type="hidden" name="_csrf" value="<%= csrfToken %>">
<label class="rm-field"><span>Their reply</span><select name="messageId" required><% for(const m of delivered.messages){ %><option value="<%= m.id %>" <%= m.id===delivered.reply_message_id?'selected':'' %>><%= m.subject||'(no subject)' %> · <%= helpers.dateTime(m.created_at) %></option><% } %></select></label>
<% if(!delivered.messages.length){ %><p>No email from <%= mail.name %> has arrived since the RFQ was sent.</p><% } %>
<% for(const line of p.lines){ const item=p.products.find(v=>v.id===line.skuId); %><label class="rm-field"><span><%= item.code %>: unit price in <%= mail.currency %></span><input name="price_<%= line.skuId %>" inputmode="decimal"></label><label class="rm-field"><span><%= item.code %>: quoted quantity</span><input name="quantity_<%= line.skuId %>" inputmode="numeric" value="<%= line.quantity %>"></label><% } %>
<label class="rm-field"><span>Delivery date they can meet (optional)</span><input name="expectedArrivalDate" type="date"></label>
<label class="rm-field"><span>Words from the reply that show these prices</span><textarea name="evidenceQuote" rows="3" maxlength="1000" required></textarea></label>
<label class="rm-field"><span>Quote valid through (optional)</span><input name="validThrough" type="date"></label><label class="rm-field"><span>Freight (optional)</span><input name="freight" inputmode="decimal"></label>
<label class="rm-field"><span>Words from the reply that show the validity or freight</span><textarea name="termsEvidence" rows="2" maxlength="1000"></textarea></label>
<button class="btn" <%= !delivered.messages.length?'disabled':'' %>>Record this quote</button></form></details><% } %></article><% } %>
<% if(deliveries.length!==p.suppliers.length||deliveries.some(d=>d.status!=='SENT')){ %><form method="post" action="/autopilot/supplier-rfqs/<%= saved.id %>/send" class="form-stack section"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="sourceFingerprint" value="<%= saved.source_fingerprint %>"><label><input type="checkbox" name="confirmed" value="yes" required> I reviewed each exact supplier, recipient, product, quantity and email. Send this RFQ batch once.</label><button class="btn btn--primary" <%= shadow||problem?'disabled':'' %>>Approve and queue these exact RFQ emails</button></form><% } %>
<% if(comparison.length){ %><section class="section"><h3>Quotes so far</h3><p>Ranked by the price of the goods for the same product, quantity, delivery place and currency. Accepting a price is always your call: start a purchase order with the supplier you choose.</p>
<div class="table-scroll"><table><thead><tr><th>Product</th><th>Supplier</th><th>Quoted units</th><th>Unit price</th><th>Goods</th><th>Freight</th><th>Rank</th><th>Arrives</th><th>Valid through</th><th>Original</th></tr></thead><tbody><% for(const q of comparison){ %><tr><td><%= q.SKU %></td><td><%= q.Supplier %></td><td><%= q['Quoted stock units'] %></td><td><%= q['Supplier unit price'] %></td><td><%= q['Quoted goods'] %></td><td><%= q['Quoted delivery charge']||'—' %></td><td><%= q['Goods price rank']||'—' %></td><td><%= q['Promised arrival']||'—' %></td><td><%= q['Valid through']||'—' %></td><td><a href="<%= q.link %>">Reply</a></td></tr><% } %></tbody></table></div>
<% for(const t of totals){ %><p><strong><%= t.supplier %></strong>: <%= t.goods %> for <%= t.lines %> of <%= p.lines.length %> products. <a href="/purchasing/orders/new?supplier=<%= encodeURIComponent(t.supplierId) %>">Start a purchase order with <%= t.supplier %></a></p><% } %></section><% } %>
<% if(teachable){ %><form method="post" action="/autopilot/supplier-rfq-competition/<%= fromRule.id %>/teach" class="form-stack section"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="requestId" value="<%= saved.id %>"><input type="hidden" name="revision" value="<%= fromRule.revision %>"><h3>Let this rule send on its own</h3><p>You sent this RFQ yourself. From now on, RFQs from “<%= fromRule.name %>” go out on their own, up to <%= fromRule.max_requests_per_week %> a week.</p><label><input type="checkbox" name="confirmed" value="yes" required> Send RFQs from this rule on their own.</label><button class="btn">Teach this rule</button></form><% } %>
<% if(!saved.closed_at&&deliveries.length){ %><form method="post" action="/autopilot/supplier-rfqs/<%= saved.id %>/close" class="form-stack section"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="confirmed" value="yes"><button class="btn">I’m done with this RFQ</button></form><% } %>
<% if(eligibleRules.length&&(deliveries.length!==p.suppliers.length||deliveries.some(d=>d.status!=='SENT'))){ %><form method="post" action="/autopilot/supplier-rfqs/<%= saved.id %>/routine" class="form-stack section"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><label class="rm-field"><span>Use an existing RFQ rule</span><select name="ruleId" required><option value="">Choose exact supplier and product authority</option><% for(const r of eligibleRules){ %><option value="<%= r.id %>"><%= r.scope.profile.suppliers.map(s=>s.name).join(', ') %> · up to <%= r.max_requests_per_week %> requests per seven days</option><% } %></select></label><p>The saved supplier, product and quantity scope is checked again. Anything outside it stays unsent.</p><button class="btn" <%= !routineReady||problem?'disabled':'' %>>Queue within my existing RFQ authority</button></form><% } %>
<% if(!saved.competition_rule_id){ %><form method="post" action="/autopilot/supplier-rfqs/<%= saved.id %>/authority" class="form-stack section"><h3><%= matchingRule?'Review the current RFQ rule':'Authorize matching future requests' %></h3><% if(matchingRule){ %><input type="hidden" name="ruleId" value="<%= matchingRule.id %>"><input type="hidden" name="revision" value="<%= matchingRule.revision %>"><p>This updates the existing matching rule. Its current weekly limit is <%= matchingRule.max_requests_per_week %> requests.</p><% } %><input type="hidden" name="_csrf" value="<%= csrfToken %>"><% if(plan==='pro'){ %><p>Pro uses a completed manual batch for this exact supplier, product and mailbox scope. Automatic batches cannot teach themselves.</p><input type="hidden" name="exampleId" value="<%= trainingExampleId %>"><% }else{ %><p>Custom can authorize this exact scope without a taught example.</p><% } %><label class="rm-field"><span>Maximum requests per rolling seven days</span><input type="number" name="maxRequestsPerWeek" min="1" max="20" required></label><label><input type="checkbox" name="confirmed" value="yes" required> Authorize only these exact suppliers, current email addresses, products and purchase packs, up to each quantity shown above and this weekly limit.</label><button class="btn" <%= !routineReady||problem||(plan==='pro'&&!manualExampleReady)?'disabled':'' %>>Authorize this bounded RFQ scope</button></form><% } %>
</section><% } %>
<section class="card section"><h2>Prepare a new request</h2><p>Choose two to twenty known suppliers and your exact requested product quantities. Saved supplier codes and pack terms are included where known. Missing product or pack terms become explicit questions to the supplier; no quantities or terms are invented.</p><form method="post" action="/autopilot/supplier-rfqs/preview" class="form-stack"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="requestKey" value="<%= requestKey %>"><label class="rm-field"><span>RFQ reference</span><input name="reference" maxlength="160" required></label><label class="rm-field"><span>Exact supplier names, one per line</span><textarea name="supplierNames" rows="4" maxlength="5000" required></textarea></label><label class="rm-field"><span>SKU code and quantity, pasted as two spreadsheet columns</span><textarea name="productRows" rows="6" maxlength="30000" required></textarea></label><label class="rm-field"><span>Quotation reply date</span><input name="replyBy" type="date" required></label><label class="rm-field"><span>Needed by</span><input name="deliverBy" type="date" required></label><label class="rm-field"><span>Deliver to</span><select name="locationId" required><option value="">Choose a location</option><% for(const l of locations){ %><option value="<%= l.id %>"><%= l.name %></option><% } %></select></label><label class="rm-field"><span>Sending mailbox</span><select name="connectorId" required><option value="">Choose a connected mailbox</option><% for(const box of mailboxes){ %><option value="<%= box.id %>"><%= box.display_name %> · <%= box.provider_account_name||box.provider_type %></option><% } %></select></label><% if(!mailboxes.length){ %><p>No sending mailbox is connected. <a href="/settings/connections">Connect Gmail or Microsoft 365</a>.</p><% } %><button class="btn" <%= shadow||!mailboxes.length?'disabled':'' %>>Prepare RFQ emails for review</button></form></section>
<section class="card section"><h2>When to ask for quotes</h2><p>When an item needs buying and it matches one of these rules, StockChief prepares one RFQ for the suppliers you name and reminds those who do not reply. <%= plan==='pro'?'On Pro it waits for you to send the first one from a rule and teach it; then it sends them on its own.':'On Custom it sends them on its own.' %> It asks about the same product at most once every 30 days. It never accepts a price or places an order.</p>
<% for(const r of competitionRules){ %><article class="section"><h3><%= r.name %></h3><p><%= r.enabled?(plan==='pro'&&!r.example_request_id?'On · drafts until you teach it':'On'):'Stopped' %> · asks <%= (r.supplier_names||[]).join(', ') %> · delivered to <%= r.location_name %> · reply in <%= r.reply_days %> days, needed in <%= r.delivery_days %> days, reminder after <%= r.chase_days %> days · up to <%= r.max_requests_per_week %> a week (<%= r.used %> used).</p>
<p>Asks when: <%= [r.new_items?'a new item needs buying':null,r.threshold_minor?'a purchase is worth '+helpers.money(Number(r.threshold_minor),r.currency)+' or more':null,(r.sku_codes||[]).length?'it is one of '+r.sku_codes.join(', '):null,r.categories.length?'it is in '+r.categories.join(', '):null].filter(Boolean).join('; or ') %>.</p>
<% if(r.last_note){ %><p>Last check<%= r.last_run_at?' '+helpers.dateTime(r.last_run_at):'' %>: <%= r.last_note %></p><% } %>
<% if(r.enabled){ %><form method="post" action="/autopilot/supplier-rfq-competition/<%= r.id %>/stop"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="revision" value="<%= r.revision %>"><button class="btn">Stop this quote rule</button></form><% } %></article><% } %>
<details class="section"><summary>Add a quote rule</summary><form method="post" action="/autopilot/supplier-rfq-competition" class="form-stack"><input type="hidden" name="_csrf" value="<%= csrfToken %>">
<label class="rm-field"><span>Rule name</span><input name="ruleName" maxlength="120" required></label>
<label><input type="checkbox" name="ruleNewItems" value="yes"> Ask for quotes when a new item needs buying</label>
<label class="rm-field"><span>Or when a purchase is worth at least</span><input name="ruleThreshold" inputmode="decimal"></label><label class="rm-field"><span>Currency of that amount</span><input name="ruleCurrency" maxlength="3"></label>
<label class="rm-field"><span>Or for these product codes, one per line</span><textarea name="ruleSkuCodes" rows="3" maxlength="10000"></textarea></label>
<label class="rm-field"><span>Or for these categories, one per line</span><textarea name="ruleCategories" rows="3" maxlength="10000"></textarea></label>
<label class="rm-field"><span>Suppliers to ask, one per line</span><textarea name="ruleSuppliers" rows="4" maxlength="5000" required></textarea></label>
<label class="rm-field"><span>Deliver to</span><select name="ruleLocationId" required><option value="">Choose a location</option><% for(const l of locations){ %><option value="<%= l.id %>"><%= l.name %></option><% } %></select></label>
<label class="rm-field"><span>Send from</span><select name="ruleConnectorId" required><option value="">Choose a connected mailbox</option><% for(const box of mailboxes){ %><option value="<%= box.id %>"><%= box.display_name %></option><% } %></select></label>
<label class="rm-field"><span>Days suppliers have to reply</span><input name="ruleReplyDays" type="number" min="1" max="60" value="5" required></label>
<label class="rm-field"><span>Days until the goods are needed</span><input name="ruleDeliveryDays" type="number" min="1" max="365" value="21" required></label>
<label class="rm-field"><span>Remind suppliers who have not replied after (days)</span><input name="ruleChaseDays" type="number" min="1" max="60" value="3" required></label>
<label class="rm-field"><span>Most RFQs a week</span><input name="ruleMaxPerWeek" type="number" min="1" max="20" value="5" required></label>
<label><input type="checkbox" name="confirmed" value="yes" required> Ask these suppliers for quotes when a matching item needs buying.</label>
<button class="btn" <%= !mailboxes.length?'disabled':'' %>>Save quote rule</button></form></details></section><% } %>
<% if(requests.length){ %><section class="card section"><h2>Prepared RFQs</h2><% for(const r of requests){ %><p><% if(!locked){ %><a href="/autopilot/supplier-rfqs/<%= r.id %>"><%= r.reference %></a><% }else{ %><%= r.reference %><% } %> · <%= helpers.dateTime(r.created_at) %></p><% } %></section><% } %>
<% if(rules.length){ %><section class="card section"><h2>Saved RFQ rules</h2><% for(const r of rules){ %><article class="section"><h3><%= r.scope.profile.suppliers.map(s=>s.name).join(', ') %></h3><p><%= r.enabled?'Enabled within current plan and authority':'Stopped' %> · up to <%= r.max_requests_per_week %> requests per rolling seven days.</p><% if(r.enabled){ %><form method="post" action="/autopilot/supplier-rfq-rules/<%= r.id %>/stop"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="revision" value="<%= r.revision %>"><button class="btn">Stop this RFQ rule</button></form><% } %></article><% } %></section><% } %>
<nav aria-label="RFQ pages"><% if(page>1){ %><a href="/autopilot/supplier-rfqs?page=<%= page-1 %>">Newer RFQs</a><% } %> <% if(more){ %><a href="/autopilot/supplier-rfqs?page=<%= page+1 %>">Older RFQs</a><% } %></nav><p>AI credits used: 0. Ordinary email allowance applies to accepted messages.</p>
