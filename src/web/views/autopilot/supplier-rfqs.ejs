<div class="page-head"><div class="titles"><h1>Supplier quote requests</h1><p>Prepare one product request for several suppliers, with a separate email to each recipient.</p></div></div>
<% if(locked){ %><section class="notice"><div><span class="badge">Pro</span> Supplier RFQs require Pro or Custom. <a class="btn" href="/settings/billing">Upgrade</a></div></section><% }else{ %>
<p>Pro learns from a completed manual RFQ batch. Custom can use your exact supplier, product, quantity and weekly limits without training. A first request for a new supplier needs approval. Each request asks for a quotation; it never places an order or accepts terms.</p>
<% if(shadow){ %><p class="notice">The first 14 days are Watch only. RFQ preparation and sending wait until that period ends.</p><% } %>
<% if(problem){ %><p class="notice"><%= problem %></p><% } %>
<% if(!routineReady){ %><p>Routine RFQ sending is paused. The owner can review StockChief’s routine-work authority in <a href="/autopilot">StockChief AI</a>. Individual RFQ review keeps its own current controls.</p><% } %>
<% if(saved){ const p=saved.snapshot; %><section class="card section"><h2><%= p.reference %></h2><p>Reply requested by <%= p.replyBy %>. <%= p.suppliers.length %> separate supplier emails.</p><div class="table-scroll"><table><thead><tr><th>Product</th><th>Requested quantity</th></tr></thead><tbody><% for(const line of p.lines){ const item=p.products.find(v=>v.id===line.skuId); %><tr><td><%= item.code %> · <%= item.name %></td><td><%= line.quantity %> <%= item.unit_label %></td></tr><% } %></tbody></table></div>
<% for(const mail of words){ const delivered=deliveries.find(d=>d.supplier_id===mail.id); %><article class="section"><h3><%= mail.name %></h3><p>To <%= mail.email %> · <%= delivered?(delivered.status==='SENT'?'Accepted by the mailbox provider':delivered.effect_status==='AMBIGUOUS'?'Outcome uncertain — check the mailbox Sent folder':delivered.status==='FAILED'?'Needs review': 'Queued for sending'):'Draft for review' %></p><% if(delivered?.error_message||delivered?.effect_error){ %><p class="notice"><%= delivered.error_message||delivered.effect_error %></p><% } %><details><summary>Review this supplier’s exact email</summary><p><strong><%= mail.subject %></strong></p><pre style="white-space:pre-wrap;overflow-wrap:anywhere;font:inherit"><%= mail.body %></pre></details></article><% } %>
<% if(deliveries.length!==p.suppliers.length||deliveries.some(d=>d.status!=='SENT')){ %><form method="post" action="/autopilot/supplier-rfqs/<%= saved.id %>/send" class="form-stack section"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="sourceFingerprint" value="<%= saved.source_fingerprint %>"><label><input type="checkbox" name="confirmed" value="yes" required> I reviewed each exact supplier, recipient, product, quantity and email. Send this RFQ batch once.</label><button class="btn btn--primary" <%= shadow||problem?'disabled':'' %>>Approve and queue these exact RFQ emails</button></form><% } %>
<% if(eligibleRules.length&&(deliveries.length!==p.suppliers.length||deliveries.some(d=>d.status!=='SENT'))){ %><form method="post" action="/autopilot/supplier-rfqs/<%= saved.id %>/routine" class="form-stack section"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><label class="rm-field"><span>Use an existing RFQ rule</span><select name="ruleId" required><option value="">Choose exact supplier and product authority</option><% for(const r of eligibleRules){ %><option value="<%= r.id %>"><%= r.scope.profile.suppliers.map(s=>s.name).join(', ') %> · up to <%= r.max_requests_per_week %> requests per seven days</option><% } %></select></label><p>The saved supplier, product and quantity scope is checked again. Anything outside it stays unsent.</p><button class="btn" <%= !routineReady||problem?'disabled':'' %>>Queue within my existing RFQ authority</button></form><% } %>
<form method="post" action="/autopilot/supplier-rfqs/<%= saved.id %>/authority" class="form-stack section"><h3><%= matchingRule?'Review the current RFQ rule':'Authorize matching future requests' %></h3><% if(matchingRule){ %><input type="hidden" name="ruleId" value="<%= matchingRule.id %>"><input type="hidden" name="revision" value="<%= matchingRule.revision %>"><p>This updates the existing matching rule. Its current weekly limit is <%= matchingRule.max_requests_per_week %> requests.</p><% } %><input type="hidden" name="_csrf" value="<%= csrfToken %>"><% if(plan==='pro'){ %><p>Pro uses a completed manual batch for this exact supplier, product and mailbox scope. Automatic batches cannot teach themselves.</p><input type="hidden" name="exampleId" value="<%= trainingExampleId %>"><% }else{ %><p>Custom can authorize this exact scope without a taught example.</p><% } %><label class="rm-field"><span>Maximum requests per rolling seven days</span><input type="number" name="maxRequestsPerWeek" min="1" max="20" required></label><label><input type="checkbox" name="confirmed" value="yes" required> Authorize only these exact suppliers, current email addresses, products and purchase packs, up to each quantity shown above and this weekly limit.</label><button class="btn" <%= !routineReady||problem||(plan==='pro'&&!manualExampleReady)?'disabled':'' %>>Authorize this bounded RFQ scope</button></form>
</section><% } %>
<section class="card section"><h2>Prepare a new request</h2><p>Choose two to twenty known suppliers and your exact requested product quantities. Saved supplier codes and pack terms are included where known. Missing product or pack terms become explicit questions to the supplier; no quantities or terms are invented.</p><form method="post" action="/autopilot/supplier-rfqs/preview" class="form-stack"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="requestKey" value="<%= requestKey %>"><label class="rm-field"><span>RFQ reference</span><input name="reference" maxlength="160" required></label><label class="rm-field"><span>Exact supplier names, one per line</span><textarea name="supplierNames" rows="4" maxlength="5000" required></textarea></label><label class="rm-field"><span>SKU code and quantity, pasted as two spreadsheet columns</span><textarea name="productRows" rows="6" maxlength="30000" required></textarea></label><label class="rm-field"><span>Quotation reply date</span><input name="replyBy" type="date" required></label><label class="rm-field"><span>Sending mailbox</span><select name="connectorId" required><option value="">Choose a connected mailbox</option><% for(const box of mailboxes){ %><option value="<%= box.id %>"><%= box.display_name %> · <%= box.provider_account_name||box.provider_type %></option><% } %></select></label><% if(!mailboxes.length){ %><p>No sending mailbox is connected. <a href="/settings/connections">Connect Gmail or Microsoft 365</a>.</p><% } %><button class="btn" <%= shadow||!mailboxes.length?'disabled':'' %>>Prepare RFQ emails for review</button></form></section><% } %>
<% if(requests.length){ %><section class="card section"><h2>Prepared RFQs</h2><% for(const r of requests){ %><p><% if(!locked){ %><a href="/autopilot/supplier-rfqs/<%= r.id %>"><%= r.reference %></a><% }else{ %><%= r.reference %><% } %> · <%= helpers.dateTime(r.created_at) %></p><% } %></section><% } %>
<% if(rules.length){ %><section class="card section"><h2>Saved RFQ rules</h2><% for(const r of rules){ %><article class="section"><h3><%= r.scope.profile.suppliers.map(s=>s.name).join(', ') %></h3><p><%= r.enabled?'Enabled within current plan and authority':'Stopped' %> · up to <%= r.max_requests_per_week %> requests per rolling seven days.</p><% if(r.enabled){ %><form method="post" action="/autopilot/supplier-rfq-rules/<%= r.id %>/stop"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="revision" value="<%= r.revision %>"><button class="btn">Stop this RFQ rule</button></form><% } %></article><% } %></section><% } %>
<nav aria-label="RFQ pages"><% if(page>1){ %><a href="/autopilot/supplier-rfqs?page=<%= page-1 %>">Newer RFQs</a><% } %> <% if(more){ %><a href="/autopilot/supplier-rfqs?page=<%= page+1 %>">Older RFQs</a><% } %></nav><p>AI credits used: 0. Ordinary email allowance applies to accepted messages.</p>
