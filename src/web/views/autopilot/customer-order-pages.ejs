<style>.customer-pages{max-width:1000px;margin:auto}.customer-pages section{border:1px solid var(--border,#d9e0e8);border-radius:12px;padding:18px;margin:18px 0}.customer-pages form{display:grid;gap:12px;margin:16px 0}.customer-pages label{display:grid;gap:6px;min-width:0}.customer-pages label:has(input[type=checkbox]){display:block}.customer-pages input:not([type=checkbox]),.customer-pages textarea,.customer-pages select{width:100%;max-width:100%;box-sizing:border-box}.customer-pages p{overflow-wrap:anywhere}.customer-pages button{white-space:normal}</style><div class="customer-pages"><p><a data-customer-pages-back href="<%= screen.allowed?'/autopilot/reviews/customer-order-pages':'/autopilot' %>">← <%= screen.allowed?'Customer order request review':'StockChief AI' %></a></p><h1>Customer order pages</h1><p>Give a known customer a private product page. They choose quantities and review the exact total. StockChief can turn that original request into one unconfirmed order draft. For preorders, stock comes from the linked purchase order. Dispatch and payment have their own controls.</p>
<% if(!screen.allowed){ %><section data-agent-plan-locked><h2>Regular order pages (Pro or Custom required)</h2><p>Pro can learn from a confirmed individual order. Custom can draft within enabled page limits without training.</p><% if(!screen.preordersAllowed){ %><p>Preorders are available from Growth.</p><% } %><a class="btn" href="/billing">Upgrade</a></section><% } %>
<% if(issuedPath){ %><section role="status"><h2>New customer link ready</h2><p><a class="btn btn--primary" href="<%= issuedPath %>" target="_blank" rel="noopener noreferrer">Open the new customer page</a></p><p>Copy that link’s address and share it only with this customer. This is the only time this new link is shown. Republishing makes a new link and revokes the previous one.</p></section><% } %>
<% if(screen.shadow && (screen.allowed||screen.preordersAllowed)){ %><p class="notice">The first 14 days are for watching. Customers can submit requests; agent drafting waits for the watch period and the owner’s authority.</p><% } %>
<% if(screen.selected){ var r=screen.selected,q=r.snapshot.quote; %><section><h2>Original customer request: <%= r.reference %></h2><p><%= r.snapshot.preorder&&r.status==='DRAFTED'&&r.automatic?(r.order_status==='DRAFT'?'Preorder accepted, waiting for linked stock receipt':'Preorder '+r.order_status.toLowerCase().replaceAll('_',' ')):r.status.toLowerCase() %> · Received <%= helpers.dateTime(r.created_at) %></p><% if(r.snapshot.preorderArrival){ %><p>Expected stock date shown to the customer is <%= r.snapshot.preorderArrival %>.</p><% } %><% if(r.problem){ %><p class="notice"><%= r.problem %></p><% } %>
<% q.lines.forEach(function(l){var product=r.snapshot.products.find(function(p){return p.id===l.skuId}); %><p><strong><%= product.name %> · <%= product.code %></strong><br><%= l.quantity %> units · <%= helpers.money(l.unitPriceMinor,q.currency) %> each · <%= helpers.money(l.totalMinor,q.currency) %> including line tax and discounts</p><% }) %><p>Discounts: <%= helpers.money(q.discountMinor,q.currency) %> · Tax: <%= helpers.money(q.taxMinor,q.currency) %> · <strong>Total: <%= helpers.money(q.totalMinor,q.currency) %></strong></p><p><%= r.snapshot.input.deliveryMethod==='PICKUP'?'Pickup':'Delivery to the customer’s existing agreed address' %>. Product, pricing, tax or delivery changes require a fresh customer review.</p>
<% if(r.status==='RECEIVED'){ %><% if(r.snapshot.preorder?screen.preordersAllowed:screen.allowed){ %><form method="post" action="/autopilot/customer-order-pages/requests/<%= r.id %>/draft"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="expectedHash" value="<%= r.request_hash %>"><label><input type="checkbox" name="confirmed" value="yes" required> I approve this exact original customer request and its total for one unconfirmed draft.</label><button class="btn btn--primary">Create this order draft</button></form><% } %><form method="post" action="/autopilot/customer-order-pages/requests/<%= r.id %>/stop"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><label><input type="checkbox" name="confirmed" value="yes" required> Stop this unprocessed request without creating an order.</label><button class="btn">Stop customer request</button></form><% } %>
<% if(r.status==='DRAFTED'){ %><p><a class="btn" href="/orders/<%= r.sales_order_id %>">Open the recorded order</a></p><% if(screen.allowed && !r.automatic && !r.snapshot.preorder){ %><p>After confirming this individual order, teach only its exact products, quantities, current prices and delivery scope. A draft that has not been confirmed cannot teach Pro.</p><form method="post" action="/autopilot/customer-order-pages/requests/<%= r.id %>/teach"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><label><input type="checkbox" name="confirmed" value="yes" required> I authorize this exact confirmed individual request shape for matching routine drafts.</label><% if(r.trainingProblem){ %><p><%= r.trainingProblem %></p><% } %><button class="btn" <%= r.canTeach?'':'disabled' %>>Teach this completed request</button></form><% } %><% } %></section><% } %>
<% if(screen.allowed||screen.preordersAllowed){ %><section><h2><%= screen.allowed?'Publish an exact customer page':'Publish a preorder page' %></h2><p>Choose up to 100 distinct whole-unit SKU codes. Every product must already have a published selling price in <%= screen.currency %>. Kits and tracked/measured goods need separate review.</p><form method="post" action="/autopilot/customer-order-pages/publish"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="currency" value="<%= screen.currency %>"><label>Page title<input name="label" maxlength="120" required placeholder="Your regular order products"></label><label>Known customer<select name="customerId" aria-label="Known customer" required><% screen.customers.forEach(function(c){ %><option value="<%= c.id %>"><%= c.name %></option><% }) %></select></label><label>Fulfillment location<select name="locationId" aria-label="Fulfillment location" required><% screen.locations.forEach(function(l){ %><option value="<%= l.id %>"><%= l.name %></option><% }) %></select></label><label>Agreed fulfillment method<select name="deliveryMethod" aria-label="Agreed fulfillment method"><option value="PICKUP">Pickup</option><option value="SHIP">Ship to the customer’s existing address</option></select></label><label>Exact SKU codes, one per line<textarea name="skuCodes" required rows="5"></textarea></label><% if(screen.preordersAllowed){ %><label>Incoming purchase order number <%= screen.allowed?'(optional for preorders)':'' %><input name="preorderOrder" maxlength="80" <%= screen.allowed?'':'required' %>></label><p>For a preorder, choose a placed purchase order with one exact line for each offered SKU at this warehouse.</p><% } %><label>Confirmed sales tax treatment<select name="taxRateId" aria-label="Confirmed sales tax treatment"><option value="">I confirm these offers are non-taxable</option><% screen.taxRates.forEach(function(rate){ %><option value="<%= rate.id %>"><%= rate.name %></option><% }) %></select></label><input type="hidden" name="taxTreatment" value="NON_TAXABLE_CONFIRMED"><label>Maximum units per product<input name="maximumUnits" type="number" min="1" max="100000" required value="10"></label><label>Maximum request total in <%= screen.currency %><input name="maximumAmount" inputmode="decimal" required placeholder="1000.00"></label><label>Link validity in days<input name="expiryDays" type="number" min="1" max="30" required value="7"></label><label><input type="checkbox" name="confirmed" value="yes" required> I approve sharing these exact customer products and published prices through this private link, with the selected delivery scope, tax treatment and limits.</label><button class="btn btn--primary"><%= screen.allowed?'Publish customer order page':'Publish preorder page' %></button></form><% if(screen.moreCustomers||screen.moreLocations||screen.moreTaxRates){ %><p>This picker shows the first 200 active customers, 250 internal locations and 100 sales tax rates.</p><% } %></section><% } %>
<section><h2>Published customer pages</h2><% screen.profiles.forEach(function(p){ %><article><h3><%= p.label %> · <%= p.customer_name %></h3><p><%= p.location_name %> · <%= p.delivery_method==='PICKUP'?'Pickup':'Agreed customer delivery' %> · <%= p.sku_ids.length %> products · up to <%= p.maximum_units %> each and <%= helpers.money(Number(p.maximum_minor),p.currency) %> per request · Link expires <%= helpers.dateTime(p.expires_at) %> · <%= !p.enabled?'Stopped':p.routine_enabled?(p.preorder_enabled?'Routine preorders enabled':'Routine drafting enabled'):'Individual request review' %></p>
<% if(p.enabled&&(p.preorder_enabled?screen.automaticPreorders:screen.allowed)){ %><p><%= p.preorder_enabled?'StockChief can accept exact preorders from this customer and reserve stock after the recorded delivery arrives.':'Pro routine drafts still need the same confirmed individually taught request shape. All orders stay unconfirmed drafts.' %></p><form method="post" action="/autopilot/customer-order-pages/pages/<%= p.id %>/configure"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="revision" value="<%= p.revision %>"><label><input type="checkbox" name="confirmed" value="yes" required> <%= p.preorder_enabled?'I authorize routine preorder acceptance within these exact products, incoming stock and price limits.':'I authorize unconfirmed routine drafts within this exact customer page and limits.' %></label><button class="btn"><%= p.preorder_enabled?'Enable routine preorders':'Enable routine request drafts' %></button></form><% } %>
<% if(p.enabled){ %><form method="post" action="/autopilot/customer-order-pages/pages/<%= p.id %>/configure"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="revision" value="<%= p.revision %>"><input type="hidden" name="stop" value="yes"><button class="btn">Stop page and revoke its link</button></form><% } %><% if(p.preorder_enabled?screen.preordersAllowed:screen.allowed){ %><details><summary>Make a new link for this exact offer</summary><p>The old link is revoked, routine drafting pauses and previous learned request shapes stop. If customer, pricing, product or tax facts changed, publish a newly reviewed offer instead.</p><form method="post" action="/autopilot/customer-order-pages/pages/<%= p.id %>/renew"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="revision" value="<%= p.revision %>"><label>Renewed link validity in days<input name="expiryDays" type="number" min="1" max="30" value="7" required></label><label><input type="checkbox" name="confirmed" value="yes" required> I approve renewing this exact unchanged customer offer and revoking its old link.</label><button class="btn">Make renewed customer link</button></form></details><% } %></article><% }) %><% if(screen.profilePage>1){ %><a href="/autopilot/customer-order-pages?profilesPage=<%= screen.profilePage-1 %>">Previous customer pages</a><% } %><% if(screen.moreProfiles){ %><a href="/autopilot/customer-order-pages?profilesPage=<%= screen.profilePage+1 %>">Next customer pages</a><% } %></section>
<section><h2>Submitted customer requests</h2><% screen.requests.forEach(function(r){ %><p><a href="/autopilot/customer-order-pages?requestId=<%= r.id %>"><%= r.customer_name %> · <%= r.reference %> · <%= r.status.toLowerCase() %></a><% if(r.problem){ %> · <%= r.problem %><% } %></p><% }) %><% if(screen.requestPage>1){ %><a href="/autopilot/customer-order-pages?requestsPage=<%= screen.requestPage-1 %>">Previous customer requests</a><% } %><% if(screen.moreRequests){ %><a href="/autopilot/customer-order-pages?requestsPage=<%= screen.requestPage+1 %>">Next customer requests</a><% } %></section></div>
