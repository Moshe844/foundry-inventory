<style>.channel-copy{max-width:1080px}.channel-copy input:not([type=checkbox]),.channel-copy textarea,.channel-copy select{box-sizing:border-box;max-width:100%;width:100%}.channel-copy p,.channel-copy td{overflow-wrap:anywhere}.copy-table{max-width:100%;max-height:480px;overflow:auto}.copy-table table{width:100%;min-width:520px}.copy-table td{vertical-align:top;white-space:pre-wrap;max-width:520px}.channel-copy button{white-space:normal}.copy-settings{max-width:650px}</style>
<style>.channel-copy h1{font-size:28px;line-height:1.2;margin:16px 0}.channel-copy h2{font-size:20px;margin:0 0 12px}.channel-copy h3{font-size:17px;margin:20px 0 8px}.channel-copy p{line-height:1.55;margin:12px 0}.channel-copy section{background:#fff;border:1px solid #dce2ec;border-radius:18px;padding:20px;margin:20px 0}.channel-copy section form{margin:14px 0}.channel-copy .copy-settings form{display:grid;gap:14px}.channel-copy label{display:block}.channel-copy details{margin:14px 0}.channel-copy ul{padding-left:20px;line-height:1.7}.channel-copy .btn{margin:4px 0}.channel-copy .copy-table{margin-top:12px}.channel-copy .copy-table td{font-size:14px;padding:12px}.channel-copy .copy-table th{font-size:13px;padding:12px}@media(max-width:600px){.channel-copy section{padding:16px}.channel-copy h1{font-size:25px}}</style>
<div class="channel-copy">
<p><a data-channel-copy-back href="<%= screen.allowed?'/autopilot/reviews/channel-copy':'/autopilot' %>">← <%= screen.allowed?'Channel copy review':'StockChief AI' %></a></p>
<h1>Product copy for sales channels</h1>
<p>Prepare up to 1,000 product titles and descriptions for one sales channel at a time. StockChief uses recorded names and variant values, plus existing descriptions only when you select them. It adds no guessed materials, certifications, benefits, delivery promises or prices.</p>
<p>Uses recorded facts: 0 AI credits per batch.</p>
<p>The CSV is a private StockChief copy review, ready for your team to use. It does not update your catalog or publish listings. Check the channel’s current publishing rules separately; the title length below is your own chosen limit.</p>
<% if(!screen.allowed){ %>
<section data-agent-plan-locked><h2>Growth, Pro or Custom required</h2><p>Growth approves each batch. Pro and Custom can refresh an approved private scope without training, after the watch period within current authority. Saved copy is preserved; existing routines can still be stopped.</p><a class="btn" href="/billing">Upgrade</a></section>
<% } %>
<% if(screen.shadow){ %><p class="notice">StockChief is watching for the first 14 days. You can preview the work; agent writing starts after the watch period and your authority settings allow it.</p><% } %>
<% if(screen.selected){ %>
<section><h2><%= screen.selected.label %></h2><p><%= screen.selected.channel_name %> · <%= screen.selected.sku_ids.length %> <%= screen.selected.sku_ids.length===1?'product':'products' %> · <%= screen.selected.enabled?'Routine private refresh enabled within current authority':'Individual batches' %></p>
<% if(screen.selected.last_issue){ %><p role="status"><%= screen.selected.last_issue %></p><% } %>
<% if(screen.selected.enabled){ %><form method="post" action="/autopilot/channel-copy/<%= screen.selected.id %>/settings"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="revision" value="<%= screen.selected.revision %>"><input type="hidden" name="stop" value="yes"><button class="btn">Stop routine writing</button></form><% } %>
<% if(screen.allowed&&screen.routineIncluded){ %>
<% if(!screen.selected.enabled){ %><form method="post" action="/autopilot/channel-copy/<%= screen.selected.id %>/settings"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="revision" value="<%= screen.selected.revision %>"><label><input type="checkbox" name="confirmed" value="yes" required> I authorize daily private copy refresh for these exact products, selected source fields and channel settings. Nothing is published.</label><button class="btn">Enable routine private writing</button></form>
<% }else{ %><form method="post" action="/autopilot/channel-copy/<%= screen.selected.id %>/refresh"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="btn">Queue a routine copy refresh</button></form><% } %>
<% }else if(screen.allowed){ %><p>Routine writing without training requires <span class="badge">Pro or Custom</span>. Growth reviews and approves each fresh batch below. <a href="/billing">Upgrade</a></p><% } %>
<% if(screen.selectedVersion){ %>
<h3>Saved private copy</h3><p>Prepared <%= helpers.dateTime(screen.selectedVersion.created_at) %> · <%= screen.selectedVersion.automatic?'Routine writing':'Individually approved batch' %>. Saved versions remain historical when product facts change.</p>
<p><a class="btn btn--primary" data-copy-download href="/autopilot/channel-copy/versions/<%= screen.selectedVersion.id %>/copy.csv">Download prepared copy CSV</a></p>
<details><summary>Review all <%= screen.selectedVersion.document.length %> product rows</summary><%- include('channel-copy-rows',{copyRows:screen.selectedVersion.document}) %></details>
<% } %>
<% if(screen.history.length>1){ %><details><summary>Saved versions</summary><ul><% screen.history.forEach(function(v){ %><li><a href="/autopilot/channel-copy/<%= screen.selected.id %>?versionId=<%= v.id %>"><%= helpers.dateTime(v.created_at) %></a> · <%= v.automatic?'Routine':'Individual approval' %></li><% }) %></ul></details><% } %>
</section>
<% } %>
<% if(screen.allowed){ %>
<% const initial=draft?draft.scope:screen.selected||{label:'',channel_name:'',title_limit:160,description_style:'paragraph',include_description:false}; const source=draft?draft.source:screen.selectedVersion?.source_snapshot; const codes=source?source.products.map(function(p){return p.code}).join('\n'):''; %>
<section class="copy-settings"><h2><%= screen.selected?'Prepare a fresh individually approved batch':'Prepare a channel copy batch' %></h2>
<form method="post" action="/autopilot/channel-copy/preview">
<input type="hidden" name="_csrf" value="<%= csrfToken %>">
<% if(screen.selected){ %><input type="hidden" name="id" value="<%= screen.selected.id %>"><input type="hidden" name="revision" value="<%= screen.selected.revision %>"><% } %>
<label>Saved copy name<input name="label" required maxlength="100" value="<%= initial.label %>" placeholder="Summer products for our store"></label>
<label>Sales channel name<input name="channelName" required maxlength="60" value="<%= initial.channel_name %>" placeholder="Your store or marketplace"></label>
<label>Your maximum title length<input name="titleLimit" type="number" min="40" max="240" required value="<%= initial.title_limit %>"></label>
<label>Description format<select name="descriptionStyle" aria-label="Description format"><option value="paragraph" <%= initial.description_style==='paragraph'?'selected':'' %>>Paragraphs</option><option value="bullets" <%= initial.description_style==='bullets'?'selected':'' %>>Bullets</option></select></label>
<label>Product SKU codes, one per line<textarea name="skuCodes" rows="6" required><%= codes %></textarea></label>
<label><input type="checkbox" name="includeDescription" value="yes" <%= initial.include_description?'checked':'' %>> Include the existing descriptions I have checked for customer-facing use. Leave off to use names and variants only.</label>
<button class="btn btn--primary">Preview channel copy</button>
</form></section>
<% if(draft){ %>
<section><h2>Review prepared copy</h2><p><%= draft.document.filter(function(r){return !r.problem}).length %> ready rows · <%= draft.document.filter(function(r){return r.problem}).length %> need individual review. Rows needing review are excluded from the CSV. New source changes require a fresh preview.</p>
<details open><summary>Review all <%= draft.document.length %> rows</summary><%- include('channel-copy-rows',{copyRows:draft.document}) %></details>
<form method="post" action="/autopilot/channel-copy">
<input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="sourceHash" value="<%= draft.sourceHash %>">
<% if(draft.id){ %><input type="hidden" name="id" value="<%= draft.id %>"><input type="hidden" name="revision" value="<%= draft.revision %>"><% } %>
<input type="hidden" name="label" value="<%= draft.scope.label %>"><input type="hidden" name="channelName" value="<%= draft.scope.channel_name %>"><input type="hidden" name="titleLimit" value="<%= draft.scope.title_limit %>"><input type="hidden" name="descriptionStyle" value="<%= draft.scope.description_style %>"><input type="hidden" name="includeDescription" value="<%= draft.scope.include_description?'yes':'' %>"><input type="hidden" name="skuCodes" value="<%= draft.source.products.map(function(p){return p.code}).join('\n') %>">
<label><input type="checkbox" name="confirmed" value="yes" required> I reviewed this exact scope, approved these source fields for customer-facing copy, and approve saving only the ready rows as a private batch. Channel publishing stays separate.</label>
<button class="btn btn--primary" <%= draft.document.every(function(r){return r.problem})?'disabled':'' %>>Save reviewed copy batch</button>
</form></section>
<% } %>
<% } %>
<section><h2>Saved channel copy</h2><ul><% screen.rows.forEach(function(p){ %><li><a href="/autopilot/channel-copy/<%= p.id %>"><%= p.label %></a> · <%= p.channel_name %> · <%= p.product_count %> <%= p.product_count===1?'product':'products' %> · <%= p.version_count %> versions · <%= p.enabled?'Routine scope enabled':'Individual batches' %></li><% }) %></ul>
<% if(screen.page>1){ %><a href="/autopilot/channel-copy?page=<%= screen.page-1 %>">Previous batches</a><% } %><% if(screen.more){ %><a href="/autopilot/channel-copy?page=<%= screen.page+1 %>">Next batches</a><% } %></section>
</div>
