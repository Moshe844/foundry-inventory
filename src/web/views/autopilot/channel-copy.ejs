<style>.channel-copy{max-width:1080px}.channel-copy h1{font-size:28px;line-height:1.2}.channel-copy h2{font-size:20px}.channel-copy p{line-height:1.55;overflow-wrap:anywhere}.channel-copy section{background:#fff;border:1px solid #dce2ec;border-radius:18px;padding:20px;margin:20px 0}.channel-copy input:not([type=checkbox]),.channel-copy textarea,.channel-copy select{box-sizing:border-box;max-width:100%;width:100%}.copy-settings{max-width:650px}.copy-settings form{display:grid;gap:14px}.channel-copy label{display:block}.channel-copy details{margin:14px 0}.copy-table{max-width:100%;max-height:480px;overflow:auto}.copy-table table{width:100%;min-width:520px}.copy-table td{vertical-align:top;white-space:pre-wrap;overflow-wrap:anywhere;max-width:520px;padding:12px}.copy-table th{padding:12px}.channel-copy button{white-space:normal}@media(max-width:600px){.channel-copy section{padding:16px}.channel-copy h1{font-size:25px}}</style>
<div class="channel-copy">
<p><a data-channel-copy-back href="<%= screen.allowed?'/autopilot/reviews/channel-copy':'/autopilot' %>">← <%= screen.allowed?'Channel copy review':'StockChief AI' %></a></p>
<h1>Product copy for sales channels</h1>
<p>Write titles and descriptions for your store, marketplace, social shop or trade catalog in your chosen language and tone. Select exact SKUs or your complete active catalog. Large batches are processed in pages automatically. Recorded product facts and variant identity are preserved.</p>
<p>Copy stays private until your team chooses to publish it. This writing job does not change catalog records or publish listings.</p>
<% if(!screen.allowed){ %><section data-agent-plan-locked><h2>Growth, Pro or Custom required</h2><p>Growth approves every finished batch. Pro and Custom can refresh an explicitly authorized scope without training after Watch. Saved versions remain available.</p><a class="btn" href="/billing">Upgrade</a></section><% } %>
<% if(screen.shadow){ %><p class="notice">StockChief is watching for the first 14 days. Preview source and settings now; writing starts after Watch and your authority settings allow it.</p><% } %>
<% if(screen.selected){ %>
<section><h2><%= screen.selected.label %></h2><p><%= screen.selected.channel_name %> · <%= screen.selected.sku_ids.length %> <%= screen.selected.sku_ids.length===1?'product':'products' %> · <%= screen.selected.language %> · <%= screen.selected.tone %> · <%= screen.selected.enabled?'Routine private writing enabled':'Individual batches' %></p>
<% if(screen.selected.last_issue){ %><p role="status"><%= screen.selected.last_issue %></p><% } %>
<% if(screen.latestRun){ const run=screen.latestRun; %>
<h3>Latest writing batch</h3><p data-copy-status role="status"><%= run.status==='PENDING'?'Queued':run.status==='RUNNING'?'Writing':run.status==='READY'?'Ready for your review':run.status==='FAILED'?'Failed — credits released':'Approved private copy' %> · <%= run.document.length %> of <%= run.source_snapshot.products.length %> product rows written.</p>
<p data-copy-credits><%= run.credits %> AI credits <%= run.status==='FAILED'?'released':run.status==='PENDING'||run.status==='RUNNING'?'reserved':'used' %>.</p>
<% if(run.issue){ %><p><%= run.issue %></p><% } %>
<% if(['PENDING','RUNNING'].includes(run.status)){ %><p>Writing continues in the background. <a href="/autopilot/channel-copy/<%= screen.selected.id %>">Refresh progress</a>. A complete batch appears here when ready.</p><% } %>
<% if(run.status==='READY'){ %>
<p>Review every row. A source problem is shown explicitly. Approving saves this exact private batch; publication is your separate decision. Changed source facts require fresh writing.</p>
<details open><summary>Review all <%= run.document.length %> product rows</summary><%- include('channel-copy-rows',{copyRows:run.document}) %></details>
<% if(screen.allowed){ %><form method="post" action="/autopilot/channel-copy/runs/<%= run.id %>/approve"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><label><input type="checkbox" name="confirmed" value="yes" required> I reviewed this complete batch and approve saving its private copy.</label><button class="btn btn--primary">Approve reviewed copy batch</button></form><% } %>
<% } %><% } %>
<% if(screen.selected.enabled){ %><form method="post" action="/autopilot/channel-copy/<%= screen.selected.id %>/settings"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="revision" value="<%= screen.selected.revision %>"><input type="hidden" name="stop" value="yes"><button class="btn">Stop routine writing</button></form><% } %>
<% if(screen.allowed&&screen.routineIncluded){ %>
<% if(!screen.selected.enabled){ %><form method="post" action="/autopilot/channel-copy/<%= screen.selected.id %>/settings"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="revision" value="<%= screen.selected.revision %>"><label><input type="checkbox" name="confirmed" value="yes" required> I authorize daily private writing for these exact products, approved source fields and channel settings, using the displayed writing credit policy. Nothing is published.</label><button class="btn">Enable routine private writing</button></form>
<% }else{ %><form method="post" action="/autopilot/channel-copy/<%= screen.selected.id %>/refresh"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="btn">Queue a routine copy refresh</button></form><% } %>
<% }else if(screen.allowed){ %><p>Routine writing without training requires Pro or Custom. Growth approves each finished batch.</p><% } %>
<% if(screen.selectedVersion){ %><h3>Saved private copy</h3><p>Prepared <%= helpers.dateTime(screen.selectedVersion.created_at) %> · <%= screen.selectedVersion.automatic?'Routine writing':'Individually approved batch' %>. Historical versions preserve their original source.</p><p><a class="btn btn--primary" data-copy-download href="/autopilot/channel-copy/versions/<%= screen.selectedVersion.id %>/copy.csv">Download complete copy CSV</a></p><details><summary>Review all <%= screen.selectedVersion.document.length %> product rows</summary><%- include('channel-copy-rows',{copyRows:screen.selectedVersion.document}) %></details><% } %>
<% if(screen.history.length>1){ %><details><summary>Saved versions</summary><ul><% screen.history.forEach(function(v){ %><li><a href="/autopilot/channel-copy/<%= screen.selected.id %>?versionId=<%= v.id %>"><%= helpers.dateTime(v.created_at) %></a> · <%= v.automatic?'Routine':'Individual approval' %></li><% }) %></ul></details><% } %>
</section><% } %>
<% if(screen.allowed){ const initial=draft?draft.scope:screen.selected||{label:'',channel_name:'',title_limit:160,description_style:'paragraph',include_description:false,description_limit:2000,channel_style:'store',language:'English',tone:'clear',all_products:false};const source=draft?draft.source:screen.latestRun?.source_snapshot||screen.selectedVersion?.source_snapshot;const codes=source&&!initial.all_products?source.products.map(p=>p.code).join('\n'):''; %>
<section class="copy-settings"><h2><%= screen.selected?'Prepare a fresh individually approved batch':'Prepare a channel writing batch' %></h2><p>Writing starts at <%= screen.credits %> AI credits per complete action, at the current configured operation price. Additional cost-bounded credits may be needed for larger source material; each run shows its exact use. Failed whole batches release their reserved credits.</p>
<form method="post" action="/autopilot/channel-copy/preview"><input type="hidden" name="_csrf" value="<%= csrfToken %>">
<% if(screen.selected){ %><input type="hidden" name="id" value="<%= screen.selected.id %>"><input type="hidden" name="revision" value="<%= screen.selected.revision %>"><% } %>
<label>Saved copy name<input name="label" required maxlength="100" value="<%= initial.label %>" placeholder="Summer products for our store"></label>
<label>Sales channel name<input name="channelName" required maxlength="60" value="<%= initial.channel_name %>" placeholder="Our store or marketplace"></label>
<label>Channel writing style<select name="channelStyle"><% [['store','Online store'],['marketplace','Marketplace listing'],['social','Social shop'],['wholesale','Wholesale catalog']].forEach(function(o){ %><option value="<%= o[0] %>" <%= initial.channel_style===o[0]?'selected':'' %>><%= o[1] %></option><% }) %></select></label>
<label>Writing language<input name="language" maxlength="60" required value="<%= initial.language %>" placeholder="English, Français, Español…"></label>
<label>Tone<select name="tone"><% ['clear','warm','technical','premium','concise'].forEach(function(t){ %><option value="<%= t %>" <%= initial.tone===t?'selected':'' %>><%= t %></option><% }) %></select></label>
<label>Maximum title length<input name="titleLimit" type="number" min="1" max="1000" required value="<%= initial.title_limit %>"></label>
<label>Maximum description length<input name="descriptionLimit" type="number" min="1" max="10000" required value="<%= initial.description_limit %>"></label>
<label>Description format<select name="descriptionStyle" aria-label="Description format"><option value="paragraph" <%= initial.description_style==='paragraph'?'selected':'' %>>Paragraphs</option><option value="bullets" <%= initial.description_style==='bullets'?'selected':'' %>>Bullets</option></select></label>
<label><input type="checkbox" name="allProducts" value="yes" <%= initial.all_products?'checked':'' %>> Select all currently active products for this batch. The exact selected SKUs are fixed at preview; new products need your fresh approval.</label>
<label>Or product SKU codes, one per line<textarea name="skuCodes" rows="6"><%= codes %></textarea></label>
<label><input type="checkbox" name="includeDescription" value="yes" <%= initial.include_description?'checked':'' %>> Use the full existing descriptions I have checked for customer-facing use.</label><button class="btn btn--primary">Review source and writing settings</button></form></section>
<% if(draft){ %><section><h2>Review source and writing request</h2><p><%= draft.source.products.length %> <%= draft.source.products.length===1?'product':'products' %> · <%= draft.scope.language %> · <%= draft.scope.tone %> · <%= draft.scope.channel_style %>. Writing starts at <%= draft.credits %> credits<% if(draft.estimatedCredits){ %>; conservative estimated upper use: <%= draft.estimatedCredits %> credits under current verified provider prices<% } %>. This preview uses 0 credits. Review the finished writing separately before saving.</p><details><summary>Exact product source</summary><ul><% draft.source.products.forEach(function(p){ %><li><%= p.code %> — <%= p.name %><% if(p.variant_label){ %> — <%= p.variant_label %><% } %></li><% }) %></ul></details>
<form method="post" action="/autopilot/channel-copy"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="sourceHash" value="<%= draft.sourceHash %>"><input type="hidden" name="credits" value="<%= draft.credits %>">
<% if(draft.id){ %><input type="hidden" name="id" value="<%= draft.id %>"><input type="hidden" name="revision" value="<%= draft.revision %>"><% } %>
<% [['label','label'],['channelName','channel_name'],['titleLimit','title_limit'],['descriptionLimit','description_limit'],['descriptionStyle','description_style'],['language','language'],['tone','tone'],['channelStyle','channel_style']].forEach(function(pair){ %><input type="hidden" name="<%= pair[0] %>" value="<%= draft.scope[pair[1]] %>"><% }) %><input type="hidden" name="includeDescription" value="<%= draft.scope.include_description?'yes':'' %>"><input type="hidden" name="allProducts" value="<%= draft.scope.all_products?'yes':'' %>"><input type="hidden" name="skuCodes" value="<%= draft.scope.all_products?'':draft.source.products.map(p=>p.code).join('\n') %>">
<label><input type="checkbox" name="confirmed" value="yes" required> I approve these exact products, customer-facing source fields, channel settings and writing credit policy. Queue private writing.</label><button class="btn btn--primary">Queue channel writing</button></form></section><% } %><% } %>
<section><h2>Saved channel copy</h2><ul><% screen.rows.forEach(function(p){ %><li><a href="/autopilot/channel-copy/<%= p.id %>"><%= p.label %></a> · <%= p.channel_name %> · <%= p.product_count %> <%= p.product_count===1?'product':'products' %> · <%= p.version_count %> versions · <%= p.enabled?'Routine scope enabled':'Individual batches' %></li><% }) %></ul><% if(screen.page>1){ %><a href="/autopilot/channel-copy?page=<%= screen.page-1 %>">Previous batches</a><% } %><% if(screen.more){ %><a href="/autopilot/channel-copy?page=<%= screen.page+1 %>">Next batches</a><% } %></section></div>
