<div class="page-head"><div class="titles"><h1>Delivery quality checks</h1><p>Keep received goods out of available stock until someone physically inspects them.</p></div></div>
<% if(locked){ %><section class="notice"><div><span class="badge">Growth</span> Delivery QC requires Growth or above. Existing holds stay in place. <a class="btn" href="/settings/billing">Upgrade</a></div></section><% } %>
<p>Growth learns from an individually approved, completed manual example. Pro and Custom can apply your exact checklist and unit limit without training. Automatic work needs your routine authority after the first 14 days. A person always performs the physical checks. Failed goods stay held; this workflow never writes them off, moves them or pays anyone.</p>
<% if(selected){ const h=selected; %>
<section class="card section"><h2><%= h.name %> · <%= h.code %></h2><p><%= h.supplier_name %> · <%= h.po_number %> · <%= h.location_name %></p><p><strong><%= h.quantity %> units</strong> · <%= h.status==='PASSED'?'Inspection passed — released':h.status==='FAILED'?'Inspection failed — goods stay held':'Goods held — unavailable for sale or dispatch' %></p>
<% if(h.inspection){ %><p>Recorded inspection: <%= h.inspection.decision==='PASS'?'Passed':'Failed' %>. <%= h.inspection.note||'' %></p><% if(h.inspection.releaseReason&&h.status!=='PASSED'){ %><p class="notice"><%= h.inspection.releaseReason %></p><% } %><% } %>
<% if(h.status!=='PASSED'&&!locked){ %><form method="post" action="/autopilot/delivery-quality/<%= h.id %>/inspect" class="form-stack"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="revision" value="<%= h.revision %>">
<h3>Physically inspect this delivery</h3><% h.checklist.forEach((check,i)=>{ %><label><input type="checkbox" name="checks" value="<%= i %>"> <%= check %></label><% }); %>
<label class="rm-field"><span>Result</span><select name="decision" required><option value="">Choose the actual result</option><option value="PASS">All checks passed</option><option value="FAIL">Inspection failed — keep goods held</option></select></label>
<label class="rm-field"><span>Inspection notes (required if failed)</span><textarea name="note" maxlength="1000" rows="3"></textarea></label>
<label><input type="checkbox" name="physicallyChecked" value="yes" required> I physically inspected these exact units. This is not an AI estimate.</label><button class="btn btn--primary">Record physical inspection</button></form>
<% if(owner&&h.inspection?.decision==='PASS'){ %><form method="post" action="/autopilot/delivery-quality/<%= h.id %>/release" class="form-stack section"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="revision" value="<%= h.revision %>"><label><input type="checkbox" name="confirmed" value="yes" required> I reviewed this passed physical inspection and approve releasing these <%= h.quantity %> units once.</label><button class="btn">Release inspected goods once</button></form><% } %><% } %>
<a href="/autopilot/delivery-quality">Back to delivery quality checks</a></section>
<% } %>
<section class="card section"><h2>Received deliveries</h2><% if(!rows.length){ %><p>No matching deliveries have been held for QC yet. Configure a rule, then book in an actual supplier delivery.</p><% }else{ %><% for(const h of rows){ %><article class="section"><h3><a href="/autopilot/delivery-quality/<%= h.id %>"><%= h.name %> · <%= h.code %></a></h3><p><%= h.quantity %> units · <%= h.supplier_name %> · <%= h.location_name %> · <%= h.po_number %></p><p><%= h.status==='PASSED'?'Passed and released':h.status==='FAILED'?'Failed — held':'Waiting for inspection or owner release — held' %></p></article><% } %><% } %></section>
<% if(owner){ %><section class="card section"><h2>Inspection rules</h2><% for(const p of policies){ %><article class="section"><h3><%= p.supplier_name %> · <%= p.code %> · <%= p.location_name %></h3><p><%= p.enabled?(p.automatic_enabled?'Routine QC enabled within current plan and authority':'One owner confirmation per delivery'):'Stopped for future deliveries; existing holds stay in place' %> · limit <%= p.max_units %> units of this product per delivery.</p><ul><% for(const check of p.checklist){ %><li><%= check %></li><% } %></ul>
<% if(!locked){ %><a class="btn" href="/autopilot/delivery-quality?edit=<%= p.id %>">Revise checklist and return to manual review</a><% if(!p.automatic_enabled){ %><form method="post" action="/autopilot/delivery-quality-rules/<%= p.id %>/settings" class="form-stack section"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="revision" value="<%= p.revision %>">
<% if(plan==='growth'){ const examples=rows.filter(h=>h.policy_id===p.id&&h.policy_revision===p.revision&&h.status==='PASSED'&&!h.automatic); %><label class="rm-field"><span>Completed manual example</span><select name="exampleId" required><option value="">Choose a matching completed inspection</option><% for(const e of examples){ %><option value="<%= e.id %>"><%= e.po_number %> · <%= e.quantity %> units · <%= helpers.dateTime(e.created_at) %></option><% } %></select></label><% } %>
<label><input type="checkbox" name="confirmed" value="yes" required> Apply this exact checklist and unit limit to future matching deliveries. Release only after a person confirms all physical checks passed.</label><button class="btn" <%= shadow?'disabled':'' %>>Authorize routine delivery QC</button></form><% } %><% } %>
<% if(p.enabled){ %><form method="post" action="/autopilot/delivery-quality-rules/<%= p.id %>/settings" class="section"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="revision" value="<%= p.revision %>"><button class="btn" name="stop" value="yes">Stop rule for future deliveries</button></form><% } %></article><% } %></section>
<% if(!locked){ const e=editing; %><section class="card section"><h2><%= e?'Revise inspection checklist':'Set up a delivery inspection rule' %></h2><p>Start with individual owner confirmation. This applies only to whole-unit quantity stock from a known linked supplier at the exact receiving location. Existing held goods keep their original checklist.</p><form method="post" action="/autopilot/delivery-quality-rules" class="form-stack"><input type="hidden" name="_csrf" value="<%= csrfToken %>">
<% if(e){ %><input type="hidden" name="id" value="<%= e.id %>"><input type="hidden" name="revision" value="<%= e.revision %>"><% } %>
<label class="rm-field"><span>Exact supplier name</span><input name="supplierName" maxlength="240" value="<%= e?.supplier_name||'' %>" <%= e?'readonly':'' %> required></label><label class="rm-field"><span>StockChief SKU code</span><input name="skuCode" maxlength="240" value="<%= e?.code||'' %>" <%= e?'readonly':'' %> required></label><label class="rm-field"><span>Exact receiving location name</span><input name="locationName" maxlength="240" value="<%= e?.location_name||'' %>" <%= e?'readonly':'' %> required></label>
<label class="rm-field"><span>Physical checks, one per line (up to ten)</span><textarea name="checklist" rows="5" maxlength="2010" required><%= e?e.checklist.join('\n'):'' %></textarea></label><label class="rm-field"><span>Maximum units of this product per delivery for routine QC</span><input type="number" name="maxUnits" min="1" max="100000" step="1" value="<%= e?.max_units||'' %>" required></label>
<label><input type="checkbox" name="confirmed" value="yes" required> I reviewed this exact supplier, product, location, checklist and unit limit. Each matching delivery must stay held until inspection passes.</label><button class="btn">Save QC rule for manual review</button></form></section><% } %><% } %>
<nav aria-label="Delivery inspection pages"><% if(page>1){ %><a href="/autopilot/delivery-quality?page=<%= page-1 %>">Previous inspections</a><% } %> <% if(more){ %><a href="/autopilot/delivery-quality?page=<%= page+1 %>">More inspections and rules</a><% } %></nav><p>AI credits used: 0.</p>
