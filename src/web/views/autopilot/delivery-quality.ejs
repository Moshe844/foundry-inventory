<div class="page-head"><div class="titles"><h1>Delivery quality checks</h1><p>Keep new deliveries out of available stock until someone physically inspects them.</p></div></div>
<% if(locked){ %><section class="notice"><div><span class="badge">Growth</span> Delivery QC requires Growth or above. Goods already on hold stay held and can still be inspected. <a class="btn" href="/settings/billing">Upgrade</a></div></section><% } %>
<% if(plan==='growth'){ %><p>StockChief suggests a hold for each matching delivery until you teach it: save a rule that holds on its own, or teach it from a delivery a person held, inspected and released.</p><% }else if(!locked){ %><p>StockChief holds matching deliveries on its own under your rules once routine work is on and the first 14 days have passed. Otherwise it suggests each hold.</p><% } %>
<p>Held goods cannot be sold, reserved, picked or offered on sales channels. A person always does the physical checks, and a pass releases the goods<%= ruleRelease?' (your rule releases them when StockChief may act)':'' %>. Failed goods stay held until they go back to the supplier or you write them off.</p>
<% const unitsOf=label=>label&&!['unit','units','each'].includes(label)?label:'units'; %>
<% if(selected){ const h=selected,unit=unitsOf(h.unit_label); %>
<section class="card section"><h2><%= h.name %> · <%= h.code %></h2><p><%= h.supplier_name %> · <%= h.po_number %> · <%= h.location_name %><% if(h.lot_code){ %> · Batch <%= h.lot_code %><% } %></p>
<p><strong><%= h.quantity %> <%= unit %></strong> · <%= h.statusText %></p>
<% if(Number(h.returned_quantity)>0){ %><p><%= h.returned_quantity %> <%= unit %> returned to the supplier.</p><% } %>
<% if(Number(h.written_off_quantity)>0){ %><p><%= h.written_off_quantity %> <%= unit %> written off.</p><% } %>
<% if(serials.length){ %><p>Held serial numbers: <%= serials.map(s=>s.serial).join(', ') %></p><% } %>
<% if(h.status==='PROPOSED'){ %><p class="notice"><%= h.proposal_reason %></p>
<% if(owner&&!locked){ %><div class="rm-actions"><form method="post" action="/autopilot/delivery-quality/<%= h.id %>/decide"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="revision" value="<%= h.revision %>"><input type="hidden" name="decision" value="hold"><button class="btn btn--primary">Hold for inspection</button></form>
<form method="post" action="/autopilot/delivery-quality/<%= h.id %>/decide"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="revision" value="<%= h.revision %>"><input type="hidden" name="decision" value="skip"><button class="btn">Don’t hold</button></form></div><% }else{ %><p>The owner decides whether to hold these goods.</p><% } %><% } %>
<% if(h.inspection){ %><p>Recorded inspection: <%= h.inspection.decision==='PASS'?'Passed':'Failed' %>. <%= h.inspection.note||'' %><% if(h.inspection.damagedQuantity!=null){ %> Damaged: <%= h.inspection.damagedQuantity %> <%= unit %>.<% } %></p><% if(h.status==='PASSED'){ %><p><%= h.released_by_rule?'Released by your QC rule after the pass.':'Released by the person who recorded the pass.' %></p><% } %><% } %>
<% if(['HELD','FAILED'].includes(h.status)&&Number(h.remaining)>0&&!returnOpen){ %><form method="post" action="/autopilot/delivery-quality/<%= h.id %>/inspect"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="revision" value="<%= h.revision %>">
<h3>Physically inspect the <%= h.remaining %> held <%= unit %></h3><% h.checklist.forEach((check,i)=>{ %><label><input type="checkbox" name="checks" value="<%= i %>"> <%= check %></label><% }); %>
<label class="rm-field"><span>Result</span><select name="decision" required><option value="">Choose the actual result</option><option value="PASS">All checks passed — release the goods</option><option value="FAIL">Inspection failed — keep the goods held</option></select></label>
<label class="rm-field"><span>Inspection notes (required if failed)</span><textarea name="note" maxlength="1000" rows="3"></textarea></label>
<label class="rm-field"><span>Actual damaged <%= unit %>, if known (failed inspections only)</span><input name="damagedQuantity" inputmode="decimal"></label><p>Leave this blank if the damaged count is unknown. A supplier return or claim needs an actual count.</p>
<label><input type="checkbox" name="physicallyChecked" value="yes" required> I physically inspected these exact goods. This is not an AI estimate.</label><button class="btn btn--primary">Record physical inspection</button></form><% } %>
<% if(h.status==='HELD'&&h.inspection?.decision==='PASS'){ %><form method="post" action="/autopilot/delivery-quality/<%= h.id %>/release" class="section"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="revision" value="<%= h.revision %>"><label><input type="checkbox" name="confirmed" value="yes" required> I reviewed this passed physical inspection and release these <%= h.remaining %> <%= unit %> once.</label><button class="btn">Release inspected goods once</button></form><% } %>
<% if(h.status==='FAILED'&&Number(h.remaining)>0){ %><section class="section"><h3>Failed goods</h3>
<% if(returnOpen){ %><p>These goods are on a supplier return. Finish or cancel it from the return.</p><% } %>
<% if(canReturn&&!returnOpen&&Number(h.inspection?.damagedQuantity||0)>0){ %><p><a href="/autopilot/supplier-returns?holdId=<%= h.id %>">Return the damaged goods to the supplier</a></p><% }else if(!canReturn&&owner){ %><p><span class="badge">Pro</span> Supplier returns need Pro or Custom.</p><% } %>
<% if(owner&&!returnOpen){ %><form method="post" action="/autopilot/delivery-quality/<%= h.id %>/write-off"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="requestKey" value="<%= writeoffKey %>">
<h4>Write off failed goods</h4><p>This removes the goods and their value from stock. Only you can approve it.</p>
<% if(h.tracking_mode==='serial'){ %><p>Choose the serial numbers to write off:</p><% for(const s of serials){ %><label><input type="checkbox" name="serialUnitIds" value="<%= s.id %>"> <%= s.serial %></label><% } %><% } %>
<label class="rm-field"><span><%= unit[0].toUpperCase()+unit.slice(1) %> to write off (up to <%= h.remaining %>)</span><input name="quantity" inputmode="decimal" required></label>
<% if(h.secondary_unit_label){ %><label class="rm-field"><span>Actual <%= h.secondary_unit_label %> written off</span><input name="secondaryQuantity" inputmode="decimal" required></label><% } %>
<label class="rm-field"><span>Reason</span><textarea name="note" maxlength="1000" rows="2" required></textarea></label>
<label><input type="checkbox" name="confirmed" value="yes" required> I approve writing off these exact failed goods.</label><button class="btn">Write off failed goods</button></form><% } %>
</section><% } %>
<% if(writeoffs.length){ %><h3>Write-offs</h3><ul><% for(const w of writeoffs){ %><li><%= w.quantity %> <%= unit %> · <%= w.note %> · approved by <%= w.approver %> · <%= helpers.dateTime(w.created_at) %></li><% } %></ul><% } %>
<% if(['HELD','FAILED','PASSED'].includes(h.status)){ %><section class="section"><h3>Delivery photo evidence</h3><p>Save the original JPEG or PNG file. StockChief prepares a smaller email copy without inventing or interpreting damage. Up to ten originals per inspection, 10 MB each.</p>
<% for(const photo of photos){ %><p><a href="/autopilot/quality-photos/<%= photo.id %>"><%= photo.filename %> — original</a> · <a href="/autopilot/quality-photos/<%= photo.id %>?copy=email">Email copy</a> <%= photo.caption %></p><% } %>
<% if(canAddPhotos){ %><form method="post" enctype="multipart/form-data" action="/autopilot/delivery-quality/<%= h.id %>/photos"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><label class="rm-field"><span>Original physical inspection photo</span><input type="file" name="photo" accept="image/jpeg,image/png" required></label><label class="rm-field"><span>Photo note</span><input name="caption" maxlength="500"></label><button class="btn">Preserve photo and prepare email copy</button></form><% }else{ %><p><span class="badge">Growth</span> Adding delivery photo evidence requires Growth or above. <a href="/settings/billing">Upgrade</a></p><% } %></section><% } %>
<% if(h.status==='FAILED'&&owner){ %><section class="section"><h3>Supplier damage claim</h3><% if(existingClaim){ %><p><a href="/autopilot/supplier-claims/<%= existingClaim.id %>">Review <%= existingClaim.reference %></a></p><% } %><% if(!canClaim){ %><p><span class="badge">Pro</span> Supplier claims require Pro or Custom. <a class="btn" href="/settings/billing">Upgrade</a></p><% }else if(!h.inspection?.damagedQuantity){ %><p>Record the actual damaged count in the failed inspection above before preparing a claim.</p><% }else if(!existingClaim){ %><form method="post" action="/autopilot/supplier-claims/preview"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="holdId" value="<%= h.id %>"><label class="rm-field"><span>Connected sending mailbox</span><select name="connectorId" required><option value="">Choose the actual mailbox</option><% for(const box of claimMailboxes){ %><option value="<%= box.id %>"><%= box.display_name %></option><% } %></select></label><p>Choose up to three exact photo copies to attach:</p><% for(const photo of photos){ %><label><input type="checkbox" name="photoIds" value="<%= photo.id %>"> <%= photo.filename %> <%= photo.caption %></label><% } %><button class="btn">Prepare damage claim for review</button></form><% } %></section><% } %>
<a href="/autopilot/delivery-quality">Back to delivery quality checks</a></section>
<% } %>
<section class="card section"><h2>Received deliveries</h2><% if(!rows.length){ %><p>No deliveries have matched a QC rule yet. Set up a rule, then book in a supplier delivery.</p><% }else{ %><% for(const h of rows){ %><article class="section"><h3><a href="/autopilot/delivery-quality/<%= h.id %>"><%= h.name %> · <%= h.code %></a></h3><p><%= h.quantity %> <%= unitsOf(h.unit_label) %> · <%= h.supplier_name %> · <%= h.location_name %> · <%= h.po_number %></p><p><%= h.statusText %></p></article><% } %><% } %></section>
<% if(owner){ %><section class="card section"><h2>QC rules</h2><% if(!policies.length){ %><p>No rules yet.</p><% } %><% for(const p of policies){ %><article class="section"><h3><%= p.scope %></h3><p><%= p.enabled?(p.automatic_enabled?'Holds matching deliveries on its own when StockChief may act':'Suggests a hold for each matching delivery'):'Stopped for future deliveries; goods already held stay held' %> · up to <%= p.max_units %> units of each product per delivery.</p><ul><% for(const check of p.checklist){ %><li><%= check %></li><% } %></ul>
<% if(!locked){ %><p><a class="btn" href="/autopilot/delivery-quality?edit=<%= p.id %>">Revise checklist or limit</a></p>
<% if(p.enabled&&!p.automatic_enabled){ const examples=rows.filter(h=>h.policy_id===p.id&&h.status==='PASSED'&&!h.automatic&&JSON.stringify(h.checklist)===JSON.stringify(p.checklist)); %><form method="post" action="/autopilot/delivery-quality-rules/<%= p.id %>/settings" class="section"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="revision" value="<%= p.revision %>"><input type="hidden" name="mode" value="automatic">
<% if(plan==='growth'){ %><label class="rm-field"><span>Teach from a completed delivery (optional)</span><select name="exampleId"><option value="">Teach from this saved rule</option><% for(const e of examples){ %><option value="<%= e.id %>"><%= e.po_number %> · <%= e.quantity %> units · <%= helpers.dateTime(e.created_at) %></option><% } %></select></label><% } %>
<label><input type="checkbox" name="confirmed" value="yes" required> Hold future matching deliveries on their own within this checklist and unit limit. A person still inspects every delivery.</label><button class="btn"><%= plan==='growth'?'Teach it to hold on its own':'Hold on its own' %></button></form><% } %>
<% if(p.enabled&&p.automatic_enabled){ %><form method="post" action="/autopilot/delivery-quality-rules/<%= p.id %>/settings" class="section"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="revision" value="<%= p.revision %>"><input type="hidden" name="mode" value="ask"><button class="btn">Suggest each hold instead</button></form><% } %><% } %>
<% if(p.enabled){ %><form method="post" action="/autopilot/delivery-quality-rules/<%= p.id %>/settings" class="section"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="revision" value="<%= p.revision %>"><button class="btn" name="stop" value="yes">Stop rule for future deliveries</button></form><% } %></article><% } %></section>
<% if(!locked){ const e=editing; %><section class="card section"><h2><%= e?'Revise QC rule':'Set up a QC rule' %></h2><p>Name a supplier, a product or both. Leave the location empty to cover every owned receiving location. Goods already held keep their original checklist.</p><form method="post" action="/autopilot/delivery-quality-rules"><input type="hidden" name="_csrf" value="<%= csrfToken %>">
<% if(e){ %><input type="hidden" name="id" value="<%= e.id %>"><input type="hidden" name="revision" value="<%= e.revision %>"><% } %>
<label class="rm-field"><span>Supplier name (leave empty for any supplier)</span><input name="supplierName" maxlength="240" value="<%= e?.supplier_name||'' %>" <%= e?'readonly':'' %>></label><label class="rm-field"><span>SKU code (leave empty for any product)</span><input name="skuCode" maxlength="240" value="<%= e?.code||'' %>" <%= e?'readonly':'' %>></label><label class="rm-field"><span>Receiving location (leave empty for all)</span><input name="locationName" maxlength="240" value="<%= e?.location_name||'' %>" <%= e?'readonly':'' %>></label>
<label class="rm-field"><span>Physical checks, one per line (up to ten)</span><textarea name="checklist" rows="5" maxlength="2010" required><%= e?e.checklist.join('\n'):'' %></textarea></label><label class="rm-field"><span>Most units of one product per delivery it may hold on its own</span><input type="number" name="maxUnits" min="1" max="100000" step="1" value="<%= e?.max_units||'' %>" required></label>
<fieldset class="rm-field"><legend>When a matching delivery arrives</legend><label><input type="radio" name="mode" value="ask" <%= !e?.automatic_enabled?'checked':'' %>> Suggest a hold and let me decide</label><label><input type="radio" name="mode" value="automatic" <%= e?.automatic_enabled?'checked':'' %>> Hold it on its own<%= plan==='growth'?' (this saved rule teaches StockChief)':'' %></label></fieldset>
<label><input type="checkbox" name="confirmed" value="yes" required> I reviewed this scope, checklist and unit limit. Matching deliveries stay unavailable until a person passes the inspection.</label><button class="btn">Save QC rule</button></form></section><% } %><% } %>
<nav aria-label="Delivery inspection pages"><% if(page>1){ %><a href="/autopilot/delivery-quality?page=<%= page-1 %>">Previous inspections</a><% } %> <% if(more){ %><a href="/autopilot/delivery-quality?page=<%= page+1 %>">More inspections and rules</a><% } %></nav><p>AI credits used: 0.</p>
