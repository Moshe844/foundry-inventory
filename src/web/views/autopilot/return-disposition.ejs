<style>.return-disposition{max-width:1000px;margin:auto}.return-disposition .card{margin:20px 0;padding:18px;border:1px solid var(--border,#d8dfe5);border-radius:12px}.return-disposition form{display:grid;gap:12px;margin:18px 0}.return-disposition label{display:grid;gap:7px;min-width:0}.return-disposition label:has(input[type=checkbox]){display:block}.return-disposition input:not([type=checkbox]),.return-disposition select{width:100%;max-width:100%;box-sizing:border-box}.return-disposition fieldset{min-width:0;display:grid;gap:12px}.return-disposition p,.return-disposition legend{overflow-wrap:anywhere}.return-disposition button{white-space:normal}</style><div class="return-disposition">
<a data-return-disposition-back href="<%= screen.allowed?'/autopilot/reviews/return-disposition':'/autopilot' %>">← <%= screen.allowed?'Return disposition review':'StockChief AI' %></a>
<h1>Restock, repair or scrap</h1>
<p>Record what you physically inspected. StockChief can apply exact product and condition rules to prepare decisions. You approve the physical stock changes separately. Refunds and customer credits keep their own approvals.</p>
<% if (!screen.allowed) { %><section class="card" data-agent-plan-locked><h2>Pro or Custom required</h2><p>Pro learns routine planning from a completed individual example. Custom can plan within exact rules without training. Your saved history remains available.</p><a class="btn" href="/billing">Upgrade</a></section><% } %>
<% if (screen.shadow && screen.allowed) { %><p class="notice">The first 14 days are for watching. You can record human inspection facts; agent planning and applying decisions wait until the watch period ends. The regular return inspection remains available.</p><% } %>
<% if(screen.problem){ %><p class="notice"><%= screen.problem %></p><% } %>
<% if(screen.selected){ var a=screen.selected; %>
<section class="card" id="assessment"><h2>Physical assessment for <%= a.source_snapshot.return_number %></h2>
<p><a href="/warehouse/returns/customer/<%= a.return_id %>">Open the original return</a> · <%= a.status.toLowerCase() %> · Inspected facts recorded <%= helpers.dateTime(a.created_at) %></p>
<% if(a.problem){ %><p class="notice"><%= a.problem %></p><% } %>
<% a.observations.forEach(function(o){ %><p><strong><%= o.product %> · <%= o.sku %></strong><br><%= o.quantity %> units · <%= o.conditionCode %> · <%= o.note %></p><% }) %>
<% if(a.proposal){ %><h3>Exact proposed decisions</h3><p><%= a.proposal.byRules?'Prepared from saved rules.':'Individually chosen decisions.' %> <%= a.proposal.automatic?'Routine preparation did not move stock.':'' %></p>
<% a.proposal.lines.forEach(function(d){ var destination=screen.places.find(function(l){return l.id===d.destinationId}); %><p><strong><%= d.sku %>: <%= d.quantity %> to <%= d.outcome.toLowerCase() %></strong><% if(d.destinationId){ %> at <%= destination?destination.name:'the recorded internal location' %><% } %><% if(d.outcome==='SCRAP'){ %> · Write-off: <%= helpers.money(d.writeoffMinor,a.source_snapshot.currency) %><% } %></p><% }) %>
<% } %>
<% if(['OBSERVED','READY'].includes(a.status) && screen.allowed){ %>
<form method="post" action="/autopilot/return-disposition/<%= a.id %>/prepare" class="form-grid" data-busy><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="revision" value="<%= a.revision %>">
<h3>Prepare current decisions</h3><label><input type="checkbox" name="byRules" value="yes"> Use the current saved rules for every product and condition</label>
<p>For an individual example, leave that box unchecked and choose every outcome and destination below. One condition must describe all units on each product line. Use the original return inspection for mixed conditions within a line.</p>
<% a.observations.forEach(function(o,i){ var currentDecision=a.proposal && a.proposal.lines.find(function(d){return d.lineId===o.lineId}); %><fieldset><legend><%= o.sku %> · <%= o.quantity %> units · <%= o.conditionCode %></legend><input type="hidden" name="lines[<%= i %>][lineId]" value="<%= o.lineId %>"><label>Disposition for <%= o.sku %><select name="lines[<%= i %>][outcome]" aria-label="Disposition for <%= o.sku %>"><option value="RESTOCK" <%= currentDecision && currentDecision.outcome==='RESTOCK'?'selected':'' %>>Restock</option><option value="REPAIR" <%= currentDecision && currentDecision.outcome==='REPAIR'?'selected':'' %>>Repair</option><option value="SCRAP" <%= currentDecision && currentDecision.outcome==='SCRAP'?'selected':'' %>>Scrap</option></select></label><label>Destination for <%= o.sku %><select name="lines[<%= i %>][destinationId]" aria-label="Destination for <%= o.sku %>"><% screen.places.forEach(function(l){ %><option value="<%= l.id %>" <%= currentDecision && currentDecision.destinationId===l.id?'selected':'' %>><%= l.name %></option><% }) %></select></label></fieldset><% }) %>
<label><input type="checkbox" name="confirmed" value="yes" required> I checked these physical conditions and approve preparing these exact decisions.</label><button class="btn" type="submit">Prepare disposition review</button></form>
<% if(a.status==='READY'){ var hasScrap=a.proposal.lines.some(function(d){return d.outcome==='SCRAP'}); %>
<form method="post" action="/autopilot/return-disposition/<%= a.id %>/apply" data-busy><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="revision" value="<%= a.revision %>"><input type="hidden" name="proposalHash" value="<%= a.proposalHash %>">
<label><input type="checkbox" name="confirmed" value="yes" required> I physically checked these goods and approve these exact quantities, dispositions and actual destinations.</label>
<% if(hasScrap){ %><label><input type="checkbox" name="writeoffConfirmed" value="yes" required> I separately approve the returned-stock write-offs shown above.</label><% } %>
<p>This releases or moves actual returned stock, or scraps it at its recorded cost. It does not refund the customer.</p><button class="btn btn--primary" type="submit">Apply approved physical disposition</button></form>
<% } %><% } %>
<% if(['OBSERVED','READY'].includes(a.status)){ %><form method="post" action="/autopilot/return-disposition/<%= a.id %>/stop"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="revision" value="<%= a.revision %>"><label><input type="checkbox" name="confirmed" value="yes" required> Stop this unreviewed assessment. Goods stay in quarantine.</label><button class="btn" type="submit">Stop assessment</button></form><% } %>
<% if(a.status==='APPLIED'){ %><p>Physical disposition completed once. Refunds and credits remain separate. <% if(!a.proposal.byRules && !a.proposal.automatic){ %>This completed individual example can teach a matching Pro rule. Choose this return in the rule's completed-example list below.<% } %></p><% } %>
</section><% } %>
<% if(screen.allowed){ %>
<section class="card"><h2>Record a physical inspection</h2>
<form method="get" action="/autopilot/return-disposition"><label>Fully received return<select name="returnId" aria-label="Fully received return" required><% screen.returns.forEach(function(r){ %><option value="<%= r.id %>" <%= screen.physical && r.id===screen.physical.id?'selected':'' %>><%= r.return_number %> · <%= r.name %> · <%= r.order_number %></option><% }) %></select></label><button class="btn" type="submit">Open physical inspection</button></form>
<% if(screen.moreReturns){ %><p>First 100 fully received returns shown. Complete or stop older work before adding more here.</p><% } %>
<% if(screen.physical){ var f=screen.physical; %><h3><%= f.return_number %> · <%= f.quarantine_name %></h3><form method="post" action="/autopilot/return-disposition/observe" data-busy><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="returnId" value="<%= f.id %>"><input type="hidden" name="sourceHash" value="<%= f.sourceHash %>">
<% f.lines.forEach(function(l,i){ %><fieldset><legend><%= l.name %> · <%= l.code %> · <%= l.quantity_received %> units</legend><input type="hidden" name="lines[<%= i %>][lineId]" value="<%= l.id %>"><label>Physical condition code for <%= l.code %><input name="lines[<%= i %>][conditionCode]" maxlength="40" required placeholder="UNOPENED_GOOD"></label><label>What you physically checked for <%= l.code %><input name="lines[<%= i %>][note]" maxlength="500" required placeholder="Seal intact; all units checked"></label></fieldset><% }) %>
<label><input type="checkbox" name="confirmed" value="yes" required> I inspected every listed received unit and each condition applies to its entire product line.</label><button class="btn btn--primary" type="submit">Record inspected conditions</button></form><% } %></section>
<section class="card"><h2>Exact product and condition rules</h2><p>A saved rule uses one account-wide rule slot. Rules start with individual review. Pro requires a matching completed manual example to enable routine preparation; Custom needs no training. Every physical disposition and write-off still needs separate human approval.</p>
<form method="post" action="/autopilot/return-disposition/rules" class="form-grid"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><label>Exact SKU code<input name="skuCode" required></label><label>Condition code<input name="conditionCode" required maxlength="40" placeholder="UNOPENED_GOOD"></label><label>Physical condition label<input name="conditionLabel" required maxlength="200" placeholder="Unopened and checked good"></label><label>Rule outcome<select name="outcome" aria-label="Rule outcome"><option value="RESTOCK">Restock</option><option value="REPAIR">Repair</option><option value="SCRAP">Scrap</option></select></label><label>Rule destination<select name="destinationId" aria-label="Rule destination"><% screen.places.forEach(function(l){ %><option value="<%= l.id %>"><%= l.name %></option><% }) %></select><small>Ignored for scrap.</small></label><label>Maximum units per matching product line<input name="maximumUnits" type="number" min="1" max="100000" required value="1"></label><label><input type="checkbox" name="confirmed" value="yes" required> I approve this exact product, physical condition, outcome, destination and limit.</label><button class="btn" type="submit">Save disposition rule</button></form></section><% } %>
<% screen.rules.forEach(function(p){ %><section class="card"><h3><%= p.code %> · <%= p.condition_label %></h3><p><%= p.condition_code %> → <%= p.outcome.toLowerCase() %><%= p.destination_name?' at '+p.destination_name:'' %> · up to <%= p.maximum_units %> units · <%= !p.enabled?'Stopped':p.routine_enabled?'Routine preparation enabled':'Individual review' %></p>
<% if(screen.allowed){ %><form method="post" action="/autopilot/return-disposition/rules/<%= p.id %>/configure"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="revision" value="<%= p.revision %>"><label>Completed individual example for <%= p.code %><select name="exampleId" aria-label="Completed individual example for <%= p.code %>"><option value="">Custom: no training required</option><% screen.assessments.filter(function(a){return a.status==='APPLIED'}).forEach(function(a){ %><option value="<%= a.id %>" <%= p.trained_assessment_id===a.id?'selected':'' %>><%= a.return_number %> · <%= helpers.dateTime(a.created_at) %></option><% }) %></select><small>Pro requires a matching individually chosen physical inspection.</small></label><label><input type="checkbox" name="confirmed" value="yes" required> I authorize routine decision preparation within this exact rule. Stock changes and write-offs still need approval.</label><button class="btn" type="submit">Enable routine preparation</button></form>
<details><summary>Revise this rule</summary><form method="post" action="/autopilot/return-disposition/rules"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="id" value="<%= p.id %>"><input type="hidden" name="revision" value="<%= p.revision %>"><input type="hidden" name="skuId" value="<%= p.sku_id %>"><input type="hidden" name="conditionCode" value="<%= p.condition_code %>"><label>Updated condition label<input name="conditionLabel" required maxlength="200" value="<%= p.condition_label %>"></label><label>Updated outcome<select name="outcome"><% ['RESTOCK','REPAIR','SCRAP'].forEach(function(outcome){ %><option value="<%= outcome %>" <%= outcome===p.outcome?'selected':'' %>><%= outcome.toLowerCase() %></option><% }) %></select></label><label>Updated destination<select name="destinationId"><% screen.places.forEach(function(l){ %><option value="<%= l.id %>" <%= l.id===p.destination_id?'selected':'' %>><%= l.name %></option><% }) %></select></label><label>Updated maximum units<input name="maximumUnits" type="number" min="1" max="100000" required value="<%= p.maximum_units %>"></label><label><input type="checkbox" name="confirmed" value="yes" required> I approve these revised facts. Routine preparation stops and the previous training is cleared.</label><button class="btn" type="submit">Save revised rule</button></form></details><% } %>
<% if(p.enabled){ %><form method="post" action="/autopilot/return-disposition/rules/<%= p.id %>/configure"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="revision" value="<%= p.revision %>"><input type="hidden" name="stop" value="yes"><button class="btn" type="submit">Stop this rule</button></form><% } %></section><% }) %>
<section class="card"><h2>Goods held for actual repair</h2><p>These returned goods are excluded from sellable stock until you confirm the physical repair and reinspection. Routine planning never releases this hold.</p>
<% screen.repairs.forEach(function(h){ %><h3><%= h.return_number %> · <%= h.code %> · <%= h.quantity %> units</h3><p>Held at <%= h.location_name %>.</p><% if(screen.allowed){ %><form method="post" action="/autopilot/return-disposition/repairs/<%= h.id %>/release"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="sourceHash" value="<%= h.sourceHash %>"><label>Location after completed repair<select name="destinationId" aria-label="Location after completed repair"><% screen.places.forEach(function(l){ %><option value="<%= l.id %>" <%= l.id===h.location_id?'selected':'' %>><%= l.name %></option><% }) %></select></label><label>Actual repair and physical checks<input name="note" required maxlength="500"></label><label><input type="checkbox" name="confirmed" value="yes" required> I confirm these exact goods were repaired, physically rechecked and are ready for sale.</label><button class="btn" type="submit">Release physically repaired goods</button></form><% }else{ %><p>Pro or Custom is required to release a new agent repair disposition. The physical hold remains in place.</p><% } %><% }) %><% if(screen.moreRepairs){ %><p>Showing the first 100 held repairs. Finish current repairs to reveal the rest.</p><% } %></section>
<% if(screen.morePlaces || screen.moreRules){ %><p>This view supports 250 internal locations and 500 rules. Broader configuration needs a separate review.</p><% } %>
<section class="card"><h2>Saved physical assessments</h2><% screen.assessments.forEach(function(a){ %><p><a href="/autopilot/return-disposition?id=<%= a.id %>"><%= a.return_number %> · <%= a.status.toLowerCase() %></a><% if(a.problem){ %> · <%= a.problem %><% } %></p><% }) %><% if(screen.moreAssessments){ %><p>Showing the latest 100 assessments. Original returns retain their physical inspection history.</p><% } %></section></div>
