<% const {product,positions,selected,result,hold,page,more}=model;
const unit=product.unit_label==='unit'?'units':product.unit_label; %>
<h1>ABC count and safety planning</h1>
<section class="card card-body stack">
  <h2><%= product.name %> · <%= product.base_code %></h2>
  <p>Month beginning <%= product.month %> · <strong><%= ['A','B','C'].includes(product.category)?'Class '+product.category:product.category?'Cost review needed':'Awaiting monthly review' %></strong></p>
  <% if(product.saleCost!==null){ %><p><%= product.saleCost %> stock cost sold over the previous 12 complete months.</p><% } %>
  <% if(product.category==='C'&&!product.has_sales){ %><p>No recorded sales in that period.</p><% } %>
  <% if(product.category==='Review'){ %><p>One or more sales lack verified stock cost.</p><% } %>
  <p><a href="/autopilot/reviews/count-priorities">See how classes rank shelves for counting</a> · <a href="/inventory/<%= product.id %>">Open product record</a></p>
</section>
<section class="card card-body stack">
  <h2>Safety stock by SKU and location</h2>
  <% if(!positions.length){ %><p>No stock position or local setting is recorded for this product on this page.</p><% }else{ %>
  <form method="get" class="form-stack">
    <input type="hidden" name="page" value="<%= page %>">
    <label class="rm-field">SKU and location
      <select name="position" required>
        <% for(const p of positions){ %><option value="<%= JSON.stringify([p.sku_id,p.location_id]) %>" <%= p===selected?'selected':'' %>><%= p.code %> · <%= p.location %> · <%= p.safety_stock==null?'Safety stock unset':p.safety_stock+' '+unit %><%= p.service_level?' · Class target '+p.service_level+'%':'' %></option><% } %>
      </select>
    </label>
    <% if(['A','B','C'].includes(product.category)){ %><label class="rm-field">Coverage to review (%) <input name="serviceLevel" type="number" min="1" max="100" step="1" inputmode="numeric" value="<%= result?.serviceLevel??'' %>"></label>
    <p>Leave coverage blank to use a saved class target at the selected location. Estimates are for planning.</p><% } %>
    <button class="btn">Review selected position</button>
  </form>
  <% } %>
  <% if(selected){ %><p><%= selected.code %> · <%= selected.location %>. Current safety stock <%= selected.safety_stock==null?'is unset':'is '+selected.safety_stock+' '+unit %>.<% if(selected.service_level){ %> Saved class <%= product.category %> target is <%= selected.service_level %>%.<% } %></p><% } %>
  <% if(hold){ %><p role="status"><%= hold %></p><% } %>
  <% if(selected&&!result&&!hold){ %><p>Enter a coverage percentage to estimate safety stock for this position.</p><% } %>
  <% if(result){ %><p>Estimated safety stock is <strong><%= result.units %> <%= unit %></strong> at <%= result.serviceLevel %>% coverage. StockChief measured <%= result.windows %> fully stocked periods of <%= result.lead %> days. Periods with a stockout are excluded.</p>
  <% if(result.assumedLead){ %><p>The estimate uses a default supplier lead time. Record the actual lead time for automatic safety-stock decisions.</p><% } %><% } %>
  <nav class="actions" aria-label="Safety-stock positions"><% if(page>1){ %><a href="?page=<%= page-1 %>">Previous page</a><% } %><% if(more){ %><a href="?page=<%= page+1 %>">Next page</a><% } %></nav>
</section>
