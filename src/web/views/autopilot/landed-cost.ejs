<section class="card"><h1>Stock cost allocation <%= document.document_number %></h1><p><% if(document.purchase_order_id){ %><a href="/purchasing/orders/<%= document.purchase_order_id %>">Purchase order <%= document.po_number %></a><% }else{ %>Recorded deliveries<% } %> · <%= document.status.toLowerCase() %></p><p><strong><%= helpers.money(totalMinor,document.currency) %></strong> of additional cost, allocated by <%= document.allocation_method %>.</p><p>This changes the value of recorded stock. Quantities, supplier balances and payments stay the same.</p>
<% if(document.status==='REVERSED'){ %><p>This allocation was reversed. Its original expense and stock value were restored; the original allocations remain in the history.</p><% } %>
<h2>Recorded expense evidence</h2><% for(const c of document.charges){ %><p><% if(c.bill_id){ %><a href="/money/bills/<%= c.bill_id %>"><%= c.bill_number %></a> · <% } %><%= c.description %> · <%= helpers.money(Number(c.amount_minor),document.currency) %></p><% } %>
<% if(problem){ %><p role="status"><%= problem %></p><% } %><% if(stopped){ %><p role="status"><%= stopped %></p><% } %>
<% if(ready){ %><h2>Product cost changes</h2><table><thead><tr><th>Product</th><th>Received units</th><th>Location</th><th>Additional stock cost</th></tr></thead><tbody><% for(const a of ready.source.allocations){ %><tr><td><%= a.product %> · <%= a.sku %></td><td><%= a.quantity %></td><td><%= a.location %></td><td><%= helpers.money(a.amountMinor,document.currency) %></td></tr><% } %></tbody></table>
<form method="post" action="/autopilot/landed-costs/<%= document.id %>/prepare"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="btn" <%= stopped?'disabled':'' %>>Review approval</button></form><% } %>
<% if(allocations.length){ %><h2>Recorded allocations</h2><% for(const a of allocations){ %><p><%= a.name %> · <%= a.code %> at <%= a.location_name %> · <%= helpers.money(Number(a.amount_minor),document.currency) %></p><% } %><% } %>
<% if(['DRAFT','APPROVED'].includes(document.status)){ %><form method="post" action="/autopilot/landed-costs/<%= document.id %>/discard"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="btn">Discard this cost draft</button></form><% } %>
<% if(document.status==='APPLIED'){ %><% if(reverseReason){ %><p role="status"><%= reverseReason %></p><% }else{ %><form method="post" action="/autopilot/landed-costs/<%= document.id %>/reverse"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="confirmed" value="yes"><p>Reversing returns this recorded cost to its original expense and preserves the original allocation in the history.</p><button class="btn">Reverse this recorded cost allocation</button></form><% } %><% } %></section>
<p><a href="/autopilot/reviews/landed-costs">Back to received-goods costs</a></p>
