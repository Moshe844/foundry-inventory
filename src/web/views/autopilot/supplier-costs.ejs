<h1>Supplier delivered cost evidence</h1>
<p>Compare each product delivered on its own to an exact receiving site. Check original quotes, applicable shipping, taxes, tax recovery and all other nonrecoverable charges. Missing amounts stay unknown. This private evidence changes no supplier prices, buying preferences, purchase orders or posted money.</p>
<p><a href="/autopilot/reviews/supplier-options">Compare suppliers</a></p>
<form method="get" action="/autopilot/supplier-costs"><label>Exact product code or supplier name <input name="filter" value="<%= screen.filter||'' %>"></label><button class="btn">Find supplier products</button></form>
<div class="rm-agent__table"><table><thead><tr><th>Product</th><th>Supplier</th><th>Recorded unit price</th><th>Check evidence</th></tr></thead><tbody><% for(const o of screen.offers){ %><tr><td><%= o.code %> · <%= o.name %></td><td><%= o.supplier_name %></td><td><%= o.last_unit_cost==null?'Unknown':cash.format(cash.toMinor(String(o.last_unit_cost),o.currency),o.currency) %></td><td><a href="/autopilot/supplier-costs?offer=<%= encodeURIComponent(o.id) %>">Choose receiving site</a></td></tr><% } %></tbody></table></div>
<% if(screen.more){ %><p><a href="/autopilot/supplier-costs?page=<%= screen.page+1 %>&amp;filter=<%= encodeURIComponent(screen.filter||'') %>">Next evidence page</a></p><% } %>
<% if(screen.chosen){const o=screen.chosen; %>
<h2><%= o.code %> · <%= o.supplier_name %></h2>
<form method="get" action="/autopilot/supplier-costs"><input type="hidden" name="offer" value="<%= o.id %>"><label>Receiving site <select name="location" required><option value="">Choose the exact site</option><% for(const l of screen.locations){ %><option value="<%= l.id %>" <%= screen.location?.id===l.id?'selected':'' %>><%= l.name %></option><% } %></select></label><button class="btn">Review this quote scope</button></form>
<% if(screen.location){const t=screen.term||{},value=(key)=>t[key]??'',amount=(key)=>t[key]==null?'':cash.fromMinor(t[key],o.currency); %>
<p>Site: <%= screen.location.name %>. Supplier currency: <%= o.currency %>. Saved goods price: <%= o.last_unit_cost??'unknown' %> per <%= o.secondary_unit_label||o.unit_label %>. Current pack: <%= o.units_per_purchase_unit??'unknown' %> <%= o.unit_label %> per <%= o.purchase_unit||'unknown purchase unit' %>. Saved ordinary delivery: <%= o.freight_terms_currency===o.currency&&o.ordinary_freight_minor!=null?cash.format(o.ordinary_freight_minor,o.currency):'unknown' %>; free-delivery threshold: <%= o.freight_terms_currency===o.currency&&o.free_freight_threshold_minor!=null?cash.format(o.free_freight_threshold_minor,o.currency):'unknown' %>.</p>
<form method="post" action="/autopilot/supplier-costs/terms">
<input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="supplierItemId" value="<%= o.id %>"><input type="hidden" name="locationId" value="<%= screen.location.id %>"><input type="hidden" name="sourceHash" value="<%= screen.sourceHash %>"><input type="hidden" name="revision" value="<%= t.revision||0 %>">
<fieldset><legend>Exact scope covered by the original quote</legend><label>Minimum stocking quantity (<%= o.unit_label %>) <input name="minimumQuantity" inputmode="decimal" required value="<%= value('minimum_quantity') %>"></label><label>Maximum stocking quantity (<%= o.unit_label %>) <input name="maximumQuantity" inputmode="decimal" required value="<%= value('maximum_quantity') %>"></label>
<% if(o.secondary_unit_label){ %><label>Minimum independent <%= o.secondary_unit_label %> <input name="minimumSecondaryQuantity" inputmode="decimal" required value="<%= value('minimum_secondary_quantity') %>"></label><label>Maximum independent <%= o.secondary_unit_label %> <input name="maximumSecondaryQuantity" inputmode="decimal" required value="<%= value('maximum_secondary_quantity') %>"></label><% } %>
<label>Valid from <input type="date" name="validFrom" required value="<%= value('valid_from')||screen.today %>"></label><label>Valid through <input type="date" name="validUntil" required value="<%= value('valid_until') %>"></label></fieldset>
<fieldset><legend>Tax and delivery facts</legend>
<label>Recorded goods price <select name="goodsPriceBasis" required><option value="">Choose its tax basis</option><option value="net" <%= t.goods_price_basis==='net'?'selected':'' %>>Excludes tax</option><option value="gross" <%= t.goods_price_basis==='gross'?'selected':'' %>>Includes tax</option></select></label><label>Goods tax percent (enter 0 if exempt) <input name="goodsTaxPercent" inputmode="decimal" required value="<%= value('goods_tax_percent') %>"></label>
<label>Applicable delivery charge <select name="freightMode" required><option value="">Choose checked shipping terms</option><option value="saved" <%= t.freight_mode==='saved'?'selected':'' %>>Current saved supplier delivery and free-shipping terms apply here</option><option value="fixed" <%= t.freight_mode==='fixed'?'selected':'' %>>Fixed delivery amount in this quote</option><option value="included" <%= t.freight_mode==='included'?'selected':'' %>>Delivery is included at no additional charge</option></select></label>
<label>Fixed quoted delivery amount (<%= o.currency %>), if selected <input name="fixedFreight" inputmode="decimal" value="<%= amount('fixed_freight_minor') %>"></label><label>Saved free-shipping threshold uses <select name="freightThresholdBasis"><option value="">Choose if saved shipping applies</option><option value="net_goods" <%= t.freight_threshold_basis==='net_goods'?'selected':'' %>>Goods value before tax</option><option value="recorded_goods" <%= t.freight_threshold_basis==='recorded_goods'?'selected':'' %>>Recorded goods price total</option></select></label>
<label>Delivery price <select name="freightPriceBasis" required><option value="">Choose its tax basis</option><option value="net" <%= t.freight_price_basis==='net'?'selected':'' %>>Excludes tax</option><option value="gross" <%= t.freight_price_basis==='gross'?'selected':'' %>>Includes tax</option></select></label><label>Delivery tax percent (enter 0 if exempt) <input name="freightTaxPercent" inputmode="decimal" required value="<%= value('freight_tax_percent') %>"></label><label>Recoverable share of goods tax, percent <input name="goodsRecoverableTaxPercent" inputmode="decimal" required value="<%= value('goods_recoverable_tax_percent') %>"></label><label>Recoverable share of delivery tax, percent <input name="freightRecoverableTaxPercent" inputmode="decimal" required value="<%= value('freight_recoverable_tax_percent') %>"></label><label>All other nonrecoverable duty, fees and delivery charges (<%= o.currency %>; enter 0 if none) <input name="otherCharges" inputmode="decimal" required value="<%= amount('other_charges_minor') %>"></label></fieldset>
<label>Original checked quote, tax and delivery sources <textarea name="sourceReference" maxlength="2000" required><%= value('source_reference') %></textarea></label><label><input type="checkbox" name="confirmed" value="yes" required> I checked these original facts and their applicability to this product, site and complete quantity range. All applicable costs and tax recovery are covered.</label><button class="btn" name="mode" value="save">Save checked delivery and tax evidence</button><% if(t.revision){ %><button class="btn" name="mode" value="clear" formnovalidate>Withdraw this comparison evidence</button><% } %>
</form><% }} %>
<h2>Checked comparison exchange quotes</h2><p>Use an actual quoted or contracted conversion after all conversion costs. A reference estimate alone does not establish what this comparison will cost. Rate direction: one unit of the supplier currency buys the stated comparison-currency amount. Quotes can be used in either direction without rounding an invented reciprocal.</p>
<div class="rm-agent__table"><table><thead><tr><th>Pair</th><th>Rate</th><th>Source</th><th>Validity</th><th>Revision</th></tr></thead><tbody><% for(const r of screen.rates){ %><tr><td><%= r.foreign_currency %> → <%= r.comparison_currency %></td><td><%= r.comparison_per_foreign %></td><td><%= r.source_reference %></td><td><%= r.valid_from %> to <%= r.valid_until %></td><td><%= r.revision %></td></tr><% } %></tbody></table></div>
<form method="post" action="/autopilot/supplier-costs/rates"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><label>Supplier currency <input name="foreignCurrency" maxlength="3" required></label><label>Comparison currency <input name="comparisonCurrency" maxlength="3" required value="<%= screen.comparisonCurrency||'' %>"></label><label>Comparison currency per one supplier-currency unit <input name="comparisonPerForeign" inputmode="decimal" required></label><label>Original quote date <input type="date" name="quotedOn" required></label><label>Valid from <input type="date" name="validFrom" required></label><label>Valid through <input type="date" name="validUntil" required></label><label>Current pair revision, or 0 for a new pair <input name="revision" type="number" min="0" step="1" value="0" required></label><label>Original all-in exchange quote or contract <textarea name="sourceReference" maxlength="2000" required></textarea></label><label><input type="checkbox" name="confirmed" value="yes" required> I checked the direction, actual conversion cost, original source and validity.</label><button class="btn">Save checked comparison exchange quote</button></form>
