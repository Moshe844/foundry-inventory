<h1>Promotion stock planning</h1><p>Plan stock for a promotion or sale and draft the purchase orders, one per supplier. StockChief uses actual warehouse issues, your promotion dates and your extra demand assumption, and checks stock, promises, dated incoming orders and recorded supplier packs. It changes no selling prices.</p>
<% if(locked){ %><section class="card"><h2><span class="badge">Pro</span> Promotion plans and purchase drafts</h2><p>Pro reviews every plan and purchase draft. Custom can authorize planning and one unapproved purchase draft per supplier within a chosen goods-value limit, without training.</p><a class="btn" href="/settings/billing">Upgrade</a></section><% }else{ %>
<section class="card"><h2>Choose the exact promotion</h2><form method="post" action="/autopilot/promotion-stock/preview" class="form-stack"><input type="hidden" name="_csrf" value="<%= csrfToken %>">
<% if(promotions.length){ %><label class="rm-field"><span>Recorded promotion (optional)</span><select name="pricingRuleId"><option value="">None: enter the dates and products below</option><% for(const r of promotions){ %><option value="<%= r.id %>" <%= chosen&&chosen.id===r.id?'selected':'' %>><%= r.name %> · <%= r.startsOn %> to <%= r.endsOn %></option><% } %></select></label><p>A recorded promotion fills in its name, dates and products. Anything you enter below takes its place.</p><% } %>
<label class="rm-field"><span>Supplier name (optional)</span><input name="supplierName" maxlength="240"></label><p>Leave it empty to order each product from its main supplier, one purchase order per supplier.</p><label class="rm-field"><span>Owned warehouse or stock location name</span><input name="locationName" maxlength="240" required></label><label class="rm-field"><span>Promotion reference</span><input name="reference" maxlength="200" <%= promotions.length?'':'required' %>></label>
<label class="rm-field"><span>StockChief SKU codes, one per line</span><textarea name="skuCodes" maxlength="50000" rows="5" <%= promotions.length?'':'required' %>></textarea></label>
<% for(const [key,label,needed] of [['orderByDate','Last order date',true],['arrivalDate','Planned arrival date',true],['startsOn','Promotion start',!promotions.length],['endsOn','Promotion end',!promotions.length]]){ %><label class="rm-field"><span><%= label %></span><input name="<%= key %>" type="date" <%= needed?'required':'' %>></label><% } %>
<label class="rm-field"><span>Extra demand during the promotion (%)</span><input name="upliftPercent" type="number" min="0" max="1000" step="1" required></label><p>This percentage is your assumption, not a guaranteed forecast. Up to 250 whole-unit products per supplier and 50 owned stock locations per warehouse scope. Lots, serials, measured stock and new products without issue history need separate review.</p><button class="btn">Review promotion stock plan</button></form></section>
<% if(drafts.length){ %><section class="card"><h2>Review the exact stock basis</h2><% if(drafts.length>1){ %><p>These products come from <%= drafts.length %> suppliers, so there is one plan and one purchase draft for each.</p><% } %><% for(const draft of drafts){ %><%- include('promotion-stock-body',{facts:draft}) %><% } %><form method="post" action="/autopilot/promotion-stock" class="form-stack"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><% for(const key of ['locationId','reference','orderByDate','arrivalDate','startsOn','endsOn','upliftPercent']){ %><input type="hidden" name="<%= key %>" value="<%= drafts[0].scope[key] %>"><% } %><input type="hidden" name="plans" value="<%= JSON.stringify(drafts.map(d=>({supplierId:d.scope.supplierId,skuIds:d.scope.skuIds,sourceFingerprint:d.sourceFingerprint}))) %>"><label><input type="checkbox" name="confirmed" value="yes" required> I reviewed these exact dates, products, extra demand assumption and stock basis. Saving <%= drafts.length>1?'these plans':'this plan' %> creates no purchase.</label><button class="btn" <%= shadow?'disabled':'' %>>Save reviewed promotion plan<%= drafts.length>1?'s':'' %></button></form></section><% } %><% } %>
<% if(rows.length){ %><section class="card"><h2>Saved promotions</h2><% for(const p of rows){ %><article><h3><% if(!locked){ %><a href="/autopilot/promotion-stock/<%= p.id %>"><%= p.reference %> · <%= p.supplier_name %> · <%= p.location_name %></a><% }else{ %><%= p.reference %> · <%= p.supplier_name %> · <%= p.location_name %><% } %></h3><p><%= p.enabled?(plan==='enterprise'?'Scoped planning enabled':'Automatic planning paused on this plan'):'Automatic planning stopped' %>. <%= p.last_issue||'' %></p><% if(p.enabled){ %><form method="post" action="/autopilot/promotion-stock/<%= p.id %>/settings"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="revision" value="<%= p.revision %>"><button class="btn" name="stop" value="yes">Stop promotion planning</button></form><% } %></article><% } %></section><% } %>
<nav aria-label="Saved promotion pages"><% if(page>1){ %><a href="/autopilot/promotion-stock?page=<%= page-1 %>">Newer promotions</a><% } %> <% if(more){ %><a href="/autopilot/promotion-stock?page=<%= page+1 %>">Older promotions</a><% } %></nav><p>AI credits used: 0.</p>
