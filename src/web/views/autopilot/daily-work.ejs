<% if(result.undoForm.entries.length){ %><section class="card card-body section"><h2>Undo available changes</h2>
<% for(const entry of result.undoForm.entries){ %><form method="post" action="/autopilot/undo/<%= entry.id %>" class="section">
 <input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="day" value="<%= result.undoForm.day %>">
 <p><%= entry.summary %></p><p><%= entry.what %></p><button class="btn">Undo this change</button>
</form><% } %></section><% } %>
