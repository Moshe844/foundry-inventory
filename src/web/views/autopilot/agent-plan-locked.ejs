<h1><%= title %></h1>
<section class="card"><div class="card-body" data-agent-plan-locked>
  <span class="rm-pillbadge"><%= tier %></span>
  <% if (reviewTerms) { %>
    <p>This work is included in your plan’s updated terms. Review the terms to open it.</p>
    <a class="btn" href="/billing/terms">Review updated plan terms</a>
  <% } else { %>
    <p>This work is available on Starter and above.</p>
    <a class="btn" href="/billing">See plans</a>
  <% } %>
</div></section>
