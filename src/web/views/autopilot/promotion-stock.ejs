<h1>Promotion stock plan</h1><p>Pro reviews every purchase draft. Custom can prepare one unapproved draft inside your authorized promotion scope and goods-value limit. Ordinary purchase approval, sending, tax and freight review remain separate.</p>
<% if(problem){ %><aside class="notice"><%= problem %></aside><% } %>
<% if(draft){ %><section class="card"><h2>Purchase draft</h2><p><%= draft.automatic?'StockChief prepared':'You prepared' %> <a href="/purchasing/orders/<%= draft.id %>"><%= draft.po_number %></a> for this promotion. Status: <%= draft.status==='DRAFT'?'draft, not approved or sent':draft.status==='CANCELLED'?'cancelled':draft.status.toLowerCase().replaceAll('_',' ') %>. Each promotion plan prepares at most one purchase draft at a time.</p><% if(draft.status==='DRAFT'){ %><form method="post" action="/autopilot/promotion-stock-plans/<%= draft.plan_id %>/undo"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="btn">Undo: cancel this purchase draft</button></form><% } %></section><% } %>
<% if(latest){ %><section class="card"><h2>Latest saved plan</h2><p>Prepared <%= helpers.dateTime(latest.created_at) %> · <%= latest.automatic?'Within the owner’s authorized promotion scope':'Individually reviewed' %>.</p><%- include('promotion-stock-body',{facts:latest.source_snapshot}) %>
<% if(!purchaseOrderId){ %><form method="post" action="/autopilot/promotion-stock-plans/<%= latest.id %>/purchase" class="form-stack"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="sourceFingerprint" value="<%= latest.source_fingerprint %>"><label><input type="checkbox" name="confirmed" value="yes" required> I reviewed these exact quantities, current stock and supplier terms and approve preparing one purchase draft. This does not approve or send the order.</label><button class="btn" <%= shadow||!fresh||fresh.sourceFingerprint!==latest.source_fingerprint||latest.source_snapshot.warnings.length||!latest.source_snapshot.calculated.rows.some(r=>r.quantityUnits>0)?'disabled':'' %>>Prepare reviewed promotion purchase draft</button></form><% } %></section><% } %>
<% if(fresh&&!purchaseOrderId){ %><section class="card"><h2>Review a fresh plan</h2><details><summary>Current stock and demand basis</summary><%- include('promotion-stock-body',{facts:fresh}) %></details><form method="post" action="/autopilot/promotion-stock" class="form-stack"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><% for(const key of ['supplierId','locationId','reference','orderByDate','arrivalDate','startsOn','endsOn','upliftPercent']){ %><input type="hidden" name="<%= key %>" value="<%= fresh.scope[key] %>"><% } %><input type="hidden" name="skuIds" value="<%= fresh.scope.skuIds.join(',') %>"><input type="hidden" name="sourceFingerprint" value="<%= fresh.sourceFingerprint %>"><label><input type="checkbox" name="confirmed" value="yes" required> I reviewed the current exact plan and its source warnings.</label><button class="btn" <%= shadow?'disabled':'' %>>Save reviewed plan update</button></form></section><% } %>
<section class="card"><h2>Plan and prepare one draft automatically</h2><% if(plan==='enterprise'&&!purchaseOrderId){ %><form method="post" action="/autopilot/promotion-stock/<%= project.id %>/settings" class="form-stack"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="revision" value="<%= project.revision %>"><input type="hidden" name="sourceFingerprint" value="<%= fresh?.sourceFingerprint||'' %>"><label class="rm-field"><span>Days between checks</span><input name="refreshDays" type="number" min="1" max="30" required></label><label class="rm-field"><span>Maximum goods value for one draft (<%= fresh?.supplier.currency||'' %>)</span><input name="maximumAmount" inputmode="decimal" required></label><label><input type="checkbox" name="confirmed" value="yes" required> I authorize only this supplier, warehouse, promotion dates, products, demand assumption and goods-value limit. StockChief may prepare one unapproved purchase draft without training. It cannot approve, send, pay, change selling prices or record physical receipt.</label><button class="btn" <%= shadow||!fresh?'disabled':'' %>>Enable scoped promotion planning</button></form><% }else if(plan!=='enterprise'){ %><p><span class="badge">Custom</span> Automatic promotion planning and draft preparation require Custom. Pro approves each draft individually.</p><a class="btn" href="/settings/billing">Upgrade</a><% } %>
<% if(project.enabled){ %><form method="post" action="/autopilot/promotion-stock/<%= project.id %>/settings"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="revision" value="<%= project.revision %>"><button class="btn" name="stop" value="yes">Stop promotion planning</button></form><% } %></section><p>For a corrected promotion, stop the old scope and use a new reference. AI credits used: 0.</p>
