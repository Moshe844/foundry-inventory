<h1><%= result.label %></h1><p><%= result.summary %></p>
<% if(result.overdueRule!==undefined){ %>
<% if(result.mode==='alone'||result.overdueRule){ %>
<form method="post" action="/autopilot/reviews/overdue-customer-orders/rule"><input type="hidden" name="_csrf" value="<%= csrfToken %>">
<p>When automation is active, this rule holds new reservations and fulfillment for customers with overdue invoices.</p>
<button name="mode" value="<%= result.overdueRule?'off':'on' %>" class="btn"><%= result.overdueRule?'Turn off overdue-order holds':'Enable overdue-order holds' %></button></form>
<% } else { %><p>Automatic holds require Pro. <a href="/billing">Upgrade</a></p><% } %>
<% } %>
<% if(result.filterable){ %><form method="get"><label><%= result.filterLabel||"Filter by exact code, name or reference" %> <input name="filter" value="<%= filter %>" maxlength="150"></label><% if(result.requiresChange){ %><label>Change in sales (%) <input type="number" name="change" step="0.01" min="-100" max="1000" value="<%= result.change??'' %>" required></label><% } %><button class="btn">Look up</button></form><% } %>
<% if(result.rows.length){const fields=Object.keys(result.rows[0]).filter(f=>f!=='link'); %><div class="card"><table><thead><tr><% fields.forEach(f=>{ %><th><%= f %></th><% }); %><% if(result.rows[0].link){ %><th>Record</th><% } %></tr></thead><tbody>
<% result.rows.forEach(r=>{ %><tr><% fields.forEach(f=>{ %><td><%= r[f]??'Unknown' %></td><% }); %><% if(r.link){ %><td><a href="<%= r.link %>">Open</a></td><% } %></tr><% }); %>
</tbody></table></div><% }else if(!result.requiresChange||result.change){ %><p>No matching records.</p><% } %>
<% if(result.page>1){ %><a href="?page=<%= result.page-1 %>&amp;filter=<%= encodeURIComponent(filter) %><%= result.requiresChange?'&change='+encodeURIComponent(result.change||''):'' %>">Previous page</a><% } %>
<% if(result.more){ %><a href="?page=<%= result.page+1 %>&amp;filter=<%= encodeURIComponent(filter) %><%= result.requiresChange?'&change='+encodeURIComponent(result.change||''):'' %>">Next page</a><% } %>
