<h1><%= result.label %></h1><p><%= result.summary %></p>
<% if(result.breaker){ const b=result.breaker; %>
<section class="card card-body stack" data-circuit-breaker>
  <% if(b.paused){ %>
    <p class="notice notice--warn"><strong>Automatic work is paused.</strong> <%= b.reason %></p>
    <form method="post" action="/autopilot/circuit-breaker/resume" class="form-stack">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <label><input type="checkbox" name="reviewed" value="yes" required> I reviewed today’s automatic work below</label>
      <label>Note for the record (optional) <input name="note" maxlength="500"></label>
      <p><button class="btn btn--primary">Resume automatic work</button></p>
    </form>
  <% }else{ %><p>Automatic work is running. StockChief pauses it on its own if today looks unusual.</p><% } %>
</section>
<% } %>
<% if(result.pricePreparationHold){ %><p><%= result.pricePreparationHold %></p><% } %>
<% if(result.countSourcePath){ %><p><a class="btn" href="<%= result.countSourcePath %>">Open physical count originals</a></p><% } %>
<% if(result.customerCheckinLink){ %><p><a href="/autopilot/customer-check-ins">Open saved check-ins and routine settings</a></p><% } %>
<% if(result.openToBuyPath){ %><p><a class="btn" href="<%= result.openToBuyPath+(filter?'?month='+encodeURIComponent(filter):'') %>">Open monthly buying plans</a></p><% } %>
<% if(result.cyclePlan){ %><p><a class="btn" href="/autopilot/daily-cycle-counts">Open daily cycle-count plans</a></p><% } %>
<% if(result.transferArrivalLink){ %><p><a href="/transfers/arrival-follow-up">Review open receiving follow-ups</a></p><% } %>
<% if(result.approvalRoutingPath){ %><p><a class="btn" href="<%= result.approvalRoutingPath %>">Set who approves what</a></p><% } %>
<% if(result.backorderLink){ %><p><a class="btn" href="/autopilot/backorders">Open backorders</a></p><% } %>
<% if(result.staleIncomingLink){ %><p><a class="btn" href="/autopilot/stale-incoming">Goods that will not arrive</a></p><% } %>
<% if(result.stockSharingLink){ %><p><a class="btn" href="/autopilot/stock-sharing">Share scarce stock by your rules</a></p><% } %>
<% if(result.warehouseRoutingLink){ %><p><a class="btn" href="/autopilot/warehouse-routing">Set your warehouse routing rules</a></p><% } %>
<% if(result.orderSplitsLink){ %><p><a class="btn" href="/autopilot/order-splits">Split orders by your rules</a></p><% } %>
<% if(result.preordersLink){ %><p><a class="btn" href="/autopilot/preorders">Fill preorders as stock arrives</a></p><% } %>
<% if(result.lossShifts?.length){ %>
  <details><summary>Set local warehouse shifts</summary>
    <% for(const warehouse of result.lossShifts){ %>
      <form method="post" action="/autopilot/reviews/repeat-loss/shifts" class="form-stack">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <input type="hidden" name="locationId" value="<%= warehouse.id %>">
        <input type="hidden" name="revision" value="<%= warehouse.revision %>">
        <label><%= warehouse.name %> shift start times
          <input name="starts" value="<%= warehouse.starts %>" maxlength="64" required>
        </label>
        <small>Separate local times in 24-hour format with commas.</small>
        <button class="btn">Save <%= warehouse.name %> shifts</button>
      </form>
    <% } %>
  </details>
<% } %>
<% if(result.balanceForm){ %>
  <p><a href="/autopilot/transfer-balancing">Manage saved balancing rules</a></p>
  <details><summary>Prepare a stock balancing request</summary>
    <form method="post" action="/autopilot/reviews/balance-transfers/prepare">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <label>Exact product or variant code <input name="sku" required value="<%= filter||'' %>"></label>
      <label>Source location <input name="fromLocation" required></label>
      <label>Destination location <input name="toLocation" required></label>
      <label>Maximum stocking quantity (optional) <input name="maximumBalanceQuantity" inputmode="decimal"></label>
      <button class="btn">Review the balancing request</button>
    </form>
  </details>
<% } %>
<% if(result.rotationForm){ %><form method="post" action="/autopilot/reviews/stock-rotation/prepare"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><label>Exact order number <input name="order" required value="<%= filter||'' %>"></label><label>Stock rotation <select name="strategy"><option value="FIFO">Oldest recorded receipt first (FIFO)</option><option value="FEFO">Earliest recorded expiry first (FEFO)</option></select></label><label>For mixed untracked stock with earlier issues: your checked records establishing that those issues used FIFO (optional) <textarea name="historicalFifoEvidence" maxlength="4000"></textarea></label><p>A new historical age fact requires your individual review before any reservation can use it.</p><button class="btn">Review exact reservations</button></form><% } %>
<% if(result.reorderForm||result.supplierSelection){ %><details><summary><%= result.supplierSelection?'Choose a buying supplier':'Prepare grouped purchase drafts' %></summary>
<form method="post" action="/autopilot/reviews/<%= result.supplierSelection?'supplier-options':'reorder-drafts' %>/purchasing-prepare">
<input type="hidden" name="_csrf" value="<%= csrfToken %>">
<label>Exact product codes, one per line<%= result.supplierSelection?'':' (leave empty for the reorder list)' %> <textarea name="skuCodes" <%= result.supplierSelection?'required':'' %>><%= filter||'' %></textarea></label>
<label>Receiving location (optional) <input name="location"></label>
<% if(result.supplierSelection){ %><label>Exact stocking quantity for each comparison (optional; otherwise the current reorder need) <input name="quantity" inputmode="decimal"></label><% } %>
<% if(result.supplierSelection){ %><p><a href="/autopilot/supplier-costs">Check delivery, tax recovery and exchange evidence</a></p><label>Choose by <select name="strategy"><option value="cheapest">Lowest comparable delivered economic cost</option><option value="fastest">Shortest recorded delivery time</option></select></label><label>Comparison basis <select name="comparisonBasis"><option value="economic">Delivered cost after shipping, charges and tax recovery</option><option value="goods">I explicitly want goods-only comparison</option></select></label><label>Comparison currency, if needed <input name="comparisonCurrency" maxlength="3" placeholder="USD"></label><label>For goods-only: your explicit request to review shipping and tax separately <textarea name="goodsOnlyReason" maxlength="2000"></textarea></label><% } %>
<label>Independent requested weights, if applicable (product code | receiving location | pieces | weight) <textarea name="secondaryQuantities"></textarea></label>
<p>Review missing costs, undated deliveries or existing unsent orders before purchasing. New supplier or price terms need individual approval.</p>
<button class="btn"><%= result.supplierSelection?'Review supplier choice':'Review grouped drafts' %></button>
</form></details><% } %>
<% if(result.lotCertificateLink){ %><p><a class="btn" href="/autopilot/lot-certificates">Review and link certificate originals</a> <a href="/autopilot/lots">Find a recorded lot</a></p><% } %>
<% if(result.supplierCreditLink){ %><p><a class="btn" href="/autopilot/supplier-credits">Open credit notes and applications</a></p><% } %>
<% if(result.documentDiscoveryLink){ %><p><a class="btn" href="/autopilot/document-filing">Discover and file originals</a></p><% } %>
<% if(result.shippingDocumentLink){ %><p><a class="btn" href="/autopilot/shipping-documents">Read shipping originals</a></p><% } %>
<% if(result.variantImportLink){ %><p><a class="btn" href="/imports/variants">Open spreadsheet variants</a></p><% } %>
<% if(result.supplierBenefitLink){ %><p><a class="btn" href="/autopilot/supplier-benefits">Open</a></p><% } %>
<% if(result.supplierPriceListLink){ %><p><a class="btn" href="/autopilot/supplier-price-lists">Upload or review a supplier price list</a></p><% } %>
<% if(result.partnerStockForm){ %><%- include('partner-stock-readings',{setting:result.partnerStockForm,csrfToken}) %><% } %>
<% if(result.pickReleaseLink){ %><p><a class="btn" href="/autopilot/pick-release">Release ready orders and set your release rules</a></p><% } %>
<% if(result.pickWavesLink){ %><p><a class="btn" href="/autopilot/pick-waves">Open pick waves and set your wave rules</a></p><% } %>
<% if(result.putawayForm){ %><%- include('putaway-labels',{form:result.putawayForm,csrfToken}) %><% } %>
<% if(result.landedCostForm){ %><p><a class="btn" href="/autopilot/landed-cost-bills">Bills posted for deliveries</a> <a class="btn" href="/autopilot/landed-costs/new">Prepare a stock-cost allocation</a></p><% } %>
<% if(result.arrivedStockForm){ %><%- include('arrived-stock',{result,csrfToken}) %><% } %>
<% if(result.stockReadyForm){ %><%- include('stock-ready-updates',{result,csrfToken}) %><% } %>
<% if(result.invoiceDisputeForm){ %><%- include('supplier-invoice-disputes',{result,csrfToken}) %><% } %>
<% if(result.returnLabelForm){ %><%- include('return-labels',{result,csrfToken}) %><% } %>
<% if(result.customerStatementForm){ %><%- include('customer-statements',{result,csrfToken}) %><% } %>
<% if(result.customerQuestionForm){ %><%- include('customer-questions',{result,csrfToken}) %><% } %>
<% if(result.quoteRequestForm){ %><%- include('quote-requests',{result,csrfToken}) %><% } %>
<% if(result.quoteFollowupDefaults){ %><%- include('quote-followup-defaults',{result,csrfToken}) %><% } %>
<% if(result.creditForm){ %><%- include('customer-credits',{result,csrfToken}) %><% } %>
<% if(result.expiryPath){ %><p><a class="btn" href="<%= result.expiryPath %>">Set warning days and see where to sell first</a></p><% } %>
<% if(result.compliancePath){ %><p><a class="btn" href="<%= result.compliancePath %>">Prepare a full compliance report</a></p><% } %>
<% if(result.slowStockPath){ %><p><a class="btn" href="<%= result.slowStockPath %>">Review next steps for slow stock</a></p><% } %>
<% if(result.dataHealthPath){ %><p><a class="btn" href="<%= result.dataHealthPath %>">See the score and what to fix first</a></p><% } %>
<% if(result.productCategoriesPath){ %><p><a class="btn" href="<%= result.productCategoriesPath %>">Open categories and tags</a></p><% } %>
<% if(result.catalogFixesPath){ %><p><a class="btn" href="<%= result.catalogFixesPath %>">Open the bulk fix list</a></p><% } %>
<% if(result.supplierCatalogsPath){ %><p><a class="btn" href="<%= result.supplierCatalogsPath %>">Read a supplier catalog</a></p><% } %>
<% if(result.clearancePlanPath){ %><p><a class="btn" href="<%= result.clearancePlanPath %>">Open clearance plans</a></p><% } %>
<% if(result.slottingPath){ %><p><a class="btn" href="<%= result.slottingPath %>">Open warehouse move lists</a></p><% } %>
<% if(result.negotiationForm){ const n=result.negotiationForm; %><form method="post" action="/autopilot/negotiation-draft">
  <input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="supplier" value="<%= n.supplier %>">
  <input type="hidden" name="evidence" value="<%= n.evidence||'' %>"><input type="hidden" name="revision" value="<%= n.revision %>">
  <% if(n.evidence){ %><button class="btn">Draft an email from these facts</button><% } %>
  <a href="/autopilot/supplier-negotiations?supplier=<%= encodeURIComponent(n.supplier) %>">See each fact and its evidence</a>
  <% if(n.revision){ %><button class="btn" formaction="/autopilot/negotiation-rule" name="remove" value="1">Stop the routine lead-time note</button>
  <% }else if(result.mode==='draft'){ %><a href="/settings/billing">Routine lead-time notes that send on their own need Custom</a><% } %>
</form><% } %>
<% if(result.vacation){ const {rule,people,today,handback}=result.vacation; %>
<% if(handback){ %>
<section class="card card-body stack" data-vacation-handback>
  <h2>Welcome back</h2>
  <p><%= handback.deputy %> covered your approvals from <%= handback.from %> to <%= handback.through %>.
    <%= handback.rows.length?handback.decided+' were decided and '+handback.back+(handback.back===1?' is':' are')+' back with you.':'Nothing waited for them.' %></p>
  <% if(handback.rows.length){ %><ul>
    <% for(const r of handback.rows){ %><li><a href="<%= r.href %>"><%= r.title %></a> · <%= r.kind %> · <%= r.waiting?'Back with you':'Decided' %></li><% } %>
  </ul><% } %>
  <form method="post" action="/autopilot/vacation-deputy/hand-back"><input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <input type="hidden" name="revision" value="<%= handback.revision %>"><button class="btn btn--primary">I have reviewed this</button></form>
</section>
<% } %>
<form method="post" action="/autopilot/vacation-deputy">
  <input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="revision" value="<%= rule.revision %>">
  <label>Deputy <select required name="deputyId"><option value="">Choose a team member</option><% for(const p of people){ %><option value="<%= p.id %>" <%= p.id===rule.deputy_id?'selected':'' %>><%= p.name %></option><% } %></select></label>
  <label>First day <input type="date" required name="start" value="<%= rule.starts_on||today %>"></label>
  <label>Last day <input type="date" required name="end" value="<%= rule.ends_on||today %>"></label>
  <% if(people.length){ %><button class="btn">Save vacation coverage</button><% }else{ %><p>A deputy needs permission to approve purchases, transfers, returns, stock changes, refunds or landed costs across this inventory. <a href="/settings?section=team#team-authority">Review team access</a></p><% } %>
  <% if(rule.deputy_id){ %><button class="btn" name="remove" value="1" formnovalidate>End coverage</button><% } %>
</form><% } %>
<% if(result.countAssignments){ const config=result.countAssignments; %><form method="post" action="/warehouse/count-assignments">
<input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="requestKey" value="<%= config.requestKey %>">
<label>Warehouse, zone or bin <select name="locationId" required><% for(const loc of config.locations){ %><option value="<%= loc.id %>" <%= config.selectedLocationId===loc.id?'selected':'' %>><%= loc.name %></option><% } %></select></label>
<label>Person who counts <select name="counterId" required><% for(const p of config.people){ %><option value="<%= p.id %>"><%= p.name %></option><% } %></select></label>
<label>Stock scope <select name="stockScope"><option value="all">All stock, including lots, serials and measures</option><option value="quantity">Quantity-only stock</option></select></label>
<button class="btn">Assign one count</button>
<details><summary>Repeat this assignment</summary><p>StockChief assigns the next list when routine work is enabled and the previous worksheet has closed. Growth uses a completed manual count for the same counter and scope.</p>
<label>First count <input type="date" name="firstDay" value="<%= config.today %>"></label>
<label>Days between counts <input type="number" name="days" min="1" max="366" value="7"></label><button class="btn" formaction="/warehouse/count-schedules">Save schedule</button></details></form>
<% for(const schedule of config.schedules){ %><form method="post" action="/warehouse/count-schedules"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="locationId" value="<%= schedule.id %>">
<p><%= schedule.name %> · <%= schedule.counter %> · <%= schedule.includes_tracking?'All stock':'Quantity only' %> · every <%= schedule.interval_days %> days · next <%= schedule.due %></p>
<% if(schedule.last_issue){ %><p><%= schedule.last_issue %></p><% } %><button class="btn" name="remove" value="1">Stop scheduled count</button></form><% } } %>
<% if(result.purchaseThreshold){ const rule=result.purchaseThreshold; %><form method="post" action="/autopilot/purchase-approval-threshold">
<input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="revision" value="<%= rule.revision %>">
<label>Currency <input required name="currency" minlength="3" maxlength="3" placeholder="USD" value="<%= rule.currency||'' %>"></label>
<label>Amount above which two people must approve <input name="amount" inputmode="decimal" value="<%= rule.amount %>"></label>
<label>Hours before passing an unanswered request to the next eligible reviewer <input type="number" min="1" max="720" name="escalationHours" value="<%= rule.escalation_hours %>" required></label>
<p>Leave the amount empty to turn the rule off.</p><button class="btn">Save threshold</button></form><% } %>
<% if(result.watchSettings){ const w=result.watchSettings; %><form method="post" action="/autopilot/alert-settings/<%= w.job %>">
<input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="revision" value="<%= w.revision %>">
<% if(w.job===170){ %><label>Alert when a cost goes up by at least (%) <input name="costRisePct" type="number" min=".01" max="1000" step=".01" value="<%= w.cost_rise_pct??'' %>" placeholder="Any rise"></label>
<label>Alert below this gross margin (%) <input name="marginPct" type="number" min="0" max="100" step=".01" value="<%= w.margin_pct??'' %>"></label>
<p class="hint">Gross margin is the selling price or sales minus the cost of the goods, before fees and shipping.</p>
<% }else{ %><label>Alert on stock corrections of at least this many units <input type="number" min=".000001" step=".000001" name="adjustmentUnits" value="<%= w.adjustment_units??'' %>"></label>
<label>Alert on a selling price change of at least (%) <input type="number" min=".01" max="1000" step=".01" name="priceChangePct" value="<%= w.price_change_pct??'' %>"></label>
<label>Alert when one person makes this many changes or deletions in a day <input type="number" min="1" max="100000" step="1" name="editCount" value="<%= w.edit_count??'' %>"></label>
<label>Watch changes from local hour (0–23) <input type="number" min="0" max="23" name="nightFrom" value="<%= w.night_from??'' %>"></label>
<label>Until local hour (0–23) <input type="number" min="0" max="23" name="nightUntil" value="<%= w.night_until??'' %>"></label>
<p class="hint">Leave a box empty and StockChief alerts only when something is at least three times what is usual. Use the hours outside your business day.</p><% } %>
<button class="btn">Save alert settings</button></form><% } %>
<% if(result.watchRules){ %><%- include('watch-rules',{watchRules:result.watchRules,csrfToken}) %><% } %>
<% if(result.download){ %><p><a class="btn" href="<%= result.download %>"><%= result.downloadLabel %></a></p><% } %>
<% if(result.specForm){ %><form method="post" action="/autopilot/reviews/supplier-specifications/prepare">
<input type="hidden" name="_csrf" value="<%= csrfToken %>"><label>Approved supplier file <input required name="sourceImport" value="<%= filter %>"></label>
<label>File page <input type="number" name="sourcePage" min="1" value="<%= result.page||1 %>" required></label>
<label>Limit to one SKU (optional) <input name="sku"></label><button class="btn">Review missing fields</button></form><% } %>
<% if(result.purchaseGrouping){ %><form method="post" action="/autopilot/reviews/<%= result.purchaseGrouping %>/regroup"><input type="hidden" name="_csrf" value="<%= csrfToken %>">
<label><%= result.purchaseGrouping==='combine-draft-orders'?'Draft PO numbers, separated by commas':'Draft PO number' %> <input required name="sourceOrders"></label>
<% if(result.purchaseGrouping==='split-draft-orders'){ %><label>Split by <select name="splitStrategy"><option value="warehouse">Receiving warehouse</option><option value="budget">Value per order</option><option value="delivery-date">Delivery date</option></select></label>
<label>For a value split, maximum per order <input name="budgetAmount" inputmode="decimal"></label>
<label>For a date split, enter one line number and date per row <textarea name="lineDates" placeholder="1 2027-02-14"></textarea></label><% } %>
<button class="btn">Review replacement orders</button></form><% } %>
<% if(result.freightCombine){ %><%- include('freight-combine-rules',{model:result.freightCombine,trained:result.mode==='trained',csrfToken}) %><% } %>
<% if(result.purchaseSplits){ %><%- include('purchase-split-rules',{model:result.purchaseSplits,trained:result.mode==='trained',csrfToken}) %><% } %>
<% if(result.orderCheckSettings){ %>
<form method="post" action="/autopilot/reviews/sales-order-checks/settings"><input type="hidden" name="_csrf" value="<%= csrfToken %>">
<p>StockChief checks each new or changed order on its own and flags problems on the order and in Needs you. It never changes or cancels an order.</p>
<label>Flag discounts bigger than this share of the list price (%) <input type="number" name="discountPercent" min="1" max="100" step="0.01" required value="<%= result.orderCheckSettings.discountPercent %>"></label>
<button class="btn">Save discount limit</button></form>
<% } %>
<% if(result.overdueRule!==undefined){ %>
<% if(result.mode==='alone'||result.overdueRule){ %>
<form method="post" action="/autopilot/reviews/overdue-customer-orders/rule"><input type="hidden" name="_csrf" value="<%= csrfToken %>">
<p><%= result.overdueRuleText || 'Hold orders on their own for customers who are overdue, and release them when the overdue invoices are paid in full.' %> Holds happen while routine work is on; a held order cannot be picked or shipped.</p>
<label>Days overdue <input type="number" name="days" min="1" max="365" required placeholder="30" value="<%= result.overdueRule ? result.overdueRule.days_overdue : '' %>"></label>
<label>Only when the overdue amount is at least (optional) <input name="amount" inputmode="decimal" value="<%= result.overdueAmount %>"></label>
<button name="mode" value="on" class="btn"><%= result.overdueRule ? 'Save overdue rule' : 'Enable overdue-order holds' %></button>
<% if(result.overdueRule){ %><button name="mode" value="off" class="btn" formnovalidate>Turn off overdue-order holds</button><% } %></form>
<% } else { %><p>Automatic holds require Pro. <a href="/billing">Upgrade</a></p><% } %>
<% } %>
<% if(result.filterable){ %><form method="get"><label><%= result.filterLabel||"Filter by exact code, name or reference" %> <input name="filter" value="<%= filter %>" maxlength="150"></label><% if(result.requiresChange){ %><label><%= result.changeLabel||'Change in sales (%)' %> <input type="number" name="change" step="0.01" min="<%= result.minChange??-100 %>" max="<%= result.maxChange??1000 %>" value="<%= result.change??'' %>" required></label><% } %><button class="btn">Look up</button></form><% } %>
<% if(result.paymentRun?.digest){ const paymentRun=result.paymentRun; %>
  <section class="card card-body stack">
    <h2>Payment review</h2>
    <p><%= paymentRun.count %> supplier <%= paymentRun.count===1?'bill':'bills' %> in the current run. Use the individual bill links to pay suppliers and record payments.</p>
    <% if(paymentRun.approvedAt){ %><p role="status">Approved <%= helpers.dateTime(paymentRun.approvedAt) %></p>
    <% }else if(paymentRun.approvalHold){ %><p><%= paymentRun.approvalHold %></p>
    <% }else{ %><form method="post" action="/autopilot/reviews/payment-run/approve">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <input type="hidden" name="digest" value="<%= paymentRun.digest %>">
      <label><input type="checkbox" name="confirmed" value="yes" required> I reviewed all listed bills and discount terms.</label>
      <button class="btn btn--primary" type="submit">Approve this payment run</button>
    </form><% } %>
  </section>
<% } %>
<% if(result.activity){ %><%- include('agent-activity',{result,csrfToken}) %><% }else if(result.rows.length){const fields=Object.keys(result.rows[0]).filter(f=>!['link','linkLabel'].includes(f)); %><div class="card<%= result.paymentRun?' table-wrap':'' %>"><table><thead><tr><% fields.forEach(f=>{ %><th><%= f %></th><% }); %><% if(result.rows[0].link){ %><th>Record</th><% } %></tr></thead><tbody>
<% result.rows.forEach(r=>{ %><tr><% fields.forEach(f=>{ %><td><%= r[f]??'Unknown' %><% if(result.reviewPrices&&f==='Suggested selling price'){ %><form method="post" action="/autopilot/reviews/margin-prices/prepare"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="sku" value="<%= r.SKU %>"><button class="btn">Prepare price change</button></form><% } %></td><% }); %><% if(r.link){ %><td><a href="<%= r.link %>"><%= r.linkLabel||'Open' %></a></td><% } %></tr><% }); %>
</tbody></table></div><% }else if(!result.requiresChange||result.change){ %><p><%= result.bankMatchForm?'No completed matches in this view.':'No matching records.' %></p><% } %>
<% if(result.page>1){ %><a href="?page=<%= result.page-1 %>&amp;filter=<%= encodeURIComponent(filter) %><%= result.requiresChange?'&change='+encodeURIComponent(result.change||''):'' %>">Previous page</a><% } %>
<% if(result.more){ %><a href="?page=<%= result.page+1 %>&amp;filter=<%= encodeURIComponent(filter) %><%= result.requiresChange?'&change='+encodeURIComponent(result.change||''):'' %>">Next page</a><% } %>
<% if(result.escalations){ %><%- include('escalations',{escalations:result.escalations,csrfToken}) %><% } %>
<% if(result.alerts){ %><%- include('alert-delivery',{alerts:result.alerts,csrfToken}) %><% } %>
<% if(result.reportEmail){ %><%- include('report-email-delivery',{panel:result.reportEmail,csrfToken}) %><% } %>
