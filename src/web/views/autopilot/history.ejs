<%
  var sections = [
    { key: 'needsYou', label: 'Needs you', icon: 'hand' },
    { key: 'blocked', label: 'Stopped or failed', icon: 'alert' },
    { key: 'automatic', label: 'Handled automatically', icon: 'check' },
    { key: 'prepared', label: 'Approved by you, then handled', icon: 'check' }
  ];
  var anything = operations.length || evaluations.length || sections.some(function (section) { return groups[section.key].length; });
  var handledCount = groups.automatic.length + groups.prepared.length;
  var waitingCount = groups.needsYou.length + groups.blocked.length;
%>

<p class="rm-stamp">StockChief's work</p>
<h1 class="rm-figure"><%= waitingCount ? waitingCount + (waitingCount === 1 ? ' thing needs a closer look.' : ' things need a closer look.') : handledCount ? handledCount + (handledCount === 1 ? ' outcome recorded.' : ' outcomes recorded.') : anything ? 'Work is recorded below.' : 'Nothing to report yet.' %></h1>
<p class="rm-sub">Completed work and anything StockChief could not finish are here. Routine checks are kept below; <a href="/activity">Activity</a> holds the underlying business record.</p>
<p class="rm-choices"><a class="rm-btn rm-btn--ghost" href="/ask">Ask about this work</a><a class="rm-btn rm-btn--ghost" href="/needs-you">Open decisions</a></p>

<% if (!anything) { %>
  <p class="rm-quiet section">Once StockChief plans, completes or stops work, the outcome appears here. No work has been recorded yet.</p>
<% } %>

<% sections.forEach(function (section) { %>
  <% if (groups[section.key].length) { %>
    <section class="owner-outcomes section" aria-labelledby="outcome-<%= section.key %>">
      <div class="owner-outcomes__head"><h2 id="outcome-<%= section.key %>"><%= section.label %></h2><span><%= groups[section.key].length %></span></div>
      <div class="owner-outcomes__list">
        <% groups[section.key].forEach(function (item) { var described = describe(item); %>
          <a href="/autopilot/work/<%= item.id %>" class="owner-outcomes__row">
            <span class="owner-outcomes__icon <%= section.key === 'needsYou' || section.key === 'blocked' ? 'is-attention' : '' %>"><%- helpers.icon(section.icon, { size: 16 }) %></span>
            <span class="owner-outcomes__copy"><strong><%= described.headline %></strong><% if (described.detail) { %><small><%= described.detail %></small><% } %><% if (item.errorMessage) { %><small class="is-warn"><%= item.errorMessage %></small><% } %></span>
            <span class="owner-outcomes__when"><%= helpers.timeAgo(item.completedAt || item.createdAt) %></span>
            <%- helpers.icon('arrowRight', { size: 15 }) %>
          </a>
        <% }) %>
      </div>
    </section>
  <% } %>
<% }) %>

<% if (operations.length) { %>
  <%
    var outcomeLines = function (value) {
      return Object.entries(value || {}).map(function (entry) {
        return {
          label: entry[0].replace(/([A-Z])/g, ' $1').replaceAll('_', ' ').replace(/^./, function (letter) { return letter.toUpperCase(); }),
          value: Array.isArray(entry[1]) ? entry[1].join(', ') : (entry[1] && typeof entry[1] === 'object' ? 'Recorded in the evidence' : String(entry[1]))
        };
      });
    };
  %>
  <section class="section" id="operations">
    <details class="disclose" open>
      <summary>
        <span>Universal operations — <%= operations.length %> planned, running or verified</span>
        <span class="disclose__cue">Show</span>
      </summary>
      <div class="disclose__body">
        <ul class="plain-list">
          <% operations.forEach(function (operation) { %>
            <li id="operation-<%= operation.id %>">
              <strong><%= operation.title %></strong>
              <span class="badge <%= operation.status === 'COMPLETED' ? 'badge--success' : operation.status === 'NEEDS_HUMAN' ? 'badge--warning' : 'badge--muted' %>"><%= operation.status.toLowerCase().replaceAll('_', ' ') %></span>
              <% if (operation.summary) { %><div class="t-muted"><%= operation.summary %></div><% } %>
              <% if (outcomeLines(operation.expectedOutcome).length || outcomeLines(operation.actualOutcome).length) { %>
                <details class="disclose disclose--nested">
                  <summary><span>Expected and verified outcome</span><span class="disclose__cue">Show</span></summary>
                  <div class="disclose__body">
                    <% outcomeLines(operation.expectedOutcome).forEach(function (line) { %><div><strong>Expected · <%= line.label %>:</strong> <%= line.value %></div><% }) %>
                    <% outcomeLines(operation.actualOutcome).forEach(function (line) { %><div><strong>Result · <%= line.label %>:</strong> <%= line.value %></div><% }) %>
                  </div>
                </details>
              <% } %>
              <div class="t-muted t-xs"><%= helpers.timeAgo(operation.completedAt || operation.updatedAt) %></div>
            </li>
          <% }) %>
        </ul>
      </div>
    </details>
  </section>
<% } %>

<%
  /*
   * The routine checks, last and folded away.
   *
   * This page is called "What StockChief has done", and it opened with fifty
   * lines of "Scheduled inventory check — 10 stock positions checked. 7
   * positions lacked enough outbound history for safe demand action", each
   * identical to the last, above the four sections describing what StockChief
   * actually did. Somebody arriving from "StockChief handled — see everything"
   * scrolled past fifty repetitions of nothing happening.
   *
   * They are evidence that StockChief is alive and looking, which is worth
   * keeping and worth counting. It is not worth reading fifty times.
   */
%>
<% if (evaluations.length) { %>
  <section class="section" id="evaluations">
    <details class="disclose">
      <summary>
        <span>
          <%= evaluations.length %> inventory check<%= evaluations.length === 1 ? '' : 's' %>
          — completed evaluations, including the ones that correctly produced no action
        </span>
        <span class="disclose__cue">Show</span>
      </summary>
      <div class="disclose__body">
        <ul class="plain-list">
          <% evaluations.forEach(function (evaluation) { %>
            <li>
              <strong><%= evaluation.title %></strong>
              <span class="t-muted"> — <%= evaluation.detail %></span>
              <div class="t-muted t-xs"><%= helpers.timeAgo(evaluation.finishedAt) %></div>
            </li>
          <% }) %>
        </ul>
      </div>
    </details>
  </section>
<% } %>
