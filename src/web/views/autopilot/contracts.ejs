<h1>Contract prices, terms and dates</h1>
<p>Read the complete file and keep prices, conditions and end dates beside their source quotes. <%= ['starter','growth'].includes(screen.plan)?'Your plan gives suggested readings for your review.':'Your plan prepares the structured reading without training.' %> The owner still approves new or changed commercial terms before they are used.</p>
<section class="card card-body section"><h2>Read newly filed contracts automatically</h2><p>Pro and Custom can read originals already filed as contracts after the 14-day watch period, with your routine authority. Each complete reading costs 100 AI credits. A document already read from your mailbox is counted once. Prices, terms and financial records still need separate approval before use.</p>
<% if(screen.automation.problem){ %><p class="notice"><%= screen.automation.problem %></p><% } %>
<% if(screen.automaticAllowed){ %><form method="post" action="/autopilot/contracts/settings" class="form-stack"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="revision" value="<%= screen.automation.revision %>"><label><input required type="checkbox" name="confirmed" value="yes"> I authorize 100 AI credits per newly filed contract, within my plan balance, to prepare its complete reading. I still approve changed commercial terms separately.</label><button class="btn btn--primary"><%= screen.automation.enabled?'Renew my reading authority':'Enable automatic contract reading' %></button></form><% }else{ %><p><strong>Pro / Custom</strong> · Starter and Growth receive suggestions from individually submitted files. <a class="btn" href="/billing">Upgrade</a></p><% } %>
<% if(screen.automation.enabled){ %><form method="post" action="/autopilot/contracts/settings"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="revision" value="<%= screen.automation.revision %>"><button class="btn" name="stop" value="yes">Stop automatic contract reading</button></form><% } %></section>
<% if(!screen.record){ %>
<section class="card card-body"><h2>Read a contract</h2><p>100 AI credits and 1 document from your plan per complete file. A failed reading uses no AI credits. Upload a PDF, Word .docx, text, photo or scan up to 20 MB. PDFs support up to 100 pages; every page is checked.</p>
<form method="post" action="/autopilot/contracts" enctype="multipart/form-data" class="form-stack"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="requestKey" value="<%= screen.requestKey %>"><label>Original contract <input required type="file" name="contract" accept=".pdf,.docx,.txt,.csv,.tsv,.png,.jpg,.jpeg,.webp,.gif,.heic,.heif,.tif,.tiff"></label><button class="btn btn--primary">Save original and read contract</button></form></section>
<% }else{ const r=screen.record; %>
<section class="card card-body" style="overflow-wrap:anywhere"><h2><%= r.filename %></h2><p><a class="btn" href="/autopilot/contracts/<%= r.id %>/original">Download saved original</a> <a href="/autopilot/contracts">All contract readings</a></p><p role="status" id="contract-status"><%= r.status==='READY'?'Complete reading ready':r.status==='FAILED'?'Reading stopped':r.status==='RUNNING'?'Reading every source section':'Original saved — waiting to read' %></p>
<% if(r.status==='READY'){ %><p><strong>AI credits used: <%= r.credits_used %></strong> · <%= r.source_pages.length %> source page<%= r.source_pages.length===1?'':'s' %> · <%= r.extracted_facts.length %> sourced facts</p><p><%= r.reading_mode==='suggest'?'Suggested readings — compare the exact quotes and conditions before using them.':'Structured reading prepared without training.' %> Conflicting or unclear terms need your review.</p><% } %>
<% if(r.problem||r.last_error){ %><p class="notice"><%= r.problem||r.last_error.message %></p><% } %>
<% if(r.job_status==='DEAD'&&r.status!=='READY'){ %><form method="post" action="/autopilot/contracts/<%= r.id %>/retry"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="btn">Retry the saved contract</button></form><% } %>
</section>
<% if(r.status==='READY'){ %>
<% if(r.issues.length){ %><section class="card card-body"><h2>Needs your review</h2><% for(const issue of r.issues){ %><p>Page <%= issue.page %>: <%= issue.text %></p><% } %></section><% } %>
<% for(const [index,fact]of r.extracted_facts.entries()){ %><article class="card card-body section" style="overflow-wrap:anywhere"><h2><%= contractLabels[fact.kind] %><% if(fact.uncertain){ %> · Check this reading<% } %></h2><% if(fact.subject){ %><p><strong><%= fact.subject %></strong></p><% } %><p><%= fact.value %></p><% if(fact.unconfirmedSubject){ %><p class="notice">Unconfirmed product or party label: <%= fact.unconfirmedSubject %>. Check this against the original.</p><% } %><% if(fact.note){ %><p class="notice"><%= fact.note %></p><% } %><blockquote style="white-space:pre-wrap;margin:1rem 0;border-left:3px solid #cbd5e1;padding-left:1rem"><%= fact.quote %></blockquote><p><a href="#contract-page-<%= fact.page %>">Source page / section <%= fact.page %></a> · Fact <%= index+1 %></p></article><% } %>
<section class="card card-body"><h2>Complete readable source</h2><p>Keep the saved original as the authority. Scanned text may contain reading errors; compare unclear characters with the original file.</p><% for(const page of r.source_pages){ %><details id="contract-page-<%= page.page %>"><summary>Page / section <%= page.page %></summary><pre style="white-space:pre-wrap;overflow-wrap:anywhere;font:inherit"><%= page.text %></pre></details><% } %></section>
<% } %>
<% if(['QUEUED','RUNNING'].includes(r.status)&&!['DEAD','PAUSED'].includes(r.job_status)){ %><script>(function(){let timer;async function poll(){try{const response=await fetch(location.pathname+'/status',{headers:{accept:'application/json'}});if(!response.ok)return;const state=await response.json();if(state.status==='READY'||state.status==='FAILED'||['DEAD','PAUSED'].includes(state.jobStatus)){location.reload();return;}document.getElementById('contract-status').textContent=state.status==='RUNNING'?'Reading every source section':'Original saved — waiting to read';}catch(e){}timer=setTimeout(poll,2000);}timer=setTimeout(poll,2000);addEventListener('pagehide',()=>clearTimeout(timer),{once:true});})();</script><% } %>
<% } %>
<section class="card card-body section"><h2>Saved contract readings</h2><% if(!screen.rows.length){ %><p>No contract files saved yet.</p><% } %><% for(const r of screen.rows){ %><p style="overflow-wrap:anywhere"><a href="/autopilot/contracts/<%= r.id %>"><%= r.filename %></a> · <%= r.status==='READY'?'Ready':r.status==='FAILED'?'Needs review':'Reading pending' %> · <%= r.credits_used %> AI credits</p><% } %><% if(screen.more){ %><p><a class="btn" href="/autopilot/contracts?page=<%= screen.page+1 %>">Next contracts</a></p><% } %></section>
