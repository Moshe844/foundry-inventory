<h1>Team procedures</h1><p>Write step-by-step app instructions from completed receiving, dispatch or count workflows. Source notes are not treated as instructions. Every version for staff requires a separate owner review.</p>
<% if(locked){ %><section class="card"><h2><span class="badge">Growth</span> Write from recorded workflows</h2><p>Growth prepares a draft for your approval. Pro and Custom can keep private drafts current without training, within your chosen scope.</p><a class="btn" href="/settings/billing">Upgrade</a></section><% }else{ %>
<% if(shadow){ %><p class="notice">Your first 14 days are Watch only. Preview recorded work here; saving agent drafts and publishing them wait until the watch period ends.</p><% } %>
<section class="card"><h2>Choose recorded examples</h2><form method="post" action="/autopilot/team-procedures/preview" class="form-stack"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><label class="rm-field"><span>Recorded workflow</span><select name="kind" required><option value="">Choose workflow</option><% for(const [key,label]of Object.entries(kinds)){ %><option value="<%= key %>" <%= draft?.scope.kind===key?'selected':'' %>><%= label %></option><% } %></select></label><label class="rm-field"><span>Warehouse or stock location</span><select name="locationId" required><option value="">Choose location</option><% for(const location of locations){ %><option value="<%= location.id %>" <%= draft?.scope.locationId===location.id?'selected':'' %>><%= location.name %></option><% } %></select></label><label class="rm-field"><span>Look back this many days</span><input name="lookbackDays" type="number" min="1" max="3650" value="<%= draft?.scope.lookbackDays||'' %>" required></label><p>Only the recorded activity history included in your plan is used. The draft uses up to 100 verified examples. Receipt and dispatch checks use up to 1,000 recent records.</p><button class="btn">Prepare procedure preview</button></form></section>
<% if(draft){ %><section class="card"><p>Based on <%= draft.examples.length %> completed examples at <%= draft.location.name %>, recorded between <%= helpers.dateTime(draft.from) %> and <%= helpers.dateTime(draft.to) %>.<%= draft.more?' The latest 100 verified examples are used.':'' %></p><%- include('team-procedure-body',{doc:draft.document}) %><form method="post" action="/autopilot/team-procedures" class="form-stack"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="kind" value="<%= draft.scope.kind %>"><input type="hidden" name="locationId" value="<%= draft.scope.locationId %>"><input type="hidden" name="lookbackDays" value="<%= draft.scope.lookbackDays %>"><input type="hidden" name="revision" value="<%= draft.revision %>"><input type="hidden" name="sourceFingerprint" value="<%= draft.sourceFingerprint %>"><label><input type="checkbox" name="confirmed" value="yes" required> I checked this exact app procedure against its recorded examples and approve saving it as a private draft.</label><button class="btn" <%= shadow?'disabled':'' %>>Save reviewed private procedure</button></form></section><% } %><% } %>
<% if(rows.length){ %><section class="card"><h2>Saved procedures</h2><% for(const p of rows){ %><article><h3><% if(!locked){ %><a href="/autopilot/team-procedures/<%= p.id %>"><%= kinds[p.kind] %> at <%= p.location_name %></a><% }else{ %><%= kinds[p.kind] %> at <%= p.location_name %><% } %></h3><p><%= p.enabled?(routineIncluded?'Private draft updates enabled':'Private draft updates paused on this plan'):'Private draft updates stopped' %> · <%= p.publication_id?(locked?'An owner-approved version is saved; staff access is paused on this plan':'An owner-approved version is available to staff'):'Private drafts only' %>. <%= p.last_issue||'' %></p><% if(p.enabled){ %><form method="post" action="/autopilot/team-procedures/<%= p.id %>/settings"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="revision" value="<%= p.revision %>"><button class="btn" name="stop" value="yes">Stop private procedure updates</button></form><% } %><% if(p.publication_id){ %><form method="post" action="/autopilot/team-procedures/<%= p.id %>/unpublish"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="expectedPublicationId" value="<%= p.publication_id %>"><label><input type="checkbox" name="confirmed" value="yes" required> I confirm removing the current version from staff view.</label><button class="btn">Remove from staff view</button></form><% } %></article><% } %></section><% } %>
<nav aria-label="Saved procedure pages"><% if(page>1){ %><a href="/autopilot/team-procedures?page=<%= page-1 %>">Previous procedures</a><% } %> <% if(more){ %><a href="/autopilot/team-procedures?page=<%= page+1 %>">Next procedures</a><% } %></nav><p>AI credits used: 0.</p>
