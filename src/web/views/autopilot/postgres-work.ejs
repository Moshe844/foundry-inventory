<% const ongoing=item.source==='postgres_workflow_owner'||item.execution_status==='EXECUTING'||item.outcome?.nextAction||item.execution_status==='FAILED'&&(item.outcome?.purchaseOrderId||item.outcome?.transferId); %>
<% if(ongoing){ const outcome=item.outcome||{},decision=outcome.decision; %>
<div class="rm-head"><div class="rm-title"><div><p class="rm-stamp">StockChief is following this work</p><h1><%= outcome.reference||item.recommendedAction.displayName||'Business workflow' %></h1><p class="rm-prose"><%= outcome.requestedOutcome||item.recommendedAction.title||'Follow the linked business record through completion.' %></p></div></div></div>
<section class="card"><div class="card-head"><h2><%= item.execution_status==='COMPLETED'?'Outcome verified':item.execution_status==='CANCELLED'?'Cancelled':item.execution_status==='FAILED'?'Needs a delivery check':'In progress' %></h2></div><div class="card-body">
<p><strong><%= item.error_message||outcome.nextAction||'Checking the saved business records.' %></strong></p>
<% if(outcome.lastCheckedAt){ %><p>Last checked <time data-local-time datetime="<%= outcome.lastCheckedAt %>"><%= helpers.dateTime(outcome.lastCheckedAt) %></time>.</p><% } %>
<% if(outcome.nextCheckAt){ %><p>Next check <time data-local-time datetime="<%= outcome.nextCheckAt %>"><%= helpers.dateTime(outcome.nextCheckAt) %></time>.</p><% } %>
<% if(outcome.deadline){ %><p>Decision or expected event due <time data-local-time datetime="<%= outcome.deadline %>"><%= helpers.dateTime(outcome.deadline) %></time>.</p><% } %>
<% if(decision){ %><div class="notice notice--warn"><div><h3><%= decision.happened %></h3><p><%= decision.impact %></p><p><%= decision.recommendation %></p><p><strong>Your decision:</strong> <%= decision.required %></p></div></div><h3>Already checked</h3><ul><% for(const check of decision.checked||[]){ %><li><%= check %></li><% } %></ul><% if(decision.alternatives?.length){ %><h3>Alternatives</h3><ul><% for(const choice of decision.alternatives){ %><li><%= choice %></li><% } %></ul><% } %><% } %>
<p><a class="btn btn--primary" href="<%= outcome.reviewHref||outcome.href||item.recommendedAction.href||(item.outcome?.transferId?'/transfers/'+item.outcome.transferId:item.outcome?.purchaseOrderId?'/purchasing/orders/'+item.outcome.purchaseOrderId:'/needs-you') %>">Open the linked record</a></p>
<p class="muted">Approval, an email or a supplier invoice does not confirm physical receipt, delivery or payment. Those outcomes are checked against their own records.</p>
</div></section>
<% } else { const action=item.recommendedAction,transfer=action.type==='transfer',waiting=item.execution_status==='WAITING_FOR_APPROVAL',statusWord=String(item.execution_status).replaceAll('_',' ').toLowerCase().replace(/^./,c=>c.toUpperCase()),chooseWhere=action.quantityScope==='workspace'&&!action.destinationLocationId,facts=item.sourceEvidence||[],fact=name=>facts.find(e=>e.fact===name)?.value,available=fact('available'),incoming=fact('incoming')??action.incoming,reorderPoint=fact('reorder_point')??action.reorderPoint,priced=action.value!==null&&action.value!==undefined; %>
<div class="aw">
<header class="aw-head"><p class="aw-kicker"><span class="level-label" data-tone="<%= item.urgency==='immediate'?'urgent':'normal' %>"><%= item.approval_requirement==='NONE'?'Automatic decision':statusWord %></span></p>
  <h1><%= transfer?'Move':'Order' %> <%= helpers.unitCount(action.quantity,'unit') %> of <%= action.displayName %></h1>
  <p><%= transfer?'Move '+helpers.unitCount(action.quantity,'unit')+' from '+action.sourceLocationName+' to '+action.destinationLocationName+'.':'From '+action.supplierName+'.' %></p></header>
<div class="aw-cols"><div class="aw-main">
  <section class="card aw-card"><h2>Why StockChief suggests this</h2>
    <p class="aw-lead"><% if(transfer){ %><%= action.destinationLocationName %> has <%= action.destinationAvailable %> available against a reorder point of <%= action.reorderPoint %>. <%= action.sourceLocationName %> has <%= action.sourceAvailable %> available and keeps <%= action.sourceSafety %> protected, so moving stock avoids buying more.<% }else if(available!==undefined&&reorderPoint!==undefined){ %><%= Number(available)<=0?'Nothing is available':available+' available' %><%= Number(incoming)>0?' and '+incoming+' on the way':Number(incoming)===0?', and nothing is on the way':'' %>. Your reorder point is <%= reorderPoint %>.<% }else{ %><%= action.reason||'This product reached its reorder point.' %><% } %></p>
    <% if(facts.length){ %><div class="aw-facts"><% for(const entry of facts){ %><div><span><%= helpers.columnLabel(entry.fact) %></span><strong><%= entry.value %></strong></div><% } %></div><% } %>
  </section>
  <section class="card aw-card"><h2>What happens when you approve</h2>
    <dl class="aw-list"><% if(transfer){ %><div><dt>Move</dt><dd><%= helpers.unitCount(action.quantity,'unit') %></dd></div><div><dt>From</dt><dd><%= action.sourceLocationName %></dd></div><div><dt>To</dt><dd><%= action.destinationLocationName %></dd></div><div><dt>Stock</dt><dd>Stays at the source until the warehouse confirms it left.</dd></div>
    <% }else{ %><div><dt>Supplier</dt><dd><%= action.supplierName %></dd></div><div><dt>Quantity</dt><dd><%= helpers.unitCount(action.quantity,'unit') %><% if(Number(action.unitsPerPurchaseUnit)>1){ %> (<%= action.purchaseUnits %> packs of <%= action.unitsPerPurchaseUnit %>)<% } %></dd></div><div><dt>Deliver to</dt><dd><%= chooseWhere?'The location you choose':action.destinationLocationName %></dd></div><div><dt>Cost</dt><dd><% if(priced){ %><%= helpers.money(Math.round(action.value*100),action.currency) %><% }else{ %><span class="aw-warn">No confirmed price yet.</span> The order is created without one, so check it with the supplier.<% } %></dd></div><div><dt>Result</dt><dd>A purchase order is created and tracked. Stock changes only when it is received.</dd></div><% } %></dl>
    <% if(item.outcome?.verified){ %><div class="notice notice--success"><div><strong><%= item.outcome.kind==='transfer'?'Prepared, authorized, and reserved.':'Executed and verified.' %></strong><p><%= item.outcome.kind==='transfer'?'The stock remains at the source until the warehouse confirms physical dispatch.':item.outcome.poNumber+' is approved and traceable to this decision.' %></p><% if(item.outcome.transferId){ %><p><a class="btn btn--primary" href="/transfers/<%= item.outcome.transferId %>">Continue <%= item.outcome.transferNumber %></a></p><% } %></div></div><% } %>
  </section>
</div>
<aside class="aw-side"><section class="card aw-card aw-decision"><h2><%= waiting?'Your decision':'Status' %></h2>
  <p class="aw-why"><%= waiting?(item.policyEvaluation.reason||'Your settings ask for approval first.'):statusWord+'.' %></p>
  <% if(waiting&&locals.approvalBlock){ %><div class="notice notice--warn"><div><strong>Fix this before approving</strong><p><%= approvalBlock.reason %></p></div></div><a class="btn btn--primary aw-fix" href="<%= approvalBlock.href %>"><%= approvalBlock.label %></a><% }else if(waiting){ %><form class="aw-approve" method="post" action="/autopilot/work/<%= item.id %>/approve"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><% if(chooseWhere){ %><label>Where should this delivery arrive?<select name="destinationLocationId" required><option value="">Choose a receiving location</option><% for(const place of action.receivingOptions||[]){ %><option value="<%= place.id %>"><%= place.name %></option><% } %></select></label><% } %><button class="btn btn--primary"><%= transfer?'Approve transfer':'Send to supplier' %></button></form><% } %>
  <% if(waiting){ %><form method="post" action="/autopilot/work/<%= item.id %>/cancel"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="btn btn--ghost aw-discard">Discard</button></form>
  <p class="aw-note">Nothing happens until you approve.</p><% } %>
</section></aside></div>
</div>
<% } %>
