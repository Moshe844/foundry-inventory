<% const base='/autopilot/supplier-forecasts',stamp=v=>helpers.dateTime(v); %>
<div class="page-head"><div class="titles"><h1>Supplier forecasts</h1>
<p>Each week StockChief sends your key suppliers your stock and a 12-week forecast of the products you buy from them, from your mailbox. Only that supplier’s own products are in it. No prices, costs or customers.</p></div></div>

<% if(locals.upgrading){ %><p class="notice notice--info">Supplier forecasts are being upgraded. Check back shortly.</p><% }else{ %>
<% if(paused){ %><p class="notice notice--warn">StockChief is paused. It prepares and sends nothing until you resume it.</p>
<% }else if(shadow){ %><p class="notice notice--info">StockChief is watching during your first 14 days. It prepares the forecasts and sends nothing.</p>
<% }else if(who.mode==='watch'){ %><p class="notice notice--info"><%= who.reason %> It keeps the forecasts and sends nothing.</p>
<% }else if(who.mode==='ask'){ %><p class="notice notice--info">StockChief keeps each forecast ready. You press send.<% if(alone){ %> <a href="/autopilot/job-modes">Change this job’s mode</a><% } %></p>
<% }else{ %><p class="notice notice--ok">StockChief sends each forecast on its own. You check the first one to each supplier.</p><% } %>
<% if(sender.problem){ %><p class="notice notice--warn"><%= sender.reason %></p><% } %>

<% if(chosen){ const p=chosen.snapshot; %>
<section class="card section" id="forecast"><h2><%= p.supplierName %> · week of <%= chosen.week_start %></h2>
<p class="cell-sub">To <strong><%= chosen.recipient||'no email on file' %></strong> · prepared <%= stamp(p.preparedAt) %></p>
<div class="table-scroll"><table><thead><tr><th>Product</th><th>Stock on hand</th><th>Next 12 weeks</th></tr></thead><tbody>
<% p.rows.forEach(row=>{ %><tr><td><%= row.name %><small style="display:block"><%= row.sku %></small></td><td><%= row.onHand %> <%= row.unit %><%= row.needsReview?' · includes a negative stock record':'' %></td>
<td><%= row.total===null?'Not enough sales history yet':row.total+' '+row.unit %><% if(row.method){ %><small style="display:block"><%= row.method %></small><% } %></td></tr><% }) %>
</tbody></table></div>
<% if(chosenWords){ %><details><summary>Read the exact email</summary><p>Subject: <%= chosenWords.subject %></p><div style="white-space:pre-wrap;overflow-wrap:anywhere;font-size:13px;line-height:1.6"><%= chosenWords.body %></div></details><% } %>
<% const v=chosen.view||{}; if(v.label){ %><p><span class="badge badge--<%= v.tone %>"><%= v.label %></span> <%= v.detail||'' %></p><% } %>
<% if((v.send||v.retry)&&!paused&&who.mode!=='watch'){ %><form method="post" action="<%= base %>/<%= chosen.id %>/send"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="fingerprint" value="<%= chosen.source_fingerprint %>"><button class="btn btn--primary"><%= v.retry?'Send again':'Send this forecast' %></button></form><% } %>
<p><a href="<%= base %>">All supplier forecasts</a></p>
</section>
<% } %>

<section class="card section" id="this-week"><h2>This week · from <%= week %></h2>
<% if(!reports.length){ %><p class="cell-sub"><%= rules.length?'Nothing prepared yet this week. StockChief prepares them at its next check, or prepare them now.':'Choose a key supplier below to start.' %></p><% }else{ %>
<ul class="rm-list"><% reports.forEach(r=>{ %><li class="list-row"><span><strong><%= r.snapshot.supplierName %></strong> <span class="badge badge--<%= r.view.tone %>"><%= r.view.label %></span>
<small><%= r.snapshot.rows.length %> product<%= r.snapshot.rows.length===1?'':'s' %><%= r.queued_at&&r.status==='QUEUED'?' · '+stamp(r.queued_at):'' %></small>
<% if(r.view.detail){ %><small><%= r.view.detail %></small><% } %></span>
<span class="sc-row-actions"><a class="btn btn--ghost btn--sm" href="<%= base %>/<%= r.id %>">Open</a>
<% if((r.view.send||r.view.retry)&&!paused&&who.mode!=='watch'){ %><form method="post" action="<%= base %>/<%= r.id %>/send"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="fingerprint" value="<%= r.source_fingerprint %>"><button class="btn btn--primary btn--sm"><%= r.view.retry?'Send again':'Send' %></button></form><% } %></span></li><% }) %></ul>
<% } %>
<% if(waiting>1&&!paused&&who.mode!=='watch'){ %><form method="post" action="<%= base %>/send-all"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="btn btn--primary">Send all <%= waiting %> ready forecasts</button></form><% } %>
<% if(rules.length&&!paused){ %><form method="post" action="<%= base %>/prepare"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="btn btn--ghost">Prepare this week’s forecasts now</button></form><% } %>
</section>

<section class="card section" id="key-suppliers"><h2>Key suppliers</h2>
<% if(!rules.length){ %><p class="cell-sub">No key suppliers yet.</p><% }else{ %>
<ul class="rm-list"><% rules.forEach(r=>{ %><li class="list-row"><span><strong><%= r.name %></strong><small><%= r.email||'No email on file' %></small></span>
<span class="sc-row-actions"><form method="post" action="<%= base %>/key/<%= r.id %>/remove"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="revision" value="<%= r.revision %>"><button class="btn btn--ghost btn--sm" aria-label="Stop weekly forecasts to <%= r.name %>">Stop</button></form></span></li><% }) %></ul>
<% } %>
<form method="get" action="<%= base %>" class="form-stack"><label class="rm-field"><span>Find a supplier</span><input name="q" value="<%= q %>" maxlength="120"></label><button class="btn">Search suppliers</button></form>
<% if(moreSuppliers){ %><p class="cell-sub">Showing 50 suppliers. Search to find yours.</p><% } %>
<% if(suppliers.length){ %><form method="post" action="<%= base %>/key" class="form-stack"><input type="hidden" name="_csrf" value="<%= csrfToken %>">
<label class="rm-field"><span>Add a key supplier</span><select name="supplierId" aria-label="Add a key supplier" required><% suppliers.forEach(s=>{ %><option value="<%= s.id %>"><%= s.name %><%= s.email?'':' · no email yet' %></option><% }) %></select></label>
<button class="btn btn--primary">Add key supplier</button></form><% } %>
<p class="cell-sub">Each key supplier counts as one of your saved rules. Their forecast goes to the email on their supplier record.</p>
</section>

<section class="card section" id="forecast-mailbox"><h2>Sending mailbox</h2>
<% if(!sender.boxes.length){ %><p class="cell-sub">No mailbox is connected. <a href="/connections">Connect your mailbox</a></p>
<% }else{ %><p class="cell-sub"><%= sender.box?'Forecasts are sent from '+(sender.box.display_name||sender.box.provider_account_name)+'.':'Choose the mailbox forecasts are sent from.' %></p>
<% if(sender.boxes.length>1||!sender.box){ %><form method="post" action="<%= base %>/mailbox" class="form-stack"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="revision" value="<%= setting?.revision||0 %>">
<label class="rm-field"><span>Mailbox</span><select name="connectorId" aria-label="Mailbox"><% sender.boxes.forEach(b=>{ %><option value="<%= b.id %>" <%= sender.box&&sender.box.id===b.id?'selected':'' %>><%= b.display_name||b.provider_account_name %></option><% }) %></select></label>
<button class="btn btn--primary">Save mailbox</button></form><% } %><% } %>
</section>
<% } %>
