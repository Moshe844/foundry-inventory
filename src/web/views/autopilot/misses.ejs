<div class="page-head"><div class="titles"><h1>Ask miss reports</h1><p class="page-sub">Keep the exact request, actual response and missing requirement together. Reviewed does not mean fixed or verified.</p></div></div>
<section class="card section"><div class="card-head"><h2>Report a miss</h2></div><div class="card-body"><form method="post" action="/autopilot/misses"><input type="hidden" name="_csrf" value="<%= csrfToken %>">
<label class="rm-field"><span>Exact question you asked</span><textarea name="question" required maxlength="4000" rows="2"></textarea></label>
<label class="rm-field"><span>What actually happened</span><textarea name="actualBehavior" required maxlength="4000" rows="2"></textarea></label>
<label class="rm-field"><span>What should have happened</span><textarea name="expectedBehavior" required maxlength="4000" rows="2"></textarea></label>
<button class="btn btn--primary" type="submit">Save miss report</button></form></div></section>
<% reports.forEach(function (report) { %><section class="card section" aria-label="Miss report"><div class="card-head"><h2><%= report.status %> · <%= report.created_at %></h2></div><div class="card-body"><dl><dt>Question</dt><dd><%= report.question %></dd><dt>Actual behavior</dt><dd><%= report.actual_behavior %></dd><dt>Expected behavior</dt><dd><%= report.expected_behavior %></dd></dl><p><%= report.intent_id ? 'Linked to the recorded Ask request.' : 'No matching recorded Ask request was found for your user. This is an unlinked report, not verified execution evidence.' %></p><% if (report.review_note) { %><p>Review: <%= report.review_note %></p><% } %><% if (canReview) { %><form method="post" action="/autopilot/misses/<%= report.id %>/review"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><label class="rm-field"><span>Review and next fix</span><textarea name="note" required maxlength="4000" rows="2"></textarea></label><button class="btn" type="submit">Save review</button></form><% } %><p>A developer must implement a safe rule or code fix and add a passing regression test before this can be counted as closed. No execution rules are learned silently from this report.</p></div></section><% }) %>
