<% const f=result.invoiceDisputeForm; %>
<% if(f.intakes?.length){ %>
<section class="card"><h2>Saved invoices with differences</h2>
<ul><% for(const source of f.intakes){ %><li>
  <a href="/autopilot/supplier-invoices/<%= source.id %>"><%= source.invoice_number %></a> · <%= source.supplier %>
  <% if(source.problem){ %><p><%= source.problem %></p><% } %>
  <% if(!f.blocked){ %><form method="post" action="/autopilot/supplier-disputes/source/<%= source.id %>">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="confirmed" value="yes">
    <input type="hidden" name="revision" value="<%= source.revision %>"><button class="btn secondary">Open dispute review</button>
  </form><% } %>
</li><% } %></ul></section>
<% } %>
<section class="card"><h2>Review a supplier message</h2>
<% if(f.blocked){ %><p class="notice"><%= f.blocked %></p><% } %>
<% if(!f.mailboxes.length){ %><p><a href="/settings/connections">Connect a sending mailbox</a> to prepare supplier messages.</p><% }else{ %>
<form method="post" action="/autopilot/supplier-disputes/prepare" class="form-stack"><input type="hidden" name="_csrf" value="<%= csrfToken %>">
<label>Bill reference <input name="billNumber" required maxlength="150"></label>
<label>Send from <select name="connectorId" required><% for(const m of f.mailboxes){ %><option value="<%= m.id %>"><%= m.display_name %></option><% } %></select></label>
<button class="btn" <%= f.blocked?'disabled':'' %>>Prepare for approval</button></form><% } %>
<p>Once you approve a fully matched original and the mailbox confirms sending, you can teach a supplier, product and invoice-value limit from that completed message.</p>
<p><a href="/autopilot/job-modes">Review job authority</a></p></section>
<section class="card"><h2>Your dispute limit</h2>
<p><%= f.rulePlan==='pro'?'Saving a limit teaches StockChief to send disputes on its own when the amount in question is at most this much.':'StockChief sends disputes on its own when the amount in question is at most this much.' %> Larger or unclear disputes, and any supplier reply, wait for you.</p>
<% if(f.rule){ %><p><%= f.rule.enabled?'On':'Stopped' %> · <%= f.rule.maximum %> <%= f.rule.currency %> · reminder after <%= f.rule.reminderDays %> days, up to <%= f.rule.reminderLimit %></p><% } %>
<% if(!f.ruleCurrency){ %><p>Set up the accounting currency first.</p><% }else{ %>
<form method="post" action="/autopilot/supplier-disputes/settings" class="form-stack"><input type="hidden" name="_csrf" value="<%= csrfToken %>">
<input type="hidden" name="revision" value="<%= f.ruleRevision %>">
<label>Largest amount in question (<%= f.ruleCurrency %>) <input name="maximum" inputmode="decimal" required value="<%= f.rule?.maximum||'' %>"></label>
<label>Remind the supplier after (days) <input name="reminderDays" inputmode="numeric" required value="<%= f.rule?.reminderDays??f.defaults.reminderDays %>"></label>
<label>Reminders before it waits for you <input name="reminderLimit" inputmode="numeric" required value="<%= f.rule?.reminderLimit??f.defaults.reminderLimit %>"></label>
<label><input type="checkbox" name="confirmed" value="yes" required> Send disputes and reminders on my behalf within this limit.</label>
<button class="btn">Save dispute limit</button></form>
<% if(f.rule?.enabled){ %><form method="post" action="/autopilot/supplier-disputes/settings"><input type="hidden" name="_csrf" value="<%= csrfToken %>">
<input type="hidden" name="revision" value="<%= f.ruleRevision %>"><button class="btn secondary" name="stop" value="yes">Stop dispute limit</button></form><% } %>
<% } %></section>
