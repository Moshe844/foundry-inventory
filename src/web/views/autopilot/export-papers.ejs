<p><a href="<%= packet?'/autopilot/export-papers':'/autopilot/reviews' %>">← Back to <%= packet?'International paperwork':'Agent reviews' %></a></p>
<h1>International paperwork</h1><p>For each packed international shipment, StockChief prepares the commercial invoice, packing list and customs declaration from the packed goods and your confirmed trade facts. Pro and Custom prepare them on their own; Growth asks you first. If an HS code, origin, weight, value or currency is missing or does not match, it stops and asks. It does not classify products, file customs forms or buy international postage.</p>
<% if(!allowed){ %><p class="notice"><strong>Growth / Pro / Custom</strong> · Export packet preparation is locked. Saved copies remain available to the inventory owner. <a class="btn" href="/billing">Upgrade</a></p><% } %>
<% if(packet){ const s=packet.source_snapshot; %>
<section class="card"><div class="card-body"><h2><%= s.shipmentNumber %> · <%= packet.status==='REVIEWED'?'Owner-reviewed packet':packet.status==='STOPPED'?'Stopped draft':'Private draft' %></h2>
<p><%= s.exporter.name %> → <%= s.to.name %> · <%= s.from.country %> to <%= s.to.country %> · Prepared <%= s.preparedDate %></p><p><%= s.lines.length %> product lines · <%= s.boxes.length %> measured parcels · Net goods <%= helpers.money(s.totals.goodsNetMinor,s.currency) %></p>
<p><a class="btn" href="/autopilot/export-papers/<%= packet.id %>/file">Download saved <%= packet.status==='REVIEWED'?'reviewed copy':'draft PDF' %></a> <a href="/fulfilment/<%= packet.shipment_id %>">Open shipment</a></p>
<% if(changed){ %><p class="notice"><%= changed %> The download preserves the historical saved copy.</p><% } %>
<div class="table-wrap"><table><thead><tr><th>SKU</th><th>Goods</th><th>Quantity</th><th>HS</th><th>Origin</th><th>Net goods</th></tr></thead><tbody><% s.lines.forEach(l=>{ %><tr><td><%= l.sku %></td><td><%= l.description %></td><td><%= l.quantity %> <%= l.unit %></td><td><%= l.hsCode %></td><td><%= l.originCountry %></td><td><%= helpers.money(l.goodsNetMinor,s.currency) %></td></tr><% }) %></tbody></table></div>
<% if(packet.status==='DRAFT'){ %><% if(blocked){ %><p class="notice"><%= blocked %></p><% } %>
<form method="post" action="/autopilot/export-papers/<%= packet.id %>/review" class="form-stack"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="revision" value="<%= packet.revision %>"><input type="hidden" name="sourceHash" value="<%= packet.source_hash %>"><label><input type="checkbox" name="confirmed" value="yes" required <%= blocked||changed?'disabled':'' %>> I reviewed the exact goods, values, weights, classification, origin and destination requirements.</label><button class="btn btn--primary" <%= blocked||changed?'disabled':'' %>>Record my packet review</button></form>
<form method="post" action="/autopilot/export-papers/<%= packet.id %>/stop"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="revision" value="<%= packet.revision %>"><label><input type="checkbox" required name="confirmed" value="yes"> Stop this unreviewed draft; retain its saved copy.</label><button class="btn">Stop draft</button></form><% } %>
</div></section><% } %>
<% if(allowed&&!packet){ %>
<% if(held.length){ %><section class="card"><div class="card-body"><h2>Waiting for your facts</h2><ul><% held.forEach(h=>{ %><li><a href="/fulfilment/<%= h.shipment_id %>"><%= h.shipment_number %></a> · <%= h.reason %><% if(h.sku){ %> <a href="/autopilot/export-papers?sku=<%= encodeURIComponent(h.sku) %>#trade-facts">Confirm <%= h.sku %></a><% } %></li><% }) %></ul></div></section><% } %>
<section class="card"><div class="card-body"><h2>Prepare a shipment packet</h2><% if(blocked){ %><p><%= blocked %></p><% }else{ %><form method="post" action="/autopilot/export-papers/prepare" class="form-stack"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><label>Shipment number<input required name="shipmentReference" maxlength="150"></label><button class="btn btn--primary">Prepare export packet</button></form><% } %></div></section>
<section class="card"><div class="card-body"><h2>Confirmed exporter facts</h2><p>The legal exporter name and address come from <a href="/settings?section=general#company">Company settings</a>. Enter the country code and delivery terms you actually agreed.</p>
<form method="post" action="/autopilot/export-papers/profile" class="form-stack"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="revision" value="<%= profile?.revision||0 %>"><label>Exporter country code<input required name="countryCode" maxlength="2" value="<%= profile?.country_code||'' %>"></label><label>Agreed delivery terms<input required name="deliveryTerms" maxlength="160" value="<%= profile?.delivery_terms||'' %>"></label><label><input required type="checkbox" name="confirmed" value="yes"> I confirm these recorded exporter facts.</label><button class="btn">Save exporter facts</button></form>
</div></section>
<section class="card" id="trade-facts"><div class="card-body"><h2>Confirmed product trade facts</h2><p>Confirm the exact SKU using your approved classification and origin. StockChief copies these facts and does not guess them. Net weight is grams per unit.</p>
<form method="get" action="/autopilot/export-papers#trade-facts"><label>Find product by SKU<input required name="sku" maxlength="100" value="<%= selectedProduct?.code||'' %>"></label><button class="btn">Load product facts</button></form>
<form method="post" action="/autopilot/export-papers/products" class="form-stack"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="revision" value="<%= selectedProduct?.revision||0 %>">
<label>Product SKU<input required name="sku" maxlength="100" value="<%= selectedProduct?.code||'' %>" <%= selectedProduct?'readonly':'' %>></label><label>Precise goods description<input required name="description" maxlength="400" value="<%= selectedProduct?.description||selectedProduct?.name||'' %>"></label><label>Confirmed HS code<input required name="hsCode" inputmode="numeric" maxlength="10" value="<%= selectedProduct?.hs_code||'' %>"></label><label>Country of origin code<input required name="originCountry" maxlength="2" value="<%= selectedProduct?.origin_country||'' %>"></label><label>Net weight per unit (grams)<input required type="number" min="1" max="1000000" name="netWeightGrams" value="<%= selectedProduct?.net_weight_grams||'' %>"></label>
<label><input required type="checkbox" name="confirmed" value="yes"> I confirm the product classification, origin and net weight.</label><button class="btn">Save product trade facts</button></form>
<div class="table-wrap"><table><thead><tr><th>SKU</th><th>Description</th><th>HS</th><th>Origin</th><th>Grams/unit</th></tr></thead><tbody><% products.forEach(p=>{ %><tr><td><a href="/autopilot/export-papers?sku=<%= encodeURIComponent(p.code) %>#trade-facts"><%= p.code %></a></td><td><%= p.description %></td><td><%= p.hs_code %></td><td><%= p.origin_country %></td><td><%= p.net_weight_grams %></td></tr><% }) %></tbody></table></div><% if(moreProducts){ %><p>Showing the first 100 confirmed records. Find any exact SKU above to open it.</p><% } %>
</div></section>
<details class="card" id="dispatch"><summary>Confirm a structured dispatch address</summary><div class="card-body"><p>Use this for an international dispatch warehouse. These separate fields must exactly match that warehouse’s saved address.</p><form method="get" action="/autopilot/export-papers#dispatch"><label>Dispatch location<select required name="origin"><% locations.forEach(l=>{ %><option value="<%= l.id %>" <%= selectedLocation?.id===l.id?'selected':'' %>><%= l.name %></option><% }) %></select></label><button class="btn">Load dispatch fields</button></form>
<% if(selectedLocation){ %><p><strong><%= selectedLocation.name %></strong> · Saved warehouse address: <%= selectedLocation.address||'Not recorded' %></p><form method="post" action="/autopilot/export-papers/origin" class="form-stack"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="locationId" value="<%= selectedLocation.id %>"><input type="hidden" name="revision" value="<%= selectedOrigin?.revision||0 %>"><% for(const [key,label,stored]of [['addressLine1','Street','line1'],['addressLine2','Address line 2','line2'],['city','City','city'],['state','State or province','state'],['postalCode','Postal code','postalCode'],['country','Country code','country']]){ %><label><%= label %><input name="<%= key %>" maxlength="200" value="<%= selectedOrigin?.address_fields?.[stored]||'' %>"></label><% } %><label><input required type="checkbox" name="confirmed" value="yes"> I confirm these dispatch fields.</label><button class="btn">Save dispatch fields</button></form><% } %></div></details>
<% } %>
<section class="card"><div class="card-body"><h2>Saved packets</h2><% if(!rows.length){ %><p>No export packets yet.</p><% }else{ %><ul><% rows.forEach(r=>{ %><li><a href="/autopilot/export-papers/<%= r.id %>"><%= r.source_snapshot.shipmentNumber %> · <%= r.status==='REVIEWED'?'Owner reviewed':r.status==='STOPPED'?'Stopped':'Private draft' %> · <%= r.source_snapshot.preparedDate %></a></li><% }) %></ul><% } %><% if(more){ %><a href="?page=<%= page+1 %>">Next packets</a><% } %></div></section>
