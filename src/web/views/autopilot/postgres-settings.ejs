<div class="rm-head"><div class="rm-title"><div><p class="rm-stamp">Standing authority</p><h1>Decide what StockChief may handle without you</h1>
  <p class="rm-prose">StockChief uses inventory, commitments, incoming supply, supplier packs, lead times and explicit reorder rules. A model never grants authority.</p></div></div></div>

<% if(state.paused){ %><div class="notice notice--warn"><div><strong>Automatic work is paused.</strong><p><%= state.pausedReason || 'Read-only monitoring continues.' %></p></div>
  <form method="post" action="/autopilot/resume"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="btn btn--primary">Resume safely</button></form></div><% } %>

<section class="card"><div class="card-head"><div><h2>How much control?</h2><p class="muted">Taking authority away is immediate. Increasing it requires the owner.</p></div></div>
  <div class="card-body"><form method="post" action="/autopilot/mode" class="grid"><input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <label class="choice"><input type="radio" name="mode" value="OBSERVE" <%= state.mode==='OBSERVE'?'checked':'' %>><span><strong>Watch only</strong><small>Notice and explain. Prepare or change nothing.</small></span></label>
    <label class="choice"><input type="radio" name="mode" value="SUPERVISED" <%= state.mode==='SUPERVISED'?'checked':'' %>><span><strong>Ask me first</strong><small>Prepare exact work and wait for approval.</small></span></label>
    <label class="choice"><input type="radio" name="mode" value="POLICY_AUTOMATED" <%= state.mode==='POLICY_AUTOMATED'?'checked':'' %>><span><strong>Handle routine work</strong><small>Execute only inside approved limits below.</small></span></label>
    <div class="form-actions"><button class="btn btn--primary" type="submit">Save control level</button></div></form></div></section>

<section class="card" id="jobs"><div class="card-head"><div><h2>Which jobs StockChief may do on its own</h2>
  <p class="muted">Every job is separate. Authorising a customer email never authorises purchasing, payments, transfers, or postage.</p></div></div>
  <div class="card-body"><div class="job-list"><% capabilities.forEach(function(job){ %><div class="job">
    <div class="job-body"><strong><%= job.label %></strong><span class="t-xs t-muted"><%= job.blurb %></span>
      <span class="t-xs t-muted"><em><%= job.consequence %></em></span></div>
    <form method="post" action="/autopilot/capability" class="job-action"><input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <input type="hidden" name="capability" value="<%= job.capability %>"><input type="hidden" name="granted" value="<%= job.granted?'0':'1' %>">
      <button class="btn btn--sm <%= job.granted?'':'btn--primary' %>" type="submit"><%= job.granted?'Take this back':'Let StockChief do this' %></button></form>
    <span class="job-state <%= job.granted?'is-on':'' %>"><%= job.granted?'Authorised':'Asks first' %></span>
  </div><% }) %></div>
  <% if(state.mode!=='POLICY_AUTOMATED'){ %><p class="hint"><strong>These grants are stored but inactive while StockChief is set to watch or ask first.</strong> Changing the mode still grants nothing by itself.</p><% } %>
  </div></section>

<section class="card"><div class="card-head"><div><h2>Routine transfer and purchasing limits</h2><p class="muted">One confirmation creates immutable, versioned authority. Everything else goes to Needs you.</p></div></div>
  <div class="card-body"><form method="post" action="/autopilot/routine-authority" class="grid"><input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <label class="choice"><input type="checkbox" name="transferEnabled" value="1" <%= transferPolicy?'checked':'' %>><span><strong>Balance stock between locations</strong><small>Prefer a safe internal transfer before buying more.</small></span></label>
    <label>Most units in one automatic transfer<input name="maximumQuantity" inputmode="numeric" value="<%= transferPolicy?.maximumQuantity || 25 %>"></label>
    <fieldset><legend>Locations StockChief may use</legend><div class="grid grid--2"><% locations.forEach(function(location){ %><label class="choice"><input type="checkbox" name="locationIds" value="<%= location.id %>" <%= !transferPolicy || !transferPolicy.locationScope.length || transferPolicy.locationScope.includes(location.id)?'checked':'' %>><span><strong><%= location.name %></strong></span></label><% }) %></div></fieldset>
    <label class="choice"><input type="checkbox" name="purchaseEnabled" value="1" <%= purchasePolicy?'checked':'' %>><span><strong>Approve routine replenishment</strong><small>Prepare an approved PO; supplier sending remains a separate verified step.</small></span></label>
    <div class="grid grid--2"><label>Most per purchase order ($)<input name="maximumValue" inputmode="decimal" value="<%= purchasePolicy?.maximumValue || 500 %>"></label>
      <label>Most across seven days ($)<input name="weeklyValue" inputmode="decimal" value="<%= purchasePolicy?.thresholds?.maxValuePerWeek || 2000 %>"></label></div>
    <fieldset><legend>Usual suppliers StockChief may use</legend><div class="grid grid--2"><% suppliers.forEach(function(supplier){ %><label class="choice"><input type="checkbox" name="supplierIds" value="<%= supplier.id %>" <%= purchasePolicy?.supplierScope.includes(supplier.id)?'checked':'' %>><span><strong><%= supplier.name %></strong></span></label><% }) %></div></fieldset>
    <div class="form-actions"><button class="btn btn--primary" type="submit">Confirm these limits</button></div></form></div></section>

<section class="card"><div class="card-head"><div><h2>Run and audit</h2><p class="muted">The same planner runs from the worker. This button performs a check now.</p></div></div><div class="card-body">
  <div class="form-actions"><form method="post" action="/autopilot/run"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="btn btn--primary">Check the operation now</button></form>
    <% if(!state.paused){ %><form method="post" action="/autopilot/pause"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="btn">Pause automatic work</button></form><% } %></div>
  <% if(!recent.length){ %><p class="muted">No transfer or replenishment decisions have been prepared yet.</p><% } else { %><div class="list-rows"><% recent.forEach(function(item){ %><div class="list-row"><div><strong><%= item.recommendedAction.displayName %></strong><p><%= item.recommendedAction.type==='transfer'?'Transfer':'Purchase' %> <%= item.recommendedAction.quantity %> units · <%= String(item.execution_status).replaceAll('_',' ').toLowerCase() %></p></div><a class="btn btn--sm" href="/autopilot/work/<%= item.id %>">Open</a></div><% }) %></div><% } %>
</div></section>
