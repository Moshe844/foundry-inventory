<section class="card section">
  <h2>Taught supplier replies</h2>
  <% if(rules.teaching){ %>
    <p>StockChief can send an approved reply when the same supplier asks the same question in the same mailbox and its records still support the reply.</p>
    <% if(rules.examples.length){ %>
      <% for(const example of rules.examples){ %>
        <details>
          <summary><%= example.supplier %> · <%= example.subject || 'No subject' %> · <%= example.mailbox %></summary>
          <p><strong>Question</strong></p>
          <blockquote style="white-space:pre-wrap;overflow-wrap:anywhere"><%= example.body_text %></blockquote>
          <p><strong>Approved reply</strong></p>
          <blockquote style="white-space:pre-wrap;overflow-wrap:anywhere"><%= example.reply_body %></blockquote>
          <form action="/autopilot/mail-replies/supplier-rule" method="post">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <button class="btn btn--primary" name="exampleId" value="<%= example.id %>">Teach this reply</button>
          </form>
        </details>
      <% } %>
    <% } else { %>
      <p>Send a supplier reply from <a href="/mail">Mail</a> first. It will appear here once the mailbox confirms delivery.</p>
    <% } %>
  <% } %>
  <% if(rules.rules.length){ %>
    <h3>Saved replies</h3>
    <ul>
      <% for(const rule of rules.rules){ %>
        <li>
          <form action="/autopilot/mail-replies/supplier-rule" method="post">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <a href="/mail/<%= encodeURIComponent(rule.example_id) %>"><%= rule.supplier %> · <%= rule.subject || 'No subject' %></a>
            <button class="btn btn--secondary" name="stop" value="<%= rule.id %>">Stop this reply rule</button>
          </form>
        </li>
      <% } %>
    </ul>
  <% } %>
</section>
