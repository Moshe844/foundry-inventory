<% const pct=v=>(v>0?'+':'')+Number(v).toFixed(1)+'%',signed=(minor,code)=>(minor>0?'+':minor<0?'−':'')+money(Math.abs(minor),code);
const rateText=r=>'1 '+r.currency+' = '+display(r.rate)+' '+base; %>
<p><a href="/autopilot/reviews">← Back to Agent reviews</a></p>
<div class="page-head"><div class="titles"><h1>Foreign purchase costs</h1>
<p>Purchases in other currencies keep their own currency. StockChief estimates their cost in <%= base %> at the rate of the day you order, and books goods in at the rate of the day they arrive. It tells you when a rate change moves your costs. It never changes a price or a cost on its own. Freight, duty and fees keep their own cost allocation.</p></div></div>
<% if(shadow){ %><p class="notice notice--info">StockChief is watching during your first 14 days. It shows what it would alert you about and sends nothing.</p><% } %>
<% if(problem){ %><p class="notice notice--warn"><%= problem %></p><% }else if(failed&&rates.length){ %><p class="notice notice--info">The rate source could not be reached. Saved rates are shown.</p><% } %>
<% if(!allowed){ %><p class="notice notice--info"><strong>Starter</strong> shows one suggestion at a time. <strong>Growth / Pro / Custom</strong> check rates every day, alert you in Needs you and by email, and let you save checked comparison rates. <a class="btn" href="/billing">Upgrade</a></p><% } %>

<% if(!allowed&&suggestion){ %><section class="card section"><h2>Suggestion</h2>
<p><%= suggestion.text %></p>
<p class="cell-sub">Check the order and your selling prices. Nothing has been changed.</p></section><% } %>

<% if(allowed){ %><section class="card section" id="alerts"><h2>Cost alerts</h2>
<% if(!rule||!rule.enabled){ %><p>Choose the change that should alert you, below. Until then StockChief only shows the changes.</p>
<% }else{ %><p>You hear about a change of more than <strong><%= Number(rule.threshold) %>%</strong> in what open orders or your usual foreign items cost.<%= rule.email_connector_id?' Alerts also go to your email.':'' %></p>
<% if(automatic){ %><p class="notice notice--info"><%= automatic %></p><% } %><% } %>
<% if(alerts.length){ %><ul class="rm-list"><% alerts.forEach(a=>{ %><li class="list-row" id="alert-<%= a.id %>"><span><strong><%= a.label %></strong> <span class="badge <%= Number(a.impact_minor)>0?'badge--warn':'badge--ok' %>"><%= Number(a.impact_minor)>0?'Cost up':'Cost down' %></span>
<small><%= a.subject_kind==='ORDER'?'Open goods now about '+money(Number(a.current_minor),a.base_currency):'Each unit' %> · <%= signed(Number(a.impact_minor),a.base_currency) %> (<%= pct(a.percent) %>) since <%= a.basis_source==='CHECKED'?'your checked rate':a.subject_kind==='ORDER'?'ordering':'it was last bought' %> · rate of <%= a.on_date %></small></span>
<form method="post" action="<%= href %>/alerts/<%= a.id %>/dismiss"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="btn btn--ghost btn--sm">Mark as seen</button></form></li><% }) %></ul>
<% }else{ %><p class="cell-sub">No open alerts.</p><% } %>
<% const watched=runs.find(r=>r.outcome==='WATCHED'&&r.result&&r.result.watched&&r.result.watched.length); if(watched&&runs[0]===watched){ %><p class="cell-sub">Watching only: <%= watched.reason %> It would have alerted you about <%= watched.result.watched.map(w=>w.label).join(', ') %>.</p><% } %>
<% if(rule&&rule.enabled){ %><form method="post" action="<%= href %>/check"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="btn btn--ghost">Check now</button></form><% } %>
<% if(cleared.length){ %><p class="cell-sub">Recently closed: <%= cleared.map(c=>c.label+' ('+(c.status==='DISMISSED'?'seen':c.cleared_reason)+')').join('; ') %></p><% } %>
</section><% } %>

<% if(chosen){ %><section class="card"><div class="card-body"><h2><%= chosen.po_number %> · <%= chosen.supplier_name %></h2><p>Open recorded goods: <strong><%= money(chosen.outstandingMinor,chosen.currency) %></strong>.</p>
<% if(result&&result.current!=null){ %><p>Now: <strong><%= money(result.current,base) %></strong> at <%= rateText({currency:chosen.currency,rate:result.rate.rate}) %> (<%= result.rate.date %>)<% if(result.original!=null){ %> · At <%= result.basis.label %>: <%= money(result.original,base) %><% } %>.</p><% if(result.change!=null){ %><p>Cost change: <strong><%= signed(result.change,base) %></strong> (<%= pct(result.percent) %>).</p><% } %><% } %>
<% if(result&&result.problem){ %><p class="notice"><%= result.problem %></p><% } %><% if(saved){ %><p>Checked basis: 1 <%= chosen.currency %> = <%= saved.base_per_foreign %> <%= saved.base_currency %> · <%= saved.quote_date %> · <%= saved.source_reference %></p><% } %>
<p><a href="/purchasing/orders/<%= chosen.id %>">Open purchase order</a> · <a href="<%= href %>">All open foreign purchases</a></p>
<% if(allowed){ %><h3>Confirm the original comparison rate</h3><p>Copy the bank, supplier or budget quote you checked. It replaces the ordering rate as the comparison for this order. Booked stock value keeps the rate of the day goods arrived.</p><form class="form-stack" method="post" action="<%= href %>/baseline"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="purchaseOrderId" value="<%= chosen.id %>"><input type="hidden" name="sourceHash" value="<%= chosen.sourceHash %>"><input type="hidden" name="revision" value="<%= saved?.revision||0 %>">
<label><%= base %> for 1 <%= chosen.currency %><input required name="basePerForeign" inputmode="decimal" value="<%= saved?.base_per_foreign||'' %>" maxlength="24"></label><label>Original quote date<input required name="quotedOn" type="date" value="<%= saved?.quote_date||'' %>"></label><label>Original quote or budget reference<input required name="sourceReference" maxlength="200" value="<%= saved?.source_reference||'' %>"></label><label><input required type="checkbox" name="confirmed" value="yes"> I checked the original quote, its date and the rate direction shown above.</label><button class="btn btn--primary">Save checked comparison rate</button></form><% } %></div></section><% } %>

<section class="card section"><h2>Open foreign purchases</h2><% if(!rows.length){ %><p>No open foreign-currency purchase orders.</p><% }else{ %><div class="table-wrap"><table class="table table--stack"><thead><tr><th>Purchase order</th><th>Open goods</th><th>At ordering</th><th>Now</th><th>Change</th></tr></thead><tbody><% rows.forEach(r=>{ %><tr><td class="cell-main"><a class="cell-title" href="<%= href %>?<%= new URLSearchParams({order:r.id}) %>"><%= r.po_number %></a><span class="cell-sub"><%= r.supplier_name %></span></td><td data-label="Open goods"><%= r.outstandingMinor==null?'Needs price review':money(r.outstandingMinor,r.currency) %></td><td data-label="At ordering"><%= r.original==null?'Not recorded':money(r.original,base) %><% if(r.basis){ %><span class="cell-sub"><%= r.basis.source==='CHECKED'?'Your checked rate':'Rate of '+r.basis.date %></span><% } %></td><td data-label="Now"><%= r.current==null?'Unavailable':money(r.current,base) %></td><td data-label="Change"><% if(r.change!=null){ %><%= signed(r.change,base) %> (<%= pct(r.percent) %>)<% } %><% if(r.problem){ %><span class="cell-sub"><%= r.problem %></span><% } %></td></tr><% }) %></tbody></table></div><% } %><p><% if(page>1){ %><a href="<%= href %>?page=<%= page-1 %>">Previous</a><% } %><% if(more){ %> <a href="<%= href %>?page=<%= page+1 %>">Next 100 purchases</a><% } %></p></section>

<% if(allowed&&items.length){ %><section class="card section"><h2>Items you buy mostly in another currency</h2><p class="cell-sub">Over the last year. The change is per unit, against its landed cost, since the rate it was last booked in or ordered at.</p><div class="table-wrap"><table class="table table--stack"><thead><tr><th>Item</th><th>Landed cost</th><th>Change per unit</th></tr></thead><tbody><% items.forEach(s=>{ %><tr><td class="cell-main"><span class="cell-title"><%= s.label %></span><span class="cell-sub">Bought in <%= s.currency %></span></td><td data-label="Landed cost"><%= s.landedMinor==null?'Not known':money(s.landedMinor,base) %></td><td data-label="Change per unit"><% if(!s.problem){ %><%= signed(s.impactMinor,base) %> (<%= pct(s.percent) %>)<% }else{ %><%= s.problem %><% } %></td></tr><% }) %></tbody></table></div></section><% } %>

<section class="card section" id="rates"><h2>Exchange rates</h2>
<% if(rates.length){ %><ul class="rm-list"><% rates.forEach(r=>{ %><li class="list-row"><span><strong><%= rateText(r) %></strong><small><%= r.label %> · <%= r.date %></small></span></li><% }) %></ul><% }else{ %><p>No current rates yet.</p><% } %>
<p class="cell-sub">Reference rates come from the <a href="<%= provider.link %>" target="_blank" rel="noopener noreferrer"><%= provider.label %></a>, published each working day. Your own rate for a day comes first. Rates older than a week are not used.</p>
<form method="post" action="<%= href %>/rates/refresh"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="btn btn--ghost">Get today’s rates</button></form>
<h3>Enter your own rate</h3><p class="cell-sub">Use the rate your bank or supplier gave you. Goods booked in that day use it.</p>
<form method="post" action="<%= href %>/rates" class="form-stack"><input type="hidden" name="_csrf" value="<%= csrfToken %>">
<label class="rm-field"><span>Currency</span><input name="currency" maxlength="3" required list="fx-currencies" value="<%= currencies[0]||'' %>"></label>
<datalist id="fx-currencies"><% currencies.forEach(c=>{ %><option value="<%= c %>"><% }) %></datalist>
<label class="rm-field"><span><%= base %> for 1 unit of that currency</span><input name="rate" inputmode="decimal" maxlength="20" required></label>
<label class="rm-field"><span>Rate date</span><input name="rateDate" type="date" required value="<%= today %>"></label>
<label class="rm-field"><span>Where the rate comes from</span><input name="note" maxlength="200" required placeholder="e.g. bank quote"></label>
<label class="checkbox"><input type="checkbox" name="confirmed" value="yes" required><span class="checkbox-text">This is how many <%= base %> one unit of the currency costs on that date.</span></label>
<button class="btn btn--primary">Save your rate</button></form>
<% if(manual.length){ %><ul class="rm-list"><% manual.forEach(m=>{ %><li class="list-row"><span><strong>1 <%= m.from_currency %> = <%= m.rate %> <%= m.to_currency %></strong><small><%= m.rate_date %> · <%= m.source_reference %></small></span>
<form method="post" action="<%= href %>/rates/remove"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="currency" value="<%= m.from_currency %>"><input type="hidden" name="rateDate" value="<%= m.rate_date %>"><button class="btn btn--ghost btn--sm">Remove</button></form></li><% }) %></ul><% } %>
</section>

<% if(allowed){ %><section class="card section" id="rule"><h2>When to alert you</h2>
<form method="post" action="<%= href %>/rules" class="form-stack"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="revision" value="<%= rule?.revision||0 %>">
<label class="rm-field"><span>Alert me when a cost changes by more than (%)</span><input name="thresholdPercent" inputmode="decimal" maxlength="5" required value="<%= rule?Number(rule.threshold):'' %>"></label>
<label class="rm-field"><span>Email alerts from</span><select name="mailbox"><option value="none">No email</option><% mailboxes.forEach(b=>{ %><option value="<%= b.id %>" <%= rule?.email_connector_id===b.id||(!rule&&mailboxes.length===1)?'selected':'' %>><%= b.provider_account_name||b.display_name %></option><% }) %></select></label>
<% if(!mailboxes.length){ %><p class="cell-sub">Connect a mailbox in Settings to get these alerts by email.</p><% } %>
<label class="checkbox"><input type="checkbox" name="confirmed" value="yes" required><span class="checkbox-text">Check rates every day and alert me. Never change a price or a cost.</span></label>
<button class="btn btn--primary">Save alert rule</button></form>
<% if(rule&&rule.enabled){ %><form method="post" action="<%= href %>/rules"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="revision" value="<%= rule.revision %>"><button class="btn btn--ghost" name="stop" value="yes">Turn off alerts</button></form><% } %>
<p class="cell-sub"><a href="/autopilot/job-modes">Choose Watch only or Ask me first for this job</a></p></section><% } %>
