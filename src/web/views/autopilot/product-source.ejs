<style>.product-source{max-width:1080px}.product-source section{background:#fff;border:1px solid #dce2ec;border-radius:18px;padding:20px;margin:20px 0}.product-source p,.product-source li,.product-source blockquote{overflow-wrap:anywhere;line-height:1.55}.product-source input:not([type=checkbox]),.product-source select{box-sizing:border-box;max-width:100%;width:100%}.product-source label{display:block;margin:12px 0}.product-source pre{white-space:pre-wrap;overflow-wrap:anywhere;font:inherit;max-height:400px;overflow:auto}.product-source .fact{border-top:1px solid #dce2ec;padding:16px 0}.product-source blockquote{margin:10px 0;padding:12px;border-left:3px solid #b6c2d6;background:#f7f9fc}.product-source .muted{color:#526179}.product-source .btn{white-space:normal;margin:4px 0}@media(max-width:600px){.product-source section{padding:16px}}</style>
<div class="product-source">
<p><a href="/autopilot">← StockChief AI</a></p><h1>Product facts from spec and safety sheets</h1>
<p>Read complete original PDFs, Word files, UTF-8 text, photos and scans. Save product specifications and safety information with their original values, units, language and exact page quotations. Source statements and certification claims do not establish legal compliance.</p>
<% if(!screen.allowed){ %><section data-agent-plan-locked><h2>Growth, Pro or Custom required</h2><p>Historical originals and saved facts remain available. New readings and product updates are locked on this plan.</p><a class="btn" href="/billing">Review plans</a></section><% } %>
<% if(screen.shadow){ %><p class="notice">StockChief is watching for the first 14 days. Source reading and saving begin after Watch with your current authority.</p><% } %>
<% if(screen.record){ const r=screen.record; %>
<section><h2><%= r.filename %></h2><p>For <a href="/inventory/<%= r.item_id %>"><%= r.product_name %></a> · <%= r.document_kind==='safety_sheet'?'Safety sheet':'Specification' %></p>
<p data-product-source-status role="status"><%= {PENDING:'Queued',RUNNING:'Reading complete source',READY:'Ready for review',SAVED:'Saved product facts',FAILED:'Reading failed — newly reserved credits released'}[r.status] %></p>
<p data-product-source-credits><%= r.credits_used %> new AI credits used · <%= r.documents_used %> new document allowance used. Existing paid receipts and complete readings are reused.</p>
<% if(r.problem){ %><p class="notice"><%= r.problem %></p><% } %>
<p><a class="btn" href="/autopilot/product-facts/<%= r.id %>/original">Download original source</a> <a class="btn" href="/inventory/<%= r.item_id %>">Open product record</a></p>
<% if(['PENDING','RUNNING'].includes(r.status)){ %><p>Reading continues in the background. <%= r.progress?.partsRead||0 %> of <%= r.progress?.partsTotal||'the complete' %> source sections checked. <a href="/autopilot/product-facts/<%= r.id %>">Refresh progress</a>.</p><% } %>
<% if((r.status==='READY'||r.status==='FAILED'||r.status==='SAVED'&&r.held_count>0)&&!r.acknowledged_at){ %><form method="post" action="/autopilot/product-facts/<%= r.id %>/acknowledge"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="btn">Mark this notice reviewed</button></form><% } %>
<% if(r.status==='FAILED'&&screen.allowed){ %><form method="post" action="/autopilot/product-facts/<%= r.id %>/retry"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="btn">Retry the complete source reading</button></form><% } %>
<% if(screen.view){ const view=screen.view; %>
<p><%= r.raw_facts.length %> complete sourced facts · <%= view.rows.filter(f=>f.saved).length %> saved · <%= view.rows.filter(f=>f.problem).length %> need source review. Missing values remain missing; StockChief does not infer new stock units, pack conversions or physical stock.</p>
<p><a class="btn btn--primary" href="/autopilot/product-facts/<%= r.id %>/facts.csv">Download complete sourced facts CSV</a></p>
<% if(r.issues.length){ %><details><summary>Source reading observations</summary><ul><% r.issues.forEach(function(i){ %><li>Section <%= i.page %>: <%= i.text %></li><% }) %></ul></details><% } %>
<form method="post" action="/autopilot/product-facts/<%= r.id %>/approve"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="revision" value="<%= r.revision %>"><input type="hidden" name="reviewHash" value="<%= view.reviewHash %>">
<h3>Review every source fact</h3>
<% view.rows.forEach(function(f){ %><article class="fact" data-source-fact><h4><%= ['certifications','regulatory'].includes(f.kind)?'Source claim: ':'' %><%= f.label||screen.labels[f.kind]||f.kind %> — <%= f.value %> <%= f.unit %></h4>
<p>Original page / section <%= f.page %><%= f.sourceName?' · '+f.sourceName:'' %> · <%= f.sourceKind==='scan'?'OCR-only reading — check the original':f.sourceKind %><%= f.subject?' · '+f.subject:'' %></p>
<blockquote><%= f.quote %></blockquote><% if(f.identityQuote&&f.identityQuote!==f.quote){ %><p>Product identity evidence, original page / section <%= f.identityPage %>: <q><%= f.identityQuote %></q></p><% } %><p><strong><%= f.saved?'Saved on product record':f.problem?'Needs review':'Ready to save' %></strong><%= f.problem?' — '+f.problem:'' %></p>
<% if(f.native){ %><p>Native <%= screen.nativeLabels[f.native.field]||f.native.field %>: <%= f.native.problem||('Ready to fill missing value with '+f.native.value) %>. Existing native values are preserved.</p><% } %>
<% if(screen.allowed&&!f.saved&&(f.uncertain||f.problem||f.native?.problem)){ %><label><input type="checkbox" name="confirmedFacts" value="<%= f.id %>"> I checked this exact value, its meaning and product identity against the original. Any measurement above describes one recorded <%= r.unit_label %>; I am not deriving it from a pack or count.</label>
<% if(!f.skuId){ %><label>Exact variant for this confirmed fact<select name="skuChoice[<%= f.id %>]"><option value="">Common product fact / choose when filling variant fields</option><% view.snapshot.skus.filter(s=>Number(s.is_active)).forEach(function(s){ %><option value="<%= s.id %>"><%= s.code %><%= s.variant_label?' — '+s.variant_label:'' %></option><% }) %></select></label><% } %><% } %>
</article><% }) %>
<% if(screen.allowed){ %><label><input type="checkbox" name="enrich" value="yes" <%= r.enrich?'checked':'' %>> Fill currently empty native barcode, weight and size fields only from the verified measurements above. No prices, stock quantities or stock units change.</label>
<label><input type="checkbox" name="confirmed" value="yes" required> I reviewed this complete batch and approve saving its ready facts and selected missing-field updates. Unresolved conflicts stay held.</label><button class="btn btn--primary">Save reviewed product facts</button><% } %></form>
<details><summary>Complete readable source and page coverage</summary><% r.source_pages.forEach(function(p){ %><h4>Original page / section <%= p.page %> · <%= p.sourceKind %><%= p.sourceName?' · '+p.sourceName:'' %></h4><% if(p.visualObservation){ %><p><%= p.visualObservation %></p><% } %><pre><%= p.text %></pre><% }) %></details>
<% } %></section><% } %>
<% if(screen.allowed&&!screen.record){ %><section><h2>Read a product source</h2><p>Current configured reading price: <%= screen.credits %> AI credits <%= screen.fixedCredits?'for the complete file':'to start the complete action; additional cost-bounded funding follows your current agreed terms' %>, plus one document allowance. A previously paid source or completed reading is reused. Failed whole readings release newly reserved credits; no per-page flat charge is added.</p>
<form method="post" action="/autopilot/product-facts" enctype="multipart/form-data"><input type="hidden" name="_csrf" value="<%= csrfToken %>">
<label>Exact product name or SKU<input name="productReference" required maxlength="240" value="<%= initial.productReference||'' %>"></label>
<label>Source type<select name="documentKind" aria-label="Source type"><option value="specification">Specification</option><option value="safety_sheet">Safety sheet</option></select></label>
<label>Complete original file<input type="file" name="source" accept=".pdf,.docx,.txt,.csv,.tsv,.png,.jpg,.jpeg,.webp,.gif,.heic,.heif,.tif,.tiff"></label>
<label>Or this product’s existing filed document ID<input name="filedDocument" value="<%= initial.filedDocument||'' %>"></label>
<label>Or an exact saved attachment ID<input name="fileAttachment"></label>
<label><input type="checkbox" name="targetConfirmed" value="yes"> I checked that this complete source belongs to the selected product. Variant-specific values still need the exact variant.</label>
<label><input type="checkbox" name="enrich" value="yes"> Also prepare verified missing barcode, weight and size updates from this same reading.</label>
<% if(screen.routineIncluded){ %><label><input type="checkbox" name="automatic" value="yes"> I authorize saving unambiguous facts and selected missing-field updates from this exact source without another batch approval, within my current global and per-job routine authority. Uncertain readings remain for me.</label><% }else{ %><p>Growth reviews and approves each finished batch. Pro and Custom can save clearly proven facts without training within explicit current authority.</p><% } %>
<button class="btn btn--primary" <%= screen.shadow?'disabled':'' %>>Queue complete source reading</button></form></section><% } %>
<section><h2>Saved source readings</h2><ul><% screen.rows.forEach(function(r){ %><li><a href="/autopilot/product-facts/<%= r.id %>"><%= r.filename %></a> · <%= r.product_name %> · <%= r.status %> · <%= r.credits_used %> AI credits</li><% }) %></ul><% if(screen.page>1){ %><a href="/autopilot/product-facts?page=<%= screen.page-1 %>">Previous sources</a><% } %><% if(screen.more){ %><a href="/autopilot/product-facts?page=<%= screen.page+1 %>">Next sources</a><% } %></section>
</div>
