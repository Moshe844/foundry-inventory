<h1>Playbooks</h1>
<% if(enabled){ %><form class="card" method="post" action="/autopilot/playbooks"><input type="hidden" name="_csrf" value="<%= csrfToken %>">
<label>Name <input name="name" maxlength="100" required></label><fieldset><legend>Steps</legend>
<% choices.forEach(c=>{ %><label><input type="checkbox" name="steps" value="<%= c.key %>"> <%= c.label %></label><% }); %></fieldset>
<label>Schedule <select name="cadence"><option value="manual">Run manually</option><option value="daily">Every day</option><option value="weekly">Every week</option></select></label>
<button class="btn btn--primary">Save playbook</button></form><% } else { %><p>Scheduled playbooks are available on Growth, Pro and Custom. <a href="/billing">Review your plan</a></p><% } %>
<% books.forEach(b=>{ %><section class="card"><h2><%= b.name %></h2>
<p><%= b.cadence %><% if(b.next_at){ %> · Next run <%= helpers.dateTime(b.next_at) %><% } %></p>
<% if(enabled){ %><form method="post" action="/autopilot/playbooks/<%= b.id %>/run">
<input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="requestKey" value="<%= requestKey %>"><button class="btn">Run now</button></form><% } %>
<% if(b.result){ %><h3>Results from <%= helpers.dateTime(b.ran_at) %></h3><% b.result.forEach(r=>{ %><h4><%= r.label %></h4><p><%= r.summary %><% if(r.link){ %> <a href="<%= r.link %>">View report</a><% } %></p>
<% if(r.rows?.length){const fields=Object.keys(r.rows[0]); %><table><thead><tr><% fields.forEach(k=>{ %><th><%= k.replaceAll('_',' ') %></th><% }); %></tr></thead><tbody>
<% r.rows.forEach(row=>{ %><tr><% fields.forEach(k=>{ %><td><% if(k==='link' && typeof row[k]==='string' && row[k].startsWith('/') && !row[k].startsWith('//')){ %><a href="<%= row[k] %>">Open record</a><% }else{ %><%= row[k] %><% } %></td><% }); %></tr><% }); %></tbody></table><% } %><% }); %><% } %>
<form method="post" action="/autopilot/playbooks/<%= b.id %>/delete"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="btn">Delete playbook</button></form></section><% }); %>
