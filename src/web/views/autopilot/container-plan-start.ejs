<h1>Container planning</h1><p>Plan selected import orders using whole cartons, outside dimensions, gross weights and confirmed stacking limits. StockChief records a conservative layout and shows every carton that does not fit. Your freight or warehouse team approves the final loading arrangement and weight distribution.</p>
<% if(locked){ %><section class="card"><h2><span class="badge">Pro</span> Import container planning</h2><p>Pro can prepare plans and learn a reviewed scope for routine recalculation. Custom can recalculate within an explicit owner-approved scope without training.</p><a class="btn" href="/settings/billing">Upgrade</a></section><% }else{ %>
<% if(shadow){ %><p class="notice">Your first 14 days are Watch only. You can inspect order and packing facts; agent plans and routine settings wait until the watch period ends.</p><% } %>
<% if(!draft){ %><section class="card"><h2>Start a load plan</h2><form method="post" action="/autopilot/container-plans/prepare" class="form-stack"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="requestKey" value="<%= requestKey %>"><%- include('container-spec-fields',{input:{}}) %><button class="btn">Check orders and packing facts</button></form></section>
<% }else{ %><section class="card"><h2>Confirm every packing profile</h2><p>Saved measurements are reused only for the same supplier, receiving warehouse, currency, SKU and purchase-unit profile. Enter the original supplier specification or your measured packing reference. Carton weight includes packaging; zero supported weight means nothing may be stacked above it.</p>
<form method="post" action="/autopilot/container-plans" class="form-stack" data-container-inputs><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="requestKey" value="<%= requestKey %>"><input type="hidden" name="sourceFingerprint" value="<%= draft.facts.fingerprint %>"><input type="hidden" name="packagesJson" value="">
<%- include('container-spec-fields',{input:draft.input}) %>
<details><summary>Fill packing facts from a spreadsheet</summary><p>Paste tab-separated rows in this order: PO number, SKU code, stock units per carton, outer length (mm), outer width (mm), outer height (mm), gross grams, supported grams above, rotation (yes/no), packing reference. One profile per line. Ambiguous rows need individual entry.</p><textarea data-packing-paste rows="5" aria-label="Packing facts from a spreadsheet"></textarea><button type="button" class="btn" data-apply-packing>Fill matching rows</button><p role="status" data-packing-status></p></details>
<% for(const row of draft.rows){const p=row.profile?.pack; %><fieldset class="card" data-packing-row data-line="<%= row.line_id %>" data-order="<%= row.order_number %>" data-sku="<%= row.code %>"><legend><%= row.order_number %> · Line <%= row.line_number %> · <%= row.code %></legend><p><%= row.supplier_name %> · Receiving at <%= row.warehouse_name %> · <%= row.remaining %> <%= row.unit_label %> remaining · Purchase unit: <%= row.purchase_unit %> of <%= row.units_per_purchase_unit %> <%= row.unit_label %>.</p>
<% for(const [key,label,value] of [['unitsPerCarton','Stock units per carton',p?.unitsPerCarton],['lengthMm','Carton outside length (mm)',p?.length],['widthMm','Carton outside width (mm)',p?.width],['heightMm','Carton outside height (mm)',p?.height],['weightGrams','Carton gross weight (grams)',p?.weight],['maximumAboveGrams','Maximum supported weight above this carton (grams)',p?.maximumAbove]]){ %><label class="rm-field"><span><%= label %></span><input data-packing-field="<%= key %>" type="number" min="<%= key==='maximumAboveGrams'?0:0.000000001 %>" step="<%= key==='unitsPerCarton'?'any':'1' %>" value="<%= value??'' %>" required></label><% } %>
<label class="rm-field"><span>May the carton turn horizontally?</span><select data-packing-field="rotate" required><option value="">Confirm orientation</option><option value="yes" <%= p?.rotate===true?'selected':'' %>>Yes</option><option value="no" <%= p?.rotate===false?'selected':'' %>>No</option></select></label>
<label class="rm-field"><span>Original packing measurement or supplier specification reference</span><input data-packing-field="sourceReference" maxlength="500" value="<%= row.profile?.source_reference||'' %>" required></label></fieldset><% } %>
<label><input type="checkbox" name="confirmed" value="yes" required> I checked the selected orders, actual container allowance and every carton’s measurements, gross weight, orientation and stacking limit.</label><button class="btn" <%= shadow?'disabled':'' %>>Calculate this load plan</button><noscript><p>Enable JavaScript to send the complete set of packing facts together.</p></noscript></form><script src="/container-plan-inputs.js" defer></script></section><% } %><% } %>
<% if(rows.length){ %><section class="card"><h2>Saved planning groups</h2><% for(const row of rows){ %><article><h3><% if(!locked){ %><a href="/autopilot/container-plans/<%= row.id %>"><%= row.title %></a><% }else{ %><%= row.title %><% } %></h3><p><%= row.enabled?'Routine recalculation enabled':'Routine recalculation stopped' %>. <%= row.last_issue||'' %></p><% if(row.enabled){ %><form method="post" action="/autopilot/container-plans/<%= row.id %>/settings"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="revision" value="<%= row.revision %>"><button class="btn" name="stop" value="yes">Stop routine container planning</button></form><% } %></article><% } %></section><% } %>
<% for(const row of rows.filter(r=>r.rule_revision)){ %><form method="post" action="/autopilot/container-plans/<%= row.id %>/teach" class="card"><h3>Taught scope: <%= row.title %></h3><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="ruleRevision" value="<%= row.rule_revision %>"><label><input type="checkbox" name="confirmed" value="yes" required> Remove this current taught scope and stop routine recalculation.</label><button class="btn" name="remove" value="yes">Remove taught container scope</button></form><% } %>
<nav aria-label="Saved planning groups"><% if(page>1){ %><a href="/autopilot/container-plans?page=<%= page-1 %>">Previous groups</a><% } %> <% if(more){ %><a href="/autopilot/container-plans?page=<%= page+1 %>">Next groups</a><% } %></nav><p>AI credits used: 0.</p>
