<div class="page-head">
  <div class="titles">
    <a class="back-link" href="/"><%- helpers.icon('chevron', { size: 14 }) %> Foundry</a>
    <h1><%= locals.title || item.categoryLabel %></h1>
    <div class="page-sub">
      <%= item.executionStatus === 'COMPLETED' ? 'Done' : helpers.columnLabel(item.executionStatus.toLowerCase().replace(/_/g, ' ')) %>
      <% if (item.verificationStatus === 'VERIFIED') { %> · verified against your records<% } %>
      <% if (item.isAutomatic) { %> · carried out automatically<% } %>
    </div>
  </div>
</div>

<div class="card section <%= item.verificationStatus === 'FAILED' ? 'card--warn' : '' %>">
  <div class="card-head">
    <h2>Why</h2>
    <% if (policy) { %><span class="spacer"></span><a class="btn btn--sm btn--ghost" href="/autopilot/policies/<%= policy.id %>"><%= policy.name %></a><% } %>
  </div>
  <div class="card-body">
    <% paragraphs.forEach(function (line) { %><p class="lede"><%= line %></p><% }) %>
    <%# What the button does, listed, and what it deliberately does not. %>
    <% if ((locals.actions || []).length) { %>
      <% const now = locals.actions.filter(function (a) { return a.when === 'now'; }); %>
      <% const later = locals.actions.filter(function (a) { return a.when === 'after'; }); %>
      <% if (now.length) { %>
        <h3 class="rep-plan-sub">What approving this will do</h3>
        <ol class="plain-list">
          <% now.forEach(function (a) { %>
            <li><strong><%= a.text %></strong><br><span class="muted"><%= a.detail %></span></li>
          <% }) %>
        </ol>
      <% } %>
      <% if (later.length) { %>
        <h3 class="rep-plan-sub">What it will not do</h3>
        <ul class="plain-list">
          <% later.forEach(function (a) { %>
            <li><%= a.text %><br><span class="muted"><%= a.detail %></span></li>
          <% }) %>
        </ul>
      <% } %>
    <% } %>

    <% if (locals.position) { %>
      <h3 class="rep-plan-sub">Where this leaves the position</h3>
      <table class="rep-plan-table">
        <tbody>
          <tr><td>On hand</td><td class="num"><%= locals.position.onHand %></td></tr>
          <tr><td>On order <span class="muted">— placed with a supplier</span></td><td class="num"><%= locals.position.onOrder %></td></tr>
          <tr><td>Drafted <span class="muted">— decided, not yet placed</span></td><td class="num"><%= locals.position.drafted %></td></tr>
          <tr><td><strong>Position now</strong> <span class="muted">— on hand + on order</span></td><td class="num"><strong><%= locals.position.position %></strong></td></tr>
          <tr><td>Reorder point</td><td class="num"><%= locals.position.reorderPoint %></td></tr>
          <tr><td>Order up to</td><td class="num"><%= locals.position.target %></td></tr>
          <tr><td><strong>Position after approving this</strong></td><td class="num"><strong><%= locals.position.afterApproval %></strong></td></tr>
          <% if (locals.position.drafted) { %>
            <tr><td>Once every drafted order is placed and arrives</td><td class="num"><%= locals.position.afterEveryOrderArrives %></td></tr>
          <% } %>
        </tbody>
      </table>
    <% } %>

    <% if (locals.orderLink) { %>
      <p><a class="btn btn--sm" href="<%= locals.orderLink %>">Open the order</a></p>
    <% } %>

    <% if (locals.supersededBy) { %>
      <p><a class="btn btn--sm" href="/autopilot/work/<%= locals.supersededBy %>">Open the plan that replaced this</a></p>
    <% } %>

    <% if (evidence.filter(function (f) { return f && f.label; }).length) { %>
      <h3 class="sub-head">What I measured</h3>
      <table class="table table--tight">
        <tbody>
          <% evidence.forEach(function (fact) { %>
            <tr><td><%= fact.label %></td><td class="num"><%= fact.value %></td></tr>
          <% }) %>
        </tbody>
      </table>
    <% } %>

    <% if (checks.length) { %>
      <h3 class="sub-head">What I checked before doing it</h3>
      <ul class="plain-list">
        <% checks.forEach(function (check) { %>
          <li class="<%= check.passed ? '' : 'is-warn' %>">
            <%- helpers.icon(check.passed ? 'check' : 'alert', { size: 14 }) %>
            <%# Every check is named as a claim — "Price is within the approved
                change limit" — which reads as a lie the moment it fails beside
                "17% > 5%". A failed one is marked as not met, in words. %>
            <%= check.passed ? check.name : 'Not met — ' + check.name.charAt(0).toLowerCase() + check.name.slice(1) %><% if (check.detail) { %> <span class="muted">(<%= check.detail %>)</span><% } %>
          </li>
        <% }) %>
      </ul>
    <% } %>

    <% if (verification.length) { %>
      <h3 class="sub-head">What I checked afterwards</h3>
      <ul class="plain-list">
        <% verification.forEach(function (check) { %>
          <li class="<%= check.ok ? '' : 'is-warn' %>">
            <%- helpers.icon(check.ok ? 'check' : 'alert', { size: 14 }) %> <%= check.name %>
          </li>
        <% }) %>
      </ul>
    <% } %>
  </div>

  <% if (item.needsPerson && canOperate) { %>
    <div class="card-foot">
      <div class="btn-row">
        <form method="post" action="/autopilot/work/<%= item.id %>/approve" data-busy>
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <button class="btn btn--primary" type="submit">Do it</button>
        </form>
        <form method="post" action="/autopilot/work/<%= item.id %>/cancel">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <button class="btn btn--ghost" type="submit">Leave it</button>
        </form>
      </div>
    </div>
  <% } %>
</div>

<div class="card section">
  <div class="card-head"><h2>What happened, in order</h2></div>
  <table class="table table--tight">
    <tbody>
      <% events.forEach(function (event) { %>
        <tr>
          <td><%= helpers.columnLabel(event.event.replace(/_/g, ' ')) %></td>
          <td class="muted"><%= event.actorName || 'Foundry' %></td>
          <td class="muted"><%= helpers.dateTime(event.createdAt) %></td>
        </tr>
      <% }) %>
    </tbody>
  </table>
  <% if (item.errorMessage) { %>
    <div class="card-body"><p class="is-warn"><%= item.errorMessage %></p></div>
  <% } %>
</div>
