<h1>Supplier rebates &amp; volume discounts</h1>
<p>Track rebates and volume discounts you agreed with a supplier. Accepting supplier terms always needs you. StockChief never posts money here; the supplier’s credit note goes through supplier credits.</p>
<% if(offers.length&&!selected&&!emailed){ %><section class="card"><h2>Rebate terms from supplier emails</h2><p>Check each one against the email before you track it.</p><% for(const o of offers){ %><p><a href="/autopilot/supplier-benefits?offer=<%= encodeURIComponent(o.id) %>">Check terms from <%= o.name %></a></p><form method="post" action="/autopilot/supplier-benefits/offers/<%= encodeURIComponent(o.id) %>/dismiss"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><label><input type="checkbox" name="confirmed" value="yes" required> I do not want to track these terms.</label><button class="btn">Ignore terms from <%= o.name %></button></form><% } %></section><% } %>
<% if(shadow){ %><p class="notice">The first 14 days are Watch only. You can check terms and record external facts yourself; background tracking waits until that period ends and you authorize routine work.</p><% } %>
<% if(locked){ %><section class="card"><h2><span class="badge">Growth</span> Check an agreed supplier benefit</h2><p>Growth can suggest a benefit from the exact terms you enter. Pro and Custom can track agreed programmes and claim deadlines.</p><a class="btn" href="/settings/billing">Upgrade</a></section><% } %>
<% if(!locked&&(!selected||editing)){ %>
<section class="card"><h2>Check agreed terms</h2><p>Use the original agreement. Leave uncertain terms for review with the supplier.</p>
<% if(emailed){ %><div class="notice"><p>Read from the email from <%= emailed.sender %> (<%= emailed.subject %>). <a href="/mail/<%= emailed.message_id %>">Open the email</a>.</p><% if(emailed.status!=='OPEN'){ %><p>These terms were already handled.</p><% } %><ul><% for(const quote of emailed.reading.quotes){ %><li><q><%= quote %></q></li><% } %></ul><% if(emailed.reading.missing.length){ %><p>Check or fill in:</p><ul><% for(const gap of emailed.reading.missing){ %><li><%= gap %></li><% } %></ul><% } %><p>Saving accepts these terms for tracking. Check every value against the email first.</p></div><% } %>
<form method="get" class="form-stack"><label class="rm-field"><span>Find a supplier</span><input name="q" value="<%= q %>"></label><button class="btn">Search suppliers</button></form>
<% if(moreSuppliers){ %><p>Showing 50 matches. Refine the supplier search.</p><% } %>
<form method="post" action="<%= editing?'/autopilot/supplier-benefits/'+selected+'/edit':'/autopilot/supplier-benefits/estimate' %>" class="form-stack">
<input type="hidden" name="_csrf" value="<%= csrfToken %>">
<% if(emailed&&emailed.status==='OPEN'&&!editing){ %><input type="hidden" name="offerId" value="<%= emailed.id %>"><% } %>
<% if(editing){ %><input type="hidden" name="revision" value="<%= result.program.revision %>"><input type="hidden" name="supplierId" value="<%= input.supplierId %>"><% } %>
<div class="rm-field"><label for="benefit-supplier">Supplier</label><select id="benefit-supplier" name="supplierId" required <%= editing?'disabled':'' %>><option value="">Choose supplier</option><% for(const supplier of suppliers){ %><option value="<%= supplier.id %>" <%= input.supplierId===supplier.id?'selected':'' %>><%= supplier.name %></option><% } %></select></div>
<label class="rm-field"><span>Agreement name</span><input name="title" maxlength="200" value="<%= input.title||'' %>" required></label>
<label class="rm-field"><span>Original agreement reference</span><input name="sourceReference" maxlength="500" value="<%= input.sourceReference||'' %>" required></label>
<label class="rm-field"><span>Agreed currency</span><input name="currency" value="<%= input.currency||'' %>" placeholder="USD" pattern="[A-Za-z]{3}" required></label>
<label class="rm-field"><span>Purchase period starts</span><input type="date" name="startsOn" value="<%= input.startsOn||'' %>" required></label><label class="rm-field"><span>Purchase period ends</span><input type="date" name="endsOn" value="<%= input.endsOn||'' %>" required></label>
<label class="rm-field"><span>Claims open on, if confirmed</span><input type="date" name="claimOn" value="<%= input.claimOn||'' %>"></label><label class="rm-field"><span>Claim deadline, if confirmed</span><input type="date" name="claimBy" value="<%= input.claimBy||'' %>"></label>
<label><input type="checkbox" name="allProducts" value="yes" <%= input.allProducts==='yes'?'checked':'' %>> All matched product lines for this supplier (spend agreements only)</label>
<label class="rm-field"><span>Exact SKU codes, one per line</span><textarea name="codes" rows="3"><%= input.codes||'' %></textarea></label><p>Choose all products or exact codes. Quantity agreements require one exact SKU and its existing stock unit.</p>
<div class="rm-field"><label for="benefit-basis">Eligibility basis</label><select id="benefit-basis" name="basis" required><option value="">Confirm basis</option><option value="net_spend" <%= input.basis==='net_spend'?'selected':'' %>>Net matched product spend, before tax and freight</option><option value="stock_units" <%= input.basis==='stock_units'?'selected':'' %>>Stock quantity of one SKU</option></select></div>
<div class="rm-field"><label for="benefit-type">Benefit type</label><select id="benefit-type" name="benefit" required><option value="">Confirm benefit</option><option value="percentage" <%= input.benefit==='percentage'?'selected':'' %>>Percentage rebate</option><option value="unit_price" <%= input.benefit==='unit_price'?'selected':'' %>>Agreed volume price (quantity basis only)</option></select></div>
<div class="rm-field"><label for="benefit-method">Tier method</label><select id="benefit-method" name="method" required><option value="">Confirm method</option><option value="retroactive" <%= input.method==='retroactive'?'selected':'' %>>Attained tier applies to all eligible purchases</option><option value="incremental" <%= input.method==='incremental'?'selected':'' %>>Each spend band has its own percentage</option></select></div>
<div class="rm-field"><label for="benefit-rounding">Agreed rounding</label><select id="benefit-rounding" name="rounding" required><option value="">Confirm rounding</option><option value="half_up" <%= input.rounding==='half_up'?'selected':'' %>>Round half up to currency precision</option><option value="floor" <%= input.rounding==='floor'?'selected':'' %>>Round down to currency precision</option></select></div>
<label class="rm-field"><span>Stock units per agreed price, for volume prices</span><input name="pricePerUnits" inputmode="decimal" value="<%= input.pricePerUnits||'' %>" placeholder="For example, 12 if the price is per case of 12"></label>
<label class="rm-field"><span>Agreed tiers: threshold | percentage or price</span><textarea name="tiersText" rows="5" required placeholder="1000.00 | 5"><%= input.tiersText||'' %></textarea></label><p>One tier per line, in increasing threshold order. Spend thresholds and prices use the agreed currency; quantities use the product’s stock unit. Enter percentages as 5 for 5%.</p>
<label><input type="checkbox" name="confirmed" value="yes" required> I checked these exact terms against the agreement already accepted with this supplier.</label>
<% if(editing){ %><button class="btn">Save reviewed agreement terms</button><% }else{ %><button class="btn">Estimate once</button>
<% if(canTrack){ %><button class="btn" formaction="/autopilot/supplier-benefits">Start tracking this agreement</button><% }else{ %><p><span class="badge">Pro</span> Ongoing tracking, deadline alerts and claim history need Pro or Custom. <a href="/settings/billing">Upgrade</a></p><% } %><% } %>
</form></section>
<% } %>
<% if(result){const r=result,p=r.program; %><section class="card"><h2><%= result.estimateOnly?'One-time suggestion':p.title %></h2><p><%= p.scope.supplierName %> · Agreement period <%= p.starts_on %> to <%= p.ends_on %> · As of <%= r.today %> · <%= p.currency %></p>
<p>Agreement reference: <%= p.source_reference %>.</p><p>Uses posted, matched invoice product amounts before tax and freight. Paid-only agreements or other eligibility clauses need separate review.</p>
<details><summary>Exact agreed tiers and method</summary><p><%= p.terms.method==='retroactive'?'The attained tier applies to all eligible purchases.':'Each spend band has its own percentage.' %> <%= p.terms.rounding==='half_up'?'Round half up':'Round down' %> to the currency’s precision.</p><ul><% for(const tier of p.terms.tiers){ %><li>From <%= p.terms.basis==='net_spend'?displayMoney(tier.threshold,p.currency):tier.threshold+' '+p.scope.products[0].unit %>: <%= p.terms.benefit==='percentage'?(tier.rateBasisPoints/100)+'%':displayMoney(tier.unitPriceMinor,p.currency)+' per '+p.terms.pricePerUnits+' '+p.scope.products[0].unit %></li><% } %></ul></details>
<p><strong><%= displayMoney(r.result.potentialBenefitMinor,p.currency) %></strong> potential benefit from checked purchases. This is an estimate of the agreed benefit, not money received.</p>
<p><%= displayMoney(r.result.eligibleNetMinor,p.currency) %> eligible product spend<% if(p.terms.basis==='stock_units'){ %> · <%= r.result.eligibleQuantity %> <%= p.scope.products[0].unit %><% } %>.</p>
<% if(r.result.nextThreshold!==null){ %><p>Next tier: <%= p.terms.basis==='net_spend'?displayMoney(r.result.nextThreshold,p.currency):r.result.nextThreshold+' '+p.scope.products[0].unit %>. Another <%= p.terms.basis==='net_spend'?displayMoney(r.result.remainingToNext,p.currency):r.result.remainingToNext+' '+p.scope.products[0].unit %> is needed.</p><% } %>
<% for(const warning of r.warnings){ %><p class="notice"><%= warning %></p><% } %>
<% if(r.scopeReview&&canTrack&&!result.estimateOnly){const review=r.scopeReview; %><section><h3>Review changed supplier or product details</h3><p>Previously: <%= review.previous.supplierName %> · <%= review.previous.supplierEmail||'No email' %>. Now: <%= review.current.supplierName %> · <%= review.current.supplierEmail||'No email' %>.</p><ul><% for(const product of review.current.products){const old=review.previous.products.find(row=>row.skuId===product.skuId); %><li><%= old?.code||'Original product' %> → <%= product.code %> · <%= product.unit %></li><% } %></ul><% if(review.compatible){ %><form method="post" action="/autopilot/supplier-benefits/<%= p.id %>/scope"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="revision" value="<%= p.revision %>"><input type="hidden" name="expectedFingerprint" value="<%= review.fingerprint %>"><label><input type="checkbox" name="confirmed" value="yes" required> I checked the original agreement. This is the same supplier and the same products with unchanged stock units. Keep the agreed terms and claim history.</label><button class="btn">Confirm reviewed supplier and product details</button></form><% }else{ %><p>Changed stock units or unavailable source records need separate agreement review. StockChief will not reinterpret past purchases.</p><% } %></section><% } %>
<% if(claimView?.nearTier){ %><p class="notice"><%= claimView.nearTier.text %></p><% } %>
<% if(claimView?.periodClosed){ %><p><strong><%= r.holds.length?'Rebate earned from checked purchases so far':'Rebate earned for the period' %>: <%= displayMoney(r.result.potentialBenefitMinor,p.currency) %></strong> (the purchase period ended on <%= p.ends_on %>).<%= r.holds.length?' Some purchases still need checking before the full rebate is known.':'' %></p><% } %>
<% if(!result.estimateOnly){ %><p>Claim window: <%= p.claim_on||'Needs confirmation' %> to <%= p.claim_by||'Needs confirmation' %>. <strong><%= r.claimReady?'Checked purchases ready for your claim review':p.enabled?'Review sources and claim window':'Tracking stopped' %>.</strong></p><p>Recorded external submissions: <%= displayMoney(r.submittedMinor,p.currency) %>. Checked benefit not yet submitted: <%= displayMoney(r.remainingClaimMinor,p.currency) %>.</p>
<% if(canTrack&&!editing&&!r.claims.length){ %><p><a href="/autopilot/supplier-benefits/<%= p.id %>?edit=1">Review or edit agreement terms</a></p><% } %>
<% if(!p.enabled&&canTrack&&!r.scopeReview){ %><form method="post" action="/autopilot/supplier-benefits/<%= p.id %>/resume"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="revision" value="<%= p.revision %>"><input type="hidden" name="expectedFingerprint" value="<%= r.sourceFingerprint %>"><label><input type="checkbox" name="confirmed" value="yes" required> Resume checking this same agreed contract, supplier and products. This does not submit claims or post money.</label><button class="btn">Resume tracking this agreement</button></form><% } %>
<details id="invoice-evidence"><summary>Purchases behind this calculation</summary><p>Page <%= sourcePage %> · <%= sourceTotal %> source invoices. Totals include every checked invoice in the selected period.</p><div class="table-scroll"><table><thead><tr><th>Invoice</th><th>Checked product amount</th><th>Review</th></tr></thead><tbody><% for(const bill of sourceRows){ %><tr><td><a href="/accounting/payables/<%= bill.id %>/review"><%= bill.bill_number %></a></td><td><%= displayMoney(bill.net_minor,bill.currency) %></td><td><%= bill.review||'Posted and matched' %><%= bill.return_adjustment&&!bill.review?' · Reconciled return deducted':'' %></td></tr><% } %></tbody></table></div><% if(sourcePage>1){ %><a href="/autopilot/supplier-benefits/<%= p.id %>?evidencePage=<%= sourcePage-1 %>#invoice-evidence">Previous invoices</a><% } %><% if(moreSources){ %><a href="/autopilot/supplier-benefits/<%= p.id %>?evidencePage=<%= sourcePage+1 %>#invoice-evidence">More invoices</a><% } %></details>
<% if(r.claimReady&&canTrack){ %><h3>Record a claim you already submitted</h3><form method="post" action="/autopilot/supplier-benefits/<%= p.id %>/claims" class="form-stack"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="requestKey" value="<%= requestKey %>"><input type="hidden" name="expectedFingerprint" value="<%= r.sourceFingerprint %>"><label class="rm-field"><span>Actual submitted amount</span><input name="amount" inputmode="decimal" required></label><label class="rm-field"><span>Actual claim reference</span><input name="externalReference" maxlength="200" required></label><label class="rm-field"><span>Actual submission date</span><input type="date" name="submittedOn" min="<%= p.claim_on %>" max="<%= r.today<p.claim_by?r.today:p.claim_by %>" required></label><label><input type="checkbox" name="confirmed" value="yes" required> I already submitted this claim outside StockChief. This records its reference only.</label><button class="btn">Record submitted claim</button></form><% } %>
<% if(claimView){ const v=claimView; %><section id="claims"><h3>Claims to the supplier</h3><p>When the purchase period ends, StockChief prepares the claim from these checked purchases and emails it to the supplier from your mailbox. Claims up to your limit go on their own. Larger claims, Ask me first and any change wait for you.</p>
<form method="post" action="/autopilot/supplier-benefits/<%= p.id %>/claim-settings" class="form-stack"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="revision" value="<%= p.revision %>">
<div class="rm-field"><label for="benefit-mailbox">Send claims from</label><select id="benefit-mailbox" name="connectorId"><option value="">Choose mailbox</option><% for(const box of v.mailboxes){ %><option value="<%= box.id %>" <%= p.connector_id===box.id?'selected':'' %>><%= box.display_name %></option><% } %></select></div>
<label class="rm-field"><span>Send claims on their own up to (leave empty to approve each one)</span><input name="claimLimit" inputmode="decimal" value="<%= v.claimLimit %>"></label>
<label class="rm-field"><span>Tell me when purchases are within this % of the next tier</span><input type="number" name="alertPercent" min="1" max="50" step="1" value="<%= p.alert_percent %>" required></label>
<label><input type="checkbox" name="confirmed" value="yes" required> Use this mailbox and limit for claims under this agreement.</label><button class="btn">Save claim settings</button></form>
<% if(v.canPrepare){ %><form method="post" action="/autopilot/supplier-benefits/<%= p.id %>/prepare-claim"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="btn">Prepare claim for <%= displayMoney(r.remainingClaimMinor,p.currency) %></button></form><% } %>
<% for(const claim of r.claims.filter(c=>['PREPARED','SENDING'].includes(c.status))){ const w=claim.source_snapshot.words; %><section class="card"><h4>Claim <%= claim.external_reference %> · <%= displayMoney(claim.amount_minor,p.currency) %></h4><p><%= claim.status==='PREPARED'?'Waiting for your approval.':'Sending from your mailbox.' %></p><% if(claim.problem){ %><p role="status"><%= claim.problem %></p><% } %>
<p>To <%= w.recipient %> · <%= w.subject %></p><pre style="white-space:pre-wrap;overflow-wrap:anywhere"><%= w.body %></pre>
<% if(claim.status==='PREPARED'){ %><form method="post" action="/autopilot/supplier-benefits/<%= p.id %>/claims/<%= claim.id %>/send"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="expectedEvidence" value="<%= claim.source_fingerprint %>"><label><input type="checkbox" name="confirmed" value="yes" required> Send this exact claim to <%= w.recipient %>.</label><button class="btn">Send claim to supplier</button></form>
<form method="post" action="/autopilot/supplier-benefits/<%= p.id %>/claims/<%= claim.id %>/discard"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><label><input type="checkbox" name="confirmed" value="yes" required> Discard this claim. Nothing was sent.</label><button class="btn">Discard claim</button></form><% } %></section><% } %>
</section><% } %>
<% if(r.claims.length){ %><h3>Claim history</h3><% for(const claim of r.claims){ %><section><p><strong><%= claim.external_reference %></strong> · <%= displayMoney(claim.amount_minor,p.currency) %> · <%= claim.submitted_on||'Not sent yet' %> · <%= ({PREPARED:'Waiting for your approval',SENDING:'Sending',SUBMITTED:claim.origin==='prepared'?'Sent to supplier':'Submitted externally',ACKNOWLEDGED:'Acknowledged by supplier',WITHDRAWN:'Withdrawn externally',CREDITED:'Credited by supplier'})[claim.status] %></p>
<% const credit=claimView?.credits[claim.id]; if(credit){ %><p>Credit notes matched: <%= displayMoney(claim.credited_minor,p.currency) %> of <%= displayMoney(claim.amount_minor,p.currency) %>.<% for(const c of credit.linked){ %> <%= c.credit_number||'Credit' %> (<%= c.credit_date %>, <%= displayMoney(c.amount_minor,p.currency) %><%= c.automatic?', matched by its reference':'' %>).<% } %></p>
<% if(claim.problem&&['SUBMITTED','ACKNOWLEDGED'].includes(claim.status)){ %><p role="status"><%= claim.problem %></p><% } %>
<% if(credit.open.length&&BigInt(claim.credited_minor)<BigInt(claim.amount_minor)){ %><form method="post" action="/autopilot/supplier-benefits/<%= p.id %>/claims/<%= claim.id %>/credit" class="form-stack"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><div class="rm-field"><label for="benefit-credit-<%= claim.id %>">Posted credit note for this claim</label><select id="benefit-credit-<%= claim.id %>" name="creditId" required><option value="">Choose credit note</option><% for(const c of credit.open){ %><option value="<%= c.id %>"><%= c.credit_number||c.id %> · <%= c.credit_date %> · <%= displayMoney(c.amount_minor,p.currency) %></option><% } %></select></div><label><input type="checkbox" name="confirmed" value="yes" required> This credit note is the supplier’s credit for claim <%= claim.external_reference %>.</label><button class="btn">Match credit note</button></form><% } %><% } %>
<% if(claim.acknowledgement_reference){ %><p>Supplier acknowledgement: <%= claim.acknowledgement_reference %> · <%= claim.acknowledgement_on %>. This is not proof of payment.</p><% } %>
<% if(claim.withdrawn_reference){ %><p>External withdrawal: <%= claim.withdrawn_reference %> · <%= claim.withdrawn_on %>.</p><% } %>
<% if(canTrack&&['SUBMITTED','ACKNOWLEDGED'].includes(claim.status)){ %><form method="post" action="/autopilot/supplier-benefits/<%= p.id %>/claims/<%= claim.id %>" class="form-stack"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="revision" value="<%= claim.revision %>"><div class="rm-field"><label for="benefit-status-<%= claim.id %>">Update to record</label><select id="benefit-status-<%= claim.id %>" name="status" required><option value="">Choose actual update</option><% if(claim.status==='SUBMITTED'){ %><option value="ACKNOWLEDGED">Supplier acknowledged the claim</option><% } %><option value="WITHDRAWN">I withdrew this claim externally</option></select></div><label class="rm-field"><span>Actual acknowledgement or withdrawal reference</span><input name="reference" maxlength="200" required></label><label class="rm-field"><span>Actual update date</span><input type="date" name="date" min="<%= claim.submitted_on %>" max="<%= r.today %>" required></label><label><input type="checkbox" name="confirmed" value="yes" required> This happened outside StockChief. I am recording the evidence, not receiving or posting money.</label><button class="btn">Record claim update</button></form><% } %></section><% } %><% } %>
<% } %></section><% } %>
<% if(programmes.length){ %><section class="card"><h2>Saved agreements</h2><% for(const p of programmes){ %><section><h3><% if(canTrack){ %><a href="/autopilot/supplier-benefits/<%= p.id %>"><%= p.title %></a><% }else{ %><%= p.title %><% } %></h3><p><%= p.supplier_name %> · <%= p.enabled?'Tracking enabled':'Stopped' %> · <%= p.starts_on %> to <%= p.ends_on %></p><% if(p.enabled){ %><form method="post" action="/autopilot/supplier-benefits/<%= p.id %>/stop"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="revision" value="<%= p.revision %>"><button class="btn">Stop tracking <%= p.title %></button></form><% } %></section><% } %><% if(moreProgrammes){ %><a href="/autopilot/supplier-benefits?after=<%= programmes[programmes.length-1].id %>">More saved agreements</a><% } %></section><% } %>
<% if(selected){ %><p><a href="/autopilot/supplier-benefits">All supplier benefits</a></p><% } %>
<p>AI credits used: 0. Calculations use checked records and exact agreement terms.</p>
