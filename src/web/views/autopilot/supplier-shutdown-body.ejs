<p><strong><%= facts.supplier.name %></strong> · <%= facts.location.name %> · <%= facts.scope.reference %></p>
<p>Last accepted order: <%= facts.scope.lastOrderDate %>. Closed <%= facts.scope.closedFrom %> through <%= facts.scope.closedThrough %>. Next possible delivery: <%= facts.scope.nextArrivalDate %>. Extra coverage chosen: <%= facts.scope.extraCoverDays %> days.</p>
<p>Uses recorded physical issues from <%= facts.historyFrom %> through the day before <%= facts.today %>. Estimates <%= facts.calculated.coverageDays %> days of coverage. <%= facts.calculated.method %></p>
<% if(facts.warnings.length){ %><aside class="notice"><strong>Review before purchasing</strong><ul><% for(const warning of facts.warnings){ %><li><%= warning.sku?warning.sku+': ':'' %><%= warning.reason %></li><% } %></ul></aside><% } %>
<div class="table-wrap"><table><thead><tr><th>Product</th><th>Expected use</th><th>On hand</th><th>Promised or held</th><th>Due in time</th><th>Stock units to buy</th><th>Purchase units</th><th>Estimated value</th></tr></thead><tbody>
<% for(const row of facts.calculated.rows){ const product=facts.products.find(p=>p.sku_id===row.skuId),position=facts.rows.find(p=>p.skuId===row.skuId); %><tr><td><%= product.code %><br><%= product.name %></td><td><%= row.expectedUnits %> <%= product.unit_label %></td><td><%= position.onHand %></td><td><%= position.committed %></td><td><%= position.incoming %></td><td><%= row.quantityUnits %></td><td><%= row.purchaseUnits %> <%= product.purchase_unit %></td><td><%= helpers.money(row.totalMinor,facts.supplier.currency) %></td></tr><% } %>
</tbody></table></div><p><strong>Estimated goods total: <%= helpers.money(facts.calculated.totalMinor,facts.supplier.currency) %>.</strong> Taxes and shipping are reviewed separately. Nothing has been ordered or sent by this calculation.</p>
