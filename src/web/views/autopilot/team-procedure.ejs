<h1><%= latest?.document.title||'Team procedure' %></h1><p>Drafts are written from the steps your team actually recorded. Staff see only the version that is published to them: by you, or on Pro and Custom by StockChief when you allow it. Procedure text grants no stock, purchasing or payment authority.</p>
<% if(problem){ %><p class="notice"><%= problem %></p><% } %><% if(shadow){ %><p class="notice">The first 14 days are Watch only. New drafts, update authority and staff publication are paused.</p><% } %>
<% if(current){ %><section class="card"><h2>Current owner-approved staff version</h2><p>Approved <%= helpers.dateTime(current.approved_at) %><%= current.automatic?' · published by StockChief on its own':'' %><%= current.edited?' · edited by you':'' %>.</p><p><a class="btn" href="/team-procedures/<%= procedure.id %>">Open approved staff procedure</a> <a href="/team-procedures/<%= procedure.id %>/document.txt">Download approved procedure</a></p>
<% const earlier=publications.filter(v=>v.id!==current.id); if(earlier.length){ %><details><summary>Earlier staff versions</summary><ul class="rm-list"><% for(const v of earlier){ %><li class="list-row"><span><%= v.title %><small><%= helpers.dateTime(v.approved_at) %> · <%= v.automatic?'published by StockChief':'published by '+(v.approver||'the owner') %><%= v.edited?' · edited':'' %></small></span>
<form method="post" action="/autopilot/team-procedures/<%= procedure.id %>/restore"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="publicationId" value="<%= v.id %>"><input type="hidden" name="expectedPublicationId" value="<%= current.id %>"><button class="btn btn--sm btn--ghost">Go back to this version</button></form></li><% } %></ul>
<p class="cell-sub">Going back stops StockChief publishing updates on its own until you allow it again.</p></details><% } %></section><% }else{ %><p>No version has been published to staff.</p><% } %>
<% if(latest){ %><section class="card"><h2>Latest private draft</h2><p><%= latest.automatic?'Written within the owner’s private update scope':'Individually saved' %> · <%= helpers.dateTime(latest.created_at) %> · Based on <%= latest.source_snapshot.examples.length %> verified examples.</p><%- include('team-procedure-body',{doc:latest.document}) %>
<details><summary>Recorded examples the draft used</summary><ul><% for(const example of evidence){ %><li><%= example.reference %> · <%= helpers.dateTime(example.recorded_at) %></li><% } %></ul><% if(evidenceHidden){ %><p>Some earlier source examples are outside the activity history included in this plan. A new publication needs source history available on the current plan.</p><% } %></details>
<form method="post" action="/autopilot/team-procedures/<%= procedure.id %>/publish" class="form-stack"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="versionId" value="<%= latest.id %>"><input type="hidden" name="documentHash" value="<%= latest.document_hash %>"><input type="hidden" name="expectedPublicationId" value="<%= current?.id||'' %>"><input type="hidden" name="requestKey" value="<%= requestKey %>">
<details><summary>Edit the text staff will see</summary><label class="rm-field"><span>Title</span><input name="title" maxlength="200" value="<%= latest.document.title %>"></label><label class="rm-field"><span>Steps, one per line</span><textarea name="steps" rows="<%= Math.min(14,latest.document.steps.length+2) %>"><%= latest.document.steps.join('\n') %></textarea></label><label class="rm-field"><span>What this achieves</span><textarea name="outcome" rows="2" maxlength="1000"><%= latest.document.outcome %></textarea></label></details>
<label class="rm-field"><span>Additional owner notes for staff</span><textarea name="ownerNotes" rows="3" maxlength="4000"><%= current?.approved_document.ownerNotes||'' %></textarea></label><label><input type="checkbox" name="confirmed" value="yes" required> I reviewed this exact procedure and my notes, and confirm this version for staff with access to its warehouse.</label><button class="btn" <%= shadow?'disabled':'' %>>Publish reviewed staff procedure</button></form></section><% } %>
<form method="post" action="/autopilot/team-procedures/preview"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="kind" value="<%= procedure.kind %>"><input type="hidden" name="locationId" value="<%= procedure.location_id %>"><input type="hidden" name="lookbackDays" value="<%= procedure.lookback_days %>"><button class="btn">Prepare updated private preview</button></form>
<section class="card"><h2>Keep the procedure current</h2><% if(plan==='growth'){ %><p><span class="badge">Pro</span> Growth prepares each procedure for your individual approval. Pro and Custom keep procedures current without training and can publish updates to staff on their own.</p><a class="btn" href="/settings/billing">Upgrade</a><% }else{ %><p>Updates use only this recorded workflow, its location and the saved lookback of <%= procedure.lookback_days %> days.</p><form method="post" action="/autopilot/team-procedures/<%= procedure.id %>/settings" class="form-stack"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="revision" value="<%= procedure.revision %>"><input type="hidden" name="sourceFingerprint" value="<%= freshFingerprint||'' %>"><label class="rm-field"><span>Days between private updates</span><input name="refreshDays" type="number" min="1" max="90" value="<%= procedure.refresh_days||'' %>" required></label><p><label><input type="checkbox" name="publish" value="yes" <%= procedure.auto_publish?'checked':'' %>> Publish updates to staff on their own when the way the team works changes. If you edited the staff text, StockChief asks you first.</label></p><p><label><input type="checkbox" name="confirmed" value="yes" required> I authorize procedure updates only for this workflow, location and lookback.</label></p><button class="btn" <%= shadow||!freshFingerprint?'disabled':'' %>>Enable private procedure updates</button></form><% if(procedure.enabled){ %><p class="cell-sub"><%= procedure.auto_publish?'Updates reach staff on their own.':'Updates stay private until you publish them.' %></p><% } %><% } %>
<% if(procedure.enabled){ %><form method="post" action="/autopilot/team-procedures/<%= procedure.id %>/settings"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="revision" value="<%= procedure.revision %>"><button class="btn" name="stop" value="yes">Stop private procedure updates</button></form><% } %></section><p>AI credits used: 0.</p>
