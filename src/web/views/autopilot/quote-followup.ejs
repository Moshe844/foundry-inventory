<% const q=quotation; %>
<p><a href="/autopilot/reviews/quote-followups">← Quote follow-ups</a></p><h1><%= q.quote_number %> follow-up</h1>
<p><%= q.customer_name %> · <%= q.status %> · Valid through <%= q.valid_until %></p>
<section class="card"><h2>The saved quotation</h2><p><a href="/quotes/<%= q.id %>">Open the full quotation</a></p>
<div class="table-wrap"><table><thead><tr><th>Product</th><th>Quantity</th><th>Unit price</th><th>Discount</th><th>Tax</th><th>Total</th></tr></thead><tbody><% q.pricing.lines.forEach(line=>{ %><tr><td><%= q.line_labels[line.skuId]||line.description||'Quoted product' %></td><td><%= line.quantity %></td><td><%= helpers.money(line.unitPriceMinor,q.pricing.currency) %></td><td><%= helpers.money(line.discountMinor||0,q.pricing.currency) %></td><td><%= helpers.money(line.taxMinor||0,q.pricing.currency) %></td><td><%= helpers.money(line.totalMinor,q.pricing.currency) %></td></tr><% }) %></tbody></table></div>
<p>Total: <strong><%= helpers.money(q.pricing.totalMinor,q.pricing.currency) %></strong></p><p>Delivery: <%= q.input.deliveryMethod==='SHIP'?'Ship to '+q.input.shipToAddress:'Customer pickup' %></p>
<% if(quoteHold){ %><p class="notice"><%= quoteHold %></p><% } %></section>
<% if(!quoteHold){ %>
<section class="card"><h2>When the customer received it</h2><p>Record an actual event. Saving a quotation alone does not establish that the customer received it. This confirmation records your evidence; it does not send a message.</p>
<% if(record){ %><p>Recorded date: <%= record.presented_date %>. Your reference: <%= record.presentation_evidence %>.</p><% } %>
<form method="post" action="/autopilot/quote-followups/<%= q.id %>/received" class="form-stack"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="requestKey" value="<%= formKey %>"><input type="hidden" name="revision" value="<%= record?.revision||0 %>"><input type="hidden" name="expectedHash" value="<%= q.pricing_hash %>">
<label class="rm-field"><span>Date the customer received this quote</span><input type="date" name="presentedOn" required value="<%= record?.presented_date||today %>" max="<%= today %>"></label>
<label class="rm-field"><span>How they received it</span><select name="channel" required><option value="">Choose the actual method</option><% for(const [value,label] of [['email','Email'],['in_person','In person'],['phone','By phone'],['customer_portal','Customer portal'],['post','Post']]){ %><option value="<%= value %>" <%= record?.presentation_channel===value?'selected':'' %>><%= label %></option><% } %></select></label>
<label class="rm-field"><span>Your delivery reference</span><textarea name="evidence" maxlength="1000" required rows="3"><%= record?.presentation_evidence||'' %></textarea></label>
<label><input type="checkbox" name="confirmed" value="yes" required> I confirm that this customer received this exact saved quotation on the date recorded.</label>
<button class="btn">Confirm customer received this quote</button><% if(record){ %><p>Correcting these details stops its existing scheduled follow-up. Review any message already queued.</p><% } %></form></section>
<% } %>
<% if(message){ %><section class="card"><h2>Follow-up delivery</h2><p><%= message.status %><%= message.error_message?' · '+message.error_message:'' %></p><a href="/messages/customer/<%= message.id %>">Track this follow-up</a><p>StockChief prepares one follow-up per quotation. Review its delivery before sending another message.</p></section><% }else if(record&&!quoteHold){ %>
<section class="card"><h2>Prepare one follow-up now</h2><% if(blocked){ %><p><%= blocked %></p><% }else if(!mailboxes.length){ %><p><a href="/connections">Connect a sending mailbox</a> before preparing a follow-up.</p><% }else{ %><form method="post" action="/autopilot/quote-followups/<%= q.id %>/prepare" class="form-stack"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><label class="rm-field"><span>Sending mailbox</span><select name="connectorId" required><% mailboxes.forEach(box=>{ %><option value="<%= box.id %>"><%= box.display_name %></option><% }) %></select></label><button class="btn">Preview follow-up</button></form><% } %></section>
<section class="card"><h2>Choose its follow-up date</h2><p>This schedules one message for this quotation. Growth needs a confirmed individual send and a taught scope for the chosen customer, products and mailbox. Your lower saved limits still apply on Pro and Custom.</p>
<% if(record.schedule_enabled){ %><p>Scheduled for <strong><%= record.due_date %></strong>, <%= record.followup_days %> days after the customer received it.</p><% } %>
<% if(routineBlocked){ %><p><%= routineBlocked %></p><% }else if(mailboxes.length){ %><form method="post" action="/autopilot/quote-followups/<%= q.id %>/schedule" class="form-stack"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="revision" value="<%= record.revision %>"><label class="rm-field"><span>Days after the customer received the quote</span><input name="days" type="number" min="1" max="365" required value="<%= record.followup_days||'' %>"></label><label class="rm-field"><span>Follow-up mailbox</span><select name="connectorId" required><% mailboxes.forEach(box=>{ %><option value="<%= box.id %>" <%= record.connector_id===box.id?'selected':'' %>><%= box.display_name %></option><% }) %></select></label><button class="btn">Schedule one follow-up</button></form><% } %>
</section><% } %>
<% if(record?.schedule_enabled){ %><form method="post" action="/autopilot/quote-followups/<%= q.id %>/schedule"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="revision" value="<%= record.revision %>"><button class="btn" name="remove" value="1">Stop this scheduled follow-up</button></form><% } %>
