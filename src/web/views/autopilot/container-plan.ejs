<h1><%= project.title %></h1><p><a href="/autopilot/container-plans">All container plans</a> · <%= project.container_spec.count %> × <%= project.container_spec.feet %> ft · Inside <%= project.container_spec.length %> × <%= project.container_spec.width %> × <%= project.container_spec.height %> mm · Cargo allowance <%= (project.container_spec.payload/1000).toFixed(3) %> kg each.</p>
<p>Uses only the selected purchase orders and checked carton profiles. This calculation records a conservative layout; it can leave usable space. The freight or warehouse team approves actual loading, securing and weight distribution. Purchasing, receiving and payments keep their separate approvals.</p>
<% if(shadow){ %><p class="notice">The first 14 days are Watch only. Agent recalculation and new authority are paused.</p><% } %>
<% if(problem||project.last_issue){ %><p class="notice"><%= problem||project.last_issue %></p><% } %>
<% if(latest){const r=latest.result; %><section class="card"><h2><%= current?'Current calculated load':'Earlier calculation · current order or packing facts changed' %></h2><p><strong><%= r.loaded %> cartons fit · <%= r.remaining %> cartons remain outside this load.</strong> Total cartons requested: <%= r.cartons %>.</p>
<p><%= latest.automatic?'Calculated within the owner’s routine scope':'Calculated on the owner’s request' %> · <%= latest.reviewed_at?'Individually reviewed':'Awaiting individual review' %> · <time data-local-time datetime="<%= new Date(latest.created_at).toISOString() %>"><%= helpers.dateTime(latest.created_at) %></time>.</p>
<div class="table-wrap"><table><thead><tr><th>Container</th><th>Cartons</th><th>Gross cargo</th><th>Volume used</th></tr></thead><tbody><% for(const load of r.loads){ %><tr><td><%= load.container %></td><td><%= load.cartons %></td><td><%= (load.weightGrams/1000).toFixed(3) %> / <%= (load.payloadGrams/1000).toFixed(3) %> kg</td><td><%= (Number(load.volumeMm3)/1e9).toFixed(3) %> / <%= (Number(load.capacityMm3)/1e9).toFixed(3) %> m³</td></tr><% } %></tbody></table></div>
<h3>Cartons by ordered product</h3><div class="table-wrap"><table><thead><tr><th>Order</th><th>SKU</th><th>Loaded cartons</th><th>Left outside</th></tr></thead><tbody><% for(const line of r.rows.slice(0,100)){const s=latest.source_snapshot.lines.find(s=>s.lineId===line.lineId); %><tr><td><%= s?.orderNumber %></td><td><%= s?.identity.code %></td><td><%= line.loaded %></td><td><%= line.remaining %></td></tr><% } %></tbody></table></div>
<% if(r.rows.length>100){ %><p>Showing the first 100 product lines. The complete layout is available below.</p><% } %><p><a class="btn" href="/autopilot/container-runs/<%= latest.id %>/manifest.csv">Download the complete carton layout (CSV)</a></p><p>Leftovers are kept on their original orders. A carton may be left out because of dimensions, available layout space, payload or supported stacking weight. There are no inferred loose cartons or changed order quantities.</p>
<% if(current&&!latest.reviewed_at){ %><form method="post" action="/autopilot/container-runs/<%= latest.id %>/review" class="form-stack"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="projectId" value="<%= project.id %>"><input type="hidden" name="sourceFingerprint" value="<%= latest.source_fingerprint %>"><label><input type="checkbox" name="confirmed" value="yes" required> I reviewed this exact calculation, the packing facts and every carton left outside the load.</label><button class="btn" <%= shadow?'disabled':'' %>>Mark this load plan reviewed</button></form><% } %></section><% } %>
<% if(!problem){ %><form method="post" action="/autopilot/container-plans/<%= project.id %>/recalculate"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="btn" <%= shadow?'disabled':'' %>>Recalculate from current order quantities</button></form><% } %>
<section class="card"><h2>Routine recalculation</h2><p><%= plan==='pro'?'Pro needs an individually reviewed load and a taught scope.':'Custom needs no training; it still requires your explicit authority.' %> Routine work recalculates only these selected orders, the same packing profiles and these fixed container limits, up to 2,000 whole cartons. It creates a plan record and changes no order, stock or money. New lines, changed units or updated packing facts stop for review.</p>
<% if(latest&&current){ %><form method="post" action="/autopilot/container-plans/<%= project.id %>/teach" class="form-stack"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="runId" value="<%= latest.id %>"><input type="hidden" name="ruleRevision" value="<%= rule?.revision||0 %>"><label><input type="checkbox" name="confirmed" value="yes" required> I teach only this individually reviewed planning group and its fixed container and packing limits.</label><button class="btn" <%= !latest.reviewed_at||shadow?'disabled':'' %>>Teach this reviewed container scope</button></form>
<form method="post" action="/autopilot/container-plans/<%= project.id %>/settings" class="form-stack"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="revision" value="<%= project.revision %>"><input type="hidden" name="sourceFingerprint" value="<%= currentFingerprint %>"><label><input type="checkbox" name="confirmed" value="yes" required> I authorize routine recalculation of only these selected orders with these exact carton measurements and container limits.</label><button class="btn" <%= shadow||plan==='pro'&&!rule?'disabled':'' %>>Enable routine container planning</button></form><% } %>
<% if(project.enabled){ %><form method="post" action="/autopilot/container-plans/<%= project.id %>/settings"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="revision" value="<%= project.revision %>"><button class="btn" name="stop" value="yes">Stop routine container planning</button></form><% } %>
<% if(rule){ %><form method="post" action="/autopilot/container-plans/<%= project.id %>/teach"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="ruleRevision" value="<%= rule.revision %>"><label><input type="checkbox" name="confirmed" value="yes" required> Remove the current taught scope and stop routine recalculation.</label><button class="btn" name="remove" value="yes">Remove taught container scope</button></form><% } %></section>
<% if(runs.length>1){ %><section class="card"><h2>Earlier recorded layouts</h2><ul><% for(const run of runs.filter(run=>run.id!==latest.id)){ %><li><%= helpers.dateTime(run.created_at) %> · <%= run.result.loaded %> cartons fitted, <%= run.result.remaining %> left outside · <a href="/autopilot/container-runs/<%= run.id %>/manifest.csv">Recorded carton layout</a></li><% } %></ul><p>Showing the most recent 20 calculations.</p></section><% } %><p>AI credits used: 0.</p>
