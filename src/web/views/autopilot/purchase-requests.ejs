<h1>Staff purchase requests</h1>
<form class="card form-stack" method="post" action="/purchasing/requests">
  <input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="requestKey" value="<%= requestKey %>">
  <label>What do you need? <input name="requestText" maxlength="240" placeholder="We need more packing tape" required></label>
  <label>Quantity, if known <input type="number" step="any" min="0.000001" name="quantity"></label>
  <label>Destination <select name="locationId" required><% if(locations.length!==1){ %><option value="">Choose a destination</option><% } %>
    <% locations.forEach(l=>{ %><option value="<%= l.id %>"><%= l.name %></option><% }); %></select></label>
  <label>Additional details <textarea name="reason" maxlength="700" rows="2"></textarea></label>
  <button class="btn btn--primary">Request purchase</button>
</form>
<% requests.forEach(r=>{ %><section class="card section"><h2><%= r.product %> &middot; <%= r.code %></h2>
  <p><%= r.requester %> requested <%= r.quantity===null?'more stock':r.quantity+' '+r.unit_label %> for <%= r.destination %>.</p>
  <p><%= r.reason %></p>
  <% if(r.status==='PENDING'&&canApprove){const choices=suppliers.get(r.sku_id)||[]; %>
    <form class="form-stack" method="post" action="/purchasing/requests/<%= r.id %>/decision"><input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <% if(choices.length){ %>
        <% if(r.quantity===null){ %><label>Quantity to purchase (<%= r.unit_label %>) <input type="number" step="any" min="0.000001" name="quantity" required></label><% } %>
        <% if(r.secondary_unit_label){ %><label>Order weight (<%= r.secondary_unit_label %>) <input type="number" step="any" min="0.000001" name="secondaryQuantity" required></label><% } %>
        <label>Linked supplier <select name="supplierId" required><option value="">Choose a supplier with a saved price</option>
          <% choices.forEach(s=>{ %><option value="<%= s.id %>"><%= s.name %></option><% }); %></select></label>
        <button class="btn" name="decision" value="approve">Approve and create draft PO</button>
      <% }else{ %><p>Link a supplier and save its price before approving this request.</p><% } %>
      <button class="btn" name="decision" value="decline" formnovalidate>Decline</button>
    </form>
  <% }else{ %><p><%= r.status==='PENDING'?'Waiting for approval':r.status==='APPROVED'?'Approved':'Declined' %>
    <% if(r.po_number&&canApprove){ %><a href="/purchasing/orders/<%= r.purchase_order_id %>"><%= r.po_number %></a><% } %></p><% } %>
</section><% }); %>
