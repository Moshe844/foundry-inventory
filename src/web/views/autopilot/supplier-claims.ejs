<div class="page-head"><div class="titles"><h1>Supplier delivery claims</h1><p>Prepare the evidence once and keep each delivery under one claim reference.</p></div></div>
<% if(locked){ %><section class="notice"><span class="badge">Pro</span> Supplier claims require Pro or Custom. <a class="btn" href="/settings/billing">Upgrade</a></section><% } %>
<p>Start with a <a href="/autopilot/delivery-checks">checked delivery shortage</a>, a <a href="/autopilot/delivery-quality">failed physical damage inspection</a> or units your team marked damaged when receiving. Pro needs a completed matching claim before routine work. Custom can authorize an exact scope without training. Portal submission and settlement decisions have separate steps.</p>
<% const stateText={DRAFT:'Draft, not sent',SENDING:'Waiting for the mailbox',WAITING:'Sent, waiting for the supplier',REPLIED:'The supplier replied',PART_SETTLED:'Partly settled',SETTLED:'Settled',CLOSED:'Closed'}; %>
<% if(saved){const p=saved.snapshot, shortage=p.claimKind==='shortage', report=p.claimKind==='report', pos=position; %><section class="card section"><h2><%= saved.reference %></h2><p><%= p.supplierName %> · <%= p.poNumber %> · <%= p.product %> · <%= shortage?p.missingUnits+' missing':p.damagedQuantity+' damaged' %> <%= p.unit %></p>
<p>Value at the purchase order price: <%= goodsCost %>. <%= p.remedy?'Asks for: '+remedies[p.remedy].toLowerCase()+'.':'Asks the supplier to propose a remedy.' %></p>
<% if(shortage){ %><p><a href="/autopilot/delivery-checks/<%= p.comparisonId %>">Original delivery comparison</a> · <a href="/purchasing/orders/<%= p.purchaseOrderId %>#receipts">Purchase order and receipts</a></p><% }else if(report){ %><p><a href="/autopilot/delivery-evidence/<%= p.receiptId %>">Staff damage report</a> · <a href="/purchasing/orders/<%= p.purchaseOrderId %>#receipts">Purchase order and receipts</a></p><% }else{ %><p>The physical count, original photos and purchase order remain the evidence. <a href="/autopilot/delivery-quality/<%= p.holdId %>">Inspection</a></p><% } %>
<% if(problem){ %><p class="notice"><%= problem %></p><% } %>
<p>To: <%= p.recipient %></p><h3><%= words.subject %></h3><p style="white-space:pre-wrap;overflow-wrap:anywhere"><%= words.body %></p>
<% if(!shortage&&!report){ %><h3>Selected photo copies</h3><% if(!p.photos.length){ %><p>No photos selected. This email uses the recorded physical findings only.</p><% } %><% for(const photo of p.photos){ %><p><a href="/autopilot/quality-photos/<%= photo.id %>?copy=email">Download email copy</a> · <a href="/autopilot/quality-photos/<%= photo.id %>">Download original</a> <%= photo.caption %></p><% } %><% } %>
<% if(delivery){ %><p><strong>Mailbox delivery: <%= delivery.status %></strong> <%= delivery.error_message||'' %> <%= delivery.provider_error||'' %></p><% if(delivery.provider_status==='AMBIGUOUS'){ %><p class="notice">Check the mailbox Sent folder. An uncertain send is never reset or resent automatically.</p><% } %><% } %>
<% if(editable){ %><details class="section"><summary>Change what this claim asks for</summary><form method="post" action="/autopilot/supplier-claims/preview" class="form-stack"><input type="hidden" name="_csrf" value="<%= csrfToken %>">
<% if(shortage){ %><input type="hidden" name="comparisonId" value="<%= p.comparisonId %>"><input type="hidden" name="lineId" value="<%= p.lineId %>"><input type="hidden" name="shortageConfirmed" value="yes"><% }else if(report){ %><input type="hidden" name="reportId" value="<%= p.reportId %>"><% }else{ %><input type="hidden" name="holdId" value="<%= p.holdId %>"><% } %>
<fieldset><legend>Ask the supplier for</legend><% for(const [value,label] of Object.entries(remedies)){ %><label><input type="radio" name="remedy" value="<%= value %>" <%= (p.remedy||'credit')===value?'checked':'' %> required> <%= label %></label> <% } %></fieldset>
<label class="rm-field"><span>Sending mailbox</span><select name="connectorId" required><% for(const box of mailboxes){ %><option value="<%= box.id %>" <%= box.id===p.connectorId?'selected':'' %>><%= box.display_name %></option><% } %></select></label>
<% if(photosToChoose.length){ %><p>Attach up to three photo copies:</p><% for(const photo of photosToChoose){ %><label><input type="checkbox" name="photoIds" value="<%= photo.id %>" <%= p.photos.some(x=>x.id===photo.id)?'checked':'' %>> <%= photo.filename %> <%= photo.caption %></label><% } %><% } %>
<button class="btn">Save changes for review</button></form></details><% } %>
<% if(!problem&&delivery?.status!=='SENT'&&delivery?.provider_status!=='AMBIGUOUS'){ %><form method="post" action="/autopilot/supplier-claims/<%= saved.id %>/send" class="form-stack"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="sourceFingerprint" value="<%= saved.source_fingerprint %>"><label class="rm-field"><span>If the supplier does not reply, remind them after (days)</span><input type="number" name="chaseAfterDays" min="1" max="60" step="1" value="<%= saved.chase_after_days||defaultChaseDays %>" required></label><label><input type="checkbox" name="confirmed" value="yes" required> I approve this exact recipient, message, claim quantity, goods value and evidence. Credits, write-offs, settlements and payments require separate approval.</label><button class="btn btn--primary" <%= shadow?'disabled':'' %>>Send this claim once</button></form><% } %>
<% if(pos&&pos.sentAt){ %><section class="section"><h3>Follow-through: <%= stateText[pos.state] %></h3>
<p>Sent <%= helpers.dateTime(pos.sentAt) %>. <% if(pos.state==='WAITING'){ %><%= pos.chases.length<maxChases?'Next reminder due '+helpers.dateTime(pos.nextChaseAt)+'.':'No reply after '+maxChases+' reminders. Call or write to the supplier.' %><% } %></p>
<% if(pos.chases.length){ %><ul><% for(const c of pos.chases){ %><li>Reminder <%= c.number %> · <%= c.status==='SENT'?'sent '+helpers.dateTime(c.sent_at):c.status.toLowerCase() %><%= c.automatic?' under your claim rule':'' %></li><% } %></ul><% } %>
<% if(pos.replies.length){ %><h4>Supplier replies</h4><ul><% for(const m of pos.replies){ %><li><a href="/mail/<%= m.id %>"><%= m.subject||'(no subject)' %></a> · <%= helpers.dateTime(m.received_at) %></li><% } %></ul><% } %>
<% if(pos.credits.length){ %><h4>Credit notes</h4><ul><% for(const c of pos.credits){ %><li><%= c.credit_number||'Credit' %> · <%= helpers.money(Number(c.amount_minor),c.currency) %> on bill <%= c.bill_number %> · <%= c.valid?(c.linked?'linked by you':'names this claim'):'not counted: check the posting, currency or other claims' %></li><% } %></ul><% } %>
<% if(pos.replacements.length){ %><h4>Replacement goods</h4><ul><% for(const x of pos.replacements){ %><li><%= Number(x.quantity) %> <%= p.unit %> received <%= helpers.dateTime(x.received_at) %> on <%= x.po_number %><%= x.settlement_id?' · linked by you':'' %></li><% } %></ul><% } %>
<p><strong><%= helpers.money(pos.remainingMinor,p.currency) %> still owed</strong> of <%= goodsCost %>.<% if(pos.outcome){ %> Closed: <%= outcomes[pos.outcome].toLowerCase() %><%= pos.outcomeDetail?.amountMinor?' · '+helpers.money(pos.outcomeDetail.amountMinor,p.currency)+' ('+pos.outcomeDetail.reference+')':'' %>.<% } %></p>
<% if(pos.state==='WAITING'&&!pos.pendingChase&&pos.chases.length<maxChases){ %><form method="post" action="/autopilot/supplier-claims/<%= saved.id %>/remind" class="form-stack"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="number" value="<%= pos.chases.length+1 %>"><label><input type="checkbox" name="confirmed" value="yes" required> Send reminder <%= pos.chases.length+1 %> of <%= maxChases %> to <%= p.recipient %> now.</label><button class="btn" <%= shadow?'disabled':'' %>>Send reminder now</button></form><% } %>
<% if(pos.state!=='CLOSED'&&pos.state!=='SETTLED'){ %>
<% if(candidates.credits.length){ %><form method="post" action="/autopilot/supplier-claims/<%= saved.id %>/link" class="form-stack"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><label class="rm-field"><span>Posted credit note from <%= p.supplierName %></span><select name="creditId" required><% for(const c of candidates.credits){ %><option value="<%= c.id %>"><%= c.credit_number||'Credit' %> · <%= helpers.money(Number(c.amount_minor),p.currency) %> · bill <%= c.bill_number %></option><% } %></select></label><label><input type="checkbox" name="confirmed" value="yes" required> This credit note answers this claim.</label><button class="btn">Link credit note</button></form><% } %>
<% if(candidates.receipts.length){ %><form method="post" action="/autopilot/supplier-claims/<%= saved.id %>/link" class="form-stack"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><label class="rm-field"><span>Later delivery of <%= p.sku %></span><select name="receiptLineId" required><% for(const x of candidates.receipts){ %><option value="<%= x.id %>"><%= Number(x.quantity) %> <%= p.unit %> · <%= x.po_number %> · <%= helpers.dateTime(x.received_at) %></option><% } %></select></label><label><input type="checkbox" name="confirmed" value="yes" required> These goods replace the claimed units.</label><button class="btn">Link replacement goods</button></form><% } %>
<details class="section"><summary>Close this claim</summary><form method="post" action="/autopilot/supplier-claims/<%= saved.id %>/close" class="form-stack"><input type="hidden" name="_csrf" value="<%= csrfToken %>">
<fieldset><legend>How did it end?</legend><% for(const [value,label] of Object.entries(outcomes)){ %><label><input type="radio" name="outcome" value="<%= value %>" required> <%= label %></label> <% } %></fieldset>
<label class="rm-field"><span>Refund amount (<%= p.currency %>), for a refund</span><input name="amount" inputmode="decimal"></label><label class="rm-field"><span>Supplier payment reference, for a refund</span><input name="reference" maxlength="120"></label>
<label class="rm-field"><span>Note</span><input name="note" maxlength="500"></label><label><input type="checkbox" name="confirmed" value="yes" required> Close this claim. Nothing is posted or paid.</label><button class="btn">Close claim</button></form></details>
<form method="post" action="/autopilot/supplier-claims/<%= saved.id %>/reminders" class="form-stack"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><label class="rm-field"><span>Days between reminders</span><input type="number" name="chaseAfterDays" min="1" max="60" step="1" value="<%= pos.chaseAfterDays %>" required></label><button class="btn">Save reminder delay</button></form>
<% } %></section><% } %>
<% if(!problem){ %><section class="section"><h3>Authorize matching routine claims</h3><% if(plan==='pro'&&!manualExampleReady&&!matchingRule?.example_id){ %><p>First send this exact claim with your individual approval. Pro learns only from a completed mailbox acceptance.</p><% } %>
<form method="post" action="/autopilot/supplier-claims/<%= saved.id %>/authority" class="form-stack"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><% if(matchingRule){ %><input type="hidden" name="ruleId" value="<%= matchingRule.id %>"><input type="hidden" name="revision" value="<%= matchingRule.revision %>"><% } %><input type="hidden" name="exampleId" value="<%= matchingRule?.example_id||saved.id %>">
<p>This applies only to the supplier, product, receiving location, connected mailbox and request shown above. Every message checks current plan and authority again.</p>
<label class="rm-field"><span>Maximum <%= shortage?'missing':'damaged' %> units per claim</span><input type="number" name="maxUnits" min="<%= shortage?(p.weightUnit?0:10**(-p.quantityPrecision)):1 %>" max="100000" step="<%= shortage?10**(-p.quantityPrecision):1 %>" required></label>
<% if(shortage&&p.weightUnit){ %><label class="rm-field"><span>Maximum missing <%= p.weightUnit %> per claim</span><input name="maxWeight" inputmode="decimal" required></label><% } %>
<label class="rm-field"><span>Maximum recorded goods cost per claim (<%= p.currency %>)</span><input name="maxValue" inputmode="decimal" required></label>
<label class="rm-field"><span>Maximum recorded goods cost per rolling seven days (<%= p.currency %>)</span><input name="maxWeekly" inputmode="decimal" required></label>
<label class="rm-field"><span>Maximum delivery age in days</span><input type="number" name="maxAgeDays" min="1" max="365" step="1" required></label>
<label class="rm-field"><span>Remind the supplier after (days without a reply)</span><input type="number" name="chaseAfterDays" min="1" max="60" step="1" value="<%= matchingRule?.scope?.chaseAfterDays||defaultChaseDays %>" required></label>
<% if(!shortage&&!report){ %><label><input type="checkbox" name="includePhotos" value="yes"> Attach up to three saved inspection photo copies. If there are more, ask me to select them.</label><% } %><label><input type="checkbox" name="confirmed" value="yes" required> I authorize this exact scope and limits. A person still checks the actual delivery. Settlement and accounting decisions need separate approval.</label>
<button class="btn" <%= !routineReady||plan==='pro'&&!manualExampleReady&&!matchingRule?.example_id?'disabled':'' %>>Authorize bounded routine claims</button></form>
<% if(matchingRule&&routineReady&&!saved.communication_id){ %><form method="post" action="/autopilot/supplier-claims/<%= saved.id %>/routine" class="section"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="ruleId" value="<%= matchingRule.id %>"><button class="btn">Apply current routine authority</button></form><% } %></section><% } %></section><% } %>
<section class="card section"><h2>Recorded claims</h2><% if(!rows.length){ %><p>No claims prepared yet. Open a checked delivery shortage, a failed inspection or a staff damage report to start.</p><% } %><% for(const r of rows){ %><p><a href="/autopilot/supplier-claims/<%= r.id %>"><%= r.reference %></a> · <%= r.claim_kind==='shortage'?'Shortage':'Damage' %> · <%= r.outcome?'Closed':r.sent?'Sent':'Draft' %> · <%= helpers.dateTime(r.created_at) %></p><% } %></section>
<section class="card section"><h2>Routine scopes</h2><% for(const r of rules){ %><article class="section"><h3><%= r.scope.supplierName %> · <%= r.scope.product %> · <%= r.scope.location %></h3><p><%= r.enabled?'Enabled within current plan and routine authority':'Stopped' %> · up to <%= r.scope.maxShortUnits??r.max_units %> <%= r.scope.claimKind==='shortage'?'missing':'damaged' %> units per claim<% if(r.scope.maxShortWeight!=null){ %> and <%= r.scope.maxShortWeight %> <%= r.scope.weightUnit %><% } %> · deliveries up to <%= r.max_age_days %> days old · <%= r.include_photos?'Attach recorded photo copies':'Text-only claims' %><% if(r.scope.remedy){ %> · asks for <%= remedies[r.scope.remedy].toLowerCase() %><% } %><% if(r.scope.chaseAfterDays){ %> · reminders after <%= r.scope.chaseAfterDays %> days<% } %></p><p>Recorded goods cost limit: <%= helpers.money(Number(r.max_value_minor),r.currency) %> per claim and <%= helpers.money(Number(r.max_weekly_minor),r.currency) %> per rolling seven days.</p><% if(r.enabled){ %><form method="post" action="/autopilot/supplier-claim-rules/<%= r.id %>/stop"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="revision" value="<%= r.revision %>"><button class="btn">Stop future claims</button></form><% } %></article><% } %></section><p>AI credits used: 0.</p>
