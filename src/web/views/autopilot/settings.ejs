<div class="page-head">
  <div class="titles">
    <h1>Automatic work</h1>
    <div class="page-sub">Choose the simple default. Open Custom only when you want to tune the limits.</div>
  </div>
</div>

<div class="card section">
  <div class="card-head">
    <h2>How should Foundry work?</h2>
    <span class="spacer"></span>
    <% if (state.paused) { %><span class="badge badge--danger">Paused</span><% } %>
    <% if (state.suspended) { %><span class="badge badge--danger">Stopped itself</span><% } %>
  </div>
  <div class="card-body">
    <p class="lede"><strong>Currently: <%= state.modeLabel %>.</strong> <%= state.modeBlurb %></p>
    <% if (state.suspended) { %><p class="is-warn"><%= state.suspendedReason %></p><% } %>

    <form method="post" action="/autopilot/mode">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <div class="grid grid--2">
        <button class="authority-choice <%= state.mode === 'SUPERVISED' ? 'is-selected' : '' %>" type="submit" name="mode" value="SUPERVISED" <%= canOperate ? '' : 'disabled' %>>
          <strong>Ask me first</strong>
          <span>Foundry watches and recommends. It makes consequential changes only after you approve them.</span>
        </button>
        <button class="authority-choice <%= state.mode === 'POLICY_AUTOMATED' ? 'is-selected' : '' %>" type="submit" name="mode" value="POLICY_AUTOMATED" <%= canOperate ? '' : 'disabled' %>>
          <strong>Handle routine work</strong>
          <span>Foundry performs safe routine work inside limits you approved and asks about everything else.</span>
        </button>
      </div>
    </form>
    <% if (state.mode === 'POLICY_AUTOMATED') { %>
      <form method="post" action="/autopilot/routine-authority" class="routine-setup" data-busy>
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <div class="routine-setup__head">
          <div>
            <h3>Foundry may automatically:</h3>
            <p>Choose only the routine work you want Foundry to handle. Nothing is enabled unless you select it and save these limits.</p>
          </div>
          <% if (routine.hasGuidedAuthority) { %><span class="badge badge--ok">Limits approved</span><% } %>
        </div>

        <% if (routine.transfer.enabled || routine.purchasing.enabled) { %>
          <div class="notice notice--success routine-current">
            <strong>Currently approved:</strong>
            <% if (routine.transfer.enabled) { %>
              transfers of no more than <strong><%= routine.transfer.maximumQuantity %> units at a time</strong><%= routine.purchasing.enabled ? '; ' : '.' %>
            <% } %>
            <% if (routine.purchasing.enabled) { %>
              purchase orders of no more than <strong>$<%= Number(routine.purchasing.maximumValue).toLocaleString('en-US') %></strong>
              may be approved and recorded as ordered in Foundry for
              <strong><%= routine.purchasing.supplierIds.length %> selected supplier<%= routine.purchasing.supplierIds.length === 1 ? '' : 's' %></strong>.
            <% } %>
            Everything outside these limits comes to you first.
          </div>
        <% } else { %>
          <p class="routine-current muted"><strong>Nothing is enabled yet.</strong> Foundry will keep asking before it moves stock or places an order.</p>
        <% } %>

        <div class="routine-capabilities">
          <section class="routine-capability <%= routine.transfer.enabled ? 'is-enabled' : '' %>">
            <label class="routine-capability__choice" for="routine-transfers">
              <input id="routine-transfers" type="checkbox" name="enableTransfers" value="1"
                     <%= routine.transfer.enabled ? 'checked' : '' %> <%= locations.length > 1 && canAdmin ? '' : 'disabled' %>>
              <span><strong>Move stock between my locations</strong><small>Only when one location risks running out, another can safely supply it, and the demand evidence is reliable.</small></span>
            </label>
            <% if (locations.length > 1) { %>
              <label class="field routine-capability__limits">
                <span class="field-label">Automatic transfers: never more than</span>
                <span class="routine-limit"><input class="input" type="number" name="maximumQuantity" value="<%= routine.transfer.maximumQuantity %>" min="1" max="100000" required> <span>units at a time</span></span>
              </label>
            <% } else { %>
              <p class="field-help routine-capability__limits">Add a second active location before Foundry can transfer stock.</p>
            <% } %>
          </section>

          <section class="routine-capability <%= routine.purchasing.enabled ? 'is-enabled' : '' %>">
            <label class="routine-capability__choice" for="routine-purchasing">
              <input id="routine-purchasing" type="checkbox" name="enablePurchasing" value="1"
                     <%= routine.purchasing.enabled ? 'checked' : '' %> <%= suppliers.length && canAdmin ? '' : 'disabled' %>>
              <span><strong>Approve routine purchase orders</strong><small>Foundry may create the PO and record it as ordered when the replenishment evidence, supplier rules, price and limits all pass.</small></span>
            </label>
            <% if (suppliers.length) { %>
              <div class="routine-capability__limits">
                <label class="field">
                  <span class="field-label">Automatic purchases: never more than</span>
                  <span class="routine-limit"><span>$</span><input class="input" type="number" name="maximumValue" value="<%= routine.purchasing.maximumValue %>" min="0.01" step="0.01" required> <span>per order</span></span>
                </label>
                <fieldset class="field routine-suppliers">
                  <legend class="field-label">Approved suppliers</legend>
                  <% suppliers.forEach(function (supplier) { %>
                    <label class="check"><input type="checkbox" name="supplierScope" value="<%= supplier.id %>" <%= routine.purchasing.supplierIds.includes(supplier.id) ? 'checked' : '' %>> <%= supplier.name %></label>
                  <% }) %>
                </fieldset>
                <p class="field-help"><strong>No supplier connection is active.</strong> “Ordered” is recorded inside Foundry; this version does not email, upload or transmit the PO to the supplier.</p>
              </div>
            <% } else { %>
              <p class="field-help routine-capability__limits">Add an active supplier before Foundry can reorder.</p>
            <% } %>
          </section>
        </div>

        <p class="routine-safety"><strong>Foundry will still ask you</strong> about counts, corrections, uncertain matches, work outside these limits, or anything that fails a safety check.</p>
        <% if (routine.otherActivePolicies.length) { %>
          <p class="notice notice--info"><strong><%= routine.otherActivePolicies.length %> additional Custom <%= routine.otherActivePolicies.length === 1 ? 'policy is' : 'policies are' %> active.</strong> Those approved limits also remain in force until you stop them under Custom.</p>
        <% } %>
        <button class="btn btn--primary" type="submit" <%= canAdmin ? '' : 'disabled' %>><%= routine.hasGuidedAuthority ? 'Save routine-work limits' : 'Start handling routine work' %></button>
      </form>
    <% } %>
  </div>
</div>

<details class="card section advanced-settings" id="advanced-authority" <%= advanced ? 'open' : '' %>>
  <summary class="card-head"><span><strong>Custom</strong><span class="muted"> — Advanced policies, preferences and hard limits</span></span></summary>
  <div class="card-body">
    <div class="act-row">
      <div><strong>Watch only</strong><p>Foundry explains what it sees but prepares or changes nothing.</p></div>
      <form method="post" action="/autopilot/mode"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="btn btn--sm <%= state.mode === 'OBSERVE' ? 'btn--primary' : '' %>" type="submit" name="mode" value="OBSERVE" <%= canOperate ? '' : 'disabled' %>>Use watch only</button></form>
    </div>
  </div>

<div class="card section">
  <div class="card-head">
    <h2>What Foundry may do on its own</h2>
    <span class="spacer"></span>
    <%# "Active" describes the policy, not what is happening. A policy only ever
        fires when Foundry is also set to run the inventory, so saying "active"
        beside "It changes nothing" was two true statements that read as a
        contradiction. %>
    <span class="badge badge--muted"><%= policies.filter(function (p) { return p.isActive; }).length %> approved</span>
  </div>
  <div class="card-body">
    <% if (!policies.length) { %>
      <p class="lede">Nothing. Foundry prepares work and waits for you on all of it.</p>
    <% } else if (!state.canAutomate) { %>
      <p class="lede muted">
        <% if (state.paused) { %>
          These are approved, but Foundry is paused, so none of them are doing anything.
        <% } else { %>
          These limits are approved, but Foundry is set to <strong><%= state.modeLabel.toLowerCase() %></strong> —
          it still brings this work to you. Choose “Handle routine work” above for them to take effect.
        <% } %>
      </p>
    <% } %>
    <% policies.forEach(function (policy) { %>
      <div class="act-row">
        <span class="act-place">
          <a href="/autopilot/policies/<%= policy.id %>"><strong><%= policy.name %></strong></a>
          <span class="badge badge--<%= policy.isActive && state.canAutomate ? 'ok' : 'muted' %>">
            <%= !policy.isApproved ? 'not approved'
                 : !policy.isActive ? 'off'
                 : state.canAutomate ? 'in force'
                 : state.paused ? 'approved · paused'
                 : 'approved · not running yet' %>
          </span>
          <div class="muted"><%= describe(policy).join(' ') %></div>
        </span>
        <span class="act-move">
          <% if (policy.isActive) { %>
            <form method="post" action="/autopilot/policies/<%= policy.id %>/disable"
                  data-confirm="Disable <%= policy.name %>? Nothing new will happen under it.">
              <input type="hidden" name="_csrf" value="<%= csrfToken %>">
              <button class="btn btn--sm btn--ghost" type="submit">Stop this</button>
            </form>
          <% } %>
        </span>
      </div>
    <% }) %>
  </div>
</div>

<%# Item 6: say it in your own words and read back what it would mean. %>
<% if (reviewAll) { %>
  <div class="notice notice--info section">
    <strong>“Handle everything” is a policy review, never unlimited permission.</strong>
    Foundry can safely prepare work and investigate without authority. Automatic transfers and routine purchase-order approval each need their own limits below. Counts, ambiguous identities and destructive changes always remain human decisions.
  </div>
<% } %>
<%
  /*
   * Everything below this line is the advanced half.
   *
   * The customer-facing choice is two options — ask me first, or handle routine
   * work inside limits I approve — and it is answered at the top of this page.
   * What followed was eight more cards of equal weight: writing policies in
   * prose, the compiled policy for review, balancing rules, replenishment
   * approval rules, hard limits and running preferences. Each is real and some
   * owner wants every one of them, but presented as siblings of the choice they
   * make the choice look unfinished — as though picking one of two options had
   * left eight more things to fill in before Foundry would do anything.
   *
   * One heading is enough to say these are for people who want the exact rules.
   */
%>
<div class="section-head" style="margin-top:40px;">
  <h2>Advanced controls</h2>
</div>
<p class="page-sub" style="margin-bottom:20px;">
  Exact policies, hard limits and preferences. The choice above works without any of this.
</p>

<form method="post" action="/autopilot/policies/read" class="card section" data-busy>
  <div class="card-head"><h2>Tell Foundry what it may handle</h2></div>
  <div class="card-body">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <label class="field">
      <span class="field-label">In your own words</span>
      <input class="input" type="text" name="instruction" maxlength="600"
             placeholder="You can move stock between Brooklyn and New Jersey when one is running out, but never more than 20 at a time">
      <span class="field-help">Foundry writes the policy. You read it and decide.</span>
    </label>
  </div>
  <div class="card-foot">
    <button class="btn" type="submit" <%= canAdmin ? '' : 'disabled' %>>Read this back to me</button>
  </div>
</form>

<% if (drafted && drafted.understood) { %>
  <form method="post" action="/autopilot/policies" class="card section">
    <div class="card-head"><h2>Here is the policy I would write</h2></div>
    <div class="card-body">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <input type="hidden" name="name" value="<%= drafted.draft.name %>">
      <input type="hidden" name="actionType" value="<%= drafted.draft.allowedActionTypes[0] %>">
      <% (drafted.draft.locationScope || []).forEach(function (id) { %>
        <input type="hidden" name="locationScope" value="<%= id %>">
      <% }) %>
      <% (drafted.draft.supplierScope || []).forEach(function (id) { %>
        <input type="hidden" name="supplierScope" value="<%= id %>">
      <% }) %>
      <p class="lede"><strong><%= drafted.draft.name %></strong></p>
      <% if (drafted.preview.length) { %>
        <ul class="plain-list">
          <% drafted.preview.forEach(function (line) { %><li><%= line %></li><% }) %>
        </ul>
      <% } %>
      <% if (drafted.questions.length) { %>
        <h3 class="sub-head">Before this can be written</h3>
        <ul class="plain-list">
          <% drafted.questions.forEach(function (question) { %><li class="is-warn"><%= question %></li><% }) %>
        </ul>
      <% } %>
      <% if (drafted.draft.allowedActionTypes[0] === 'approve_purchase_order') { %>
        <label class="field"><span class="field-label">Never commit more than</span>
          <input class="input" type="number" name="maximumValue" value="<%= drafted.draft.maximumValue || '' %>" min="1" step="0.01" required>
          <span class="field-help">on one purchase order.</span></label>
        <label class="field"><span class="field-label">Maximum known unit-price increase</span>
          <input class="input" type="number" name="maxUnitPriceChangePercent"
                 value="<%= drafted.draft.thresholds.maxUnitPriceChangePercent === undefined ? '' : drafted.draft.thresholds.maxUnitPriceChangePercent %>" min="0" step="0.1" required>
          <span class="field-help">percent; anything higher comes to you.</span></label>
      <% } else { %>
        <label class="field">
          <span class="field-label">Never move more than</span>
          <input class="input" type="number" name="maximumQuantity"
                 value="<%= drafted.draft.maximumQuantity || '' %>" min="1" required>
          <span class="field-help">units in one go.</span>
        </label>
      <% } %>
      <p class="muted">
        Foundry chose none of the safety conditions itself — every policy written this way carries all of
        them. Nothing happens until you approve it.
      </p>
    </div>
    <div class="card-foot">
      <button class="btn btn--primary" type="submit" <%= canAdmin ? '' : 'disabled' %>>Write this policy</button>
    </div>
  </form>
<% } %>

<%# Balancing moves stock between locations. Offering it to an inventory with
    one location invites somebody to write a policy that can never fire, and
    then wonder why Foundry never does anything. Say why instead. %>
<% if (locations.length < 2) { %>
  <div class="card section">
    <div class="card-head"><h2>Let Foundry balance your warehouses</h2></div>
    <div class="card-body">
      <p class="lede">
        This needs somewhere to move stock <em>to</em>.
        <%= locations.length === 1 ? locations[0].name + ' is the only location in this inventory' : 'This inventory has no locations yet' %>,
        so there is nothing to balance yet.
      </p>
      <p class="muted">
        Add a second location and Foundry can keep them level — moving stock when one is running out
        and the other has plenty, within a limit you set.
      </p>
    </div>
    <div class="card-foot">
      <a class="btn" href="/locations">Add a location</a>
    </div>
  </div>
<% } else { %>
<form method="post" action="/autopilot/policies" class="card section">
  <div class="card-head"><h2>Let Foundry balance your warehouses</h2></div>
  <div class="card-body">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <p class="lede">
      Foundry can move stock between your own locations when one is running out and another has plenty.
      Nothing leaves the business, the total never changes, and a wrong one is undone by moving it back.
    </p>
    <label class="field">
      <span class="field-label">Call it</span>
      <input class="input" type="text" name="name" value="Automatic warehouse balancing" maxlength="120">
    </label>
    <label class="field">
      <span class="field-label">Never move more than</span>
      <input class="input" type="number" name="maximumQuantity" value="12" min="1" required>
      <span class="field-help">units in one go. Anything bigger comes to you.</span>
    </label>
    <label class="field">
      <span class="field-label">At most</span>
      <input class="input" type="number" name="dailyLimit" min="1" placeholder="5">
      <span class="field-help">of these a day (optional).</span>
    </label>
    <fieldset class="field">
      <span class="field-label">Between these locations</span>
      <% locations.forEach(function (location) { %>
        <label class="check">
          <input type="checkbox" name="locationScope" value="<%= location.id %>" checked>
          <%= location.name %>
        </label>
      <% }) %>
    </fieldset>
    <p class="muted">
      Foundry will only do it when the destination is measurably about to run out and the source keeps
      enough for its own demand. You will see every move and can stop this at any time.
    </p>
  </div>
  <div class="card-foot">
    <button class="btn btn--primary" type="submit" <%= canAdmin ? '' : 'disabled' %>>Write this policy</button>
  </div>
</form>
<% } %>

<% if (suppliers.length) { %>
<form method="post" action="/autopilot/policies" class="card section">
  <div class="card-head"><h2>Let Foundry approve routine replenishment</h2></div>
  <div class="card-body">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <input type="hidden" name="actionType" value="approve_purchase_order">
    <p class="lede">Foundry may approve an order only when measured demand supports it, incoming stock does not already cover it, supplier pack rules pass, and price stays inside your limit.</p>
    <label class="field"><span class="field-label">Call it</span>
      <input class="input" type="text" name="name" value="Routine replenishment purchasing" maxlength="120" required></label>
    <label class="field"><span class="field-label">Never commit more than</span>
      <input class="input" type="number" name="maximumValue" value="500" min="1" step="0.01" required>
      <span class="field-help">on one order. Anything larger comes to Needs you.</span></label>
    <label class="field"><span class="field-label">Maximum known unit-price increase</span>
      <input class="input" type="number" name="maxUnitPriceChangePercent" value="5" min="0" step="0.1" required>
      <span class="field-help">percent. A larger change becomes a price exception.</span></label>
    <fieldset class="field"><span class="field-label">Only these suppliers</span>
      <% suppliers.forEach(function (supplier) { %><label class="check"><input type="checkbox" name="supplierScope" value="<%= supplier.id %>"> <%= supplier.name %></label><% }) %>
    </fieldset>
    <p class="muted">Foundry records the evidence and policy version on every automatic approval. Receiving remains a physical confirmation.</p>
  </div>
  <div class="card-foot"><button class="btn btn--primary" type="submit" <%= canAdmin ? '' : 'disabled' %>>Write this policy</button></div>
</form>
<% } %>

<form method="post" action="/autopilot/limits" class="card section">
  <div class="card-head"><h2>Hard limits</h2></div>
  <div class="card-body">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <p class="muted">These apply whatever any policy says.</p>
    <div class="grid grid--2">
      <label class="field">
        <span class="field-label">Automatic actions a day</span>
        <input class="input" type="number" name="maxActionsPerDay" value="<%= limits.maxActionsPerDay %>" min="0">
      </label>
      <label class="field">
        <span class="field-label">Units in one action</span>
        <input class="input" type="number" name="maxUnitsPerAction" value="<%= limits.maxUnitsPerAction %>" min="1">
      </label>
      <label class="field">
        <span class="field-label">Hours before touching the same product again</span>
        <input class="input" type="number" name="cooldownHours" value="<%= limits.cooldownHours %>" min="0">
      </label>
      <label class="field">
        <span class="field-label">Times one product may be moved per week</span>
        <input class="input" type="number" name="maxActionsPerItemPerWeek" value="<%= limits.maxActionsPerItemPerWeek %>" min="0">
      </label>
    </div>
  </div>
  <div class="card-foot">
    <button class="btn" type="submit" <%= canAdmin ? '' : 'disabled' %>>Save limits</button>
  </div>
</form>

<%# Item 26: preferences, only ever because somebody said so. %>
<form method="post" action="/autopilot/preferences" class="card section">
  <div class="card-head"><h2>How you want this inventory run</h2></div>
  <div class="card-body">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <p class="muted">
      Foundry never works these out from watching you. It uses what you set here and nothing else —
      leave one blank and it uses its own judgement.
    </p>
    <%
      var current = {};
      preferences.forEach(function (pref) { current[pref.key] = pref.value; });
    %>
    <div class="grid grid--2">
      <% preferenceKeys.forEach(function (definition) { %>
        <label class="field">
          <span class="field-label"><%= definition.label %></span>
          <% if (definition.kind === 'boolean') { %>
            <select class="input" name="<%= definition.key %>">
              <option value="">Foundry decides</option>
              <option value="true" <%= current[definition.key] === true ? 'selected' : '' %>>Yes</option>
              <option value="false" <%= current[definition.key] === false ? 'selected' : '' %>>No</option>
            </select>
          <% } else { %>
            <input class="input" type="number" name="<%= definition.key %>"
                   min="<%= definition.min %>" max="<%= definition.max %>"
                   value="<%= current[definition.key] === undefined ? '' : current[definition.key] %>">
          <% } %>
        </label>
      <% }) %>
    </div>
    <% if (preferences.length) { %>
      <h3 class="sub-head">What is set, and who set it</h3>
      <ul class="plain-list">
        <% preferences.forEach(function (pref) { %>
          <li>
            <%= pref.description %>
            <span class="muted">
              — <%= pref.source === 'instruction' ? 'you asked for this' : pref.source === 'policy' ? 'from an approved policy' : 'set in settings' %><%
                if (pref.setByName) { %> by <%= pref.setByName %><% } %>
            </span>
            <% if (pref.statedAs) { %><div class="muted">“<%= pref.statedAs %>”</div><% } %>
          </li>
        <% }) %>
      </ul>
    <% } %>
  </div>
  <div class="card-foot">
    <button class="btn" type="submit" <%= canOperate ? '' : 'disabled' %>>Save</button>
  </div>
</form>

</details>
