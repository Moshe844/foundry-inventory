<div class="page-head">
  <div class="titles">
    <h1>Automatic work</h1>
    <div class="page-sub">Choose the simple default. Open Custom only when you want to tune the limits.</div>
  </div>
</div>

<% if (canAdmin && !authorityProposal.alreadyConfigured) { %>
<section class="card section" aria-label="Limits from your own records">
  <div class="card-head"><h2>Suggested limits from your records</h2></div>
  <div class="card-body">
  <% if (authorityProposal.available) { %>
    <% if (authorityProposal.suppliers.length) { %><p>Based on <%= authorityProposal.evidence.length %> priced USD orders placed in the last 90 days. Usual suppliers: <%= authorityProposal.suppliers.map(function (supplier) { return supplier.name; }).join(', ') %>.</p><% } else { %><p>Your recent label history supports the shipping limits below. There is not enough qualifying supplier history to propose purchase authority.</p><% } %>
    <% if (authorityProposal.suppliers.length) { %><p>Approve replenishment for the <%= authorityProposal.itemScope.length %> previously purchased products, up to <strong>$<%= authorityProposal.maximumValue.toFixed(2) %> per order</strong> and <strong>$<%= authorityProposal.maximumValuePerWeek.toFixed(2) %> in any rolling seven days</strong>. These are your largest observed order and seven-day spend, not invented budgets.</p><% } %>
    <p>Demand, incoming supply, pack rules and price checks still have to pass. <%= authorityProposal.excludedCount %> orders were excluded because evidence or supplier history was insufficient.</p>
    <% authorityProposal.email.forEach(function (email) { %><p>Send newly approved routine POs and status follow-ups to <strong><%= email.supplierName %> · <%= email.recipient %></strong> using <%= email.mailboxName %>, up to <strong>$<%= (email.maximumValueMinor / 100).toFixed(2) %> USD per order</strong>. Initial POs approved before this confirmation still require individual review.</p><% }) %>
    <% authorityProposal.shipping.forEach(function (shipping) { %><p>Buy <strong><%= shipping.carrier %> <%= shipping.service %></strong> labels for packed, eligible parcels up to <strong>$<%= (shipping.maximumValueMinor / 100).toFixed(2) %> USD per label</strong>, based on <%= shipping.evidence.length %> recorded successful purchases. Fresh rates and any promised delivery date must pass.</p><% }) %>
    <% if (!authorityProposal.email.length) { %><p>Supplier email still asks first: a usual supplier needs a saved recipient and connected Gmail or Outlook mailbox.</p><% } %>
    <% if (!authorityProposal.shipping.length) { %><p>Shipping labels still ask first: connect a carrier account and record at least three successful USD label purchases for a service. If accounting is enabled, its base currency must also be USD.</p><% } %>
    <p>Payments are not authorised by this confirmation. Connected status and recorded history are not live-provider certification. Existing authorisations are never silently widened.</p>
    <form method="post" action="/autopilot/authority-proposal/approve"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="expectedHash" value="<%= authorityProposal.integrityHash %>"><button class="btn btn--primary" type="submit">Confirm these limits</button></form>
  <% } else { %>
    <p>No spending limits are guessed. Add at least three priced USD orders actually placed with a supplier to get a proposal. You can set your own limits below instead.</p>
  <% } %>
  </div>
</section>
<% } %>
<p><a href="/autopilot/daily">Daily digest and batch approvals</a> · <a href="/autopilot/misses">Report or review an Ask miss</a></p>
<div class="card section">
  <div class="card-head">
    <h2>How should StockChief work?</h2>
    <span class="spacer"></span>
    <% if (state.paused) { %><span class="badge badge--danger">Paused</span><% } %>
    <% if (state.suspended) { %><span class="badge badge--danger">Stopped itself</span><% } %>
  </div>
  <div class="card-body">
    <p class="lede"><strong>Currently: <%= state.modeLabel %>.</strong> <%= state.modeBlurb %></p>
    <% if (state.suspended) { %><p class="is-warn"><%= state.suspendedReason %></p><% } %>

    <form method="post" action="/autopilot/mode">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <div class="grid grid--2">
        <button class="authority-choice <%= state.mode === 'SUPERVISED' ? 'is-selected' : '' %>" type="submit" name="mode" value="SUPERVISED" <%= canOperate ? '' : 'disabled' %>>
          <strong>Ask me first</strong>
          <span>StockChief watches and recommends. It makes consequential changes only after you approve them.</span>
        </button>
        <button class="authority-choice <%= state.mode === 'POLICY_AUTOMATED' ? 'is-selected' : '' %>" type="submit" name="mode" value="POLICY_AUTOMATED" <%= canOperate ? '' : 'disabled' %>>
          <strong>Handle routine work</strong>
          <span>StockChief performs safe routine work inside limits you approved and asks about everything else.</span>
        </button>
      </div>
    </form>
    <%#
      Which jobs StockChief may do on its own.

      Separate from the mode above it, because the mode used to be both: the
      switch that let StockChief email a payment request also let it place
      supplier orders and move stock. One authority, six unrelated
      consequences, and no way to want one without the others.

      Each of these is granted on its own and starts off. Raising the mode
      grants none of them; granting one does nothing while the mode is below
      it. Both have to agree.
    %>
    <section id="jobs" class="card authority-jobs">
      <div class="card-head">
        <h3>Which jobs StockChief may do on its own</h3>
        <p>
          Each is separate. Authorising StockChief to chase an invoice never authorises it to spend money.
          <% if (state.mode !== 'POLICY_AUTOMATED') { %>
            <strong>While StockChief is set to “<%= state.modeLabel %>”, none of these run</strong> — it prepares
            the work and waits for you. The grants are kept, so they take effect if you change the mode.
          <% } %>
        </p>
      </div>
      <ul class="job-list">
        <% capabilities.forEach(function (job) { %>
          <li class="job">
            <div class="job-body">
              <strong><%= job.label %></strong>
              <span class="t-xs t-muted"><%= job.blurb %></span>
              <span class="t-xs t-muted"><em><%= job.consequence %></em></span>
            </div>
            <form method="post" action="/autopilot/capability" class="job-action" data-busy>
              <input type="hidden" name="_csrf" value="<%= csrfToken %>">
              <input type="hidden" name="capability" value="<%= job.capability %>">
              <input type="hidden" name="granted" value="<%= job.granted ? '0' : '1' %>">
              <button class="btn btn--sm <%= job.granted ? '' : 'btn--primary' %>" type="submit" <%= canOperate ? '' : 'disabled' %>>
                <%= job.granted ? 'Take this back' : 'Let StockChief do this' %>
              </button>
            </form>
            <span class="job-state <%= job.granted ? 'is-on' : '' %>">
              <%= job.granted ? 'Authorised' : 'Asks first' %>
            </span>
          </li>
        <% }) %>
      </ul>
      <p class="hint t-muted">
        You can also just say it: “Automatically send payment requests to customers, but always ask me
        before placing supplier orders.” StockChief sets exactly these switches and leaves the rest alone.
      </p>
    </section>

    <% if (state.mode === 'POLICY_AUTOMATED') { %>
      <form method="post" action="/autopilot/routine-authority" class="routine-setup" data-busy>
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <div class="routine-setup__head">
          <div>
            <h3>StockChief may automatically:</h3>
            <p>Choose only the routine work you want StockChief to handle. Nothing is enabled unless you select it and save these limits.</p>
          </div>
          <% if (routine.hasGuidedAuthority) { %><span class="badge badge--ok">Limits approved</span><% } %>
        </div>

        <% if (routine.transfer.enabled || routine.purchasing.enabled) { %>
          <div class="notice notice--success routine-current">
            <strong>Currently approved:</strong>
            <% if (routine.transfer.enabled) { %>
              transfers of no more than <strong><%= routine.transfer.maximumQuantity %> units at a time</strong><%= routine.purchasing.enabled ? '; ' : '.' %>
            <% } %>
            <% if (routine.purchasing.enabled) { %>
              purchase orders of no more than <strong>$<%= Number(routine.purchasing.maximumValue).toLocaleString('en-US') %></strong>
              may be approved and recorded as ordered in StockChief for
              <strong><%= routine.purchasing.supplierIds.length %> selected supplier<%= routine.purchasing.supplierIds.length === 1 ? '' : 's' %></strong>.
            <% } %>
            Everything outside these limits comes to you first.
          </div>
        <% } else { %>
          <p class="routine-current muted"><strong>Nothing is enabled yet.</strong> StockChief will keep asking before it moves stock or places an order.</p>
        <% } %>

        <div class="routine-capabilities">
          <section class="routine-capability <%= routine.transfer.enabled ? 'is-enabled' : '' %>">
            <label class="routine-capability__choice" for="routine-transfers">
              <input id="routine-transfers" type="checkbox" name="enableTransfers" value="1"
                     <%= routine.transfer.enabled ? 'checked' : '' %> <%= locations.length > 1 && canAdmin ? '' : 'disabled' %>>
              <span><strong>Move stock between my locations</strong><small>Only when one location risks running out, another can safely supply it, and the demand evidence is reliable.</small></span>
            </label>
            <% if (locations.length > 1) { %>
              <label class="field routine-capability__limits">
                <span class="field-label">Automatic transfers: never more than</span>
                <span class="routine-limit"><input class="input" type="number" name="maximumQuantity" value="<%= routine.transfer.maximumQuantity %>" min="1" max="100000" required> <span>units at a time</span></span>
              </label>
            <% } else { %>
              <p class="field-help routine-capability__limits">Add a second active location before StockChief can transfer stock.</p>
            <% } %>
          </section>

          <section class="routine-capability <%= routine.purchasing.enabled ? 'is-enabled' : '' %>">
            <label class="routine-capability__choice" for="routine-purchasing">
              <input id="routine-purchasing" type="checkbox" name="enablePurchasing" value="1"
                     <%= routine.purchasing.enabled ? 'checked' : '' %> <%= suppliers.length && canAdmin ? '' : 'disabled' %>>
              <span><strong>Approve routine purchase orders</strong><small>StockChief may create the PO and record it as ordered when the replenishment evidence, supplier rules, price and limits all pass.</small></span>
            </label>
            <% if (suppliers.length) { %>
              <div class="routine-capability__limits">
                <label class="field">
                  <span class="field-label">Automatic purchases: never more than</span>
                  <span class="routine-limit"><span>$</span><input class="input" type="number" name="maximumValue" value="<%= routine.purchasing.maximumValue %>" min="0.01" step="0.01" required> <span>per order</span></span>
                </label>
                <fieldset class="field routine-suppliers">
                  <label class="field"><span class="field-label">USD budget in any rolling seven days (blank means no weekly cap)</span><input class="input" type="number" name="maximumValuePerWeek" min="0.01" step="0.01" value="<%= routine.purchasing.maximumValuePerWeek || '' %>"></label>
                  <% if (routine.purchasing.itemScope.length) { %><p>Limited to the <%= routine.purchasing.itemScope.length %> products covered by your data-backed approval. Saving here preserves that product scope.</p><% } %>
                  <legend class="field-label">Approved suppliers</legend>
                  <% suppliers.forEach(function (supplier) { %>
                    <label class="check"><input type="checkbox" name="supplierScope" value="<%= supplier.id %>" <%= routine.purchasing.supplierIds.includes(supplier.id) ? 'checked' : '' %>> <%= supplier.name %></label>
                  <% }) %>
                </fieldset>
                <p class="field-help">“Ordered” records the internal purchase approval, not supplier delivery. Email is sent only when a saved recipient, connected mailbox and separately approved email limits all pass. Check the daily digest for the actual message status.</p>
              </div>
            <% } else { %>
              <p class="field-help routine-capability__limits">Add an active supplier before StockChief can reorder.</p>
            <% } %>
          </section>
        </div>

        <p class="routine-safety"><strong>StockChief will still ask you</strong> about counts, corrections, uncertain matches, work outside these limits, or anything that fails a safety check.</p>
        <% if (routine.otherActivePolicies.length) { %>
          <p class="notice notice--info"><strong><%= routine.otherActivePolicies.length %> additional Custom <%= routine.otherActivePolicies.length === 1 ? 'policy is' : 'policies are' %> active.</strong> Those approved limits also remain in force until you stop them under Custom.</p>
        <% } %>
        <button class="btn btn--primary" type="submit" <%= canAdmin ? '' : 'disabled' %>><%= routine.hasGuidedAuthority ? 'Save routine-work limits' : 'Start handling routine work' %></button>
      </form>
    <% } %>
  </div>
</div>

<details class="card section advanced-settings" id="advanced-authority" <%= advanced ? 'open' : '' %>>
  <summary class="card-head"><span><strong>Custom</strong><span class="muted"> — Advanced policies, preferences and hard limits</span></span></summary>
  <div class="card-body">
    <div class="act-row">
      <div><strong>Watch only</strong><p>StockChief explains what it sees but prepares or changes nothing.</p></div>
      <form method="post" action="/autopilot/mode"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="btn btn--sm <%= state.mode === 'OBSERVE' ? 'btn--primary' : '' %>" type="submit" name="mode" value="OBSERVE" <%= canOperate ? '' : 'disabled' %>>Use watch only</button></form>
    </div>
  </div>

<div class="card section">
  <div class="card-head">
    <h2>What StockChief may do on its own</h2>
    <span class="spacer"></span>
    <%# "Active" describes the policy, not what is happening. A policy only ever
        fires when StockChief is also set to run the inventory, so saying "active"
        beside "It changes nothing" was two true statements that read as a
        contradiction. %>
    <span class="badge badge--muted"><%= policies.filter(function (p) { return p.isActive; }).length %> approved</span>
  </div>
  <div class="card-body">
    <% if (!policies.length) { %>
      <p class="lede">Nothing. StockChief prepares work and waits for you on all of it.</p>
    <% } else if (!state.canAutomate) { %>
      <p class="lede muted">
        <% if (state.paused) { %>
          These are approved, but StockChief is paused, so none of them are doing anything.
        <% } else { %>
          These limits are approved, but StockChief is set to <strong><%= state.modeLabel.toLowerCase() %></strong> —
          it still brings this work to you. Choose “Handle routine work” above for them to take effect.
        <% } %>
      </p>
    <% } %>
    <% policies.forEach(function (policy) { %>
      <div class="act-row">
        <span class="act-place">
          <a href="/autopilot/policies/<%= policy.id %>"><strong><%= policy.name %></strong></a>
          <span class="badge badge--<%= policy.isActive && state.canAutomate ? 'ok' : 'muted' %>">
            <%= !policy.isApproved ? 'not approved'
                 : !policy.isActive ? 'off'
                 : state.canAutomate ? 'in force'
                 : state.paused ? 'approved · paused'
                 : 'approved · not running yet' %>
          </span>
          <div class="muted"><%= describe(policy).join(' ') %></div>
        </span>
        <span class="act-move">
          <% if (policy.isActive) { %>
            <form method="post" action="/autopilot/policies/<%= policy.id %>/disable"
                  data-confirm="Disable <%= policy.name %>? Nothing new will happen under it.">
              <input type="hidden" name="_csrf" value="<%= csrfToken %>">
              <button class="btn btn--sm btn--ghost" type="submit">Stop this</button>
            </form>
          <% } %>
        </span>
      </div>
    <% }) %>
  </div>
</div>

<%# Item 6: say it in your own words and read back what it would mean. %>
<% if (reviewAll) { %>
  <div class="notice notice--info section">
    <strong>“Handle everything” is a policy review, never unlimited permission.</strong>
    StockChief can safely prepare work and investigate without authority. Automatic transfers and routine purchase-order approval each need their own limits below. Counts, ambiguous identities and destructive changes always remain human decisions.
  </div>
<% } %>
<%
  /*
   * Everything below this line is the advanced half.
   *
   * The customer-facing choice is two options — ask me first, or handle routine
   * work inside limits I approve — and it is answered at the top of this page.
   * What followed was eight more cards of equal weight: writing policies in
   * prose, the compiled policy for review, balancing rules, replenishment
   * approval rules, hard limits and running preferences. Each is real and some
   * owner wants every one of them, but presented as siblings of the choice they
   * make the choice look unfinished — as though picking one of two options had
   * left eight more things to fill in before StockChief would do anything.
   *
   * One heading is enough to say these are for people who want the exact rules.
   */
%>
<div class="section-head" style="margin-top:40px;">
  <h2>Advanced controls</h2>
</div>
<p class="page-sub" style="margin-bottom:20px;">
  Exact policies, hard limits and preferences. The choice above works without any of this.
</p>

<details class="card section" id="universal-operation-authority">
  <summary class="card-head"><span><strong>Operation-by-operation authority</strong><span class="muted"> — Every operation starts off</span></span></summary>
  <div class="card-body">
    <p class="lede">Grant one job at a time. Spending, collections, credits, refunds, write-offs and messages are deliberately separate.</p>
    <form method="post" action="/autopilot/operation-authority" class="form-grid operation-authority-grid">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <label class="field field--full"><span class="field-label">Operation</span>
        <select class="input" name="operationType" required>
          <% operationCatalog.forEach(function (operation) { %>
            <option value="<%= operation.type %>"><%= operation.title %> · <%= operation.grant ? 'on' : 'off' %></option>
          <% }) %>
        </select>
      </label>
      <label class="field"><span class="field-label">Maximum units per action</span><input class="input" name="maximumQuantity" type="number" min="0" step="1" placeholder="No quantity limit"></label>
      <label class="field"><span class="field-label">Maximum value per action</span><input class="input" name="maximumValue" type="number" min="0" step="0.01" placeholder="No value limit"></label>
      <label class="field"><span class="field-label">Maximum actions per day</span><input class="input" name="maximumDailyCount" type="number" min="1" step="1" value="10" required></label>
      <label class="field"><span class="field-label">Minimum evidence confidence</span><select class="input" name="minimumConfidence"><option value="high">High</option><option value="medium">Medium</option><option value="low">Low</option></select></label>
      <label class="field"><span class="field-label">Maximum risk</span><select class="input" name="maximumRisk"><option value="low">Low</option><option value="medium">Medium</option><option value="high">High</option><option value="critical">Critical</option></select></label>
      <fieldset class="field operation-authority-roles"><legend class="field-label">Roles allowed to trigger it</legend>
        <label class="check"><input type="checkbox" name="allowedRoles" value="owner" checked> Owner</label>
        <label class="check"><input type="checkbox" name="allowedRoles" value="accountant"> Accountant</label>
        <label class="check"><input type="checkbox" name="allowedRoles" value="staff"> Staff</label>
      </fieldset>
      <div class="form-actions operation-authority-actions">
        <button class="btn btn--primary" name="enabled" value="1" <%= canAdmin ? '' : 'disabled' %>>Grant these limits</button>
        <button class="btn btn--ghost" name="enabled" value="0" <%= canOperate ? '' : 'disabled' %>>Turn this operation off</button>
      </div>
    </form>
  </div>
</details>

<form method="post" action="/autopilot/policies/read" class="card section" data-busy>
  <div class="card-head"><h2>Tell StockChief what it may handle</h2></div>
  <div class="card-body">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <label class="field">
      <span class="field-label">In your own words</span>
      <input class="input" type="text" name="instruction" maxlength="600"
             placeholder="You can move stock between Brooklyn and New Jersey when one is running out, but never more than 20 at a time">
      <span class="field-help">StockChief writes the policy. You read it and decide.</span>
    </label>
  </div>
  <div class="card-foot">
    <button class="btn" type="submit" <%= canAdmin ? '' : 'disabled' %>>Read this back to me</button>
  </div>
</form>

<% if (drafted && drafted.understood) { %>
  <form method="post" action="/autopilot/policies" class="card section">
    <div class="card-head"><h2>Here is the policy I would write</h2></div>
    <div class="card-body">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <input type="hidden" name="name" value="<%= drafted.draft.name %>">
      <input type="hidden" name="actionType" value="<%= drafted.draft.allowedActionTypes[0] %>">
      <% (drafted.draft.locationScope || []).forEach(function (id) { %>
        <input type="hidden" name="locationScope" value="<%= id %>">
      <% }) %>
      <% (drafted.draft.supplierScope || []).forEach(function (id) { %>
        <input type="hidden" name="supplierScope" value="<%= id %>">
      <% }) %>
      <p class="lede"><strong><%= drafted.draft.name %></strong></p>
      <% if (drafted.preview.length) { %>
        <ul class="plain-list">
          <% drafted.preview.forEach(function (line) { %><li><%= line %></li><% }) %>
        </ul>
      <% } %>
      <% if (drafted.questions.length) { %>
        <h3 class="sub-head">Before this can be written</h3>
        <ul class="plain-list">
          <% drafted.questions.forEach(function (question) { %><li class="is-warn"><%= question %></li><% }) %>
        </ul>
      <% } %>
      <% if (drafted.draft.allowedActionTypes[0] === 'approve_purchase_order') { %>
        <label class="field"><span class="field-label">Never commit more than</span>
          <input class="input" type="number" name="maximumValue" value="<%= drafted.draft.maximumValue || '' %>" min="1" step="0.01" required>
          <span class="field-help">on one purchase order.</span></label>
        <label class="field"><span class="field-label">Maximum known unit-price increase</span>
          <input class="input" type="number" name="maxUnitPriceChangePercent"
                 value="<%= drafted.draft.thresholds.maxUnitPriceChangePercent === undefined ? '' : drafted.draft.thresholds.maxUnitPriceChangePercent %>" min="0" step="0.1" required>
          <span class="field-help">percent; anything higher comes to you.</span></label>
      <% } else { %>
        <label class="field">
          <span class="field-label">Never move more than</span>
          <input class="input" type="number" name="maximumQuantity"
                 value="<%= drafted.draft.maximumQuantity || '' %>" min="1" required>
          <span class="field-help">units in one go.</span>
        </label>
      <% } %>
      <p class="muted">
        StockChief chose none of the safety conditions itself — every policy written this way carries all of
        them. Nothing happens until you approve it.
      </p>
    </div>
    <div class="card-foot">
      <button class="btn btn--primary" type="submit" <%= canAdmin ? '' : 'disabled' %>>Write this policy</button>
    </div>
  </form>
<% } %>

<%# Balancing moves stock between locations. Offering it to an inventory with
    one location invites somebody to write a policy that can never fire, and
    then wonder why StockChief never does anything. Say why instead. %>
<% if (locations.length < 2) { %>
  <div class="card section">
    <div class="card-head"><h2>Let StockChief balance your warehouses</h2></div>
    <div class="card-body">
      <p class="lede">
        This needs somewhere to move stock <em>to</em>.
        <%= locations.length === 1 ? locations[0].name + ' is the only location in this inventory' : 'This inventory has no locations yet' %>,
        so there is nothing to balance yet.
      </p>
      <p class="muted">
        Add a second location and StockChief can keep them level — moving stock when one is running out
        and the other has plenty, within a limit you set.
      </p>
    </div>
    <div class="card-foot">
      <a class="btn" href="/locations">Add a location</a>
    </div>
  </div>
<% } else { %>
<form method="post" action="/autopilot/policies" class="card section">
  <div class="card-head"><h2>Let StockChief balance your warehouses</h2></div>
  <div class="card-body">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <p class="lede">
      StockChief can move stock between your own locations when one is running out and another has plenty.
      Nothing leaves the business, the total never changes, and a wrong one is undone by moving it back.
    </p>
    <label class="field">
      <span class="field-label">Call it</span>
      <input class="input" type="text" name="name" value="Automatic warehouse balancing" maxlength="120">
    </label>
    <label class="field">
      <span class="field-label">Never move more than</span>
      <input class="input" type="number" name="maximumQuantity" value="12" min="1" required>
      <span class="field-help">units in one go. Anything bigger comes to you.</span>
    </label>
    <label class="field">
      <span class="field-label">At most</span>
      <input class="input" type="number" name="dailyLimit" min="1" placeholder="5">
      <span class="field-help">of these a day (optional).</span>
    </label>
    <fieldset class="field">
      <span class="field-label">Between these locations</span>
      <% locations.forEach(function (location) { %>
        <label class="check">
          <input type="checkbox" name="locationScope" value="<%= location.id %>" checked>
          <%= location.name %>
        </label>
      <% }) %>
    </fieldset>
    <p class="muted">
      StockChief will only do it when the destination is measurably about to run out and the source keeps
      enough for its own demand. You will see every move and can stop this at any time.
    </p>
  </div>
  <div class="card-foot">
    <button class="btn btn--primary" type="submit" <%= canAdmin ? '' : 'disabled' %>>Write this policy</button>
  </div>
</form>
<% } %>

<% if (suppliers.length) { %>
<form method="post" action="/autopilot/policies" class="card section">
  <div class="card-head"><h2>Let StockChief approve routine replenishment</h2></div>
  <div class="card-body">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <input type="hidden" name="actionType" value="approve_purchase_order">
    <p class="lede">StockChief may approve an order only when measured demand supports it, incoming stock does not already cover it, supplier pack rules pass, and price stays inside your limit.</p>
    <label class="field"><span class="field-label">Call it</span>
      <input class="input" type="text" name="name" value="Routine replenishment purchasing" maxlength="120" required></label>
    <label class="field"><span class="field-label">Never commit more than</span>
      <input class="input" type="number" name="maximumValue" value="500" min="1" step="0.01" required>
      <span class="field-help">on one order. Anything larger comes to Needs you.</span></label>
    <label class="field"><span class="field-label">Maximum known unit-price increase</span>
      <input class="input" type="number" name="maxUnitPriceChangePercent" value="5" min="0" step="0.1" required>
      <span class="field-help">percent. A larger change becomes a price exception.</span></label>
    <fieldset class="field"><span class="field-label">Only these suppliers</span>
      <% suppliers.forEach(function (supplier) { %><label class="check"><input type="checkbox" name="supplierScope" value="<%= supplier.id %>"> <%= supplier.name %></label><% }) %>
    </fieldset>
    <p class="muted">StockChief records the evidence and policy version on every automatic approval. Receiving remains a physical confirmation.</p>
  </div>
  <div class="card-foot"><button class="btn btn--primary" type="submit" <%= canAdmin ? '' : 'disabled' %>>Write this policy</button></div>
</form>
<% } %>

<form method="post" action="/autopilot/limits" class="card section">
  <div class="card-head"><h2>Hard limits</h2></div>
  <div class="card-body">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <p class="muted">These apply whatever any policy says.</p>
    <div class="grid grid--2">
      <label class="field">
        <span class="field-label">Automatic actions a day</span>
        <input class="input" type="number" name="maxActionsPerDay" value="<%= limits.maxActionsPerDay %>" min="0">
      </label>
      <label class="field">
        <span class="field-label">Units in one action</span>
        <input class="input" type="number" name="maxUnitsPerAction" value="<%= limits.maxUnitsPerAction %>" min="1">
      </label>
      <label class="field">
        <span class="field-label">Hours before touching the same product again</span>
        <input class="input" type="number" name="cooldownHours" value="<%= limits.cooldownHours %>" min="0">
      </label>
      <label class="field">
        <span class="field-label">Times one product may be moved per week</span>
        <input class="input" type="number" name="maxActionsPerItemPerWeek" value="<%= limits.maxActionsPerItemPerWeek %>" min="0">
      </label>
    </div>
  </div>
  <div class="card-foot">
    <button class="btn" type="submit" <%= canAdmin ? '' : 'disabled' %>>Save limits</button>
  </div>
</form>

<%# Item 26: preferences, only ever because somebody said so. %>
<form method="post" action="/autopilot/preferences" class="card section">
  <div class="card-head"><h2>How you want this inventory run</h2></div>
  <div class="card-body">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <p class="muted">
      StockChief never works these out from watching you. It uses what you set here and nothing else —
      leave one blank and it uses its own judgement.
    </p>
    <%
      var current = {};
      preferences.forEach(function (pref) { current[pref.key] = pref.value; });
    %>
    <div class="grid grid--2">
      <% preferenceKeys.forEach(function (definition) { %>
        <label class="field">
          <span class="field-label"><%= definition.label %></span>
          <% if (definition.kind === 'boolean') { %>
            <select class="input" name="<%= definition.key %>">
              <option value="">StockChief decides</option>
              <option value="true" <%= current[definition.key] === true ? 'selected' : '' %>>Yes</option>
              <option value="false" <%= current[definition.key] === false ? 'selected' : '' %>>No</option>
            </select>
          <% } else { %>
            <input class="input" type="number" name="<%= definition.key %>"
                   min="<%= definition.min %>" max="<%= definition.max %>"
                   value="<%= current[definition.key] === undefined ? '' : current[definition.key] %>">
          <% } %>
        </label>
      <% }) %>
    </div>
    <% if (preferences.length) { %>
      <h3 class="sub-head">What is set, and who set it</h3>
      <ul class="plain-list">
        <% preferences.forEach(function (pref) { %>
          <li>
            <%= pref.description %>
            <span class="muted">
              — <%= pref.source === 'instruction' ? 'you asked for this' : pref.source === 'policy' ? 'from an approved policy' : 'set in settings' %><%
                if (pref.setByName) { %> by <%= pref.setByName %><% } %>
            </span>
            <% if (pref.statedAs) { %><div class="muted">“<%= pref.statedAs %>”</div><% } %>
          </li>
        <% }) %>
      </ul>
    <% } %>
  </div>
  <div class="card-foot">
    <button class="btn" type="submit" <%= canOperate ? '' : 'disabled' %>>Save</button>
  </div>
</form>

</details>
