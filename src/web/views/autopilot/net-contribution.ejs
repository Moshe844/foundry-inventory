<% const m=margin,pct=(net,revenue)=>net!=null&&revenue>0?(100*net/revenue).toFixed(2)+'%':'Not established',cost=(v,code)=>v==null?'Missing':helpers.money(v,code);
const kinds={ITEM:'Item',CHANNEL:'Channel',CUSTOMER:'Customer'},lastRun=m.runs[0]; %>
<p><a href="/autopilot/reviews">← Back to Agent reviews</a></p>
<div class="page-head"><div class="titles"><h1>Net margin</h1>
<p>What each order really made: posted sales, returns and credits, minus product cost, marketplace and processing fees, and shipping. Fees come from your checked cost import, or from your fee terms for the channel. Shipping comes from your import, or from the carrier labels and costs recorded on the order, return parcels included. A missing cost is shown as missing, never as zero. Currencies are kept apart.</p></div></div>
<% if(m.shadow&&allowed){ %><p class="notice notice--info">StockChief is watching during your first 14 days. It shows what it would flag and opens no alerts.</p><% } %>
<% if(!allowed){ %><p class="notice notice--info"><strong>Starter</strong> shows this view when you open it. <strong>Growth / Pro / Custom</strong> keep it up to date on their own, flag low margins in Needs you and import checked costs. <a class="btn" href="/billing">Upgrade</a></p><% } %>

<% if(allowed){ %><section class="card section" id="margin-alerts"><h2>Low margin alerts</h2>
<% if(!m.rule||!m.rule.enabled){ %><p>Choose your lowest net margin, below. Until then StockChief keeps the figures current and flags nothing.</p>
<% }else{ %><p>You hear about an item, channel or customer below <strong><%= m.percentText(m.rule.threshold_bps) %></strong> net margin over the last <%= m.rule.period_days %> days.</p>
<% if(m.automatic){ %><p class="notice notice--info"><%= m.automatic %></p><% } %><% } %>
<% const open=m.alerts.filter(a=>a.status==='OPEN'),seen=m.alerts.filter(a=>a.status==='DISMISSED'); %>
<% if(open.length){ %><ul class="rm-list"><% open.forEach(a=>{ %><li class="list-row" id="margin-alert-<%= a.id %>"><span><strong><%= a.label %></strong> <span class="badge badge--warn"><%= kinds[a.subject_kind] %></span>
<small><%= a.margin_bps==null?'Lost '+helpers.money(Math.abs(Number(a.net_minor)),a.currency)+' with no net sales':'Net margin '+m.percentText(a.margin_bps)+' · '+helpers.money(Number(a.net_minor),a.currency)+' on '+helpers.money(Number(a.revenue_minor),a.currency) %> · <%= a.orders %> order<%= a.orders===1?'':'s' %></small></span>
<form method="post" action="/autopilot/net-contribution/alerts/<%= a.id %>/dismiss"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="btn btn--ghost btn--sm">Mark as seen</button></form></li><% }) %></ul>
<% }else{ %><p class="cell-sub">No open alerts.</p><% } %>
<% if(seen.length){ %><p class="cell-sub">Seen, still below the line: <%= seen.map(a=>a.label).join(', ') %>.</p><% } %>
<% if(lastRun){ %><p class="cell-sub">Last check <%= helpers.dateTime(lastRun.created_at) %>, orders dated <%= lastRun.start_date %> to <%= lastRun.end_date %>.<% if(lastRun.outcome==='WATCHED'){ %> Watching only: <%= lastRun.reason %><% if(lastRun.result&&lastRun.result.flagged&&lastRun.result.flagged.length){ %> It would have flagged <%= lastRun.result.flagged.map(f=>f.label).join(', ') %>.<% } %><% }else if(lastRun.outcome==='STOPPED'){ %> It stopped: <%= lastRun.reason %><% }else if(lastRun.result&&lastRun.result.incompleteCount){ %> <%= lastRun.result.incompleteCount %> order<%= lastRun.result.incompleteCount===1?' is':'s are' %> missing a cost.<% } %></p><% } %>
<% if(m.rule&&m.rule.enabled){ %><form method="post" action="/autopilot/net-contribution/check"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="btn btn--ghost">Check now</button></form><% } %>
<% if(m.cleared.length){ %><p class="cell-sub">Recently cleared: <%= m.cleared.map(c=>c.label+' ('+c.cleared_reason+')').join('; ') %></p><% } %>
</section><% } %>

<section class="card section"><h2>Orders and groups</h2>
<form method="get" action="/autopilot/net-contribution" class="form-stack"><label class="rm-field"><span>Order dates from</span><input type="date" name="start" required value="<%= start %>"></label><label class="rm-field"><span>Order dates through</span><input type="date" name="end" required value="<%= end %>"></label><label class="rm-field"><span>Group by</span><select aria-label="Group by" name="group"><% [['order','Order'],['item','Item'],['customer','Customer'],['channel','Channel']].forEach(([v,label])=>{ %><option value="<%= v %>" <%= group===v?'selected':'' %>><%= label %></option><% }) %></select></label><button class="btn">Review current contribution</button></form>
</section>
<% if(group!=='order'){ %><section class="card section"><h2>By <%= group %></h2><% if(!groups.length){ %><p>No matching posted orders.</p><% }else{ %><div class="table-wrap"><table class="table table--stack"><thead><tr><th><%= group[0].toUpperCase()+group.slice(1) %></th><th>Orders</th><th>Net sales</th><th>Product cost</th><th>Return writeoffs</th><th>Fees</th><th>Shipping</th><th>Net contribution</th><th>Contribution %</th></tr></thead><tbody><% groups.forEach(r=>{ %><tr><td class="cell-main"><span class="cell-title"><%= r.label %></span><% if(r.missing){ %><span class="cell-sub"><%= r.missing %> order<%= r.missing===1?'':'s' %> missing a cost</span><% } %></td><td data-label="Orders"><%= r.orders %></td><td data-label="Net sales"><%= helpers.money(r.revenue,r.currency) %></td><td data-label="Product cost"><%= helpers.money(r.cogs,r.currency) %></td><td data-label="Return writeoffs"><%= helpers.money(r.scrap,r.currency) %></td><td data-label="Fees"><%= r.fees==null?'Missing':helpers.money(r.fees,r.currency) %></td><td data-label="Shipping"><%= r.shipping==null?'Missing':helpers.money(r.shipping,r.currency) %></td><td data-label="Net contribution"><%= r.net==null?'Not established':helpers.money(r.net,r.currency) %></td><td data-label="Contribution %"><%= pct(r.net,r.revenue) %></td></tr><% }) %></tbody></table></div><% } %></section><% } %>
<section class="card section"><h2>Orders</h2><% if(!rows.length){ %><p>No posted sales in these order dates.</p><% }else{ %><div class="table-wrap"><table class="table table--stack"><thead><tr><th>Order</th><th>Channel</th><th>Net sales</th><th>Product cost</th><th>Return writeoffs</th><th>Fees</th><th>Shipping</th><th>Net contribution</th><th>Contribution %</th></tr></thead><tbody><% rows.forEach(r=>{ %><tr><td class="cell-main"><a class="cell-title" href="/sales/orders/<%= r.id %>"><%= r.order_number %></a><span class="cell-sub"><%= r.customer_name %></span><span class="cell-sub"><%= r.problem||'Costs: '+(r.feeSource===r.shippingSource?r.feeSource:r.feeSource+'; '+r.shippingSource) %><% if(r.costCheckedAt){ %> · checked <%= helpers.dateTime(r.costCheckedAt) %><% if(r.source){ %> · <%= r.source %><% } %><% } %></span></td><td data-label="Channel"><%= r.channel %></td><td data-label="Net sales"><%= helpers.money(r.revenue,r.currency) %></td><td data-label="Product cost"><%= helpers.money(r.cogs,r.currency) %></td><td data-label="Return writeoffs"><%= helpers.money(r.scrap,r.currency) %></td><td data-label="Fees"><%= cost(r.fees,r.currency) %></td><td data-label="Shipping"><%= cost(r.shipping,r.currency) %></td><td data-label="Net contribution"><%= r.net==null?'Not established':helpers.money(r.net,r.currency) %></td><td data-label="Contribution %"><%= pct(r.net,r.revenue) %></td></tr><% }) %></tbody></table></div><% } %></section>

<section class="card section" id="fee-terms"><h2>Fee terms by channel</h2>
<p class="cell-sub">Used when an order has no checked cost import. Enter the channel name exactly as it shows above, and the fees it charges per order: a percentage of the sale plus a fixed amount. Use 0 when a channel charges nothing. Fee refunds on returns are not assumed.</p>
<% if(m.fees.length){ %><ul class="rm-list"><% m.fees.forEach(f=>{ %><li class="list-row"><span><strong><%= f.channel %> · <%= f.currency %></strong><small><%= f.percent %>% + <%= f.fixedText %> per order · <%= f.source_reference %></small></span>
<form method="post" action="/autopilot/net-contribution/fee-terms"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="id" value="<%= f.id %>"><input type="hidden" name="revision" value="<%= f.revision %>"><button class="btn btn--ghost btn--sm" name="remove" value="yes">Remove</button></form></li><% }) %></ul><% } %>
<form method="post" action="/autopilot/net-contribution/fee-terms" class="form-stack"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="revision" value="0">
<label class="rm-field"><span>Channel</span><input name="channel" required maxlength="100" list="margin-channels"></label>
<datalist id="margin-channels"><% m.channels.forEach(c=>{ %><option value="<%= c %>"><% }) %></datalist>
<label class="rm-field"><span>Currency</span><input name="currency" required maxlength="3" value="<%= rows[0]?.currency||'USD' %>"></label>
<label class="rm-field"><span>Fee as % of the sale</span><input name="percent" required inputmode="decimal" maxlength="6"></label>
<label class="rm-field"><span>Fixed fee per order</span><input name="fixed" inputmode="decimal" maxlength="20" value="0"></label>
<label class="rm-field"><span>Where these terms come from</span><input name="sourceReference" required maxlength="200" placeholder="e.g. channel fee page or contract"></label>
<button class="btn btn--primary">Save fee terms</button></form>
<p class="cell-sub">Each channel and currency counts as one of your saved rules.</p></section>

<% if(allowed){ %><section class="card section" id="margin-rule"><h2>Your lowest net margin</h2>
<form method="post" action="/autopilot/net-contribution/margin-rule" class="form-stack"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="revision" value="<%= m.rule?.revision||0 %>">
<label class="rm-field"><span>Flag a net margin below (%)</span><input name="thresholdPercent" inputmode="decimal" maxlength="6" required value="<%= m.rule?(m.rule.threshold_bps/100):'' %>"></label>
<label class="rm-field"><span>Look back (days)</span><input name="periodDays" inputmode="numeric" maxlength="3" required value="<%= m.rule?.period_days||30 %>"></label>
<label class="checkbox"><input type="checkbox" name="confirmed" value="yes" required><span class="checkbox-text">Check every few hours and flag low margins in Needs you. Never change a price.</span></label>
<button class="btn btn--primary">Save margin rule</button></form>
<% if(m.rule&&m.rule.enabled){ %><form method="post" action="/autopilot/net-contribution/margin-rule"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="revision" value="<%= m.rule.revision %>"><button class="btn btn--ghost" name="stop" value="yes">Turn off alerts</button></form><% } %>
<p class="cell-sub"><a href="/autopilot/job-modes">Choose Watch only or Ask me first for this job</a></p></section>

<section class="card section"><h2>Import checked costs</h2><p>Paste CSV or a six-column table copied from your spreadsheet. Use an exact StockChief order/invoice number or a unique connected-channel order reference. Enter net fees and carrier costs in that order’s currency, excluding recoverable tax. Enter an explicit zero when the original source proves no charge. Include return postage and confirmed fee/carrier refunds; exclude product writeoffs already shown above. An import replaces fee terms and recorded carrier costs for its orders.</p><p>Columns: <strong>Order, Currency, Channel, Marketplace and processing fees, Shipping including returns, Cost source</strong>.</p><form method="post" action="/autopilot/net-contribution/preview" class="form-stack"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><label>Checked cost rows<textarea required name="rows" rows="7" maxlength="1048576" placeholder="Order,Currency,Channel,Marketplace and processing fees,Shipping including returns,Cost source&#10;SO-00001,USD,Website,1.25,4.50,Actual statement reference"></textarea></label><button class="btn btn--primary">Review these cost facts</button></form><p>Up to 500 orders per import. You review the exact amounts before they enter this report. The import records reported costs; it does not post a journal or pay a provider.</p></section><% } %>

<% if(pending.length){ %><section class="card section"><h2>Cost imports waiting for review</h2><ul><% pending.forEach(p=>{ %><li><a href="/autopilot/net-contribution/reviews/<%= p.id %>"><%= p.rows %> order rows · <%= helpers.dateTime(p.created_at) %></a></li><% }) %></ul></section><% } %>
