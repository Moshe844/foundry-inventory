<% const money = minor => minor === null || minor === undefined ? 'Unknown' : new Intl.NumberFormat('en-US',{style:'currency',currency:'USD'}).format(Number(minor)/100);
   const unmeasured = rows.filter(row => row.dailyRate <= 0).length; %>

<p class="rm-stamp">What happens next · Evidence-based planning · <%= scanned %> product<%= scanned === 1 ? '' : 's' %> reviewed</p>
<h1 class="rm-figure"><% if (!scanned) { %>Nothing to forecast yet.<% } else if (shortages.length) { %><%= shortages.length %> stock position<%= shortages.length === 1 ? ' is' : 's are' %> heading for a shortage.<% } else if (unmeasured) { %>No shortage is proven; <%= unmeasured %> position<%= unmeasured === 1 ? ' needs' : 's need' %> demand history.<% } else { %>No measured shortage is approaching.<% } %></h1>
<p class="rm-sub">
  StockChief compares physical stock, customer commitments, incoming purchases and recorded demand.
  <% if (unmeasured) { %><%= unmeasured %> position<%= unmeasured === 1 ? ' has' : 's have' %> no measured selling rate yet, so this is not an all-clear for <%= unmeasured === 1 ? 'it' : 'them' %>.<% } %>
  A prediction does not place an order or move stock.
</p>

<%- include('../partials/owner-direct-line', { directLineContext: 'Ask what might run short or tell StockChief what you want to protect.' }) %>

<% if (recommendations.length) { %>
  <section class="owner-planning section" id="recommendations" aria-labelledby="planning-decisions-title">
    <div class="owner-outcomes__head"><h2 id="planning-decisions-title">Needs your decision</h2><span><%= recommendations.length %></span></div>
    <p class="owner-planning__explain">These change a replenishment threshold only. They do not authorize a purchase, transfer or message.</p>
    <% recommendations.forEach(row => { %>
      <article class="owner-planning__decision">
        <div><span class="badge"><%= row.confidence || 'learning' %> confidence</span><h3><%= row.headline %></h3><p><%= row.why %></p><small>Current: <%= row.currentValue === null ? 'not set' : row.currentValue %> · proposed: <%= row.recommendedValue %></small></div>
        <% if (canOperate) { %><div class="owner-planning__actions"><form method="post" action="/planning/recommendations/<%= row.id %>/accept"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="rm-btn" type="submit">Use <%= row.recommendedValue %></button></form><form method="post" action="/planning/recommendations/<%= row.id %>/decline"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="rm-btn rm-btn--ghost" type="submit">Keep current policy</button></form></div><% } %>
      </article>
    <% }) %>
  </section>
<% } %>

<section class="owner-planning section" id="shortages" aria-labelledby="planning-shortages-title">
  <div class="owner-outcomes__head"><h2 id="planning-shortages-title">Heading for shortage</h2><span><%= shortages.length %></span></div>
  <% if (!shortages.length) { %><p class="rm-quiet">No measurable shortage falls inside the current lead-time window.<% if (unmeasured) { %> StockChief still needs demand evidence for <%= unmeasured %> position<%= unmeasured === 1 ? '' : 's' %>.<% } %></p><% } else { %>
    <div class="rm-told"><% shortages.forEach(row => { %>
      <div class="rm-told__row"><span class="rm-told__t"><a class="rm-u" href="/inventory/<%= row.item_id %>"><%= row.displayName %></a><small><%= row.location_name %> · <%= row.sold90 %> issued / 90 days · <%= row.reorderPoint === null ? 'derived threshold ' + row.inferredReorder : 'approved reorder point ' + row.reorderPoint %> · lead time <%= row.leadTimeDays %> days</small></span><span class="rm-told__m is-warn"><%= row.available %> available · <%= row.incoming %> incoming</span></div>
    <% }) %></div>
  <% } %>
</section>

<% if (transfers.length) { %>
  <section class="owner-planning section" id="transfers" aria-labelledby="planning-transfers-title">
    <div class="owner-outcomes__head"><h2 id="planning-transfers-title">Move stock before buying</h2><span><%= transfers.length %></span></div>
    <p class="owner-planning__explain">Suggestions only. StockChief keeps a shortage buffer at the source.</p>
    <div class="rm-told"><% transfers.forEach(move => { %><div class="rm-told__row"><span class="rm-told__t"><strong>Move <%= move.units %> <%= move.displayName %> from <%= move.fromLocationName %> to <%= move.toLocationName %></strong><small><%= move.why %></small></span></div><% }) %></div>
  </section>
<% } %>

<% if (excess.length) { %>
  <section class="owner-planning section" id="excess" aria-labelledby="planning-excess-title">
    <div class="owner-outcomes__head"><h2 id="planning-excess-title">Money tied up in stock</h2><span><%= excess.length %></span></div>
    <div class="rm-told"><% excess.forEach(row => { %><div class="rm-told__row"><span class="rm-told__t"><a class="rm-u" href="/inventory/<%= row.item_id %>"><%= row.displayName %></a><small><%= row.location_name %> · <%= row.onHand %> on hand · <%= row.daysOfSupply === null ? 'no measured demand' : Math.round(row.daysOfSupply) + ' days of supply' %></small></span><span class="rm-told__m"><%= row.excessUnits %> excess · <%= money(row.excessValueMinor) %></span></div><% }) %></div>
  </section>
<% } %>

<details class="owner-manual section" id="goals"><summary><span><strong>Planning goals</strong><small>How StockChief ranks safe options; these do not widen its authority.</small></span><span class="owner-manual__cue">Adjust <%- helpers.icon('chevron', { size: 15 }) %></span></summary><div class="owner-manual__body">
  <% if (canAdmin) { %><form method="post" action="/planning/goals"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><div class="grid">
    <label class="field"><span class="field-label">Availability preference</span><select class="select" name="serviceLevel"><option value="lean" <%= goals.serviceLevel === 'lean' ? 'selected' : '' %>>Keep stock lean</option><option value="balanced" <%= goals.serviceLevel === 'balanced' ? 'selected' : '' %>>Balanced</option><option value="protective" <%= goals.serviceLevel === 'protective' ? 'selected' : '' %>>Protect availability</option></select></label>
    <label class="field"><span class="field-label">Maximum days of supply</span><input class="input" type="number" name="maxDaysOfSupply" min="7" max="730" value="<%= goals.maxDaysOfSupply ?? '' %>" placeholder="90"></label>
    <label class="field"><span class="field-label">Inventory investment limit</span><input class="input" name="inventoryCap" value="<%= goals.inventoryCapMinor === null ? '' : (goals.inventoryCapMinor/100).toFixed(2) %>" placeholder="No limit"></label>
    <label class="field"><span class="field-label">Cash reserve</span><input class="input" name="cashReserve" value="<%= goals.cashReserveMinor === null ? '' : (goals.cashReserveMinor/100).toFixed(2) %>" placeholder="No reserve"></label>
    <label class="field field--check"><input type="checkbox" name="prioritiseCoreProducts" <%= goals.prioritiseCoreProducts ? 'checked' : '' %>><span>Protect reliable core products first</span></label>
    <label class="field field--check"><input type="checkbox" name="conservativeSeasonal" <%= goals.conservativeSeasonal ? 'checked' : '' %>><span>Treat seasonal spikes conservatively</span></label>
  </div><div class="rm-choices"><button class="rm-btn" type="submit">Save planning goals</button></div></form><% } else { %><p>Only an owner or administrator can change planning goals.</p><% } %>
</div></details>

<details class="owner-manual section" id="accuracy"><summary><span><strong>How reliable have forecasts been?</strong><small><%= accuracy.summary %></small></span><span class="owner-manual__cue">See evidence <%- helpers.icon('chevron', { size: 15 }) %></span></summary><div class="owner-manual__body"><p>Comparable forecasts: <strong><%= accuracy.comparable %></strong><% if (accuracy.comparable) { %> · average absolute error: <strong><%= accuracy.meanAbsoluteError %> units</strong> · average bias: <strong><%= accuracy.bias %></strong><% } %></p><p>Inventory at evidenced cost: <strong><%= money(heldMinor) %></strong>.</p></div></details>
