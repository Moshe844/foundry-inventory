<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= outcome.providerName %> connection · StockChief</title>
  <link rel="stylesheet" href="/app.css">
  <link rel="stylesheet" href="/product-clarity.css">
  <link rel="stylesheet" href="/foundry.css">
  <link rel="stylesheet" href="/room.css">
  <link rel="stylesheet" href="/design.css">
  <style>
    body { min-height:100vh; margin:0; display:grid; place-items:center; background:var(--bg); }
    .oauth-return { width:min(460px, calc(100vw - 32px)); text-align:center; }
    .oauth-return .panel { padding:32px; margin:0; }
    .oauth-return__mark { width:52px; height:52px; margin:0 auto 18px; border-radius:16px;
      display:grid; place-items:center; color:#fff; background:linear-gradient(135deg, #705cff, #4033c8);
      font-size:24px; font-weight:800; box-shadow:0 12px 30px rgba(79, 64, 220, .24); }
    .oauth-return h1 { margin:0 0 10px; font-size:var(--t-2xl); }
    .oauth-return p { margin:0 0 20px; color:var(--muted); line-height:1.55; }
    .oauth-return [hidden] { display:none !important; }
  </style>
</head>
<body>
  <main class="oauth-return" data-connection-return data-popup="<%= outcome.popup?'true':'false' %>" data-connected="<%= outcome.connected?'true':'false' %>" data-workspace-id="<%= outcome.workspaceId||'' %>" data-return-path="<%= outcome.returnPath %>" data-return-origin="<%= outcome.returnOrigin %>">
    <div class="panel">
      <div class="oauth-return__mark" aria-hidden="true"><%= outcome.connected ? '✓' : '!' %></div>
      <h1><%= outcome.connected ? outcome.providerName + ' is connected' : outcome.providerName + ' was not connected' %></h1>
      <p data-connection-return-status role="status"><%= outcome.message %></p>
      <button class="btn btn--primary" type="button" data-connection-return-close hidden>Close window</button>
      <a class="btn btn--primary" data-connection-return-link href="<%= outcome.returnUrl %>">Return to StockChief</a>
    </div>
  </main>
  <script src="/connection-return.js?v=popup-return-2" defer></script>
</body>
</html>
