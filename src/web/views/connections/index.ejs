<%
 const inventorySetup=Boolean(locals.inventorySetup),postgresMode=Boolean(locals.postgresMode),pay=locals.paymentAccount,grant=locals.paymentConnect,shipping=locals.shippingAccount;
 const apiToken=locals.apiToken,webhookSecret=locals.webhookSecret,apiClients=locals.apiClients||[],outboundWebhooks=locals.outboundWebhooks||[],publicOrigin=locals.connectionPublicOrigin||'';
 const capped=locals.connectionCapacity?.remaining===0,cp=helpers.connectionPresentation,runtime=locals.connectionRuntime;
 const included=new Set(locals.commercialCapabilities||[]);
 function capability(type){return cp.access(providerCatalog.find(p=>p.type===type)||{type}).commercial;}
 const catalogCards=helpers.connectionCards(providerCatalog,connections);
 const groups=cp.groups(providerCatalog);
 const logoTypes=new Set(['shopify','woocommerce','bigcommerce','square','clover','gmail','microsoft365','quickbooks','xero','stripe','cardknox']);
 const connected=connections.filter(c=>c.status!=='disconnected'&&c.provider_type!=='stripe');
 const developerMode=locals.connectionSection==='developers';
 const stripeConnected=Boolean(pay?.connected&&!grant?.unfinished),stripeDisconnect=postgresMode?'/settings/connections/payments/disconnect':'/settings/connections/payments/remove';
 const stripeLaunch=postgresMode?'/settings/connections/payments/launch?ticket='+encodeURIComponent(locals.launchTicket||''):'/settings/connections/payments/start';
 const paymentsFocus=Boolean(locals.paymentsFocus);
%>
<% if(paymentsFocus){ %><header class="rm-head"><h1>Payment gateways</h1><p>Connect one to take cards and send payment links from your orders. The money goes to your own merchant account.</p></header><% }else{ %><header class="rm-head"><h1><%= inventorySetup?'Connect a platform':'Connections' %></h1><p><%= inventorySetup?'Bring your products and stock into this inventory.':'Connect your business accounts and manage their updates in one place. Each inventory has its own accounts.' %></p></header><% } %>
<% if(capped){ %><div class="notice notice--warn" role="status" data-connection-limit>This account uses all <%= connectionCapacity.hardLimit %> connection slots. Disconnect an unused account or <a href="/billing">review your plan</a>. Unfinished authorization windows do not use a slot.</div><% } %>
<% if(developerMode){ %><a class="btn" href="/settings/connections">Back to connections</a><% for(const provider of providerCatalog.filter(p=>p.integrationMode==='custom_contract'||p.type==='reference_webhook')){const requiredCommercialCapability=capability(provider.type),includedOnPlan=true; %><section class="card card-body"><h2><%= provider.name %></h2><%- include('provider-connect-form',{provider,requiredCommercialCapability,includedOnPlan,postgresMode,csrfToken}) %></section><% } %><%- include('developer-settings',{postgresMode,apiToken,webhookSecret,apiClients,outboundWebhooks}) %><% if(locals.developerAccounts){ %><a class="btn" href="/commercial-admin/accounts">Developer account tools</a><% } %><% }else{ %>
<% if(!paymentsFocus){ %><% if(connected.length||stripeConnected){ %><section class="sc-connected-section" aria-labelledby="connected-heading"><h2 id="connected-heading">Connected</h2><div class="sc-connected-list">
 <% for(const connection of connected){ const type=connection.provider_type; %><article class="sc-connected-row" data-connected-id="<%= connection.id %>">
 <div class="sc-connected-identity"><% if(cp.logo(type)){ %><img src="/provider-logos/<%= cp.logo(type) %>.svg" alt="" width="32" height="32"><% }else{ %><%- helpers.icon('link',{size:32}) %><% } %><div><strong><%= providerCatalog.find(p=>p.type===type)?.name||connection.display_name||type %></strong><span><%= connection.provider_account_name||connection.display_name||type %></span></div></div>
 <span class="badge <%= cp.status(connection)==='Connected'?'badge--success':'badge--warn' %>"><%= cp.status(connection) %></span><span class="sc-connected-sync"><%= connection.last_synced_at?'Synced '+helpers.timeAgo(connection.last_synced_at):'Waiting for first sync' %></span>
 <% if(cp.issue(connection)){ %><p class="hint sc-connection-error" data-connection-error><%= cp.issue(connection) %></p><% } %>
 <a class="btn" href="<%= ['shippo','shipstation','shipengine','easypost'].includes(type)?'/settings/shipping':'/settings/connections/'+connection.id %>"><%= cp.status(connection)==='Error'?'Fix':'Manage' %> <%= cp.name(connection) %></a>

 </article><% } %>
 <% if(stripeConnected&&(runtime!=='production'||pay.liveMode)){ %><article class="sc-connected-row"><div class="sc-connected-identity"><img src="/provider-logos/stripe.svg" alt="" width="32" height="32"><div><strong>Stripe</strong><span>Connected to <%= pay.displayName||pay.accountId %></span></div></div><span class="badge badge--success">Connected</span><span><%= pay.checkedAt?'Checked '+helpers.timeAgo(pay.checkedAt):'Awaiting account check' %></span><button class="btn" type="button" data-modal-open="payments">Manage Stripe</button></article><% } %>
 </div></section><% } %>
<% for(const group of groups){const cards=catalogCards.filter(c=>group.types.includes(c.provider.type));if(!cards.length)continue; %><section class="sc-provider-section" <%- group.title==='Email'?'id="supplier-communication"':'' %> aria-label="<%= group.title %>"><h2><%= group.title %></h2><div class="sc-provider-grid">
 <% for(const card of cards){const provider=card.provider,requiredCommercialCapability=capability(provider.type),includedOnPlan=locals.commercialDevelopment||included.has(requiredCommercialCapability); %>
 <article class="rm-provider sc-provider-card" data-integration-card="<%= provider.type %>"><div class="rm-provider__h"><img src="/provider-logos/<%= provider.type %>.svg" alt="" width="32" height="32"><strong class="rm-provider__n"><%= provider.name %></strong><span class="badge <%= card.state==='Connected'?'badge--success':card.state==='Error'?'badge--danger':'badge--muted' %>"><%= card.state %></span></div>
 <p class="sc-provider-description"><%= cp.description(provider) %></p><% if(card.connection&&cp.issue(card.connection)){ %><p class="hint sc-connection-error" data-connection-error><%= cp.issue(card.connection) %></p><% } %>

 <div class="sc-provider-action"><%- include('provider-card-action',{card,provider,requiredCommercialCapability,includedOnPlan,postgresMode,capped}) %></div><% if(['gmail','microsoft365'].includes(provider.type)){ %><%- include('mail-preparation',{connection:card.connection,mailProviderName:provider.name,mailPreparation:card.connection?mailPreparationStates[card.connection.id]:{enabled:false,available:false,connected:false,label:'Connect your mailbox first',entries:[]},mailPreparationReturn:'connections'}) %><% } %></article>
 <% } %></div></section><% } %><% } %>
<% if(!inventorySetup){ %><section class="sc-provider-section" id="payment-connections"><% if(!paymentsFocus){ %><h2>Payments</h2><% } %><div class="sc-provider-grid">
 <% if(pay&&(runtime!=='production'||!grant?.testMode)){ %><article class="rm-provider sc-provider-card" data-integration-card="stripe"><div class="rm-provider__h"><img src="/provider-logos/stripe.svg" alt="" width="32" height="32"><strong class="rm-provider__n">Stripe</strong><span class="badge <%= stripeConnected?'badge--success':'badge--muted' %>"><%= stripeConnected?'Connected':grant?.unfinished?'Setup unfinished':'Not connected' %></span></div><p class="sc-provider-description">Collect invoice payments in your own merchant account. The account belongs to the business and pays out to its bank.</p><%- include('stripe-connection-actions',{stripeConnected,stripeLaunch,stripeDisconnect,pay,grant,capped,included}) %></article><% } %>
 <% if(locals.cardknoxAccount){ %><article class="rm-provider sc-provider-card" data-integration-card="cardknox"><div class="rm-provider__h"><img src="/provider-logos/cardknox.svg" alt="" width="32" height="32"><strong class="rm-provider__n">Sola / Cardknox</strong><span class="badge <%= cardknoxAccount.connected?'badge--success':'badge--muted' %>"><%= cardknoxAccount.connected?'Connected':'Not connected' %></span></div><p class="sc-provider-description">Accept payments through your own Sola merchant account.</p><div class="sc-provider-action"><% if(!capped||cardknoxAccount.connected){ %><button class="btn btn--primary" type="button" data-modal-open="cardknox"><%= cardknoxAccount.connected?'Manage Sola':'Connect Sola' %></button><% }else{ %><a class="btn" href="/billing">Review plan</a><% } %></div></article><% } %>
 </div></section>
 <% if(!paymentsFocus){ %><section class="sc-provider-section" id="shipping"><h2>Shipping</h2><div class="sc-provider-grid"><article class="rm-provider sc-provider-card" data-integration-card="shipping"><div class="rm-provider__h"><%- helpers.icon('ship',{size:32}) %><strong class="rm-provider__n">Shipping accounts</strong><span class="badge"><%= shipping?.connected?'Connected':'Not connected' %></span></div><p class="sc-provider-description">Rates, labels and tracking with your own shipping accounts.</p><div class="sc-provider-action"><a class="btn btn--primary" href="/settings/shipping">Manage shipping</a></div></article></div></section><% } %>
 <% if(locals.cardknoxAccount){ %><dialog class="sc-connect-dialog" id="cardknox" aria-label="Connect Sola"><header><h2><%= cardknoxAccount.connected?'Manage Sola':'Connect Sola' %></h2><button type="button" class="btn btn--ghost" data-modal-close>Close</button></header><%- include('sola-form') %></dialog><% } %>
 <% if(pay?.connected){ %><dialog class="sc-connect-dialog" id="payments" aria-label="Manage Stripe"><header><h2>Stripe</h2><button type="button" class="btn btn--ghost" data-modal-close>Close</button></header><p><%= pay.displayName||pay.accountId %></p><p><%= pay.chargesEnabled?'Ready to take payments':'Stripe review pending' %></p><form method="post" action="/settings/connections/payments/refresh"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="btn" type="submit">Check Stripe status</button></form><form method="post" action="<%= stripeDisconnect %>" data-confirm="Disconnect Stripe? Existing payment history is kept."><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="btn btn--ghost" type="submit">Disconnect Stripe</button></form></dialog><% } %>
 <% if(!paymentsFocus){ %><p class="sc-developer-link"><a class="btn btn--ghost" href="/settings/connections?section=developers#developer-api">For developers</a></p><% } %>
<% } %>
<% if(!paymentsFocus&&connections.length){ %><details class="rm-work sc-connection-history"><summary>Connection history</summary><div class="rm-work__body"><% for(const connection of connections){ %><p><a href="/settings/connections/<%= connection.id %>" aria-label="View details: <%= cp.historyLabel(connection)||'connection history' %>">View details<span> · <%= cp.historyLabel(connection)||'Connection history' %></span></a></p><% } %></div></details><% } %>
<% } %>
<span hidden data-connection-host data-workspace-id="<%= currentWorkspaceId||'' %>" data-public-origin="<%= publicOrigin %>" data-csrf-token="<%= csrfToken %>"></span>
<script src="/connection-return.js?v=<%= assetVersion %>"></script><script src="/provider-connect.js?v=<%= assetVersion %>" defer></script>
