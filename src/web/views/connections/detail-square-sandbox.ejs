<% var unmapped = externalRecords.filter(function(row) { return row.mapping_status === 'UNMAPPED' && row.selected; }); %>
<% var unmappedProducts = unmapped.filter(function(row) { return row.entity_type === 'sku'; }); %>
<% var products = externalRecords.filter(function(row) { return row.entity_type === 'sku' && row.mapping_status === 'MAPPED'; }); %>
<% var mappedLocations = externalRecords.filter(function(row) { return row.entity_type === 'location' && row.mapping_status === 'MAPPED' && row.selected; }); %>

<header class="page-head">
  <div class="titles">
    <div class="breadcrumbs"><a href="/settings/connections">Connections</a><span>›</span><span>Square Sandbox</span></div>
    <h1>Square</h1>
    <p class="page-sub">Test completed Square sales flowing automatically into Foundry.</p>
  </div>
  <span class="badge <%= connection.status === 'connected' ? 'badge--ok' : 'badge--muted' %>"><%= connection.status === 'connected' ? 'Connected' : 'Disconnected' %></span>
</header>

<main class="grid connection-simple">
  <% if (connection.status !== 'connected') { %>
    <section class="notice notice--warn">
      <div><strong>This Square connection is not active.</strong><p>This is a preserved duplicate or disconnected setup. Open the Square connection marked Connected.</p><p style="margin-top:10px"><a class="btn btn--primary btn--sm" href="/settings/connections">Choose the connected Square account</a></p></div>
    </section>
  <% } else if (unmapped.length) { %>
    <section class="card" data-selection-group>
      <div class="card-head"><div><span class="eyebrow">One-time setup</span><h2>Match <%= unmapped.length %> Square record<%= unmapped.length === 1 ? '' : 's' %></h2><p class="muted">Do this once. Foundry remembers every match for future sales.</p></div></div>
      <div class="card-body grid">
        <% if (unmappedProducts.length > 1) { %>
          <form id="bulk-product-import" method="post" action="/settings/connections/<%= connection.id %>/create-products-map" class="form-actions">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <button class="btn btn--sm" type="button" data-select-all>Select all products</button>
            <button class="btn btn--sm" type="button" data-clear-selection>Clear</button>
            <span class="muted" data-selection-count>0 selected</span>
            <button class="btn btn--primary btn--sm" type="submit" data-remove-selected disabled>Add selected to Foundry</button>
          </form>
        <% } %>
        <% unmapped.forEach(function(record) { var choices = record.entity_type === 'sku' ? skus : locations; %>
          <div class="list-row" style="align-items:flex-start">
            <% if (record.entity_type === 'sku' && unmappedProducts.length > 1) { %><input type="checkbox" name="externalIds" value="<%= record.external_id %>" form="bulk-product-import" data-selection-item aria-label="Select <%= record.display_name %>"><% } %>
            <div style="flex:1"><strong><%= record.display_name %></strong><p class="muted"><%= record.entity_type === 'sku' ? 'Square product · ' + (record.code || record.external_id) : 'Square location' %></p>
              <% if (choices.length) { %><form method="post" action="/settings/connections/<%= connection.id %>/map" class="form-actions" style="margin-top:10px"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="entityType" value="<%= record.entity_type %>"><input type="hidden" name="externalId" value="<%= record.external_id %>"><select class="select" name="foundryRecordId" required><option value="">Choose its Foundry match</option><% if (record.entity_type === 'sku') { skus.forEach(function(sku) { %><option value="<%= sku.id %>"><%= sku.item_name %><%= sku.variant_label ? ' / ' + sku.variant_label : '' %> · <%= sku.code %></option><% }) } else { locations.forEach(function(location) { %><option value="<%= location.id %>"><%= location.name %></option><% }) } %></select><button class="btn btn--primary btn--sm" type="submit">Save match</button></form><% } %>
              <% if (record.entity_type === 'sku') { %><form method="post" action="/settings/connections/<%= connection.id %>/create-product-map" style="margin-top:10px"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="externalId" value="<%= record.external_id %>"><button class="btn btn--sm" type="submit">Create it in Foundry from Square</button></form><% } %>
              <% if (record.entity_type === 'location' && !choices.length) { %><form method="post" action="/settings/connections/<%= connection.id %>/create-location-map" class="form-actions" style="margin-top:10px"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="externalId" value="<%= record.external_id %>"><input type="hidden" name="name" value="<%= record.display_name %>"><input type="hidden" name="kind" value="store"><button class="btn btn--primary btn--sm" type="submit">Create this location in Foundry</button></form><% } %>
            </div>
          </div>
        <% }) %>
      </div>
    </section>
  <% } else { %>
    <section class="notice notice--success connection-ready">
      <div><strong>Square is ready.</strong><p><%= products.length %> product<%= products.length === 1 ? '' : 's' %> and <%= mappedLocations.length %> location<%= mappedLocations.length === 1 ? '' : 's' %> are matched. Future completed Square sales can update Foundry automatically.</p></div>
    </section>

    <section class="card connection-real-sale">
      <div class="card-body grid">
        <div><span class="eyebrow">Sandbox test</span><h2>Run the sale in Square</h2><p>Foundry prepares an unpaid Square Sandbox checkout. You complete the payment on Square’s testing panel. Inventory does not change until Square reports that payment as successful.</p></div>
        <% if (products.length && mappedLocations.length) { %>
          <form method="post" action="/settings/connections/<%= connection.id %>/square-sandbox-checkout" class="grid grid--2">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <label class="field"><span class="label">Square product</span><select class="select" name="externalSku" required><% products.forEach(function(product) { %><option value="<%= product.external_id %>"><%= product.display_name %><%= product.code ? ' · ' + product.code : '' %></option><% }) %></select></label>
            <label class="field"><span class="label">Square location</span><select class="select" name="externalLocationId" required><% mappedLocations.forEach(function(location) { %><option value="<%= location.external_id %>"><%= location.display_name %></option><% }) %></select></label>
            <label class="field"><span class="label">Quantity</span><input class="input" type="number" name="quantity" value="1" min="1" max="100" required></label>
            <div class="form-actions" style="align-self:end"><button class="btn btn--primary" type="submit">Open unpaid Square test checkout</button></div>
          </form>
          <p class="hint">The next page belongs to Square. Use its Test Payment step and complete the sale there. Foundry never presses the final payment button.</p>
        <% } else { %>
          <div class="notice notice--warn"><div><strong>Finish matching first</strong><p>A matched Square product and selected location are required before an itemized test sale can be prepared.</p></div></div>
        <% } %>
      </div>
    </section>
  <% } %>

  <details class="card connection-advanced">
    <summary class="card-head"><h2>Advanced settings</h2><span class="muted">Sync, history and connection controls</span></summary>
    <div class="card-body grid">
      <div class="list-row"><span>Last event received</span><strong><%= connection.last_activity_at ? helpers.timeAgo(connection.last_activity_at) : 'None yet' %></strong></div>
      <div class="list-row"><span>Products mapped</span><strong><%= connection.productsMapped %></strong></div>
      <div class="list-row"><span>Locations mapped</span><strong><%= connection.locationsMapped %></strong></div>
      <% if (connection.last_error) { %><div class="notice notice--warn"><div><strong>Last connection problem</strong><p><%= connection.last_error %></p></div></div><% } %>
      <% if (currentUser.role === 'owner' && connection.status === 'connected') { %><div class="form-actions"><form method="post" action="/settings/connections/<%= connection.id %>/sync"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="btn" type="submit">Refresh Square catalogue</button></form><form method="post" action="/settings/connections/<%= connection.id %>/reconcile"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="btn" type="submit">Compare recent history</button></form><form method="post" action="/settings/connections/<%= connection.id %>/pause"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="btn" type="submit">Pause events</button></form><form method="post" action="/settings/connections/<%= connection.id %>/disconnect" data-confirm="Disconnect Square? Mappings and audit history will be kept."><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="btn btn--danger" type="submit">Disconnect</button></form></div><% } %>
    </div>
  </details>
</main>
