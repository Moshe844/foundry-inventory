<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><meta name="referrer" content="no-referrer"><title>Continue to StockChief</title><link rel="stylesheet" href="/app.css"><link rel="stylesheet" href="/design.css"><link rel="stylesheet" href="/professional-system.css?v=<%= locals.assetVersion||'current' %>">
</head><body><main class="panel" style="max-width:32rem;margin:3rem auto;padding:2rem"><h1><%= locals.installed?'StockChief':'Continue to StockChief' %></h1>
<% if(locals.installed){ %><p>Open your StockChief inventory to review this store's connection, product matches and synchronization settings. Sign in with your StockChief account; store access does not grant access to another inventory.</p><p><a class="btn btn--primary" target="_blank" rel="noopener noreferrer" href="<%= continueUrl %>">Open StockChief</a></p>
<% }else{ %><p>Finish this connection in the StockChief window that started it. Your browser keeps that sign-in separate from the store’s embedded view.</p><p><a class="btn btn--primary" target="_top" rel="noreferrer" href="<%= continueUrl %>" data-provider-handoff>Continue to StockChief</a></p><% } %>
<p><a href="/integrations/bigcommerce" target="_blank" rel="noopener noreferrer">Installation and user guide</a> · <a href="mailto:support@stockchiefhq.com">Contact support</a></p>
</main><% if(!locals.installed){ %><script src="/provider-handoff.js" defer></script><% } %></body></html>
