<%
  const accounting=connection.accounting||null;
  const displayStatus=helpers.connectionPresentation.status(connection);
  const providerName=provider?.name||connection.display_name||connection.provider_type;
  const needsAuthorization=connection.setup_status==='REAUTHORIZATION_REQUIRED'||connection.status==='disconnected';
  const connected=connection.status==='connected'&&!connection.paused_at&&!needsAuthorization;
  const proof=locals.connectionProof||{};
  const hasCatalogue=Boolean(proof.catalogue_at);
  const eventAt=isMailbox?mailboxLastPollAt:proof.event_at;
  const hasEvent=Boolean(eventAt);
  const currentActivity=hasEvent&&(!isMailbox||connected);
  const proven=connected&&connection.publicStatus==='Connected'&&(!canDiscover||(hasCatalogue&&!connection.itemsNeedingMapping))&&hasEvent;
%>

<% const logo=helpers.connectionPresentation.logo(connection.provider_type);
   const statusTone=displayStatus==='Connected'?'is-ok':displayStatus==='Error'?'is-bad':'is-wait';
   // Only completed provider evidence counts: a mailbox check that finished, or an event that was processed.
   const checkLabel=isMailbox?'Last completed mailbox check':accounting?'Company verified':'Last provider event processed';
   const lastCheck=isMailbox?(mailboxLastPollAt?helpers.timeAgo(mailboxLastPollAt):'No mailbox check has completed yet'):accounting?(accounting.policy.verified_at?helpers.timeAgo(accounting.policy.verified_at):'Verification needed'):(proof.event_at?helpers.dateTime(proof.event_at):'No provider event has been processed yet'); %>
<div class="cx">
<header class="cx-head">
  <div class="cx-head__top page-head">
    <span class="cx-logo" aria-hidden="true"><% if(logo){ %><img src="/provider-logos/<%= logo %>.svg" alt="" width="36" height="36"><% }else{ %><%- helpers.icon('link',{size:22}) %><% } %></span>
    <div class="cx-head__id"><h1><%= connection.display_name %></h1><p><%= providerName %><%= connection.provider_account_name?' · '+connection.provider_account_name:'' %></p></div>
    <span class="cx-status badge <%= statusTone %>"><%= displayStatus %></span>
    <% if(isMailbox){ %><a class="cx-btn cx-btn--primary" href="/mail">Open Mail</a><% } %>
  </div>
  <dl class="cx-facts">
    <div><dt>Account</dt><dd><%= connection.provider_account_name||'Not returned yet' %></dd></div>
    <div><dt><%= checkLabel %></dt><dd><%= lastCheck %></dd></div>
    <% if(!isMailbox){ %><div><dt>Last sync</dt><dd><%= connection.last_synced_at?helpers.timeAgo(connection.last_synced_at):'Not yet' %></dd></div><% } %>
    <% if(connection.actionableIssues){ %><div><dt>Needs you</dt><dd class="cx-facts__bad"><a href="#connection-issues"><%= connection.actionableIssues %> <%= Number(connection.actionableIssues)===1?'problem':'problems' %></a></dd></div><% } %>
    <% if(accounting&&connection.catalogueSetupIssues){ %><div><dt>Optional inventory setup</dt><dd><a href="?reviewProducts=1#catalogue-review"><%= helpers.connectionPresentation.matchingSummary(connection) %></a></dd></div><% } %>
  </dl>
<% if(!accounting){ %>
<section class="setup-journey section">
  <div class="setup-journey__head"><div class="setup-journey__head-copy"><span class="setup-journey__eyebrow">Is it working?</span>
    <h2><%= proven?'Account and activity verified':'Verify setup before relying on automatic updates' %></h2>
    <p><%= isMailbox?'StockChief verifies the connected account and records completed mailbox checks separately.':'Connected is not the same as working. StockChief records the account, catalogue and first real event separately.' %></p></div></div>
  <div class="setup-steps">
    <div class="setup-step <%= connected?'setup-step--done':'setup-step--current' %>"><span class="setup-step__number"><%= connected?'✓':'1' %></span><div><strong>Sign in to the right account</strong><p><%= connection.provider_account_name||'The provider has not returned an account identity yet.' %></p></div><span class="setup-step__state"><%= connected?'Verified':'Waiting' %></span></div>
    <% if(canDiscover){ %><div class="setup-step <%= hasCatalogue?'setup-step--done':connected?'setup-step--current':'' %>"><span class="setup-step__number"><%= hasCatalogue?'✓':'2' %></span><div><strong>Read products and locations</strong><p>Identity records are read first; old sales are never replayed into current stock.</p></div><span class="setup-step__state"><%= hasCatalogue?'Recorded':'Refresh below' %></span></div><% } %>
    <div class="setup-step <%= currentActivity?'setup-step--done':connected?'setup-step--current':'' %>"><span class="setup-step__number"><%= currentActivity?'✓':canDiscover?'3':'2' %></span><div><strong><%= isMailbox?'Complete a mailbox check':'Receive and process a provider event' %></strong><p><%= isMailbox?(connected?'A scheduled check must finish successfully.':'Sign in again before StockChief can check for new mail. Previous checks remain in history.'):'Event delivery and individual sales, payments and inventory workflows are verified separately. Signing in alone does not prove delivery.' %></p></div><span class="setup-step__state"><%= currentActivity?(isMailbox?'Checked':'Received once'):isMailbox&&!connected?'Waiting for sign-in':'Not yet' %></span></div>
  </div>
</section>
<% } %>
</header>

<% const canRestore=needsAuthorization&&currentUser.role==='owner'&&provider?.available; %>
<% if(displayStatus==='Error'||canRestore){ const retryAt=Date.parse(connection.config?.syncRetryAt||''); %>
<section class="cx-alert<%= displayStatus==='Error'?' is-bad':'' %>" role="status" aria-label="<%= canRestore?'Restore provider authorization':'Connection needs attention' %>">
  <div class="cx-alert__text">
    <% if(displayStatus==='Error'){ %><strong>This connection needs attention.</strong><p><%= helpers.connectionPresentation.issue(connection) %><%= canRestore?' Your records, matches and history are kept.':'' %></p><% if(Number.isFinite(retryAt)&&retryAt>Date.now()){ %><p>Next automatic retry: <time data-local-time datetime="<%= new Date(retryAt).toISOString() %>"><%= helpers.dateTime(new Date(retryAt)) %></time>.</p><% } %>
    <% }else{ %><strong>Sign in again to <%= providerName %></strong><p>This restores the existing connection. Its records, mappings and history are kept.</p><% } %>
    <% if(canRestore&&provider.authorizationPrerequisite){ %><p><strong>Account sign-in needed.</strong> <%= provider.authorizationPrerequisite.message %> <a href="<%= provider.authorizationPrerequisite.href %>" target="_blank" rel="noopener noreferrer"><%= provider.authorizationPrerequisite.label %></a></p><% } %>
  </div>
  <% if(canRestore){ %>
    <form method="post" action="/settings/connections/<%= encodeURIComponent(connection.provider_type) %>/authorize" data-oauth-connect="<%= connection.provider_type %>" data-provider-name="<%= providerName %>"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="connectorId" value="<%= connection.id %>">
      <% if(connection.config.shop){ %><input type="hidden" name="shop" value="<%= connection.config.shop %>"><% } %><% if(connection.config.storeUrl){ %><input type="hidden" name="storeUrl" value="<%= connection.config.storeUrl %>"><% } %>
      <button class="btn btn--primary" type="submit">Sign in again to <%= providerName %></button>
    </form>
  <% } %>
</section>
<% } %>
<% if(connected&&currentUser.role==='owner'&&proof.push_setup_failed){ %>
<form method="post" action="/settings/connections/<%= encodeURIComponent(connection.id) %>/retry-events" class="section"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="btn btn--secondary" type="submit">Retry event setup</button></form>
<% } %>
<% if(newConnectionToken){ %><div class="notice notice--warn section"><div><strong>Copy this secure connection key now. StockChief will not show it again.</strong><input class="input mono" aria-label="Connection token" value="<%= newConnectionToken %>" readonly onclick="this.select()"></div></div><% } %>

<div class="cx-cols">
<div class="cx-main">
<% if(locals.connectionIssues&&(connectionIssues.total||connectionIssues.focused)){ %>
<section class="card section" id="connection-issues" aria-label="Connection issues">
  <div class="card-head"><h2>What needs attention</h2><span class="badge badge--warn"><%= connectionIssues.total %> open</span></div>
  <div class="card-body grid">
    <% if(!connectionIssues.rows.length){ %><p>No open issue matches this view.</p><% } %>
    <% connectionIssues.rows.forEach(function(issue){ %><article id="issue-<%= issue.id %>">
      <h3><%= issue.title %></h3>
      <% if(issue.code){ %><p><strong><%= issue.code %></strong><% if(issue.location){ %> · <%= issue.location %><% } %><% if(issue.field){ %> · <%= issue.field==='quantity'?'Sellable stock':'Selling price' %><% } %></p><% } %>
      <p><%= issue.detail %></p><% if(issue.resolution_hint){ %><p><strong>Next step:</strong> <%= issue.resolution_hint %></p><% } %>
      <p class="hint">Last checked <time data-local-time datetime="<%= new Date(issue.updated_at).toISOString() %>"><%= helpers.dateTime(issue.updated_at) %></time></p>
    </article><% }); %>
    <nav class="form-actions" aria-label="Connection issue pages">
      <% if(connectionIssues.focused){ %><a class="btn" href="/settings/connections/<%= encodeURIComponent(connection.id) %>#connection-issues">View all open issues</a>
      <% }else{ %><% if(connectionIssues.page>1){ %><a class="btn" href="?issuesPage=<%= connectionIssues.page-1 %>#connection-issues">Previous issues</a><% } %><% if(connectionIssues.page*10<connectionIssues.total){ %><a class="btn" href="?issuesPage=<%= connectionIssues.page+1 %>#connection-issues">Next issues</a><% } %><% } %>
    </nav>
  </div>
</section><% } %>
  <% if(accounting){ const externalAccounts=accounting.latestShadow?.externalSnapshot?.accounts||[]; %>
    <%- include('accounting-summary',{connection,accounting,providerName,connected,hasCatalogue}) %>
    <details class="card cx-accounting-options" id="accounting-options" <%= accounting.policy.requested_authority!=='OBSERVE'||locals.accountingExpanded?'open':'' %>><summary class="card-head"><div><h2>Accounting access and comparisons</h2><p class="muted">Choose read-only access, compare balances, or request permission to post approved entries.</p></div></summary><div class="card-body grid">
      <dl class="cx-accounting-summary__facts"><div><dt>Accounts matched</dt><dd><%= accounting.mappings.length %></dd></div><div><dt>Pending journals</dt><dd><%= accounting.pendingEntries.length %></dd></div><div><dt>Confirmed exports</dt><dd><%= accounting.postedEntries.length %></dd></div></dl>
      <% if(accounting.canVerifyWrites&&accounting.policy.requested_authority==='OBSERVE'){ %><form method="post" action="/settings/connections/<%= connection.id %>/accounting/authority"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="authority" value="POST"><button class="btn btn--primary" type="submit">Request governed posting</button></form><% } %>
      <form method="post" action="/settings/connections/<%= connection.id %>/accounting/authority" class="choice-grid"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><label class="choice"><input type="radio" name="authority" value="OBSERVE" <%= accounting.policy.requested_authority==='OBSERVE'?'checked':'' %>><span><strong>Observe only</strong><small>Read identity and health. Never post.</small></span></label><label class="choice"><input type="radio" name="authority" value="SHADOW" <%= accounting.policy.requested_authority==='SHADOW'?'checked':'' %>><span><strong>Shadow comparison</strong><small>Compare without changing either system.</small></span></label><% if(accounting.canVerifyWrites){ %><label class="choice"><input type="radio" name="authority" value="POST" <%= accounting.policy.requested_authority==='POST'?'checked':'' %>><span><strong>Request governed posting</strong><small>Still blocked until exact parity and final enablement.</small></span></label><% } %><div class="form-actions"><button class="btn btn--primary" type="submit">Save authority</button></div></form>
      <% if(connection.provider_type==='xero'&&currentUser.role==='owner'&&accounting.policy.requested_authority==='POST'&&!connection.capabilities.includes('accounting:post')){ %>
        <form method="post" action="/settings/connections/xero/authorize" data-oauth-connect="xero" data-provider-name="Xero"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="connectorId" value="<%= connection.id %>"><input type="hidden" name="requestedAuthority" value="POST"><p>Xero needs your permission to post journals and eligible invoices or bills. Granting permission does not enable posting; matching books and your final approval remain required.</p><button class="btn btn--secondary" type="submit">Grant Xero journal permission</button></form>
      <% } %>
      <% if(connection.provider_type==='xero'&&accounting.canVerifyWrites){ %><p class="hint" data-xero-posting-controls>Manual approvals are available from day one after posting setup. Automatic agent actions are blocked for the first 14 days. Afterward, your plan, teaching rules and chosen approvals still apply. Automated invoice and bill exports require Pro or Custom.</p><% } %>
      <% if(accounting.policy.requested_authority!=='OBSERVE'){ %><form method="post" action="/settings/connections/<%= connection.id %>/accounting/shadow" class="form-actions"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><label class="field"><span class="field-label">Compare through</span><input class="input" type="date" name="asOf" value="<%= new Date().toISOString().slice(0,10) %>"></label><button class="btn" type="submit">Run read-only shadow comparison</button></form><% } %>
      <% if(accounting.latestShadow){ %><div class="notice <%= accounting.latestShadow.isCurrent&&accounting.latestShadow.status==='MATCHED'?'notice--success':'notice--warn' %>"><div><strong><%= !accounting.latestShadow.isCurrent?'Run a new comparison for the current authority and mappings':accounting.latestShadow.status==='MATCHED'?'Shadow comparison matched exactly':accounting.latestShadow.differences.length+' accounting difference'+(accounting.latestShadow.differences.length===1?'':'s')+' remain. Nothing was posted.' %></strong><p>Compared through <%= accounting.latestShadow.as_of %>.</p></div></div><% } %>
      <% if(accounting.openingBooks?.canImport){ var opening=accounting.openingBooks; var openingMoney=function(value){return new Intl.NumberFormat('en-US',{style:'currency',currency:opening.currency}).format(value/Math.pow(10,opening.currencyExponent));}; %>
        <section class="card" aria-label="Review starting balances"><div class="card-body grid">
          <div><h3>Start these empty books from <%= providerName %></h3><p>Copy the verified balances as of <%= opening.asOf %> into this StockChief business. This records one opening journal and maps <%= opening.accountCount %> accounts. It does not send a journal back to <%= providerName %>, import inventory quantities or enable posting.</p></div>
          <p><strong><%= opening.currency %> · Debits <%= openingMoney(opening.debitMinor) %> · Credits <%= openingMoney(opening.creditMinor) %></strong></p>
          <details><summary>Review all <%= opening.nonzeroCount %> balances</summary><div class="table-wrap"><table class="table"><thead><tr><th scope="col">Provider account</th><th scope="col">Type</th><th scope="col">Debit</th><th scope="col">Credit</th></tr></thead><tbody>
          <% opening.accounts.filter(function(row){return row.balanceMinor!==0;}).forEach(function(row){ %><tr><th scope="row"><%= row.name %></th><td><%= row.shape.type.toLowerCase() %></td><td><%= row.balanceMinor>0?openingMoney(row.balanceMinor):'—' %></td><td><%= row.balanceMinor<0?openingMoney(-row.balanceMinor):'—' %></td></tr><% }) %>
          </tbody></table></div></details>
          <form method="post" action="/settings/connections/<%= connection.id %>/accounting/import-opening"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="runId" value="<%= opening.runId %>"><input type="hidden" name="scopeHash" value="<%= opening.scopeHash %>"><button class="btn btn--primary" type="submit">Approve these starting balances</button></form>
          <p class="hint">Only an owner can approve this exact snapshot. Changed provider balances or existing StockChief accounting activity stop the import.</p>
        </div></section>
      <% } else if(accounting.openingBooks?.alreadyImported){ %><p class="notice notice--success">Starting balances are recorded. They are excluded from outbound posting.</p><% } else if(accounting.openingBooks?.error){ %><p class="notice notice--warn"><%= accounting.openingBooks.error %></p><% } %>
      <% if(externalAccounts.length&&accounting.policy.requested_authority!=='OBSERVE'){ %><details open><summary>Map exact accounting accounts</summary><form method="post" action="/settings/connections/<%= connection.id %>/accounting/map-account" class="grid grid--2"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><label class="field"><span class="field-label">StockChief account</span><select class="select" name="accountId" required><option value="">Choose account</option><% accounting.accounts.forEach(function(account){ %><option value="<%= account.id %>"><%= account.code %> · <%= account.name %></option><% }) %></select></label><label class="field"><span class="field-label">Provider account</span><select class="select" name="externalId" required><option value="">Choose verified <%= providerName %> account</option><% externalAccounts.forEach(function(account){ %><option value="<%= account.externalId %>"><%= account.code||account.externalId %> · <%= account.name %></option><% }) %></select></label><button class="btn" type="submit">Save exact mapping</button></form></details><% } %>
      <% if(accounting.canVerifyWrites&&accounting.policy.stage==='WRITE_READY'){ %><form method="post" action="/settings/connections/<%= connection.id %>/accounting/enable"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="btn btn--primary" type="submit">Enable verified posting</button></form><% } %>
      <% if(accounting.canVerifyWrites&&accounting.policy.stage==='WRITE_ENABLED'){ %><form method="post" action="/settings/connections/<%= connection.id %>/accounting/export"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="btn btn--primary" type="submit">Queue ready journals</button></form><% } %>
      <% if(accounting.pendingEntries.length){ %><div class="grid"><% accounting.pendingEntries.forEach(function(entry){ %><div class="list-row"><div><strong>Journal <%= entry.entry_number %> · <%= entry.description %></strong><p><%= helpers.shortDate(entry.posting_date) %></p></div><span class="badge"><%= entry.effect_status||'not queued' %></span></div><% }) %></div><% } %>
    </div></details>
  <% } else { %>
    <% if(isMailbox){ %>

      <section class="card" aria-label="Mailbox settings">
        <div class="card-head"><div><h2>Business email</h2><p class="muted">Only mail from a known customer or supplier, or a reply to a conversation StockChief sent, enters the business inbox. Other senders are set aside without saving their message body or attachments.</p></div></div>
        <div class="card-body grid">
          <p><strong><%= connected?'Connected mailbox:':'Saved mailbox:' %></strong> <%= connection.provider_account_name||'Account identity unavailable' %></p>
          <div class="form-actions"><a class="btn btn--primary" href="/mail">View business emails</a><a class="btn" href="/mail/set-aside">Review set-aside senders</a></div>
          <p class="hint">Add or update a supplier or customer email address on that contact's record. StockChief matches the sender to those addresses; connecting a mailbox alone does not approve every sender.</p>
          <% if(currentUser.role==='owner'){ %>
            <% if(connected){ %><form method="post" action="/settings/connections/<%= connection.id %>/check-mail"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="btn" type="submit">Check mailbox now</button></form><% } %>
          <% } %>
          <p class="hint">Last completed check: <%= mailboxLastPollAt?helpers.timeAgo(mailboxLastPollAt):'not yet' %>. Queuing a check is not proof that it completed.</p>
        </div>
      </section>
      <%- include('mail-preparation',{mailPreparation,connection}) %>
    <% } %>
<% } %>
    <% if(canDiscover&&!(accounting&&connection.catalogueSetupOptional)){ %><section class="card"><div class="card-head"><div><h2>Products and locations</h2><p class="muted">Exact matches happen automatically. Ambiguous records stay unchanged. Organization-wide balances need a location match before stock is imported.</p></div></div><div class="card-body">
<div class="stats-row cx-stats">
  <div class="stat"><span>Products mapped</span><strong><%= connection.productsMapped %></strong></div>
  <div class="stat"><span>Locations mapped</span><strong><%= connection.locationsMapped %></strong></div>
  <div class="stat<%= connection.itemsNeedingMapping?' is-warn':'' %>"><span>Need your match</span><strong><%= connection.itemsNeedingMapping %></strong></div>
</div><% if(query&&query.refresh==='queued'){ %><div class="notice notice--success">Catalogue refresh queued.</div><% } %><% if(connected){ %><form method="post" action="/settings/connections/<%= connection.id %>/refresh"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="btn" type="submit">Refresh now</button></form><% } %></div></section><% } %>
    <% if(catalogueReview){ %>
      <% if(accounting&&connection.catalogueSetupOptional){ %><details class="card cx-catalogue-option" id="catalogue-review" <%= locals.catalogueExpanded?'open':'' %>>
        <summary class="card-head"><div><h2>Optional product setup</h2><p class="muted"><%= helpers.connectionPresentation.matchingSummary(connection) %> available to review. Accounting reads work without importing them.</p></div><span class="badge badge--muted">Optional</span></summary>
        <div class="card-body"><% if(query&&query.refresh==='queued'){ %><p class="notice notice--success">Product and location refresh queued.</p><% } %><% if(connected&&currentUser.role==='owner'){ %><form method="post" action="/settings/connections/<%= connection.id %>/refresh"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="btn" type="submit">Refresh products and locations</button></form><% } %></div>
        <%- include('catalogue-matching',{catalogueReview,connection,optionalAccountingCatalogue:true}) %>
      </details><% }else{ %><%- include('catalogue-matching',{catalogueReview,connection}) %><% } %>
    <% } %>
<% if(['shopify','square','clover','woocommerce','bigcommerce'].includes(connection.provider_type)){ %>
<section class="card section" aria-label="Stock and price synchronization"><div class="card-head"><h2>Stock and price synchronization</h2></div><div class="card-body">
<p>Outgoing stock is costed, uncommitted stock available to sell. Incoming count differences need physical confirmation. Conflicts are held for review; a queued delivery is complete only after provider read-back.</p>
<% if(locals.canManageCommerce){ %><details><summary>Set up stock and price synchronization</summary>
<form method="post" action="/settings/connections/<%= connection.id %>/commerce-synchronization" class="section">
<input type="hidden" name="_csrf" value="<%= csrfToken %>">
<div class="form-grid"><label>Product SKU<input name="sku" maxlength="200" required placeholder="Exact mapped SKU"></label>
<label>Location<input name="location" maxlength="200" required placeholder="Exact mapped location name"></label>
<% for(const field of [['quantitySyncMode','Stock direction'],['priceSyncMode','Price direction']]){ %>
<label><%= field[1] %><select name="<%= field[0] %>"><option value="">Leave unchanged</option><option value="off">Off</option><option value="outbound">StockChief to provider</option><option value="inbound">Provider to StockChief</option><option value="two_way">Both directions</option></select></label><% } %>
<label class="field--full">If the starting values differ<select name="initialSyncSource" required><option value="require_equal">Stop and ask me</option><option value="stockchief">Use StockChief's value</option><option value="provider">Use the provider's value</option></select></label></div>
<p>You will review the exact matches and current values before approving. This step does not turn on synchronization.</p>
<button type="submit" class="btn btn--primary">Review synchronization</button></form></details><% } %>
  <% if(!locals.commercePositions?.length){ %><p>No stock or price write-back has been authorized yet. Ask StockChief to prepare the direction and starting source for the products and locations you want to synchronize.</p><% }else{ %>
  <div class="table-scroll"><table class="table"><thead><tr><th>SKU</th><th>Location</th><th>Field</th><th>Direction</th><th>Last verified values</th><th>Delivery</th></tr></thead><tbody>
  <% commercePositions.forEach(function(p){ const show=function(v){return v===null?'Unknown':typeof v==='object'?helpers.money(v.amount,v.currency):v;}; %>
  <tr><td><%= p.code %></td><td><%= p.location %></td><td><%= p.field==='quantity'?'Sellable units':'Selling price' %></td><td><%= {off:'Off',inbound:'Provider → StockChief',outbound:'StockChief → provider',two_way:'Both directions'}[p.mode] %></td><td>StockChief: <%= show(p.baseline_local) %><br>Provider: <%= show(p.baseline_provider) %></td><td><% if(p.review_issue_id){ %><a href="?issue=<%= encodeURIComponent(p.review_issue_id) %>#connection-issues">Needs review: <%= p.review_title %></a><% }else{ %><%= p.mode==='off'?'Off':p.pending_effect_id?({PENDING:'Queued',RUNNING:'Verifying with provider',AMBIGUOUS:'Needs review: delivery uncertain',FAILED:'Needs review: delivery failed'}[p.delivery_status]||'Awaiting provider verification'):p.last_verified_at?'Verified':'Awaiting first check' %><% } %></td></tr>
  <% }); %></tbody></table></div><% } %><p><a href="/ask?from=<%= encodeURIComponent('/settings/connections/'+connection.id) %>">Ask StockChief to review or change these settings</a></p>
</div></section><% } %>
<% if(locals.pendingWebhooks?.length){ const receiptLabels={RECEIVED:'Queued',PROCESSING:'Processing',RETRY_PENDING:'Waiting to retry',NEEDS_MAPPING:'Needs a match',NEEDS_REVIEW:'Needs review'}; %>
<section class="card section" aria-label="Retained provider events">
  <div class="card-head"><h2>Events still being resolved</h2></div>
  <div class="card-body"><p>Original provider evidence is retained securely. Completed operations are kept; resuming handles the remaining steps only.</p>
  <% pendingWebhooks.forEach(function(receipt){ %><div class="section">
    <strong><%= receiptLabels[receipt.status]||'Waiting' %></strong> · Received <time datetime="<%= new Date(receipt.received_at).toISOString() %>" title="<%= new Date(receipt.received_at).toISOString() %>"><time data-local-time datetime="<%= receipt.received_at %>"><%= helpers.dateTime(receipt.received_at) %></time></time>
    <% if(currentUser.role==='owner'&&(['NEEDS_MAPPING','NEEDS_REVIEW','RETRY_PENDING'].includes(receipt.status)||(receipt.status==='PROCESSING'&&new Date(receipt.lease_until||0).getTime()<=Date.now()))){ %>
    <form method="post" action="/settings/connections/<%= encodeURIComponent(connection.id) %>/receipts/<%= encodeURIComponent(receipt.id) %>/resume">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="btn btn--secondary btn--sm" type="submit">Resume after resolving</button>
    </form><% } %>
  </div><% }) %></div>
</section><% } %>
</div>
<aside class="cx-side">
<% const sync=connection.synchronization; if(sync?.supported){ %>
<section class="card section" aria-label="Automatic synchronization" data-connection-synchronization="<%= connection.id %>" data-last-check="<%= sync.lastCheckAt||'' %>" data-products-mapped="<%= connection.productsMapped %>" data-locations-mapped="<%= connection.locationsMapped %>">
  <div class="card-head"><div><h2>Automatic synchronization</h2><p class="muted"><%= sync.scope==='mailbox'?'Check for new business email.':'Check products, variants, prices and provider stock observations. Sales and accounting follow their verified event and approval workflows.' %></p></div><span class="badge <%= sync.mode==='active'?'badge--ok':'badge--muted' %>"><%= {active:'On',paused:'Paused',off:'Off',disconnected:'Sign-in needed'}[sync.mode] %></span></div>
  <div class="card-body grid">
    <p role="status" aria-live="polite" data-connection-sync-progress><%= sync.mode==='active'?'Automatic checks are on.':sync.mode==='paused'?'Automatic updates are temporarily paused.':sync.mode==='off'?'Automatic updates are off.':'Sign in to start automatic updates.' %></p>
    <a class="btn" href="/settings/connections/<%= connection.id %>" data-connection-sync-updated hidden>View updated products and matches</a>
    <dl class="grid"><div><dt>Last completed check</dt><dd data-sync-last><% if(sync.lastCheckAt){ %><time datetime="<%= new Date(sync.lastCheckAt).toISOString() %>"><time data-local-time datetime="<%= sync.lastCheckAt %>"><%= helpers.dateTime(sync.lastCheckAt) %></time></time><% }else{ %>Waiting for the first check<% } %></dd></div>
      <div><dt>Next check</dt><dd data-sync-next><%= sync.retryAt?'Waiting for the provider until '+helpers.dateTime(sync.retryAt):sync.nextCheckAt?helpers.dateTime(sync.nextCheckAt):sync.mode==='disconnected'?'Sign in to resume updates':sync.mode==='off'?'Automatic updates are off':'Resume to schedule updates' %></dd></div></dl>
    <% if(sync.providerLimitNote){ %><p class="hint"><%= sync.providerLimitNote %></p><% } %>
    <p class="hint">Supported webhooks are processed as they arrive. Scheduled checks provide a fallback; provider limits and retries can delay them. Stock observations do not create receipts or inventory cost. Accounting posting and other consequential actions keep their existing authority checks.</p>
    <% if(currentUser.role==='owner'){ %><form method="post" action="/settings/connections/<%= connection.id %>/synchronization" class="form-actions">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <label class="field"><span class="field-label">Automatic updates</span><select class="select" name="mode"><option value="on" <%= sync.mode!=='off'?'selected':'' %>>On</option><option value="off" <%= sync.mode==='off'?'selected':'' %>>Off</option></select></label>
      <label class="field"><span class="field-label">Check frequency</span><select class="select" name="minutes"><% const choices=[...new Set([1,5,10,15,30,60,sync.requestedMinutes])].sort((a,b)=>a-b); choices.forEach(function(minutes){ %><option value="<%= minutes %>" <%= sync.requestedMinutes===minutes?'selected':'' %>>Every <%= minutes %> minute<%= minutes===1?'':'s' %></option><% }); %></select></label>
      <% if(canDiscover&&!accounting){ %><label class="checkbox"><input type="checkbox" name="autoImportCatalog" value="1" <%= connection.config.autoImportCatalog===true?'checked':'' %>> Automatically import new products, initial prices, locations and their reported opening stock once. Do not invent missing quantities, inventory cost or supplier bills.</label><% } %>
      <button class="btn btn--primary" type="submit">Save synchronization</button>
    </form><% } %>
  </div>
</section>
<script src="/connection-sync.js?v=<%= assetVersion %>" defer></script>
<% } %>
<% if(connection.provider_type==='woocommerce'&&currentUser.role==='owner'){ %><details class="card" id="reauthorize-woocommerce"><summary>Update WooCommerce authorization</summary><div class="card-body"><%- include('woocommerce-connect',{provider,postgresMode:true,csrfToken}) %></div></details><% } %>
    <section class="card"><div class="card-head"><h2>Connection control</h2></div><div class="card-body"><p class="hint">Pausing is reversible. Disconnecting removes the encrypted credential while keeping mappings and audit history.</p><div class="form-actions"><% if(connection.paused_at){ %><form method="post" action="/settings/connections/<%= connection.id %>/resume"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="btn btn--primary" type="submit">Resume</button></form><% } else if(connection.status==='connected'){ %><form method="post" action="/settings/connections/<%= connection.id %>/pause"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="btn" type="submit">Pause</button></form><% } %><% if(connection.status!=='disconnected'){ %><form method="post" action="/settings/connections/<%= connection.id %>/disconnect"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="btn btn--danger" type="submit">Disconnect and remove credentials</button></form><% } %></div></div></section>
    <details class="card"><summary class="card-head"><h2>Advanced diagnostics</h2></summary><div class="card-body"><p class="mono">Connection <%= connection.id %></p><p>Provider: <%= connection.provider_type %></p><p>Setup: <%= connection.setup_status %></p><p>Open issues: <%= connection.openIssues %></p><p>Last processed event: <%= proof.event_at||'none' %></p><p>Last successful sync: <%= connection.last_synced_at||'none' %></p></div></details>
</aside>
</div>
</div>
