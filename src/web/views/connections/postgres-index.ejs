<%
  var groups=[
    {key:'accounting',title:'Accounting',description:'Connect read-only first, prove the books agree, then choose whether StockChief may post.'},
    {key:'selling',title:'Selling',description:'Stores and tills. StockChief brings completed sales in by itself.'},
    {key:'business',title:'Business systems',description:'Your own POS, ERP or warehouse software.'},
    {key:'supplier',title:'Supplier communication',description:'Mailboxes carrying customer and supplier business messages.'},
  ];
  var active=connections.filter(function(connection){return connection.status!=='disconnected';});
%>

<header class="rm-head">
  <p class="rm-head__eyebrow"><%- helpers.icon('link',{size:15}) %> Connections</p>
  <h1>Where your business already happens</h1>
  <p>Each inventory connects to its own accounts. Connect your shop, till, mailbox and books; credentials, records and authority are never shared with another inventory.</p>
</header>

<div class="rm-sect"><h2>Working now</h2><% if(active.length){ %><span class="rm-sect__c"><%= active.length %> connected</span><% } %></div>
<% if(!active.length){ %>
  <div class="rm-empty"><span class="rm-empty__ic"><%- helpers.icon('link',{size:19}) %></span><strong>Nothing is connected yet</strong><p>Pick the system that already holds useful business records. You sign in with that provider; StockChief never asks for its password.</p></div>
<% } else { %>
  <div class="rm-told"><% active.forEach(function(connection){ %><a class="rm-told__row" href="/settings/connections/<%= connection.id %>">
    <span class="rm-told__t"><%= connection.display_name %><small><%= connection.provider_account_name||connection.provider_type %><% if(connection.last_activity_at){ %> · last activity <%= helpers.timeAgo(connection.last_activity_at) %><% } else { %> · connected, no successful exchange recorded yet<% } %></small></span>
    <span class="rm-told__m <%= connection.publicStatus==='Connected'?'is-ok':'is-warn' %>"><%= connection.publicStatus %></span>
  </a><% }) %></div>
<% } %>

<% groups.forEach(function(group){var choices=providerCatalog.filter(function(provider){return provider.category===group.key;});if(!choices.length)return; %>
  <div class="rm-sect" id="group-<%= group.key %>"><h2><%= group.title %></h2><p><%= group.description %></p></div>
  <div class="rm-choices-grid"><% choices.forEach(function(provider){var connected=active.some(function(connection){return connection.provider_type===provider.type;}); %>
    <article class="rm-provider">
      <div class="rm-provider__h"><span class="rm-provider__mark <%= String(provider.mark||'↗').length>2?'is-word':'' %>" aria-hidden="true"><%= provider.mark||'↗' %></span><span class="rm-provider__n"><%= provider.name %></span><% if(connected){ %><span class="rm-pillbadge is-ok">connected</span><% } else if(!provider.available){ %><span class="rm-pillbadge">not available here</span><% } %></div>
      <p><%= provider.description %></p>
      <% if(connected){ %><p class="quiet">This inventory already has an active <%= provider.name %> connection. Open it under Working now to inspect or disconnect it.</p>
      <% } else if(provider.available&&provider.authMode==='oauth'){ %><a class="rm-btn rm-btn--wash" href="/settings/connections/<%= provider.type %>/launch?ticket=<%= encodeURIComponent(launchTicket) %>" target="_blank" rel="opener" data-provider-connect>Connect <%= provider.name %></a>
      <% } else { %><p class="quiet"><%= provider.unavailableReason||'This connector needs server-side provider credentials before a business can authorize it.' %></p><% } %>
    </article>
  <% }) %></div>
<% }) %>

<div class="rm-sect" id="custom-system"><h2>Your own system</h2><p>Create a scoped event feed for an ERP, warehouse, or in-house system. The bearer token appears once.</p></div>
<section class="rm-provider"><form method="post" action="/settings/connections/custom" class="grid">
  <input type="hidden" name="_csrf" value="<%= csrfToken %>"><label class="field"><span class="field-label">Connection name</span><input class="input" name="displayName" required maxlength="100" placeholder="Warehouse ERP"></label><button class="rm-btn rm-btn--wash" type="submit">Create event connection</button>
</form></section>

<details class="rm-work" id="developer-api" open><summary>Developer API — most businesses do not need this</summary><div class="rm-work__body">
  <% if(apiToken){ %><div class="rm-note rm-note--warn"><strong>Copy this token now</strong><input aria-label="New API token" value="<%= apiToken.token %>" readonly onclick="this.select()"><small>Scopes: <%= apiToken.scopes.join(', ') %>. Only its one-way digest is stored.</small></div><% } %>
  <div class="rm-told"><% apiClients.forEach(function(client){ %><div class="rm-told__row"><span class="rm-told__t"><%= client.name %><small><%= client.scopes.join(', ') %> · <%= client.token_prefix %>…</small></span><span class="rm-told__m <%= client.revoked_at?'':'is-ok' %>"><%= client.revoked_at?'Revoked':'Active' %></span><% if(!client.revoked_at&&currentUser.role==='owner'){ %><form method="post" action="/settings/connections/api-clients/<%= client.id %>/revoke" data-confirm="Revoke this API token immediately?"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="rm-btn rm-btn--ghost" type="submit">Revoke</button></form><% } %></div><% }) %></div>
  <% if(currentUser.role==='owner'){ %><form method="post" action="/settings/connections/api-clients" class="grid" style="margin-top:16px"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><label class="field"><span class="field-label">Client name</span><input class="input" name="name" required placeholder="Warehouse automation"></label><label class="choice"><input type="checkbox" name="scopes" value="inventory:read"><span><strong>Read inventory</strong></span></label><label class="choice"><input type="checkbox" name="scopes" value="inventory:write"><span><strong>Receive or correct inventory</strong><small>Submit controlled inventory commands through the canonical ledger.</small></span></label><button class="rm-btn rm-btn--wash" type="submit">Create scoped token</button></form><% } %>
</div></details>

<script>
document.querySelectorAll('[data-provider-connect]').forEach(function(link){link.addEventListener('click',function(event){event.preventDefault();var popup=window.open(link.href,'stockchief-provider-connect','popup=yes,width=720,height=780,resizable=yes,scrollbars=yes');if(!popup){window.location.assign(link.href);return;}popup.focus();});});
window.addEventListener('message',function(event){if(!event.data||event.data.type!=='foundry:connection-return'||event.origin!==window.location.origin)return;window.location.assign(event.data.returnPath||'/settings/connections');});
</script>
