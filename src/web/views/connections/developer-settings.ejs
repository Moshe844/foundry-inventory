<%- include('../components/plan-lock',{capability:'api.public',label:'API access'}) %>
<details class="rm-work" id="developer-api" <%= apiToken || webhookSecret ? 'open' : '' %>>
  <summary>Advanced: connect custom software with APIs and webhooks</summary>
  <div class="rm-work__body">
    <p class="quiet"><strong>Most business owners do not need this.</strong> Use it only when your ERP, warehouse system, developer, or reporting tool needs to exchange data directly with StockChief.</p>
    <div class="rm-grid2" style="margin-top:16px">
  <section class="rm-provider">
    <div class="rm-provider__top"><span class="rm-provider__mark is-word">API</span><span class="rm-provider__n">Scoped API clients</span></div>
    <p><%= postgresMode?'Read inventory or submit inventory commands. Use signed webhooks below to receive events.':'Read inventory/events or submit canonical inventory commands.' %> No client can write balance tables directly.</p>
    <% if (apiToken) { %><div class="rm-note rm-note--warn"><div><strong>Copy this token now</strong><input class="input mono" aria-label="New API token" value="<%= apiToken.token %>" readonly onclick="this.select()"><small>Shown once. Scopes: <%= apiToken.scopes.join(', ') %></small></div></div><% } %>
    <% apiClients.forEach(function(client) { %><div class="rm-told__row"><span class="rm-told__t"><%= client.name %><small><%= client.scopes.join(', ') %> · <%= client.token_prefix %>…</small></span><span class="rm-told__m <%= client.revoked_at ? '' : 'is-ok' %>"><%= client.revoked_at ? 'Revoked' : 'Active' %></span><% if (!client.revoked_at && currentUser.role === 'owner') { %><form method="post" action="/settings/connections/api-clients/<%= client.id %>/revoke" data-confirm="Revoke this API token immediately?"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="rm-btn rm-btn--ghost" type="submit">Revoke</button></form><% } %></div><% }) %>
    <% if (currentUser.role === 'owner'&&locals.planGates?.['api.public']?.enabled!==false) { %>
      <form method="post" action="/settings/connections/api-clients" class="grid" style="margin-top:16px">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <label class="field"><span class="field-label">Client name</span><input class="input" name="name" placeholder="Warehouse automation" required></label>
        <div class="choice-grid">
          <label class="choice"><input type="checkbox" name="scopes" value="inventory:read"><span><strong>Read inventory</strong></span></label>
          <label class="choice"><input type="checkbox" name="scopes" value="inventory:write"><span><strong><%= postgresMode ? 'Receive or correct inventory' : 'Submit inventory commands' %></strong></span></label>
          <% if (!postgresMode) { %>
            <label class="choice"><input type="checkbox" name="scopes" value="events:read"><span><strong>Read events</strong></span></label>
            <label class="choice"><input type="checkbox" name="scopes" value="migration:read"><span><strong>Read migration checks</strong></span></label>
            <label class="choice"><input type="checkbox" name="scopes" value="migration:write"><span><strong>Stage migration evidence</strong><small>Cannot approve or activate cutover</small></span></label>
          <% } %>
        </div>
        <button class="rm-btn rm-btn--wash" type="submit">Create scoped token</button>
      </form>
    <% } %>
    <details class="rm-more"><summary>How to prove this API works</summary><div><p>Start with a token that has only <strong>Read inventory</strong>. Give it to the test client for this one inventory and request <code>GET /api/v1/public/inventory</code>. The response must identify StockChief as the source of truth and must contain only this inventory’s records.</p><p>Then create a separate write-enabled test token. Send one receive command with an <code>Idempotency-Key</code>, resend the exact same command, and confirm stock changes once. Revoke the token and confirm the next request is refused.</p></div></details>
    <details class="rm-more"><summary>Endpoints and contract</summary><div><p><code>GET /api/v1/public/inventory</code></p><p><code>POST /api/v1/public/commands/inventory/receive</code></p><p><code>POST /api/v1/public/commands/inventory/adjust</code></p><p>Every write requires a stable <code>Idempotency-Key</code>; retrying the same command returns its original result without posting twice.</p></div></details>
  </section>
  <section class="rm-provider">
    <div class="rm-provider__top"><span class="rm-provider__mark is-word">WEB</span><span class="rm-provider__n">Signed outbound webhooks</span></div>
    <p>Deliver committed events with HMAC signatures and durable retries. Receivers must deduplicate by event ID because an uncertain response can be retried. Up to 10 active endpoints per inventory; deliveries use the plan’s API-event allowance.</p>
    <% if (webhookSecret) { %><div class="rm-note rm-note--warn"><div><strong>Copy this signing secret now</strong><input class="input mono" aria-label="New webhook signing secret" value="<%= webhookSecret.secret %>" readonly onclick="this.select()"></div></div><% } %>
    <% outboundWebhooks.forEach(function(hook) { %><div class="rm-told__row"><span class="rm-told__t"><%= hook.name %><small><%= hook.endpoint_url %> · <%= hook.eventTypes.join(', ') %></small><% if(hook.last_error){ %><small><%= hook.last_error %></small><% } %></span><span class="rm-told__m <%= hook.status === 'ACTIVE' ? 'is-ok' : '' %>"><%= hook.status %></span><% if (hook.status === 'ACTIVE' && currentUser.role === 'owner') { %><form method="post" action="/settings/connections/outbound-webhooks/<%= hook.id %>/revoke" data-confirm="Stop sending all future events to this webhook?"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="rm-btn rm-btn--ghost" type="submit">Revoke</button></form><% } %></div><% }) %>
    <% if (currentUser.role === 'owner'&&locals.planGates?.['api.public']?.enabled!==false) { %><form method="post" action="/settings/connections/outbound-webhooks" class="grid" style="margin-top:16px"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><label class="field"><span class="field-label">Webhook name</span><input class="input" name="name" placeholder="Data warehouse" required></label><label class="field"><span class="field-label">HTTPS endpoint</span><input class="input" type="url" name="endpointUrl" placeholder="https://example.com/foundry-events" required></label><label class="field"><span class="field-label">Events</span><select class="select" name="eventTypes" multiple required><% if(postgresMode){ %><option value="stock.changed">Stock changed</option><option value="purchase_order.received">Purchase order received</option><option value="order.created">Order created</option><% }else{ %><option value="*">All business events</option><option value="inventory.received">Inventory received</option><option value="inventory.issued">Inventory issued</option><option value="purchase_order.completed">Purchase order completed</option><option value="sales_order.fulfilled">Sales order fulfilled</option><% } %></select><span class="field-help">Use Ctrl/Cmd to choose several.</span></label><button class="rm-btn rm-btn--wash" type="submit">Create signed webhook</button></form><% } %>
    <details class="rm-more"><summary>How to prove this webhook works</summary><div><p>Use an HTTPS test receiver you control. Create the webhook for <strong><%= postgresMode?'Stock changed':'Inventory received' %></strong>, receive one unit in StockChief, and confirm the receiver gets one signed event with its StockChief event ID.</p><p>Return an error once to prove StockChief records the failure and retries durably. Then accept the retry and confirm the same event is not delivered as a second business effect. Revoke the webhook and confirm later events are not sent.</p></div></details>
    <p><a href="/api/docs">Signature verification and API documentation</a></p>
  </section>
    </div>
  </div>
</details>
