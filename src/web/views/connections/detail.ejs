<% var isMailbox = ['supplier_email','gmail','microsoft365'].includes(connection.provider_type); %>
<% var watchedRules = isMailbox ? emailRules.filter(function(rule) { return rule.supplier_id && rule.supplier_name; }) : []; %>
<% var pendingEmailRule = isMailbox ? emailRules.find(function(rule) { return !rule.supplier_id; }) : null; %>
<% var isAccounting = Boolean(accounting); %>
<% if (isMailbox) { %><div data-live-mailbox data-connector-id="<%= connection.id %>" data-signature="<%= mailboxSignature %>" hidden></div><% } %>
<header class="page-head">
  <div class="titles">
    <div class="breadcrumbs"><a href="/settings/connections">Connections</a><span>›</span><span><%= connection.display_name %></span></div>
    <h1><%= connection.display_name %></h1>
    <p class="page-sub"><% if (isMailbox) { %><%= connection.provider_account_name || provider.name %> · StockChief watches only the suppliers you choose<% } else { %><%= provider.name %><%= connection.provider_account_name ? ' · ' + connection.provider_account_name : '' %> · <%= connection.provides.join(', ') %><% } %></p>
  </div>
  <span class="badge <%= connection.publicStatus === 'Connected' ? 'badge--ok' : connection.publicStatus === 'Needs attention' ? 'badge--warn' : 'badge--muted' %>"><%= connection.publicStatus %></span>
</header>

<% if (!isMailbox && !isAccounting) { %><div class="stats-row section">
  <div class="stat"><strong><%= connection.productsMapped %></strong><span>products mapped</span></div>
  <div class="stat"><strong><%= connection.locationsMapped %></strong><span>locations mapped</span></div>
  <div class="stat"><strong><%= connection.itemsNeedingMapping %></strong><span>need mapping</span></div>
  <div class="stat"><strong><%= connection.last_activity_at ? helpers.timeAgo(connection.last_activity_at) : 'None yet' %></strong><span>last event received</span></div>
</div><% } %>

<% if (token) { %>
  <div class="notice notice--warn section"><div><strong>Copy this secure connection key now. StockChief will not show it again.</strong><input class="input mono" value="<%= token %>" readonly onclick="this.select()"></div></div>
<% } %>

<% if (certification) { %>
  <section class="setup-journey section">
    <div class="setup-journey__head"><div class="setup-journey__head-copy">
      <span class="setup-journey__eyebrow">Connection certification</span>
      <h2><%= certification.history ? 'This connection has passed its operational proof' : 'Prove this connection before relying on it' %></h2>
      <p>Connected is not the finish line. Each proof below is based on recorded evidence from this connection in this inventory.</p>
    </div></div>
    <div class="setup-steps">
      <div class="setup-step <%= certification.connected ? 'setup-step--done' : 'setup-step--current' %>"><span class="setup-step__number"><%= certification.connected ? '✓' : '1' %></span><div><strong>Authorize the right account</strong><p><%= connection.provider_account_name || 'StockChief must verify the provider account identity.' %></p></div><span class="setup-step__state"><%= certification.connected ? 'Verified' : 'Waiting' %></span></div>
      <div class="setup-step <%= certification.catalog ? 'setup-step--done' : certification.connected ? 'setup-step--current' : '' %>"><span class="setup-step__number"><%= certification.catalog ? '✓' : '2' %></span><div><strong>Read products and locations</strong><p>StockChief reads identities first; it does not replay old sales into stock.</p></div><span class="setup-step__state"><%= certification.catalog ? 'Recorded' : 'Refresh below' %></span></div>
      <div class="setup-step <%= certification.event ? 'setup-step--done' : certification.catalog ? 'setup-step--current' : '' %>"><span class="setup-step__number"><%= certification.event ? '✓' : '3' %></span><div><strong>Prove one real workflow</strong><p><%= certification.testInstruction %></p></div><span class="setup-step__state"><%= certification.event ? 'Received once' : 'Run test' %></span></div>
      <div class="setup-step <%= certification.history ? 'setup-step--done' : certification.event ? 'setup-step--current' : '' %>"><span class="setup-step__number"><%= certification.history ? '✓' : '4' %></span><div><strong>Compare provider history</strong><p>StockChief compares what it safely processed. A mismatch stops for review; it never overwrites stock.</p></div><span class="setup-step__state"><%= certification.history ? 'Matched' : 'Compare below' %></span></div>
    </div>
  </section>
<% } %>

<% if (isMailbox) { %>
  <section class="setup-journey">
    <div class="setup-journey__head">
      <div class="setup-journey__head-copy">
        <span class="setup-journey__eyebrow"><%= provider.name %> setup</span>
        <h1><%= watchedRules.length ? 'Your supplier inbox is ready' : 'One more step: choose a supplier' %></h1>
        <p><%= watchedRules.length
          ? `StockChief is connected to ${connection.provider_account_name || 'this mailbox'} and knows which supplier emails matter.`
          : 'Connecting Gmail only gives StockChief permission to read the mailbox. Now tell it which supplier email address to watch.' %></p>
      </div>
    </div>
    <div class="setup-steps">
      <div class="setup-step setup-step--done"><span class="setup-step__number">✓</span><div><strong>Connect <%= provider.name %></strong><p><%= connection.provider_account_name || 'Mailbox connected' %></p></div><span class="setup-step__state">Done</span></div>
      <div class="setup-step <%= watchedRules.length ? 'setup-step--done' : 'setup-step--current' %>"><span class="setup-step__number"><%= watchedRules.length ? '✓' : '2' %></span><div><strong>Choose supplier emails</strong><p>Enter the address your supplier sends from. StockChief handles the association.</p></div><span class="setup-step__state"><%= watchedRules.length ? 'Done' : 'Do this now' %></span></div>
      <div class="setup-step <%= watchedRules.length ? 'setup-step--current' : '' %>"><span class="setup-step__number">3</span><div><strong>Send one test email</strong><p>StockChief checks automatically and will show the message below.</p></div><span class="setup-step__state"><%= watchedRules.length ? 'Ready to test' : 'Next' %></span></div>
    </div>
  </section>
<% } %>

<div class="grid grid--sidebar">
  <main class="grid">
    <% if (isAccounting) { var policy = accounting.policy; var fact = policy.verifiedFact || {}; var shadow = accounting.latestShadow; %>
      <section class="setup-journey">
        <div class="setup-journey__head"><div class="setup-journey__head-copy">
          <span class="setup-journey__eyebrow">Safe accounting connection</span>
          <h1><%= policy.stage === 'WRITE_ENABLED' ? 'StockChief may post verified entries' : 'Connected without changing the books' %></h1>
          <p>StockChief verified <strong><%= fact.label || 'the accounting company' %>: <%= fact.value || connection.provider_account_name %></strong>. Operational stock remains owned by StockChief. No provider can write inventory balances.</p>
        </div></div>
        <div class="setup-steps">
          <div class="setup-step setup-step--done"><span class="setup-step__number">✓</span><div><strong>Connect and authorize</strong><p>Minimum provider scopes only.</p></div><span class="setup-step__state">Done</span></div>
          <div class="setup-step setup-step--done"><span class="setup-step__number">✓</span><div><strong>Verify one real fact</strong><p><%= fact.value || 'Company identity verified' %></p></div><span class="setup-step__state">Done</span></div>
          <div class="setup-step <%= policy.requested_authority === 'OBSERVE' ? 'setup-step--current' : 'setup-step--done' %>"><span class="setup-step__number"><%= policy.requested_authority === 'OBSERVE' ? '3' : '✓' %></span><div><strong>Choose authority</strong><p>Observe, compare in shadow, or request governed posting.</p></div><span class="setup-step__state"><%= policy.requested_authority === 'OBSERVE' ? 'Do this now' : 'Done' %></span></div>
          <div class="setup-step <%= policy.requested_authority !== 'OBSERVE' && policy.stage !== 'WRITE_ENABLED' ? 'setup-step--current' : '' %>"><span class="setup-step__number">4</span><div><strong>Prove parity</strong><p>Exact account identities and balances must match before writes.</p></div><span class="setup-step__state"><%= shadow && shadow.status === 'MATCHED' ? 'Matched' : policy.requested_authority === 'OBSERVE' ? 'Optional' : 'Next' %></span></div>
        </div>
      </section>

      <section class="card"><div class="card-head"><div><h2>What may StockChief do?</h2><p class="muted">This is an explicit business authority boundary, not an AI decision.</p></div></div><div class="card-body grid">
        <form method="post" action="/settings/connections/<%= connection.id %>/accounting-authority" class="grid">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <label class="field"><span class="field-label">Accounting source of truth</span><select class="select" name="accountingSource"><option value="FOUNDRY" <%= policy.accounting_source === 'FOUNDRY' ? 'selected' : '' %>>StockChief owns accounting entries</option><option value="EXTERNAL" <%= policy.accounting_source === 'EXTERNAL' ? 'selected' : '' %>><%= provider.name %> owns accounting truth (read-only in StockChief)</option></select></label>
          <div class="choice-grid">
            <label class="choice"><input type="radio" name="authority" value="OBSERVE" <%= policy.requested_authority === 'OBSERVE' ? 'checked' : '' %>><span><strong>Observe only</strong><small>Read company identity and health. Never post.</small></span></label>
            <label class="choice"><input type="radio" name="authority" value="SHADOW" <%= policy.requested_authority === 'SHADOW' ? 'checked' : '' %>><span><strong>Shadow comparison</strong><small>Compare books without changing either system.</small></span></label>
            <label class="choice"><input type="radio" name="authority" value="POST" <%= policy.requested_authority === 'POST' ? 'checked' : '' %>><span><strong>Request posting authority</strong><small>Still blocked until an exact shadow match and final enablement.</small></span></label>
          </div>
          <div class="form-actions"><button class="btn btn--primary" type="submit">Save authority</button></div>
        </form>
      </div></section>

      <% if (policy.requested_authority !== 'OBSERVE') { %><section class="card"><div class="card-head"><div><h2>Shadow reconciliation</h2><p class="muted">StockChief reads both trial balances at the same date. It never guesses account mappings.</p></div><% if (shadow) { %><span class="badge <%= shadow.status === 'MATCHED' ? 'badge--ok' : shadow.status === 'MISMATCH' ? 'badge--warn' : 'badge--muted' %>"><%= shadow.status %></span><% } %></div><div class="card-body grid">
        <% if (accounting.sandboxProof && accounting.sandboxProof.passed) { %><div class="notice notice--success"><div><strong>QuickBooks sandbox proof passed.</strong><p>StockChief posted the $1 journal and its exact reversal, QuickBooks confirmed both, and the final reread matched with zero differences.</p><div class="grid grid--2" style="margin-top:12px"><% accounting.sandboxProof.entries.forEach(function(entry) { %><div class="list-row"><div><strong><%= entry.entry_number === 2 ? '$1 test journal' : '$1 reversal journal' %></strong><p>StockChief journal <%= entry.entry_number %> · QuickBooks ID <%= entry.external_id %></p></div><span class="badge badge--ok">Confirmed</span></div><% }) %></div><p class="hint">Net effect: $0. Retries cannot create duplicates.</p></div></div><% } %>
        <form method="post" action="/settings/connections/<%= connection.id %>/accounting-shadow" class="form-actions"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><label class="field"><span class="field-label">Compare through</span><input class="input" type="date" name="asOf" value="<%= new Date().toISOString().slice(0, 10) %>"></label><button class="btn btn--primary" type="submit">Run read-only comparison</button></form>
        <% if (shadow) {
          var externalSampleBooks = shadow.status === 'MISMATCH'
            && shadow.differences.length > 0
            && shadow.differences.every(function(row) { return row.kind === 'UNMAPPED_EXTERNAL_ACCOUNT'; })
            && (shadow.localSnapshot.accounts || []).every(function(row) { return Number(row.balanceMinor || 0) === 0; }); %>
          <% if (externalSampleBooks) { %><div class="notice notice--info"><div><strong>The connection test passed; these are different books.</strong><p><%= provider.name %> returned <%= shadow.differences.length %> non-zero accounts from its sample company, while this StockChief inventory has no accounting activity. They cannot reconcile because they are not the same business. Nothing was posted. Keep this connection read-only, or import matching opening books before requesting posting authority.</p></div></div>
          <% if (accounting.openingBooks && accounting.openingBooks.canImport) { %><section class="setup-journey" style="margin-top:14px"><div class="setup-journey__head"><div class="setup-journey__head-copy"><span class="setup-journey__eyebrow">Make these the same books</span><h2>Use <%= connection.provider_account_name || provider.name %> as StockChief’s starting books</h2><p>StockChief will reread <%= provider.name %>, create <strong><%= accounting.openingBooks.accountCount %> exactly linked accounts</strong>, and save one balanced opening journal. Debits and credits in this preview are both <strong><%= helpers.money(accounting.openingBooks.debitMinor) %></strong>. This changes StockChief only; it does not post to <%= provider.name %>.</p></div></div><form method="post" action="/settings/connections/<%= connection.id %>/accounting-import-opening" data-confirm="Import the freshly reread provider balances as this empty StockChief inventory’s starting books? This creates a posted opening journal in StockChief, but sends nothing to the provider."><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="asOf" value="<%= accounting.openingBooks.asOf %>"><button class="btn btn--primary" type="submit">Import starting books and prove the match</button></form></section><% } %>
          <% } else { %><p><strong><%= shadow.status === 'MATCHED' ? 'The books match exactly.' : shadow.differences.length + ' difference' + (shadow.differences.length === 1 ? '' : 's') + ' found. Nothing was posted.' %></strong> Compared <%= shadow.as_of %>.</p><% } %>
          <% if (shadow.differences.length) { %><details><summary>See exact differences and map uncertain accounts</summary><div class="grid" style="margin-top:12px"><% shadow.differences.forEach(function(diff) { %><div class="list-row"><div style="flex:1"><strong><%= diff.code || diff.externalName || diff.kind %></strong><p><%= diff.kind.replaceAll('_', ' ').toLowerCase() %><%= diff.foundryMinor != null ? ' · StockChief ' + helpers.money(diff.foundryMinor) : '' %><%= diff.externalMinor != null ? ' · ' + provider.name + ' ' + helpers.money(diff.externalMinor) : '' %></p><% if (diff.kind === 'UNMAPPED_EXTERNAL_ACCOUNT' && diff.externalId) { %><form method="post" action="/settings/connections/<%= connection.id %>/accounting-map" class="form-actions" style="margin-top:10px"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="externalId" value="<%= diff.externalId %>"><select class="select" name="accountId" required><option value="">Choose the exact StockChief account</option><% accountingAccounts.forEach(function(account) { %><option value="<%= account.id %>"><%= account.code %> · <%= account.name %></option><% }) %></select><button class="btn btn--sm" type="submit">Save exact mapping</button></form><% } %></div><span class="badge badge--warn">Stopped</span></div><% }) %></div></details><% } %>
        <% } %>
        <% if (shadow && policy.requested_authority === 'POST' && (shadow.externalSnapshot.accounts || []).length) {
          var accountIdentities = accounting.identities.filter(function(row) { return row.entity_type === 'account'; });
          var externalAccountsForMapping = (shadow.externalSnapshot.accounts || []).slice().sort(function(a, b) {
            return String(a.code || a.name || '').localeCompare(String(b.code || b.name || ''));
          }); %>
          <details class="disclose"><summary>Posting account mappings · <%= accountIdentities.length %> saved</summary><div class="disclose__body grid">
            <p>Map only the StockChief accounts used by entries you intend to post. A zero-balance account omitted by the provider is not a financial discrepancy, but StockChief still requires an exact provider identity before writing to it.</p>
            <form method="post" action="/settings/connections/<%= connection.id %>/accounting-map" class="grid grid--2">
              <input type="hidden" name="_csrf" value="<%= csrfToken %>">
              <label class="field"><span class="field-label">StockChief account</span><select class="select" name="accountId" required><option value="">Choose the account used by the journal</option><% accountingAccounts.forEach(function(account) { %><option value="<%= account.id %>"><%= account.code %> · <%= account.name %></option><% }) %></select></label>
              <label class="field"><span class="field-label"><%= provider.name %> account</span><select class="select" name="externalId" required><option value="">Choose its exact provider account</option><% externalAccountsForMapping.forEach(function(account) { %><option value="<%= account.externalId %>"><%= account.code ? account.code + ' · ' : '' %><%= account.name %></option><% }) %></select></label>
              <div class="form-actions"><button class="btn btn--primary" type="submit">Save exact posting mapping</button></div>
            </form>
            <% if (accountIdentities.length) { %><div class="grid"><% accountIdentities.forEach(function(identity) {
              var localAccount = accountingAccounts.find(function(account) { return account.id === identity.foundry_record_id; });
              var externalAccount = externalAccountsForMapping.find(function(account) { return String(account.externalId) === String(identity.external_id); }); %>
              <div class="list-row"><span><%= localAccount ? localAccount.code + ' · ' + localAccount.name : identity.foundry_record_id %></span><strong><%= externalAccount ? externalAccount.name : identity.external_id %></strong></div>
            <% }) %></div><% } %>
          </div></details>
        <% } %>
        <% if (policy.stage === 'WRITE_READY') { %><form method="post" action="/settings/connections/<%= connection.id %>/accounting-enable" data-confirm="Enable StockChief to post verified accounting entries to <%= provider.name %>? StockChief remains the source of truth."><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="btn btn--primary" type="submit">Enable verified posting</button></form><% } %>
        <% if (policy.stage === 'WRITE_ENABLED' && provider.environment === 'sandbox' && !(accounting.sandboxProof && accounting.sandboxProof.passed)) { %><div class="notice notice--info"><div><strong>Ready for the real sandbox proof.</strong><p>StockChief will post a $1 expense journal, post its exact reversal, and reread both trial balances. The net balance change is $0, and both provider journal IDs are saved as evidence.</p><form method="post" action="/settings/connections/<%= connection.id %>/accounting-sandbox-proof" data-confirm="Post a $1 journal and its exact reversal to this provider sandbox? This creates two real sandbox journal entries with a net $0 balance effect."><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="btn btn--primary" type="submit">Post and reverse $1 sandbox proof</button></form></div></div><% } %>
        <% if (policy.stage === 'WRITE_ENABLED') { %><form method="post" action="/settings/connections/<%= connection.id %>/accounting-post"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="btn btn--primary" type="submit">Post new verified entries now</button></form><p class="hint">Each journal has a provider idempotency key and exact external account identities. Retries cannot create duplicate books.</p><% } %>
      </div></section><% } %>
    <% } else { %>
    <% if (canBootstrapShopify) { %>
      <section class="card"><div class="card-head"><div><h2>Use this Shopify store as a new StockChief inventory</h2><p class="muted">For an empty inventory only. StockChief imports active tracked products, variants, selling prices, locations, and current on-hand quantities once. It does not replay old sales.</p></div></div><div class="card-body"><form method="post" action="/settings/connections/<%= connection.id %>/bootstrap-shopify" data-confirm="Import this Shopify store's current catalogue and opening stock into this empty StockChief inventory?"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="btn btn--primary" type="submit">Import Shopify store into StockChief</button></form></div></section>
    <% } else if (connection.provider_type === 'shopify' && connection.config.catalogBootstrap) { %>
      <section class="notice notice--success"><strong>Shopify store setup is complete.</strong> <%= connection.config.catalogBootstrap.items %> products, <%= connection.config.catalogBootstrap.skus %> variants, <%= connection.config.catalogBootstrap.locations %> locations, and <%= connection.config.catalogBootstrap.openingUnits %> opening units were imported once. Future Shopify activity arrives automatically.</section>
    <% } %>
    <% var unmapped = externalRecords.filter(function(row) { return row.mapping_status === 'UNMAPPED' && row.selected; }); %>
    <% var unmappedProducts = unmapped.filter(function(row) { return row.entity_type === 'sku'; }); %>
    <% if (unmapped.length) { %>
      <section class="card" data-selection-group><div class="card-head"><div><h2>Review <%= unmapped.length %> uncertain record<%= unmapped.length === 1 ? '' : 's' %></h2><p class="muted">StockChief already matched exact SKUs, barcodes, product/variant names, and locations automatically. These are the only records where choosing for you could merge the wrong products.</p></div></div><div class="card-body grid">
        <% if (unmappedProducts.length > 1) { %><form id="bulk-product-import" method="post" action="/settings/connections/<%= connection.id %>/create-products-map" class="form-actions"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="btn btn--sm" type="button" data-select-all>Select all products</button><button class="btn btn--sm" type="button" data-clear-selection>Clear</button><span class="muted" data-selection-count>0 selected</span><button class="btn btn--primary btn--sm" type="submit" data-remove-selected disabled>Add selected to StockChief</button></form><% } %>
        <% unmapped.forEach(function(record) { var choices = record.entity_type === 'sku' ? skus : locations; %><div class="list-row" id="mapping-<%= record.entity_type %>-<%= record.external_id %>" style="align-items:flex-start; scroll-margin-top:24px"><% if (record.entity_type === 'sku' && unmappedProducts.length > 1) { %><input type="checkbox" name="externalIds" value="<%= record.external_id %>" form="bulk-product-import" data-selection-item aria-label="Select <%= record.display_name %>"><% } %><div style="flex:1"><strong><%= record.display_name %></strong><p class="muted"><%= record.entity_type === 'sku' ? 'External SKU ' + (record.code || record.external_id) : 'External location' %></p>
          <% if (choices.length) { %><form method="post" action="/settings/connections/<%= connection.id %>/map" class="form-actions" style="margin-top:10px"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="entityType" value="<%= record.entity_type %>"><input type="hidden" name="externalId" value="<%= record.external_id %>"><select class="select" name="foundryRecordId" required><option value="">Choose the matching StockChief record</option><% if (record.entity_type === 'sku') { skus.forEach(function(sku) { %><option value="<%= sku.id %>"><%= sku.item_name %><%= sku.variant_label ? ' / ' + sku.variant_label : '' %> · <%= sku.code %></option><% }) } else { locations.forEach(function(location) { %><option value="<%= location.id %>"><%= location.name %></option><% }) } %></select><button class="btn btn--primary btn--sm" type="submit">Save match</button></form><% } %>
          <% if (record.entity_type === 'sku') { %><div class="notice" style="margin-top:10px"><div><strong><%= choices.length ? 'Not already in StockChief?' : 'This product is new to StockChief.' %></strong><p>StockChief already has the name, SKU, price, and tracked stock supplied by <%= provider.name %>. Create and match it without typing everything again.</p><form method="post" action="/settings/connections/<%= connection.id %>/create-product-map" style="margin-top:10px"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="externalId" value="<%= record.external_id %>"><button class="btn btn--primary btn--sm" type="submit">Create product in StockChief and finish</button></form></div></div>
          <% } else if (!choices.length) { %><div class="notice" style="margin-top:10px"><div><strong>StockChief does not have a location yet.</strong><p>Create this <%= provider.name %> location here and StockChief will match it automatically.</p><form method="post" action="/settings/connections/<%= connection.id %>/create-location-map" class="form-actions" style="margin-top:10px"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="externalId" value="<%= record.external_id %>"><label class="field"><span class="label">StockChief location name</span><input class="input" name="name" value="<%= record.display_name %>" required></label><label class="field"><span class="label">Location type</span><select class="select" name="kind" required><% helpers.LOCATION_KINDS.forEach(function(kind) { %><option value="<%= kind.id %>" <%= kind.id === 'store' ? 'selected' : '' %>><%= kind.label %></option><% }) %></select></label><button class="btn btn--primary btn--sm" type="submit">Create location and finish</button></form></div></div><% } %>
          <form method="post" action="/settings/connections/<%= connection.id %>/ignore" style="margin-top:8px"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="entityType" value="<%= record.entity_type %>"><input type="hidden" name="externalId" value="<%= record.external_id %>"><button class="btn btn--sm" type="submit">Ignore this external record</button></form>
        </div><span class="badge badge--warn">Needs your match</span></div><% }) %>
      </div></section>
    <% } %>

    <% var providerLocations = externalRecords.filter(function(row) { return row.entity_type === 'location'; }); %>
    <% if (providerLocations.length) { %><section class="card"><div class="card-head"><div><h2>Provider locations</h2><p class="muted">Choose where StockChief should accept activity from this connection.</p></div></div><div class="card-body"><form method="post" action="/settings/connections/<%= connection.id %>/locations" class="grid"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><div class="choice-grid"><% providerLocations.forEach(function(location) { %><label class="choice"><input type="checkbox" name="externalLocationIds" value="<%= location.external_id %>" <%= location.selected ? 'checked' : '' %>><span><strong><%= location.display_name %></strong><small><%= location.mapping_status === 'MAPPED' ? 'Mapped' : 'Still needs a StockChief match' %></small></span></label><% }) %></div><div class="form-actions"><button class="btn" type="submit">Save locations</button></div></form></div></section><% } %>


    <% var visibleIssues = issues.filter(function(issue) { return issue.status === 'OPEN' && !unmapped.some(function(record) { return issue.issue_type === 'UNKNOWN_' + record.entity_type.toUpperCase() && issue.fingerprint.endsWith(':' + record.external_id); }); }); %>
    <% if (visibleIssues.length) { %>
      <section class="card">
        <div class="card-head"><div><h2>Needs attention</h2><p class="muted">One clear problem, one safe resolution.</p></div></div>
        <div class="card-body grid">
          <% visibleIssues.forEach(function(issue) { %>
            <div class="list-row" id="issue-<%= issue.id %>" style="align-items:flex-start; scroll-margin-top:24px"><div><strong><%= issue.title %></strong><p><%= issue.detail %></p><p class="muted"><%= issue.resolution_hint %></p>
              <% if (connection.provider_type === 'reference_webhook' && /^UNKNOWN_(SKU|LOCATION|CUSTOMER|SALES_ORDER|SUPPLIER)$/.test(issue.issue_type)) { var entity = issue.issue_type.slice(8).toLowerCase(); var externalId = issue.fingerprint.split(':').slice(-1)[0]; %>
                <form method="post" action="/settings/connections/<%= connection.id %>/map" class="form-actions" style="margin-top:10px">
                  <input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="entityType" value="<%= entity %>"><input type="hidden" name="externalId" value="<%= externalId %>">
                  <select class="select" name="foundryRecordId" required>
                    <option value="">Choose the matching StockChief record</option>
                    <% if (entity === 'sku') { skus.forEach(function(sku) { %><option value="<%= sku.id %>"><%= sku.item_name %><%= sku.variant_label ? ' / ' + sku.variant_label : '' %> · <%= sku.code %></option><% }) } %>
                    <% if (entity === 'location') { locations.forEach(function(location) { %><option value="<%= location.id %>"><%= location.name %></option><% }) } %>
                    <% if (entity === 'customer') { customers.forEach(function(customer) { %><option value="<%= customer.id %>"><%= customer.name %></option><% }) } %>
                    <% if (entity === 'supplier') { suppliers.forEach(function(supplier) { %><option value="<%= supplier.id %>"><%= supplier.name %></option><% }) } %>
                  </select><button class="btn btn--primary btn--sm" type="submit">Save mapping and retry</button>
                </form>
              <% } %>
              <% var supplierSkuCandidates = issue.issue_type === 'SUPPLIER_DOCUMENT_REVIEW' ? issue.candidates.filter(function(candidate) { return candidate.kind === 'supplier_sku' && candidate.supplierSku && candidate.supplierId; }) : []; %>
              <% supplierSkuCandidates.forEach(function(candidate) { %>
                <form method="post" action="/settings/connections/<%= connection.id %>/supplier-sku-map" class="form-actions" style="margin-top:10px">
                  <input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="issueId" value="<%= issue.id %>"><input type="hidden" name="supplierSku" value="<%= candidate.supplierSku %>">
                  <label class="field"><span class="field-label">What is <%= candidate.supplierSku %> in StockChief?</span><select class="select" name="skuId" required><option value="">Choose the matching product</option><% skus.forEach(function(sku) { %><option value="<%= sku.id %>"><%= sku.item_name %><%= sku.variant_label ? ' / ' + sku.variant_label : '' %> · <%= sku.code %></option><% }) %></select></label>
                  <button class="btn btn--primary btn--sm" type="submit">Save match for future emails</button>
                </form>
              <% }) %>
              <% var documentDecision = issue.issue_type === 'SUPPLIER_DOCUMENT_REVIEW' ? issue.candidates.find(function(candidate) { return candidate.kind === 'supplier_document_review'; }) : null; %>
              <% if (documentDecision && !documentDecision.discrepancies.some(function(discrepancy) { return discrepancy.type === 'unknown_sku'; })) { %>
                <form method="post" action="/settings/connections/<%= connection.id %>/supplier-document-decision" class="form-actions" style="margin-top:10px">
                  <input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="issueId" value="<%= issue.id %>">
                  <button class="btn btn--primary btn--sm" type="submit" name="decision" value="accept">Accept supplier changes</button>
                  <button class="btn btn--sm" type="submit" name="decision" value="keep_original">Keep original purchase order</button>
                </form>
              <% } %>
            </div><span class="badge badge--warn"><%= issue.issue_type.replaceAll('_', ' ').toLowerCase() %></span></div>
          <% }) %>
        </div>
      </section>
    <% } %>

    <% if (isMailbox) { %>
      <section class="card"><div class="card-head"><div><h2><%= watchedRules.length ? 'Suppliers StockChief watches' : 'Which supplier should StockChief watch?' %></h2><p class="muted">Use the address the supplier sends email from—not the Gmail inbox you just connected.</p></div></div><div class="card-body grid">
        <% watchedRules.forEach(function(rule) { var modeLabel = rule.document_mode === 'inventory_list' ? 'Inventory files → prepare review' : rule.document_mode === 'supplier_documents' ? 'Purchasing documents → process' : 'Ask what each file is'; %><div class="list-row"><div><strong><%= rule.supplier_name %></strong><p>Emails from <%= rule.sender_pattern %> · <%= modeLabel %></p></div><span class="badge badge--ok">Watching</span></div><% }) %>
        <% if (currentUser.role === 'owner') { %>
          <form method="post" action="/settings/connections/<%= connection.id %>/email-rules" class="grid grid--2">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <label class="field"><span class="field-label">Which email address should StockChief use?</span><input class="input" name="senderPattern" value="<%= pendingEmailRule ? pendingEmailRule.sender_pattern : '' %>" placeholder="orders@abcapparel.com" required><span class="field-help">Everything from other senders remains ignored.</span></label>
            <label class="field"><span class="field-label">What should StockChief call this source? <span class="muted">optional</span></span><input class="input" name="supplierName" list="supplier-name-options" placeholder="ABC Apparel"><span class="field-help">Type any useful name. There is no separate supplier setup required.</span></label>
            <label class="field"><span class="field-label">What do its attached files contain?</span><select class="select" name="documentMode"><option value="review_each">I will choose for each file</option><option value="inventory_list">Products or inventory quantities</option><option value="supplier_documents">Purchase orders, invoices or shipment updates</option></select><span class="field-help">PDF, Excel, CSV, Word, and text work the same way. StockChief prepares a review; it does not silently change stock.</span></label>
            <datalist id="supplier-name-options"><% suppliers.forEach(function(s) { %><option value="<%= s.name %>"><% }) %></datalist>
            <div class="form-actions"><button class="btn btn--primary" type="submit"><%= watchedRules.length ? 'Watch another sender' : 'Start watching this sender' %></button></div>
          </form>
        <% } %>
      </div></section>
      <section class="card"><div class="card-head"><div><h2>Emails StockChief found</h2><p class="muted">Each file shows its real outcome: waiting, imported, or safely ignored as a duplicate.</p></div></div><div class="card-body grid"><% if (!messages.length) { %><p class="muted"><%= watchedRules.length ? 'No approved-sender email has arrived yet. StockChief will check automatically.' : 'Choose a sender above first.' %></p><% } messages.forEach(function(message) { var attachmentsForMessage = messageAttachments.filter(function(a) { return a.message_id === message.id; }); var hasPendingInventory = attachmentsForMessage.some(function(a) { return a.document_status === 'PREPARED'; }); var hasAppliedInventory = attachmentsForMessage.some(function(a) { return a.document_status === 'APPLIED'; }); var isDuplicateInventory = message.processing_status === 'DUPLICATE_IGNORED'; var messageBadge = message.trust_status !== 'TRUSTED' ? 'Ignored—not approved' : isDuplicateInventory ? 'Duplicate ignored' : hasPendingInventory ? 'Inventory review ready' : hasAppliedInventory ? 'Imported' : 'Approved sender'; %><div class="list-row" style="align-items:flex-start"><div style="flex:1"><strong><%= message.subject || '(no subject)' %></strong><p><%= message.sender %><%= message.attachment_count ? ' · ' + message.attachment_count + ' attachment' + (message.attachment_count === 1 ? '' : 's') : '' %></p>
        <% attachmentsForMessage.forEach(function(attachment) { %><div class="notice" style="margin-top:10px"><div><strong><%= attachment.filename %></strong>
          <% if (attachment.document_status === 'PREPARED' && attachment.understanding_id) { %><p>Ready for review. Nothing has been imported yet.</p><a class="btn btn--primary btn--sm" href="/foundry/proposal/<%= attachment.understanding_id %>">Review inventory</a>
          <% } else if (attachment.document_status === 'APPLIED') { %><% if (isDuplicateInventory) { %><p><strong>Duplicate file.</strong> These exact contents were already imported<%= attachment.document_applied_at ? ' ' + helpers.timeAgo(attachment.document_applied_at) : '' %>. Nothing was added again.</p><% } else { %><p><strong>Imported<%= attachment.document_applied_at ? ' ' + helpers.timeAgo(attachment.document_applied_at) : '' %>.</strong> This file is already part of the inventory. There is nothing left to review.</p><a class="btn btn--sm" href="/inventory">See inventory</a><% } %>
          <% } else if (message.trust_status === 'TRUSTED') { %><form method="post" action="/settings/connections/<%= connection.id %>/email-attachments/<%= attachment.id %>/inventory-preview" class="grid" style="margin-top:8px"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><label class="choice"><input type="checkbox" name="rememberFuture" value="1"><span><strong>Future files from this sender are inventory lists</strong><small>Prepare a review automatically; never import without approval.</small></span></label><button class="btn btn--primary btn--sm" type="submit">Review this file as inventory</button></form><% } %>
        </div></div><% }) %>
      </div><span class="badge <%= message.trust_status !== 'TRUSTED' || isDuplicateInventory ? 'badge--muted' : 'badge--ok' %>"><%= messageBadge %></span></div><% }) %></div></section>
    <% } %>

    <% if (!isMailbox) { %><section class="card"><div class="card-head"><div><h2>Recent activity received</h2><p class="muted">Understandable status here; exact payloads remain available in diagnostics.</p></div></div><div class="card-body grid">
      <% if (!events.length) { %><p class="muted">Waiting for first activity.</p><% } events.forEach(function(event) { %><div class="list-row"><div><strong><%= event.event_type %></strong><p>External event <%= event.external_event_id %> · received <%= helpers.timeAgo(event.received_at) %><%= event.action_type ? ' · StockChief action ' + event.action_type : '' %></p><% if (event.error_message) { %><p class="is-warn"><%= event.error_message %></p><% } %></div><span class="badge <%= event.status === 'COMPLETED' ? 'badge--ok' : event.status === 'NEEDS_MAPPING' ? 'badge--warn' : 'badge--muted' %>"><%= event.status.replaceAll('_', ' ') %></span></div><% }) %>
    </div></section><% } %>

    <% if (reconciliations.length) { %><section class="card"><div class="card-head"><h2>Reconciliation</h2></div><div class="card-body grid"><% reconciliations.forEach(function(row) { %><div class="list-row"><div><strong><%= row.status === 'MATCHED' ? 'External history matches' : 'Mismatch found' %></strong><p><%= row.period_start || 'All recorded time' %><%= row.period_end ? ' to ' + row.period_end : '' %></p></div><span class="badge <%= row.status === 'MATCHED' ? 'badge--ok' : 'badge--warn' %>"><%= row.status %></span></div><% }) %></div></section><% } %>
    <% } %>
  </main>

  <aside class="grid">
    <% if (isAccounting) { %>
      <section class="card"><div class="card-head"><h2>Safety contract</h2></div><div class="card-body grid"><p><strong>Inventory:</strong> StockChief only</p><p><strong>Accounting truth:</strong> <%= accounting.policy.accounting_source === 'FOUNDRY' ? 'StockChief' : provider.name %></p><p><strong>Direction:</strong> <%= accounting.policy.posting_direction.replaceAll('_', ' ').toLowerCase() %></p><p><strong>Authority:</strong> <%= accounting.policy.stage.replaceAll('_', ' ').toLowerCase() %></p><p class="hint">Provider data can propose or verify canonical commands. It can never write stock or account balances directly.</p>
        <% if (currentUser.role === 'owner') { %><div class="form-actions">
          <% if (connection.status === 'disconnected') { %><form method="post" action="/settings/connections/connect"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="providerType" value="<%= connection.provider_type %>"><input type="hidden" name="connectorId" value="<%= connection.id %>"><button class="btn btn--primary" type="submit">Reconnect <%= provider.name %></button></form><% } %>
          <% if (connection.provider_type === 'xero' && accounting.policy.requested_authority === 'POST' && !connection.capabilities.includes('accounting:post')) { %><form method="post" action="/settings/connections/connect"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="providerType" value="xero"><input type="hidden" name="connectorId" value="<%= connection.id %>"><input type="hidden" name="requestedAuthority" value="POST"><button class="btn btn--primary" type="submit">Grant Xero posting scope</button></form><% } %>
          <% if (connection.status !== 'disconnected') { %><form method="post" action="/settings/connections/<%= connection.id %>/disconnect" data-confirm="Disconnect this accounting system? StockChief keeps all identity maps and audit history."><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="btn btn--danger" type="submit">Disconnect</button></form><% } %>
        </div><% } %>
      </div></section>
    <% } else { %>
    <% if (connection.provider_type === 'reference_webhook' || connection.provider_type === 'supplier_email') { %><section class="card"><div class="card-head"><h2><%= connection.provider_type === 'reference_webhook' ? 'Custom business system API' : 'Send events' %></h2></div><div class="card-body grid"><label class="field"><span class="label">Event endpoint</span><input class="input mono" value="<%= origin %>/api/v1/events" readonly onclick="this.select()"></label><p class="hint">Use <code>Authorization: Bearer YOUR_TOKEN</code>. Replaying one external event ID never repeats its StockChief action.</p><% if (connection.provider_type === 'reference_webhook') { %><label class="field"><span class="label">Machine-readable contract</span><input class="input mono" value="<%= origin %>/api/v1/events/schema" readonly onclick="this.select()"></label><p class="hint">Supported events: sale, customer order, order snapshot/change/cancellation, fulfillment, return, receipt, transfer, adjustment, product update, and location update. Send <code>aggregateId</code> plus <code>version</code> for ordering protection.</p><details><summary>Example sale event</summary><pre class="mono" style="white-space:pre-wrap">{
  "eventId": "sale-10482-line-1",
  "type": "sale.completed",
  "version": "1",
  "aggregateId": "order-10482",
  "occurredAt": "2026-08-28T14:30:00Z",
  "data": {
    "externalSku": "sku-123",
    "skuCode": "ABC-123",
    "externalLocationId": "store-1",
    "locationName": "Main Store",
    "quantity": 1
  }
}</pre></details><% } %><% if (connection.provider_type === 'supplier_email') { %><label class="field"><span class="label">Email endpoint</span><input class="input mono" value="<%= origin %>/api/v1/email/messages" readonly onclick="this.select()"></label><% } %></div></section><% } else if (isMailbox) { %>
      <section class="card"><div class="card-head"><h2><%= watchedRules.length ? 'Test it now' : 'What happens next?' %></h2></div><div class="card-body grid">
        <% if (watchedRules.length) { var testRule = watchedRules[0]; %>
          <p>Send an email from <strong><%= testRule.sender_pattern %></strong> to <strong><%= connection.provider_account_name %></strong>.</p>
          <p class="hint">Use a subject such as <strong>Order acknowledgement PO-1234</strong>. StockChief will match real PO numbers when they exist.</p>
        <% } else { %>
          <p>Enter one supplier name and sender email on the left. Then StockChief will show the exact test to run.</p>
        <% } %>
        <p class="hint">StockChief checks automatically every <%= connection.config.mailboxCheckMinutes || 5 %> minutes. Last checked <%= connection.last_synced_at ? helpers.timeAgo(connection.last_synced_at) : 'not yet' %>.</p>
        <% if (currentUser.role === 'owner' && ['gmail','microsoft365'].includes(connection.provider_type)) { %><form method="post" action="/settings/connections/<%= connection.id %>/mailbox-cadence" class="form-actions"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><label class="field"><span class="field-label">Check for new mail</span><select class="select" name="minutes"><% [1,5,10,15,30].forEach(function(n) { %><option value="<%= n %>" <%= Number(connection.config.mailboxCheckMinutes || 5) === n ? 'selected' : '' %>>Every <%= n %> minute<%= n === 1 ? '' : 's' %></option><% }) %></select></label><button class="btn btn--sm" type="submit">Save timing</button></form><% } %>
      </div></section>
    <% } else { %>
      <section class="card"><div class="card-head"><h2>Automatic provider sync</h2></div><div class="card-body grid"><p>Events arrive automatically from <%= provider.name %>. You do not need an API command or Check now.</p><p class="hint">Initial setup imports product and location identities only. It does not replay historical sales into current stock.</p><% if (currentUser.role === 'owner' && connection.status === 'connected') { %><div class="form-actions"><form method="post" action="/settings/connections/<%= connection.id %>/sync"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="btn" type="submit">Refresh products and locations</button></form><form method="post" action="/settings/connections/<%= connection.id %>/reconcile"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="btn" type="submit">Compare recent provider history</button></form></div><p class="hint">History comparison is read-only. A mismatch creates a clear issue; it never rewrites stock.</p><% } %></div></section>
    <% } %>
    <% if (!isMailbox) { %>
      <section class="card"><div class="card-head"><h2>Before-checkout stock warning</h2></div><div class="card-body grid">
        <label class="field"><span class="label">Decision endpoint</span><input class="input mono" value="<%= origin %>/api/v1/precheckout" readonly onclick="this.select()"></label>
        <% if (connection.provider_type === 'woocommerce') { %>
          <p>Supported with the StockChief WooCommerce plugin. It checks the live StockChief balance, commitments, reorder point, and stock-protection rules before checkout.</p>
        <% } else if (connection.provider_type === 'reference_webhook') { %>
          <p>Supported now. Your POS, ERP, or checkout can call this endpoint before taking payment and display the returned <code>ALLOW</code>, <code>WARN</code>, or <code>BLOCK</code> decision.</p>
        <% } else if (connection.provider_type === 'shopify') { %>
          <p>The StockChief decision API is ready. Showing it inside Shopify checkout requires deploying a Shopify checkout-validation extension and Shopify approval for its required capability.</p>
        <% } else if (connection.provider_type === 'square') { %>
          <p>Square's standard POS cannot accept an injected StockChief warning. This endpoint is ready for a custom Square checkout or Terminal app; completed Square sales still reach StockChief automatically.</p>
        <% } else if (connection.provider_type === 'clover') { %>
          <p>Clover's standard New Sale screen cannot accept a warning from this web connector. This endpoint is ready for a Clover Android companion/custom checkout app; completed Clover sales still reach StockChief automatically.</p>
        <% } %>
        <p class="hint">This is read-only. It never changes stock. Only an existing owner-set stock-protection rule returns <strong>BLOCK</strong>; low stock and reorder-point crossings return <strong>WARN</strong>.</p>
        <% if (currentUser.role === 'owner' && connection.status === 'connected') { %>
          <form method="post" action="/settings/connections/<%= connection.id %>/checkout-token"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="btn" type="submit">Create checkout integration key</button></form>
        <% } %>
      </div></section>
    <% } %>
    <<%= isMailbox ? 'details' : 'section' %> class="card"><%- isMailbox ? '<summary class="card-head"><h2>Connection settings</h2></summary>' : '<div class="card-head"><h2>Connection control</h2></div>' %><div class="card-body form-actions"><% if (currentUser.role === 'owner') { %>
      <% if (connection.status === 'disconnected' && connection.provider_type === 'reference_webhook') { %><form method="post" action="/settings/connections/<%= connection.id %>/rotate"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="btn btn--primary" type="submit">Reconnect with new token</button></form><% } else if (connection.status === 'disconnected' && ['shopify','square','clover','woocommerce','gmail','microsoft365'].includes(connection.provider_type)) { %><form method="post" action="/settings/connections/connect"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="providerType" value="<%= connection.provider_type %>"><input type="hidden" name="connectorId" value="<%= connection.id %>"><% if (connection.provider_type === 'shopify') { %><input type="hidden" name="shop" value="<%= connection.config.shop || '' %>"><% } %><% if (connection.provider_type === 'woocommerce') { %><input type="hidden" name="storeUrl" value="<%= connection.config.storeUrl || '' %>"><% } %><button class="btn btn--primary" type="submit">Reconnect <%= provider.name %></button></form><% } else if (connection.paused_at) { %><form method="post" action="/settings/connections/<%= connection.id %>/resume"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="btn btn--primary" type="submit">Resume trusting events</button></form><% } else if (connection.status !== 'disconnected') { %><form method="post" action="/settings/connections/<%= connection.id %>/pause"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="btn" type="submit">Pause ingestion</button></form><% } %>
      <% if (connection.status !== 'disconnected') { %><% if (connection.provider_type === 'reference_webhook') { %><form method="post" action="/settings/connections/<%= connection.id %>/rotate"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="btn" type="submit">Rotate token</button></form><% } %><form method="post" action="/settings/connections/<%= connection.id %>/disconnect" data-confirm="Disconnect this source? Mappings and audit history will be kept."><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="btn btn--danger" type="submit">Disconnect</button></form><% } %>
    <% } %></div></<%= isMailbox ? 'details' : 'section' %>>
    <% } %>
    <details class="card"><summary class="card-head"><h2>Advanced diagnostics</h2></summary><div class="card-body"><p class="mono">Connection <%= connection.id %></p><p>Provider: <%= connection.provider_type %></p><% if (connection.provider_type === 'clover') { %><p>Webhook URL: <span class="mono"><%= origin %>/api/v1/connections/clover/webhooks</span></p><% } %><p>Setup: <%= connection.setup_status %></p><p>Mappings: <%= mappings.length %></p><p>Last event: <%= connection.last_activity_at || 'none' %></p><p>Last successful sync: <%= connection.last_synced_at || 'none' %></p><p>Last sync problem: <%= connection.last_error || 'none' %></p><% syncRuns.forEach(function(run) { %><p><%= run.sync_kind %> · <%= run.status %> · <%= run.started_at %><%= run.error_message ? ' · ' + run.error_message : '' %></p><% }) %><% if (currentUser.role === 'owner' && mappings.some(function(row) { return row.entity_type === 'sku'; })) { %><p><a href="/repairs/report?connectorId=<%= connection.id %>">Report an incorrect product match</a></p><% } %></div></details>
  </aside>
</div>
