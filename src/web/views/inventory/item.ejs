<%
  /*
   * One product, read top to bottom.
   *
   * The page used to answer the same question three times. "What is going on
   * with size 38?" meant reading the Variants table for its stock, the Pricing
   * table for its price, and the Reorder settings table for its buying rule —
   * three tables, three headers, the same row key in each, stacked one under
   * the other at identical weight. A product with one variant got three tables
   * of one row each.
   *
   * There is one row per variant now, carrying everything that is true of that
   * variant, because that is the shape of the fact. What is genuinely narrow —
   * the record's own details, where the stock sits, archiving — stays in the
   * rail. What is a story rather than a figure — what Foundry expects next,
   * what has happened — stays underneath in the order somebody reads it.
   */
  var mode = item.tracking_mode;
  var modeInfo = helpers.TRACKING_MODES[mode];
  var canAct = locations.length > 0 && item.is_active;
  var itemData = {
    trackingMode: mode,
    skus: skus.map(function (s) {
      return { id: s.id, code: s.code, label: s.variant_label,
        // Missing rows mean zero. Shipping 125 zero-valued locations for every
        // visible variant made the page far larger without adding information.
        perLocation: s.perLocation.filter(function (p) {
          return Number(p.onHand || 0) !== 0 || Number(p.committed || 0) !== 0;
        }) };
    }),
    lots: (lots || []).map(function (l) {
      return {
        id: l.id, code: l.code, skuId: l.sku_id, total: l.total, expiresAt: l.expires_at,
        perLocation: (l.perLocation || []).map(function (p) {
          return { locationId: p.location_id, quantity: p.quantity };
        })
      };
    })
  };

  // The buying rule for a variant lives in a different list from its stock.
  // Joined here, once, so the row can state both without the reader doing it.
  var policyBySku = {};
  (purchasingLines || []).forEach(function (line) { policyBySku[line.skuId] = line; });

  var findings = typeof attention !== 'undefined' ? attention : [];
%>

<div class="rm-head">
  <a class="rm-head__back" href="/inventory"><span aria-hidden="true">←</span> Inventory</a>
  <div class="rm-title">
    <div>
      <h1>
        <%= item.name %>
        <% if (!item.is_active) { %><span class="rm-pillbadge">Archived</span><% } %>
      </h1>
      <p>
        <span class="mono"><%= item.base_code || skus[0].code %></span>
        · <%= modeInfo.label %><% if (item.has_variants) { %> · <%= variantTotal %> variants<% } %>
        <% if (item.description) { %> · <%= item.description %><% } %>
      </p>
    </div>
    <div class="rm-title__do">
      <a class="rm-btn rm-btn--ghost rm-btn--sm" href="<%= skus.length === 1 ? '/purchasing/why/' + skus[0].id : '#reorder-settings' %>"><%- helpers.icon('purchasing', { size: 15 }) %> Reorder settings</a>
      <button class="rm-btn rm-btn--ghost rm-btn--sm" type="button" data-modal-open="modal-edit"><%- helpers.icon('settings', { size: 15 }) %> Edit details</button>
    </div>
  </div>
</div>

<% if (!canAct) { %>
  <div class="rm-note rm-note--warn">
    <%- helpers.icon('alert', { size: 16 }) %>
    <div>
      <% if (locations.length === 0) { %>
        Add a location before you can move stock. <a href="/locations">Go to locations</a>.
      <% } else { %>
        This item is archived. Restore it to record movements.
      <% } %>
    </div>
  </div>
<% } %>

<%# What Foundry has noticed about this record, stated where the person is
    already looking rather than only on a page they have to remember to open. %>
<% findings.forEach(function (finding) { %>
  <a class="rm-decision" href="<%= finding.actionHref || '/attention/' + finding.attentionId %>">
    <span class="rm-decision__txt">
      <strong><%= finding.categoryLabel %> · <%= finding.title %></strong>
      <span><%= finding.conciseSummary %></span>
    </span>
    <span class="rm-decision__go"><%= finding.actionLabel || 'Why this?' %>
      <span class="rm-decision__arrow"><%- helpers.icon('arrowRight', { size: 14 }) %></span></span>
  </a>
<% }) %>
<% if (findingTotal > findings.length) { %>
  <a class="rm-decision" href="/needs-you">
    <span class="rm-decision__txt">
      <strong><%= helpers.qty(findingTotal - findings.length) %> more decisions are grouped in Needs you</strong>
      <span>This page shows only the highest-priority issues so the product stays fast and readable.</span>
    </span>
    <span class="rm-decision__go">See all <span class="rm-decision__arrow"><%- helpers.icon('arrowRight', { size: 14 }) %></span></span>
  </a>
<% } %>

<%# The four numbers that belong together, read as one line. The unit word stays
    in the label: a product measured in kilograms reads "kg on hand", and
    shortening it would drop the one word saying what the number counts. %>
<div class="rm-pulse">
  <div class="rm-stat">
    <span class="rm-stat__n"><%= helpers.qty(total) %></span>
    <span class="rm-stat__d"><%= helpers.plural(total, item.unit_label) %> on hand</span>
  </div>
  <div class="rm-stat<%= committed ? ' rm-stat--brand' : '' %>">
    <span class="rm-stat__n"><%= helpers.qty(committed || 0) %></span>
    <%# "committed to customer orders", not "committed" — on a page that also
        shows what is on order from suppliers, the short version is ambiguous
        about which kind of order did the committing. %>
    <span class="rm-stat__d">committed to customer orders</span>
  </div>
  <div class="rm-stat<%= available ? '' : ' rm-stat--flag' %>">
    <span class="rm-stat__n"><%= helpers.qty(available) %></span>
    <span class="rm-stat__d"><%= helpers.plural(available, item.unit_label) %> available</span>
  </div>
  <div class="rm-stat">
    <span class="rm-stat__n"><%= helpers.qty(onOrder || 0) %></span>
    <span class="rm-stat__d">on order from suppliers</span>
  </div>
</div>

<section class="rm-panel" id="kit-definition" style="margin-bottom:18px">
  <div class="rm-panel__head">
    <%- helpers.icon('layers', { size: 15, className: 'rm-quiet' }) %>
    <h2>Kit / bill of materials</h2>
    <span class="right">The customer buys this SKU; Foundry moves its components.</span>
  </div>
  <div class="rm-panel__body">
    <% skus.forEach(function(sku){ var definition=kitDefinitions[sku.id]; if(definition && definition.isKit){ %>
      <div class="rm-note" style="margin-bottom:12px"><div><strong><%= sku.code %> contains</strong><br>
        <% definition.components.forEach(function(component,index){ %><%= index ? ' · ' : '' %><%= component.quantity %> × <%= component.item_name %><%= component.variant_label ? ' / ' + component.variant_label : '' %> (<span class="mono"><%= component.code %></span>)<% }) %>
      </div></div>
    <% } }); %>
    <details class="rm-disclosure">
      <summary><%= Object.values(kitDefinitions).some(function(definition){return definition.isKit}) ? 'Change kit components' : 'Make this product a kit' %></summary>
      <form method="post" action="/inventory/<%= item.id %>/kit" class="rm-form-grid" style="margin-top:12px">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <label>Kit SKU<select name="kitSkuId" required><% skus.forEach(function(sku){ %><option value="<%= sku.id %>"><%= sku.code %><%= sku.variant_label ? ' · ' + sku.variant_label : '' %></option><% }) %></select></label>
        <label class="rm-span-2">Components <span class="field-help">One exact component SKU per line: <strong>SKU, quantity</strong></span><textarea name="components" rows="5" required placeholder="CLEANER-1, 2&#10;CLOTH-RED, 5"></textarea></label>
        <div class="rm-span-2"><button class="rm-button rm-button--primary">Save kit definition</button></div>
      </form>
    </details>
  </div>
</section>

<% if (canAct) { %>
  <%# Receive, Issue, Transfer and Adjust are warehouse words. A shop owner
      thinks "some came in", "I sold one", "the count is wrong". The verbs stayed
      in the engine, where they are precise; the buttons say what the person is
      actually doing. None is styled as the main action: these are four things
      you can do, not something owed. %>
  <div class="rm-choices" style="margin-bottom:8px">
    <button class="rm-btn rm-btn--ghost rm-btn--sm" type="button" data-modal-open="modal-receive"><%- helpers.icon('receive', { size: 15 }) %> Some came in</button>
    <button class="rm-btn rm-btn--ghost rm-btn--sm" type="button" data-modal-open="modal-issue"><%- helpers.icon('issue', { size: 15 }) %> Sold or used</button>
    <button class="rm-btn rm-btn--ghost rm-btn--sm" type="button" data-modal-open="modal-transfer" <%= locations.length < 2 ? 'disabled' : '' %>><%- helpers.icon('transfer', { size: 15 }) %> Move it</button>
    <button class="rm-btn rm-btn--ghost rm-btn--sm" type="button" data-modal-open="modal-adjust"><%- helpers.icon('adjust', { size: 15 }) %> Fix the count</button>
  </div>
  <p class="rm-quiet" style="font-size:12.5px;margin:0 0 18px">
    Or just <a href="/#tell-foundry">tell Foundry</a> what happened.
    <%# A greyed-out button explains itself in a tooltip, which nobody hovers and
        no phone has. Say it on the page. %>
    <% if (locations.length < 2) { %>
      Moving is off until there is a second location — <a href="/locations">add one</a>.
    <% } %>
  </p>
<% } %>

  <section class="rm-panel" id="pricing">
    <span id="reorder-settings"></span>
    <div class="rm-panel__head">
      <%- helpers.icon('layers', { size: 15, className: 'rm-quiet' }) %>
      <h2><%= item.has_variants ? 'Variants' : 'This product' %></h2>
      <span class="right">
        <% if (item.has_variants) { %><%= variantTotal %> tracked separately<% } %>
        <% if (item.has_variants && canAct) { %>
          <button class="rm-btn rm-btn--wash rm-btn--sm" type="button" data-modal-open="modal-variant" style="margin-left:10px"><%- helpers.icon('plus', { size: 14 }) %> Add</button>
        <% } %>
      </span>
    </div>
    <div class="rm-scroll">
      <table class="rm-vtable">
        <thead>
          <tr>
            <th><%= item.has_variants ? 'Variant' : 'Product' %></th>
            <th class="num">On hand</th>
            <th class="num">Committed</th>
            <th class="num">Available</th>
            <th class="num">On order</th>
            <th>Selling price</th>
            <th>Reordering</th>
            <% if (canAct) { %><th><span class="visually-hidden">Actions</span></th><% } %>
          </tr>
        </thead>
        <tbody>
          <% skus.forEach(function (sku) { %>
            <%
              var line = policyBySku[sku.id];
              var policy = line && line.policy;
              var held = sku.perLocation.filter(function (p) { return p.onHand !== 0; });
            %>
            <tr id="sku-<%= sku.id %>">
              <td class="vt-id">
                <strong><%= sku.variant_label || item.name %></strong>
                <small class="mono"><%= sku.code %></small>
                <small><a href="/warehouse/labels/sku/<%= sku.id %>">Print barcode label</a></small>
                <% if (held.length) { %>
                  <small class="vt-where">
                    <% held.forEach(function (row, i) { %><%= i ? ' · ' : '' %><%= row.locationName %> <%= helpers.qty(row.onHand) %><% }) %>
                  </small>
                <% } %>
              </td>
              <td class="num"><strong><%= helpers.qty(sku.total) %></strong></td>
              <td class="num<%= sku.committed ? '' : ' vt-nil' %>"><%= helpers.qty(sku.committed || 0) %></td>
              <td class="num<%= sku.available ? '' : ' vt-nil' %>"><%= helpers.qty(sku.available) %></td>
              <td class="num<%= sku.onOrder ? '' : ' vt-nil' %>"><%= helpers.qty(sku.onOrder || 0) %></td>
              <td class="vt-price">
                <% if (sku.sellingPrice.isSet) { %>
                  <strong><%= sku.sellingPrice.formatted %></strong>
                  <a href="/pricing/new?skuId=<%= sku.id %>">Change</a>
                <% } else { %>
                  <a class="vt-do" href="/pricing/new?skuId=<%= sku.id %>">Set price</a>
                <% } %>
                <% if (sku.purchaseCost) { %>
                  <small>purchase cost <strong><%= sku.purchaseCost.formatted %></strong><%= sku.purchaseCost.sourceLabel ? ' · ' + sku.purchaseCost.sourceLabel : '' %></small>
                  <% if (sku.sellingPrice.isSet && sku.sellingPrice.amount_minor < sku.purchaseCost.amount_minor) { %>
                    <small class="is-warn"><strong>Warning:</strong> sells <%= helpers.money(sku.purchaseCost.amount_minor - sku.sellingPrice.amount_minor, sku.purchaseCost.currency) %> below purchase cost</small>
                  <% } %>
                <% } %>
              </td>
              <td class="vt-rule">
                <% if (policy && policy.isSet) { %>
                  <strong>Reorder at <%= policy.reorderPoint === null ? '—' : policy.reorderPoint %><%= policy.targetStock === null ? '' : ', up to ' + policy.targetStock %></strong>
                <% } else { %>
                  <span class="vt-nil">No reorder level set</span>
                <% } %>
                <small><%= line && line.suppliers.length ? line.suppliers[0].supplierName : 'No supplier linked' %></small>
              </td>
              <% if (canAct) { %>
                <td class="vt-do-cell">
                  <button class="rm-btn rm-btn--ghost rm-btn--sm" type="button" data-modal-open="modal-receive" data-preset-sku="<%= sku.id %>" title="Receive this variant"><%- helpers.icon('plus', { size: 14 }) %></button>
                  <a class="rm-btn rm-btn--ghost rm-btn--sm" href="/purchasing/why/<%= sku.id %>">Configure</a>
                </td>
              <% } %>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
    <% if (variantPageCount > 1) { %>
      <div class="rm-panel__foot" style="display:flex;align-items:center;justify-content:space-between;gap:12px">
        <span>Showing <strong><%= ((variantPage - 1) * variantPageSize) + 1 %>–<%= Math.min(variantPage * variantPageSize, variantTotal) %></strong> of <strong><%= variantTotal %></strong> variants</span>
        <span class="rm-choices" style="margin:0">
          <% if (variantPage > 1) { %><a class="rm-btn rm-btn--ghost rm-btn--sm" href="/inventory/<%= item.id %>?page=<%= variantPage - 1 %>#pricing">Previous <%= variantPageSize %></a><% } %>
          <span class="rm-quiet">Page <%= variantPage %> of <%= variantPageCount %></span>
          <% if (variantPage < variantPageCount) { %><a class="rm-btn rm-btn--ghost rm-btn--sm" href="/inventory/<%= item.id %>?page=<%= variantPage + 1 %>#pricing">Next <%= variantPageSize %></a><% } %>
        </span>
      </div>
    <% } %>
    <p class="rm-panel__foot">
      Selling price is charged to customers; supplier cost is kept separately for purchasing and
      margin reporting. Foundry will not pick a reorder level for you until it has seen one
      sell — or you set it yourself.
    </p>
  </section>

<div class="rm-split">
  <div class="rm-stack">

    <% if (!skus.some(function (s) { return s.total; })) { %>
      <div class="rm-empty">
        <span class="rm-empty__ic"><%- helpers.icon('box', { size: 19 }) %></span>
        <strong>Nothing on hand</strong>
        <p>Receive stock into a location to start tracking this <%= item.has_variants ? 'product' : 'item' %>.</p>
        <% if (canAct) { %><button class="rm-btn rm-btn--wash rm-btn--sm" type="button" data-modal-open="modal-receive">Receive stock</button><% } %>
      </div>
    <% } %>

    <% if ((commitments || []).length) { %>
      <section class="rm-panel">
        <div class="rm-panel__head">
          <%- helpers.icon('sales', { size: 15, className: 'rm-quiet' }) %>
          <h2>Committed to customer orders</h2>
        </div>
        <div class="rm-told" style="box-shadow:none;border:0;border-radius:0">
          <% commitments.forEach(function (entry) { %>
            <a class="rm-told__row" href="/sales/orders/<%= entry.sales_order_id %>">
              <span class="rm-told__t"><%= entry.order_number %> · <%= entry.customer_name %>
                <small><%= entry.displayName %> · <%= entry.location_name %></small></span>
              <span class="rm-told__m"><strong><%= entry.quantity %></strong></span>
            </a>
          <% }) %>
        </div>
      </section>
    <% } %>

    <% if (mode === 'serial') { %>
      <section class="rm-panel">
        <div class="rm-panel__head">
          <%- helpers.icon('serial', { size: 15, className: 'rm-quiet' }) %>
          <h2>Units</h2>
          <span class="right"><%= units.filter(function (u) { return u.status === 'in_stock'; }).length %> in stock</span>
        </div>
        <% if (units.length === 0) { %>
          <div class="rm-empty" style="border:0;box-shadow:none">
            <span class="rm-empty__ic"><%- helpers.icon('serial', { size: 19 }) %></span>
            <strong>No units yet</strong>
            <p>Receive units by entering their serial numbers. Each one is then tracked on its own.</p>
          </div>
        <% } else { %>
          <div class="rm-scroll">
            <table class="rm-vtable">
              <thead>
                <tr><th>Serial number</th><% if (item.has_variants) { %><th>Variant</th><% } %><th>Location</th><th>Condition</th><th>Status</th></tr>
              </thead>
              <tbody>
                <% units.forEach(function (unit) { %>
                  <tr id="unit-<%= unit.id %>">
                    <td class="vt-id"><strong class="mono"><%= unit.serial %></strong><small><a href="/warehouse/labels/serial/<%= unit.id %>">Print label</a></small></td>
                    <% if (item.has_variants) { %><td><%= unit.variant_label || '—' %></td><% } %>
                    <td><%= unit.location_name || '—' %></td>
                    <td><%= helpers.conditionLabel(unit.condition) %></td>
                    <td>
                      <% if (unit.status === 'in_stock') { %>
                        <span class="rm-pillbadge is-ok">In stock</span>
                      <% } else { %>
                        <span class="rm-pillbadge">Issued</span>
                      <% } %>
                    </td>
                  </tr>
                <% }) %>
              </tbody>
            </table>
          </div>
        <% } %>
      </section>
    <% } %>

    <% if (mode === 'lot') { %>
      <section class="rm-panel">
        <div class="rm-panel__head">
          <%- helpers.icon('lot', { size: 15, className: 'rm-quiet' }) %>
          <h2>Lots</h2>
          <span class="right"><%= lots.filter(function (l) { return l.total > 0; }).length %> with stock</span>
        </div>
        <% if (lots.length === 0) { %>
          <div class="rm-empty" style="border:0;box-shadow:none">
            <span class="rm-empty__ic"><%- helpers.icon('lot', { size: 19 }) %></span>
            <strong>No lots yet</strong>
            <p>Receive stock with a lot or batch number and it will appear here with its expiration date.</p>
          </div>
        <% } else { %>
          <div class="rm-scroll">
            <table class="rm-vtable">
              <thead>
                <tr><th>Lot</th><% if (item.has_variants) { %><th>Variant</th><% } %><th>Expires</th><th>Where</th><th class="num">On hand</th></tr>
              </thead>
              <tbody>
                <% lots.forEach(function (lot) { %>
                  <% var state = helpers.expiryState(lot.expires_at); %>
                  <tr id="lot-<%= lot.id %>">
                    <td class="vt-id"><strong class="mono"><%= lot.code %></strong>
                      <% if (lot.received_at) { %><small>Received <%= helpers.shortDate(lot.received_at) %></small><% } %>
                      <small><a href="/warehouse/labels/lot/<%= lot.id %>">Print label</a></small>
                    </td>
                    <% if (item.has_variants) { %><td><%= lot.variant_label || '—' %></td><% } %>
                    <td>
                      <% if (state) { %>
                        <span class="rm-pillbadge <%= state.tone === 'ok' ? 'is-ok' : 'is-warn' %>"><%= helpers.shortDate(lot.expires_at) %></span>
                      <% } else { %><span class="vt-nil">—</span><% } %>
                    </td>
                    <td class="vt-where-cell">
                      <% if (lot.perLocation.length === 0) { %><span class="vt-nil">—</span><% } %>
                      <% lot.perLocation.forEach(function (row, i) { %><%= i ? ' · ' : '' %><%= row.location_name %> <%= helpers.qty(row.quantity) %><% }) %>
                    </td>
                    <td class="num"><strong><%= helpers.qty(lot.total) %></strong></td>
                  </tr>
                <% }) %>
              </tbody>
            </table>
          </div>
        <% } %>
      </section>
    <% } %>

    <%#
      Where this product is heading.

      Immediately after the rule it is produced by: the row above states what
      Foundry will do, this states what that is currently producing. Every
      figure here is a prediction and says so; the confidence is never buried
      behind a tooltip.
    %>
    <%
      /*
       * Five variants Foundry has never seen sell produced five identical
       * paragraphs saying so. Nothing is learned by reading the fourth. When
       * every line is still learning and none of them has a purchase, a
       * recommendation, a transfer or an anomaly attached, it is one fact about
       * the product, said once.
       */
      var outlookLines = locals.outlook || [];
      var allStillLearning = outlookLines.length > 0 && outlookLines.every(function (line) {
        // The purchase advice is not checked, because with no sales rate the
        // only advice it can carry is "not on a guess" — which is what the one
        // sentence below says. A recommendation, a move or an anomaly is
        // specific to a variant, and any of those keeps the full reading.
        return line.forecast.dailyRate === null
          && !line.advice.recommendations.length && !line.transfers.length
          && !line.anomalies.length && !line.forecast.committedUnits;
      });
    %>
    <% if (outlookLines.length && allStillLearning) { %>
      <section class="rm-panel" id="planning">
        <div class="rm-panel__head">
          <%- helpers.icon('trendUp', { size: 15, className: 'rm-quiet' }) %>
          <h2>What happens next</h2>
          <span class="right">Foundry's read on where this is heading</span>
        </div>
        <div class="rm-panel__body">
          <p class="rm-quiet" style="font-size:13.5px;line-height:1.6;margin:0">
            Nothing to order yet. Foundry has not seen any of the
            <%= item.has_variants ? variantTotal : outlookLines.length %> <%= item.has_variants ? 'variants' : 'lines' %> sell, so it
            cannot estimate how fast this sells yet and will not recommend a purchase on a guess. It starts
            advising as soon as this product moves.
          </p>
        </div>
      </section>
    <% } else if (outlookLines.length) { %>
      <section class="rm-panel" id="planning">
        <div class="rm-panel__head">
          <%- helpers.icon('trendUp', { size: 15, className: 'rm-quiet' }) %>
          <h2>What happens next</h2>
          <span class="right">Foundry's read on where this is heading</span>
        </div>
        <div class="rm-panel__body">
          <% outlook.forEach(function (line) { %>
            <article class="rm-outlook">
              <% if (outlook.length > 1) { %><strong class="rm-outlook__k"><%= line.label %></strong><% } %>

              <p>
                <% if (line.forecast.dailyRate === null) { %>
                  Foundry cannot estimate how fast this sells yet
                  <span class="rm-pillbadge">Still learning</span>.
                  <% if (line.forecast.committedUnits > 0) { %>
                    Customers have ordered <%= line.forecast.committedUnits %> that have not shipped,
                    which is what it is going on.
                  <% } %>
                <% } else { %>
                  Selling about <strong><%= line.forecast.dailyRate %></strong> a day
                  <span class="rm-pillbadge"><%= line.forecast.confidenceLabel %></span>.
                  <%= line.projection.explanation %>
                <% } %>
              </p>

              <% if (line.forecast.committedUnits > 0 && line.forecast.dailyRate !== null) { %>
                <p class="rm-quiet">
                  Separately, <strong><%= line.forecast.committedUnits %></strong> are already promised to
                  customers. That is known demand, not a forecast.
                </p>
              <% } %>

              <% if (line.leadTime && line.leadTime.material) { %>
                <p class="rm-quiet"><%= line.leadTime.explanation %></p>
              <% } %>

              <% if (line.purchase) { %>
                <p><strong><%= line.purchase.headline %></strong> — <%= line.purchase.explanation %></p>
                <% if (line.purchase.tradeoff) { %>
                  <p class="rm-quiet"><%= line.purchase.tradeoff.text %></p>
                <% } %>
              <% } %>

              <% line.advice.recommendations.forEach(function (change) { %>
                <div class="rm-rule">
                  <strong><%= change.headline %></strong>
                  <p class="rm-quiet"><%= change.why %></p>
                  <%
                    // Only a recommendation Foundry has actually written down can
                    // be decided: the row is what carries the evidence and the
                    // authority verdict, and a decision has to attach to it.
                    var raised = line.decisions && line.decisions[change.kind];
                  %>
                  <% if (raised && canOperate) { %>
                    <div class="rm-choices">
                      <form method="post" action="/planning/recommendations/<%= raised.id %>/accept">
                        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                        <input type="hidden" name="returnTo" value="/inventory/<%= item.id %>#planning">
                        <button class="rm-btn rm-btn--sm" type="submit"><%= change.actionLabel %></button>
                      </form>
                      <form method="post" action="/planning/recommendations/<%= raised.id %>/decline">
                        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                        <input type="hidden" name="returnTo" value="/inventory/<%= item.id %>#planning">
                        <button class="rm-btn rm-btn--ghost rm-btn--sm" type="submit"><%= change.keepLabel %></button>
                      </form>
                    </div>
                  <% } else { %>
                    <p class="rm-quiet" style="font-size:12.5px">
                      <%= change.actionLabel %> · <%= change.keepLabel %> — set either on the reorder
                      settings above.
                    </p>
                  <% } %>
                </div>
              <% }) %>

              <% line.transfers.forEach(function (move) { %>
                <p class="rm-quiet"><strong>Move <%= move.units %> from <%= move.fromLocationName %>
                  to <%= move.toLocationName %>.</strong> <%= move.why %></p>
              <% }) %>

              <% line.anomalies.forEach(function (finding) { %>
                <p class="rm-quiet"><strong><%= finding.headline %></strong> <%= finding.detail %>
                  <% if (finding.recommendation) { %><%= finding.recommendation %><% } %></p>
              <% }) %>

              <details class="rm-work" style="margin-top:12px">
                <summary>See how I worked this out</summary>
                <div class="rm-work__body">
                  <ul class="rm-list">
                    <% line.forecast.calculation.forEach(function (step) { %>
                      <li><%= step.detail %></li>
                    <% }) %>
                    <% line.advice.calculation.forEach(function (step) { %>
                      <li><%= step.detail %></li>
                    <% }) %>
                    <% if (line.forecast.backtest && line.forecast.backtest.ran) { %>
                      <li><%= line.forecast.backtest.reason %></li>
                    <% } %>
                    <li>Confidence: <%= line.forecast.confidenceLabel %> —
                      <%= line.forecast.confidenceReasons.join('; ') %>.</li>
                  </ul>
                </div>
              </details>
            </article>
          <% }) %>
        </div>
        <p class="rm-panel__foot">
          These are predictions from your own trading history. Foundry never changes a reorder setting
          you configured without being told to.
        </p>
      </section>
    <% } %>

    <section class="rm-panel">
      <div class="rm-panel__head">
        <%- helpers.icon('activity', { size: 15, className: 'rm-quiet' }) %>
        <h2>Recent activity</h2>
        <span class="right"><a href="/activity?item=<%= item.id %>">Full history</a></span>
      </div>
      <% if (recent.length === 0) { %>
        <div class="rm-empty" style="border:0;box-shadow:none">
          <span class="rm-empty__ic"><%- helpers.icon('activity', { size: 19 }) %></span>
          <strong>Nothing has happened yet</strong>
          <p>Every receipt, issue, transfer and adjustment for this item will be listed here.</p>
        </div>
      <% } else { %>
        <div class="rm-panel__body">
          <%- include('../partials/ledger', { groups: recent, helpers: helpers }) %>
        </div>
      <% } %>
    </section>
  </div>

  <div class="rm-stack">
    <section class="rm-panel">
      <div class="rm-panel__head">
        <%- helpers.icon('tag', { size: 15, className: 'rm-quiet' }) %>
        <h2>Details</h2>
      </div>
      <div class="rm-bands" style="box-shadow:none;border:0;border-radius:0">
        <div class="rm-band"><span class="rm-band__k">Item code</span><span class="rm-band__v mono"><%= item.base_code || '—' %></span></div>
        <div class="rm-band"><span class="rm-band__k">Tracking</span><span class="rm-band__v"><%= modeInfo.staffLabel %><%= item.has_variants ? ', by variant' : '' %></span></div>
        <div class="rm-band"><span class="rm-band__k">Counted in</span><span class="rm-band__v"><%= helpers.plural(2, item.unit_label) %></span></div>
        <% if (item.has_variants) { %>
          <div class="rm-band"><span class="rm-band__k">Options</span><span class="rm-band__v"><%= options.map(function (o) { return o.name; }).join(', ') %></span></div>
        <% } %>
        <div class="rm-band"><span class="rm-band__k">Added</span><span class="rm-band__v"><%= helpers.shortDate(item.created_at) %></span></div>
        <% if (item.allow_negative) { %>
          <div class="rm-band"><span class="rm-band__k">Negative stock</span><span class="rm-band__v"><span class="rm-pillbadge is-warn">Allowed</span></span></div>
        <% } %>
      </div>
    </section>

    <% if (locationTotals.length > 0) { %>
      <section class="rm-panel">
        <div class="rm-panel__head">
          <%- helpers.icon('locations', { size: 15, className: 'rm-quiet' }) %>
          <h2>Where it is</h2>
        </div>
        <div class="rm-panel__body">
          <% var maxTotal = locationTotals.reduce(function (m, l) { return Math.max(m, l.total); }, 0) || 1; %>
          <% locationTotals.forEach(function (row) { %>
            <div class="rm-where">
              <span class="rm-where__k"><%= row.name %></span>
              <span class="rm-where__v"><%= helpers.qty(row.total) %></span>
              <span class="rm-meter"><span style="width: <%= Math.round((row.total / maxTotal) * 100) %>%"></span></span>
            </div>
          <% }) %>
        </div>
      </section>
    <% } %>

    <% if (item.is_active) { %>
      <form method="post" action="/inventory/<%= item.id %>/archive" data-confirm="Archive <%= item.name %>? It will be hidden from the inventory list.">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <div class="rm-note">
          <%- helpers.icon('box', { size: 16 }) %>
          <div style="flex:1">
            <strong>Archive item</strong>
            Only possible when nothing is on hand.
          </div>
          <button class="rm-btn rm-btn--ghost rm-btn--sm" type="submit">Archive</button>
        </div>
      </form>
    <% } else { %>
      <form method="post" action="/inventory/<%= item.id %>/archive">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <input type="hidden" name="restore" value="1">
        <div class="rm-note">
          <%- helpers.icon('box', { size: 16 }) %>
          <div style="flex:1"><strong>Restore item</strong></div>
          <button class="rm-btn rm-btn--ghost rm-btn--sm" type="submit">Restore</button>
        </div>
      </form>
    <% } %>
  </div>
</div>

<script type="application/json" id="item-data"><%- JSON.stringify(itemData) %></script>

<!-- ------------------------------------------------------------- modals -- -->

<dialog class="modal" id="modal-edit">
  <form method="post" action="/inventory/<%= item.id %>/details">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <div class="modal-head">
      <h2>Edit item details</h2>
      <button class="btn btn--ghost btn--sm close" type="button" data-modal-close aria-label="Close"><%- helpers.icon('close', { size: 16 }) %></button>
    </div>
    <div class="modal-body">
      <div class="field">
        <label class="label" for="edit-name">Name</label>
        <input class="input" id="edit-name" name="name" value="<%= item.name %>" required>
      </div>
      <div class="field-row">
        <div class="field">
          <label class="label" for="edit-code">Item code</label>
          <input class="input mono" id="edit-code" name="baseCode" value="<%= item.base_code || '' %>">
        </div>
        <div class="field">
          <label class="label" for="edit-unit">Counted in</label>
          <input class="input" id="edit-unit" name="unitLabel" value="<%= item.unit_label %>">
        </div>
      </div>
      <div class="field">
        <label class="label" for="edit-description">Description</label>
        <textarea class="textarea" id="edit-description" name="description"><%= item.description || '' %></textarea>
      </div>
      <% if (mode === 'quantity') { %>
        <div class="field">
          <label class="checkbox">
            <input type="checkbox" name="allowNegative" value="1" <%= item.allow_negative ? 'checked' : '' %>>
            <span class="checkbox-text">
              <strong>Allow stock to go negative</strong>
              <small>Off by default. Only turn this on if your process records issues before receipts.</small>
            </span>
          </label>
        </div>
      <% } %>
      <div class="notice">
        <%- helpers.icon('shield', { size: 16 }) %>
        <span>How this item is tracked (<%= modeInfo.label.toLowerCase() %>) cannot change once it exists, because past movements are recorded against it.</span>
      </div>
    </div>
    <div class="modal-foot">
      <button class="btn" type="button" data-modal-close>Cancel</button>
      <button class="btn btn--primary" type="submit">Save details</button>
    </div>
  </form>
</dialog>

<% if (item.has_variants) { %>
  <dialog class="modal" id="modal-variant">
    <form method="post" action="/inventory/<%= item.id %>/variants">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <div class="modal-head">
        <h2>Add a variant</h2>
        <button class="btn btn--ghost btn--sm close" type="button" data-modal-close aria-label="Close"><%- helpers.icon('close', { size: 16 }) %></button>
      </div>
      <div class="modal-body">
        <% options.forEach(function (option) { %>
          <div class="field">
            <label class="label" for="variant-<%= option.id %>"><%= option.name %></label>
            <input class="input" id="variant-<%= option.id %>" name="optionValues[<%= option.id %>]" required>
          </div>
        <% }) %>
        <div class="hint">A new tracked variant is created with its own stock, starting at zero.</div>
      </div>
      <div class="modal-foot">
        <button class="btn" type="button" data-modal-close>Cancel</button>
        <button class="btn btn--primary" type="submit">Add variant</button>
      </div>
    </form>
  </dialog>
<% } %>

<% if (canAct) { %>
  <!-- Receive -->
  <dialog class="modal" id="modal-receive">
    <form method="post" action="/inventory/<%= item.id %>/receive" data-stock-form>
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <div class="modal-head">
        <span class="ledger-icon ledger-icon--receive"><%- helpers.icon('receive', { size: 16 }) %></span>
        <h2>Some came in</h2>
        <button class="btn btn--ghost btn--sm close" type="button" data-modal-close aria-label="Close"><%- helpers.icon('close', { size: 16 }) %></button>
      </div>
      <div class="modal-body">
        <%- include('../partials/form-sku', { item: item, skus: skus, idPrefix: 'receive' }) %>
        <div class="field">
          <label class="label" for="receive-location">Into location</label>
          <select class="select" id="receive-location" name="locationId" required>
            <% locations.forEach(function (location) { %>
              <option value="<%= location.id %>"><%= location.name %></option>
            <% }) %>
          </select>
          <div class="hint" data-onhand></div>
        </div>

        <% if (mode === 'serial') { %>
          <div class="field">
            <label class="label" for="receive-serials">Serial numbers</label>
            <textarea class="textarea mono" id="receive-serials" name="serials" required placeholder="DL-829193&#10;DL-829194" rows="5"></textarea>
            <div class="hint">One per line. Each becomes its own tracked unit.</div>
          </div>
          <div class="field">
            <label class="label" for="receive-condition">Condition</label>
            <select class="select" id="receive-condition" name="condition">
              <% helpers.CONDITIONS.forEach(function (condition) { %>
                <option value="<%= condition.id %>"><%= condition.label %></option>
              <% }) %>
            </select>
          </div>
        <% } else { %>
          <div class="field">
            <label class="label" for="receive-quantity">Quantity</label>
            <input class="input num" id="receive-quantity" name="quantity" type="number" min="1" step="1" required inputmode="numeric" placeholder="0">
          </div>
        <% } %>

        <% if (mode === 'lot') { %>
          <div class="field">
            <label class="label" for="receive-lot">Lot or batch number</label>
            <input class="input mono" id="receive-lot" name="lotCode" required placeholder="L240812">
            <div class="hint">Receiving into an existing lot adds to it.</div>
          </div>
          <div class="field-row">
            <div class="field">
              <label class="label" for="receive-lot-received">Received on <span class="optional">optional</span></label>
              <input class="input" id="receive-lot-received" name="lotReceivedAt" type="date">
            </div>
            <div class="field">
              <label class="label" for="receive-expires">Expires <span class="optional">optional</span></label>
              <input class="input" id="receive-expires" name="expiresAt" type="date">
            </div>
          </div>
        <% } %>

        <div class="field-row">
          <div class="field">
            <label class="label" for="receive-reference">Reference <span class="optional">optional</span></label>
            <input class="input" id="receive-reference" name="reference" placeholder="Delivery note">
          </div>
          <div class="field">
            <label class="label" for="receive-notes">Notes <span class="optional">optional</span></label>
            <input class="input" id="receive-notes" name="notes">
          </div>
        </div>
      </div>
      <div class="modal-foot">
        <button class="btn" type="button" data-modal-close>Cancel</button>
        <button class="btn btn--primary" type="submit">Receive</button>
      </div>
    </form>
  </dialog>

  <!-- Issue -->
  <dialog class="modal" id="modal-issue">
    <form method="post" action="/inventory/<%= item.id %>/issue" data-stock-form>
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <div class="modal-head">
        <span class="ledger-icon ledger-icon--issue"><%- helpers.icon('issue', { size: 16 }) %></span>
        <h2>Sold or used</h2>
        <button class="btn btn--ghost btn--sm close" type="button" data-modal-close aria-label="Close"><%- helpers.icon('close', { size: 16 }) %></button>
      </div>
      <div class="modal-body">
        <%- include('../partials/form-sku', { item: item, skus: skus, idPrefix: 'issue' }) %>
        <div class="field">
          <label class="label" for="issue-location">From location</label>
          <select class="select" id="issue-location" name="locationId" required>
            <% locations.forEach(function (location) { %>
              <option value="<%= location.id %>"><%= location.name %></option>
            <% }) %>
          </select>
          <div class="hint" data-onhand></div>
        </div>

        <% if (mode === 'serial') { %>
          <%- include('../partials/units-picker', { units: units, helpers: helpers, label: 'Units to issue' }) %>
        <% } else { %>
          <% if (mode === 'lot') { %>
            <div class="field">
              <label class="label" for="issue-lot">From lot</label>
              <select class="select" id="issue-lot" name="lotId" required>
                <option value="">Choose a lot</option>
                <% lots.forEach(function (lot) { %>
                  <option value="<%= lot.id %>"><%= lot.code %></option>
                <% }) %>
              </select>
            </div>
          <% } %>
          <div class="field">
            <label class="label" for="issue-quantity">Quantity</label>
            <input class="input num" id="issue-quantity" name="quantity" type="number" min="1" step="1" required inputmode="numeric">
          </div>
        <% } %>

        <div class="field">
          <label class="label" for="issue-reason">Reason <span class="optional">optional</span></label>
          <select class="select" id="issue-reason" name="reasonCode">
            <option value="">Not specified</option>
            <% helpers.ISSUE_REASONS.forEach(function (reason) { %>
              <option value="<%= reason.id %>"><%= reason.label %></option>
            <% }) %>
          </select>
        </div>
        <div class="field">
          <label class="label" for="issue-occurred">When did it go out? <span class="optional">optional</span></label>
          <input class="input" id="issue-occurred" name="occurredAt" type="date" max="<%= new Date().toISOString().slice(0, 10) %>">
          <span class="field-help">Leave blank for today. Foundry works out what to reorder from when stock actually left, so entering last week's sales with last week's dates keeps that right.</span>
        </div>
        <div class="field-row">
          <div class="field">
            <label class="label" for="issue-reference">Reference <span class="optional">optional</span></label>
            <input class="input" id="issue-reference" name="reference" placeholder="Job or order number">
          </div>
          <div class="field">
            <label class="label" for="issue-notes">Notes <span class="optional">optional</span></label>
            <input class="input" id="issue-notes" name="notes">
          </div>
        </div>
      </div>
      <div class="modal-foot">
        <button class="btn" type="button" data-modal-close>Cancel</button>
        <button class="btn btn--primary" type="submit">Issue</button>
      </div>
    </form>
  </dialog>

  <!-- Transfer -->
  <dialog class="modal" id="modal-transfer">
    <form method="post" action="/inventory/<%= item.id %>/transfer" data-stock-form>
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <div class="modal-head">
        <span class="ledger-icon ledger-icon--transfer"><%- helpers.icon('transfer', { size: 16 }) %></span>
        <h2>Move it somewhere else</h2>
        <button class="btn btn--ghost btn--sm close" type="button" data-modal-close aria-label="Close"><%- helpers.icon('close', { size: 16 }) %></button>
      </div>
      <div class="modal-body">
        <%- include('../partials/form-sku', { item: item, skus: skus, idPrefix: 'transfer' }) %>
        <div class="field-row">
          <div class="field">
            <label class="label" for="transfer-from">From</label>
            <select class="select" id="transfer-from" name="fromLocationId" required>
              <% locations.forEach(function (location) { %>
                <option value="<%= location.id %>"><%= location.name %></option>
              <% }) %>
            </select>
            <div class="hint" data-onhand></div>
          </div>
          <div class="field">
            <label class="label" for="transfer-to">To</label>
            <select class="select" id="transfer-to" name="toLocationId" required>
              <% locations.forEach(function (location, index) { %>
                <option value="<%= location.id %>" <%= index === 1 ? 'selected' : '' %>><%= location.name %></option>
              <% }) %>
            </select>
          </div>
        </div>

        <% if (mode === 'serial') { %>
          <%- include('../partials/units-picker', { units: units, helpers: helpers, label: 'Units to move' }) %>
        <% } else { %>
          <% if (mode === 'lot') { %>
            <div class="field">
              <label class="label" for="transfer-lot">From lot</label>
              <select class="select" id="transfer-lot" name="lotId" required>
                <option value="">Choose a lot</option>
                <% lots.forEach(function (lot) { %>
                  <option value="<%= lot.id %>"><%= lot.code %></option>
                <% }) %>
              </select>
            </div>
          <% } %>
          <div class="field">
            <label class="label" for="transfer-quantity">Quantity</label>
            <input class="input num" id="transfer-quantity" name="quantity" type="number" min="1" step="1" required inputmode="numeric">
          </div>
        <% } %>

        <div class="field-row">
          <div class="field">
            <label class="label" for="transfer-reference">Reference <span class="optional">optional</span></label>
            <input class="input" id="transfer-reference" name="reference">
          </div>
          <div class="field">
            <label class="label" for="transfer-notes">Notes <span class="optional">optional</span></label>
            <input class="input" id="transfer-notes" name="notes">
          </div>
        </div>
        <div class="notice">
          <%- helpers.icon('shield', { size: 16 }) %>
          <span>This requests a tracked transfer. Stock stays here until dispatch, remains in transit while travelling, and reaches the destination only when it is received.</span>
        </div>
      </div>
      <div class="modal-foot">
        <button class="btn" type="button" data-modal-close>Cancel</button>
        <button class="btn btn--primary" type="submit">Request transfer</button>
      </div>
    </form>
  </dialog>

  <!-- Adjust -->
  <dialog class="modal" id="modal-adjust">
    <form method="post" action="/inventory/<%= item.id %>/adjust" data-stock-form>
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <div class="modal-head">
        <span class="ledger-icon ledger-icon--adjust"><%- helpers.icon('adjust', { size: 16 }) %></span>
        <h2><%= mode === 'serial' ? 'Write off units' : 'Fix the count' %></h2>
        <button class="btn btn--ghost btn--sm close" type="button" data-modal-close aria-label="Close"><%- helpers.icon('close', { size: 16 }) %></button>
      </div>
      <div class="modal-body">
        <%- include('../partials/form-sku', { item: item, skus: skus, idPrefix: 'adjust' }) %>
        <div class="field">
          <label class="label" for="adjust-location">Location</label>
          <select class="select" id="adjust-location" name="locationId" required>
            <% locations.forEach(function (location) { %>
              <option value="<%= location.id %>"><%= location.name %></option>
            <% }) %>
          </select>
        </div>

        <% if (mode === 'serial') { %>
          <%- include('../partials/units-picker', { units: units, helpers: helpers, label: 'Units that are missing or written off' }) %>
        <% } else { %>
          <% if (mode === 'lot') { %>
            <div class="field">
              <label class="label" for="adjust-lot">Lot</label>
              <select class="select" id="adjust-lot" name="lotId" required>
                <option value="">Choose a lot</option>
                <% lots.forEach(function (lot) { %>
                  <option value="<%= lot.id %>"><%= lot.code %></option>
                <% }) %>
              </select>
            </div>
          <% } %>
          <div class="field-row">
            <div class="field">
              <label class="label">Foundry expects</label>
              <input class="input num" value="0" data-expected readonly tabindex="-1" aria-readonly="true">
            </div>
            <div class="field">
              <label class="label" for="adjust-counted">Physical count</label>
              <input class="input num" id="adjust-counted" name="countedQty" type="number" min="0" step="1" required inputmode="numeric">
            </div>
          </div>
        <% } %>

        <div class="field">
          <label class="label" for="adjust-reason">Reason</label>
          <select class="select" id="adjust-reason" name="reasonCode" required>
            <option value="">Choose a reason</option>
            <% helpers.ADJUSTMENT_REASONS.forEach(function (reason) { %>
              <option value="<%= reason.id %>"><%= reason.label %></option>
            <% }) %>
          </select>
          <div class="hint">Adjustments always need a reason. It is stored with the movement.</div>
        </div>
        <div class="field">
          <label class="label" for="adjust-notes">Notes <span class="optional">optional</span></label>
          <input class="input" id="adjust-notes" name="notes" placeholder="Anything the next person should know">
        </div>
      </div>
      <div class="modal-foot">
        <button class="btn" type="button" data-modal-close>Cancel</button>
        <button class="btn btn--primary" type="submit"><%= mode === 'serial' ? 'Write off' : 'Save adjustment' %></button>
      </div>
    </form>
  </dialog>
<% } %>
