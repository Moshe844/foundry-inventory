<% const v=productView,first=skus[0],single=variantTotal===1,price=single&&first.sellingPrice?.isSet?first.sellingPrice:null,cost=single?first.purchaseCost:null,currency=price?.currency||cost?.currency||'USD',low=v.low,out=Number(total)<=0,runout=v.issueRate>0?Math.max(0,Math.floor(available/v.issueRate)):null,reorder=single?'/purchasing/why/'+first.id:'/purchasing/setup',owner=currentUser.role==='owner',unit=item.secondary_unit_label||item.unit_label,base='/inventory/'+item.id;
const priceLabel=v.money?.priceLabel||(price?price.formatted:'Not set'),costLabel=v.money?.costLabel||(cost?cost.formatted:'Not set'),profitLabel=v.money?.profitLabel||(price&&cost&&price.currency===cost.currency?helpers.money(price.amount_minor-cost.amount_minor,currency):'Needs price and cost'),marginLabel=v.money?.marginLabel;
const statusLabel=s=>{const text=String(s||'').replaceAll('_',' ').toLowerCase();return text.charAt(0).toUpperCase()+text.slice(1);},uncostedShown=skus.reduce((n,s)=>n+Number(s.stockCost?.missingUnits||0),0); %>
<a class="back-link" href="/inventory">‹ Stock</a>
<section class="pd-head sc-product-header" <%- single?'id="sku-'+first.id+'"':'' %>>
  <button type="button" class="sc-product-photo" data-modal-open="product-photo" aria-label="Change product photo"><% if(v.photo){ %><img src="<%= base %>/photo?v=<%= v.photo.content_hash %>" alt="<%= item.name %>"><% }else{ %><%- helpers.icon('inventory',{size:28}) %><small>Add photo</small><% } %></button>
  <div class="pd-head__who">
    <h1><%= item.name %> <% if(!item.is_active){ %><span class="badge">Archived</span><% }else if(out){ %><span class="badge badge--danger">Out of stock</span><% }else if(low&&!single&&v.lowVariants){ %><span class="badge badge--warn"><%= helpers.qty(v.lowVariants) %> of <%= helpers.qty(variantTotal) %> variants low</span><% }else if(low){ %><span class="badge badge--warn">Low · reorder soon</span><% }else{ %><span class="badge badge--success">In stock</span><% } %></h1>
    <p><span class="mono"><%= helpers.productCode(item.base_code, first.code) %></span> · Counted in <%= item.unit_label %><%= variantTotal>1?' · '+helpers.qty(variantTotal)+' variants':'' %></p>
  </div>
  <div class="pd-head__do sc-product-actions"><% if(item.is_active&&item.has_variants&&locals.canOperate){ %><button class="btn" type="button" data-modal-open="modal-variant">Add variant</button><% } %><button class="btn" type="button" data-modal-open="modal-adjust" <%= !canAct?'disabled':'' %>>Adjust stock</button><a class="btn btn--primary" href="<%= reorder %>">Reorder</a><details class="sc-product-more"><summary class="btn" aria-label="More product actions">⋯</summary><div><button class="btn" type="button" data-modal-open="modal-edit">Edit details</button><% if(canAct){ %><button class="btn" type="button" data-modal-open="modal-receive">Some came in</button><button class="btn" type="button" data-modal-open="modal-issue">Sold or used</button><button class="btn" type="button" data-modal-open="modal-transfer" <%= locations.length<2?'disabled':'' %>>Move stock</button><% } %><a class="btn" href="<%= base %>/duplicate">Duplicate product</a><a class="btn" href="/warehouse/labels/sku/<%= first.id %>">Print barcode label</a><a class="btn" href="/ask?from=<%= encodeURIComponent(base) %>&amp;recordType=product&amp;recordId=<%= item.id %>">Ask about this product</a><% if(owner){ %><form method="post" action="<%= base %>/archive"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><% if(!item.is_active){ %><input type="hidden" name="restore" value="1"><% } %><button class="btn" type="submit"><%= item.is_active?'Archive':'Restore' %></button></form><% if(item.is_active){ %><a class="btn rd-delete" href="/delete/product/<%= encodeURIComponent(item.id) %>">Delete product</a><% } %><% } %></div></details></div>
</section>
<% if(uncostedShown){ %><div class="notice" data-product-cost-hold><strong>Cost not recorded for <%= helpers.unitCount(uncostedShown,'unit') %>.</strong> Record their cost before selling those units.<%= variantPageCount>1?' This covers the variants shown on this page.':'' %> <% if(locals.canEstablishCost){ %><a href="<%= base %>/costs">Add stock cost →</a><% } %></div><% } %>
<div class="sc-tiles pd-tiles">
  <a class="sc-tile <%= out?'is-urgent':'' %>" href="<%= base %>?tab=history"><span>On hand</span><strong><%= helpers.qty(total) %></strong><small><% if(item.secondary_unit_label){ %><%= helpers.qty(locals.secondaryTotal||0) %> <%= item.secondary_unit_label %> · <% } %>all locations</small></a>
  <a class="sc-tile <%= Number(available)<=0?'is-urgent':low?'is-important':'' %>" href="<%= base %>?tab=orders"><span>Available</span><strong><%= helpers.qty(available) %></strong><small><%= helpers.qty(committed) %> committed to orders</small></a>
  <a class="sc-tile" href="<%= base %>?tab=orders"><span>Incoming</span><strong><%= helpers.qty(onOrder) %></strong><small>on purchase orders</small></a>
  <a class="sc-tile <%= runout!==null&&runout<=7?'is-urgent':runout!==null&&runout<=30?'is-important':'' %>" href="<%= reorder %>"><span>Runs out in</span><strong class="<%= runout===null?'is-quiet':'' %>"><%= runout===null?'Not enough history':runout>365?'Over a year':runout===1?'1 day':runout+' days' %></strong><small><%= runout===null?'No recent issues to estimate demand':'At the last 30-day issue rate' %></small></a>
</div>
<section class="pd-money sc-product-prices" aria-label="Price and cost">
  <div>Sells for <% if(priceLabel==='Not set'&&owner&&single){ %><a href="/pricing/new?skuId=<%= first.id %>">Set price →</a><% }else{ %><strong><%= priceLabel %></strong><% } %></div>
  <% if(locals.canViewCosts!==false){ %><div>Purchase cost <% if(costLabel==='Not set'&&owner&&single){ %><a href="/pricing/purchase-costs/new?skuId=<%= first.id %>">Set cost →</a><% }else{ %><strong><%= costLabel %></strong><% } %></div><% } %>
  <% if(locals.canViewMargins!==false){ %><div>Profit per <%= unit %> <strong class="<%= /^(Not set|Needs)/.test(profitLabel)?'is-quiet':'' %>"><%= profitLabel %></strong></div>
  <% if(marginLabel&&marginLabel!=='Not set'){ %><div>Margin <strong><%= marginLabel %></strong></div><% } %>
  <% if((price&&cost)||(v.money?.profitLabel&&v.money.profitLabel!=='Not set')){ %><small class="sc-business-note">Quoted margin per <%= unit %>; actual sales profit uses the recorded stock cost.</small><% } %><% } %>
</section>
<nav class="sc-section-tabs" aria-label="Product tabs"><% for(const [key,label]of [['overview','Overview'],['history','History'],['orders','Orders'],['suppliers','Suppliers & costs']].filter(([key])=>key!=='suppliers'||locals.canViewCosts!==false)){ %><a href="<%= base %>?tab=<%= key %>" aria-current="<%= v.tab===key?'page':'false' %>"><%= label %></a><% } %></nav>
<div class="pd-grid <%= variantTotal>1?'pd-grid--wide':'' %>">
<div class="pd-main">
<% if(v.tab==='overview'){const peak=Math.max(1,...v.sales.map(r=>Math.abs(r.revenue_minor))),totalSold=v.sales.reduce((n,r)=>n+r.revenue_minor,0),dayKey=value=>String(value instanceof Date?value.toISOString():value).slice(0,10),soldOn=new Map(v.sales.map(r=>[dayKey(r.posting_date),r.revenue_minor])),lastDay=[new Date().toISOString().slice(0,10),...soldOn.keys()].sort().at(-1),salesDays=Array.from({length:Number(v.days)},(_,i)=>new Date(Date.parse(lastDay+'T12:00:00Z')-(Number(v.days)-1-i)*86400000).toISOString().slice(0,10)); %>
  <section class="sc-business-card pd-sales"><header><h2>Sales</h2><nav class="pd-range" aria-label="Sales period"><a href="<%= base %>?days=30" aria-current="<%= Number(v.days)===30?'true':'false' %>">30 days</a><a href="<%= base %>?days=90" aria-current="<%= Number(v.days)===90?'true':'false' %>">90 days</a></nav></header>
    <p class="pd-sales__total"><strong><%= helpers.money(totalSold,currency) %></strong> recorded net sales · last <%= v.days %> days</p>
    <% if(v.sales.length){ %><div class="pd-columns" role="img" aria-label="Sales by day"><% for(const day of salesDays){const sold=soldOn.get(day); %><i class="<%= sold<0?'is-negative':!sold?'is-none':'' %>" style="height:<%= sold?Math.max(3,Math.abs(sold)/peak*100):1 %>%" title="<%= helpers.shortDate(day) %>: <%= helpers.money(sold||0,currency) %>"></i><% } %></div><div class="pd-columns__axis"><span><%= helpers.shortDate(salesDays[0]) %></span><span><%= helpers.shortDate(salesDays.at(-1)) %></span></div><% }else{ %><p class="sc-empty">No sales recorded in this period.</p><% } %></section>
  <% if(locals.importedGroups?.count){const imported=importedGroups,multi=imported.variants.length>1,rowsText=rows=>rows.length===1?'Source row '+rows[0]:rows.length<=4?'Source rows '+rows.join(', '):'Source rows '+rows[0]+'–'+rows.at(-1)+' ('+rows.length+')'; %><section class="sc-business-card pd-imported"><h2>Imported details</h2><% if(imported.shared.length){ %><p class="pd-imported__lead">Same for every variant on this page</p><dl><% for(const field of imported.shared){ %><dt><%= field.name %></dt><dd><%= field.value %></dd><% } %></dl><% } %><% for(const variant of imported.variants){ if(!variant.fields.length&&multi)continue; %><% if(multi){ %><details><summary><span class="mono"><%= variant.code %></span> · <%= variant.fields.length %> <%= variant.fields.length===1?'detail':'details' %></summary><% } %><dl><% for(const field of variant.fields){ %><dt><%= field.name %></dt><dd><%= field.value %></dd><% } %></dl><p class="pd-imported__source"><% for(const source of variant.sources){ %><a href="/imports/<%= source.importId %>"><%= rowsText(source.rows) %></a> <% } %></p><% if(multi){ %></details><% } %><% } %></section><% } %>
  <%- include('../partials/tracking-pages') %>
  <% if(mode==='serial'){ %><section class="sc-business-card"><h2>Serial units</h2><div class="sc-product-variants"><% for(const unit of units){ %><article id="unit-<%= unit.id %>"><strong><%= unit.serial %></strong><span><%= unit.variant_label||item.name %></span><small><%= unit.location_name||'No location' %> · <%= helpers.conditionLabel(unit.condition) %> · <%= unit.status.replaceAll('_',' ') %></small><a href="/warehouse/labels/serial/<%= unit.id %>">Print serial label</a></article><% } %></div><% if(!units.length){ %><p class="sc-empty">No serial units on this page.</p><% } %></section><% } %>
  <% if(mode==='lot'){ %><section class="sc-business-card"><h2>Lots and batches</h2><div class="sc-product-variants"><% for(const lot of lots){ %><article id="lot-<%= lot.id %>"><strong><%= lot.code %></strong><span><%= helpers.qty(lot.total) %> on hand</span><small><%= lot.expires_at?'Expires '+helpers.shortDate(lot.expires_at):'No expiry recorded' %></small><% for(const p of lot.perLocation||[]){ %><small><%= p.location_name %>: <%= helpers.qty(p.quantity) %></small><% } %><a href="/warehouse/labels/lot/<%= lot.id %>">Print lot label</a></article><% } %></div><% if(!lots.length){ %><p class="sc-empty">No lots on this page.</p><% } %></section><% } %>
  <% if(variantTotal>1){ %><section class="sc-business-card vx" id="variants"><header class="vx-head"><h2>Variants <span class="vx-count"><%= Number(variantTotal).toLocaleString('en-US') %></span></h2><% if(owner){ %><form method="post" action="/inventory/bulk" class="vx-all"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="itemIds" value="<%= item.id %>"><label><span class="visually-hidden">All active variants</span><select class="select" name="kind"><option value="price">Change selling prices</option><option value="cost">Change purchase costs</option><option value="reorder">Change reorder levels</option></select></label><button class="btn" type="submit">Edit all variants</button></form><% } %></header><% if(options.length===2){ %><%- include('variant-grid') %><% } %><%- include('variant-list',{base}) %><% if(owner){ %><details class="vx-editor" id="variant-table-editor" <%= variantTotal<=variantPageSize?'open':'' %>><summary>Edit these variants in a table</summary><%- include('variant-edit-table') %></details><% } %></section><% } %>
<% }else if(v.tab==='history'){ %>
  <section class="sc-business-card"><h2>Stock history</h2><% if(!v.history.length){ %><p class="sc-empty">No stock movements recorded.</p><% }else{ %><div class="pd-table-wrap"><table class="pd-table"><thead><tr><th>When</th><th>What happened</th><th>Where</th><th class="is-num">Change</th><th class="is-num">Stock after</th></tr></thead><tbody><% for(const r of v.history){const delta=Number(r.quantity_delta); %><tr><td><time><%= helpers.dateTime(r.occurred_at) %></time></td><td><strong><%= helpers.operationLabel(r.operation) %></strong><% if(variantTotal>1){ %> <span class="mono"><%= r.code %></span><% } %><% if(r.reference){ %><small><%= r.reference %></small><% } %></td><td><%= r.location_name %></td><td class="is-num <%= delta>0?'is-up':delta<0?'is-down':'' %>"><%= delta>0?'+':'' %><%= helpers.qty(r.quantity_delta) %></td><td class="is-num"><%= helpers.qty(r.balance_after) %></td></tr><% } %></tbody></table></div><% } %><% if(v.historyHasMore){ %><p class="pd-note">Showing the latest 100 movement groups. <a href="/reports/business/movement">Open inventory movement report</a> for more.</p><% } %></section>
<% }else if(v.tab==='orders'){ %>
  <% for(const side of [{title:'Customer orders',rows:v.orders,sales:true},{title:'Purchase orders',rows:v.purchases,sales:false}]){ %><section class="sc-business-card"><h2><%= side.title %></h2><% if(!side.rows.length){ %><p class="sc-empty">No orders recorded for this product.</p><% } %><% for(const r of side.rows){ %><a class="sc-party-row" href="<%= side.sales?'/orders/':'/purchasing/orders/' %><%= r.id %>"><span><strong><%= r.order_number||r.po_number %></strong><small><%= r.customer||r.supplier %></small></span><span class="badge"><%= statusLabel(r.status) %></span></a><% } %></section><% } %>
<% }else{ %>
  <section class="sc-business-card"><header><h2>Suppliers</h2><a href="/suppliers/for/<%= first.id %>">Manage supplier links</a></header><% if(!v.suppliers.length){ %><p class="sc-empty">No supplier linked. <a href="/suppliers/for/<%= first.id %>">Link a supplier</a>.</p><% }else{ %><div class="pd-table-wrap"><table class="pd-table"><thead><tr><th>Supplier</th><th>Their code</th><th class="is-num">Cost</th><th class="is-num">Lead time</th><th></th></tr></thead><tbody><% for(const s of v.suppliers){ %><tr><td><a href="/suppliers/<%= s.supplier_id %>"><strong><%= s.supplier_name %></strong></a><small class="mono"><%= s.code %></small></td><td><%= s.supplier_sku||'None recorded' %></td><td class="is-num"><%= s.costLabel %></td><td class="is-num"><%= s.effective_lead==null?'Not recorded':s.effective_lead+' days' %></td><td class="is-num"><a class="btn btn--sm" href="/purchasing/why/<%= s.sku_id %>">Reorder</a></td></tr><% } %></tbody></table></div><% } %></section>
  <section class="sc-business-card"><h2>Prices and stock cost</h2><div class="pd-table-wrap"><table class="pd-table"><thead><tr><th>Product</th><th class="is-num">Selling price</th><th class="is-num">Purchase cost</th><th class="is-num">Stock value</th></tr></thead><tbody><% for(const sku of skus){ %><tr><td><strong><%= sku.variant_label||item.name %></strong><small class="mono"><%= sku.code %></small></td><td class="is-num"><%= sku.sellingPrice.formatted %><small><a href="/pricing/new?skuId=<%= sku.id %>">Change selling price</a></small></td><td class="is-num"><%= sku.purchaseCost?.formatted||'Not set' %><small><a href="/pricing/purchase-costs/new?skuId=<%= sku.id %>">Change purchase cost</a></small></td><td class="is-num"><% if(sku.stockCost?.missingUnits){ %><span class="is-warn"><%= helpers.unitCount(sku.stockCost.missingUnits,'unit') %> still need a purchase cost.</span><% if(locals.canEstablishCost){ %><small><a href="<%= base %>/costs">Add stock cost</a></small><% } %><% }else if(sku.stockCost){ %><%= helpers.money(sku.stockCost.totalCostMinor,sku.stockCost.currency) %><% }else{ %>—<% } %></td></tr><% } %></tbody></table></div></section>
<% } %>
</div>
<aside class="pd-side">
  <section class="sc-business-card"><h2>Where it is</h2><% const placed=locationTotals.filter(l=>Number(l.total)!==0),most=Math.max(1,...placed.map(l=>Math.abs(Number(l.total)))); %><% if(!placed.length){ %><p class="sc-empty">None in stock at any location.</p><% } %><% for(const l of placed){ %><div class="pd-place"><span><%= l.name||l.locationName||l.location_name %></span><strong><%= helpers.qty(l.total) %></strong><i style="width:<%= Math.abs(Number(l.total))/most*100 %>%"></i></div><% } %><% if(locations.length>1){ %><p class="pd-note"><a href="/transfers/new">Move stock between locations →</a></p><% } %></section>
  <section class="sc-business-card"><header><h2>Reordering</h2><a href="<%= reorder %>">Change</a></header><% for(const sku of skus){const line=policyBySku[sku.id]; %><div class="pd-fact"><% if(variantTotal>1){ %><strong><%= sku.variant_label||sku.code %></strong><% } %><% if(line?.policies?.length){for(const p of line.policies){ %><p><%= p.locationName %>: reorder at <%= p.reorderPoint %><%= p.targetStock===null?'':', up to '+p.targetStock %>.</p><% } }else{ %><p>No reorder level set.</p><% } %><a href="/purchasing/why/<%= sku.id %>">Review buying recommendation →</a></div><% } %></section>
  <section class="sc-business-card"><header><h2>Product details</h2><button class="btn btn--sm" type="button" data-modal-open="modal-edit">Edit details</button></header><p class="pd-note"><%= item.description||'No description added.' %></p><dl class="pd-facts"><dt>Item code</dt><dd class="mono"><%= item.base_code||first.code %></dd><dt>Counted in</dt><dd><%= item.unit_label %></dd><dt>Tracked by</dt><dd><%= helpers.trackingLabel(mode) %></dd></dl><% if(single){ %><div class="pd-barcode"><%- include('variant-maintenance',{sku:first}) %></div><% } %></section>
  <% if(locals.kitDefinitions){ %><%- include('kit-controls') %><% } %>
</aside>
</div>
<dialog class="modal" id="product-photo"><form method="post" action="<%= base %>/photo" enctype="multipart/form-data"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><div class="modal-head"><h2>Product photo</h2><button class="btn" type="button" data-modal-close>Close</button></div><div class="modal-body"><label class="field">PNG or JPEG, up to 4 MB<input class="input" type="file" name="photo" accept="image/png,image/jpeg" required></label></div><div class="modal-foot"><button class="btn btn--primary" type="submit">Save photo</button></div></form></dialog>
