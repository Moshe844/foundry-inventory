<% const v=productView,first=skus[0],single=variantTotal===1,price=single&&first.sellingPrice?.isSet?first.sellingPrice:null,cost=single?first.purchaseCost:null,currency=price?.currency||cost?.currency||'USD',low=v.low,runout=v.issueRate>0?Math.max(0,Math.floor(available/v.issueRate)):null,reorder=single?'/purchasing/why/'+first.id:'/purchasing/setup'; %>
<a class="back-link" href="/inventory">‹ Stock</a><section class="sc-product-header sc-business-card" <%- single?'id="sku-'+first.id+'"':'' %>><div class="sc-product-identity"><button type="button" class="sc-product-photo" data-modal-open="product-photo" aria-label="Change product photo"><% if(v.photo){ %><img src="/inventory/<%= item.id %>/photo?v=<%= v.photo.content_hash %>" alt="<%= item.name %>"><% }else{ %><%- helpers.icon('inventory',{size:40}) %><small>Add photo</small><% } %></button><div><h1><%= item.name %> <% if(low){ %><span class="badge badge--warn">Low · reorder soon</span><% } %><% if(!item.is_active){ %><span class="badge">Archived</span><% } %></h1><p><span class="mono"><%= item.base_code||first.code %></span> · <%= item.unit_label %><%= variantTotal>1?' · '+variantTotal+' variants':'' %></p><div class="sc-product-prices"><span>Sells for <strong><%= price?price.formatted:single?'Not set':'Varies by variant' %></strong></span><span>Purchase cost <strong><%= cost?cost.formatted:single?'Not set':'Varies by variant' %></strong></span><span>Profit per unit <strong><%= price&&cost&&price.currency===cost.currency?helpers.money(price.amount_minor-cost.amount_minor,currency):'Needs price and cost' %></strong></span></div><% if(price&&cost){ %><small class="sc-business-note">Quoted unit margin; actual sales profit uses the recorded stock cost.</small><% } %></div></div><div class="sc-product-actions"><a class="btn btn--primary" href="<%= reorder %>">Reorder</a><button class="btn" type="button" data-modal-open="modal-adjust" <%= !canAct?'disabled':'' %>>Adjust stock</button><details class="sc-product-more"><summary class="btn" aria-label="More product actions">⋯</summary><div><button class="btn" type="button" data-modal-open="modal-edit">Edit details</button><% if(canAct){ %><button class="btn" type="button" data-modal-open="modal-receive">Some came in</button><button class="btn" type="button" data-modal-open="modal-issue">Sold or used</button><button class="btn" type="button" data-modal-open="modal-transfer" <%= locations.length<2?'disabled':'' %>>Move stock</button><% } %><a class="btn" href="/inventory/<%= item.id %>/duplicate">Duplicate product</a><a class="btn" href="/warehouse/labels/sku/<%= first.id %>">Print barcode label</a><a class="btn" href="/ask?from=<%= encodeURIComponent('/inventory/'+item.id) %>&amp;recordType=product&amp;recordId=<%= item.id %>">Ask about this product</a><% if(currentUser.role==='owner'){ %><form method="post" action="/inventory/<%= item.id %>/archive"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><% if(!item.is_active){ %><input type="hidden" name="restore" value="1"><% } %><button class="btn" type="submit"><%= item.is_active?'Archive':'Restore' %></button></form><% } %></div></details></div><div class="sc-product-stats"><div><span>On hand</span><strong><%= helpers.qty(total) %></strong><small>all locations</small></div><div><span>Available</span><strong><%= helpers.qty(available) %></strong><small><%= helpers.qty(committed) %> committed to orders</small></div><div><span>Incoming</span><strong><%= helpers.qty(onOrder) %></strong><small>on purchase orders</small></div><div><span>Runs out in</span><strong><%= runout===null?'Not enough history':runout+' days' %></strong><small><%= runout===null?'No recent issues to estimate demand':'At the last 30-day issue rate' %></small></div></div></section>
<% const uncostedShown=skus.reduce((n,s)=>n+Number(s.stockCost?.missingUnits||0),0);if(uncostedShown){ %><div class="notice" data-product-cost-hold><strong><%= uncostedShown %> <%= uncostedShown===1?'unit needs':'units need' %> actual stock cost.</strong> Record their cost before selling those units.<%= variantPageCount>1?' This covers the variants shown on this page.':'' %> <% if(locals.canEstablishCost){ %><a href="/inventory/<%= item.id %>/costs">Record actual stock cost →</a><% } %></div><% } %>
<nav class="sc-section-tabs" aria-label="Product tabs"><% for(const [key,label]of [['overview','Overview'],['history','History'],['orders','Orders'],['suppliers','Suppliers & costs']]){ %><a href="/inventory/<%= item.id %>?tab=<%= key %>" aria-current="<%= v.tab===key?'page':'false' %>"><%= label %></a><% } %></nav>
<% if(v.tab==='overview'){const high=Math.max(1,...v.sales.map(r=>Math.abs(r.revenue_minor))); %><div class="sc-business-two"><section class="sc-business-card"><header><h2>Sales</h2><div><a href="/inventory/<%= item.id %>?days=30">30 days</a> · <a href="/inventory/<%= item.id %>?days=90">90 days</a></div></header><p><%= helpers.money(v.sales.reduce((n,r)=>n+r.revenue_minor,0),currency) %> recorded net sales · last <%= v.days %> days</p><% if(v.sales.length){ %><div class="sc-report-bars"><% for(const r of v.sales){ %><div><span><%= helpers.shortDate(r.posting_date) %></span><i style="width:<%= Math.abs(r.revenue_minor)/high*100 %>%"></i><strong><%= helpers.money(r.revenue_minor,currency) %></strong></div><% } %></div><% }else{ %><p class="sc-empty">No sales recorded in this period.</p><% } %></section><section class="sc-business-card"><h2>Where it is</h2><% for(const l of locationTotals){ %><div class="sc-party-row"><strong><%= l.name||l.locationName||l.location_name %></strong><span><%= helpers.qty(l.total) %></span></div><% } %><p><a href="/transfers/new">Move stock between locations →</a></p></section></div>
<section class="sc-business-card"><header><h2>Reordering</h2><a href="<%= reorder %>">Change reorder settings →</a></header><div class="sc-product-variants"><% for(const sku of skus){const line=policyBySku[sku.id]; %><article><strong><%= sku.variant_label||item.name %></strong><small><%= sku.code %></small><% if(line?.policies?.length){for(const p of line.policies){const projected=Number(sku.available)+Number(sku.onOrder||0); %><p><%= p.locationName %>: reorder at <%= p.reorderPoint %><%= p.targetStock===null?'':', up to '+p.targetStock %>.</p><% } }else{ %><p>No reorder level set.</p><% } %><a href="/purchasing/why/<%= sku.id %>">Review buying recommendation →</a></article><% } %></div></section>
<% if(locals.importedDetails?.length){ %><section class="sc-business-card"><h2>Imported details</h2><dl><% for(const fact of importedDetails){ %><dt><strong><%= fact.name %></strong> · <%= fact.code %></dt><dd><%= fact.value %> · <a href="/imports/<%= fact.source_import_id %>">Source row <%= fact.source_row %></a></dd><% } %></dl></section><% } %><% if(mode==='serial'){ %><section class="sc-business-card"><h2>Serial units</h2><div class="sc-product-variants"><% for(const unit of units){ %><article id="unit-<%= unit.id %>"><strong><%= unit.serial %></strong><span><%= unit.variant_label||item.name %></span><small><%= unit.location_name||'No location' %> · <%= helpers.conditionLabel(unit.condition) %> · <%= unit.status.replaceAll('_',' ') %></small><a href="/warehouse/labels/serial/<%= unit.id %>">Print serial label</a></article><% } %></div><% if(!units.length){ %><p class="sc-empty">No serial units received yet.</p><% } %></section><% } %>
<% if(mode==='lot'){ %><section class="sc-business-card"><h2>Lots and batches</h2><div class="sc-product-variants"><% for(const lot of lots){ %><article id="lot-<%= lot.id %>"><strong><%= lot.code %></strong><span><%= helpers.qty(lot.total) %> on hand</span><small><%= lot.expires_at?'Expires '+helpers.shortDate(lot.expires_at):'No expiry recorded' %></small><% for(const p of lot.perLocation||[]){ %><small><%= p.location_name %>: <%= helpers.qty(p.quantity) %></small><% } %><a href="/warehouse/labels/lot/<%= lot.id %>">Print lot label</a></article><% } %></div><% if(!lots.length){ %><p class="sc-empty">No lots received yet.</p><% } %></section><% } %>
<section class="sc-business-card"><h2>Product details</h2><p><%= item.description||'No description added.' %></p><p>Item code: <%= item.base_code||first.code %> · Counted in <%= item.unit_label %> · <%= helpers.trackingLabel(mode) %></p><button class="btn" type="button" data-modal-open="modal-edit">Edit details</button></section>
<% if(variantTotal>1){ %><section class="sc-business-card"><h2>Variants</h2><div class="sc-product-variants"><% for(const sku of skus){ %><article id="sku-<%= sku.id %>"><strong><%= sku.variant_label||sku.code %></strong><small><%= sku.code %></small><p><%= helpers.qty(sku.total) %> on hand · <%= helpers.qty(sku.available) %> available</p><p><%= sku.sellingPrice.formatted %></p><a href="/pricing/new?skuId=<%= sku.id %>">Change selling price</a><a href="/purchasing/why/<%= sku.id %>">Reorder settings</a></article><% } %></div><% if(variantPageCount>1){ %><p>Page <%= variantPage %> of <%= variantPageCount %> <% if(variantPage>1){ %><a href="/inventory/<%= item.id %>?page=<%= variantPage-1 %>">Previous</a><% } %> <% if(variantPage<variantPageCount){ %><a href="/inventory/<%= item.id %>?page=<%= variantPage+1 %>">Next</a><% } %></p><% } %></section><% } %>
<% }else if(v.tab==='history'){ %><section class="sc-business-card"><h2>Stock history</h2><p>Stock after is the balance of that SKU at that location.</p><div class="sc-record-list"><% if(!v.history.length){ %><p class="sc-empty">No stock movements recorded.</p><% }for(const r of v.history){ %><article><div><strong><%= helpers.operationLabel(r.operation) %> <%= Math.abs(Number(r.quantity_delta)) %> × <%= r.code %></strong><time><%= helpers.dateTime(r.occurred_at) %></time><small><%= r.reference||'No reference' %></small></div><div><strong><%= r.location_name %></strong><small>Stock after: <%= helpers.qty(r.balance_after) %></small></div><strong><%= Number(r.quantity_delta)>0?'+':'' %><%= helpers.qty(r.quantity_delta) %></strong></article><% } %></div><% if(v.historyHasMore){ %><p>Showing the latest 100 movement groups. <a href="/reports/business/movement">Open inventory movement report</a> for more.</p><% } %></section>
<% }else if(v.tab==='orders'){ %><% for(const side of [{title:'Customer orders',rows:v.orders,sales:true},{title:'Purchase orders',rows:v.purchases,sales:false}]){ %><section class="sc-business-card"><h2><%= side.title %></h2><% if(!side.rows.length){ %><p class="sc-empty">No orders recorded for this product.</p><% }for(const r of side.rows){ %><a class="sc-party-row" href="<%= side.sales?'/orders/':'/purchasing/orders/' %><%= r.id %>"><span><strong><%= r.order_number||r.po_number %></strong><small><%= r.customer||r.supplier %></small></span><span><%= r.status.replaceAll('_',' ').toLowerCase() %></span></a><% } %></section><% } %>
<% }else{ %><section class="sc-business-card"><header><h2>Suppliers & costs</h2><a href="/suppliers/for/<%= first.id %>">Manage supplier links</a></header><% if(!v.suppliers.length){ %><p class="sc-empty">No supplier linked. <a href="/suppliers/for/<%= first.id %>">Link a supplier</a>.</p><% } %><div class="sc-record-list"><% for(const s of v.suppliers){ %><article><div><a href="/suppliers/<%= s.supplier_id %>"><strong><%= s.supplier_name %></strong></a><small><%= s.code %> · <%= s.supplier_sku||'No supplier code' %></small></div><div><strong><%= s.costLabel %></strong><small><%= s.effective_lead==null?'Lead time not recorded':s.effective_lead+' days lead time' %></small></div><a class="btn" href="/purchasing/why/<%= s.sku_id %>">Reorder</a></article><% } %></div></section><section class="sc-business-card"><h2>Prices and actual stock cost</h2><div class="sc-product-variants"><% for(const sku of skus){ %><article><strong><%= sku.code %></strong><p>Selling price <%= sku.sellingPrice.formatted %></p><a href="/pricing/new?skuId=<%= sku.id %>">Change selling price</a><p>Purchase cost <%= sku.purchaseCost?.formatted||'Not set' %></p><a href="/pricing/purchase-costs/new?skuId=<%= sku.id %>">Change purchase cost</a><% if(sku.stockCost?.missingUnits){ %><p class="is-warn"><%= sku.stockCost.missingUnits %> units need actual stock cost.</p><% if(locals.canEstablishCost){ %><a href="/inventory/<%= item.id %>/costs">Record actual stock cost</a><% } %><% }else if(sku.stockCost){ %><p>Actual stock value: <%= helpers.money(sku.stockCost.totalCostMinor,sku.stockCost.currency) %></p><% } %></article><% } %></div></section><% } %>
<dialog class="modal" id="product-photo"><form method="post" action="/inventory/<%= item.id %>/photo" enctype="multipart/form-data"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><div class="modal-head"><h2>Product photo</h2><button class="btn" type="button" data-modal-close>Close</button></div><div class="modal-body"><label class="field">PNG or JPEG, up to 4 MB<input class="input" type="file" name="photo" accept="image/png,image/jpeg" required></label></div><div class="modal-foot"><button class="btn btn--primary" type="submit">Save photo</button></div></form></dialog>
