<h1>Change reorder levels</h1><section class="card card-body"><p>Set levels for every active variant of the selected products. Review the exact list before approval.</p><form method="post" action="/inventory/bulk/reorder"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><% for(const item of items){ %><input type="hidden" name="itemIds" value="<%= item.id %>"><p><%= item.name %></p><% } %><label class="field"><span>Warehouse</span><select class="select" name="locationId"><option value="">All locations (default policy)</option><% for(const location of locations){ %><option value="<%= location.id %>"><%= location.name %></option><% } %></select></label><label class="field"><span>Reorder point</span><input class="input" name="reorderPoint" inputmode="decimal" required></label><label class="field"><span>Target stock (leave blank to keep current targets)</span><input class="input" name="targetStock" inputmode="decimal"></label><button class="btn btn--primary" type="submit">Review exact changes</button></form></section>