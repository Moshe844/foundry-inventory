<%
  /*
   * What you hold, as a position rather than a list.
   *
   * The page this replaced opened with a paginated table of every product,
   * twenty-five at a time, sorted by name — which answers "what is in the
   * database" and not "is my stock all right". Sixty-one products that are
   * fine do not need sixty-one rows.
   *
   * Groups are ordered by how much thought each one needs, and every one
   * carries what StockChief has already done about it. The table is one link at
   * the bottom, where somebody who actually wants a table will look for it.
   */
  var totals = position.totals || {};
  var value = locals.stockValue;
  var knownCostUnits = value ? Number(value.totalUnits || 0) : 0;
  var missingCostUnits = value && value.missingCostUnits != null ? Number(value.missingCostUnits) : Math.max(0, Number(totals.onHand || 0) - knownCostUnits);
  var missingCostShown = value && value.missingCostUnits != null ? helpers.missingCost(value) : helpers.unitCount(missingCostUnits, 'unit');
%>


<header class="sc-business-head"><div><h1><%= typeof title!=='undefined'?title:'Stock overview' %></h1><p><%= helpers.qty(totals.locations) %> location<%= totals.locations === 1 ? '' : 's' %> · <%= helpers.qty(totals.skus) %> <%= typeof postgresNative!=='undefined'&&postgresNative?'SKU':'product' %><%= totals.skus === 1 ? '' : 's' %> tracked</p></div><% if (!position.tooLarge && position.groups.length) { %><div class="sc-row-actions"><a class="btn" href="/actions">Record stock activity</a><a class="btn" href="/inventory/table">Open the stock table</a><a class="btn btn--primary" href="/inventory/new">Add a product</a></div><% } %></header>
<% if (position.productNames && position.productNames.length) { %><p class="sr-only">Products in this inventory: <%= position.productNames.join(', ') %>.</p><% } %>

<% if (position.tooLarge) { %>

  <section class="sc-business-card">
    <h2>This inventory is too big to summarise on sight.</h2>
    <p>Reading every position to group them would make this the page you stop opening. <%= helpers.qty(totals.products) %> products are past that line, so here is the table instead, which is what you would want at this size anyway.</p>
    <p><a class="btn btn--primary" href="/inventory/table">Open the stock table</a></p>
  </section>

<% } else if (!position.groups.length) { %>

  <section class="sc-business-card">
    <h2>There is nothing here yet.</h2>
    <p>Once StockChief knows what you hold, this is where it tells you whether it is all right.</p>
    <p class="rm-choices">
      <a class="rm-btn" href="/ask"><%- helpers.icon('spark', { size: 15 }) %> Tell StockChief what you sell</a>
      <a class="rm-btn rm-btn--ghost" href="/inventory/new"><%- helpers.icon('plus', { size: 15 }) %> Add one manually</a>
      <a class="rm-btn rm-btn--ghost" href="/imports">Import existing inventory</a>
      <a class="rm-btn rm-btn--ghost" href="/settings/connections">Connect a business system</a>
    </p>
  </section>

<% } else { %>

  <div class="sc-tiles">
    <a class="sc-tile" href="/inventory/table" data-tone="stock"><span>On hand</span><strong data-count-up><%= helpers.unitCount(helpers.qty(totals.onHand),'unit') %></strong><small>Across every location<% if (totals.measured && totals.measured.length) { %>, plus <%= helpers.measuredStock(totals.measured) %><% } %></small><i class="sc-mark" aria-hidden="true"><%- helpers.icon('layers',{size:16}) %></i></a>
    <a class="sc-tile" href="/accounting#inventory" data-tone="<%= missingCostUnits > 0 ? 'important' : 'ok' %>"><span>Known cost</span><strong class="<%= missingCostUnits > 0 ? 'is-important' : '' %>" data-count-up><%= value && value.totalCostMinor ? '$' + Math.round(value.totalCostMinor / 100).toLocaleString('en-US') : 'Not recorded' %></strong><small class="<%= missingCostUnits > 0 ? '' : 'is-go' %>"><%= missingCostUnits > 0 ? missingCostShown + ' still need a cost' : 'Every unit has a cost' %></small><i class="sc-mark" aria-hidden="true"><%- helpers.icon('wallet',{size:16}) %></i></a>
    <a class="sc-tile" href="/orders?status=open" data-tone="<%= totals.committed ? 'normal' : 'quiet' %>"><span>Promised to customers</span><strong data-count-up><%= helpers.unitCount((totals.committed || 0).toLocaleString('en-US'),'unit') %></strong><small><%= totals.committed ? 'Already sold, not yet shipped' : 'Nothing is promised to a customer' %></small><% if (totals.committed && totals.onHand) { %><i class="hm-meter" aria-hidden="true" title="Share of the units on hand"><b style="width:<%= helpers.barWidth(totals.committed, totals.onHand) %>"></b></i><% } %><i class="sc-mark" aria-hidden="true"><%- helpers.icon('sales',{size:16}) %></i></a>
    <a class="sc-tile" href="/inventory/table?group=incoming" data-tone="<%= totals.incoming ? 'ok' : 'quiet' %>"><span>On the way</span><strong data-count-up><%= helpers.unitCount((totals.incoming || 0).toLocaleString('en-US'),'unit') %></strong><small>From purchase orders</small><i class="sc-mark" aria-hidden="true"><%- helpers.icon('arrive',{size:16}) %></i></a>
  </div>

  <% if (missingCostUnits > 0) { %>
    <p class="sc-stock-notice"><%= typeof postgresNative!=='undefined'&&postgresNative?'Actual stock cost':'Purchase cost' %> is missing for <strong><%= missingCostShown %></strong><% if(value && value.totalCostMinor){ %>, so <%= '$' + Math.round(value.totalCostMinor / 100).toLocaleString('en-US') %> is not the full inventory value<% } %>. <% if(typeof postgresNative!=='undefined'&&postgresNative){ %><a href="/inventory/table">Open a product to record stock cost.</a><% }else{ %><a href="/accounting#inventory">Show the units and recorded cost.</a><% } %></p>
  <% } %>

  <section class="sc-business-card sc-stock-groups"><h2>Where your products stand</h2>
    <div class="rm-groups">
    <% position.groups.forEach(function (group) { %>
      <%
        /* The bar is this group's share of the products counted, on one scale
           across every row, so the shape of the inventory reads at a glance. */
        var share = helpers.barWidth(group.count, totals.products);
      %>
      <a class="rm-group" href="<%= group.href %>">
        <span class="rm-group__body">
          <span class="rm-group__n"><%= group.name %></span>
          <span class="rm-group__d"><%= group.detail %></span>
        </span>
        <span class="sc-group-count"><strong><%= group.count.toLocaleString('en-US') %></strong><span class="rm-meter <%= group.tone === 'hot' ? 'is-flag' : group.tone === 'ok' ? 'is-good' : 'is-quiet' %>"><span style="width:<%= share %>"></span></span></span>
      </a>
    <% }) %>
    </div>
  </section>

<% } %>

<p class="rm-disclose">
  <a href="/ask?from=%2Finventory">Ask about your stock</a>
  <a href="/planning">What happens next</a>
  <a href="/purchasing/orders">What is on order</a>
  <a href="/locations">Your locations</a>
  <a href="/inventory/table?archived=only">Archived products</a>
  <% if(typeof postgresNative!=='undefined'&&postgresNative){ %><a href="/imports">File imports and results</a><a href="/manufacturing">Manufacturing and material planning</a><a href="/custody">Rentals and consignment</a><% } %>
</p>
