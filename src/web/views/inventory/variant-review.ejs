<a href="/inventory/<%= review.item_id %>#variant-editor">Back to product</a><h1>Review variant changes</h1><p><%= review.status==='COMPLETED'?'All approved changes are complete.':'One approval applies every listed change together.' %></p>
<div class="table-scroll"><table class="table"><thead><tr><th>Variant</th><th>Field</th><th>Current value</th><th>New value</th></tr></thead><tbody>
<% for(const change of review.payload.changes){const before=reviewValues(change,false),after=reviewValues(change,true);for(const label of Object.keys(after)){ %><tr><td><%= change.label %> · <%= change.code %></td><td><%= label %></td><td><%= before[label] %></td><td><%= after[label] %></td></tr><% }} %>
</tbody></table></div><% if(review.status==='PENDING'){ %><form method="post" action="/inventory/variant-reviews/<%= review.id %>/approve"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="integrityHash" value="<%= review.integrity_hash %>"><button class="btn btn--primary">Approve all variant changes</button></form><% } %>
