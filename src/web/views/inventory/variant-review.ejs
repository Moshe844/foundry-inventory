<a href="/inventory/<%= review.item_id %>#variant-editor">Back to product</a><h1>Review variant changes</h1><p><%= review.status==='COMPLETED'?'All approved changes are complete.':'One approval applies every listed change together.' %></p><div class="table-scroll"><table class="table"><thead><tr><th>Variant</th><th>Field</th><th>Current value</th><th>New value</th></tr></thead><tbody><% for(const change of review.payload.changes){for(const [field,value] of Object.entries(change.after)){const labels={code:'SKU',barcode:'Barcode',price:'Selling price',cost:'Purchase cost',reorder:'Reorder point',supplier:'Supplier'}; %><tr><td><%= change.label %> · <%= change.code %></td><td><%= labels[field]||field %></td><td><%= ['price','cost'].includes(field)?(change.before[field]?.amount_minor==null?'Not set':helpers.money(Number(change.before[field].amount_minor),change.before[field].currency)):field==='reorder'?(change.before.policies.find(p=>p.location_id===(value.locationId||null))?.reorder_point??'Not set'):field==='supplier'?(change.before.suppliers.find(s=>Number(s.is_active)&&Number(s.is_preferred))?.supplier_name||'Not linked'):(change.before[field]||'Not set') %></td><td><%= ['price','cost'].includes(field)?helpers.money(value.amountMinor,value.currency):field==='reorder'?value.reorderPoint:field==='supplier'?value.name+(value.lastUnitCost===undefined?'':' · '+helpers.moneyDecimal(value.lastUnitCost,value.currency)):value %></td></tr><% }} %></tbody></table></div><% if(review.status==='PENDING'){ %><form method="post" action="/inventory/variant-reviews/<%= review.id %>/approve"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="integrityHash" value="<%= review.integrity_hash %>"><button class="btn btn--primary">Approve all variant changes</button></form><% } %>
