<div class="page-head">
  <div class="titles">
    <% if (returnTo) { %><a class="back-link" href="<%= returnTo %>">← Back to <%= returnLabel %> message history</a><% } %>
    <h1><%= sourceLabel ? `Products from ${sourceLabel}` : filters.archivedOnly ? 'Archived products' : 'Inventory' %></h1>
    <div class="page-sub"><%= sourceLabel ? 'The exact original product records from this import, whether active or archived.' : filters.archivedOnly ? 'Products kept for history but not currently active.' : 'Everything you track, and how much of it you have.' %></div>
  </div>
  <div class="page-actions">
      <%# Purchasing is how stock arrives, so it belongs to Inventory rather
          than to a department of its own in the sidebar. %>
      <a class="btn" href="/purchasing"><%- helpers.icon('purchasing', { size: 15 }) %> Ordering and suppliers</a>
      <a class="btn" href="/planning">What happens next</a>
    <a class="btn btn--primary" href="/inventory/new"><%- helpers.icon('plus', { size: 16 }) %> Add item</a>
  </div>
</div>

<form class="filters" method="get" action="/inventory">
  <input class="input filter-search" type="search" name="q" value="<%= filters.q %>" placeholder="Search items, SKUs, serials, lots" aria-label="Search inventory">
  <select class="select" name="tracking" aria-label="Tracking type" data-auto-submit>
    <option value="">All tracking types</option>
    <% Object.values(helpers.TRACKING_MODES).forEach(function (mode) { %>
      <option value="<%= mode.id %>" <%= filters.trackingMode === mode.id ? 'selected' : '' %>><%= mode.label %></option>
    <% }) %>
  </select>
  <select class="select" name="location" aria-label="Location" data-auto-submit>
    <option value="">All locations</option>
    <% locations.forEach(function (location) { %>
      <option value="<%= location.id %>" <%= filters.locationId === location.id ? 'selected' : '' %>><%= location.name %></option>
    <% }) %>
  </select>
  <select class="select" name="sort" aria-label="Sort" data-auto-submit>
    <option value="name" <%= filters.sort === 'name' ? 'selected' : '' %>>Name A–Z</option>
    <option value="stock_desc" <%= filters.sort === 'stock_desc' ? 'selected' : '' %>>Most stock</option>
    <option value="stock_asc" <%= filters.sort === 'stock_asc' ? 'selected' : '' %>>Least stock</option>
    <option value="newest" <%= filters.sort === 'newest' ? 'selected' : '' %>>Newest</option>
  </select>
  <% if (filters.includeArchived) { %><input type="hidden" name="archived" value="<%= filters.archivedOnly ? 'only' : '1' %>"><% } %>
  <% if (fromConnection) { %><input type="hidden" name="fromConnection" value="<%= fromConnection %>"><% } %>
  <% if (fromMessage) { %><input type="hidden" name="fromMessage" value="<%= fromMessage %>"><% } %>
  <% if (sourceDocument) { %><input type="hidden" name="sourceDocument" value="<%= sourceDocument %>"><% } %>
  <button class="btn btn--sm" type="submit">Apply</button>
  <% if (filters.q || filters.trackingMode || filters.locationId) { %>
    <a class="btn btn--ghost btn--sm" href="/inventory<%= helpers.queryString({}, { archived: filters.archivedOnly ? 'only' : null, sourceDocument: sourceDocument, fromConnection: fromConnection, fromMessage: fromMessage }) %>">Clear</a>
  <% } %>
</form>

<div class="card">
  <% if (items.length === 0) { %>
    <div class="empty">
      <div class="icon-wrap"><%- helpers.icon('empty', { size: 22 }) %></div>
      <% if (filters.q || filters.trackingMode || filters.locationId) { %>
        <h3>Nothing matches those filters</h3>
        <p>Try a different search term, or clear the filters to see everything you track.</p>
        <a class="btn" href="/inventory">Clear filters</a>
      <% } else { %>
        <% if (filters.archivedOnly) { %>
          <h3>No archived products</h3><p>None of this inventory’s products are currently archived.</p><% if (returnTo) { %><a class="btn btn--primary" href="<%= returnTo %>">Back to <%= returnLabel %> message history</a><% } %>
        <% } else { %>
          <h3>Your setup is ready. Now add your products.</h3>
          <p>StockChief knows how this inventory should work, but no product or stock records have been added yet.</p>
          <a class="btn btn--primary" href="/inventory/describe"><%- helpers.icon('spark', { size: 15 }) %> Tell StockChief what you sell</a>
          <a class="btn" href="/inventory/new">Add one manually</a>
          <p class="hint">Already have records? <a href="/onboarding/migrations/new">Import a file</a>, <a href="/onboarding/system">connect a business system</a>, or <a href="/onboarding/mailbox">use email attachments</a>.</p>
        <% } %>
      <% } %>
    </div>
  <% } else { %>
    <div class="table-wrap">
      <table class="table table--stack">
        <%
          /*
           * The columns are the ones a decision is made from.
           *
           * "Tracking" — quantity, serial or lot — was a column of its own with
           * a badge on every row, which is StockChief's internal model shown to
           * somebody who only wants to know what they have. It matters when a
           * product carries serials or lots, so it appears on those rows and is
           * silent on the rest.
           *
           * What was missing mattered more: how much is free to sell, and how
           * much is already coming. Someone reading "19 on hand" had no way to
           * tell whether all nineteen were already promised.
           */
        %>
        <thead>
          <tr>
            <th>Product</th>
            <th>Status</th>
            <th class="num"><%= filters.locationId ? 'At location' : 'On hand' %></th>
            <th class="num">Committed</th>
            <th class="num">Available</th>
            <th class="num">On order</th>
          </tr>
        </thead>
        <tbody>
          <% items.forEach(function (item) { %>
            <%
              /*
                One status word per row. Zero on hand is not one situation but
                three, and only one of them is bad news: a product can have run
                out, or have an order on the way, or simply never have been
                stocked at all. Saying "Out of stock" in red to all three made
                a correctly-imported proforma look like a catastrophe.
              */
              var status = !item.is_active ? { label: 'Archived', tone: 'muted' }
                : item.on_hand > 0 && item.available === 0 ? { label: 'All committed', tone: 'warn' }
                : item.on_hand > 0 ? { label: 'In stock', tone: 'ok' }
                : item.onOrder > 0 ? { label: 'On the way', tone: 'muted' }
                : item.hasHistory === false ? { label: 'None yet', tone: 'muted' }
                : { label: 'Out of stock', tone: 'danger' };
              var tracking = helpers.TRACKING_MODES[item.tracking_mode];
              var tracksUnits = item.tracking_mode !== 'quantity';
            %>
            <tr>
              <td class="cell-main">
                <a class="cell-title" href="/inventory/<%= item.id %>"><%= item.name %></a>
                <span class="cell-sub">
                  <span class="mono"><%= item.base_code || item.first_sku_code %></span><%
                    %><% if (item.has_variants && item.sku_count > 1) { %> · <%= item.sku_count %> variants<% } %><%
                    %><% if (tracksUnits) { %> · <%= tracking.label %><% } %>
                </span>
              </td>
              <td data-label="Status">
                <span class="badge badge--<%= status.tone %>"><%= status.label %></span>
              </td>
              <td class="num" data-label="On hand"><strong><%= helpers.qty(item.on_hand) %></strong></td>
              <td class="num t-muted" data-label="Committed"><%= item.committed ? helpers.qty(item.committed) : '—' %></td>
              <td class="num" data-label="Available"><%= helpers.qty(item.available) %></td>
              <td class="num cell-end" data-label="On order">
                <% if (item.onOrder) { %>
                  <%= helpers.qty(item.onOrder) %>
                <% } else if (item.on_hand === 0) { %>
                  <%# Nothing here and nothing coming is the commonest state right
                      after setup, and a dash is a dead end. Say what changes it. %>
                  <a class="t-xs" href="/inventory/<%= item.id %>#modal-receive">Receive stock</a>
                <% } else { %>
                  <span class="t-muted">—</span>
                <% } %>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
    <% if (page > 1 || hasMore) { %>
      <div class="card-foot" style="display:flex; gap:8px; align-items:center;">
        <span class="muted">Page <%= page %></span>
        <span class="spacer" style="margin-left:auto;"></span>
        <% if (page > 1) { %>
          <a class="btn btn--sm" href="/inventory<%= helpers.queryString(query, { page: page - 1 }) %>">Previous</a>
        <% } %>
        <% if (hasMore) { %>
          <a class="btn btn--sm" href="/inventory<%= helpers.queryString(query, { page: page + 1 }) %>">Next</a>
        <% } %>
      </div>
    <% } %>
  <% } %>
</div>
