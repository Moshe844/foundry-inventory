<% /* The SQLite reference engine supplies stock, prices and forecasts directly.
      Keep its supported actions usable without inventing PostgreSQL-only facts. */ %>
<a class="back-link" href="/inventory">‹ Stock</a>
<section class="sc-business-card">
  <header><div><h1><%= item.name %><%= item.is_active?'':' · Archived' %></h1><p><%= item.base_code||skus[0]?.code %> · <%= item.unit_label %> · <%= helpers.trackingLabel(mode) %></p></div>
  <div class="sc-product-actions"><button class="btn" type="button" data-modal-open="modal-edit">Edit details</button>
  <% if(item.has_variants&&canOperate&&item.is_active){ %><button class="btn" type="button" data-modal-open="modal-variant">Add variant</button><% } %>
  <% if(canAct){ %><button class="btn btn--primary" type="button" data-modal-open="modal-receive">Some came in</button><button class="btn" type="button" data-modal-open="modal-issue">Sold or used</button><button class="btn" type="button" data-modal-open="modal-adjust">Adjust stock</button><button class="btn" type="button" data-modal-open="modal-transfer" <%= locations.length<2?'disabled':'' %>>Move stock</button><% } %>
  <% if(currentUser.role==='owner'){ %><form method="post" action="/inventory/<%= item.id %>/archive"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><% if(!item.is_active){ %><input type="hidden" name="restore" value="1"><% } %><button class="btn" type="submit"><%= item.is_active?'Archive':'Restore' %></button></form><% } %></div></header>
  <p><%= item.description %></p><div class="sc-product-stats"><div><span>On hand</span><strong><%= helpers.qty(total) %></strong></div><div><span>Available</span><strong><%= helpers.qty(available) %></strong><small><%= helpers.qty(committed) %> committed to orders</small></div><div><span>Incoming</span><strong><%= helpers.qty(onOrder) %></strong></div></div>
  <% if(variantTotal===1){const sku=skus[0],price=sku.sellingPrice,cost=sku.purchaseCost,line=policyBySku[sku.id]; %><p>Selling price <%= price.formatted %> · Purchase cost <%= cost?.formatted||'Not set' %><% for(const supplier of line?.suppliers||[]){ %> · <%= supplier.supplierName %><% } %></p><% if(price.isSet&&cost&&price.currency===cost.currency){const profit=price.amount_minor-cost.amount_minor; %><p>Profit per <%= item.unit_label %>: <%= helpers.money(profit,price.currency) %><% if(profit<0){ %> · Warning: sells <%= helpers.money(-profit,price.currency) %> below purchase cost.<% } %></p><% }} %>
</section>
<% if(findings.length){ %><section class="sc-business-card"><h2>What StockChief has noticed</h2><% for(const finding of findings){ %><%- include('../partials/attention-card',{item:finding,returnTo:'/inventory/'+item.id}) %><% } %><% if(findingTotal>findings.length){ %><a href="/attention?itemId=<%= item.id %>">Review all <%= findingTotal %> findings</a><% } %></section><% } %>
<section class="sc-business-card"><h2><%= item.has_variants?'Variants':'Prices and stock' %></h2><div class="table-scroll"><table class="table"><thead><tr><th>Variant / SKU</th><th>On hand</th><th>Committed</th><th>Available</th><th>On order</th><th>Selling price</th><th>Purchase cost</th><th>Where it is</th><th>Reordering</th></tr></thead><tbody>
<% for(const sku of skus){const line=policyBySku[sku.id]; %><tr id="sku-<%= sku.id %>"><td><strong><%= sku.variant_label||item.name %></strong><small><%= sku.code %></small></td><td><%= helpers.qty(sku.total) %></td><td><%= helpers.qty(sku.committed) %></td><td><%= helpers.qty(sku.available) %></td><td><%= helpers.qty(sku.onOrder) %></td><td><%= sku.sellingPrice.formatted %><% if(currentUser.role==='owner'){ %> <a href="/pricing/new?skuId=<%= sku.id %>">Change selling price</a><% } %></td><td><%= sku.purchaseCost?.formatted||'Not set' %><% if(currentUser.role==='owner'){ %> <a href="/pricing/purchase-costs/new?skuId=<%= sku.id %>">Change purchase cost</a><% } %></td><td><% for(const position of sku.perLocation){ %><p><%= position.locationName %>: <%= helpers.qty(position.onHand) %></p><% } %></td><td><% if(line?.policy){ %><p>Reorder point: <%= line.policy.reorderPoint??'Not set' %></p><% } %><a href="/purchasing/why/<%= sku.id %>">Review reordering</a> · <a href="/suppliers/for/<%= sku.id %>">Link a supplier</a></td></tr><% } %>
</tbody></table></div><% if(variantPageCount>1){ %><p>Page <%= variantPage %> of <%= variantPageCount %><% if(variantPage>1){ %> <a href="/inventory/<%= item.id %>?page=<%= variantPage-1 %>">Previous</a><% } %><% if(variantPage<variantPageCount){ %> <a href="/inventory/<%= item.id %>?page=<%= variantPage+1 %>">Next</a><% } %></p><% } %></section>
<section class="sc-business-card"><h2>Where it is</h2><% for(const location of locationTotals){ %><p><%= location.name||location.locationName||location.location_name %>: <%= helpers.qty(location.total) %></p><% } %></section>
<% if(outlook.length){ %><section class="sc-business-card"><h2>What happens next</h2><% for(const view of outlook){ %><article><h3><%= view.label %></h3><p><%= view.forecast?.confidenceLabel||'Still learning' %></p><% if(view.forecast?.dailyRate==null){ %><p>StockChief cannot estimate how fast this sells yet. Record normal sales and receipts to build demand history.</p><% }else{ %><p>Recent demand: <%= helpers.qty(view.forecast.dailyRate) %> per day.</p><% } %><a href="/planning">See how I worked this out</a><% if(canOperate){for(const decision of Object.values(view.decisions)){ %><form method="post" action="/planning/recommendations/<%= decision.id %>/accept"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="returnTo" value="/inventory/<%= item.id %>"><button class="btn" type="submit">Use <%= decision.recommended_value %></button></form><form method="post" action="/planning/recommendations/<%= decision.id %>/decline"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="returnTo" value="/inventory/<%= item.id %>"><button class="btn" type="submit">Keep <%= decision.current_value %></button></form><% }} %></article><% } %></section><% } %>
<% if(mode==='serial'){ %><section class="sc-business-card"><h2>Serial units</h2><% for(const unit of units){ %><p><strong><%= unit.serial %></strong> · <%= unit.status==='in_stock'?'In stock':unit.status.replaceAll('_',' ') %> · <%= unit.location_name||'No location' %></p><% } %></section><% } %>
<% if(mode==='lot'){ %><section class="sc-business-card"><h2>Lots and batches</h2><% for(const lot of lots){ %><p><strong><%= lot.code %></strong> · <%= helpers.qty(lot.total) %> on hand<%= lot.expires_at?' · Expires '+helpers.shortDate(lot.expires_at):'' %></p><% } %></section><% } %>
<section class="sc-business-card"><h2>Recent activity</h2><% if(!recent.length){ %><p>No stock activity yet.</p><% } %><% for(const movement of recent){ %><p><%= helpers.dateTime(movement.occurredAt) %> · <%= movement.sentence %> · <%= movement.reference||'' %></p><% } %></section>
