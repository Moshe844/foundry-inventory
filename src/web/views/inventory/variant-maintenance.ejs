<p><strong>Barcode:</strong> <%= sku.barcode||'Not set' %><% if(!sku.is_active){ %> · <span class="badge">Archived</span><% } %></p>
<% if(currentUser.role==='owner'){ %><details id="barcode-<%= sku.id %>"><summary>Edit barcode</summary><form method="post" action="/inventory/<%= item.id %>/variants/<%= sku.id %>/details"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="expectedBarcode" value="<%= sku.barcode||'' %>"><label class="field"><span>Barcode for <%= sku.variant_label||sku.code %></span><input class="input" name="barcode" value="<%= sku.barcode||'' %>" maxlength="240"></label><button class="btn" type="submit">Save barcode</button></form></details>
<% if(item.has_variants){ %><form method="post" action="/inventory/<%= item.id %>/variants/<%= sku.id %>/archive"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><% if(!sku.is_active){ %><input type="hidden" name="restore" value="1"><% } %><button class="btn" type="submit"><%= sku.is_active?'Archive variant':'Restore variant' %></button></form><% } %><% } %>
