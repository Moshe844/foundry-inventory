<% const size=options.find(o=>o.name.toLowerCase()==='size'),color=options.find(o=>['color','colour'].includes(o.name.toLowerCase()));if(size&&color){const sizes=[...new Set(skus.map(s=>s.optionValues?.[size.name]).filter(Boolean))],colors=[...new Set(skus.map(s=>s.optionValues?.[color.name]).filter(Boolean))]; %><details class="sc-business-card" open><summary>Size × color grid</summary><p>Stock for the variants on this page. A dash means that combination is not shown here.<%= variantPageCount>1?' Use the variant pages below to see more combinations.':'' %></p><div class="table-scroll"><table class="table"><thead><tr><th>Size / color</th><% for(const value of colors){ %><th><%= value %></th><% } %></tr></thead><tbody><% for(const value of sizes){ %><tr><th><%= value %></th><% for(const shade of colors){const cell=skus.filter(s=>s.optionValues?.[size.name]===value&&s.optionValues?.[color.name]===shade); %><td><% if(!cell.length){ %>—<% }else{for(const sku of cell){ %><a href="#sku-<%= sku.id %>"><%= helpers.qty(sku.total) %> on hand<%= sku.is_active?'':' · Archived' %></a><br><% }} %></td><% } %></tr><% } %></tbody></table></div></details><% } %>