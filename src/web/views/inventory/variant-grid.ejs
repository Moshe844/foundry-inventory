<% const axes=options.slice(0,2);if(axes.length===2){const [rowAxis,columnAxis]=axes,rows=[...new Set(skus.map(s=>s.optionValues?.[rowAxis.name]).filter(Boolean))],columns=[...new Set(skus.map(s=>s.optionValues?.[columnAxis.name]).filter(Boolean))]; %>
<details class="sc-business-card" open><summary><%= rowAxis.name %> × <%= columnAxis.name %> grid</summary><p>Stock for the variants on this page. A dash means that combination is not shown here.<%= variantPageCount>1?' Use the variant pages below to see more combinations.':'' %></p><div class="table-scroll"><table class="table"><thead><tr><th><%= rowAxis.name %> / <%= columnAxis.name %></th><% for(const value of columns){ %><th><%= value %></th><% } %></tr></thead><tbody><% for(const value of rows){ %><tr><th><%= value %></th><% for(const column of columns){const cell=skus.filter(s=>s.optionValues?.[rowAxis.name]===value&&s.optionValues?.[columnAxis.name]===column); %><td><% if(!cell.length){ %>—<% }else{for(const sku of cell){ %><a href="#sku-<%= sku.id %>"><%= options.length>2?sku.variant_label+' · ':'' %><%= helpers.qty(sku.total) %> on hand<%= sku.is_active?'':' · Archived' %></a><br><% }} %></td><% } %></tr><% } %></tbody></table></div></details><% } %>
