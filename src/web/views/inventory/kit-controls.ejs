<% if(currentUser.role==='owner'&&item.tracking_mode==='quantity'&&!item.secondary_unit_label&&Number(item.quantity_precision||0)===0){const access=locals.planGates?.['inventory.kits']; %>
<section class="sc-business-card"><h2>Kits and bundles<% if(!access?.enabled){ %> <span class="badge"><%= access?.tier||'Custom' %></span><% } %></h2>
<% for(const sku of skus){const stock=locals.kitAvailability?.[sku.id];if(stock){ %><p><strong><%= sku.variant_label||sku.code %>:</strong> <%= stock.buildable %> kits can be built from available, unexpired components.<% if(stock.reason){ %> <%= stock.reason %><% } %></p><% }} %>
<% if(access?.enabled){ %><p>Sell a kit and reduce each component variant's stock. Existing orders keep the recipe they accepted.</p><div class="sc-record-list"><% for(const sku of skus.filter(s=>s.is_active)){ %><a class="btn" href="/inventory/<%= item.id %>/kits/<%= sku.id %>"><%= kitDefinitions[sku.id]?.isKit?'Edit':'Set up' %> kit recipe · <%= sku.variant_label||sku.code %></a><% } %></div>
<% }else{ %><p>Available from <%= access?.tier||'Custom' %>.<%= access?.currentOfferIncludes?' Review your accepted plan terms to enable it.':'' %></p><a class="btn" href="<%= access?.currentOfferIncludes?'/billing/terms':'/upgrade?capability=inventory.kits' %>"><%= access?.currentOfferIncludes?'Review updated plan terms':'View '+(access?.tier||'Custom')+' plan' %></a><% } %></section><% } %>
