<div class="breadcrumb">
  <a href="/inventory">Inventory</a> <%- helpers.icon('chevron', { size: 13 }) %> <span>New item</span>
</div>

<div class="page-head">
  <div class="titles">
    <h1>Add an item</h1>
    <div class="page-sub">Tell StockChief what you keep track of, and how you count it.</div>
  </div>
</div>

<% if (typeof error !== 'undefined' && error) { %>
  <div class="flash flash--error" role="alert" style="margin-bottom:14px;"><%- helpers.icon('alert', { size: 18 }) %><span><%= error %></span></div>
<% } %>

<form method="post" action="/inventory" autocomplete="off">
  <input type="hidden" name="_csrf" value="<%= csrfToken %>">
  <% if (typeof resumeInstructionId !== 'undefined' && resumeInstructionId) { %>
    <input type="hidden" name="resumeInstructionId" value="<%= resumeInstructionId %>">
  <% } %>

  <div class="card measure">
    <div class="card-head"><h2>What are you tracking?</h2></div>
    <div class="card-body">
      <div class="field">
        <label class="label" for="name">Name</label>
        <input class="input" id="name" name="name" value="<%= form.name || '' %>" required autofocus placeholder="Copper Elbow 1/2 in.">
        <div class="hint">What your team calls it.</div>
      </div>
      <div class="field-row">
        <div class="field">
          <label class="label" for="baseCode">Item code <span class="optional">optional</span></label>
          <input class="input mono" id="baseCode" name="baseCode" value="<%= form.baseCode || '' %>" placeholder="CE-100">
          <div class="hint">Your SKU or part number. We will generate one if you leave this blank.</div>
        </div>
        <div class="field">
          <label class="label" for="unitLabel">Counted in <span class="optional">optional</span></label>
          <input class="input" id="unitLabel" name="unitLabel" value="<%= form.unitLabel || '' %>" placeholder="unit, box, metre">
          <p class="hint">Choose the unit you buy, stock and sell, such as kg, litre, metre or piece. Choose the allowed decimal places below. Unit settings stay fixed after stock or orders are recorded.</p>
          <div class="hint">How you say the quantity out loud.</div>
<label class="field"><span>Quantity decimal places</span><select name="quantityPrecision"><% for(let n=0;n<=6;n++){ %><option value="<%= n %>" <%= Number(form.quantityPrecision||0)===n?'selected':'' %>><%= n===0?'Whole units':n+' decimal places' %></option><% } %></select></label>
<label class="field"><span>Smallest stock increment (optional)</span><input name="quantityIncrement" inputmode="decimal" value="<%= form.quantityIncrement||'' %>" placeholder="For example 0.001 for grams when stocking kg"></label>
<details><summary>Count pieces and also record actual weight</summary><p>Use whole pieces above. Receipts, moves and sales will also require the actual measured weight. Selling and purchase prices are per weight unit.</p><label class="field"><span>Also weigh in (optional)</span><input name="secondaryUnitLabel" value="<%= form.secondaryUnitLabel||'' %>" placeholder="kg"></label><label class="field"><span>Weight decimal places</span><select name="secondaryPrecision"><% for(let n=0;n<=6;n++){ %><option value="<%= n %>" <%= Number(form.secondaryPrecision??3)===n?'selected':'' %>><%= n %></option><% } %></select></label></details>
        </div>
      </div>
      <div class="field">
        <label class="label" for="description">Description <span class="optional">optional</span></label>
        <textarea class="textarea" id="description" name="description" placeholder="Anything that helps staff recognise it."><%= form.description || '' %></textarea>
      </div>
    </div>
  </div>

  <div class="card section measure"><div class="card-head"><h2>Pricing and shipping specifications</h2></div><div class="card-body form-grid">
    <label class="field"><span>Selling price (<%= locals.currency||'USD' %>)</span><input name="sellingPrice" inputmode="decimal" value="<%= form.sellingPrice||'' %>"></label>
    <label class="field"><span>Purchase cost (<%= locals.currency||'USD' %>)</span><input name="purchaseCost" inputmode="decimal" value="<%= form.purchaseCost||'' %>"><small>Used for purchase orders and for any starting stock entered below.</small></label>
    <% [['weightGrams','Weight (g)'],['lengthMm','Length (mm)'],['widthMm','Width (mm)'],['heightMm','Height (mm)']].forEach(([name,label])=>{ %><label class="field"><span><%= label %></span><input type="number" min="1" max="1000000000" step="1" name="<%= name %>" value="<%= form[name]||'' %>"></label><% }) %>
  </div></div>
  <% if(locals.startingLocations){ %><section class="card section measure"><div class="card-head"><h2>Starting stock</h2></div><div class="card-body"><% if(!startingLocations.length){ %><p>Add a location first to enter starting stock. <a class="btn" href="/locations#add-location">Add a location</a></p><% }else{ %><label class="field"><span>Starting quantity (optional)</span><input name="startingQuantity" type="number" min="0" step="any" value="<%= form.startingQuantity||'' %>"></label><label class="field"><span>Starting actual weight (for pieces also weighed)</span><input name="startingSecondaryQuantity" inputmode="decimal" value="<%= form.startingSecondaryQuantity||'' %>"></label><label class="field"><span>Starting location</span><select name="startingLocationId"><% for(const l of startingLocations){ %><option value="<%= l.id %>" <%= form.startingLocationId===l.id?'selected':'' %>><%= l.name %></option><% } %></select></label><label class="field"><span>Starting cost per unit ($)</span><input name="startingCost" inputmode="decimal" value="<%= form.startingCost||'' %>"><small>Leave blank to use the purchase cost above. This is what you paid for the stock you already own.</small></label><details><summary>Batch or serial details</summary><label class="field"><span>Starting batch code (for lots)</span><input name="startingLotCode" value="<%= form.startingLotCode||'' %>"></label><label class="field"><span>Starting serial numbers (one per line)</span><textarea name="startingSerials"><%= form.startingSerials||'' %></textarea></label></details><p>For items with several variants, add stock for each variant after saving.</p><% } %></div></section><% } %><div class="card section reveal-host measure">
    <div class="card-head"><h2>How should StockChief track it?</h2></div>
    <div class="card-body">
      <div class="choice-grid">
        <label class="choice">
          <input type="radio" name="trackingMode" value="quantity" <%= (form.trackingMode || 'quantity') === 'quantity' ? 'checked' : '' %> required>
          <span class="choice-body">
            <strong>Quantity</strong>
            <span>&ldquo;I mainly need to know how many I have.&rdquo;</span>
          </span>
        </label>
        <label class="choice">
          <input type="radio" name="trackingMode" value="serial" <%= form.trackingMode === 'serial' ? 'checked' : '' %>>
          <span class="choice-body">
            <strong>Individual units</strong>
            <span>&ldquo;Every physical unit has its own serial number or identity.&rdquo;</span>
          </span>
        </label>
        <label class="choice">
          <input type="radio" name="trackingMode" value="lot" <%= form.trackingMode === 'lot' ? 'checked' : '' %>>
          <span class="choice-body">
            <strong>Lots / batches</strong>
            <span>&ldquo;Groups of this item need their own lot, batch, or expiration information.&rdquo;</span>
          </span>
        </label>
      </div>

      <div class="field" style="margin-top: 18px; padding-top: 16px; border-top: 1px solid var(--line-soft);">
        <label class="checkbox">
          <input type="checkbox" name="hasVariants" value="1" data-reveal-toggle <%= form.hasVariants ? 'checked' : '' %>>
          <span class="checkbox-text">
            <strong>This item comes in options such as size or colour</strong>
            <small>Each option combination is counted separately. It still works with any of the choices above.</small>
            <% if (typeof fromConfiguration !== 'undefined' && fromConfiguration) { %>
              <small class="muted">Filled in from what you told StockChief about this business. Change or clear anything.</small>
            <% } %>
          </span>
        </label>
      </div>

      <div data-reveal style="margin-top: 14px;">
        <div class="notice" style="margin-bottom: 12px;">
          <%- helpers.icon('tag', { size: 16 }) %>
          <span>List the choices for each option, separated by commas. StockChief creates one tracked variant per combination.</span>
        </div>
        <%# Every variant is counted, priced and reordered separately, so getting
            five sizes instead of one matters before saving rather than after.
            The preview reads the boxes the same way the item service does. %>
        <p class="variant-preview" data-variant-preview hidden></p>
        <div class="option-row">
          <label class="field"><span class="field-label">Option name</span><input class="input" name="options[0][name]" aria-label="First option name" placeholder="Colour" value="<%= (form.options && form.options[0] && form.options[0].name) || '' %>"></label>
          <label class="field"><span class="field-label">Choices</span><input class="input" name="options[0][values]" aria-label="First option choices" placeholder="Black, White" value="<%= (form.options && form.options[0] && form.options[0].values) || '' %>"></label>
        </div>
        <div class="option-row">
          <label class="field"><span class="field-label">Option name</span><input class="input" name="options[1][name]" aria-label="Second option name" placeholder="Size" value="<%= (form.options && form.options[1] && form.options[1].name) || '' %>"></label>
          <label class="field"><span class="field-label">Choices</span><input class="input" name="options[1][values]" aria-label="Second option choices" placeholder="Small, Medium, Large" value="<%= (form.options && form.options[1] && form.options[1].values) || '' %>"></label>
        </div>
        <div class="option-row">
          <label class="field"><span class="field-label">Another option <span class="optional">optional</span></span><input class="input" name="options[2][name]" aria-label="Third option name" placeholder="Fit" value="<%= (form.options && form.options[2] && form.options[2].name) || '' %>"></label>
          <label class="field"><span class="field-label">Choices</span><input class="input" name="options[2][values]" aria-label="Third option choices" placeholder="Regular, Relaxed" value="<%= (form.options && form.options[2] && form.options[2].values) || '' %>"></label>
        </div>
      </div>
    </div>
    <div class="card-foot" style="display:flex; gap:10px; align-items:center;">
      <span class="muted">You can add stock straight after saving.</span>
      <span style="margin-left:auto; display:flex; gap:8px;">
        <a class="btn" href="/inventory">Cancel</a>
        <button class="btn btn--primary" type="submit">Create item</button>
      </span>
    </div>
  </div>
</form>
