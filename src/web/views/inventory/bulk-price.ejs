<div class="page-head"><div><h1>Change selected selling prices</h1><p>This sets the same price on every active variant of the selected products. You will review the exact list before approval.</p></div></div>
<section class="card card-body"><ul><% items.forEach(function(i){ %><li><%= i.name %></li><% }); %></ul><form method="post" action="/inventory/bulk/prices" class="stack-form"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><% items.forEach(function(i){ %><input type="hidden" name="itemIds" value="<%= i.id %>"><% }); %>
<label class="field"><span>New selling price</span><input class="input" name="amount" inputmode="decimal" required maxlength="80"></label><label class="field"><span>Currency</span><input class="input" name="currency" value="USD" required pattern="[A-Za-z]{3}" maxlength="3"></label><button class="btn btn--primary" type="submit">Review exact price changes</button></form></section>
