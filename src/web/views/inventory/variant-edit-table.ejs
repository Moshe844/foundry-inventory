<section class="sc-business-card" id="variant-editor"><h2>Manage variants</h2><p>Edit the variants on this page, then review and approve all changes together. Stock entries are physical counts. Additional units use the purchase cost entered here; reductions remove their recorded stock cost. Batches, serial numbers and measured weights use the item’s stock actions so their identities stay recorded.</p>
<% const stockColumns=locals.variantStockLocations||locations.slice(0,10),countEditable=item.tracking_mode==='quantity'&&!item.secondary_unit_label&&locals.planGates?.['inventory.counts']?.enabled!==false; %>
<% if(locals.stockPlaces?.length>10){ %><form method="get"><label>Stock location <select name="stockLocationId"><option value="">First 10 locations</option><% for(const location of stockPlaces){ %><option value="<%= location.id %>" <%= stockColumns.length===1&&stockColumns[0].id===location.id?'selected':'' %>><%= location.name %></option><% } %></select></label><button class="btn">Show location</button></form><% } %>
<%- include('../components/plan-lock',{capability:'inventory.counts',label:'Stock count editing'}) %>
<form method="post" action="/inventory/<%= item.id %>/variants/review" data-variant-editor><input type="hidden" name="_csrf" value="<%= csrfToken %>">
<fieldset><legend>Bulk edit selected variants</legend><label><input type="checkbox" data-variant-all> Select all shown</label>
<label>Option value <select data-variant-filter><option value="">All shown values</option><% for(const option of options){for(const value of option.values){ %><option value="<%= JSON.stringify([option.name,value]) %>"><%= option.name %>: <%= value %></option><% }} %></select></label>
<label>Set <select data-variant-bulk-field><option value="price">Selling price</option><option value="cost">Purchase cost</option><option value="reorderPoint">Reorder point</option><option value="supplierId">Supplier</option><option value="supplierCost">Supplier cost</option></select></label>
<label data-variant-bulk-amount>Value <input inputmode="decimal" data-variant-bulk-value></label><label data-variant-bulk-supplier hidden>Supplier <select data-variant-bulk-supplier-value><option value="">Choose supplier</option><% for(const supplier of variantSuppliers){ %><option value="<%= supplier.id %>"><%= supplier.name %></option><% } %></select></label><button class="btn" type="button" data-variant-bulk-apply>Apply to selected</button><p data-variant-selection-status role="status"></p></fieldset>
<div class="table-scroll"><table class="table"><thead><tr><th>Select</th><% for(const option of options){ %><th><%= option.name %></th><% } %><th>SKU</th><th>Barcode</th><th>Purchase cost</th><th>Selling price</th><th>Reorder point</th><th>Supplier</th><th>Supplier cost</th><% for(const location of stockColumns){ %><th><%= location.name %></th><% } %></tr></thead><tbody>
<% for(const [index,sku] of skus.entries()){const state=variantStates.find(r=>r.id===sku.id),link=state.suppliers.find(s=>Number(s.is_active)&&Number(s.is_preferred)),policy=state.policies.find(p=>p.location_id===null),prefix='rows['+index+']'; %>
<tr data-variant-row data-option-values="<%= JSON.stringify(sku.optionValues) %>"><td><input type="checkbox" data-variant-select aria-label="Select <%= sku.variant_label||sku.code %>" <%= sku.is_active?'':'disabled' %>><input type="hidden" name="<%= prefix %>[skuId]" value="<%= sku.id %>"><input type="hidden" name="<%= prefix %>[version]" value="<%= state.version %>"></td>
<% for(const option of options){ %><td><input class="input" name="<%= prefix %>[optionValues][<%= option.id %>]" value="<%= sku.optionValues?.[option.name]||'' %>" aria-label="<%= option.name %> for <%= sku.variant_label||sku.code %>" required maxlength="120" <%= sku.is_active?'':'disabled' %>></td><% } %>
<% for(const [field,value,label] of [['code',sku.code,'SKU'],['barcode',sku.barcode||'','Barcode'],['cost',state.cost?helpers.moneyInput(Number(state.cost.amount_minor),state.cost.currency):'','Purchase cost'],['price',state.price?.amount_minor!=null?helpers.moneyInput(Number(state.price.amount_minor),state.price.currency):'','Selling price'],['reorderPoint',policy?.reorder_point??'','Reorder point']]){ %><td><input class="input" name="<%= prefix %>[<%= field %>]" data-variant-field="<%= field %>" aria-label="<%= label %> for <%= sku.variant_label||sku.code %>" value="<%= value %>" <%= sku.is_active?'':'disabled' %>></td><% } %>
<td><select name="<%= prefix %>[supplierId]" data-variant-field="supplierId" aria-label="Supplier for <%= sku.variant_label||sku.code %>" <%= sku.is_active?'':'disabled' %>><option value="">Link a supplier</option><% for(const supplier of variantSuppliers){ %><option value="<%= supplier.id %>" <%= link?.supplier_id===supplier.id?'selected':'' %>><%= supplier.name %></option><% } %></select></td><td><input class="input" name="<%= prefix %>[supplierCost]" data-variant-field="supplierCost" value="<%= link?.last_unit_cost??'' %>" aria-label="Supplier cost for <%= sku.variant_label||sku.code %>" <%= sku.is_active?'':'disabled' %>></td>
<% for(const location of stockColumns){const stock=locals.variantStockSnapshots?.[sku.id+':'+location.id]; %><td><% if(countEditable&&sku.is_active&&stock){ %><input class="input" type="number" step="<%= item.quantity_increment||1 %>" min="0" name="<%= prefix %>[stock][<%= location.id %>][quantity]" value="<%= stock.quantity %>" aria-label="Count <%= sku.variant_label||sku.code %> at <%= location.name %>"><input type="hidden" name="<%= prefix %>[stock][<%= location.id %>][originalQuantity]" value="<%= stock.quantity %>"><input type="hidden" name="<%= prefix %>[stock][<%= location.id %>][snapshot]" value="<%= stock.hash %>"><% }else{ %><%= helpers.qty(sku.perLocation.find(p=>p.locationId===location.id)?.onHand||0) %><% } %></td><% } %></tr><% } %>
</tbody></table></div><button class="btn btn--primary" type="submit">Review all variant changes</button></form><script src="/variant-editor.js" defer></script></section>
