<%
  /*
   * The rule, as three conditions and a choice.
   *
   * Written as a form rather than a sentence box on purpose. A sentence has to
   * be re-read every time a parcel is ready, and a reader that is right
   * ninety-nine times in a hundred is wrong about one parcel a week — which,
   * for a rule that spends money, is not a rounding error. The sentence
   * underneath each rule is StockChief saying back what it will do, so an owner
   * can see it understood them.
   */
  const money = function (minor) { return '$' + (Number(minor || 0) / 100).toFixed(2); };
  const se = typeof shipengine === 'undefined' ? { opened: false, available: false } : shipengine;
  const sandboxQualification = !account.connected && workspace && workspace.data_mode === 'synthetic';
%>

<div class="page-head">
  <div>
    <p class="eyebrow">Shipping</p>
    <h1>Connect shipping, then test one label</h1>
    <p class="lede">
      Start with a sandbox connection. Once StockChief can get a rate and create a test label,
      choose how much of the real workflow it may handle. Nothing on this page ships a parcel by itself.
    </p>
  </div>
</div>

<section class="card section" aria-label="Shipping qualification status">
  <div class="card-head"><div>
    <h2><%= account.connected ? (account.testMode ? 'Sandbox connected' : 'Shipping account connected') : 'Step 1 — connect a ShipEngine sandbox' %></h2>
    <p class="hint"><%= account.connected
      ? (account.testMode
        ? 'This connection can quote rates and create test labels. Test labels cannot ship real parcels and do not charge real postage.'
        : 'This connection can quote and buy real labels on this business’s own account.')
      : 'For qualification, use a ShipEngine TEST key. This is a shipping-platform key, not a UPS, FedEx, USPS or DHL login.' %></p>
  </div></div>
  <div class="card-body stack">
    <% if (!account.connected) { %>
      <ol class="stack">
        <li>Sign in to ShipEngine and switch the dashboard to <strong>Sandbox</strong>.</li>
        <li>Open <strong>API Keys</strong>, create a key, and copy the key beginning with <code>TEST</code>.</li>
        <li>Paste it under <strong>Connect with a shipping-platform key</strong> below. StockChief verifies it before storing it encrypted for this inventory only.</li>
      </ol>
      <% if (workspace && workspace.data_mode === 'synthetic') { %>
        <div class="notice notice--ok"><div><strong>This sample inventory is the right place to qualify it.</strong><br>Do not use a production key here. Test labels and qualification records remain disposable.</div></div>
      <% } %>
      <p class="hint">Handling mode and automation rules appear only after this connection passes.</p>
    <% } else if (account.testMode) { %>
      <p><strong>Next:</strong> use a complete test customer order to request rates, purchase one test label, verify its tracking record, then void it.</p>
    <% } else { %>
      <p><strong>Next:</strong> verify one low-value label manually before enabling recommendation or automatic purchasing.</p>
    <% } %>
    <p class="hint"><strong>Production ownership:</strong> every StockChief business must use its own shipping account or its own isolated ShipEngine seller. A developer key must never pay customer postage.</p>
  </div>
</section>

<section class="card section" aria-label="How businesses set up shipping">
  <div class="card-head"><div>
    <h2>One setup, based on how the business ships today</h2>
    <p class="hint">Customers should not need to understand ShipEngine. It is the infrastructure behind the secure setup.</p>
  </div></div>
  <div class="card-body stack">
    <div class="planning-item"><strong>Already has UPS, FedEx, USPS or DHL accounts</strong><br><span class="t-muted">Connect those carrier accounts in the secure setup window. Existing negotiated rates and carrier billing stay with that business.</span></div>
    <div class="planning-item"><strong>Does not have carrier accounts yet</strong><br><span class="t-muted">Use the same setup window to activate shipping rates and add the payment method that pays that business’s postage.</span></div>
    <div class="planning-item"><strong>Buys labels somewhere else</strong><br><span class="t-muted">Skip the connection. When a parcel leaves, record its carrier, tracking number and postage; inventory and accounting still update.</span></div>
    <details class="disclose"><summary><span>Already uses a shipping platform</span><span class="disclose__cue">Show</span></summary>
      <div class="disclose__body stack t-sm">
        <p>An existing ShipEngine, ShipStation, EasyPost or Shippo account can be connected as an advanced path. Its credentials belong only to that business.</p>
        <p><a class="btn" href="#account">Use this business's existing shipping platform</a></p>
      </div>
    </details>
  </div>
</section>

<section class="card section" aria-label="Shipping pricing">
  <div class="card-head"><div>
    <h2>Who pays what</h2>
    <p class="hint">Three different amounts stay separate so margin and accounting remain truthful.</p>
  </div></div>
  <div class="card-body stack">
    <div class="planning-item"><strong>Carrier postage</strong><br><span class="t-muted">Charged directly to this business’s connected shipping account and recorded as its shipping expense.</span></div>
    <div class="planning-item"><strong>What the customer pays for delivery</strong><br><span class="t-muted">Optional and set on the order. It is recorded separately as customer revenue, never silently netted against postage.</span></div>
    <div class="planning-item"><strong>StockChief shipping markup</strong><br><span class="t-muted">None in the current product. Subscription pricing is separate and is not implemented yet.</span></div>
  </div>
</section>

<% if (account.connected) { %>
<section class="card section" id="handling">
  <div class="card-head"><div>
    <h2>Later — choose how StockChief handles labels</h2>
    <p class="hint">Leave this on Recommend during qualification. Rate shopping is read-only; only Automatic can purchase, and only inside a saved rule and explicit authority.</p>
  </div></div>
  <form method="post" action="/settings/shipping/operation-mode" data-busy>
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <div class="card-body choice-grid">
      <% [
        ['MANUAL','Manual','Show all carrier rates; I choose and buy.'],
        ['RECOMMEND','Recommend','StockChief explains the best qualifying rate; I approve the purchase.'],
        ['AUTOMATIC','Automatic','StockChief may buy only when a saved rule and shipping-label authority both cover it.']
      ].forEach(function (choice) { %>
        <label class="choice">
          <input type="radio" name="mode" value="<%= choice[0] %>"
            <%= operationPolicy.mode === choice[0] ? 'checked' : '' %>>
          <span class="choice-body"><strong><%= choice[1] %></strong><span class="t-xs t-muted"><%= choice[2] %></span></span>
        </label>
      <% }) %>
    </div>
    <div class="card-foot"><button class="btn btn--primary" type="submit">Save handling</button></div>
  </form>
</section>
<% } %>

<%
  /*
   * Whose account this inventory ships on.
   *
   * Shown before the rules, because a rule is a permission to spend and the
   * first thing worth knowing is whose money. A key set on the server is
   * shared by every inventory on it — fine for one shop, wrong for two — so
   * that state is stated rather than shown as a green tick.
   */
%>
<section class="card section" id="account">
  <div class="card-head"><div>
    <h2><%= sandboxQualification ? 'Connect ShipEngine sandbox' : 'The account StockChief will use' %></h2>
    <p class="hint"><%= sandboxQualification
      ? 'Enter one ShipEngine TEST key. StockChief verifies it before anything else appears.'
      : 'One inventory, one encrypted shipping-platform credential, and no shared customer postage.' %></p>
  </div></div>

  <% if (account.connected) { %>
  <div class="card-body stack">
    <div class="notice notice--ok"><div>
      <strong>Connected shipping platform: <%= account.provider === 'shipengine' ? 'ShipEngine'
        : account.provider === 'shipstation' ? 'ShipStation'
          : account.provider === 'easypost' ? 'EasyPost' : 'Shippo' %></strong><br>
      Carrier choices come from this business's account. StockChief shows a carrier only when that
      account actually returns a rate; the names UPS, FedEx, USPS and DHL are not setup buttons.
    </div></div>
    <details class="disclose">
      <summary><span>Use a different Shippo, ShipStation, EasyPost or ShipEngine account</span><span class="disclose__cue">Show</span></summary>
      <div class="disclose__body t-sm">
        Disconnect the current platform below, then choose the platform this business already uses
        and verify that business's API key. Disconnecting does not delete the external account or
        StockChief's existing labels and tracking history.
      </div>
    </details>
  </div>
  <% } %>

  <%# ------------------------------------- a workspace ShipEngine seller %>
  <% if (account.connected && account.source === 'platform') { %>
    <div class="card-body stack">
      <p class="lede">
        Shipping for <%= se.name || workspaceName %>
        <% if (se.billingReady) { %><span class="badge badge--ok">ready to buy labels</span>
        <% } else { %><span class="badge badge--warn">setup unfinished</span><% } %>
      </p>
      <p class="hint">
        This is this business's separate shipping account. Its carrier rates, payment method,
        labels and charges are isolated from every other StockChief workspace. StockChief never charges
        StockChief's platform account for this business's postage.
      </p>
      <% if (!se.billingReady) { %>
        <div class="notice notice--warn"><div>
          <strong>Finish the one-time setup before buying a real label.</strong><br>
          <%= se.because %>
        </div></div>
      <% } %>
      <details class="disclose"><summary><span>Advanced connection details</span><span class="disclose__cue">Show</span></summary>
        <div class="disclose__body t-xs t-muted">Shipping platform: ShipEngine · seller <code><%= se.sellerId %></code></div>
      </details>
    </div>
    <div class="card-foot">
      <% if (!se.billingReady) { %>
        <button class="btn btn--primary" type="button" data-modal-open="modal-shipengine">
          Continue shipping setup
        </button>
      <% } else { %>
        <button class="btn" type="button" data-modal-open="modal-shipengine-settings">
          Manage carriers and payment
        </button>
      <% } %>
      <form method="post" action="/settings/shipping/account/remove" data-busy>
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <button class="btn btn--ghost" type="submit">Disconnect</button>
      </form>
    </div>

  <%# ------------------------------------------- an account StockChief opened %>
  <% } else if (account.connected && account.source === 'referral') { %>
    <div class="card-body">
      <p class="lede">
        Shipping account for <%= referral.name %><% if (!referral.billingReady) { %>
          <span class="badge badge--warn">no payment method</span>
        <% } else { %> <span class="badge badge--ok">live</span><% } %>
      </p>
      <p class="hint">
        StockChief opened this account and it belongs to this business — its rates, its labels, its
        bill. StockChief is not charged for anything shipped on it.
      </p>
      <details class="disclose"><summary><span>Advanced connection details</span><span class="disclose__cue">Show</span></summary>
        <div class="disclose__body t-xs t-muted">Shipping platform: EasyPost · reference
          <code><%= referral.referralCustomerId %></code> · billing notices go to <%= referral.email %> ·
          webhook <code><%= webhookUrl %></code></div>
      </details>
      <% if (!referral.billingReady) { %>
        <div class="notice notice--warn"><div>
          <strong>This account cannot buy a label yet.</strong><br>
          <%= referral.because %>
        </div></div>
      <% } %>
    </div>

    <% if (!referral.billingReady) { %>
      <%
        /*
         * Collecting the card, without the card coming here.
         *
         * The field below is Stripe's own, mounted into this page. The number
         * is typed into Stripe's iframe and goes straight to Stripe; what
         * reaches StockChief is a pm_ reference, which is worth nothing to
         * anybody who steals it. StockChief then asks EasyPost whether it can
         * really bill this merchant, rather than believing the browser.
         */
      %>
      <div class="card-body stack" id="billing-setup">
        <button class="btn btn--primary" type="button" id="billing-start">Add a payment method</button>
        <div id="billing-field" hidden></div>
        <p class="t-xs t-muted" id="billing-said"></p>
        <form method="post" action="/settings/shipping/account/billing/confirm" id="billing-confirm" hidden>
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <input type="hidden" name="stripeCustomerId" id="billing-customer">
          <input type="hidden" name="paymentMethodReference" id="billing-method">
        </form>
        <form method="post" action="/settings/shipping/account/billing/recheck" data-busy>
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <button class="btn btn--ghost" type="submit">I added one elsewhere — check again</button>
        </form>
      </div>
    <% } %>

    <div class="card-foot">
      <form method="post" action="/settings/shipping/account/remove" data-busy>
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <button class="btn btn--ghost" type="submit">Disconnect</button>
      </form>
      <p class="t-xs t-muted">
        Disconnecting makes StockChief forget the connection. The shipping account and everything
        shipped on it stay with this business.
      </p>
    </div>

  <% } else if (account.connected && account.source === 'workspace') { %>
    <div class="card-body">
      <p class="lede">
        Carrier connection ready<% if (account.testMode) { %>
          <span class="badge badge--warn">test mode</span><% } %>
      </p>
      <p class="hint"><%= account.hasWebhookSecret
        ? 'Carrier scans update this inventory automatically.'
        : 'StockChief checks the carrier on a schedule because instant scan updates are not connected.' %></p>
      <details class="disclose"><summary><span>Advanced connection details</span><span class="disclose__cue">Show</span></summary>
        <div class="disclose__body t-xs t-muted">Platform:
          <%= account.provider === 'shipengine' ? 'ShipEngine'
            : account.provider === 'shipstation' ? 'ShipStation'
              : account.provider === 'easypost' ? 'EasyPost' : 'Shippo' %>
          · key ending <%= account.keyEndsWith %> · webhook <code><%= webhookUrl %></code></div>
      </details>
    </div>
    <div class="card-foot">
      <form method="post" action="/settings/shipping/account/remove" data-busy>
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <button class="btn btn--ghost" type="submit">Disconnect</button>
      </form>
    </div>
  <% } else { %>
    <% if (account.connected && account.source === 'server') { %>
      <div class="card-body">
        <div class="notice notice--warn"><div>
          <strong>This inventory is using the key set on the server.</strong><br>
          <%= account.because %>
        </div></div>
      </div>
    <% } else if (!sandboxQualification) { %>
      <div class="card-body">
        <p class="lede">No carrier account is connected.</p>
        <p class="hint">
          StockChief can hold these rules, but it cannot get a rate or buy a label until there is an
          account to ask. Nothing about shipping stops working meanwhile — parcels handed over by
          hand are recorded exactly as they always were.
        </p>
      </div>
    <% } %>

    <%
      /*
       * Two ways to the same place, and the order matters.
       *
       * Almost every shop has no carrier account and does not want to go and
       * make one, so that path is first and is the plain button. A shop that
       * already ships on negotiated rates wants its own key and will find the
       * second — and would be worse off on a new account, so it must stay.
       */
    %>
    <% if (se.available && !se.opened && !account.connected) { %>
      <form method="post" action="/settings/shipping/shipengine/start" data-busy>
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <input type="hidden" name="countryCode" value="US">
        <div class="card-body stack">
          <h3>Set up shipping for me</h3>
          <p class="hint">
            StockChief will open one secure setup window. Your business address is filled in. You
            activate a carrier and add the payment method that pays for this business's labels.
            After that, StockChief can compare rates, buy labels, print them and keep tracking updated.
          </p>
          <div class="notice notice--ok"><div>
            <strong>This business pays its own postage.</strong><br>
            StockChief never charges its platform account. The payment method entered during
            setup belongs only to this business's shipping account.
          </div></div>
        </div>
        <div class="card-foot">
          <button class="btn btn--primary" type="submit">Set up shipping for me</button>
        </div>
      </form>
    <% } else if (!se.available && !se.opened && !account.connected && !sandboxQualification) { %>
      <div class="card-body stack">
        <div class="notice notice--warn"><div>
          <strong>Production guided setup is not enabled on this installation yet.</strong><br>
          That production path requires StockChief’s ShipEngine partner credentials and creates an isolated
          seller for each customer. For qualification now, connect a ShipEngine sandbox TEST key below.
        </div></div>
        <a class="btn btn--primary" href="#existing-carrier-connection">Connect ShipEngine sandbox</a>
      </div>
    <% } %>

    <% if (!se.available && referral.available && !referral.opened && !se.opened) { %>
      <form method="post" action="/settings/shipping/account/open" data-busy>
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <div class="card-body stack">
          <h3>Let StockChief open one</h3>
          <p class="hint">
            StockChief creates a carrier account in this business's name. The account is yours — your
            rates, your labels, your bill — and you never leave this page to make it.
          </p>
          <label class="field">
            <span class="field-label">Business name</span>
            <input class="input" name="name" value="<%= workspaceName %>" required>
            <span class="field-hint">The name the carrier bills and the name on the account.</span>
          </label>
          <label class="field">
            <span class="field-label">Email for billing notices</span>
            <input class="input" type="email" name="email" required>
            <span class="field-hint">
              The carrier sends receipts and account notices here. It is not used by StockChief for
              anything else.
            </span>
          </label>
          <label class="field">
            <span class="field-label">Phone <span class="t-muted">(optional)</span></span>
            <input class="input" name="phone">
          </label>
        </div>
        <div class="card-foot">
          <button class="btn btn--primary" type="submit">Open a shipping account</button>
        </div>
      </form>
    <% } %>

    <%
      // Provider keys are an advanced escape hatch, never the ordinary owner flow.
      // The carrier-first choices above remain primary even when guided setup is unavailable.
    var offerOpen = !sandboxQualification;
    %>
    <% if (offerOpen) { %>
      <details class="disclose" id="existing-carrier-connection">
        <summary>
          <span>Connect with a shipping-platform key</span>
          <span class="disclose__cue">Show</span>
        </summary>
        <div class="disclose__body">
    <% } %>
    <form method="post" action="/settings/shipping/account" data-busy id="advanced-shipping-connection">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <div class="card-body stack">
        <% if (!offerOpen) { %><h3 id="existing-carrier-connection">ShipEngine sandbox API key</h3><% } %>
        <p class="hint">For qualification choose ShipEngine and paste a sandbox key beginning with TEST. In production, this key must belong to this business—not to the StockChief developer account.</p>
        <% if (sandboxQualification) { %>
          <input type="hidden" name="provider" value="shipengine">
        <% } else { %>
        <label class="field">
          <span class="field-label">Shipping platform <span class="t-muted">(not the carrier)</span></span>
          <select class="select" name="provider">
            <% providers.forEach(function (name) { %>
              <option value="<%= name %>"><%= name === 'shipengine' ? 'ShipEngine API'
                : name === 'shipstation' ? 'ShipStation'
                  : name === 'easypost' ? 'EasyPost' : 'Shippo' %></option>
            <% }) %>
          </select>
        </label>
        <% } %>
        <label class="field">
          <span class="field-label">API key</span>
          <input class="input" type="password" name="apiKey" autocomplete="off" required>
          <span class="field-hint">
            ShipEngine sandbox keys begin with TEST. StockChief checks the key before saving it,
            stores it encrypted for this inventory, and never shows it back to you.
          </span>
        </label>
        <label class="field">
          <span class="field-label">Webhook secret <span class="t-muted">(optional)</span></span>
          <input class="input" type="password" name="webhookSecret" autocomplete="off">
          <span class="field-hint">
            Only needed when the provider uses a shared secret. ShipStation API signs its webhooks
            automatically. Without instant updates StockChief still uses the slower scheduled check.
          </span>
        </label>
      </div>
      <div class="card-foot">
        <button class="btn <%= offerOpen ? '' : 'btn--primary' %>"
          type="submit">Verify and connect</button>
      </div>
    </form>
    <% if (offerOpen) { %>
        </div>
      </details>
    <% } %>
  <% } %>
</section>

<section class="card section" aria-label="What happens after a parcel leaves">
  <div class="card-head"><div>
    <h2>What StockChief does after the handoff</h2>
    <p class="hint">The shipping connection is not only for buying labels.</p>
  </div></div>
  <div class="card-body stack">
    <div class="planning-item"><strong>1. Records the real handoff</strong><br><span class="t-muted">Inventory leaves only when the carrier handoff, customer collection or delivery by your team is confirmed.</span></div>
    <div class="planning-item"><strong>2. Follows the tracking number</strong><br><span class="t-muted">Carrier webhooks update it immediately when configured. A scheduled carrier check recovers missed updates and manually entered tracking numbers.</span></div>
    <div class="planning-item"><strong>3. Updates the order</strong><br><span class="t-muted">In transit, out for delivery, delivered, returned and failed scans are recorded without allowing an older scan to move the parcel backward.</span></div>
    <div class="planning-item"><strong>4. Tells the customer according to your policy</strong><br><span class="t-muted">Choose separately whether shipped, out-for-delivery, delivered and exception emails are prepared for review, sent automatically or turned off.</span></div>
    <div class="planning-item"><strong>5. Escalates exceptions</strong><br><span class="t-muted">A failed or returned parcel remains visible for a person instead of being silently treated as complete.</span></div>
  </div>
  <div class="card-foot">
    <a class="btn" href="/fulfilment#customer-notices">Choose customer notification timing</a>
  </div>
</section>

<script>
  (function () {
    if (window.location.hash !== '#existing-carrier-connection') return;
    var advanced = document.getElementById('existing-carrier-connection');
    if (advanced && advanced.tagName === 'DETAILS') advanced.open = true;
  }());
  (function () {
    document.querySelectorAll('details.disclose').forEach(function (details) {
      var cue = details.querySelector(':scope > summary .disclose__cue');
      if (!cue) return;
      function updateCue() { cue.textContent = details.open ? 'Hide' : 'Show'; }
      details.addEventListener('toggle', updateCue);
      updateCue();
    });
  }());
</script>

<% if (account.connected && account.source === 'platform') { %>
  <dialog class="modal" id="modal-shipengine" aria-labelledby="shipengine-setup-title">
    <div class="modal-head">
      <div>
        <h2 id="shipengine-setup-title">Set up shipping once</h2>
        <p class="hint">Carrier, ship-from address, and this business's payment method.</p>
      </div>
      <button class="btn btn--ghost btn--sm close" type="button" data-modal-close aria-label="Close">×</button>
    </div>
    <div class="modal-body">
      <div id="shipengine-onboarding" style="min-height:420px;max-height:70vh;overflow:auto">
        <p class="hint" id="shipengine-onboarding-status">Loading secure shipping setup…</p>
      </div>
    </div>
  </dialog>

  <dialog class="modal" id="modal-shipengine-settings" aria-labelledby="shipengine-settings-title">
    <div class="modal-head">
      <div>
        <h2 id="shipengine-settings-title">Shipping account</h2>
        <p class="hint">Manage this business's carriers, warehouse, and payment method.</p>
      </div>
      <button class="btn btn--ghost btn--sm close" type="button" data-modal-close aria-label="Close">×</button>
    </div>
    <div class="modal-body">
      <div id="shipengine-account-settings" style="min-height:420px;max-height:70vh;overflow:auto">
        <p class="hint" id="shipengine-settings-status">Loading secure account settings…</p>
      </div>
    </div>
  </dialog>

  <script type="module">
    import { ElementsSDK } from 'https://cdn.shipengine.com/shipengine-elements-sdk.mjs';

    const csrf = <%- JSON.stringify(csrfToken) %>;
    const defaultShipFromAddress = <%- JSON.stringify(shipFromAddress) %>;
    let onboardingMounted = false;
    let settingsMounted = false;
    let completing = false;

    async function getToken() {
      const response = await fetch('/settings/shipping/shipengine/token', {
        headers: { accept: 'text/plain' }, credentials: 'same-origin',
      });
      const token = await response.text();
      if (!response.ok) throw new Error(token || 'StockChief could not open secure shipping setup.');
      return token;
    }

    const elements = new ElementsSDK(getToken, {
      baseURL: 'https://elements.shipengine.com',
      locale: 'en-US',
      onError: function (error) {
        const visible = document.querySelector('dialog[open] [id^="shipengine-"][id$="status"]');
        if (visible) visible.textContent = error && error.message
          ? error.message : 'ShipEngine could not load this step. Please try again.';
      },
      features: {
        globalFeatures: {
          enabledShipEngineCarriers: ['stamps_com', 'dhl_express_worldwide'],
          enabledExternalCarriers: ['ups', 'fedex', 'stamps_com', 'dhl_express_worldwide'],
          poweredByShipEngine: true,
        },
      },
    });

    async function finish() {
      if (completing) return;
      completing = true;
      const response = await fetch('/settings/shipping/shipengine/complete', {
        method: 'POST',
        headers: { 'content-type': 'application/json', 'x-csrf-token': csrf },
        credentials: 'same-origin',
        body: JSON.stringify({ _csrf: csrf }),
      });
      const result = await response.json();
      if (!response.ok || !result.ok) {
        completing = false;
        throw new Error(result.error || 'StockChief could not verify that shipping setup finished.');
      }
      window.location.assign(result.redirect || '/settings/shipping#account');
    }

    function mountOnboarding() {
      if (onboardingMounted) return;
      onboardingMounted = true;
      document.getElementById('shipengine-onboarding-status')?.remove();
      const onboarding = elements.create('onboarding');
      onboarding.mount('shipengine-onboarding', {
        defaultShipFromAddress: defaultShipFromAddress,
        skipWelcomePage: true,
        onComplete: finish,
        onSellerOnboarded: finish,
      });
    }

    function mountSettings() {
      if (settingsMounted) return;
      settingsMounted = true;
      document.getElementById('shipengine-settings-status')?.remove();
      const accountSettings = elements.create('accountSettings');
      accountSettings.mount('shipengine-account-settings');
    }

    document.querySelectorAll('[data-modal-open="modal-shipengine"]').forEach(function (button) {
      button.addEventListener('click', mountOnboarding);
    });
    document.querySelectorAll('[data-modal-open="modal-shipengine-settings"]').forEach(function (button) {
      button.addEventListener('click', mountSettings);
    });

    <% if (openShipEngineSetup && !se.billingReady) { %>
      const dialog = document.getElementById('modal-shipengine');
      mountOnboarding();
      if (dialog && !dialog.open) dialog.showModal();
    <% } %>
  </script>
<% } %>

<% if (account.connected) { %>
<section class="card section">
  <div class="card-head"><div>
    <h2>Rules you have set</h2>
    <p class="hint">Checked in order. The first one that covers a parcel is the one used.</p>
  </div></div>
  <div class="card-body stack">
    <% if (!rules.filter(function (r) { return r.active; }).length) { %>
      <p class="planning-item">
        No rule yet, so StockChief asks about every parcel. That is a reasonable place to stay —
        a rule is worth setting when you notice yourself answering the same way each time.
      </p>
    <% } %>
    <% rules.filter(function (r) { return r.active; }).forEach(function (rule) { %>
      <article class="planning-item">
        <strong><%= rule.name %></strong>
        <p class="t-muted">
          <%= rule.carrier ? rule.carrier.toUpperCase() : 'Any carrier' %>
          <%= rule.service || '' %>
          <% if (rule.maxCostMinor) { %> · under <%= money(rule.maxCostMinor) %><% } %>
          <% if (rule.requireByPromised) { %> · must arrive by the promised date<% } %>
          <% if (rule.maxDeliveryDays) { %> · within <%= rule.maxDeliveryDays %> days<% } %>
        </p>
        <% if (rule.statedText) { %><p class="t-xs t-muted">You said: “<%= rule.statedText %>”</p><% } %>
        <form method="post" action="/settings/shipping/<%= rule.id %>/remove" data-busy>
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <button class="btn btn--sm btn--ghost" type="submit">Stop using this</button>
        </form>
      </article>
    <% }) %>
  </div>
</section>

<section class="card section">
  <div class="card-head"><div>
    <h2>Add a rule</h2>
    <p class="hint">
      Leave the carrier empty to mean “whatever is cheapest that qualifies”, which is what most
      shops actually want.
    </p>
  </div></div>
  <form method="post" action="/settings/shipping">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <div class="card-body stack">
      <label class="field">
        <span class="field-label">Carrier <span class="t-muted">(optional)</span></span>
        <select class="select" name="carrier">
          <option value="">Any — cheapest that qualifies</option>
          <% carriers.forEach(function (carrier) { %>
            <option value="<%= carrier.code %>"><%= carrier.name %></option>
          <% }) %>
        </select>
      </label>
      <label class="field">
        <span class="field-label">Service <span class="t-muted">(optional)</span></span>
        <input class="input" type="text" name="service" placeholder="Ground">
        <span class="field-hint">Exactly as the carrier names it. Empty means any service.</span>
      </label>
      <label class="field">
        <span class="field-label">Only when it costs less than</span>
        <input class="input" type="text" name="maxCost" placeholder="25.00">
        <span class="field-hint">Empty means no limit, which is a lot of trust to give postage.</span>
      </label>
      <label class="field field--check">
        <input type="checkbox" name="requireByPromised" checked>
        <span>Only when it arrives by the date the customer was promised</span>
      </label>
      <label class="field">
        <span class="field-label">Or within this many days <span class="t-muted">(optional)</span></span>
        <input class="input" type="number" name="maxDeliveryDays" min="1" max="30">
      </label>
    </div>
    <div class="card-foot">
      <button class="btn btn--primary" type="submit">Save this rule</button>
    </div>
  </form>
</section>

<p class="money-foot">
  StockChief only ever chooses between rates a carrier has actually quoted for the parcel in front of
  it. A rule cannot make it buy something nobody offered, and a rate with no delivery date never
  counts as arriving on time — a carrier that declines to say is not a carrier promising.
</p>
<% } %>

<% if (account.connected && account.source === 'referral' && !referral.billingReady) { %>
<script>
/*
 * The card field, which is Stripe's and not StockChief's.
 *
 * Loaded only when there is a payment method to add, so the page does not pull
 * a third-party script it has no use for. The sequence: ask StockChief for a
 * client secret, mount Stripe's own field with it, and post back the reference
 * Stripe returns. At no point does a card number exist in this page's own
 * variables, this request, or this server.
 *
 * If any of it fails — script blocked, network down, an EasyPost shape that
 * has moved — the "I added one elsewhere" button below is still there and
 * still works, because a merchant should never be stuck behind our JavaScript.
 */
(function () {
  var start = document.getElementById('billing-start');
  var field = document.getElementById('billing-field');
  var said = document.getElementById('billing-said');
  var form = document.getElementById('billing-confirm');
  if (!start) return;

  function say(text) { said.textContent = text; }

  function load() {
    if (window.Stripe) return Promise.resolve();
    return new Promise(function (resolve, reject) {
      var tag = document.createElement('script');
      tag.src = 'https://js.stripe.com/v3/';
      tag.onload = resolve;
      tag.onerror = function () { reject(new Error('Stripe could not be loaded.')); };
      document.head.appendChild(tag);
    });
  }

  start.addEventListener('click', function () {
    start.disabled = true;
    say('Asking the carrier for a secure card field…');

    fetch('/settings/shipping/account/billing/start', {
      method: 'POST',
      headers: { 'content-type': 'application/json', 'x-csrf-token': '<%= csrfToken %>' },
      body: JSON.stringify({ _csrf: '<%= csrfToken %>', kind: 'card' }),
    }).then(function (response) { return response.json(); }).then(function (setup) {
      if (!setup.ok) throw new Error(setup.error || 'The carrier would not open a card field.');
      if (!setup.publishableKey) {
        throw new Error('The carrier did not say which Stripe account to collect the card into.');
      }
      return load().then(function () {
        var stripe = window.Stripe(setup.publishableKey);
        var elements = stripe.elements({ clientSecret: setup.clientSecret });
        elements.create('payment').mount(field);
        field.hidden = false;
        say('');

        var submit = document.createElement('button');
        submit.className = 'btn btn--primary';
        submit.type = 'button';
        submit.textContent = 'Save this payment method';
        field.after(submit);

        submit.addEventListener('click', function () {
          submit.disabled = true;
          say('Saving with Stripe…');
          stripe.confirmSetup({ elements: elements, redirect: 'if_required' })
            .then(function (result) {
              if (result.error) throw new Error(result.error.message);
              var intent = result.setupIntent || {};
              document.getElementById('billing-method').value = intent.payment_method || '';
              form.submit();
            })
            .catch(function (error) { submit.disabled = false; say(error.message); });
        });
      });
    }).catch(function (error) {
      start.disabled = false;
      say(error.message + ' You can add a payment method on the carrier\u2019s own site instead, '
        + 'then use the button below.');
    });
  });
}());
</script>
<% } %>
