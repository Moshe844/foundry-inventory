<%
  /*
   * The rule, as three conditions and a choice.
   *
   * Written as a form rather than a sentence box on purpose. A sentence has to
   * be re-read every time a parcel is ready, and a reader that is right
   * ninety-nine times in a hundred is wrong about one parcel a week — which,
   * for a rule that spends money, is not a rounding error. The sentence
   * underneath each rule is Foundry saying back what it will do, so an owner
   * can see it understood them.
   */
  const money = function (minor) { return '$' + (Number(minor || 0) / 100).toFixed(2); };
  const se = typeof shipengine === 'undefined' ? { opened: false, available: false } : shipengine;
%>

<div class="page-head">
  <div>
    <p class="eyebrow">Foundry · A Keeper product</p>
    <h1>Shipping rules</h1>
    <p class="lede">
      When a parcel is ready, Foundry gets live rates from the carriers. A rule here says which of
      them it may buy on its own. Anything a rule does not cover becomes a question rather than a
      guess.
    </p>
  </div>
</div>

<%
  /*
   * Whose account this inventory ships on.
   *
   * Shown before the rules, because a rule is a permission to spend and the
   * first thing worth knowing is whose money. A key set on the server is
   * shared by every inventory on it — fine for one shop, wrong for two — so
   * that state is stated rather than shown as a green tick.
   */
%>
<section class="card section" id="account">
  <div class="card-head"><div>
    <h2>Carrier account</h2>
    <p class="hint">Rates and labels come from this account, and its labels are billed to it.</p>
  </div></div>

  <%# ------------------------------------- a workspace ShipEngine seller %>
  <% if (account.connected && account.source === 'platform') { %>
    <div class="card-body stack">
      <p class="lede">
        ShipEngine for <%= se.name || workspaceName %>
        <% if (se.billingReady) { %><span class="badge badge--ok">ready to buy labels</span>
        <% } else { %><span class="badge badge--warn">setup unfinished</span><% } %>
      </p>
      <p class="hint">
        This is this business's separate shipping account. Its carrier rates, payment method,
        labels and charges are isolated from every other Foundry workspace. Foundry never charges
        Keeper's developer account for this business's postage.
      </p>
      <% if (!se.billingReady) { %>
        <div class="notice notice--warn"><div>
          <strong>Finish the one-time setup before buying a real label.</strong><br>
          <%= se.because %>
        </div></div>
      <% } %>
      <p class="t-xs t-muted">ShipEngine seller <code><%= se.sellerId %></code></p>
    </div>
    <div class="card-foot">
      <% if (!se.billingReady) { %>
        <button class="btn btn--primary" type="button" data-modal-open="modal-shipengine">
          Continue shipping setup
        </button>
      <% } else { %>
        <button class="btn" type="button" data-modal-open="modal-shipengine-settings">
          Manage carriers and payment
        </button>
      <% } %>
      <form method="post" action="/settings/shipping/account/remove" data-busy>
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <button class="btn btn--ghost" type="submit">Disconnect</button>
      </form>
    </div>

  <%# ------------------------------------------- an account Foundry opened %>
  <% } else if (account.connected && account.source === 'referral') { %>
    <div class="card-body">
      <p class="lede">
        EasyPost account for <%= referral.name %><% if (!referral.billingReady) { %>
          <span class="badge badge--warn">no payment method</span>
        <% } else { %> <span class="badge badge--ok">live</span><% } %>
      </p>
      <p class="hint">
        Foundry opened this account and it belongs to this business — its rates, its labels, its
        bill. Nobody at Keeper is charged for anything shipped on it.
      </p>
      <p class="t-xs t-muted">
        EasyPost reference <code><%= referral.referralCustomerId %></code> ·
        billing notices go to <%= referral.email %>
      </p>
      <% if (!referral.billingReady) { %>
        <div class="notice notice--warn"><div>
          <strong>This account cannot buy a label yet.</strong><br>
          <%= referral.because %>
        </div></div>
      <% } %>
      <p class="t-xs t-muted">Webhook address for this inventory: <code><%= webhookUrl %></code></p>
    </div>

    <% if (!referral.billingReady) { %>
      <%
        /*
         * Collecting the card, without the card coming here.
         *
         * The field below is Stripe's own, mounted into this page. The number
         * is typed into Stripe's iframe and goes straight to Stripe; what
         * reaches Foundry is a pm_ reference, which is worth nothing to
         * anybody who steals it. Foundry then asks EasyPost whether it can
         * really bill this merchant, rather than believing the browser.
         */
      %>
      <div class="card-body stack" id="billing-setup">
        <button class="btn btn--primary" type="button" id="billing-start">Add a payment method</button>
        <div id="billing-field" hidden></div>
        <p class="t-xs t-muted" id="billing-said"></p>
        <form method="post" action="/settings/shipping/account/billing/confirm" id="billing-confirm" hidden>
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <input type="hidden" name="stripeCustomerId" id="billing-customer">
          <input type="hidden" name="paymentMethodReference" id="billing-method">
        </form>
        <form method="post" action="/settings/shipping/account/billing/recheck" data-busy>
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <button class="btn btn--ghost" type="submit">I added one elsewhere — check again</button>
        </form>
      </div>
    <% } %>

    <div class="card-foot">
      <form method="post" action="/settings/shipping/account/remove" data-busy>
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <button class="btn btn--ghost" type="submit">Disconnect</button>
      </form>
      <p class="t-xs t-muted">
        Disconnecting makes Foundry forget the keys. The EasyPost account, and everything shipped
        on it, stays.
      </p>
    </div>

  <% } else if (account.connected && account.source === 'workspace') { %>
    <div class="card-body">
      <p class="lede">
        Connected to <%= account.provider === 'shipengine' ? 'ShipEngine'
          : account.provider === 'easypost' ? 'EasyPost' : 'Shippo' %><% if (account.testMode) { %>
          <span class="badge badge--warn">test mode</span><% } %>
      </p>
      <p class="hint">
        Key ending <%= account.keyEndsWith %>.
        <%= account.hasWebhookSecret
          ? 'Tracking updates arrive by webhook.'
          : 'No webhook secret is set, so tracking updates rely on the slower scheduled check.' %>
      </p>
      <p class="t-xs t-muted">Webhook address for this inventory: <code><%= webhookUrl %></code></p>
    </div>
    <div class="card-foot">
      <form method="post" action="/settings/shipping/account/remove" data-busy>
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <button class="btn btn--ghost" type="submit">Disconnect</button>
      </form>
    </div>
  <% } else { %>
    <% if (account.connected && account.source === 'server') { %>
      <div class="card-body">
        <div class="notice notice--warn"><div>
          <strong>This inventory is using the key set on the server.</strong><br>
          <%= account.because %>
        </div></div>
      </div>
    <% } else { %>
      <div class="card-body">
        <p class="lede">No carrier account is connected.</p>
        <p class="hint">
          Foundry can hold these rules, but it cannot get a rate or buy a label until there is an
          account to ask. Nothing about shipping stops working meanwhile — parcels handed over by
          hand are recorded exactly as they always were.
        </p>
      </div>
    <% } %>

    <%
      /*
       * Two ways to the same place, and the order matters.
       *
       * Almost every shop has no carrier account and does not want to go and
       * make one, so that path is first and is the plain button. A shop that
       * already ships on negotiated rates wants its own key and will find the
       * second — and would be worse off on a new account, so it must stay.
       */
    %>
    <% if (se.available && !se.opened && !account.connected) { %>
      <form method="post" action="/settings/shipping/shipengine/start" data-busy>
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <input type="hidden" name="countryCode" value="US">
        <div class="card-body stack">
          <h3>Set up shipping</h3>
          <p class="hint">
            Foundry will open one secure setup window. Your business address is filled in. You
            activate a carrier and add the payment method that pays for this business's labels.
            After that, Foundry can compare rates, buy labels, print them and keep tracking updated.
          </p>
          <div class="notice notice--ok"><div>
            <strong>This business pays its own postage.</strong><br>
            Foundry never charges Keeper's developer account. The payment method entered during
            setup belongs only to this workspace's ShipEngine seller.
          </div></div>
        </div>
        <div class="card-foot">
          <button class="btn btn--primary" type="submit">Set up shipping</button>
        </div>
      </form>
    <% } else if (!se.available && !se.opened && !account.connected) { %>
      <div class="card-body">
        <div class="notice notice--warn"><div>
          <strong>ShipEngine's embedded setup is not connected to this Foundry installation yet.</strong><br>
          The Foundry administrator must add the platform credentials issued during ShipEngine
          partner onboarding. A normal sandbox API key alone cannot create isolated customer sellers.
        </div></div>
      </div>
    <% } %>

    <% if (!se.available && referral.available && !referral.opened && !se.opened) { %>
      <form method="post" action="/settings/shipping/account/open" data-busy>
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <div class="card-body stack">
          <h3>Let Foundry open one</h3>
          <p class="hint">
            Foundry creates a carrier account in this business's name. The account is yours — your
            rates, your labels, your bill — and you never leave this page to make it.
          </p>
          <label class="field">
            <span class="field-label">Business name</span>
            <input class="input" name="name" value="<%= workspaceName %>" required>
            <span class="field-hint">The name the carrier bills and the name on the account.</span>
          </label>
          <label class="field">
            <span class="field-label">Email for billing notices</span>
            <input class="input" type="email" name="email" required>
            <span class="field-hint">
              The carrier sends receipts and account notices here. It is not used by Foundry for
              anything else.
            </span>
          </label>
          <label class="field">
            <span class="field-label">Phone <span class="t-muted">(optional)</span></span>
            <input class="input" name="phone">
          </label>
        </div>
        <div class="card-foot">
          <button class="btn btn--primary" type="submit">Open a shipping account</button>
        </div>
      </form>
    <% } %>

    <%
      // Folded away only when there is something better to fold it behind.
      // Where Foundry cannot open an account, this is the only way in.
    var offerOpen = Boolean((se.available || referral.available) && !referral.opened && !se.opened);
    %>
    <% if (offerOpen) { %>
      <details class="disclose">
        <summary>
          <span>I already have a carrier account</span>
          <span class="disclose__cue">Show</span>
        </summary>
        <div class="disclose__body">
    <% } %>
    <form method="post" action="/settings/shipping/account" data-busy>
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <div class="card-body stack">
        <label class="field">
          <span class="field-label">Provider</span>
          <select class="select" name="provider">
            <% providers.forEach(function (name) { %>
              <option value="<%= name %>"><%= name === 'shipengine' ? 'ShipEngine'
                : name === 'easypost' ? 'EasyPost' : 'Shippo' %></option>
            <% }) %>
          </select>
        </label>
        <label class="field">
          <span class="field-label">API key</span>
          <input class="input" type="password" name="apiKey" autocomplete="off" required>
          <span class="field-hint">
            Start with the provider's test key. It exercises the flow and issues test labels
            without charging anybody or moving anything; test prices may differ from live rates.
            Stored encrypted, and never shown back to you.
          </span>
        </label>
        <label class="field">
          <span class="field-label">Webhook secret <span class="t-muted">(optional)</span></span>
          <input class="input" type="password" name="webhookSecret" autocomplete="off">
          <span class="field-hint">
            The string you set on the provider's webhook. Without it Foundry still tracks parcels,
            just on the slower scheduled check rather than the instant a carrier scans one.
          </span>
        </label>
      </div>
      <div class="card-foot">
        <button class="btn <%= offerOpen ? '' : 'btn--primary' %>"
          type="submit">Connect this inventory's account</button>
      </div>
    </form>
    <% if (offerOpen) { %>
        </div>
      </details>
    <% } %>
  <% } %>
</section>

<% if (account.connected && account.source === 'platform') { %>
  <dialog class="modal" id="modal-shipengine" aria-labelledby="shipengine-setup-title">
    <div class="modal-head">
      <div>
        <h2 id="shipengine-setup-title">Set up shipping once</h2>
        <p class="hint">Carrier, ship-from address, and this business's payment method.</p>
      </div>
      <button class="btn btn--ghost btn--sm close" type="button" data-modal-close aria-label="Close">×</button>
    </div>
    <div class="modal-body">
      <div id="shipengine-onboarding" style="min-height:420px;max-height:70vh;overflow:auto">
        <p class="hint" id="shipengine-onboarding-status">Loading secure shipping setup…</p>
      </div>
    </div>
  </dialog>

  <dialog class="modal" id="modal-shipengine-settings" aria-labelledby="shipengine-settings-title">
    <div class="modal-head">
      <div>
        <h2 id="shipengine-settings-title">Shipping account</h2>
        <p class="hint">Manage this business's carriers, warehouse, and payment method.</p>
      </div>
      <button class="btn btn--ghost btn--sm close" type="button" data-modal-close aria-label="Close">×</button>
    </div>
    <div class="modal-body">
      <div id="shipengine-account-settings" style="min-height:420px;max-height:70vh;overflow:auto">
        <p class="hint" id="shipengine-settings-status">Loading secure account settings…</p>
      </div>
    </div>
  </dialog>

  <script type="module">
    import { ElementsSDK } from 'https://cdn.shipengine.com/shipengine-elements-sdk.mjs';

    const csrf = <%- JSON.stringify(csrfToken) %>;
    const defaultShipFromAddress = <%- JSON.stringify(shipFromAddress) %>;
    let onboardingMounted = false;
    let settingsMounted = false;
    let completing = false;

    async function getToken() {
      const response = await fetch('/settings/shipping/shipengine/token', {
        headers: { accept: 'text/plain' }, credentials: 'same-origin',
      });
      const token = await response.text();
      if (!response.ok) throw new Error(token || 'Foundry could not open secure shipping setup.');
      return token;
    }

    const elements = new ElementsSDK(getToken, {
      baseURL: 'https://elements.shipengine.com',
      locale: 'en-US',
      onError: function (error) {
        const visible = document.querySelector('dialog[open] [id^="shipengine-"][id$="status"]');
        if (visible) visible.textContent = error && error.message
          ? error.message : 'ShipEngine could not load this step. Please try again.';
      },
      features: {
        globalFeatures: {
          enabledShipEngineCarriers: ['stamps_com', 'dhl_express_worldwide'],
          enabledExternalCarriers: ['ups', 'fedex', 'stamps_com', 'dhl_express_worldwide'],
          poweredByShipEngine: true,
        },
      },
    });

    async function finish() {
      if (completing) return;
      completing = true;
      const response = await fetch('/settings/shipping/shipengine/complete', {
        method: 'POST',
        headers: { 'content-type': 'application/json', 'x-csrf-token': csrf },
        credentials: 'same-origin',
        body: JSON.stringify({ _csrf: csrf }),
      });
      const result = await response.json();
      if (!response.ok || !result.ok) {
        completing = false;
        throw new Error(result.error || 'Foundry could not verify that shipping setup finished.');
      }
      window.location.assign(result.redirect || '/settings/shipping#account');
    }

    function mountOnboarding() {
      if (onboardingMounted) return;
      onboardingMounted = true;
      document.getElementById('shipengine-onboarding-status')?.remove();
      const onboarding = elements.create('onboarding');
      onboarding.mount('shipengine-onboarding', {
        defaultShipFromAddress: defaultShipFromAddress,
        skipWelcomePage: true,
        onComplete: finish,
        onSellerOnboarded: finish,
      });
    }

    function mountSettings() {
      if (settingsMounted) return;
      settingsMounted = true;
      document.getElementById('shipengine-settings-status')?.remove();
      const accountSettings = elements.create('accountSettings');
      accountSettings.mount('shipengine-account-settings');
    }

    document.querySelectorAll('[data-modal-open="modal-shipengine"]').forEach(function (button) {
      button.addEventListener('click', mountOnboarding);
    });
    document.querySelectorAll('[data-modal-open="modal-shipengine-settings"]').forEach(function (button) {
      button.addEventListener('click', mountSettings);
    });

    <% if (openShipEngineSetup && !se.billingReady) { %>
      const dialog = document.getElementById('modal-shipengine');
      mountOnboarding();
      if (dialog && !dialog.open) dialog.showModal();
    <% } %>
  </script>
<% } %>

<section class="card section">
  <div class="card-head"><div>
    <h2>Rules you have set</h2>
    <p class="hint">Checked in order. The first one that covers a parcel is the one used.</p>
  </div></div>
  <div class="card-body stack">
    <% if (!rules.filter(function (r) { return r.active; }).length) { %>
      <p class="planning-item">
        No rule yet, so Foundry asks about every parcel. That is a reasonable place to stay —
        a rule is worth setting when you notice yourself answering the same way each time.
      </p>
    <% } %>
    <% rules.filter(function (r) { return r.active; }).forEach(function (rule) { %>
      <article class="planning-item">
        <strong><%= rule.name %></strong>
        <p class="t-muted">
          <%= rule.carrier ? rule.carrier.toUpperCase() : 'Any carrier' %>
          <%= rule.service || '' %>
          <% if (rule.maxCostMinor) { %> · under <%= money(rule.maxCostMinor) %><% } %>
          <% if (rule.requireByPromised) { %> · must arrive by the promised date<% } %>
          <% if (rule.maxDeliveryDays) { %> · within <%= rule.maxDeliveryDays %> days<% } %>
        </p>
        <% if (rule.statedText) { %><p class="t-xs t-muted">You said: “<%= rule.statedText %>”</p><% } %>
        <form method="post" action="/settings/shipping/<%= rule.id %>/remove" data-busy>
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <button class="btn btn--sm btn--ghost" type="submit">Stop using this</button>
        </form>
      </article>
    <% }) %>
  </div>
</section>

<section class="card section">
  <div class="card-head"><div>
    <h2>Add a rule</h2>
    <p class="hint">
      Leave the carrier empty to mean “whatever is cheapest that qualifies”, which is what most
      shops actually want.
    </p>
  </div></div>
  <form method="post" action="/settings/shipping">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <div class="card-body stack">
      <label class="field">
        <span class="field-label">Carrier <span class="t-muted">(optional)</span></span>
        <select class="select" name="carrier">
          <option value="">Any — cheapest that qualifies</option>
          <% carriers.forEach(function (carrier) { %>
            <option value="<%= carrier.code %>"><%= carrier.name %></option>
          <% }) %>
        </select>
      </label>
      <label class="field">
        <span class="field-label">Service <span class="t-muted">(optional)</span></span>
        <input class="input" type="text" name="service" placeholder="Ground">
        <span class="field-hint">Exactly as the carrier names it. Empty means any service.</span>
      </label>
      <label class="field">
        <span class="field-label">Only when it costs less than</span>
        <input class="input" type="text" name="maxCost" placeholder="25.00">
        <span class="field-hint">Empty means no limit, which is a lot of trust to give postage.</span>
      </label>
      <label class="field field--check">
        <input type="checkbox" name="requireByPromised" checked>
        <span>Only when it arrives by the date the customer was promised</span>
      </label>
      <label class="field">
        <span class="field-label">Or within this many days <span class="t-muted">(optional)</span></span>
        <input class="input" type="number" name="maxDeliveryDays" min="1" max="30">
      </label>
    </div>
    <div class="card-foot">
      <button class="btn btn--primary" type="submit">Save this rule</button>
    </div>
  </form>
</section>

<p class="money-foot">
  Foundry only ever chooses between rates a carrier has actually quoted for the parcel in front of
  it. A rule cannot make it buy something nobody offered, and a rate with no delivery date never
  counts as arriving on time — a carrier that declines to say is not a carrier promising.
</p>

<% if (account.connected && account.source === 'referral' && !referral.billingReady) { %>
<script>
/*
 * The card field, which is Stripe's and not Foundry's.
 *
 * Loaded only when there is a payment method to add, so the page does not pull
 * a third-party script it has no use for. The sequence: ask Foundry for a
 * client secret, mount Stripe's own field with it, and post back the reference
 * Stripe returns. At no point does a card number exist in this page's own
 * variables, this request, or this server.
 *
 * If any of it fails — script blocked, network down, an EasyPost shape that
 * has moved — the "I added one elsewhere" button below is still there and
 * still works, because a merchant should never be stuck behind our JavaScript.
 */
(function () {
  var start = document.getElementById('billing-start');
  var field = document.getElementById('billing-field');
  var said = document.getElementById('billing-said');
  var form = document.getElementById('billing-confirm');
  if (!start) return;

  function say(text) { said.textContent = text; }

  function load() {
    if (window.Stripe) return Promise.resolve();
    return new Promise(function (resolve, reject) {
      var tag = document.createElement('script');
      tag.src = 'https://js.stripe.com/v3/';
      tag.onload = resolve;
      tag.onerror = function () { reject(new Error('Stripe could not be loaded.')); };
      document.head.appendChild(tag);
    });
  }

  start.addEventListener('click', function () {
    start.disabled = true;
    say('Asking the carrier for a secure card field…');

    fetch('/settings/shipping/account/billing/start', {
      method: 'POST',
      headers: { 'content-type': 'application/json', 'x-csrf-token': '<%= csrfToken %>' },
      body: JSON.stringify({ _csrf: '<%= csrfToken %>', kind: 'card' }),
    }).then(function (response) { return response.json(); }).then(function (setup) {
      if (!setup.ok) throw new Error(setup.error || 'The carrier would not open a card field.');
      if (!setup.publishableKey) {
        throw new Error('The carrier did not say which Stripe account to collect the card into.');
      }
      return load().then(function () {
        var stripe = window.Stripe(setup.publishableKey);
        var elements = stripe.elements({ clientSecret: setup.clientSecret });
        elements.create('payment').mount(field);
        field.hidden = false;
        say('');

        var submit = document.createElement('button');
        submit.className = 'btn btn--primary';
        submit.type = 'button';
        submit.textContent = 'Save this payment method';
        field.after(submit);

        submit.addEventListener('click', function () {
          submit.disabled = true;
          say('Saving with Stripe…');
          stripe.confirmSetup({ elements: elements, redirect: 'if_required' })
            .then(function (result) {
              if (result.error) throw new Error(result.error.message);
              var intent = result.setupIntent || {};
              document.getElementById('billing-method').value = intent.payment_method || '';
              form.submit();
            })
            .catch(function (error) { submit.disabled = false; say(error.message); });
        });
      });
    }).catch(function (error) {
      start.disabled = false;
      say(error.message + ' You can add a payment method on the carrier\u2019s own site instead, '
        + 'then use the button below.');
    });
  });
}());
</script>
<% } %>
