<section class="rm-head"><div><p class="rm-head__eyebrow">Shipping</p><h1>Label batch</h1><p><%= batch.complete %> of <%= batch.entries.length %> purchases verified<% if(batch.needsAttention){ %> · <%= batch.needsAttention %> need attention<% } %>. Quoted total: <%= helpers.money(batch.totalMinor,batch.currency) %>.</p><p>Each parcel is checked separately. Progress updates automatically. Reopening this batch does not buy again.</p></div><a href="/fulfilment">Back to fulfilment</a></section>
<section class="card section"><div class="card-body"><ul><% for(const entry of batch.entries){ %><li><a href="/fulfilment/<%= entry.shipment_id %>"><%= entry.shipment_number %></a> · <%= entry.status==='SUCCEEDED'?'Purchase verified':entry.status==='PENDING'?'Buying and verifying':entry.status==='REVIEW'?'Carrier outcome needs review':entry.status %><% if(entry.error_message){ %> · <%= entry.error_message %><% } %><% if(entry.status==='SUCCEEDED'&&!entry.documents.length){ %> · Label unavailable for printing: it was voided, replaced or needs verification.<% } %></li><% } %></ul>
<% for(const format of ['PDF','ZPL']){const docs=batch.entries.flatMap(e=>e.documents).filter(d=>d.format===format);for(let start=0;start<docs.length;start+=printChunk){ %><p><a class="btn" href="/fulfilment/batches/<%= batch.id %>/print?format=<%= format %>&amp;offset=<%= start %>" target="_blank" rel="noopener"><%= format==='PDF'?'Open combined PDF':'Download combined ZPL' %> · labels <%= start+1 %>–<%= Math.min(start+printChunk,docs.length) %></a></p><% }} %>
<p class="hint">Combined PDFs retain each carrier page’s size at 300 dpi. Print at actual size. Voided and unverified labels are excluded.</p></div></section>
<div data-shipping-batch data-status-url="/fulfilment/batches/<%= batch.id %>/status" data-complete="<%= batch.complete %>" data-needs-attention="<%= batch.needsAttention %>" data-total="<%= batch.entries.length %>"></div><script src="/shipping-batch-progress.js" defer></script>