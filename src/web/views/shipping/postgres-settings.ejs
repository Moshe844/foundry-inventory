<% const providerNames={easypost:'EasyPost',shipstation:'ShipStation account',shippo:'Shippo',shipengine:'ShipStation API (ShipEngine)'};
   const keyProviders=['shipengine','shippo','shipstation'].filter(p=>providers.includes(p)),owner=currentUser.role==='owner';
   const keyHelp={shipengine:['A standalone ShipStation API key (formerly ShipEngine): open API Management in that dashboard and copy the key. Test keys start with TEST_.','https://www.shipengine.com/docs/auth/'],
     shippo:['In Shippo, open Settings → API and copy your API token. Test tokens start with shippo_test_.','https://docs.goshippo.com/guides/authentication'],
     shipstation:['Your existing ShipStation account: in ShipStation open Account → API Settings, choose V2 API and generate a key. API access depends on your ShipStation plan; sandbox keys start with TEST_.','https://help.shipstation.com/hc/articles/360025856212']}; %>
<link rel="stylesheet" href="/orders-ui.css?v=<%= locals.assetVersion||'current' %>">
<% const connectedAny=shippingAccounts.length>0,openKey=locals.openKeyForm; %>
<div class="ox ox-ship" data-ox-page>
<div class="ox-head"><div><h1 class="ox-title">Shipping</h1>
  <p class="ox-sub">Print shipping labels right from your orders. Postage is billed to your own shipping account.</p></div></div>

<% if(locals.returnTo){ %><div class="ship-return" data-ship-return><span>Connect an account below and you'll go straight back to your order.</span><a class="ox-btn ox-btn--ghost ox-btn--sm" href="<%= returnTo %>">Back to the order</a></div><% } %>
<ol class="ship-how" aria-label="How shipping works">
  <li class="<%= connectedAny?'is-done':'is-now' %>"><span>1</span><div><strong>Connect your shipping account</strong><small><%= connectedAny?'Done · '+shippingAccounts.map(a=>a.providerName).join(', '):'Once, below' %></small></div></li>
  <li class="<%= connectedAny?'is-now':'' %>"><span>2</span><div><strong>Open an order and enter the weight</strong><small>Its Fulfilment card shows rates from your account</small></div></li>
  <li><span>3</span><div><strong>Pick a rate, print, hand over</strong><small>Stock leaves when the parcel is handed over</small></div></li>
</ol>
<% if(connectedAny){ %><p class="ship-how__go"><a class="ox-btn ox-btn--primary" href="/orders">Go to orders to ship</a></p><% } %>

<section class="ox-card ship-acct" aria-label="Connected shipping accounts">
  <div class="ship-acct__h"><h2><%= connectedAny ? (shippingAccounts.every(a=>a.testMode)?'Sandbox connected':'Your shipping account') : 'Connect your shipping account' %></h2>
    <p><%= connectedAny?'Every order you ship gets rates from '+(shippingAccounts.length>1?'these accounts':'this account')+'. Labels you buy are charged to it.':'Pick the way that matches the account you already have. Your key is encrypted and belongs only to this business.' %></p></div>
  <% shippingAccounts.forEach(function(connected){ %>
  <article class="ox-ship__account" id="account-<%= connected.connectorId %>" aria-label="<%= connected.providerName %> account">
    <div class="ox-ship__account-main"><strong><%= connected.providerName %></strong> <span class="ox-badge <%= connected.testMode?'ox-badge--amber':'ox-badge--green' %>"><%= connected.testMode?'Test labels only':'Live account' %></span>
      <p><%= connected.testMode?'Test labels cannot be used for real parcels and do not charge real postage.':'Labels you buy are billed to this account.' %>
        <span role="status"><%= connected.webhookSetup?.status==='CONNECTED'?'Tracking updates arrive automatically.':connected.webhookSetup?.status==='POLLING'?'Tracking is checked automatically.':connected.webhookSetup?.status==='REVIEW'?'Tracking update setup needs attention; tracking is still checked regularly.':'Setting up automatic tracking updates.' %></span></p>
      <details class="ox-more"><summary>Advanced connection details</summary>
        <p>Platform: <%= connected.providerName %> · key ending <%= connected.keyEnding %></p>
        <p>Tracking webhook: <code style="overflow-wrap:anywhere"><%= connected.webhookUrl %></code></p>
        <p><%= connected.hasWebhookSecret?'Carrier event verification is configured for this business.':'StockChief will configure carrier event verification automatically.' %></p>
      </details></div>
    <% if(owner){ %><form method="post" action="/settings/shipping/account/disconnect" data-busy data-confirm="Disconnect this account? Existing labels and shipment history remain.">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="connectorId" value="<%= connected.connectorId %>">
      <button class="ox-btn ox-btn--ghost ox-btn--sm" type="submit">Disconnect <%= connected.providerName %></button>
    </form><% } %>
  </article>
  <% }); %>
  <div class="ship-ways" id="account">
    <% if(connectedAny){ %><h3 class="ship-ways__h">Add another account</h3><% } %>
    <% if(locals.shippoLink){ %>
    <div class="ship-way <%= connectedAny?'':'is-primary' %>">
      <div><strong>Link your Shippo account <span class="ox-badge ox-badge--blue">Easiest</span></strong><p>Sign in to Shippo and approve. No keys to copy.</p></div>
      <% if(owner){ %><a class="ox-btn <%= connectedAny?'ox-btn--secondary':'ox-btn--primary' %>" href="/settings/shipping/shippo/connect<%= locals.returnTo?'?returnTo='+encodeURIComponent(returnTo):'' %>">Link Shippo account</a><% } %>
    </div>
    <% } %>
    <details class="ship-way ship-way--key" id="existing-carrier-connection" <%= openKey?'open':'' %>>
      <summary><div><strong>Connect with an API key</strong><p>For ShipStation, its API (ShipEngine) or Shippo: copy the key from that account and paste it here.</p></div><span class="ox-btn ox-btn--secondary ship-way__open">Use an API key</span></summary>
    <% if(owner){ %><form method="post" action="/settings/shipping/account" class="ox-ship__form" data-busy data-key-form>
      <input type="hidden" name="_csrf" value="<%= csrfToken %>"><% if(locals.returnTo){ %><input type="hidden" name="returnTo" value="<%= returnTo %>"><% } %>
      <label class="ox-ship__field"><span id="shipping-provider-label">Shipping platform</span><select name="provider" required data-key-provider aria-labelledby="shipping-provider-label">
        <% keyProviders.forEach(function(provider){ %><option value="<%= provider %>" <%= locals.selectedProvider===provider?'selected':'' %>><%= providerNames[provider] %></option><% }); %></select></label>
      <% keyProviders.forEach(function(provider){ %><p class="ox-ship__help" data-key-help="<%= provider %>" <%= (locals.selectedProvider||keyProviders[0])===provider?'':'hidden' %>><%= keyHelp[provider][0] %> <a href="<%= keyHelp[provider][1] %>" target="_blank" rel="noopener noreferrer">How to find it</a></p><% }); %>
      <label class="ox-ship__field"><span id="shipping-key-label">API key</span><input type="password" name="apiKey" aria-labelledby="shipping-key-label" required autocomplete="off"></label>
      <label class="ox-ship__field ox-ship__field--minor"><span>Webhook secret (optional)</span><input type="password" name="webhookSecret" autocomplete="off"></label>
      <button class="ox-btn ox-btn--primary" type="submit">Verify and connect</button>
      <p class="ox-ship__fine">StockChief checks the key before saving it. Connecting the same platform again replaces only its saved key.</p>
    </form><% }else{ %><p class="ox-ship__fine">Only an owner can connect a shipping account.</p><% } %>
    </details>
    <div class="ship-way">
      <div><strong>ShipStation Custom Store</strong><p>Keep printing labels in ShipStation: it pulls your StockChief orders and sends tracking back.<% if(locals.customStore){ %> <strong>Connected</strong> · StockChief connection details are ready to enter in ShipStation.<% } %></p></div>
      <% if(owner){ %><form method="post" action="/settings/shipping/shipstation-custom"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><% if(locals.returnTo){ %><input type="hidden" name="returnTo" value="<%= returnTo %>"><% } %><button class="ox-btn ox-btn--secondary" type="submit"><%= locals.customStore?'View and copy connection details':'Set up Custom Store' %></button></form><% } %>
    </div>
  </div>
</section>

<div class="ship-prefs-h"><h2>Optional preferences</h2><p>You don't need any of these to ship. They only shape which rate is suggested and how much can be spent.</p></div>
<div class="ship-prefs">
<% if(account.connected){ %>
<section class="ox-card ox-ship__card" id="handling">
  <div class="ox-ship__card-h"><h2>Choosing a rate</h2><p>Comparing rates never buys postage.<% if (locals.agentRates) { %> StockChief picks the cheapest rate that arrives by the date promised on the order.<%= agentRates.mode === 'suggest' ? ' You approve each label with one tap.' : agentRates.mode === 'alone' ? ' It chooses on its own.' : '' %><% } else { %> Every label is bought by a person.<% } %></p></div>
  <% if (locals.agentRates && agentRates.canTeach) { %>
  <form method="post" action="/settings/shipping/agent-rates" class="ox-ship__form" data-busy data-agent-rates>
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <label class="ox-ship__choice"><input type="checkbox" name="enabled" <%= agentRates.ruleEnabled ? 'checked' : '' %>><span><strong>Let StockChief choose on its own</strong><small>Without this, it suggests a rate until you approve one. This uses one of your saved rules.</small></span></label>
    <button class="ox-btn ox-btn--secondary" type="submit">Save</button>
  </form>
  <% } %>
  <form method="post" action="/settings/shipping/operation-mode" class="ox-ship__form" data-busy>
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <div class="ox-ship__choices">
      <% [['MANUAL','Manual','I pick from the rates myself.'],['RECOMMEND','Recommend','StockChief highlights the best rate; I approve the label.']].forEach(function(choice){ %>
      <label class="ox-ship__choice"><input type="radio" name="mode" value="<%= choice[0] %>" <%= operationPolicy.mode===choice[0]?'checked':'' %>><span><strong><%= choice[1] %></strong><small><%= choice[2] %></small></span></label><% }); %>
    </div>
    <button class="ox-btn ox-btn--secondary" type="submit">Save handling</button>
  </form>
</section>
<% } %>

<section class="ox-card ox-ship__card" id="rules">
  <div class="ox-ship__card-h"><h2>Preferred carriers <small>optional</small></h2><p>Tell StockChief which rates you prefer; matching rates are marked when you ship.</p></div>
  <% if(rules.length){ %><ul class="ox-ship__rules"><% rules.forEach(function(rule){ %><li><span><strong><%= rule.name %></strong><%= rule.active?'':' · Off' %><% if(rule.maxDeliveryDays!=null){ %> · Within <%= rule.maxDeliveryDays %> delivery days<% } %></span>
    <% if(rule.active){ %><form method="post" action="/settings/shipping/<%= rule.id %>/remove"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="ox-btn ox-btn--ghost ox-btn--sm" type="submit">Turn off</button></form><% } %></li><% }); %></ul><% } %>
  <form method="post" action="/settings/shipping" class="ox-ship__form" data-busy>
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <div class="ox-ship__grid">
      <label class="ox-ship__field"><span>Carrier (optional)</span><select name="carrier"><option value="">Any carrier</option><% carriers.forEach(function(carrier){ %><option value="<%= carrier.code %>"><%= carrier.name %></option><% }); %></select></label>
      <label class="ox-ship__field"><span>Service (optional)</span><input name="service" maxlength="160" placeholder="e.g. Ground"></label>
      <label class="ox-ship__field"><span>Only when it costs less than</span><input name="maxCost" inputmode="decimal" placeholder="25.00"></label>
      <label class="ox-ship__field"><span>Maximum delivery days (optional)</span><input type="number" name="maxDeliveryDays" min="1" max="30"></label>
    </div>
    <details class="ox-more"><summary>Weight limits</summary><div class="ox-ship__grid">
      <label class="ox-ship__field"><span>Minimum parcel weight, grams (optional)</span><input type="number" name="minWeightGrams" min="1" max="2147483647" step="1"></label>
      <label class="ox-ship__field"><span>Maximum parcel weight, grams (optional)</span><input type="number" name="maxWeightGrams" min="1" max="2147483647" step="1"></label></div></details>
    <label class="ox-ship__check"><input type="checkbox" name="requireByPromised"> Must arrive by the promised date</label>
    <button class="ox-btn ox-btn--secondary" type="submit">Save this rule</button>
  </form>
</section>

<section class="ox-card ox-ship__card" id="limits">
  <div class="ox-ship__card-h"><h2>Postage spending limits <small>optional</small></h2><p>Caps on what can be spent on labels, including batches. Blank means no limit beyond your own approval.</p></div>
  <form method="post" action="/settings/shipping/limits" class="ox-ship__form" data-busy><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="currency" value="<%= purchaseLimits?.currency||currency %>">
    <div class="ox-ship__grid">
      <label class="ox-ship__field"><span>Maximum per parcel (<%= purchaseLimits?.currency||currency %>)</span><input name="perLabel" inputmode="decimal" value="<%= purchaseLimits?.per_label_minor!=null?fromMinor(purchaseLimits.per_label_minor,purchaseLimits.currency):'' %>" <%= owner?'':'disabled' %>></label>
      <label class="ox-ship__field"><span>Maximum over any 24 hours (<%= purchaseLimits?.currency||currency %>)</span><input name="rollingDay" inputmode="decimal" value="<%= purchaseLimits?.rolling_day_minor!=null?fromMinor(purchaseLimits.rolling_day_minor,purchaseLimits.currency):'' %>" <%= owner?'':'disabled' %>></label>
    </div>
    <% if(owner){ %><button class="ox-btn ox-btn--secondary" type="submit">Save postage limits</button><% } %>
  </form>
</section></div>
<p class="ox-ship__fine">Buying a label does not move stock. Stock leaves once, when you confirm the parcel was handed to the carrier; voiding an unused label changes nothing.</p>
</div>
<script>(()=>{const form=document.querySelector('[data-key-form]');if(!form)return;const select=form.querySelector('[data-key-provider]');const show=()=>form.querySelectorAll('[data-key-help]').forEach(p=>p.hidden=p.dataset.keyHelp!==select.value);select.addEventListener('change',show);show();})();</script>
