<% const providerNames={easypost:'EasyPost',shipstation:'ShipStation',shippo:'Shippo',shipengine:'ShipEngine'}; %>
<header class="rm-head">
  <p class="rm-head__eyebrow">Shipping</p>
  <h1>Your shipping accounts, managed in StockChief</h1>
  <p>Connect this business’s own accounts. StockChief compares their available rates; the provider bills your business directly for approved postage.</p>
</header>

<section class="card section" aria-label="Connected shipping accounts">
  <div class="card-head"><div><h2><%= shippingAccounts.length ? (shippingAccounts.every(a=>a.testMode)?'Sandbox connected':'Connected shipping accounts') : 'Connect a shipping account' %></h2>
    <p class="hint">Each account is encrypted and belongs only to this inventory. Connecting another provider keeps your existing connections.</p></div></div>
  <% if(!shippingAccounts.length){ %><div class="card-body"><p>No shipping accounts are connected yet. Add EasyPost, ShipStation or Shippo below.</p></div><% } %>
  <% shippingAccounts.forEach(function(connected){ %>
  <article class="card-body stack" aria-label="<%= connected.providerName %> account">
    <h3><%= connected.providerName %> <span class="badge <%= connected.testMode?'badge--warn':'badge--ok' %>"><%= connected.testMode?'Test labels only':'Live account' %></span></h3>
    <p><%= connected.testMode?'Test labels cannot be used for real parcels and do not charge real postage.':'Approved labels are billed to your connected provider account.' %></p>
    <p role="status"><%= connected.webhookSetup?.status==='CONNECTED'?'Automatic carrier updates are registered. StockChief also checks tracking periodically.':connected.webhookSetup?.status==='POLLING'?'This provider’s test environment uses automatic tracking checks.':connected.webhookSetup?.status==='REVIEW'?'Carrier update registration needs attention. Automatic tracking checks continue.':'StockChief is setting up automatic carrier updates.' %></p>
    <details class="disclose"><summary><span>Advanced connection details</span><span class="disclose__cue">Show</span></summary>
      <div class="disclose__body t-sm">Platform: <%= connected.providerName %> · key ending <%= connected.keyEnding %>
        <p>Tracking webhook: <code style="overflow-wrap:anywhere"><%= connected.webhookUrl %></code></p>
        <p><%= connected.hasWebhookSecret?'Carrier event verification is configured for this business.':'StockChief will configure carrier event verification automatically.' %></p>
      </div>
    </details>
    <form method="post" action="/settings/shipping/account/disconnect" data-busy data-confirm="Disconnect this account? Existing labels and shipment history remain.">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="connectorId" value="<%= connected.connectorId %>">
      <button class="btn btn--ghost" type="submit">Disconnect <%= connected.providerName %></button>
    </form>
  </article>
  <% }); %>
</section>

<section class="card section" id="account">
  <div class="card-head"><div><h2><%= shippingAccounts.length?'Add or update a shipping account':'Use your existing shipping account' %></h2>
    <p class="hint">Choose the shipping platform your business uses. Your carrier contracts and billing stay with you.</p></div></div>
  <div class="card-body">
  <details class="disclose" id="existing-carrier-connection"><summary><span>Connect with a shipping-platform key</span><span class="disclose__cue">Show</span></summary>
    <div class="disclose__body">
      <form method="post" action="/settings/shipping/account" class="stack" data-busy>
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <label class="field"><span class="field-label" id="shipping-provider-label">Shipping platform</span><select class="select" name="provider" required aria-labelledby="shipping-provider-label">
          <% ['easypost','shipstation','shippo','shipengine'].filter(p=>providers.includes(p)).forEach(function(provider){ %>
          <option value="<%= provider %>"><%= providerNames[provider] %></option><% }); %>
        </select></label>
        <label class="field"><span class="field-label" id="shipping-key-label">API key</span><input class="input" type="password" name="apiKey" required autocomplete="off" aria-labelledby="shipping-key-label">
          <span class="field-help">Use a test key to try shipping without real postage. ShipStation requires a V2 API key; sandbox keys start with TEST_.</span></label>
        <label class="field"><span class="field-label">Webhook secret <small>(optional)</small></span><input class="input" type="password" name="webhookSecret" autocomplete="off"></label>
        <p class="hint">Updating an existing provider replaces only its saved key. Rates quoted on the old key must be refreshed before buying a label.</p>
        <button class="btn btn--primary" type="submit">Verify and connect</button>
      </form>
      <p class="hint">Key setup: <a href="https://docs.easypost.com/docs/authentication" target="_blank" rel="noopener noreferrer">EasyPost</a> ·
        <a href="https://docs.shipstation.com/authentication" target="_blank" rel="noopener noreferrer">ShipStation V2</a> ·
        <a href="https://docs.goshippo.com/guides/authentication" target="_blank" rel="noopener noreferrer">Shippo</a>.</p>
    </div>
  </details>
  </div>
</section>

<% if(account.connected){ %>
<section class="card section" id="handling">
  <div class="card-head"><div><h2>How StockChief handles shipping</h2><p class="hint">Comparing rates buys no postage. Every label purchase needs the appropriate permission and approval.</p></div></div>
  <form method="post" action="/settings/shipping/operation-mode" data-busy>
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <div class="card-body choice-grid">
      <% [['MANUAL','Manual','Choose from the available rates yourself.'],['RECOMMEND','Recommend','StockChief highlights the lowest current price; you approve the label.']].forEach(function(choice){ %>
      <label class="choice"><input type="radio" name="mode" value="<%= choice[0] %>" <%= operationPolicy.mode===choice[0]?'checked':'' %>>
        <span class="choice-body"><strong><%= choice[1] %></strong><span><%= choice[2] %></span></span></label><% }); %>
    </div><div class="card-foot"><button class="btn btn--primary" type="submit">Save handling</button></div>
  </form>
</section>
<% } %>

<section class="card section" id="rules">
  <div class="card-head"><div><h2>Shipping preferences</h2><p class="hint">Save the carrier, price and delivery limits you want StockChief to consider.</p></div></div>
  <div class="card-body stack">
    <% rules.forEach(function(rule){ %><div class="planning-item"><strong><%= rule.name %></strong> <%= rule.active?'':'· Off' %>
      <% if(rule.active){ %><form method="post" action="/settings/shipping/<%= rule.id %>/remove"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="btn btn--ghost" type="submit">Turn off</button></form><% } %>
    </div><% }); %>
    <form method="post" action="/settings/shipping" class="stack" data-busy>
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <label class="field"><span class="field-label">Carrier (optional)</span><select class="select" name="carrier"><option value="">Any carrier</option>
        <% carriers.forEach(function(carrier){ %><option value="<%= carrier.code %>"><%= carrier.name %></option><% }); %>
      </select></label>
      <label class="field"><span class="field-label">Service (optional)</span><input class="input" name="service" maxlength="160"></label>
      <label class="field"><span class="field-label">Only when it costs less than</span><input class="input" name="maxCost" inputmode="decimal" placeholder="25.00"></label>
      <label class="field"><span class="field-label">Maximum delivery days (optional)</span><input class="input" type="number" name="maxDeliveryDays" min="1" max="30"></label>
      <label class="choice"><input type="checkbox" name="requireByPromised"><span>Must arrive by the promised date</span></label>
      <button class="btn btn--primary" type="submit">Save this rule</button>
    </form>
  </div>
</section>

<section class="card section"><div class="card-body"><h2>When inventory changes</h2>
  <p>A label does not mean the goods have left. StockChief deducts stock once when you confirm physical handoff. Voiding an unused label leaves stock unchanged. Goods already shipped come back through a confirmed physical return.</p>
</div></section>
