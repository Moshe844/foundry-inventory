<section class="rm-head"><div><p class="rm-head__eyebrow">Shipping</p><h1>Buy labels together</h1><p>Choose a current carrier offer for each packed parcel. Your own connected postage accounts pay the providers. Stock changes only when the goods leave.</p></div></section>
<section class="card section"><div class="card-body">
<% if(!candidates.length){ %><p>No parcels have current offers ready to buy. Prepare and measure parcels, then compare their carrier rates.</p><a href="/fulfilment">Back to fulfilment</a><% }else{ const grouped=new Map();for(const row of candidates){if(!grouped.has(row.id))grouped.set(row.id,[]);grouped.get(row.id).push(row);} %>
<form method="post" action="/fulfilment/batches"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="idempotencyKey" value="<%= requestKey %>"><input type="hidden" name="currency" value="<%= currency %>">
<% for(const [id,rates] of grouped){ %><div class="field"><label for="rate-<%= id %>"><a href="/fulfilment/<%= id %>"><%= rates[0].shipment_number %></a></label><select class="select" id="rate-<%= id %>" name="choices[<%= id %>]"><option value="">Leave this parcel out</option><% for(const rate of rates){ %><option value="<%= rate.rate_id %>"><%= rate.provider %> · <%= rate.carrier %> <%= rate.service %> · <%= helpers.money(rate.amount_minor,rate.currency) %></option><% } %></select></div><% } %>
<div class="field"><label for="batch-limit">Maximum total postage (<%= currency %>)</label><input class="input" id="batch-limit" name="maxCost" inputmode="decimal" required><p class="hint">The quoted total must fit this limit. Carrier increases stop the affected purchase for review.</p></div>
<label><input type="checkbox" name="confirmed" value="yes" required> I approve the selected postage purchases from this business’s own accounts.</label><p><button class="btn btn--primary" type="submit">Approve and queue these labels</button></p></form><% } %>
</div></section>
