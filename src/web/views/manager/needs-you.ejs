<%
  // One list, not one section per internal mechanism. Every entry answers the
  // same four questions, so the page can be read straight down without knowing
  // what a physical event or a work item is.
  var items = locals.inbox || [];
  var totalLabel = items.length === 1 ? '1 thing needs you' : items.length + ' things need you';
%>

<header class="needs-you-hero">
  <div>
    <div class="eyebrow">Only the things Foundry cannot settle itself</div>
    <h1>Needs you</h1>
    <p>Everything else, Foundry is getting on with.</p>
  </div>
  <div class="needs-you-total <%= items.length ? 'has-work' : 'is-clear' %>">
    <span><%- helpers.icon(items.length ? 'attention' : 'check', { size: 18 }) %></span>
    <strong><%= items.length ? totalLabel : 'Nothing is waiting' %></strong>
  </div>
</header>

<% if (!items.length) { %>
  <div class="card section">
    <div class="card-body">
      <div class="needs-empty">
        <span class="needs-empty__icon"><%- helpers.icon('check', { size: 17 }) %></span>
        <div>
          <strong>Nothing is waiting</strong>
          <p>
            You do not need to watch Foundry all day. When it needs something from you — a number it
            cannot know, a difference it cannot explain, or permission it does not have — it waits
            here and says why.
          </p>
        </div>
      </div>
    </div>
  </div>
<% } else { %>
  <div class="needs-inbox section">
    <% items.forEach(function (entry) { %>
      <article class="needs-item">
        <div class="needs-item__body">
          <h2><%= entry.title %></h2>
          <p class="needs-item__happened"><%= entry.happened %></p>
          <p class="needs-item__why"><%= entry.why %></p>
          <p class="needs-item__missing">
            <span class="needs-item__label">Foundry needs</span>
            <%= entry.missing %>
          </p>
        </div>
        <div class="needs-item__do">
          <a class="btn btn--primary btn--sm" href="<%= entry.href %>"><%= entry.actionLabel %></a>
        </div>
      </article>
    <% }); %>
  </div>
<% } %>
