<%
  var totalWaiting = operating.length + investigations.length + physical.length + waiting.length;
  var totalLabel = totalWaiting === 1 ? '1 thing needs you' : totalWaiting + ' things need you';
%>

<header class="needs-you-hero">
  <div>
    <div class="eyebrow">Exceptions only</div>
    <h1>Needs you</h1>
    <p>Foundry is handling everything else within the authority you approved.</p>
  </div>
  <div class="needs-you-total <%= totalWaiting ? 'has-work' : 'is-clear' %>">
    <span><%- helpers.icon(totalWaiting ? 'attention' : 'check', { size: 18 }) %></span>
    <strong><%= totalWaiting ? totalLabel : 'Nothing is waiting' %></strong>
  </div>
</header>

<div class="needs-you-queue">
  <section class="needs-section <%= operating.length ? 'needs-section--attention' : '' %>" id="operating-inputs">
    <div class="needs-section__head">
      <span class="needs-section__icon"><%- helpers.icon('activity', { size: 18 }) %></span>
      <div>
        <span class="needs-section__label">Missing operating signal</span>
        <h2>Operating inputs</h2>
      </div>
      <span class="needs-count <%= operating.length ? 'has-work' : 'is-clear' %>"><%= operating.length ? operating.length + ' waiting' : 'Clear' %></span>
    </div>

    <% if (!operating.length) { %>
      <div class="needs-empty">
        <span class="needs-empty__icon"><%- helpers.icon('check', { size: 17 }) %></span>
        <div><strong>Foundry has the inputs it needs</strong><p>No missing operating evidence currently requires you.</p></div>
      </div>
    <% } %>

    <% operating.forEach(function (entry) { %>
      <article class="needs-input">
        <div class="needs-input__mark"><%- helpers.icon('alert', { size: 20 }) %></div>
        <div class="needs-input__body">
          <span class="needs-input__kicker">Foundry is waiting for real activity</span>
          <h3><%= entry.title %></h3>
          <p><%= entry.because %></p>
          <div class="needs-input__safety">
            <%- helpers.icon('shield', { size: 16 }) %>
            <span>Foundry cannot silently observe another system or invent demand, and it will not
              raise a low-stock alert it cannot stand behind. Record sales, usage, or stock leaving
              here and it can begin learning immediately.</span>
          </div>
        </div>
        <a class="btn btn--primary needs-input__action" href="/#tell-foundry">Report a sale or movement <%- helpers.icon('chevron', { size: 15 }) %></a>
      </article>
    <% }) %>
  </section>

  <section class="needs-section">
    <div class="needs-section__head">
      <span class="needs-section__icon"><%- helpers.icon('search', { size: 18 }) %></span>
      <div><span class="needs-section__label">Physical discrepancies</span><h2>Investigations</h2></div>
      <span class="needs-count <%= investigations.length ? 'has-work' : 'is-clear' %>"><%= investigations.length ? investigations.length + ' waiting' : 'Clear' %></span>
    </div>
    <% if (!investigations.length) { %>
      <div class="needs-empty">
        <span class="needs-empty__icon"><%- helpers.icon('check', { size: 17 }) %></span>
        <div><strong>No investigations need you</strong><p>There are no unexplained inventory discrepancies waiting.</p></div>
      </div>
    <% } %>
    <% investigations.forEach(function (entry) { %>
      <a class="needs-row" href="/investigations/<%= entry.investigationId %>">
        <span class="needs-row__icon is-warn"><%- helpers.icon('alert', { size: 18 }) %></span>
        <div><strong><%= entry.affectedEntities.displayName || 'Inventory discrepancy' %></strong><p><%= entry.recommendedNextStep %></p></div>
        <span class="needs-count has-work"><%= entry.unexplainedAmount === null ? 'Review' : entry.unexplainedAmount + ' unexplained' %></span>
        <%- helpers.icon('chevron', { size: 17 }) %>
      </a>
    <% }) %>
  </section>

  <section class="needs-section">
    <div class="needs-section__head">
      <span class="needs-section__icon"><%- helpers.icon('box', { size: 18 }) %></span>
      <div><span class="needs-section__label">Reports needing context</span><h2>Physical events to match</h2></div>
      <span class="needs-count <%= physical.length ? 'has-work' : 'is-clear' %>"><%= physical.length ? physical.length + ' waiting' : 'Clear' %></span>
    </div>
    <% if (!physical.length) { %>
      <div class="needs-empty">
        <span class="needs-empty__icon"><%- helpers.icon('check', { size: 17 }) %></span>
        <div><strong>Every physical event is matched</strong><p>No reported count, receipt, or movement is missing context.</p></div>
      </div>
    <% } %>
    <% physical.forEach(function (entry) { %>
      <div class="needs-row">
        <span class="needs-row__icon is-warn"><%- helpers.icon('question', { size: 18 }) %></span>
        <div><strong><%= entry.event_type.replaceAll('_', ' ') %></strong><p><%= entry.stated_as %></p></div>
        <a class="btn btn--sm" href="/#tell-foundry">Add missing detail</a>
      </div>
    <% }) %>
  </section>

  <section class="needs-section">
    <div class="needs-section__head">
      <span class="needs-section__icon"><%- helpers.icon('shield', { size: 18 }) %></span>
      <div><span class="needs-section__label">Outside approved authority</span><h2>Decisions</h2></div>
      <span class="needs-count <%= waiting.length ? 'has-work' : 'is-clear' %>"><%= waiting.length ? waiting.length + ' waiting' : 'Clear' %></span>
    </div>
    <% if (!waiting.length) { %>
      <div class="needs-empty">
        <span class="needs-empty__icon"><%- helpers.icon('check', { size: 17 }) %></span>
        <div><strong>No decisions are waiting</strong><p>Foundry is working within the boundaries you approved.</p></div>
      </div>
    <% } %>
    <% waiting.forEach(function (entry) { %>
      <a class="needs-row" href="/autopilot/work/<%= entry.id %>">
        <span class="needs-row__icon is-warn"><%- helpers.icon('attention', { size: 18 }) %></span>
        <div><strong><%= entry.categoryLabel %></strong><p><%= entry.policyEvaluation.reason || 'Your approval is required.' %></p></div>
        <span class="needs-count has-work">Review</span><%- helpers.icon('chevron', { size: 17 }) %>
      </a>
    <% }) %>
  </section>
</div>
