<%
  /*
   * The Desk. One decision at a time, at full size.
   *
   * What this replaced was a scrolling list of cards, which is a triage
   * interface: you can read everything on it and settle nothing, and the page
   * looks the same afterwards. A stack behaves differently — it has a position,
   * it visibly shortens, and the only way to reach the end of it is to decide.
   *
   * The four questions every entry has already answered — what happened, why
   * StockChief stopped, what it recommends, what it needs — are typeset as a
   * structure rather than four paragraphs of equal weight, so the
   * recommendation is visibly the recommendation. It is the only line on the
   * screen in the accent, because it is the only line that is StockChief's
   * opinion rather than its record.
   *
   * Evidence is a disclosure inside the decision, never a link to a further
   * page. Nothing in this product is more than one story deep.
   */
  var items = locals.inbox || [];
  var at = Math.max(0, Math.min(items.length - 1, Number(locals.at || 0) || 0));
  var entry = items[at];
  var total = items.length;

  // The source fills the recommendation and the decision from one string often
  // enough that the page has to notice. Saying it once is the whole fix.
  var recommendation = entry ? (entry.recommendation || '') : '';
  var missing = entry ? (entry.missing || '') : '';
  var sameAnswer = recommendation && missing
    && recommendation.trim().toLowerCase() === missing.trim().toLowerCase();

  var nextAt = at + 1 < total ? at + 1 : null;
  var prevAt = at > 0 ? at - 1 : null;
  var pipStart = Math.max(0, Math.min(at - 5, Math.max(0, total - 12)));
  var pipEnd = Math.min(total, pipStart + 12);
%>

<% if (!total) { %>

  <p class="rm-stamp">Nothing on the desk</p>
  <h1 class="rm-verdict">Nothing is waiting for you.</h1>
  <p class="rm-prose">
    You do not have to watch StockChief. Only what it cannot settle by itself reaches you — a number
    it cannot know, a difference it cannot explain, or permission it does not have — and when that
    happens it stops there, waits here, and says why.
  </p>
  <p class="rm-choices">
    <a class="rm-btn" href="/">Back to the brief</a>
    <a class="rm-btn rm-btn--ghost" href="/ask">Ask StockChief something</a>
    <% if (currentUser.role === 'owner') { %><a class="rm-btn rm-btn--ghost" href="/repairs/report">Report something wrong</a><% } %>
  </p>

<% } else { %>

  <div class="rm-desk">
    <div class="rm-desk__count">
      <span>Decision <%= at + 1 %> of <%= total %></span>
      <span class="rm-pips" aria-hidden="true">
        <% for (var i = pipStart; i < pipEnd; i += 1) { %><span class="rm-pip <%= i < at ? 'is-done' : i === at ? 'is-now' : '' %>"></span><% } %>
      </span>
      <%# The importance badge keeps the class the rest of the product colours by,
          so orange means the same thing here as everywhere else. %>
      <% if (entry.importance === 'Urgent' || entry.importance === 'Important') { %>
        <span class="rm-desk__flag badge <%= entry.importance === 'Urgent' ? 'badge--danger' : 'badge--warn' %>"><%= entry.importance %></span>
      <% } %>
      <span class="right">
        <% if (prevAt !== null) { %><a href="/needs-you?at=<%= prevAt %>">← Back</a><% } %>
        <% if (nextAt !== null) { %><a href="/needs-you?at=<%= nextAt %>">Skip for now →</a><% } %>
      </span>
    </div>

    <h1 class="rm-h"><%= entry.title %></h1>
    <%#
      What this queue is for, said once, on the entry somebody starts at. Only
      what StockChief cannot settle by itself arrives here: a number it cannot
      know, a difference it cannot explain, or permission it does not have.
      Everything else it is getting on with.
    %>
    <% if (at === 0) { %>
      <p class="rm-stamp rm-stamp--lede">
        Only what I cannot settle myself reaches you — a number I cannot know, a difference
        I cannot explain, or permission I do not have.
      </p>
    <% } %>

    <div class="rm-qa">
      <% if (entry.happened) { %>
        <div class="rm-qa__row"><span class="rm-qa__k">What happened</span><span class="rm-qa__v"><%= entry.happened %></span></div>
      <% } %>
      <% if (entry.why) { %>
        <div class="rm-qa__row"><span class="rm-qa__k">Why I stopped</span><span class="rm-qa__v"><%= entry.why %></span></div>
      <% } %>
      <% if (recommendation && !sameAnswer) { %>
        <div class="rm-qa__row rm-qa__row--rec"><span class="rm-qa__k">What I'd do</span><span class="rm-qa__v"><%= recommendation %></span></div>
      <% } %>
      <% if (missing) { %>
        <div class="rm-qa__row"><span class="rm-qa__k">What I need</span><span class="rm-qa__v"><%= missing %></span></div>
      <% } %>
    </div>

    <div class="rm-choices">
      <a class="rm-btn" href="<%= entry.href %>"><%= entry.actionLabel %></a>
      <%#
        Saying no, in the same place as saying yes. Every decision here used to
        offer one button and it was always the one that goes ahead; a file
        uploaded twice sat in the queue twice with no way to be rid of either
        copy. A decision you can only agree to is not a decision.
      %>
      <% if (entry.dismiss) { %>
        <form method="post" action="<%= entry.dismiss.action %>"
          <%= entry.dismiss.confirm ? 'data-confirm="' + entry.dismiss.confirm + '"' : '' %>>
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <input type="hidden" name="returnTo" value="/needs-you">
          <% if (entry.dismiss.entryId) { %><input type="hidden" name="entryId" value="<%= entry.dismiss.entryId %>"><% } %>
          <button class="rm-btn rm-btn--ghost" type="submit"><%= entry.dismiss.label %></button>
        </form>
      <% } %>
      <%#
        The third choice, and the one that separates a manager from a modal:
        a decision surface you can hold a conversation with. It carries the
        entry so the question opens with what is on screen already said.
      %>
      <a class="rm-btn rm-btn--wash" href="/ask?about=<%= encodeURIComponent(entry.title) %>">Ask me something first</a>
    </div>

    <%
      /*
       * What else is in the stack, by name.
       *
       * One decision at a time is the point of this page, but a stack whose
       * contents cannot be seen is a black box: somebody who has just been told
       * a product is running out has no way to know whether the next card is
       * about the same product. Names only, no detail, each going straight to
       * its own position — visible without becoming a second queue to triage.
       */
      var rest = items.map(function (item, i) { return { item: item, index: i }; })
        .filter(function (row) { return row.index !== at; })
        .slice(0, 8);
    %>
    <% if (rest.length) { %>
      <p class="rm-stamp" style="margin-top:30px;margin-bottom:8px"><%= total - 1 %> other <%= total === 2 ? 'thing' : 'things' %> waiting</p>
      <div class="rm-feed" style="margin-top:0">
        <% rest.forEach(function (row) { var other = row.item; var i = row.index; %>
          <a class="rm-feed__row" href="/needs-you?at=<%= i %>">
            <span class="rm-feed__ic"><%= i + 1 %></span>
            <span class="rm-feed__t"><%= other.title %><% if (other.happened) { %><small><%= other.happened %></small><% } %></span>
            <span class="rm-feed__m">Open</span>
          </a>
        <% }) %>
      </div>
      <% if (total - 1 > rest.length) { %><p class="rm-disclose"><a href="/needs-you/all">See all <%= total %> decisions</a></p><% } %>
    <% } %>

    <p class="rm-disclose">
      <a href="<%= entry.href %>">The evidence behind this</a>
      <% if (nextAt !== null) { %><a href="/needs-you?at=<%= nextAt %>">Leave it and see the next one</a><% } %>
      <a href="/needs-you/all">See all <%= total %> at once</a>
      <% if (currentUser.role === 'owner') { %><a href="/repairs/report">Report something else wrong</a><% } %>
      <a href="/">Back to the brief</a>
    </p>
  </div>

<% } %>
