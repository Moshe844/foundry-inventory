<link rel="stylesheet" href="/needs-you.css?v=<%= locals.assetVersion || '' %>">
<header class="ny-head"><div><p class="eyebrow">Your decision inbox</p><h1>Needs you</h1><p>Review approvals, answer questions and resolve issues. Open any item directly.</p></div><a class="btn" href="/ask">Ask StockChief</a></header>
<%- include('coverage-warning') %>
<% if(locals.failures && failures.attempts){ %><aside class="notice notice--warn"><strong><%= failures.attempts %> background attempts need technical review.</strong> These are separate from your business decisions. <a href="/settings/operations#dead-letters">View system issues</a></aside><% } %>
<section class="ny-summary" aria-label="Inbox summary"><div><strong><%= desk.total %></strong><span>Waiting for attention</span></div><div><strong><%= desk.urgent %></strong><span>Urgent</span></div><p>Dates and times: <span data-inbox-time-zone><%= account.timeZone||'UTC' %></span>. Nothing executes merely by opening an item.</p></section>
<nav class="ny-filters" aria-label="Filter decisions"><% for(const group of desk.groups){ %><a href="<%= group.href %>" <%- desk.category===group.key?'aria-current="page"':'' %>><%= group.label %> <span><%= group.count %></span></a><% } %></nav>
<form class="ny-search" method="get" action="/needs-you" role="search"><input type="hidden" name="category" value="<%= desk.category %>"><label><span class="visually-hidden">Search decisions</span><input class="input" type="search" name="q" value="<%= desk.q %>" placeholder="Search a product, order, person or issue…"></label><label class="ny-sort"><span>Sort</span><select name="sort"><option value="priority" <%= desk.sort==='priority'?'selected':'' %>>Priority</option><option value="newest" <%= desk.sort==='newest'?'selected':'' %>>Newest first</option><option value="oldest" <%= desk.sort==='oldest'?'selected':'' %>>Oldest first</option></select></label><button class="btn" type="submit">Apply</button><% if(desk.q||desk.category!=='all'){ %><a href="/needs-you">Clear filters</a><% } %></form>
<% if(!desk.rows.length){ %><section class="ny-empty"><h2><%= desk.total?'No matching items':'You’re all caught up' %></h2><p><%= desk.total?'Try another search or category. Your other items are still waiting.':'No known business decisions are waiting for you.' %></p><a href="<%= desk.total?'/needs-you':'/' %>"><%= desk.total?'Show everything':'Back to Home' %></a></section><% }else{ %>
<p class="ny-count"><%= desk.rows.length %> of <%= desk.total %> items</p><div class="ny-list"><% for(const entry of desk.rows){ %><article class="ny-card <%= entry.id===desk.focus?'is-focused':'' %>" id="decision-<%= entry.id %>"><div class="ny-card-top"><span class="ny-kind"><%= entry.kind==='recovery'?'Workflow recovery':desk.groups.find(g=>g.key===entry.category)?.label||'Issue' %></span><span class="badge <%= entry.importance==='Urgent'?'badge--danger':entry.importance==='Important'?'badge--warn':'' %>"><%= entry.importance==='Needs You'?'Needs your decision':entry.importance||'Needs attention' %></span></div><h2><%= entry.title %></h2>
<div class="ny-times"><span><%= entry.timeLabel||'Added' %>: <% if(entry.createdAt){ %><time datetime="<%= entry.createdAt %>" data-inbox-instant><%= helpers.dateTime(entry.createdAt) %></time><% }else{ %>Time not recorded<% } %></span><% if(entry.updatedAt&&entry.updatedAt!==entry.createdAt){ %><span>Updated: <time datetime="<%= entry.updatedAt %>" data-inbox-instant><%= helpers.dateTime(entry.updatedAt) %></time></span><% } %><% if(entry.dueDate){ %><span>Due: <time datetime="<%= entry.dueDate %>"><%= helpers.shortDate(entry.dueDate) %></time></span><% } %></div>
<% if(entry.happened&&entry.happened!==entry.title){ %><p class="ny-context"><%= entry.happened %></p><% } %><% if(entry.why){ %><p class="ny-reason"><%= entry.why %></p><% } %><% if(entry.recommendation&&entry.recommendation!==entry.why){ %><p class="ny-next"><strong>Next step</strong> <%= entry.recommendation %></p><% } %>
<div class="ny-actions"><a class="btn btn--primary" href="<%= entry.href %>"><%= entry.actionLabel||'Review item' %></a><% if(entry.dismiss){ %><form method="post" action="<%= entry.dismiss.action %>" <% if(entry.dismiss.confirm){ %>data-confirm="<%= entry.dismiss.confirm %>"<% } %>><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="returnTo" value="/needs-you"><% if(entry.dismiss.entryId){ %><input type="hidden" name="entryId" value="<%= entry.dismiss.entryId %>"><% } %><button class="btn" type="submit"><%= entry.dismiss.label %></button></form><% } %></div></article><% } %></div><% } %>
<script src="/needs-you.js?v=<%= locals.assetVersion || '' %>" defer></script>
