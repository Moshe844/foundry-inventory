<link rel="stylesheet" href="/needs-you.css?v=<%= locals.assetVersion || '' %>">
<header class="ny-head"><h1>Needs you</h1>
  <p class="ny-summary" aria-label="Inbox summary"><% if(desk.total){ %><strong class="ny-total"><%= desk.total %></strong> <%= inbox.some(entry=>entry.grouped)?(desk.total===1?'decision or group':'decisions and groups'):'waiting for you' %><% if(desk.urgent){ %> · <strong class="ny-urgent"><%= desk.urgent %> urgent</strong><% } %><% }else{ %>Nothing is waiting for you.<% } %></p>
</header>
<%- include('coverage-warning') %>
<% if(locals.failures && failures.attempts){ %><aside class="notice notice--warn"><strong>Some background work could not finish.</strong> Review the affected records or contact support. <a href="/settings/operations">Review work needing attention</a></aside><% } %>
<% if(desk.groups.length>2||desk.total>=3){ %><div class="ny-tools">
  <% if(desk.groups.length>2){ %><nav class="ny-filters" aria-label="Filter decisions"><% for(const group of desk.groups){ %><a href="<%= group.href %>" <%- desk.category===group.key?'aria-current="page"':'' %>><%= group.label %> <span><%= group.count %></span></a><% } %></nav><% } %>
  <% if(desk.total>=3){ %><form class="ny-search" method="get" action="/needs-you" role="search"><input type="hidden" name="category" value="<%= desk.category %>"><label><span class="visually-hidden">Search decisions</span><input class="input" type="search" name="q" value="<%= desk.q %>" placeholder="Search"></label><% if(desk.total>=6){ %><label class="ny-sort"><span class="visually-hidden">Sort</span><select class="select" name="sort"><option value="priority" <%= desk.sort==='priority'?'selected':'' %>>Most important</option><option value="newest" <%= desk.sort==='newest'?'selected':'' %>>Newest</option><option value="oldest" <%= desk.sort==='oldest'?'selected':'' %>>Oldest</option></select></label><% } %><button class="btn" type="submit">Apply</button><% if(desk.q||desk.category!=='all'){ %><a href="/needs-you">Clear</a><% } %></form><% } %>
</div><% } %>
<% if(!desk.rows.length){ %><section class="ny-empty"><h2><%= desk.total?'No matching items':'You’re all caught up' %></h2><p><%= desk.total?'Try another search or category. Your other items are still waiting.':'No known business decisions are waiting for you.' %></p><a class="btn" href="<%= desk.total?'/needs-you':'/' %>"><%= desk.total?'Show everything':'Back to Home' %></a></section><% }else{ %>
<div class="ny-list"><% const iconOf=item=>({order:'box',shipping:'ship',purchase:'purchasing',inventory:'box',accounting:'wallet',mail:'chat',connection:'bolt',import:'import',approval:'check',recovery:'alert',clarification:'question',provider:'alert',repair:'alert'})[item.kind]||'attention'; for(const entry of desk.rows){ const lead=entry.happened&&entry.happened!==entry.title?entry.happened:entry.why; const why=lead===entry.why?null:entry.why; %><article class="ny-card <%= entry.id===desk.focus?'is-focused':'' %>" data-tone="<%= entry.importance==='Urgent'?'urgent':entry.importance==='Important'?'important':'normal' %>" id="decision-<%= entry.id %>">
  <span class="ny-icon" aria-hidden="true"><%- helpers.icon(iconOf(entry),{size:18}) %></span>
  <div class="ny-card-main">
    <div class="ny-title"><h2><%= entry.title %></h2><% if(entry.importance==='Urgent'){ %><span class="badge badge--danger">Urgent</span><% }else if(entry.importance==='Important'){ %><span class="badge badge--warn">Important</span><% } %></div>
    <% if(lead){ %><p class="ny-context"><%= lead %></p><% } %>
    <div class="ny-card-top"><span class="ny-kind"><%= entry.kind==='recovery'?'Workflow recovery':desk.groups.find(g=>g.key===entry.category)?.label||'Issue' %></span><span class="ny-times"><% if(entry.createdAt){ %><%= entry.timeLabel||'Added' %> <time datetime="<%= entry.createdAt %>" data-inbox-instant><%= helpers.dateTime(entry.createdAt) %></time><% } %><% if(entry.dueDate){ %> · Due <time datetime="<%= entry.dueDate %>"><%= helpers.shortDate(entry.dueDate) %></time><% } %></span></div>
    <% if((entry.recommendation&&entry.recommendation!==lead)||why){ %><details class="ny-why"><summary>More</summary><% if(entry.recommendation&&entry.recommendation!==lead){ %><p class="ny-next"><%= entry.recommendation %></p><% } %><% if(why&&why!==entry.recommendation){ %><p class="ny-reason"><%= why %></p><% } %></details><% } %>
  </div>
  <div class="ny-actions"><a class="btn btn--primary btn--sm" href="<%= entry.href %>"><%= entry.actionLabel||'Review item' %></a><% if(entry.dismiss){ %><form method="post" action="<%= entry.dismiss.action %>" <% if(entry.dismiss.confirm){ %>data-confirm="<%= entry.dismiss.confirm %>"<% } %>><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="returnTo" value="/needs-you"><% if(entry.dismiss.entryId){ %><input type="hidden" name="entryId" value="<%= entry.dismiss.entryId %>"><% } %><button class="btn btn--sm" type="submit"><%= entry.dismiss.label %></button></form><% } %></div>
</article><% } %></div><% } %>
<p class="ny-foot">Times are in <span data-inbox-time-zone><%= account.timeZone||'UTC' %></span>. Opening an item never changes anything.</p>
<script src="/needs-you.js?v=<%= locals.assetVersion || '' %>" defer></script>
