<link rel="stylesheet" href="/needs-you.css?v=<%= locals.assetVersion || '' %>">
<header class="ny-head" data-decision-sort="<%= desk.sort %>"><h1>Needs you</h1>
  <% if(locals.managerView){ %><a href="/reports/my-preferences">My report and approval preferences</a><% } %>
  <% if(locals.dailyBrief){ %><a href="/autopilot/reviews/daily-briefing?filter=<%= dailyBrief.date %>">Daily briefing for <%= dailyBrief.date %></a>
    <% if(dailyBrief.team){ %><a href="/autopilot/reviews/daily-team-summary?filter=<%= dailyBrief.date %>">Daily team summary</a><% } %>
  <% } %>
  <p class="ny-summary" aria-label="Inbox summary"><% if(desk.total){ %><strong class="ny-total"><%= desk.total %></strong> <%= inbox.some(entry=>entry.grouped)?(desk.total===1?'decision or group':'decisions and groups'):'waiting for you' %><% }else{ %>Nothing is waiting for you.<% } %></p>
  <% if(desk.total){ %><div class="level-counts" aria-label="Filter by level"><% for(const entry of desk.levels){ if(entry.count){ %><a class="level-count" data-tone="<%= entry.key %>" href="<%= entry.href %>" <%- entry.active?'aria-current="true"':'' %>><%= entry.count %> <%= entry.label %></a><% }} %><% if(desk.level){ %><a class="level-clear" href="/needs-you">Show every level</a><% } %></div><% } %>
</header>
<%- include('coverage-warning') %>
<% if(locals.failures && failures.attempts){ %><aside class="notice notice--warn"><strong>Some background work could not finish.</strong> Review the affected records or contact support. <a href="/settings/operations">Review work needing attention</a></aside><% } %>
<% if(desk.groups.length>2||desk.total>=3){ %><div class="ny-tools">
  <% if(desk.groups.length>2){ %><nav class="ny-filters" aria-label="Filter decisions"><% for(const group of desk.groups){ %><a href="<%= group.href %>" <%- desk.category===group.key?'aria-current="page"':'' %>><%= group.label %> <span><%= group.count %></span></a><% } %></nav><% } %>
  <% if(desk.total>=3){ %><form class="ny-search" method="get" action="/needs-you" role="search"><input type="hidden" name="category" value="<%= desk.category %>"><% if(desk.level){ %><input type="hidden" name="level" value="<%= desk.level %>"><% } %><label><span class="visually-hidden">Search decisions</span><input class="input" type="search" name="q" value="<%= desk.q %>" placeholder="Search"></label><% if(desk.total>=6){ %><label class="ny-sort"><span class="visually-hidden">Sort</span><select class="select" name="sort"><option value="priority" <%= desk.sort==='priority'?'selected':'' %>>Most important</option><option value="newest" <%= desk.sort==='newest'?'selected':'' %>>Newest</option><option value="oldest" <%= desk.sort==='oldest'?'selected':'' %>>Oldest</option></select></label><% } %><button class="btn" type="submit">Apply</button><% if(desk.q||desk.category!=='all'){ %><a href="/needs-you">Clear</a><% } %></form><% } %>
</div><% } %>
<% if(desk.rows.length&&locals.approvalGroups&&approvalGroups.length){ %><div class="ny-list" data-approval-groups><h2 class="ny-section">Approve similar ones together</h2>
<% for(const g of approvalGroups){ %><article class="ny-card" data-tone="normal" data-approval-group>
  <span class="ny-icon" aria-hidden="true"><%- helpers.icon('check',{size:16}) %></span>
  <div class="ny-card-main">
    <div class="ny-title"><h2><%= g.label %></h2><span class="level-label" data-tone="normal"><%= g.count %> waiting</span></div>
    <p class="ny-context">Each one is checked on its own. Any that cannot go through stay here with the reason.</p>
    <div class="ny-card-top"><details class="ny-why"><summary>Show all <%= g.count %></summary><% for(const i of g.items){ %><p><a href="<%= i.href %>"><%= i.title %></a></p><% } %></details></div>
  </div>
  <div class="ny-actions"><form method="post" action="/needs-you/groups"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="group" value="<%= g.key %>"><input type="hidden" name="token" value="<%= approvalGroupToken %>"><input type="hidden" name="decision" value="approve"><% for(const i of g.items){ %><input type="hidden" name="keys" value="<%= i.key %>"><% } %><button class="btn btn--sm btn--primary" type="submit">Approve all <%= g.count %></button></form>
  <% if(g.decline){ %><form method="post" action="/needs-you/groups" data-confirm="Decline all <%= g.count %>? Each one is cancelled and nothing else changes."><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="group" value="<%= g.key %>"><input type="hidden" name="token" value="<%= approvalGroupToken %>"><input type="hidden" name="decision" value="decline"><% for(const i of g.items){ %><input type="hidden" name="keys" value="<%= i.key %>"><% } %><button class="btn btn--sm" type="submit">Decline all <%= g.count %></button></form><% } %></div>
</article><% } %></div><% } %>
<% if(!desk.rows.length){ %><section class="ny-empty"><h2><%= desk.total?'No matching items':'You’re all caught up' %></h2><p><%= desk.total?'Try another search or category. Your other items are still waiting.':'No known business decisions are waiting for you.' %></p><a class="btn" href="<%= desk.total?'/needs-you':'/' %>"><%= desk.total?'Show everything':'Back to Home' %></a></section><% }else{ %>
<% const sectionOf=entry=>entry.question||entry.category==='clarification'?'asking':entry.category==='approval'&&entry.kind!=='recovery'?'approve':entry.category==='connection'||entry.kind==='recovery'?'fix':'review',sectionNames={approve:'Approve',fix:'Fix',asking:'StockChief is asking',review:'Review'},sectionIcons={approve:'check',fix:'bolt',asking:'question'},iconFor=entry=>sectionIcons[sectionOf(entry)]||({inventory:'box',accounting:'wallet',orders:'ship',mail:'chat'})[entry.category]||'attention',ordered=desk.sort==='priority'||!desk.sort?['approve','fix','review','asking'].flatMap(key=>desk.rows.filter(entry=>sectionOf(entry)===key)):desk.rows;let lastSection=null; %>
<div class="ny-list" <% if(!locals.showAllDecisions){ %>data-show-batch="6"<% } %><%- desk.focus?' data-show-focus="#decision-'+desk.focus+'"':'' %>><% for(const entry of ordered){ if((desk.sort==='priority'||!desk.sort)&&sectionOf(entry)!==lastSection){lastSection=sectionOf(entry); %><h2 class="ny-section" data-batch-heading><%= sectionNames[lastSection] %></h2><% } const lead=entry.happened&&entry.happened!==entry.title?entry.happened:entry.why; const why=lead===entry.why?null:entry.why; %><article class="ny-card <%= entry.id===desk.focus?'is-focused':'' %>" data-tone="<%= entry.importance==='Urgent'?'urgent':entry.importance==='Important'?'important':'normal' %>" id="decision-<%= entry.id %>">
  <span class="ny-icon" aria-hidden="true"><%- helpers.icon(iconFor(entry),{size:16}) %></span>
  <div class="ny-card-main">
    <div class="ny-title"><h2><%= entry.title %></h2><span class="level-label" data-tone="<%= entry.importance==='Urgent'?'urgent':entry.importance==='Important'?'important':'normal' %>"><%= entry.importance==='Urgent'?'Urgent':entry.importance==='Important'?'Important':'Normal' %></span></div>
    <% if(lead){ %><p class="ny-context"><%= lead %></p><% } %>
    <div class="ny-card-top"><span class="ny-kind"><%= entry.kind==='recovery'?'Workflow recovery':desk.groups.find(g=>g.key===entry.category)?.label||'Issue' %></span><span class="ny-times"><% if(entry.createdAt){ %><%= entry.timeLabel||'Added' %> <time datetime="<%= entry.createdAt %>" data-inbox-instant><%= helpers.dateTime(entry.createdAt) %></time><% } %><% if(entry.dueDate){ %> · Due <time datetime="<%= entry.dueDate %>"><%= helpers.shortDate(entry.dueDate) %></time><% } %></span><% if((entry.recommendation&&entry.recommendation!==lead)||why){ %><details class="ny-why"><summary>More</summary><dl class="ny-explain"><% if(lead){ %><div><dt>What’s wrong</dt><dd><%= lead %></dd></div><% } %><% if(why&&why!==entry.recommendation){ %><div><dt>Why it matters</dt><dd><%= why %></dd></div><% } %><% if(entry.recommendation&&entry.recommendation!==lead){ %><div><dt>What StockChief recommends</dt><dd class="ny-next"><%= entry.recommendation %></dd></div><% } %><div><dt>What’s needed from you</dt><dd><%= entry.actionLabel||'Review item' %></dd></div></dl></details><% } %></div>
  </div>
  <div class="ny-actions"><a class="btn btn--sm ny-action" href="<%= entry.href %>"><%= entry.actionLabel||'Review item' %></a><% if(entry.dismiss){ %><form method="post" action="<%= entry.dismiss.action %>" <% if(entry.dismiss.confirm){ %>data-confirm="<%= entry.dismiss.confirm %>"<% } %>><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="returnTo" value="/needs-you"><% if(entry.dismiss.entryId){ %><input type="hidden" name="entryId" value="<%= entry.dismiss.entryId %>"><% } %><button class="btn btn--sm" type="submit"><%= entry.dismiss.label %></button></form><% } %></div>
</article><% } %></div><% } %>
<p class="ny-foot">Times are in <span data-inbox-time-zone><%= account.timeZone||'UTC' %></span>. Opening an item never changes anything.</p>
<script src="/needs-you.js?v=<%= locals.assetVersion || '' %>" defer></script>
