<%
  var expected = investigation.observedDifference.expected;
  var observed = investigation.observedDifference.observed;
  var measured = Number.isFinite(Number(expected)) && Number.isFinite(Number(observed));
  var difference = measured ? Number(observed) - Number(expected) : null;
  var differenceSize = difference === null ? null : Math.abs(difference);
  var differenceLabel = difference === null ? 'Unknown difference' : difference < 0
    ? differenceSize + ' fewer than recorded'
    : difference > 0 ? differenceSize + ' more than recorded' : 'Count matches';
  var open = ['OPEN', 'INVESTIGATING', 'NEEDS_HUMAN', 'INCONCLUSIVE'].includes(investigation.status);
  var statusLabel = investigation.status === 'RESOLVED' ? 'Resolved' : 'Needs confirmation';
  // A count on a sku and location with no ledger at all is an opening balance,
  // not a discrepancy, and the only thing that resolves it is receiving stock.
  var openingBalance = investigation.trigger === 'opening_balance_declared';
  var eventLabels = {
    opened: 'Report received',
    opening_balance_declared: 'Recognised as opening stock',
    investigating: 'Compared with inventory records',
    evidence_reviewed: 'Evidence checked',
    inconclusive: 'More detail needed',
    resolved: 'Resolved by you',
    resolved_by_reconciliation: 'Count reconciled',
  };
%>

<nav class="breadcrumb" aria-label="Breadcrumb">
  <a href="/needs-you">Needs you</a><span>›</span><span>Investigation</span>
</nav>

<header class="investigation-hero">
  <div class="investigation-hero__mark" aria-hidden="true"><%- helpers.icon('alert', { size: 21 }) %></div>
  <div class="investigation-hero__copy">
    <div class="investigation-hero__meta">
      <span class="badge <%= investigation.status === 'RESOLVED' ? 'badge--ok' : 'badge--warn' %>"><%= statusLabel %></span>
      <span><%= openingBalance ? 'Opening stock not recorded yet' : 'Physical count discrepancy' %></span>
    </div>
    <h1><%= investigation.affectedEntities.displayName || 'Inventory discrepancy' %></h1>
  </div>
</header>

<div class="investigation-layout section">
  <main class="investigation-main">
    <section class="card investigation-summary">
      <div class="card-head">
        <div>
          <span class="investigation-kicker">What Foundry found</span>
          <h2><%= openingBalance
            ? 'This is the first time anything has been counted here'
            : 'The physical count does not match the inventory record' %></h2>
        </div>
      </div>
      <div class="card-body">
        <% if (openingBalance) { %>
          <div class="count-equation" aria-label="You reported <%= observed %> on hand; nothing was recorded before">
            <div class="count-equation__value">
              <span>You reported</span>
              <strong><%= observed ?? '—' %></strong>
              <small>on hand</small>
            </div>
            <div class="count-equation__operator" aria-hidden="true">→</div>
            <div class="count-equation__result">
              <span>On the ledger</span>
              <strong>0</strong>
              <small>nothing recorded yet</small>
            </div>
          </div>
        <% } else { %>
        <div class="count-equation" aria-label="Recorded <%= expected ?? 'unknown' %>, physically counted <%= observed ?? 'unknown' %>, <%= differenceLabel %>">
          <div class="count-equation__value">
            <span>Recorded</span>
            <strong><%= expected ?? '—' %></strong>
            <small>in Foundry</small>
          </div>
          <div class="count-equation__operator" aria-hidden="true">→</div>
          <div class="count-equation__value">
            <span>Counted</span>
            <strong><%= observed ?? '—' %></strong>
            <small>reported physically</small>
          </div>
          <div class="count-equation__operator" aria-hidden="true">=</div>
          <div class="count-equation__result <%= difference === 0 ? 'is-match' : '' %>">
            <span>Difference</span>
            <strong><%= differenceSize ?? '—' %></strong>
            <small><%= differenceLabel %></small>
          </div>
        </div>
        <% } %>

        <div class="investigation-explanation">
          <span class="investigation-explanation__icon"><%- helpers.icon('activity', { size: 17 }) %></span>
          <div>
            <% if (openingBalance) { %>
              <strong>There is no difference to explain.</strong>
              <p>Foundry has never recorded a sale, transfer, receipt or adjustment for this product at this location, so the recorded 0 is not a measurement — it is the absence of one. Your count is the opening quantity, and receiving it is what puts it on the ledger.</p>
            <% } else if (!investigation.hypotheses.length) { %>
              <strong>No recorded event explains the difference yet.</strong>
              <p>Foundry checked the ledger and found no sale, transfer, receipt or adjustment that accounts for these <%= differenceSize ?? 'missing' %> units. It will not invent a cause.</p>
            <% } else { %>
              <strong>Foundry found evidence worth reviewing.</strong>
              <% investigation.hypotheses.forEach(function (hypothesis) { %>
                <p><%= hypothesis.statement %> <span class="muted">Confidence: <%= hypothesis.confidence %>.</span></p>
              <% }) %>
            <% } %>
          </div>
        </div>
      </div>
    </section>

    <section class="card investigation-trail section">
      <div class="card-head">
        <div>
          <span class="investigation-kicker">Audit trail</span>
          <h2>What happened</h2>
        </div>
      </div>
      <div class="investigation-timeline">
        <% events.forEach(function (event, index) { %>
          <div class="investigation-event">
            <span class="investigation-event__marker <%= index === events.length - 1 ? 'is-current' : '' %>" aria-hidden="true"></span>
            <div>
              <strong><%= eventLabels[event.event] || helpers.columnLabel(event.event.replaceAll('_', ' ')) %></strong>
              <time datetime="<%= event.createdAt %>"><%= new Date(event.createdAt).toLocaleString() %></time>
            </div>
          </div>
        <% }) %>
      </div>
    </section>
  </main>

  <aside class="card investigation-decision">
    <% if (open && openingBalance) { %>
      <div class="card-head">
        <div>
          <span class="investigation-kicker">One decision</span>
          <h2>Record this as opening stock</h2>
        </div>
      </div>
      <div class="card-body">
        <p class="investigation-decision__lead">
          Nothing has ever moved through <%= investigation.affectedEntities.displayName || 'this product' %>
          at this location, so there is no record for your count to disagree with.
          Receiving these <%= observed %> puts them on the ledger with you as the source.
        </p>
        <div class="investigation-safety">
          <%- helpers.icon('alert', { size: 16 }) %>
          <span>Foundry will not write this balance by itself. Receiving is the step that makes it real, and it stays in Activity with your name on it.</span>
        </div>
        <% if (investigation.affectedEntities.itemId) { %>
          <a class="btn btn--primary btn--block" href="/inventory/<%= investigation.affectedEntities.itemId %>?action=receive&skuId=<%= encodeURIComponent(investigation.affectedEntities.skuId || '') %>&locationId=<%= encodeURIComponent(investigation.affectedEntities.locationId || '') %>&quantity=<%= observed %>">
            <%- helpers.icon('check', { size: 16 }) %> Receive <%= observed %> into stock
          </a>
        <% } %>
        <form method="post" action="/investigations/<%= investigation.investigationId %>/resolve" style="margin-top:12px;">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <label class="field">
            <span class="label">Or close this without recording stock — why?</span>
            <textarea class="textarea" name="note" rows="3" required placeholder="Example: reported in error, these bags belong to another site."></textarea>
          </label>
          <button class="btn btn--block" type="submit">Close without recording stock</button>
        </form>
      </div>
    <% } else if (open) { %>
      <div class="card-head">
        <div>
          <span class="investigation-kicker">One decision</span>
          <h2>Confirm the physical count</h2>
        </div>
      </div>
      <div class="card-body">
        <p class="investigation-decision__lead">
          Only settle this after somebody has counted again or found reliable evidence.
          Say which of the two numbers is right.
        </p>
        <div class="investigation-safety">
          <%- helpers.icon('shield', { size: 16 }) %>
          <span>
            Neither button changes stock. Confirming the count prepares the correction
            from <strong><%= expected %></strong> to <strong><%= observed %></strong> and asks you to approve
            it, exactly like any other correction.
          </span>
        </div>

        <%# The count was right: prepare the ordinary correction, carrying the
            evidence and the words it was confirmed with into it. %>
        <form method="post" action="/investigations/<%= investigation.investigationId %>/resolve">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <input type="hidden" name="correct" value="1">
          <label class="field">
            <span class="label">What confirmed the count?</span>
            <textarea class="textarea" name="note" rows="4" required
                      placeholder="Example: Jamie counted the shelf again and confirmed <%= observed %>."></textarea>
          </label>
          <button class="btn btn--primary btn--block" type="submit">
            <%- helpers.icon('check', { size: 16 }) %>
            The count is right — prepare the correction to <%= observed %>
          </button>
        </form>

        <%# The records were right, or it is not settled yet. Closes the
            investigation and leaves the ledger alone. %>
        <form method="post" action="/investigations/<%= investigation.investigationId %>/resolve" style="margin-top:14px;">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <label class="field">
            <span class="label">Or the records were right — why?</span>
            <textarea class="textarea" name="note" rows="3" required
                      placeholder="Example: the miscount was mine, the shelf really does hold <%= expected %>."></textarea>
          </label>
          <button class="btn btn--block" type="submit">Close without changing stock</button>
        </form>
      </div>
    <% } else { %>
      <div class="card-body investigation-resolved">
        <span class="investigation-resolved__icon"><%- helpers.icon('check', { size: 22 }) %></span>
        <h2>Investigation resolved</h2>
        <p>The evidence remains in the audit trail. Inventory was not silently adjusted.</p>
        <a class="btn btn--block" href="/needs-you">Back to Needs you</a>
      </div>
    <% } %>
  </aside>
</div>
