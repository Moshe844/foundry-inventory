<a class="back-link" href="/needs-you">‹ Needs you</a><h1>Inventory findings</h1><p><%= total.toLocaleString('en-US') %> findings. Highest recorded stock value first, then priority. This is the value of stock involved, not an estimated purchase cost.</p>
<form method="get"><input type="hidden" name="category" value="<%= category %>"><input type="hidden" name="location" value="<%= location %>"><label>Search item, variant or SKU <input name="q" value="<%= q %>" maxlength="120"></label><button class="btn">Search</button></form>
<% for(const row of rows){ %><article class="sc-business-card"><h2><%= row.title %></h2><p><%= row.product||'' %><%= row.variant_label?' — '+row.variant_label:'' %> <%= row.code||'' %></p><p><%= row.concise_summary %></p><p><%= row.recommendation %></p><% if(row.stock_value!=null){ %><p>Recorded stock value involved: <%= helpers.money(Number(row.stock_value),currency) %></p><% } %><% if(row.item_id){ %><a class="btn btn--primary" href="/inventory/<%= row.item_id %>?finding=<%= encodeURIComponent(row.id) %>">See what to do</a><% } %></article><% } %>
<%- include('../partials/pager') %>
