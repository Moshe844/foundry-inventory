<header class="page-head"><h1>Replenishment decisions</h1><p><%= total.toLocaleString() %> decisions. Highest known purchase values first, then urgency. <a href="/needs-you">Back to Needs you</a></p></header>
<form method="get" action="/needs-you/work"><input type="hidden" name="kind" value="<%= kind %>"><input type="hidden" name="location" value="<%= location %>"><input type="hidden" name="currency" value="<%= currency %>"><label>Search product or SKU <input class="input" type="search" name="q" value="<%= q %>"></label><button class="btn" type="submit">Search</button></form>
<div class="table-wrap"><table class="table"><thead><tr><th>Product / variant</th><th>Quantity</th><th>Destination</th><th>Estimated purchase value</th><th>Review</th></tr></thead><tbody><% for(const row of rows){ %><tr><td><%= row.action.displayName %> <small><%= row.action.code %></small></td><td><%= row.action.quantity %></td><td><%= row.action.destinationLocationName||'Choose a location' %></td><td><%= row.money==null?'Not priced':new Intl.NumberFormat('en-US',{style:'currency',currency:row.currency||'USD'}).format(Number(row.money)) %></td><td><a href="/autopilot/work/<%= row.id %>">Review decision</a></td></tr><% } %></tbody></table></div>
<% const link=p=>'/needs-you/work?'+new URLSearchParams({kind,location,currency,q,page:p}); %><nav aria-label="Decision pages"><% if(page>1){ %><a href="<%= link(page-1) %>">Previous</a><% } %> Page <%= page %> <% if(hasMore){ %><a href="<%= link(page+1) %>">Next</a><% } %></nav>
