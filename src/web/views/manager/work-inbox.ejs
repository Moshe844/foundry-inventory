<header class="page-head"><div><h1><%= kind==='transfer'?'Stock transfer decisions':'Replenishment decisions' %></h1><p><%= total.toLocaleString() %> decisions. Highest known purchase values first, then urgency.</p></div><a class="btn" href="/needs-you">Back to Needs you</a></header>
<form method="get" action="/needs-you/work" class="wi-search"><input type="hidden" name="kind" value="<%= kind %>"><input type="hidden" name="location" value="<%= location %>"><input type="hidden" name="currency" value="<%= currency %>"><label>Search product or SKU <input class="input" type="search" name="q" value="<%= q %>"></label><button class="btn" type="submit">Search</button></form>
<% const choose=rows.filter(r=>r.action.quantityScope==='workspace'&&!r.action.destinationLocationId),places=choose[0]?.action.receivingOptions||[]; %>
<form method="post" action="/needs-you/work/approve" data-bulk-approve data-confirm="Approve the selected decisions? Each one creates its purchase order or transfer."><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="kind" value="<%= kind %>"><input type="hidden" name="location" value="<%= location %>"><input type="hidden" name="currency" value="<%= currency %>">
<div class="wi-bar"><label class="wi-all"><input type="checkbox" data-bulk-all aria-label="Select every decision on this page"> Select all on this page</label><span data-bulk-count>None selected</span><% if(choose.length){ %><label class="wi-where">Deliver to<select name="destinationLocationId" data-bulk-where><option value="">Choose a receiving location</option><% for(const place of places){ %><option value="<%= place.id %>"><%= place.name %></option><% } %></select></label><% } %><button class="btn btn--primary" type="submit" data-bulk-submit disabled>Approve selected</button></div>
<div class="table-wrap"><table class="table"><thead><tr><th><span class="visually-hidden">Select</span></th><th>Product / variant</th><th>Why</th><th>Quantity</th><th>From</th><th>Destination</th><th>Estimated purchase value</th><th>Review</th></tr></thead><tbody><% for(const row of rows){ const fact=name=>(row.evidence||[]).find(e=>e.fact===name)?.value; %><tr><td><input type="checkbox" name="ids" value="<%= row.id %>" aria-label="Select <%= row.action.displayName %>" data-bulk-row></td><td><%= row.action.displayName %> <small><%= row.action.code %></small></td><td><% if(fact('available')!==undefined){ %><%= fact('available') %> available<% if(fact('reorder_point')!==undefined){ %>, reorder at <%= fact('reorder_point') %><% } %><% }else{ %>—<% } %></td><td><%= row.action.quantity %></td><td><%= row.action.supplierName||row.action.sourceLocationName||'—' %></td><td><%= row.action.destinationLocationName&&row.action.destinationLocationId?row.action.destinationLocationName:'Choose a location' %></td><td><%= row.money==null?'Not priced':new Intl.NumberFormat('en-US',{style:'currency',currency:row.currency||'USD'}).format(Number(row.money)) %></td><td><a href="/autopilot/work/<%= row.id %>">Review decision</a></td></tr><% } %></tbody></table></div>
</form>
<%- include('../partials/pager') %>
<script src="/work-inbox.js?v=<%= locals.assetVersion || '' %>" defer></script>
