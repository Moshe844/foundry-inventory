{
  "AWSTemplateFormatVersion": "2010-09-09",
  "Description": "StockChief database migration target: retain the source while qualifying an encrypted PostgreSQL standby and colocated imports.",
  "Metadata": {
    "AWSToolsMetrics": {
      "AWSAgentToolkit": "aws-cloudformation@3"
    },
    "com.aws.cloudformation.Context": {
      "ref": [
        "README.md"
      ],
      "must": [
        "Create only after the reviewed recurring cost and service/network choices are approved.",
        "Keep live checkout and approved commercial entitlements unchanged."
      ]
    }
  },
  "Parameters": {
    "NamePrefix": {
      "Type": "String",
      "Default": "stockchief-production",
      "AllowedPattern": "[a-z][a-z0-9-]{2,29}",
      "Description": "Unique deployment prefix; existing databases are never replaced by this preparation."
    },
    "DatabaseName": {
      "Type": "String",
      "Default": "stockchief",
      "AllowedPattern": "[a-zA-Z][a-zA-Z0-9_]{0,62}"
    },
    "EngineVersion": {
      "Type": "String",
      "Default": "17.11",
      "AllowedPattern": "17\\.[0-9]+",
      "Description": "Latest available PostgreSQL 17 minor verified in the selected Region; preserve the source major for this migration."
    },
    "DatabaseClass": {
      "Type": "String",
      "Default": "db.m7g.xlarge",
      "AllowedValues": [
        "db.m7g.large",
        "db.m7g.xlarge"
      ],
      "Description": "Reviewed non-burstable choices: 2 vCPU/8 GiB or 4 vCPU/16 GiB. The class remains subject to cost approval and qualification."
    },
    "DeploymentPhase": {
      "Type": "String",
      "Default": "qualification",
      "AllowedValues": [
        "qualification",
        "production"
      ],
      "Description": "Rehearse on the isolated target first; production enables a synchronous standby in another zone."
    },
    "AllocatedStorage": {
      "Type": "Number",
      "Default": 50,
      "AllowedValues": [
        50
      ]
    },
    "MaxAllocatedStorage": {
      "Type": "Number",
      "Default": 100,
      "AllowedValues": [
        100
      ],
      "Description": "Storage autoscaling ceiling, shared across customers. The database cannot shrink after growth."
    },
    "AllowRestrictedRenderAccess": {
      "Type": "String",
      "Default": "false",
      "AllowedValues": [
        "false",
        "true"
      ],
      "Description": "Explicitly approved exception for the Render-hosted application. False keeps the endpoint private; true requires confirmed Render outbound CIDRs."
    },
    "RenderCidr1": {
      "Type": "String",
      "Default": "",
      "AllowedPattern": "^$|^([0-9]{1,3}\\.){3}[0-9]{1,3}/(1[6-9]|2[0-9]|3[0-2])$",
      "Description": "Verified Render outbound range only; never the internet. Leave unused entries empty."
    },
    "RenderCidr2": {
      "Type": "String",
      "Default": "",
      "AllowedPattern": "^$|^([0-9]{1,3}\\.){3}[0-9]{1,3}/(1[6-9]|2[0-9]|3[0-2])$",
      "Description": "Verified Render outbound range only; never the internet. Leave unused entries empty."
    },
    "RenderCidr3": {
      "Type": "String",
      "Default": "",
      "AllowedPattern": "^$|^([0-9]{1,3}\\.){3}[0-9]{1,3}/(1[6-9]|2[0-9]|3[0-2])$",
      "Description": "Verified Render outbound range only; never the internet. Leave unused entries empty."
    },
    "RenderCidr4": {
      "Type": "String",
      "Default": "",
      "AllowedPattern": "^$|^([0-9]{1,3}\\.){3}[0-9]{1,3}/(1[6-9]|2[0-9]|3[0-2])$",
      "Description": "Verified Render outbound range only; never the internet. Leave unused entries empty."
    },
    "RenderCidr5": {
      "Type": "String",
      "Default": "",
      "AllowedPattern": "^$|^([0-9]{1,3}\\.){3}[0-9]{1,3}/(1[6-9]|2[0-9]|3[0-2])$",
      "Description": "Verified Render outbound range only; never the internet. Leave unused entries empty."
    },
    "RenderCidr6": {
      "Type": "String",
      "Default": "",
      "AllowedPattern": "^$|^([0-9]{1,3}\\.){3}[0-9]{1,3}/(1[6-9]|2[0-9]|3[0-2])$",
      "Description": "Verified Render outbound range only; never the internet. Leave unused entries empty."
    },
    "RenderCidr7": {
      "Type": "String",
      "Default": "",
      "AllowedPattern": "^$|^([0-9]{1,3}\\.){3}[0-9]{1,3}/(1[6-9]|2[0-9]|3[0-2])$",
      "Description": "Verified Render outbound range only; never the internet. Leave unused entries empty."
    },
    "RenderCidr8": {
      "Type": "String",
      "Default": "",
      "AllowedPattern": "^$|^([0-9]{1,3}\\.){3}[0-9]{1,3}/(1[6-9]|2[0-9]|3[0-2])$",
      "Description": "Verified Render outbound range only; never the internet. Leave unused entries empty."
    }
  },
  "Conditions": {
    "RestrictedRenderAccess": {
      "Fn::Equals": [
        {
          "Ref": "AllowRestrictedRenderAccess"
        },
        "true"
      ]
    },
    "Production": {
      "Fn::Equals": [
        {
          "Ref": "DeploymentPhase"
        },
        "production"
      ]
    },
    "RenderRange1": {
      "Fn::And": [
        {
          "Condition": "RestrictedRenderAccess"
        },
        {
          "Fn::Not": [
            {
              "Fn::Equals": [
                {
                  "Ref": "RenderCidr1"
                },
                ""
              ]
            }
          ]
        }
      ]
    },
    "RenderRange2": {
      "Fn::And": [
        {
          "Condition": "RestrictedRenderAccess"
        },
        {
          "Fn::Not": [
            {
              "Fn::Equals": [
                {
                  "Ref": "RenderCidr2"
                },
                ""
              ]
            }
          ]
        }
      ]
    },
    "RenderRange3": {
      "Fn::And": [
        {
          "Condition": "RestrictedRenderAccess"
        },
        {
          "Fn::Not": [
            {
              "Fn::Equals": [
                {
                  "Ref": "RenderCidr3"
                },
                ""
              ]
            }
          ]
        }
      ]
    },
    "RenderRange4": {
      "Fn::And": [
        {
          "Condition": "RestrictedRenderAccess"
        },
        {
          "Fn::Not": [
            {
              "Fn::Equals": [
                {
                  "Ref": "RenderCidr4"
                },
                ""
              ]
            }
          ]
        }
      ]
    },
    "RenderRange5": {
      "Fn::And": [
        {
          "Condition": "RestrictedRenderAccess"
        },
        {
          "Fn::Not": [
            {
              "Fn::Equals": [
                {
                  "Ref": "RenderCidr5"
                },
                ""
              ]
            }
          ]
        }
      ]
    },
    "RenderRange6": {
      "Fn::And": [
        {
          "Condition": "RestrictedRenderAccess"
        },
        {
          "Fn::Not": [
            {
              "Fn::Equals": [
                {
                  "Ref": "RenderCidr6"
                },
                ""
              ]
            }
          ]
        }
      ]
    },
    "RenderRange7": {
      "Fn::And": [
        {
          "Condition": "RestrictedRenderAccess"
        },
        {
          "Fn::Not": [
            {
              "Fn::Equals": [
                {
                  "Ref": "RenderCidr7"
                },
                ""
              ]
            }
          ]
        }
      ]
    },
    "RenderRange8": {
      "Fn::And": [
        {
          "Condition": "RestrictedRenderAccess"
        },
        {
          "Fn::Not": [
            {
              "Fn::Equals": [
                {
                  "Ref": "RenderCidr8"
                },
                ""
              ]
            }
          ]
        }
      ]
    }
  },
  "Rules": {
    "SelectedRegion": {
      "Assertions": [
        {
          "Assert": {
            "Fn::Equals": [
              {
                "Ref": "AWS::Region"
              },
              "us-east-2"
            ]
          },
          "AssertDescription": "This project is assigned to us-east-2."
        }
      ]
    },
    "RenderException": {
      "RuleCondition": {
        "Fn::Equals": [
          {
            "Ref": "AllowRestrictedRenderAccess"
          },
          "true"
        ]
      },
      "Assertions": [
        {
          "Assert": {
            "Fn::Not": [
              {
                "Fn::Equals": [
                  {
                    "Ref": "RenderCidr1"
                  },
                  ""
                ]
              }
            ]
          },
          "AssertDescription": "Restricted public access requires a verified Render outbound range."
        }
      ]
    }
  },
  "Resources": {
    "Network": {
      "Type": "AWS::EC2::VPC",
      "Properties": {
        "CidrBlock": "10.85.0.0/16",
        "EnableDnsSupport": true,
        "EnableDnsHostnames": true
      },
      "Metadata": {
        "com.aws.cloudformation.Context": {
          "why": "Colocate the database and import tasks; no public database access by default.",
          "must": [
            "Only the assigned Region; do not attach other customer networks."
          ]
        }
      }
    },
    "Gateway": {
      "Type": "AWS::EC2::InternetGateway",
      "Properties": {},
      "Metadata": {
        "com.aws.cloudformation.Context": {
          "why": "Outbound AWS service access for import tasks without a permanently charged NAT gateway.",
          "must": []
        }
      }
    },
    "GatewayAttachment": {
      "Type": "AWS::EC2::VPCGatewayAttachment",
      "Properties": {
        "VpcId": {
          "Ref": "Network"
        },
        "InternetGatewayId": {
          "Ref": "Gateway"
        }
      },
      "Metadata": {
        "com.aws.cloudformation.Context": {
          "why": "Public task IPs carry outbound connections only; task security groups accept no inbound connections.",
          "must": []
        }
      }
    },
    "Subnet0": {
      "Type": "AWS::EC2::Subnet",
      "Properties": {
        "VpcId": {
          "Ref": "Network"
        },
        "CidrBlock": "10.85.0.0/24",
        "AvailabilityZone": {
          "Fn::Select": [
            0,
            {
              "Fn::GetAZs": ""
            }
          ]
        },
        "MapPublicIpOnLaunch": false
      },
      "Metadata": {
        "com.aws.cloudformation.Context": {
          "why": "Distinct availability zones support database failover.",
          "must": [
            "RDS remains private unless the reviewed Render exception is explicitly enabled."
          ]
        }
      }
    },
    "Subnet1": {
      "Type": "AWS::EC2::Subnet",
      "Properties": {
        "VpcId": {
          "Ref": "Network"
        },
        "CidrBlock": "10.85.1.0/24",
        "AvailabilityZone": {
          "Fn::Select": [
            1,
            {
              "Fn::GetAZs": ""
            }
          ]
        },
        "MapPublicIpOnLaunch": false
      },
      "Metadata": {
        "com.aws.cloudformation.Context": {
          "why": "Distinct availability zones support database failover.",
          "must": [
            "RDS remains private unless the reviewed Render exception is explicitly enabled."
          ]
        }
      }
    },
    "Routes": {
      "Type": "AWS::EC2::RouteTable",
      "Properties": {
        "VpcId": {
          "Ref": "Network"
        }
      },
      "Metadata": {
        "com.aws.cloudformation.Context": {
          "why": "Shared outbound routing; no NAT gateway or public listener.",
          "must": []
        }
      }
    },
    "InternetRoute": {
      "Type": "AWS::EC2::Route",
      "Properties": {
        "RouteTableId": {
          "Ref": "Routes"
        },
        "DestinationCidrBlock": "0.0.0.0/0",
        "GatewayId": {
          "Ref": "Gateway"
        }
      },
      "Metadata": {
        "com.aws.cloudformation.Context": {
          "why": "Egress route for tasks explicitly assigned a public IP.",
          "must": []
        }
      },
      "DependsOn": "GatewayAttachment"
    },
    "RouteAssociation0": {
      "Type": "AWS::EC2::SubnetRouteTableAssociation",
      "Properties": {
        "SubnetId": {
          "Ref": "Subnet0"
        },
        "RouteTableId": {
          "Ref": "Routes"
        }
      },
      "Metadata": {
        "com.aws.cloudformation.Context": {
          "why": "Associate both database/task subnets with the same reviewed routing.",
          "must": []
        }
      }
    },
    "RouteAssociation1": {
      "Type": "AWS::EC2::SubnetRouteTableAssociation",
      "Properties": {
        "SubnetId": {
          "Ref": "Subnet1"
        },
        "RouteTableId": {
          "Ref": "Routes"
        }
      },
      "Metadata": {
        "com.aws.cloudformation.Context": {
          "why": "Associate both database/task subnets with the same reviewed routing.",
          "must": []
        }
      }
    },
    "ClientFirewall": {
      "Type": "AWS::EC2::SecurityGroup",
      "Properties": {
        "VpcId": {
          "Ref": "Network"
        },
        "GroupDescription": "StockChief import tasks: no inbound traffic",
        "SecurityGroupEgress": [
          {
            "IpProtocol": "tcp",
            "FromPort": 443,
            "ToPort": 443,
            "CidrIp": "0.0.0.0/0"
          }
        ]
      },
      "Metadata": {
        "com.aws.cloudformation.Context": {
          "why": "Task identity grants private database access; HTTPS reaches S3, SQS and image endpoints.",
          "must": [
            "No ingress rules; database access is restricted to the database group."
          ]
        }
      }
    },
    "DatabaseFirewall": {
      "Type": "AWS::EC2::SecurityGroup",
      "Properties": {
        "VpcId": {
          "Ref": "Network"
        },
        "GroupDescription": "StockChief database: import tasks and explicitly approved Render ranges only",
        "SecurityGroupIngress": [
          {
            "IpProtocol": "tcp",
            "FromPort": 5432,
            "ToPort": 5432,
            "SourceSecurityGroupId": {
              "Ref": "ClientFirewall"
            }
          }
        ],
        "SecurityGroupEgress": [
          {
            "IpProtocol": "-1",
            "CidrIp": "127.0.0.1/32"
          }
        ]
      },
      "Metadata": {
        "com.aws.cloudformation.Context": {
          "why": "Private task traffic is allowed by security-group identity, not a shared internet range.",
          "must": [
            "Never allow 0.0.0.0/0 or ::/0 to PostgreSQL."
          ]
        }
      }
    },
    "ClientDatabaseEgress": {
      "Type": "AWS::EC2::SecurityGroupEgress",
      "Properties": {
        "GroupId": {
          "Ref": "ClientFirewall"
        },
        "IpProtocol": "tcp",
        "FromPort": 5432,
        "ToPort": 5432,
        "DestinationSecurityGroupId": {
          "Ref": "DatabaseFirewall"
        }
      },
      "Metadata": {
        "com.aws.cloudformation.Context": {
          "why": "Avoid a security-group dependency cycle while restricting database egress.",
          "must": []
        }
      }
    },
    "RenderIngress1": {
      "Type": "AWS::EC2::SecurityGroupIngress",
      "Properties": {
        "GroupId": {
          "Ref": "DatabaseFirewall"
        },
        "IpProtocol": "tcp",
        "FromPort": 5432,
        "ToPort": 5432,
        "CidrIp": {
          "Ref": "RenderCidr1"
        }
      },
      "Metadata": {
        "com.aws.cloudformation.Context": {
          "why": "Opt-in connectivity from a verified Render region; TLS and database authentication remain mandatory.",
          "must": [
            "Requires explicit network approval and a confirmed outbound CIDR."
          ]
        }
      },
      "Condition": "RenderRange1"
    },
    "RenderIngress2": {
      "Type": "AWS::EC2::SecurityGroupIngress",
      "Properties": {
        "GroupId": {
          "Ref": "DatabaseFirewall"
        },
        "IpProtocol": "tcp",
        "FromPort": 5432,
        "ToPort": 5432,
        "CidrIp": {
          "Ref": "RenderCidr2"
        }
      },
      "Metadata": {
        "com.aws.cloudformation.Context": {
          "why": "Opt-in connectivity from a verified Render region; TLS and database authentication remain mandatory.",
          "must": [
            "Requires explicit network approval and a confirmed outbound CIDR."
          ]
        }
      },
      "Condition": "RenderRange2"
    },
    "RenderIngress3": {
      "Type": "AWS::EC2::SecurityGroupIngress",
      "Properties": {
        "GroupId": {
          "Ref": "DatabaseFirewall"
        },
        "IpProtocol": "tcp",
        "FromPort": 5432,
