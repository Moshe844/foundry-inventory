    "DataKey": {
      "Type": "AWS::KMS::Key",
      "Properties": {
        "Description": "StockChief database, managed credentials and migration evidence",
        "EnableKeyRotation": true,
        "PendingWindowInDays": 30,
        "KeyPolicy": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Sid": "EnableProjectIamPermissions",
              "Effect": "Allow",
              "Principal": {
                "AWS": {
                  "Fn::Sub": "arn:${AWS::Partition}:iam::${AWS::AccountId}:root"
                }
              },
              "Action": "kms:*",
              "Resource": "*"
            },
            {
              "Sid": "EncryptDatabaseLogs",
              "Effect": "Allow",
              "Principal": {
                "Service": {
                  "Fn::Sub": "logs.${AWS::Region}.amazonaws.com"
                }
              },
              "Action": [
                "kms:Encrypt*",
                "kms:Decrypt*",
                "kms:ReEncrypt*",
                "kms:GenerateDataKey*",
                "kms:Describe*"
              ],
              "Resource": "*",
              "Condition": {
                "ArnEquals": {
                  "kms:EncryptionContext:aws:logs:arn": {
                    "Fn::Sub": "arn:${AWS::Partition}:logs:${AWS::Region}:${AWS::AccountId}:log-group:/aws/rds/instance/${NamePrefix}-postgres/postgresql"
                  }
                }
              }
            }
          ]
        }
      },
      "Metadata": {
        "com.aws.cloudformation.Context": {
          "why": "Retain decryptability of database backups, credentials and migration evidence.",
          "must": [
            "Do not delete the key while retained data exists."
          ]
        }
      },
      "DeletionPolicy": "Retain",
      "UpdateReplacePolicy": "Retain"
    },
    "DatabaseLogs": {
      "Type": "AWS::Logs::LogGroup",
      "Properties": {
        "LogGroupName": {
          "Fn::Sub": "/aws/rds/instance/${NamePrefix}-postgres/postgresql"
        },
        "KmsKeyId": {
          "Fn::GetAtt": [
            "DataKey",
            "Arn"
          ]
        },
        "RetentionInDays": 14
      },
      "Metadata": {
        "com.aws.cloudformation.Context": {
          "why": "Encrypted database security/slow-query logs with bounded retention.",
          "must": []
        }
      },
      "DeletionPolicy": "Retain",
      "UpdateReplacePolicy": "Retain"
    },
    "Parameters": {
      "Type": "AWS::RDS::DBParameterGroup",
      "Properties": {
        "Family": "postgres17",
        "Description": "StockChief: verified TLS and normalized performance diagnostics",
        "Parameters": {
          "rds.force_ssl": "1",
          "shared_preload_libraries": "pg_stat_statements",
          "track_io_timing": "1",
          "pg_stat_statements.track_utility": "0",
          "log_parameter_max_length": "0",
          "log_parameter_max_length_on_error": "0"
        }
      },
      "Metadata": {
        "com.aws.cloudformation.Context": {
          "why": "Preserve PostgreSQL semantics and measure database work without logging bind values.",
          "must": [
            "TLS cannot be disabled; do not log passwords or customer query parameters."
          ]
        }
      }
    },
    "DatabaseSubnets": {
      "Type": "AWS::RDS::DBSubnetGroup",
      "Properties": {
        "DBSubnetGroupDescription": "Two-zone StockChief database subnets",
        "SubnetIds": [
          {
            "Ref": "Subnet0"
          },
          {
            "Ref": "Subnet1"
          }
        ]
      },
      "Metadata": {
        "com.aws.cloudformation.Context": {
          "why": "Automatic standby failover requires at least two availability zones.",
          "must": []
        }
      }
    },
    "Database": {
      "Type": "AWS::RDS::DBInstance",
      "Properties": {
        "DBInstanceIdentifier": {
          "Fn::Sub": "${NamePrefix}-postgres"
        },
        "DBName": {
          "Ref": "DatabaseName"
        },
        "Engine": "postgres",
        "EngineVersion": {
          "Ref": "EngineVersion"
        },
        "DBInstanceClass": {
          "Ref": "DatabaseClass"
        },
        "Port": 5432,
        "AllocatedStorage": {
          "Ref": "AllocatedStorage"
        },
        "MaxAllocatedStorage": {
          "Ref": "MaxAllocatedStorage"
        },
        "StorageType": "gp3",
        "StorageEncrypted": true,
        "KmsKeyId": {
          "Fn::GetAtt": [
            "DataKey",
            "Arn"
          ]
        },
        "MultiAZ": {
          "Fn::If": [
            "Production",
            true,
            false
          ]
        },
        "PubliclyAccessible": {
          "Fn::If": [
            "RestrictedRenderAccess",
            true,
            false
          ]
        },
        "VPCSecurityGroups": [
          {
            "Ref": "DatabaseFirewall"
          }
        ],
        "DBSubnetGroupName": {
          "Ref": "DatabaseSubnets"
        },
        "DBParameterGroupName": {
          "Ref": "Parameters"
        },
        "MasterUsername": "sc_database_owner",
        "ManageMasterUserPassword": true,
        "MasterUserSecret": {
          "KmsKeyId": {
            "Fn::GetAtt": [
              "DataKey",
              "Arn"
            ]
          }
        },
        "BackupRetentionPeriod": 7,
        "DeletionProtection": true,
        "AutoMinorVersionUpgrade": true,
        "AllowMajorVersionUpgrade": false,
        "CopyTagsToSnapshot": true,
        "EnablePerformanceInsights": true,
        "PerformanceInsightsRetentionPeriod": 7,
        "PerformanceInsightsKMSKeyId": {
          "Fn::GetAtt": [
            "DataKey",
            "Arn"
          ]
        },
        "EnableCloudwatchLogsExports": [
          "postgresql"
        ],
        "Tags": [
          {
            "Key": "created_by",
            "Value": "rds-oss-skill"
          },
          {
            "Key": "generation_model",
            "Value": "unknown"
          },
          {
            "Key": "workload",
            "Value": "stockchief"
          },
          {
            "Key": "phase",
            "Value": {
              "Ref": "DeploymentPhase"
            }
          }
        ]
      },
      "Metadata": {
        "com.aws.cloudformation.Context": {
          "why": "Managed PostgreSQL retains transactions, advisory locks, unique constraints and exact numeric behavior.",
          "must": [
            "Source remains authoritative until restore, correctness, performance and connection checks pass.",
            "Retain the source and snapshots through the approved recovery window.",
            "No major-version upgrade during this move."
          ]
        }
      },
      "DeletionPolicy": "Retain",
      "UpdateReplacePolicy": "Retain",
      "DependsOn": "DatabaseLogs"
    },
    "ApplicationSecret": {
      "Type": "AWS::SecretsManager::Secret",
      "Properties": {
        "KmsKeyId": {
          "Fn::GetAtt": [
            "DataKey",
            "Arn"
          ]
        },
        "Description": "StockChief database-scoped application role; bootstrap before starting any worker",
        "GenerateSecretString": {
          "SecretStringTemplate": "{\"username\":\"stockchief_runtime\"}",
          "GenerateStringKey": "password",
          "PasswordLength": 40,
          "ExcludePunctuation": true
        }
      },
      "Metadata": {
        "com.aws.cloudformation.Context": {
          "why": "Use a database-scoped application role rather than the RDS owner in web/worker processes.",
          "must": [
            "No plaintext credentials in parameters, repository, outputs or logs."
          ]
        }
      },
      "DeletionPolicy": "Retain",
      "UpdateReplacePolicy": "Retain"
    },
    "ApplicationSecretAttachment": {
      "Type": "AWS::SecretsManager::SecretTargetAttachment",
      "Properties": {
        "SecretId": {
          "Ref": "ApplicationSecret"
        },
        "TargetId": {
          "Ref": "Database"
        },
        "TargetType": "AWS::RDS::DBInstance"
      },
      "Metadata": {
        "com.aws.cloudformation.Context": {
          "why": "Attach endpoint metadata only; this does not create the application role or restore records.",
          "must": [
            "A verified bootstrap/restore must create the database-scoped role before activation."
          ]
        }
      }
    },
    "MigrationEvidence": {
      "Type": "AWS::S3::Bucket",
      "Properties": {
        "BucketEncryption": {
          "ServerSideEncryptionConfiguration": [
            {
              "ServerSideEncryptionByDefault": {
                "SSEAlgorithm": "aws:kms",
                "KMSMasterKeyID": {
                  "Fn::GetAtt": [
                    "DataKey",
                    "Arn"
                  ]
                }
              }
            }
          ]
        },
        "PublicAccessBlockConfiguration": {
          "BlockPublicAcls": true,
          "BlockPublicPolicy": true,
          "IgnorePublicAcls": true,
          "RestrictPublicBuckets": true
        },
        "VersioningConfiguration": {
          "Status": "Enabled"
        },
        "OwnershipControls": {
          "Rules": [
            {
              "ObjectOwnership": "BucketOwnerEnforced"
            }
          ]
        },
        "LifecycleConfiguration": {
          "Rules": [
            {
              "Id": "IncompleteTransfersOnly",
              "Status": "Enabled",
              "AbortIncompleteMultipartUpload": {
                "DaysAfterInitiation": 7
              }
            }
          ]
        }
      },
      "Metadata": {
        "com.aws.cloudformation.Context": {
          "why": "Keep a versioned, encrypted migration snapshot and verification manifest without automatic deletion of valid evidence.",
          "must": [
            "No public downloads; use scoped roles and frozen object versions."
          ]
        }
      },
      "DeletionPolicy": "Retain",
      "UpdateReplacePolicy": "Retain"
    },
    "MigrationEvidencePolicy": {
      "Type": "AWS::S3::BucketPolicy",
      "Properties": {
        "Bucket": {
          "Ref": "MigrationEvidence"
        },
        "PolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Effect": "Deny",
              "Principal": "*",
              "Action": "s3:*",
              "Resource": [
                {
                  "Fn::GetAtt": [
                    "MigrationEvidence",
                    "Arn"
                  ]
                },
                {
                  "Fn::Sub": "${MigrationEvidence.Arn}/*"
                }
              ],
              "Condition": {
                "Bool": {
                  "aws:SecureTransport": "false"
                }
              }
            }
          ]
        }
      },
      "Metadata": {
        "com.aws.cloudformation.Context": {
          "why": "Require encrypted transport for backup evidence.",
          "must": []
        }
      }
    }
  },
  "Outputs": {
    "Host": {
      "Description": "Certificate-verified PostgreSQL endpoint, never a credential.",
      "Value": {
        "Fn::GetAtt": [
          "Database",
          "Endpoint.Address"
        ]
      }
    },
    "MasterSecretArn": {
      "Description": "Managed administrative secret: bootstrap/restore only.",
      "Value": {
        "Fn::GetAtt": [
          "Database",
          "MasterUserSecret.SecretArn"
        ]
      }
    },
    "ApplicationSecretArn": {
      "Description": "Application role secret: role must be created and qualified before activation.",
      "Value": {
        "Ref": "ApplicationSecret"
      }
    },
    "VpcId": {
      "Description": "Pass to the colocated import stack.",
      "Value": {
        "Ref": "Network"
      }
    },
    "SubnetIds": {
      "Description": "Import task subnets; public task IPs permit HTTPS egress without a NAT gateway.",
      "Value": {
        "Fn::Join": [
          ",",
          [
            {
              "Ref": "Subnet0"
            },
            {
              "Ref": "Subnet1"
            }
          ]
        ]
      }
    },
    "ClientSecurityGroupId": {
      "Description": "Import tasks only; no inbound ports.",
      "Value": {
        "Ref": "ClientFirewall"
      }
    },
    "MigrationBucket": {
      "Description": "Private retained migration evidence.",
      "Value": {
        "Ref": "MigrationEvidence"
      }
    }
  }
}
