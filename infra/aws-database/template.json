          "must": [
            "Requires explicit network approval and a confirmed outbound CIDR."
          ]
        }
      },
      "Condition": "RenderRange3"
    },
    "RenderIngress4": {
      "Type": "AWS::EC2::SecurityGroupIngress",
      "Properties": {
        "GroupId": {
          "Ref": "DatabaseFirewall"
        },
        "IpProtocol": "tcp",
        "FromPort": 5432,
        "ToPort": 5432,
        "CidrIp": {
          "Ref": "RenderCidr4"
        }
      },
      "Metadata": {
        "com.aws.cloudformation.Context": {
          "why": "Opt-in connectivity from a verified Render region; TLS and database authentication remain mandatory.",
          "must": [
            "Requires explicit network approval and a confirmed outbound CIDR."
          ]
        }
      },
      "Condition": "RenderRange4"
    },
    "RenderIngress5": {
      "Type": "AWS::EC2::SecurityGroupIngress",
      "Properties": {
        "GroupId": {
          "Ref": "DatabaseFirewall"
        },
        "IpProtocol": "tcp",
        "FromPort": 5432,
        "ToPort": 5432,
        "CidrIp": {
          "Ref": "RenderCidr5"
        }
      },
      "Metadata": {
        "com.aws.cloudformation.Context": {
          "why": "Opt-in connectivity from a verified Render region; TLS and database authentication remain mandatory.",
          "must": [
            "Requires explicit network approval and a confirmed outbound CIDR."
          ]
        }
      },
      "Condition": "RenderRange5"
    },
    "RenderIngress6": {
      "Type": "AWS::EC2::SecurityGroupIngress",
      "Properties": {
        "GroupId": {
          "Ref": "DatabaseFirewall"
        },
        "IpProtocol": "tcp",
        "FromPort": 5432,
        "ToPort": 5432,
        "CidrIp": {
          "Ref": "RenderCidr6"
        }
      },
      "Metadata": {
